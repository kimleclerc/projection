---
// Accueil VoteScope Labs : les projections du moteur expérimental.
import {
  type Locale, T, NAMES, LABS_KEYS, labsUrl, hasLabs, loadLabs, loadBacktests,
  partyLabel, pct, fmt, fmtDate, REFERENCES,
} from '../lib/labs';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = T[locale];

const desks = LABS_KEYS.filter(hasLabs).map((k) => {
  const d = loadLabs(k);
  let headline = '';
  let sub = '';
  if (k.startsWith('us_')) {
    const dem = d.parties.find((x: any) => x.party === 'us_dem');
    const rep = d.parties.find((x: any) => x.party === 'us_rep');
    if (k === 'us_governor') {
      headline = `D ${dem.seats_favored} · R ${rep.seats_favored}`;
      sub = t.wins;
    } else {
      const lead = dem.p_control >= rep.p_control ? dem : rep;
      headline = `${partyLabel(d, lead.party, locale)} ${pct(lead.p_control, locale)}`;
      sub = t.control;
    }
  } else {
    const [party, p] = Object.entries(d.p_first as Record<string, number>).sort((a, b) => b[1] - a[1])[0];
    const row = d.parties.find((x: any) => x.party === party);
    headline = `${partyLabel(d, party, locale)} · ${row.seats_favored}`;
    sub = `${pct(p, locale)} ${t.chanceFirst}`;
  }
  return { k, name: NAMES[k][locale], headline, sub, asOf: d.as_of };
});

const bt = loadBacktests();
const btRows = ['bc_2024', 'qc_2022', 'qc_2018'].map((c) => ({
  c,
  name: { bc_2024: NAMES.bc_44[locale].replace('2026', '2024'), qc_2022: NAMES.qc_2026[locale].replace('2026', '2022'), qc_2018: NAMES.qc_2026[locale].replace('2026', '2018') }[c as 'bc_2024'],
  labs: bt?.labs?.[`${c}@J-1`]?.seat_mae_favored,
  right: bt?.labs?.[`${c}@J-1`]?.winner_accuracy,
  prod: bt?.prod?.[c]?.mae_seats,
})).filter((r) => r.labs !== undefined);
const updated = desks.map((x) => x.asOf).sort().at(-1);
---

<article class="lh container" data-content-area>
  <header class="lh-hero">
    <p class="lh-kicker">{t.brand} · {t.kicker}{updated && ` · ${t.updated} ${fmtDate(updated, locale)}`}</p>
    <h1>{t.hubTitle}</h1>
    <p class="lh-dek">{t.hubDek}</p>
  </header>

  <section class="lh-grid" aria-label={t.hubDesks}>
    {desks.map((x) => (
      <a class="lh-card" href={labsUrl(locale, x.k)}>
        <span class="lh-label">{x.name}</span>
        <strong>{x.headline}</strong>
        <span class="lh-sub">{x.sub}</span>
        <span class="lh-open">{t.openDesk} →</span>
      </a>
    ))}
  </section>

  {btRows.length > 0 && (
    <section class="lh-section" aria-labelledby="lh-bt">
      <h2 id="lh-bt">{t.backtests}</h2>
      <p class="lh-muted">{t.backtestsNote}</p>
      <div class="lh-scroll">
        <table class="lh-table">
          <thead><tr><th>{t.election}</th><th>{t.errLabs}</th><th>{t.errRef}</th><th>{t.ridingsRight}</th></tr></thead>
          <tbody>
            {btRows.map((r) => (
              <tr>
                <td>{r.name}</td>
                <td><strong>{fmt(r.labs, locale, 1)}</strong></td>
                <td>{r.prod != null ? fmt(r.prod, locale, 1) : t.notAvailable}</td>
                <td>{pct(r.right, locale)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="lh-section" aria-labelledby="lh-how">
    <h2 id="lh-how">{t.howTitle}</h2>
    <div class="lh-how">
      {t.how.map(([h, p]) => (<div><h3>{h}</h3><p>{p}</p></div>))}
    </div>
  </section>

  <section class="lh-section" aria-labelledby="lh-refs">
    <h2 id="lh-refs">{t.readMore}</h2>
    <ul class="lh-refs">
      {REFERENCES.map((r) => (<li><a href={r.url} rel="noopener" target="_blank">{r.label}</a></li>))}
    </ul>
    <p class="lh-muted">{t.caveat}</p>
  </section>
</article>

<style>
  .lh { max-width: 1080px; padding-block: 56px 96px; }
  .lh-hero { padding-bottom: 36px; border-bottom: 1px solid var(--rule); }
  .lh-kicker { margin: 0 0 14px; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .lh-hero h1 { max-width: 760px; margin: 0 0 18px; font-family: var(--serif); font-size: clamp(44px, 7vw, 80px); font-weight: 420; letter-spacing: -.02em; line-height: .98; }
  .lh-dek { max-width: 720px; margin: 0; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .lh-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 36px; }
  .lh-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 1px solid var(--rule); border-radius: 6px; background: var(--card); color: var(--ink); text-decoration: none; transition: border-color .15s; }
  .lh-card:hover { border-color: var(--ink-3); }
  .lh-label { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .lh-card strong { font-family: var(--serif); font-size: 26px; font-weight: 450; line-height: 1.15; }
  .lh-sub { color: var(--ink-3); font-size: 13px; }
  .lh-open { margin-top: auto; padding-top: 8px; font-size: 14px; font-weight: 500; }
  .lh-section { margin-top: 56px; }
  .lh-section h2 { font-family: var(--serif); font-size: 28px; font-weight: 450; margin: 0 0 16px; }
  .lh-how { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .lh-how h3 { font-family: var(--serif); font-size: 20px; font-weight: 450; margin: 0 0 8px; }
  .lh-how p { color: var(--ink-2); line-height: 1.6; margin: 0; }
  .lh-scroll { overflow-x: auto; }
  .lh-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .lh-table th { text-align: left; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); border-bottom: 1px solid var(--rule); padding: 8px 10px; white-space: nowrap; }
  .lh-table td { border-bottom: 1px solid var(--rule-2); padding: 10px; white-space: nowrap; }
  .lh-muted { color: var(--ink-3); font-size: 14px; line-height: 1.55; }
  .lh-refs { padding-left: 18px; line-height: 1.8; }
  .lh-refs a { color: var(--ink); }
</style>
