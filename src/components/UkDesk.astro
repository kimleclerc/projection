---
import { partyName } from '../lib/party-names';
// Desk UK — accueil de section data-driven (pattern FranceDesk : un composant,
// locale en prop). Remplace l'ancien hub à deux cartes : le desk montre le
// topline live du modèle, la composition réelle de la Chambre et les
// partielles, au lieu d'être une étape vide avant la projection.
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PageHeader from './PageHeader.astro';
import StoryList from './StoryList.astro';
import ResultsTable from './ResultsTable.astro';
import { longDate } from '../lib/format';
import MethodologyNote from './MethodologyNote.astro';
import DeskSections from './DeskSections.astro';
import ukMeta from '../../web_data/uk/latest.json';
import holbornSpecial from '../../web_data/uk-holborn-special/latest.json';
import clactonRecall from '../../web_data/uk-clacton-recall/latest.json';
import { ukByelections, ukResolvedByelections2026 } from '../data/ukByelections';

type Locale = 'en' | 'fr' | 'es';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const meta = (ukMeta as any).meta;
const parties = ((ukMeta as any).parties as any[]) ?? [];
const composition = ((ukMeta as any).current_composition as any[]) ?? [];

const topParties = [...parties]
  .filter((p) => p.party !== 'uk_oth')
  .sort((a, b) => (b.vote_mean ?? 0) - (a.vote_mean ?? 0))
  .slice(0, 5);
const leader = topParties[0];
const runnerUp = topParties[1];
// Le meilleur en VOIX et le meilleur en SIÈGES ne sont pas le même parti, et
// c'est l'histoire que ce desk raconte mieux que personne. Le titre se calcule
// donc sur les données du run : il reste juste sans être réécrit à la main, et
// il bascule tout seul si le croisement disparaît.
const seatLeader = [...parties].sort((a, b) => (b.seats_mean ?? 0) - (a.seats_mean ?? 0))[0];
// Les libellés du modèle sont des adjectifs (« Travailliste ») : parfaits dans
// une légende, bancals en sujet de phrase. Deux formes, donc — une pour le
// titre, une plus courte pour la ligne de chiffres.
const SUBJECT: Record<string, Record<Locale, string>> = {
  uk_lab: { fr: 'Le Parti travailliste', en: 'Labour', es: 'El Partido Laborista' },
  uk_ref: { fr: 'Reform UK', en: 'Reform UK', es: 'Reform UK' },
  uk_con: { fr: 'Les conservateurs', en: 'The Conservatives', es: 'Los conservadores' },
  uk_ld: { fr: 'Les libéraux-démocrates', en: 'The Liberal Democrats', es: 'Los liberal-demócratas' },
  uk_grn: { fr: 'Les Verts', en: 'The Greens', es: 'Los Verdes' },
  uk_snp: { fr: 'Le SNP', en: 'The SNP', es: 'El SNP' },
};
const SHORT: Record<string, Record<Locale, string>> = {
  uk_lab: { fr: 'Travaillistes', en: 'Labour', es: 'Laboristas' },
  uk_ref: { fr: 'Reform UK', en: 'Reform UK', es: 'Reform UK' },
  uk_con: { fr: 'Conservateurs', en: 'Conservatives', es: 'Conservadores' },
  uk_ld: { fr: 'Lib-Dem', en: 'Lib Dems', es: 'Lib-Dem' },
  uk_grn: { fr: 'Verts', en: 'Greens', es: 'Verdes' },
  uk_snp: { fr: 'SNP', en: 'SNP', es: 'SNP' },
};
const subj = (p: any) => SUBJECT[p?.party]?.[locale] ?? partyLabel(p);
const shortName = (p: any) => SHORT[p?.party]?.[locale] ?? partyLabel(p);
const splitWinner = seatLeader && leader && seatLeader.party !== leader.party;
const seatGap = splitWinner ? Math.round((seatLeader.seats_mean ?? 0) - (leader.seats_mean ?? 0)) : 0;
const voteGap = splitWinner ? Math.abs((leader.vote_mean ?? 0) - (seatLeader.vote_mean ?? 0)) : 0;
const compTotal = composition.reduce((acc, c) => acc + (c.seats ?? 0), 0);

// Course en cours : Holborn and St Pancras (démission de Keir Starmer).
// Aucun sondage de circonscription n'existe — on montre donc la fourchette et
// le levier de champ, jamais un point (règle posée à Clacton).
const race = ukByelections.holborn;
const racePath = race.paths[locale];
const raceModel = (holbornSpecial as any).model;
const pHold = Math.round(raceModel.p_lab_hold * 1000) / 10;
const labShare = raceModel.candidates.lab.share;
const grnShare = raceModel.candidates.grn.share;
const pGreen = Math.round(raceModel.candidates.grn.p_win * 1000) / 10;
const polanski = (raceModel.scenarios as any[]).find((sc) => sc.id === 'polanski_runs');
const pHoldIfPolanski = Math.round((polanski?.p_lab_hold ?? 0) * 1000) / 10;

// Clacton 2.0 : la nouvelle du jour mène le desk.
const recallHeld = ((clactonRecall as any).horizons['2029-06-30']?.p_byelection_held ?? 0) as number;

const partyLabel = (p: any) =>
  partyName(p, locale);

const fmt1 = (v: number) =>
  locale === 'en' ? v.toFixed(1) : v.toFixed(1).replace('.', ',');

const copy = {
  en: {
    title: `U.K. General Election Poll Tracker & Seat Projection — ${shortName(leader)} ${fmt1(leader.vote_mean)}%${seatLeader.party === leader.party ? ' and' : `, ${shortName(seatLeader)}`} ${Math.round(seatLeader.seats_mean)} Seats — Vote-Scope`,
    description: splitWinner
      ? `${subj(leader)} leads the polls on ${fmt1(leader.vote_mean)}% and still finishes ${seatGap} seats behind ${shortName(seatLeader)}. Vote-Scope projects all 650 Westminster constituencies, tracks every U.K. poll, and covers the Holborn and St Pancras by-election and the Clacton recall question.`
      : `${partyLabel(leader)} leads on ${fmt1(leader.vote_mean)}% and ${Math.round(seatLeader.seats_mean)} seats. Vote-Scope projects all 650 Westminster constituencies, tracks every U.K. poll, and covers the live by-elections.`,
    eyebrow: 'U.K. Desk',
    heroTitle: splitWinner
      ? `${subj(leader)} wins the polls. ${subj(seatLeader)} wins ${seatGap} more seats.`
      : `${subj(leader)} leads in votes and in seats.`,
    promise: 'We project all 650 Westminster constituencies one by one, from polls corrected for each pollster’s usual lean.',
    question: seatLeader.party === leader.party
      ? `Today: ${shortName(leader)} leads with ${fmt1(leader.vote_mean)}% of the vote and ${Math.round(leader.seats_mean)} projected seats.`
      : `Today: ${shortName(seatLeader)} wins the most seats (${Math.round(seatLeader.seats_mean)}) on ${fmt1(seatLeader.vote_mean)}% of the vote; ${shortName(leader)} leads the vote on ${fmt1(leader.vote_mean)}% but gets ${Math.round(leader.seats_mean)}.`,
    openProjection: 'Open projection',
    allIndexes: 'All indexes',
    toplineLabel: `Forecast of ${longDate(meta.run_date, 'en')} · ${meta.n_polls} polls`,
    votes: 'vote',
    seats: 'seats',
    compositionLabel: `Commons today — ${compTotal} of ${meta.total_seats} GB seats tracked`,
    transitionKicker: '1 September 2026 · Westminster',
    transitionTitle: 'Starmer has left the Commons — six weeks after leaving Downing Street.',
    transitionBody: 'Keir Starmer stood down as MP for Holborn and St Pancras on 1 September, saying it was time to step aside for international work. Andy Burnham had already replaced him as prime minister on 20 July, with Healey at the Treasury, Streeting at Defence and Rayner back at Housing. Two things follow: the Commons has a vacancy again, and the model now reads Labour through a leader it has only a few months of polling on.',
    transitionCta: 'The by-election, seat by seat',
    byeLabel: 'By-elections',
    raceKicker: 'Seat vacant · polling day not yet set',
    raceTitle: 'Labour has to defend Starmer’s seat without Starmer.',
    raceBody: `No local poll exists yet, so we give a range rather than a single number. Labour is projected at ${fmt1(labShare.q50)}% (between ${fmt1(labShare.q10)}% and ${fmt1(labShare.q90)}%) and holds the seat in ${fmt1(pHold)}% of simulations; the Greens are at ${fmt1(grnShare.q50)}% with a ${fmt1(pGreen)}% chance of winning it. In 2024 the runner-up here was not a Conservative but an independent, on 18.9%.`,
    raceLever: `If Green leader Zack Polanski stands, Labour’s chance of holding the seat falls to ${pHoldIfPolanski < 1 ? 'under 1' : fmt1(pHoldIfPolanski)}%. No other unknown moves this race as much.`,
    raceCta: 'Full by-election forecast',
    resolvedLabel: '2026 by-elections already decided',
    resolvedNote: 'Clacton settled on 13 August: Reform hold, and the Commons vacancy that had been showing here is gone.',
    leadKicker: '3 September 2026 · Clacton',
    leadTitle: 'Farage is filmed celebrating a secret foreign-funded polling scheme. Could Clacton vote again?',
    leadBody: 'According to Channel 4 News and the investigative group Verbatim, senior Reform UK figures had three polls paid for by a US company and published as independent. Reform UK and Mr Farage deny all the allegations, and no charge has been laid. We have modelled the steps of a possible recall and the candidacies the race could see.',
    leadStat: 'a second by-election by mid-2029',
    leadCta: 'The recall chain and 24 race scenarios',
    cards: [
      { href: '/en/uk/general-election/', title: 'U.K. general election', body: 'Projection of all 650 seats, with each party’s chance of winning every one.' },
      { href: '/en/uk/constituencies/', title: 'The 650 Westminster constituencies', body: 'A page for every seat: projection, sitting MP, 2024 result, demographics and nearby seats.' },
      { href: '/en/uk/polls/', title: 'U.K. polls', body: 'Every poll that feeds the model: pollster, dates, sample and weight.' },
    ],
    methodTitle: 'How we forecast the United Kingdom',
    methodBody: 'Each seat is projected separately: tactical voting, regional swings and the rise of smaller parties move individual seats in ways national polls do not show.',
    methodBullets: [
      "Polls are combined in a model that follows each party over time, with regional adjustments.",
      "We then simulate the election thousands of times to get seat ranges and each seat’s chances.",
      "The Commons composition includes by-elections already decided and current vacancies, not only the 2024 result.",
      "By-elections have their own model. With no local poll in Holborn and St Pancras yet, it gives ranges and candidacy scenarios rather than a single number.",
    ],
  },
  fr: {
    title: `Sondages et projection de sièges au Royaume-Uni — ${shortName(leader)} ${fmt1(leader.vote_mean)} %${seatLeader.party === leader.party ? ' et' : `, ${shortName(seatLeader)}`} ${Math.round(seatLeader.seats_mean)} sièges — Vote-Scope`,
    description: splitWinner
      ? `${subj(leader)} mène les sondages à ${fmt1(leader.vote_mean)} % et finit quand même ${seatGap} sièges derrière ${shortName(seatLeader)}. Vote-Scope projette les 650 circonscriptions de Westminster, suit chaque sondage britannique et couvre la partielle de Holborn and St Pancras ainsi que la question du rappel à Clacton.`
      : `${partyLabel(leader)} mène à ${fmt1(leader.vote_mean)} % et ${Math.round(seatLeader.seats_mean)} sièges. Vote-Scope projette les 650 circonscriptions de Westminster et suit chaque sondage britannique.`,
    eyebrow: 'Bureau UK',
    heroTitle: splitWinner
      ? `${subj(leader)} gagne les sondages. ${subj(seatLeader)} gagne ${seatGap} sièges de plus.`
      : `${subj(leader)} mène aux voix comme aux sièges.`,
    promise: 'Nous projetons les 650 circonscriptions de Westminster une par une, à partir des sondages corrigés des écarts habituels de chaque institut.',
    question: seatLeader.party === leader.party
      ? `Aujourd’hui, ${subj(leader).charAt(0).toLowerCase() + subj(leader).slice(1)} mène avec ${fmt1(leader.vote_mean)} % des voix et ${Math.round(leader.seats_mean)} sièges projetés.`
      : `Aujourd’hui, ${subj(seatLeader).charAt(0).toLowerCase() + subj(seatLeader).slice(1)} remporte le plus de sièges (${Math.round(seatLeader.seats_mean)}) avec ${fmt1(seatLeader.vote_mean)} % des voix ; ${subj(leader).charAt(0).toLowerCase() + subj(leader).slice(1)} mène en voix à ${fmt1(leader.vote_mean)} % mais n’obtient que ${Math.round(leader.seats_mean)} sièges.`,
    openProjection: 'Ouvrir la projection',
    allIndexes: 'Tous les indices',
    toplineLabel: `Projection du ${longDate(meta.run_date, 'fr')} · ${meta.n_polls} sondages`,
    votes: 'voix',
    seats: 'sièges',
    compositionLabel: `Les Communes aujourd’hui : ${compTotal} des ${meta.total_seats} sièges de Grande-Bretagne`,
    transitionKicker: '1er septembre 2026 · Westminster',
    transitionTitle: 'Starmer quitte les Communes — six semaines après avoir quitté Downing Street.',
    transitionBody: 'Keir Starmer a démissionné de son siège de Holborn and St Pancras le 1er septembre, disant qu’il était temps de « s’effacer » pour se consacrer aux dossiers internationaux. Andy Burnham l’avait déjà remplacé comme premier ministre le 20 juillet, avec Healey aux Finances, Streeting à la Défense et Rayner de retour au Logement. Deux conséquences : les Communes ont de nouveau un siège vacant, et le modèle lit désormais le Parti travailliste à travers un chef sur lequel il n’a que quelques mois de sondages.',
    transitionCta: 'La partielle, siège par siège',
    byeLabel: 'Partielles',
    raceKicker: 'Siège vacant · date du scrutin pas encore fixée',
    raceTitle: 'Le Parti travailliste doit défendre le siège de Starmer sans lui.',
    raceBody: `Aucun sondage local n’existe encore : nous donnons une fourchette plutôt qu’un chiffre. Le Parti travailliste est projeté à ${fmt1(labShare.q50)} % (entre ${fmt1(labShare.q10)} et ${fmt1(labShare.q90)} %) et garde le siège dans ${fmt1(pHold)} % des simulations ; les Verts sont à ${fmt1(grnShare.q50)} % avec ${fmt1(pGreen)} % de chances de l’emporter. En 2024, le deuxième ici n’était pas un conservateur mais un candidat indépendant, à 18,9 %.`,
    raceLever: `Si Zack Polanski, chef des Verts, se présente, les chances des travaillistes de garder le siège tombent à ${pHoldIfPolanski < 1 ? 'moins de 1' : fmt1(pHoldIfPolanski)} %. Aucune autre inconnue ne pèse autant sur cette course.`,
    raceCta: 'Toute la projection de cette partielle',
    resolvedLabel: 'Partielles de 2026 déjà tranchées',
    resolvedNote: 'Clacton a été tranchée le 13 août : maintien Reform, et la vacance qui s’affichait ici a disparu.',
    leadKicker: '3 septembre 2026 · Clacton',
    leadTitle: 'Farage filmé en train de se féliciter d’un montage de sondages payés de l’étranger. Clacton peut-elle revoter ?',
    leadBody: 'Selon Channel 4 News et le groupe d’enquête Verbatim, des dirigeants de Reform UK auraient fait payer trois sondages par une société américaine, publiés comme indépendants. Reform UK et M. Farage nient l’ensemble des allégations, et aucune accusation n’a été portée. Nous avons modélisé les étapes d’un éventuel rappel et les candidatures possibles.',
    leadStat: 'une seconde partielle d’ici mi-2029',
    leadCta: 'Les étapes du rappel et 24 scénarios de candidatures',
    cards: [
      { href: '/fr/uk/general-election/', title: 'Élection générale britannique', body: 'Projection des 650 sièges, avec les chances de chaque parti dans chacun.' },
      { href: '/fr/uk/circonscriptions/', title: 'Les 650 circonscriptions de Westminster', body: 'Une page par siège : projection, député en poste, résultat de 2024, démographie et sièges voisins.' },
      { href: '/fr/uk/sondages/', title: 'Sondages britanniques', body: 'Tous les sondages qui alimentent le modèle : institut, dates, échantillon et poids.' },
    ],
    methodTitle: 'Comment nous projetons le Royaume-Uni',
    methodBody: 'Chaque siège est projeté à part : le vote tactique, les écarts entre régions et la montée des petits partis déplacent des sièges que les sondages nationaux ne montrent pas.',
    methodBullets: [
      "Les sondages sont combinés dans un modèle qui suit chaque parti dans le temps, avec des ajustements par région.",
      "Nous simulons ensuite l’élection des milliers de fois pour obtenir les fourchettes de sièges et les chances dans chaque siège.",
      "La composition des Communes tient compte des partielles déjà tranchées et des sièges vacants, pas seulement du résultat de 2024.",
      "Les partielles ont leur propre modèle. Sans sondage local à Holborn and St Pancras, il donne des fourchettes et des scénarios de candidatures plutôt qu’un chiffre unique.",
    ],
  },
  es: {
    title: `Encuestas y proyección de escaños en el Reino Unido — ${shortName(leader)} ${fmt1(leader.vote_mean)} %${seatLeader.party === leader.party ? ' y' : `, ${shortName(seatLeader)}`} ${Math.round(seatLeader.seats_mean)} escaños — Vote-Scope`,
    description: splitWinner
      ? `${subj(leader)} lidera las encuestas con ${fmt1(leader.vote_mean)} % y aun así termina ${seatGap} escaños por detrás de ${shortName(seatLeader)}. Vote-Scope proyecta las 650 circunscripciones de Westminster, sigue cada encuesta británica y cubre la parcial de Holborn and St Pancras y la cuestión del recall en Clacton.`
      : `${partyLabel(leader)} lidera con ${fmt1(leader.vote_mean)} % y ${Math.round(seatLeader.seats_mean)} escaños. Vote-Scope proyecta las 650 circunscripciones de Westminster.`,
    eyebrow: 'Reino Unido',
    heroTitle: splitWinner
      ? `${subj(leader)} gana las encuestas. ${subj(seatLeader)} gana ${seatGap} escaños más.`
      : `${subj(leader)} lidera en votos y en escaños.`,
    promise: 'Proyectamos las 650 circunscripciones de Westminster una por una, con encuestas corregidas según el sesgo habitual de cada encuestadora.',
    question: seatLeader.party === leader.party
      ? `Hoy, ${subj(leader).charAt(0).toLowerCase() + subj(leader).slice(1)} lidera con el ${fmt1(leader.vote_mean)} % de los votos y ${Math.round(leader.seats_mean)} escaños proyectados.`
      : `Hoy, ${subj(seatLeader).charAt(0).toLowerCase() + subj(seatLeader).slice(1)} logra más escaños (${Math.round(seatLeader.seats_mean)}) con el ${fmt1(seatLeader.vote_mean)} % de los votos; ${subj(leader).charAt(0).toLowerCase() + subj(leader).slice(1)} lidera en votos con el ${fmt1(leader.vote_mean)} % pero obtiene ${Math.round(leader.seats_mean)}.`,
    openProjection: 'Abrir la proyección',
    allIndexes: 'Todos los índices',
    toplineLabel: `Proyección del ${longDate(meta.run_date, 'es')} · ${meta.n_polls} encuestas`,
    votes: 'voto',
    seats: 'escaños',
    compositionLabel: `Los Comunes hoy: ${compTotal} de los ${meta.total_seats} escaños de Gran Bretaña`,
    transitionKicker: '1 de septiembre de 2026 · Westminster',
    transitionTitle: 'Starmer deja los Comunes — seis semanas después de dejar Downing Street.',
    transitionBody: 'Keir Starmer renunció a su escaño de Holborn and St Pancras el 1 de septiembre, diciendo que era hora de apartarse para dedicarse a asuntos internacionales. Andy Burnham ya lo había sustituido como primer ministro el 20 de julio, con Healey en el Tesoro, Streeting en Defensa y Rayner de vuelta en Vivienda. Dos consecuencias: los Comunes vuelven a tener una vacante, y el modelo lee ahora al laborismo a través de un líder del que solo tiene unos meses de encuestas.',
    transitionCta: 'La parcial, escaño por escaño',
    byeLabel: 'Parciales',
    raceKicker: 'Escaño vacante · fecha de votación aún sin fijar',
    raceTitle: 'El Partido Laborista debe defender el escaño de Starmer sin él.',
    raceBody: `Todavía no hay ninguna encuesta local: damos un rango en lugar de una cifra. El Partido Laborista se proyecta en ${fmt1(labShare.q50)} % (entre ${fmt1(labShare.q10)} y ${fmt1(labShare.q90)} %) y retiene el escaño en el ${fmt1(pHold)} % de las simulaciones; los Verdes están en ${fmt1(grnShare.q50)} % con un ${fmt1(pGreen)} % de probabilidades de ganarlo. En 2024, el segundo aquí no fue un conservador sino un independiente, con el 18,9 %.`,
    raceLever: `Si se presenta Zack Polanski, líder de los Verdes, la probabilidad de que los laboristas retengan el escaño cae a ${pHoldIfPolanski < 1 ? 'menos del 1' : fmt1(pHoldIfPolanski)} %. Ninguna otra incógnita pesa tanto en esta contienda.`,
    raceCta: 'Toda la proyección de esta parcial',
    resolvedLabel: 'Parciales de 2026 ya decididas',
    resolvedNote: 'Clacton se resolvió el 13 de agosto: retención de Reform, y la vacante que aparecía aquí ya no existe.',
    leadKicker: '3 de septiembre de 2026 · Clacton',
    leadTitle: 'Farage, filmado celebrando un montaje de encuestas pagadas desde el extranjero. ¿Puede Clacton volver a votar?',
    leadBody: 'Según Channel 4 News y el grupo de investigación Verbatim, dirigentes de Reform UK habrían hecho pagar tres encuestas a una empresa estadounidense, publicadas como independientes. Reform UK y el señor Farage niegan todas las acusaciones, y no se ha presentado ningún cargo. Hemos modelado los pasos de un posible recall y las candidaturas posibles.',
    leadStat: 'una segunda parcial antes de mediados de 2029',
    leadCta: 'La cadena de recall y 24 escenarios',
    cards: [
      { href: '/es/uk/general-election/', title: 'Elecciones generales británicas', body: 'Proyección de los 650 escaños, con las probabilidades de cada partido en cada uno.' },
      { href: '/es/uk/circunscripciones/', title: 'Las 650 circunscripciones de Westminster', body: 'Una página por escaño: proyección, diputado en ejercicio, resultado de 2024, demografía y escaños vecinos.' },
      { href: '/es/uk/sondeos/', title: 'Encuestas británicas', body: 'Todas las encuestas que alimentan el modelo: encuestadora, fechas, muestra y peso.' },
    ],
    methodTitle: 'Cómo proyectamos el Reino Unido',
    methodBody: 'Cada escaño se proyecta por separado: el voto táctico, las diferencias entre regiones y el ascenso de los partidos pequeños mueven escaños que las encuestas nacionales no muestran.',
    methodBullets: [
      "Las encuestas se combinan en un modelo que sigue a cada partido en el tiempo, con ajustes por región.",
      "Después simulamos la elección miles de veces para obtener las horquillas de escaños y las probabilidades en cada escaño.",
      "La composición de los Comunes incluye las parciales ya decididas y los escaños vacantes, no solo el resultado de 2024.",
      "Las parciales tienen su propio modelo. Sin encuesta local en Holborn and St Pancras, da rangos y escenarios de candidaturas en lugar de una cifra única.",
    ],
  },
}[locale];

const t = copy;
const canonical = `https://vote-scope.com/${locale}/uk/`;
const alternates = {
  en: 'https://vote-scope.com/en/uk/',
  fr: 'https://vote-scope.com/fr/uk/',
  es: 'https://vote-scope.com/es/uk/',
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.title,
    url: canonical,
    inLanguage: locale,
    dateModified: meta.run_date,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${locale}/` },
      { '@type': 'ListItem', position: 2, name: 'U.K.', item: canonical },
    ],
  },
];

const dateLabel = (iso: string) => {
  const d = new Date(`${iso}T12:00:00`);
  return d.toLocaleDateString(locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};
---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={locale}
  currentPage="uk"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <PageHeader title={t.heroTitle} promise={t.promise} question={t.question} preferredSourceLocale={locale} />

  <section class="container ukdesk-block">
    <ResultsTable
      lang={locale}
      rows={topParties.map((p) => ({ label: partyLabel(p), color: p.color, seats: Math.round(p.seats_mean), chance: p.vote_mean / 100 }))}
      totalSeats={meta.total_seats}
      majority={Math.floor(meta.total_seats / 2) + 1}
      chanceKind="vote"
      meta={t.toplineLabel}
    />
    <p class="ukdesk-label" style="margin-top:28px;">{t.compositionLabel}</p>
    <div class="ukdesk-comp-bar" role="img" aria-label={t.compositionLabel}>
      {composition.filter((c) => c.seats > 0).map((c) => (
        <div style={`width:${(c.seats / compTotal) * 100}%;background:${c.color};`} title={`${partyLabel(c)} : ${c.seats}`} />
      ))}
    </div>
    <div class="ukdesk-comp-legend">
