      ]}
    />
  </section>

  <section class="container ukdesk-block">
    <StoryList items={t.cards} size="sm" />
  </section>

  <DeskSections lang={locale} desk="uk" />

  <MethodologyNote
    title={t.methodTitle}
    body={t.methodBody}
    bullets={t.methodBullets}
  />
