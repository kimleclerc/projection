---
// Page d'une édition du budget (docs/DESIGN.md §7) : la réponse d'abord, les chiffres
// en tableau, le partage, puis notre lecture et le détail. Partagée fr/en/es.
import PageHeader from './PageHeader.astro';
import BudgetForYou from '../islands/BudgetForYou.tsx';
import BudgetShare from '../islands/BudgetShare.tsx';
import {
  t, val, UI, JURISDICTION_LABEL, TYPE_LABEL, editionLabel, budgetJur, budgetHub, budgetEdition, answerOf, budgetCardInput,
  type BudgetData, type Locale,
} from '../lib/budget';
import { editionsFor } from '../lib/budget-data';

interface Props { data: BudgetData; locale: Locale }
const { data, locale } = Astro.props;

const jur = JURISDICTION_LABEL[data.slug]?.[locale] ?? data.slug;
const heading = editionLabel(data, locale);
const answer = answerOf(data, locale);
const dek = t(data.title_full, locale);
const [lead, ...others] = data.key_numbers;
const card = budgetCardInput(data, locale);
const url = `https://vote-scope.com${budgetEdition(locale, data.slug, data.edition)}`;
const otherEditions = editionsFor(data.slug).filter((d) => d.edition !== data.edition);
const crumbLabel = locale === 'fr' ? 'Fil d’Ariane' : locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb';
---

<article class="bd" data-content-area>
  <nav class="bd-crumb container vs-meta" aria-label={crumbLabel}>
    <a href={budgetHub(locale)}>Budget</a> <span aria-hidden="true">/</span>
    <a href={budgetJur(locale, data.slug)}>{jur}</a> <span aria-hidden="true">/</span>
    <span>{heading}</span>
  </nav>

  <PageHeader title={heading} promise={dek} question={answer} preferredSourceLocale={locale} />

  <div class="container">
    <p class="bd-meta vs-meta">
      {UI.by[locale]} · {UI.tabled[locale]} {t(data.date_tabled, locale)} · {UI.minister[locale]}{locale === 'fr' ? ' :' : ':'} {data.minister}
    </p>

    {lead && (
      <section class="bd-section" id="chiffres">
        <h2>{UI.keyNumbers[locale]}</h2>
        <div class="bd-lead">
          <p class="bd-lead-value">{val(lead.value, locale)}</p>
          <p class="bd-lead-label">{t(lead.label, locale)}</p>
          {t(lead.note, locale) && <p class="bd-lead-note">{t(lead.note, locale)}</p>}
          {t(lead.change, locale) && <p class="bd-lead-note">{t(lead.change, locale)}</p>}
        </div>
        {others.length > 0 && (
          <div class="table-scroll">
            <table class="bd-table">
              <tbody>
                {others.map((n) => (
                  <tr>
                    <th scope="row">{t(n.label, locale)}</th>
                    <td class="bd-num">{val(n.value, locale)}</td>
                    <td class="bd-note">{t(n.note, locale)}{t(n.change, locale) ? ` ${t(n.change, locale)}` : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )}

    <section class="bd-section">
      <BudgetShare client:visible lang={locale} text={answer} url={url} image={`/og/budget/${data.slug}/${data.edition}/${locale}.png`} version={data.meta.ingested_at} slug={data.slug} embedPath={`/${locale}/embed/budget/${data.slug}/${data.edition}/`} />
    </section>

    {data.reading && data.reading.length > 0 && (
      <section class="bd-section" id="lecture">
        <h2>{UI.reading[locale]}</h2>
        {data.reading.map((r) => (
          <div class="bd-reading">
            <h3>{t(r.title, locale)}</h3>
            {r.body.map((p) => <p>{t(p, locale)}</p>)}
          </div>
        ))}
      </section>
    )}

    {data.audiences.length > 0 && (
      <section class="bd-section" id="pour-vous">
        <h2>{UI.forYou[locale]}</h2>
        <BudgetForYou audiences={data.audiences} locale={locale} card={{ title: card.title, foot: card.foot, slug: `budget-${data.slug}-${data.edition}`, jurisdiction: data.slug }} client:visible />
      </section>
    )}

    {data.sectors.length > 0 && (
      <section class="bd-section" id="secteurs">
        <h2>{UI.sectors[locale]}</h2>
        {data.sectors.map((s) => (
          <div class="bd-item" id={s.id}>
            <h3>{t(s.title, locale)}</h3>
            {t(s.spending, locale) && <p class="bd-amount">{t(s.spending, locale)}</p>}
            <p>{t(s.summary, locale)}</p>
            {s.points.length > 0 && (
              <details>
                <summary>{UI.details[locale]}</summary>
                <ul>{s.points.map((pt) => <li>{t(pt, locale)}</li>)}</ul>
              </details>
            )}
          </div>
        ))}
      </section>
    )}

    {data.comparison && data.comparison.items.length > 0 && (
      <section class="bd-section" id="avant-apres">
        <h2>{UI.comparison[locale]}</h2>
        <div class="table-scroll">
          <table class="bd-table">
            <thead><tr><th scope="col"></th><th scope="col">{t(data.comparison.before_label, locale) || UI.before[locale]}</th><th scope="col">{t(data.comparison.after_label, locale) || UI.after[locale]}</th></tr></thead>
            <tbody>
              {data.comparison.items.map((it) => (
                <tr>
                  <th scope="row">{t(it.label, locale)}</th>
                  <td>{t(it.before, locale)}</td>
                  <td class="bd-strong">{t(it.after, locale)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {data.stakeholders.length > 0 && (
      <section class="bd-section" id="parties-prenantes">
        <h2>{UI.stakeholders[locale]}</h2>
        {data.stakeholders.map((s) => (
          <div class="bd-item">
            <h3>{t(s.title, locale)}</h3>
            <p>{t(s.summary, locale)}</p>
            {s.issues.length > 0 && (
              <details>
                <summary>{UI.issues[locale]}</summary>
                <ul>{s.issues.map((i) => <li>{t(i, locale)}</li>)}</ul>
              </details>
            )}
          </div>
        ))}
      </section>
    )}

    {data.glossary.length > 0 && (
      <section class="bd-section" id="glossaire">
        <h2>{UI.glossary[locale]}</h2>
        {data.glossary.map((g) => (
          <details class="bd-gloss">
            <summary>{t(g.term, locale)}</summary>
            <p>{t(g.definition, locale)}</p>
          </details>
        ))}
      </section>
    )}

    {data.sources && (data.sources.plan || data.sources.brief) && (
      <section class="bd-section" id="sources">
        <h2>{UI.sources[locale]}</h2>
        <ul class="bd-links">
          {data.sources.plan && <li><a class="vs-link" href={(locale === 'fr' && data.sources.plan_fr) || data.sources.plan} target="_blank" rel="noopener">{UI.planLabel[locale]}</a></li>}
          {data.sources.brief && <li><a class="vs-link" href={(locale === 'fr' && data.sources.brief_fr) || data.sources.brief} target="_blank" rel="noopener">{UI.briefLabel[locale]}</a></li>}
          {(data.sources.others ?? []).map((o) => <li><a class="vs-link" href={(locale === 'fr' && o.url_fr) || o.url} target="_blank" rel="noopener">{t(o.label, locale)}</a></li>)}
        </ul>
        <p class="vs-meta">{UI.disclaimer[locale]}</p>
      </section>
    )}

    <section class="bd-section">
      <h2>{UI.otherBudgets[locale]}</h2>
      <ul class="bd-links">
        {otherEditions.map((d) => (
          <li><a class="vs-link" href={budgetEdition(locale, d.slug, d.edition)}>{editionLabel(d, locale)}</a> <span class="vs-meta">{TYPE_LABEL[d.type][locale]}, {t(d.date_tabled, locale)}</span></li>
        ))}
        <li><a class="vs-link" href={budgetHub(locale)}>{locale === 'fr' ? 'Les budgets du Canada, de l’Ontario et du Québec' : locale === 'es' ? 'Los presupuestos de Canadá, Ontario y Quebec' : 'Budgets for Canada, Ontario and Quebec'}</a></li>
      </ul>
    </section>
  </div>
</article>

<style>
  .bd { padding-bottom: 64px; }
  .bd-crumb { padding-top: 24px; }
  .bd-crumb a { color: var(--ink-2); }
  .bd-crumb span[aria-hidden] { margin: 0 4px; }
  .bd-meta { margin: 16px 0 0; }
  .bd-section { margin-top: 48px; }
  .bd-section h2 { margin: 0 0 16px; font-size: clamp(24px, 3vw, 32px); font-weight: 700; line-height: 1.1; }
  .bd-section h3 { margin: 0 0 8px; font-size: 20px; font-weight: 700; line-height: 1.2; }
  .bd-section p { max-width: 72ch; }
  .bd-lead { border-top: 4px solid var(--ink); padding-top: 12px; }
  .bd-lead-value { margin: 0; font-family: var(--numeric); font-size: clamp(56px, 10vw, 96px); font-weight: 700; line-height: 1; }
  .bd-lead-label { margin: 4px 0; font-size: 19px; font-weight: 700; }
  .bd-lead-note { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  .bd-table { width: 100%; margin-top: 16px; border-collapse: collapse; }
  .bd-table th, .bd-table td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: baseline; font-size: 15px; line-height: 1.4; }
  .bd-table thead th { border-bottom: 2px solid var(--ink); font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .bd-table tbody th { font-weight: 600; min-width: 150px; }
  .bd-num { font-family: var(--numeric); font-size: 26px !important; font-weight: 700; white-space: nowrap; }
  .bd-note { color: var(--ink-2); min-width: 220px; }
  .bd-strong { font-weight: 700; }
  .bd-reading { margin-top: 24px; }
  .bd-reading p, .bd-item p { margin: 0 0 12px; font-size: 17px; line-height: 1.55; color: var(--ink-2); }
  .bd-item { border-top: 2px solid var(--ink); padding: 12px 0 20px; }
  .bd-section .bd-amount { margin-bottom: 8px; font-size: 15px; font-weight: 600; color: var(--ink); }
  details summary { font-size: 15px; font-weight: 600; cursor: pointer; text-decoration: underline; }
  details ul { max-width: 72ch; margin: 8px 0 0; padding-left: 18px; }
  details li { margin-bottom: 6px; font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  .bd-gloss { border-top: 1px solid var(--rule); padding: 12px 0; }
  .bd-gloss summary { font-size: 17px; text-decoration: none; }
  .bd-gloss p { margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
  .bd-links { list-style: none; margin: 0 0 12px; padding: 0; }
  .bd-links li { padding: 8px 0; border-top: 1px solid var(--rule); font-size: 17px; }
</style>
