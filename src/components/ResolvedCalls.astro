---
// Registre des appels résolus (track record), alimenté par la source figée
// web_data/resolved-calls.json. Compteur PAR DOMAINE (sport/élection comptés
// séparément, jamais additionnés) + une fiche par appel : proba modèle vs proba
// marché au même instant, résultat, et preuve d'antériorité (commit git).
// Locale-prop fr/en/es. Filtre `domain` optionnel (une page sport ne montre que
// le sport ; sans filtre, chaque domaine a son propre compteur).
import resolved from '../../web_data/resolved-calls.json';

type Locale = 'en' | 'fr' | 'es';
interface Props {
  locale: Locale;
  domain?: 'sport' | 'election';
}
const { locale, domain } = Astro.props;

interface Call {
  id: string;
  domain: string;
  competition: Record<Locale, string>;
  timing: Record<Locale, string>;
  model_snapshot: {
    subject: string;
    subject_prob: number;
    opponent?: string;
    opponent_prob?: number;
    runner_up?: string;
    runner_up_prob?: number;
  };
  market: {
    available: boolean;
    subject_price?: number;
    edge_points?: number;
    note?: Record<Locale, string>;
  };
  proof: { commit: string; commit_date: string; note: Record<Locale, string> };
  result: { status: string; date: string; outcome: Record<Locale, string> };
  links: { votescope?: Record<Locale, string> };
  text: {
    title: Record<Locale, string>;
    call: Record<Locale, string>;
    result: Record<Locale, string>;
  };
}

const all = (resolved.calls as unknown as Call[]).filter((c) => !domain || c.domain === domain);

// Groupes par domaine (préserve l'ordre d'apparition).
const domains = [...new Set(all.map((c) => c.domain))];

const t = {
  en: {
    resolved: 'resolved calls', accuracy: 'accuracy', model: 'Model', market: 'Market',
    edge: 'edge', notFrozen: 'market not frozen at the snapshot', public: 'Public',
    verify: 'commit', result: 'Result', domainLabel: { sport: 'Sports Scope', election: 'Elections' } as Record<string, string>,
    fmtPct: (v: number) => `${v}%`,
  },
  fr: {
    resolved: 'appels résolus', accuracy: 'exactitude', model: 'Modèle', market: 'Marché',
    edge: 'écart', notFrozen: 'marché non figé à l’instant', public: 'Public le',
    verify: 'commit', result: 'Résultat', domainLabel: { sport: 'Sports Scope', election: 'Élections' } as Record<string, string>,
    fmtPct: (v: number) => `${String(v).replace('.', ',')} %`,
  },
  es: {
    resolved: 'llamadas resueltas', accuracy: 'exactitud', model: 'Modelo', market: 'Mercado',
    edge: 'ventaja', notFrozen: 'mercado no congelado en el instante', public: 'Público el',
    verify: 'commit', result: 'Resultado', domainLabel: { sport: 'Sports Scope', election: 'Elecciones' } as Record<string, string>,
    fmtPct: (v: number) => `${String(v).replace('.', ',')} %`,
  },
}[locale];

const groups = domains.map((d) => {
  const calls = all.filter((c) => c.domain === d);
  const correct = calls.filter((c) => c.result.status === 'correct').length;
  return { domain: d, calls, correct, total: calls.length };
});
---

{groups.map((g) => (
  <section class="rc-band">
    <div class="container">
      <p class="rc-domain-label">{t.domainLabel[g.domain] ?? g.domain}</p>
      <div class="rc-counter">
        <span class="rc-counter-main">{g.correct} / {g.total}</span>
        <span class="rc-counter-sub">{t.resolved}</span>
        <span class="rc-counter-pct">{Math.round((g.correct / g.total) * 100)}% {t.accuracy}</span>
      </div>

      <div class="rc-cards">
        {g.calls.map((c) => {
          const m = c.model_snapshot;
          const mk = c.market;
          const page = c.links.votescope?.[locale];
          return (
            <article class="rc-card">
              <p class="rc-card-eyebrow">
                {c.competition[locale]} · {c.timing[locale]}
                {c.result.status === 'correct' && <span class="rc-check"> ✓</span>}
              </p>
              <h3 class="rc-card-title">{c.text.title[locale]}</h3>
              <p class="rc-card-call">{c.text.call[locale]}</p>

              <div class="rc-vs">
                <span class="rc-vs-model">{`${t.model} `}<strong>{t.fmtPct(m.subject_prob)}</strong></span>
                {mk.available && mk.subject_price != null ? (
                  <>
                    <span class="rc-vs-sep">·</span>
                    <span class="rc-vs-market">{`${t.market} `}<strong>{t.fmtPct(mk.subject_price)}</strong></span>
                    {mk.edge_points != null && (
                      <span class="rc-vs-edge">{`${t.edge} +${t.fmtPct(mk.edge_points)}`}</span>
                    )}
                  </>
                ) : (
                  <span class="rc-vs-nofreeze">{`· ${t.notFrozen}`}</span>
                )}
              </div>

              <p class="rc-card-result">{c.text.result[locale]}</p>

              <footer class="rc-card-foot">
                <span class="rc-proof">{`${t.public} ${c.proof.commit_date} · ${t.verify} ${c.proof.commit}`}</span>
                {page && <a class="rc-link" href={page}>↗</a>}
              </footer>
            </article>
          );
        })}
      </div>
    </div>
  </section>
))}

<style>
  .rc-band { padding-block: 40px; border-top: 1px solid var(--rule); }
  .rc-domain-label {
    font-family: var(--mono); font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-3); margin: 0 0 14px;
  }
  .rc-counter { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 26px; }
  .rc-counter-main {
    font-family: var(--serif); font-size: clamp(40px, 6vw, 64px); font-weight: 420;
    letter-spacing: -.02em; line-height: 1; color: var(--ink);
  }
  .rc-counter-sub { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .rc-counter-pct {
    margin-left: auto; font-family: var(--mono); font-size: 13px; letter-spacing: .04em;
    color: var(--red); border: 1px solid currentColor; border-radius: 999px; padding: 4px 12px;
  }
  .rc-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
  .rc-card {
    border: 1px solid var(--rule); border-left: 3px solid var(--red); border-radius: 6px;
    background: var(--card); padding: 20px 22px; display: flex; flex-direction: column;
  }
  .rc-card-eyebrow {
    margin: 0; font-family: var(--mono); font-size: 11px; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .rc-check { color: var(--red); font-weight: 700; }
  .rc-card-title { margin: 8px 0 6px; font-family: var(--serif); font-size: 21px; font-weight: 440; line-height: 1.1; letter-spacing: -.01em; }
  .rc-card-call { margin: 0 0 14px; color: var(--ink-2); font-size: 14px; line-height: 1.55; }
  .rc-vs {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px;
    font-family: var(--mono); font-size: 12px; color: var(--ink-2);
    padding: 10px 0; border-block: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .rc-vs strong { color: var(--ink); font-size: 14px; }
  .rc-vs-edge { margin-left: auto; color: var(--red); font-weight: 500; }
  .rc-vs-nofreeze { color: var(--ink-3); font-style: italic; }
  .rc-card-result { margin: 13px 0 0; font-family: var(--serif); font-size: 15px; color: var(--ink); line-height: 1.4; }
  .rc-card-foot {
    margin-top: 14px; padding-top: 12px; border-top: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--mono); font-size: 10px; letter-spacing: .04em; color: var(--ink-3);
  }
  .rc-link { color: var(--ink-3); text-decoration: none; font-size: 13px; }
  .rc-link:hover { color: var(--ink); }
  @media (max-width: 720px) { .rc-cards { grid-template-columns: 1fr; } }
</style>
