---
interface Props {
  title: string;
  kicker: string;
  body: string;
  modelLabel: string;
  marketLabel: string;
  note: string;
}

const { title, kicker, body, modelLabel, marketLabel, note } = Astro.props;
---

<section class="market-check">
  <div class="container market-inner">
    <div>
      <p class="eyebrow">{kicker}</p>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="market-board" aria-label={title}>
      <div>
        <span>{modelLabel}</span>
        <strong>Vote-Scope</strong>
      </div>
      <div>
        <span>{marketLabel}</span>
        <strong>Market</strong>
      </div>
      <p>{note}</p>
    </div>
  </div>
</section>

<style>
  .market-check {
    padding: 72px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    color: var(--paper-3);
  }

  .market-inner {
    display: grid;
    grid-template-columns: 1fr .75fr;
    gap: 48px;
    align-items: center;
  }

  h2 {
    max-width: 680px;
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(34px, 4vw, 58px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  p {
    max-width: 620px;
    margin-top: 18px;
    color: color-mix(in oklab, var(--paper-3) 72%, transparent);
    line-height: 1.65;
  }

  .market-board {
    border: 1px solid color-mix(in oklab, var(--paper-3) 22%, transparent);
    border-radius: 6px;
    background: color-mix(in oklab, var(--paper-3) 7%, transparent);
    padding: 24px;
  }

  .market-board div {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid color-mix(in oklab, var(--paper-3) 18%, transparent);
  }

  .market-board span {
    color: color-mix(in oklab, var(--paper-3) 62%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .market-board strong {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 430;
  }

  .market-board p {
    margin-top: 18px;
    color: color-mix(in oklab, var(--paper-3) 68%, transparent);
    font-size: 13px;
  }

  @media (max-width: 820px) {
    .market-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
