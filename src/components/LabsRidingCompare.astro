---
// Toutes les circonscriptions (ou courses) d'une juridiction : favori et chance
// selon Harfang des neiges (projection de référence), selon Orbite, et selon le
// mélange 50/50 (moyenne des deux chances). Chaque nom mène à la fiche locale,
// qui reprend les trois lectures. Image à télécharger : les désaccords.
import { type Locale, type LabsKey, compareRows, localUrl, partyLabel, partyColor, pct, fmtDate } from '../lib/labs';
import { MODEL_RELEASES } from '../data/modelVersion';
import RidingShareButton from '../islands/RidingShareButton.tsx';

interface Props { locale: Locale; desk: any; labsKey: LabsKey }
const { locale, desk, labsKey } = Astro.props;
const refName = MODEL_RELEASES[0].name;
const rows = compareRows(labsKey);
const nAgree = rows.filter((r) => r.agree).length;
const nSplit = rows.length - nAgree;

// Le mot juste : circonscription, district ou course.
const UNIT = {
  fr: { riding: ['circonscription', 'circonscriptions', 'Circonscription'], district: ['district', 'districts', 'District'], race: ['course', 'courses', 'Course'] },
  en: { riding: ['riding', 'ridings', 'Riding'], district: ['district', 'districts', 'District'], race: ['race', 'races', 'Race'] },
  es: { riding: ['circunscripción', 'circunscripciones', 'Circunscripción'], district: ['distrito', 'distritos', 'Distrito'], race: ['contienda', 'contiendas', 'Contienda'] },
}[locale][labsKey === 'us_house' ? 'district' : labsKey.startsWith('us_') ? 'race' : 'riding'];
const [one, many, head] = UNIT;
// genre du mot en français et en espagnol (« les 35 courses », « los 435 distritos »)
const fem = (locale === 'fr' && (one === 'circonscription' || one === 'course')) || (locale === 'es' && one !== 'distrito');

const TX = {
  fr: {
    title: (n: number) => `Les ${n} ${many} : ${refName}, Orbite et le mélange`,
    dek: (a: number, n: number) => `Pour chaque ${one}, le favori et sa chance de l’emporter selon notre projection principale (${refName}), selon Orbite et selon le mélange 50/50, qui fait la moyenne des deux chances. Les deux modèles désignent le même favori dans ${a} ${many} sur ${n}. ${n - a === 0 ? 'Aucun désaccord.' : n - a === 1 ? `${fem ? 'L’autre est marquée' : 'L’autre est marqué'}.` : `Les ${n - a} autres sont ${fem ? 'marquées' : 'marqués'}.`}`,
    only: 'Seulement les désaccords',
    ref: refName, orbit: 'Orbite', blend: 'Mélange 50/50', split: 'désaccord',
    share: (n: number, name: string) => n === 0 ? `${name} : Orbite et ${refName} désignent partout le même favori` : `${name} : ${n} ${n > 1 ? many : one} où Orbite et ${refName} ne désignent pas le même favori`,
    where: (o: string, r: string) => `Orbite ${o} · ${refName} ${r}`,
    thFav: 'Mélange 50/50', thP: 'Chances',
    foot: (d: string) => `Orbite et ${refName}, chiffres du ${d}`,
  },
  en: {
    title: (n: number) => `All ${n} ${many}: ${refName}, Orbit and the blend`,
    dek: (a: number, n: number) => `For each ${one}, the favourite and its chance of winning according to our main forecast (${refName}), according to Orbit, and according to the 50/50 blend, which averages the two chances. The two models pick the same favourite in ${a} of ${n} ${many}. ${n - a === 0 ? 'No disagreements.' : n - a === 1 ? `The other one is flagged.` : `The other ${n - a} are flagged.`}`,
    only: 'Disagreements only',
    ref: refName, orbit: 'Orbit', blend: '50/50 blend', split: 'split',
    share: (n: number, name: string) => n === 0 ? `${name}: Orbit and ${refName} pick the same favourite everywhere` : `${name}: ${n} ${n > 1 ? many : one} where Orbit and ${refName} disagree on the favourite`,
    where: (o: string, r: string) => `Orbit ${o} · ${refName} ${r}`,
    thFav: '50/50 blend', thP: 'Chance',
    foot: (d: string) => `Orbit and ${refName}, figures as of ${d}`,
  },
  es: {
    title: (n: number) => `${fem ? 'Las' : 'Los'} ${n} ${many}: ${refName}, Órbita y la mezcla`,
    dek: (a: number, n: number) => `Para cada ${one}, el favorito y su probabilidad de ganar según nuestra proyección principal (${refName}), según Órbita y según la mezcla 50/50, que promedia ambas probabilidades. Los dos modelos eligen el mismo favorito en ${a} de ${n} ${many}. ${n - a === 0 ? 'Ningún desacuerdo.' : n - a === 1 ? `${fem ? 'La otra está señalada' : 'El otro está señalado'}.` : `${fem ? 'Las' : 'Los'} ${n - a} restantes están ${fem ? 'señaladas' : 'señalados'}.`}`,
    only: 'Solo los desacuerdos',
    ref: refName, orbit: 'Órbita', blend: 'Mezcla 50/50', split: 'desacuerdo',
    share: (n: number, name: string) => n === 0 ? `${name}: Órbita y ${refName} eligen el mismo favorito en todas partes` : `${name}: ${n} ${n > 1 ? many : one} donde Órbita y ${refName} no eligen el mismo favorito`,
    where: (o: string, r: string) => `Órbita ${o} · ${refName} ${r}`,
    thFav: 'Mezcla 50/50', thP: 'Probabilidad',
    foot: (d: string) => `Órbita y ${refName}, cifras del ${d}`,
  },
}[locale];
const cell = (p: string, v: number) => ({ label: partyLabel(desk, p, locale), color: partyColor(desk, p), v: pct(v, locale) });

// Image : les désaccords d'abord (au plus six), sinon les plus serrées selon le mélange.
const pick = (nSplit > 0 ? rows.filter((r) => !r.agree) : [...rows].sort((a, b) => a.pb - b.pb)).slice(0, 6);
const short = (p: string) => partyLabel(desk, p, locale).split(' ')[0];
const deskName = desk.desk ? ({ 'us-senate': { fr: 'Sénat 2026', en: 'Senate 2026', es: 'Senado 2026' },
  'us-house': { fr: 'Chambre 2026', en: 'House 2026', es: 'Cámara 2026' },
  'us-governor': { fr: 'Gouverneurs 2026', en: 'Governors 2026', es: 'Gobernadores 2026' } } as Record<string, Record<Locale, string>>)[desk.desk]?.[locale] : undefined;
const payload = {
  card: 'slate' as const,
  slug: `orbite-${labsKey}`,
  jurisdiction: `labs-${labsKey}`,
  title: 'Vote-Scope Labs',
  heading: TX.share(nSplit, deskName ?? refName),
  rows: pick.map((r) => ({
    name: r.name,
    where: TX.where(`${short(r.fo)} ${pct(r.po, locale)}`, `${short(r.fr)} ${pct(r.pr, locale)}`),
    fav: partyLabel(desk, r.fb, locale), color: partyColor(desk, r.fb), p: pct(r.pb, locale),
  })),
  thFav: TX.thFav, thP: TX.thP,
  voteDay: desk.election_date ?? '',
  foot: TX.foot(fmtDate(desk.as_of, locale)),
};
---

{rows.length > 0 && (
  <section class="lrc vs-block" aria-labelledby="lrc-title" id="lrc">
    <h2 id="lrc-title">{TX.title(rows.length)}</h2>
    <p class="lrc-dek">{TX.dek(nAgree, rows.length)}</p>
    <label class="lrc-toggle"><input type="checkbox" data-lrc-only /> {TX.only}</label>
    <div class="lrc-scroll">
      <table class="lrc-table" data-lrc>
        <thead><tr><th>{head}</th><th>{TX.ref}</th><th>{TX.orbit}</th><th>{TX.blend}</th></tr></thead>
        <tbody>
          {rows.map((r) => {
            const a = cell(r.fr, r.pr), b = cell(r.fo, r.po), c = cell(r.fb, r.pb);
            const href = localUrl(labsKey, locale, r.slug);
            return (
              <tr data-agree={r.agree ? '1' : '0'}>
                <td>{href ? <a href={href}>{r.name}</a> : r.name}{!r.agree && <span class="lrc-flag">{TX.split}</span>}</td>
                <td><span class="lrc-dot" style={`background:${a.color}`}></span>{a.label}{' '}<span class="lrc-p">{a.v}</span></td>
                <td><span class="lrc-dot" style={`background:${b.color}`}></span>{b.label}{' '}<span class="lrc-p">{b.v}</span></td>
                <td><span class="lrc-dot" style={`background:${c.color}`}></span><strong>{c.label}</strong>{' '}<span class="lrc-p">{c.v}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="vs-meta">{TX.foot(fmtDate(desk.as_of, locale))}</p>
    <RidingShareButton client:idle lang={locale} payload={payload} />
  </section>
)}

<script>
  document.querySelectorAll<HTMLInputElement>('[data-lrc-only]').forEach((box) => {
    const table = box.closest('.lrc')?.querySelector('[data-lrc]');
    box.addEventListener('change', () => {
      table?.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((tr) => {
        tr.hidden = box.checked && tr.dataset.agree === '1';
      });
    });
  });
</script>

<style>
  .lrc { margin-top: 64px; padding-top: 16px; }
  .lrc h2 { font-size: clamp(24px, 3.2vw, 32px); font-weight: 700; margin: 0 0 12px; }
  .lrc-dek { max-width: 72ch; margin: 0 0 12px; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .lrc-toggle { display: inline-flex; gap: 8px; align-items: center; font-size: 15px; color: var(--ink-2); margin-bottom: 12px; cursor: pointer; }
  .lrc-scroll { max-height: 620px; overflow: auto; border: 1px solid var(--rule); }
  .lrc-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .lrc-table th { position: sticky; top: 0; background: var(--paper); text-align: left; font-size: 13px; font-weight: 600; color: var(--ink-3); border-bottom: 1px solid var(--ink); padding: 8px 12px; white-space: nowrap; }
  .lrc-table td { border-bottom: 1px solid var(--rule); padding: 8px 12px; white-space: nowrap; }
  .lrc-table td a { color: var(--ink); }
  .lrc-dot { display: inline-block; width: 10px; height: 10px; margin-right: 8px; vertical-align: baseline; }
  .lrc-p { font-size: 14px; color: var(--ink-3); }
  .lrc-flag { margin-left: 8px; font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .lrc .vs-meta { margin: 8px 0 0; }
</style>
