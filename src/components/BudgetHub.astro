---
// /{lang}/budget/ : les juridictions, chacune avec sa dernière édition.
import PageHeader from './PageHeader.astro';
import StoryList from './StoryList.astro';
import { jurisdictions, latestFor } from '../lib/budget-data';
import { t, JURISDICTION_LABEL, TYPE_LABEL, editionLabel, budgetEdition, answerOf, type Locale } from '../lib/budget';

interface Props { locale: Locale }
const { locale } = Astro.props;
const COPY = {
  fr: { title: 'Budgets du Canada, de l’Ontario et du Québec', promise: 'Une page par budget : les chiffres, les secteurs et ce qui change selon votre situation. Les éditions passées restent en ligne.' },
  en: { title: 'Budgets of Canada, Ontario and Quebec', promise: 'One page per budget: the numbers, the sectors and what changes for you. Past editions stay online.' },
  es: { title: 'Presupuestos de Canadá, Ontario y Quebec', promise: 'Una página por presupuesto: las cifras, los sectores y lo que cambia para usted. Las ediciones anteriores siguen en línea.' },
}[locale];
const items = jurisdictions().map((slug) => {
  const d = latestFor(slug)!;
  return {
    meta: `${JURISDICTION_LABEL[slug]?.[locale] ?? slug} · ${TYPE_LABEL[d.type][locale]} · ${t(d.date_tabled, locale)}`,
    title: editionLabel(d, locale),
    text: answerOf(d, locale),
    href: budgetEdition(locale, d.slug, d.edition),
  };
});
---
<article data-content-area>
  <PageHeader title={COPY.title} promise={COPY.promise} />
  <div class="container bh-list"><StoryList items={items} /></div>
</article>
<style>.bh-list { padding-block: 32px 64px; }</style>
