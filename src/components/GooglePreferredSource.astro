---
/**
 * Official Google "preferred sources" badge — lets readers add Vote-Scope to
 * their preferred sources in Google Search/Top Stories. Uses Google's own
 * per-language badge images (light/dark variants swapped with the site theme).
 * Deep-link format per Google docs: google.com/preferences/source?q=<domain>.
 */
interface Props {
  locale: 'en' | 'fr' | 'es';
}
const { locale } = Astro.props;
const label = {
  en: 'Add Vote-Scope to your preferred sources on Google',
  fr: 'Ajouter Vote-Scope à vos sources préférées sur Google',
  es: 'Añade Vote-Scope a tus fuentes preferidas en Google',
}[locale];
---

<a
  class="gps"
  href="https://google.com/preferences/source?q=vote-scope.com"
  target="_blank"
  rel="noopener"
  aria-label={label}
  title={label}
>
  <img src={`/img/google-source/light_${locale}.png`} alt={label} width="676" height="213" loading="lazy" />
</a>

<style>
  .gps { display: inline-flex; margin-top: 14px; }
  .gps img { height: 40px; width: auto; display: block; }
</style>
