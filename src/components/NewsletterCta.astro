---
/**
 * Capture d'abonnés vers l'infolettre (Le Scope / The Scope).
 *
 * Volontairement SANS hydratation : Substack accepte un POST de formulaire
 * classique sur /api/v1/free?nojs=true, donc pas d'îlot, pas de JS, pas
 * d'iframe tierce. La page reste statique et le coût de rendu est nul.
 *
 * Le paramètre utm_source permet enfin de mesurer ce que le site rapporte
 * réellement à l'infolettre dans les statistiques Substack.
 */
interface Props {
  lang: 'fr' | 'en' | 'es';
  /** Placement, repris tel quel dans utm_content (ex. « quebec », « ridings »). */
  placement?: string;
}
const { lang, placement = 'desk' } = Astro.props;

const PUBS = {
  fr: 'https://kimleclerc.substack.com',
  en: 'https://leclercswarroom.substack.com',
  // Pas encore de publication hispanophone : on dirige vers l'anglaise.
  es: 'https://leclercswarroom.substack.com',
} as const;

const COPY = {
  fr: {
    eyebrow: "L'infolettre",
    title: 'Le Scope',
    blurb:
      'Les projections quand elles bougent, avec le raisonnement derrière. Gratuit, directement dans ta boîte.',
    placeholder: 'ton@courriel.com',
    cta: "S'abonner",
    note: 'Gratuit. Désabonnement en un clic.',
    aria: 'Adresse courriel',
  },
  en: {
    eyebrow: 'The newsletter',
    title: 'The Scope',
    blurb:
      'Projections when they move, with the reasoning behind them. Free, straight to your inbox.',
    placeholder: 'you@email.com',
    cta: 'Subscribe',
    note: 'Free. Unsubscribe in one click.',
    aria: 'Email address',
  },
  es: {
    eyebrow: 'El boletín',
    title: 'The Scope',
    blurb:
      'Las proyecciones cuando se mueven, con el razonamiento detrás. Gratis, en tu correo.',
    placeholder: 'tu@correo.com',
    cta: 'Suscribirse',
    note: 'Gratis. Cancela con un clic.',
    aria: 'Correo electrónico',
  },
} as const;

const c = COPY[lang];
const action = `${PUBS[lang]}/api/v1/free?nojs=true&utm_source=vote-scope.com&utm_medium=site&utm_content=${encodeURIComponent(placement)}`;
---

<section class="nl-cta">
  <div class="container">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2>{c.title}</h2>
    <p class="blurb">{c.blurb}</p>

    <form class="nl-form" action={action} method="post" target="_blank" rel="noopener">
      <label class="sr-only" for={`nl-email-${placement}`}>{c.aria}</label>
      <input
        id={`nl-email-${placement}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={c.placeholder}
      />
      <button type="submit">{c.cta}</button>
    </form>

    <p class="note">{c.note}</p>
  </div>
</section>

<style>
  .nl-cta {
    padding: 56px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .nl-cta h2 {
    margin: 8px 0 12px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  .blurb {
    max-width: 620px;
    color: var(--ink-2);
    margin: 0 0 20px;
    line-height: 1.55;
  }
  .nl-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 520px;
  }
  .nl-form input {
    flex: 1 1 240px;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
  }
  .nl-form input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .nl-form button {
    padding: 12px 22px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .nl-form button:hover {
    background: color-mix(in oklab, var(--ink) 80%, transparent);
  }
  .note {
    margin: 12px 0 0;
    color: var(--ink-2);
    font-size: 13px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
