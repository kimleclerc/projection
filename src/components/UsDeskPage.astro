---
import { partyName } from '../lib/party-names';
/**
 * Desk États-Unis — un seul corps pour /en/us/, /fr/us/ et /es/us/.
 *
 * Les trois routes étaient trois copies de 218 lignes qui ne différaient que
 * par la langue : chaque nouvel élément était empilé trois fois, jamais tout à
 * fait pareil (la méthodologie espagnole parlait encore de Monte Carlo un mois
 * après que les deux autres aient cessé). Une seule implémentation, une table
 * de textes — le motif que PollsHubPage et SpecialElectionEngine suivent déjà.
 *
 * HIÉRARCHIE : le mi-mandat du 3 novembre d'abord, puis ce qui remplit encore
 * sa carte (primaires, partielles vives), puis les indices, puis 2028, puis
 * les archives. L'ancienne page ouvrait sur une carte affiliée et fondait sept
 * objets sans rapport dans une seule grille « Instrument live ».
 */
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PageHeader from './PageHeader.astro';
import StoryList from './StoryList.astro';
import { longDate, num } from '../lib/format';
import MethodologyNote from './MethodologyNote.astro';
import PolymarketEmbed from './PolymarketEmbed.astro';
import AffiliateCard from './AffiliateCard.astro';
import DeskSections from './DeskSections.astro';
import UsTrioShare from '../islands/UsTrioShare.tsx';
import UsPreCount from './UsPreCount.astro';
import UsNeedle from '../islands/UsNeedle.tsx';
import UsNationalCalls from '../islands/UsNationalCalls.tsx';
import { US_LIVE_API_BASE, US_LIVE_EVENT_ID, US_LIVE_FALLBACK_API_BASE } from '../data/us-live';
import { usTrio } from '../data/us-live';
import { specialElections, type SpecialElectionConfig } from '../data/specialElections';

import ldiData from '../../web_data/us-lame-duck/latest.json';
import houseData from '../../web_data/us-house/latest.json';
import senateData from '../../web_data/us-senate/latest.json';
import governorData from '../../web_data/us-governor/latest.json';
import showdownData from '../../web_data/cusma-showdown/latest.json';
import presData from '../../web_data/us-president/latest.json';
import primaryDesk from '../../web_data/us-primaries/latest.json';

type Lang = 'en' | 'fr' | 'es';
interface Props { lang: Lang; }
const { lang } = Astro.props as Props;


type SeatParty = { party: string; seats_projected?: number; seats_median?: number; seats_mean?: number; p_majority: number; color: string };
const pick = (rows: SeatParty[], party: string) => rows.find((p) => p.party === party)!;

const ldi = ldiData.ldi;
const houseParties = houseData.parties as unknown as SeatParty[];
const senateParties = senateData.parties as unknown as SeatParty[];
const govParties = governorData.parties as unknown as SeatParty[];
const houseDem = pick(houseParties, 'us_dem');
const houseRep = pick(houseParties, 'us_rep');
const senateDem = pick(senateParties, 'us_dem');
const senateRep = pick(senateParties, 'us_rep');
const govDem = pick(govParties, 'us_dem');
const govRep = pick(govParties, 'us_rep');
// Les sièges ouverts sont le fait saillant du cycle gubernatorial : la moitié
// des courses n'a pas de sortant. Compté sur les données, jamais écrit en dur.
const govOpenSeats = (governorData.ridings as Array<{ open_seat?: boolean }>).filter((r) => r.open_seat).length;

const primaryMeta = (primaryDesk as any).meta;
const presRep = (presData as any).primary.rep;
const presDem = (presData as any).primary.dem;
const presRepLead = presRep.standings.find((s: any) => s.status !== 'ineligible') ?? presRep.standings[0];
const presDemLead = presDem.standings.find((s: any) => s.status !== 'ineligible') ?? presDem.standings[0];

/**
 * Partielles : une course sans date attend son bref, une course datée dans le
 * futur est vive, une course datée dans le passé est une archive. Les sept
 * étaient auparavant rendues à plat, un résultat d'avril à côté d'une vacance
 * ouverte.
 */
const today = new Date().toISOString().slice(0, 10);
const allSpecials = Object.values(specialElections);
const liveSpecials = allSpecials.filter((s) => !s.electionDate || s.electionDate >= today);
const pastSpecials = allSpecials
  .filter((s) => s.electionDate && s.electionDate < today)
  .sort((a, b) => (b.electionDate! < a.electionDate! ? -1 : 1));

const specialHref = (s: (typeof allSpecials)[number]) => s.paths[lang] ?? s.paths.en ?? '#';

// L'archive listait l'accroche anglaise quelle que soit la langue du desk.
const specialHeadline = (s: SpecialElectionConfig) =>
  (lang === 'fr' ? s.headline_fr : lang === 'es' ? s.headline_es : undefined) ?? s.headline;
const specialKicker = (s: SpecialElectionConfig) =>
  (lang === 'fr' ? s.kicker_fr : lang === 'es' ? s.kicker_es : undefined) ?? s.kicker;
const specialDek = (s: SpecialElectionConfig) =>
  (lang === 'fr' ? s.dek_fr : lang === 'es' ? s.dek_es : undefined) ?? s.dek;

// Une page, une question, une réponse. La question doit être celle que les gens
// tapent — « midterm elections 2026 » vaut 8 200 impressions sur trois mois —
// et la réponse doit être un chiffre du jour, pas une formule.
const pHouse = Math.round((houseDem?.p_majority ?? 0) * 100);
const pSenate = Math.round((senateDem?.p_majority ?? 0) * 100);

const COPY = {
  en: {
    title: 'Trump\u2019s 2026 Midterms — House, Senate and Governor Forecast — Vote-Scope',
    description: 'House control, Senate fragility, special elections, and the Lame-Duck Index in one place. Our final projection, and the results as the count comes in on November 3 — Vote-Scope.',
    breadcrumb: 'U.S.',
    heroTitle: `Democrats are favoured for the House at ${pHouse}%, and for the Senate at ${pSenate}%.`,
    heroPromise: "House, Senate and governors, all decided tonight, November 3, 2026: our final projection from public polls, before the first results.",
    govRaces: (n: number) => `36 races on the ballot · ${n} open seats.`,
    primaries: 'Primaries 2026',
    primariesCount: (decided: number, awaiting: number) => `${decided} nominations settled · ${awaiting} races still awaiting official results.`,
    radar: 'U.S. Latino Radar',
    radarBody: 'The House and Senate races where Latino electoral weight, competitiveness, and control of Congress intersect — ranked on a 100-point scale.',
    radarHref: '/en/us/latino-radar/',
    archiveEyebrow: 'Archive',
    archiveTitle: 'Before November 3',
    archiveHint: 'Kept for the record: the primaries and special elections that led up to the midterms.',
    archivePast: 'Special elections already decided',
    marketEyebrow: 'Prediction markets',
    marketBalance: 'U.S. Midterms 2026 — balance of power',
    marketPres: 'U.S. Presidential 2028',
    methodTitle: "How the U.S. forecasts are built",
    methodBody: "Each forecast starts from public polls, corrected for each pollster’s usual lean, then simulates the election district by district and state by state.",
    projTitle: "The forecasts",
    colRace: "Race",
    colD: "Democrats",
    colR: "Republicans",
    colChance: "Chance of a Democratic majority",
    indexTitle2: "The indexes",
    presTitle: "Beyond 2026",
    updated: "Updated",
    ldiTitle: "Lame-Duck Index",
    methodBullets: [
      "House polls feed a model that follows the national vote over time; the Senate and governors are modelled race by race, from state polls and the national climate.",
      "All races move together when the national mood shifts; that is what produces the seat ranges.",
      "A recent local poll pulls its own race toward it; polls more than 180 days old are left out.",
      "The Lame-Duck Index combines presidential approval, the economy, district margins and prediction markets into a score out of 100.",
      "Polymarket prices are shown next to our forecasts. They do not enter our calculations.",
    ],
    houseHref: '/en/us/house/', senateHref: '/en/us/senate/', govHref: '/en/us/governors/',
    primariesHref: '/en/us/primaries/', presHref: '/en/us/president/',
    ldiHref: '/en/us/indexes/lame-duck/', cusmaHref: '/en/indexes/cusma-showdown/',
    homeHref: 'https://vote-scope.com/en/',
  },
  fr: {
    title: 'Les mi-mandats de Trump 2026 — Chambre, Sénat, gouverneurs — Vote-Scope',
    description: "Contrôle de la Chambre, fragilité du Sénat, partielles et indice Canard boiteux réunis. Notre projection finale, puis les résultats au fil du dépouillement le 3 novembre — Vote-Scope.",
    breadcrumb: 'États-Unis',
    heroTitle: `Les démocrates sont favoris pour la Chambre à ${pHouse} %, et pour le Sénat à ${pSenate} %.`,
    heroPromise: "Chambre, Sénat et gouverneurs, tous décidés ce soir, 3 novembre 2026 : notre projection finale, tirée des sondages publics, avant les premiers résultats.",
    govRaces: (n: number) => `36 courses au bulletin · ${n} sièges ouverts.`,
    primaries: 'Primaires 2026',
    primariesCount: (decided: number, awaiting: number) => `${decided} investitures tranchées · ${awaiting} courses encore sans résultat officiel.`,
    radar: 'Radar Latino USA',
    radarBody: "Les courses Chambre et Sénat où l’électorat latino, la compétitivité et le contrôle du Congrès se rencontrent — classées sur 100.",
    radarHref: '/fr/us/radar-latino/',
    archiveEyebrow: 'Archives',
    archiveTitle: 'Avant le 3 novembre',
    archiveHint: 'Conservées pour mémoire : les primaires et les partielles qui ont précédé le mi-mandat.',
    archivePast: 'Partielles déjà tranchées',
    marketEyebrow: 'Marchés de prédiction',
    marketBalance: 'Mi-mandat américain 2026 — équilibre des pouvoirs',
    marketPres: 'Présidentielle américaine 2028',
    methodTitle: "Comment nous faisons les projections américaines",
    methodBody: "Chaque projection part des sondages publics, corrigés des écarts habituels de chaque institut, puis simule l’élection district par district et État par État.",
    projTitle: "Les projections",
    colRace: "Course",
    colD: "Démocrates",
    colR: "Républicains",
    colChance: "Chances de majorité démocrate",
    indexTitle2: "Les indices",
    presTitle: "Après 2026",
    updated: "Mis à jour",
    ldiTitle: "Indice Canard boiteux",
    methodBullets: [
      "Les sondages sur la Chambre alimentent un modèle qui suit le vote national dans le temps ; le Sénat et les gouverneurs sont projetés course par course, à partir des sondages d’État et du climat national.",
      "Toutes les courses bougent ensemble quand l’humeur nationale change ; c’est ce qui donne les fourchettes de sièges.",
      "Un sondage local récent tire sa course vers lui ; un sondage de plus de 180 jours est écarté.",
      "L’indice Canard boiteux combine l’approbation du président, l’économie, les marges des districts et les marchés de prédiction en un score sur 100.",
      "Les cotes de Polymarket sont affichées à côté de nos projections. Elles n’entrent pas dans nos calculs.",
    ],
    houseHref: '/fr/us/chambre/', senateHref: '/fr/us/senat/', govHref: '/fr/us/gouverneurs/',
    primariesHref: '/fr/us/primaires/', presHref: '/fr/us/presidentielle/',
    ldiHref: '/fr/us/indexes/lame-duck/', cusmaHref: '/fr/indexes/cusma-showdown/',
    homeHref: 'https://vote-scope.com/fr/',
  },
  es: {
    title: 'Las intermedias de Trump 2026 — Cámara, Senado, gobernadores — Vote-Scope',
    description: 'Control de la Cámara, fragilidad del Senado, elecciones especiales y el índice Pato Cojo en un solo lugar. Nuestra proyección final y los resultados a medida que avanza el recuento el 3 de noviembre — Vote-Scope.',
    breadcrumb: 'EE. UU.',
    heroTitle: `Los demócratas son favoritos para la Cámara con un ${pHouse} % y para el Senado con un ${pSenate} %.`,
    heroPromise: "Cámara, Senado y gobernadores, todos decididos esta noche, 3 de noviembre de 2026: nuestra proyección final, a partir de encuestas públicas, antes de los primeros resultados.",
    govRaces: (n: number) => `36 contiendas en la papeleta · ${n} puestos abiertos.`,
    primaries: 'Primarias 2026',
    primariesCount: (decided: number, awaiting: number) => `${decided} nominaciones decididas · ${awaiting} contiendas aún sin resultado oficial.`,
    radar: 'Radar Latino USA',
    radarBody: 'Las contiendas de Cámara y Senado donde coinciden el peso electoral latino, la competitividad y el control del Congreso — clasificadas sobre 100.',
    radarHref: '/es/us/radar-latino/',
    archiveEyebrow: 'Archivo',
    archiveTitle: 'Antes del 3 de noviembre',
    archiveHint: 'Conservadas como registro: las primarias y elecciones especiales previas a las intermedias.',
    archivePast: 'Especiales ya decididas',
    marketEyebrow: 'Mercados de predicción',
    marketBalance: 'Elecciones intermedias 2026 — equilibrio de poder',
    marketPres: 'Elección presidencial 2028',
    methodTitle: "Cómo hacemos las proyecciones de EE. UU.",
    methodBody: "Cada proyección parte de encuestas públicas, corregidas según el sesgo habitual de cada encuestadora, y simula la elección distrito por distrito y estado por estado.",
    projTitle: "Las proyecciones",
    colRace: "Contienda",
    colD: "Demócratas",
    colR: "Republicanos",
    colChance: "Probabilidad de mayoría demócrata",
    indexTitle2: "Los índices",
    presTitle: "Después de 2026",
    updated: "Actualizado",
    ldiTitle: "Índice Pato Cojo",
    methodBullets: [
      "Las encuestas de la Cámara alimentan un modelo que sigue el voto nacional en el tiempo; el Senado y los gobernadores se proyectan contienda por contienda, con encuestas estatales y el clima nacional.",
      "Todas las contiendas se mueven juntas cuando cambia el ánimo nacional; de ahí salen las horquillas de escaños.",
      "Una encuesta local reciente acerca su contienda hacia ella; las encuestas de más de 180 días se descartan.",
      "El índice Pato Cojo combina la aprobación presidencial, la economía, los márgenes de distrito y los mercados de predicción en una puntuación sobre 100.",
      "Las cuotas de Polymarket se muestran junto a nuestras proyecciones. No entran en nuestros cálculos.",
    ],
    houseHref: '/es/us/house/', senateHref: '/es/us/senate/', govHref: '/es/us/gobernadores/',
    primariesHref: '/es/us/primarias/', presHref: '/es/us/presidencial/',
    ldiHref: '/es/us/indexes/lame-duck/', cusmaHref: '/es/indexes/cusma-showdown/',
    homeHref: 'https://vote-scope.com/es/',
  },
} as const;

const t = COPY[lang];
const trio = usTrio(lang);
const liveUrl = (base: string) => `${base.replace(/\/$/, '')}/api/v1/elections/${US_LIVE_EVENT_ID}/live.json`;
const canonical = `https://vote-scope.com/${lang}/us/`;
const ldiLabel = partyName(ldi, lang);
const showdownLabel = lang === 'fr' ? showdownData.showdown.label_fr
  : lang === 'es' ? showdownData.showdown.label_es : showdownData.showdown.label_en;

const pctTxt = (p: number) => {
  const v = p * 100;
  const n = v > 99 ? (lang === 'en' ? '>99' : '> 99') : v < 1 ? (lang === 'en' ? '<1' : '< 1') : String(Math.round(v));
  return lang === 'en' ? `${n}%` : `${n}\u00a0%`;
};
const othOf = (rows: SeatParty[]) => rows.find((p) => p.party === 'us_oth')?.seats_projected ?? 0;
const senateOth = othOf(senateParties);
const houseOth = othOf(houseParties);
const seatNote = (n: number, oth: number) => {
  const base = lang === 'fr' ? `${n} sièges` : lang === 'es' ? `${n} escaños` : `${n} seats`;
  if (!oth) return base;
  return base + (lang === 'fr' ? `, dont ${oth} indépendant${oth > 1 ? 's' : ''} ou autre${oth > 1 ? 's' : ''}` : lang === 'es' ? `, incluido${oth > 1 ? 's' : ''} ${oth} independiente${oth > 1 ? 's' : ''} u otro${oth > 1 ? 's' : ''}` : `, including ${oth} independent or other`);
};
const chambers = [
  { label: lang === 'fr' ? 'Chambre des représentants' : lang === 'es' ? 'Cámara de Representantes' : 'House of Representatives', href: t.houseHref,
    d: houseDem.seats_median!, r: 435 - houseDem.seats_median!, chance: pctTxt(houseDem.p_majority), note: seatNote(435, houseOth) },
  { label: lang === 'fr' ? 'Sénat' : lang === 'es' ? 'Senado' : 'Senate', href: t.senateHref,
    d: senateDem.seats_projected ?? Math.round(senateDem.seats_mean!), r: senateRep.seats_projected ?? Math.round(senateRep.seats_mean!), chance: pctTxt(senateDem.p_majority), note: seatNote(100, senateOth) },
  { label: lang === 'fr' ? 'Gouverneurs' : lang === 'es' ? 'Gobernadores' : 'Governors', href: t.govHref,
    d: govDem.seats_projected ?? Math.round(govDem.seats_mean!), r: govRep.seats_projected ?? Math.round(govRep.seats_mean!), chance: pctTxt(govDem.p_majority), note: `${lang === 'fr' ? 'Les 50 États' : lang === 'es' ? 'Los 50 estados' : 'All 50 states'}${lang === 'fr' ? ' ; ' : '; '}${t.govRaces(govOpenSeats).replace(' · ', ', ').replace(/^./, (c) => c.toLowerCase())}` },
];

const firstSentence = (txt: string) => { const m = /^(.+?[.!?])(\s|$)/.exec(txt.trim()); return m ? m[1] : txt; };
// Le 3 novembre, primaires et partielles vacantes passent aux archives : la
// carte qu'elles remplissaient se remplit ce soir.
const archiveItems = [
  { title: t.primaries, text: t.primariesCount(primaryMeta.n_races_decided, primaryMeta.n_races_awaiting), href: t.primariesHref },
  ...liveSpecials.map((sp) => ({ meta: specialKicker(sp), title: specialHeadline(sp).replace(/\n/g, ' '), text: firstSentence(specialDek(sp)), href: specialHref(sp) })),
];
const ldiDelta = `${ldi.delta_7d >= 0 ? '+' : '−'}${num(Math.abs(ldi.delta_7d), lang, 1)}`;
const indexItems = [
  { meta: lang === 'fr' ? `${Math.round(ldi.score)} sur 100 · ${ldiLabel} · ${ldiDelta} en 7 jours` : lang === 'es' ? `${Math.round(ldi.score)} sobre 100 · ${ldiLabel} · ${ldiDelta} en 7 días` : `${Math.round(ldi.score)} out of 100 · ${ldiLabel} · ${ldiDelta} over 7 days`,
    color: ldi.zone_color, title: t.ldiTitle, text: lang === 'fr' ? 'Le poids politique qu’il reste au président, mesuré sur 100.' : lang === 'es' ? 'El peso político que le queda al presidente, medido sobre 100.' : 'How much political weight the president has left, on a 100-point scale.', href: t.ldiHref },
  { title: t.radar, text: t.radarBody, href: t.radarHref },
  { meta: lang === 'fr' ? `Écart de ${Math.round(showdownData.showdown.gap)} points · ${showdownLabel}` : lang === 'es' ? `Diferencia de ${Math.round(showdownData.showdown.gap)} puntos · ${showdownLabel}` : `${Math.round(showdownData.showdown.gap)}-point gap · ${showdownLabel}`,
    title: lang === 'fr' ? 'Guerre commerciale Canada–États-Unis' : lang === 'es' ? 'Guerra comercial Canadá–EE. UU.' : 'Canada–U.S. trade war', text: lang === 'fr' ? 'Le rapport de force entre Ottawa et Washington.' : lang === 'es' ? 'La relación de fuerzas entre Ottawa y Washington.' : 'The balance of power between Ottawa and Washington.', href: t.cusmaHref },
];
const presItems = [
  { meta: lang === 'fr' ? `Primaires : ${presRepLead.short_label} ${Math.round(presRepLead.share)} % chez les républicains, ${presDemLead.short_label} ${Math.round(presDemLead.share)} % chez les démocrates`
      : lang === 'es' ? `Primarias: ${presRepLead.short_label} ${Math.round(presRepLead.share)} % entre los republicanos, ${presDemLead.short_label} ${Math.round(presDemLead.share)} % entre los demócratas`
      : `Primaries: ${presRepLead.short_label} ${Math.round(presRepLead.share)}% among Republicans, ${presDemLead.short_label} ${Math.round(presDemLead.share)}% among Democrats`,
    title: lang === 'fr' ? 'Présidentielle de 2028' : lang === 'es' ? 'Presidencial de 2028' : 'The 2028 presidential race',
    text: lang === 'fr' ? 'Les candidatures dans les deux partis et la carte du collège électoral.' : lang === 'es' ? 'Las candidaturas en ambos partidos y el mapa del colegio electoral.' : 'The candidates in both parties and the electoral-college map.', href: t.presHref },
];
---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={lang}
  currentPage="usa-hub"
  ogImage={`https://vote-scope.com${trio.image}?v=${trio.runDate}`}
  alternates={{ en: 'https://vote-scope.com/en/us/', fr: 'https://vote-scope.com/fr/us/', es: 'https://vote-scope.com/es/us/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: t.title,
      url: canonical,
      inLanguage: lang,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: t.homeHref },
        { '@type': 'ListItem', position: 2, name: t.breadcrumb, item: canonical },
      ],
    },
  ]}
>
  <PageHeader title={t.heroTitle} promise={t.heroPromise} preferredSourceLocale={lang} />

  <div class="container">
    <UsNationalCalls client:load lang={lang} liveUrl={liveUrl(US_LIVE_API_BASE)} fallbackUrl={liveUrl(US_LIVE_FALLBACK_API_BASE)}
      demColor={houseDem.color} repColor={houseRep.color} pageUrl={canonical} />
  </div>

  <UsPreCount lang={lang} />

  <section class="container us-block">
    <UsNeedle client:load lang={lang} liveUrl={liveUrl(US_LIVE_API_BASE)} fallbackUrl={liveUrl(US_LIVE_FALLBACK_API_BASE)}
      demColor={houseDem.color} repColor={houseRep.color} />
  </section>

  <section class="container us-block" aria-labelledby="us-proj">
    <h2 id="us-proj">{t.projTitle}</h2>
    <div class="table-scroll">
      <table class="us-table">
        <thead>
          <tr><th>{t.colRace}</th><th class="num">{t.colD}</th><th class="num">{t.colR}</th><th class="num">{t.colChance}</th></tr>
        </thead>
        <tbody>
          {chambers.map((c) => (
            <tr>
              <th scope="row"><a class="vs-link" href={c.href}>{c.label}</a>{c.note && <span class="us-note">{c.note}</span>}</th>
              <td class="num"><span class="dot" style={`background:${houseDem.color}`} aria-hidden="true"></span>{c.d}</td>
              <td class="num"><span class="dot" style={`background:${houseRep.color}`} aria-hidden="true"></span>{c.r}</td>
              <td class="num">{c.chance}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="vs-meta">{t.updated} : {longDate(houseData.meta.run_date, lang)}</p>
  </section>

  <section class="container us-block">
    <UsTrioShare client:visible lang={lang} text={trio.text} url={trio.url} image={trio.image} runDate={trio.runDate} />
  </section>

  <section class="container us-block">
    <StoryList heading={t.indexTitle2} items={indexItems} size="sm" />
  </section>

  <section class="container us-block">
    <StoryList heading={t.presTitle} items={presItems} size="sm" />
  </section>

  <section class="container us-block" aria-labelledby="us-markets">
    <h2 id="us-markets">{t.marketEyebrow}</h2>
    <PolymarketEmbed lang={lang} slug="2026-balance-of-power-d-senate-d-house-949" title={t.marketBalance} />
    <PolymarketEmbed lang={lang} slug="will-gavin-newsom-win-the-2028-us-presidential-election" title={t.marketPres} />
  </section>

  <section class="content-band">
    <div class="container">
      <AffiliateCard partner="proton" lang={lang} visual placement="us-desk" />
    </div>
  </section>

  <section class="container us-block" aria-labelledby="us-archive">
    <h2 id="us-archive">{t.archiveEyebrow} · {t.archiveTitle}</h2>
    <p class="us-small">{t.archiveHint}</p>
    <StoryList items={archiveItems} size="sm" />
    {pastSpecials.length > 0 && (
      <details class="us-archive">
        <summary>{t.archivePast} ({pastSpecials.length})</summary>
        <ul>
          {pastSpecials.map((s) => (
            <li>
              <a href={specialHref(s)}>{specialHeadline(s).replace(/\n/g, ' ')}</a>
              <span class="us-small"> · {longDate(s.electionDate, lang)}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <DeskSections lang={lang} desk="us" />

  <MethodologyNote
    title={t.methodTitle}
    body={t.methodBody}
    bullets={t.methodBullets}
  />
</EditorialLayout>

