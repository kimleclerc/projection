---
/**
 * Desk États-Unis — un seul corps pour /en/us/, /fr/us/ et /es/us/.
 *
 * Les trois routes étaient trois copies de 218 lignes qui ne différaient que
 * par la langue : chaque nouvel élément était empilé trois fois, jamais tout à
 * fait pareil (la méthodologie espagnole parlait encore de Monte Carlo un mois
 * après que les deux autres aient cessé). Une seule implémentation, une table
 * de textes — le motif que PollsHubPage et SpecialElectionEngine suivent déjà.
 *
 * HIÉRARCHIE : le mi-mandat du 3 novembre d'abord, puis ce qui remplit encore
 * sa carte (primaires, partielles vives), puis les indices, puis 2028, puis
 * les archives. L'ancienne page ouvrait sur une carte affiliée et fondait sept
 * objets sans rapport dans une seule grille « Instrument live ».
 */
import EditorialLayout from '../layouts/EditorialLayout.astro';
import EditorialHero from './EditorialHero.astro';
import MarketCheck from './MarketCheck.astro';
import MethodologyNote from './MethodologyNote.astro';
import AnimatedNumber from '../islands/AnimatedNumber';
import PolymarketEmbed from './PolymarketEmbed.astro';
import AffiliateCard from './AffiliateCard.astro';
import DeskSections from './DeskSections.astro';
import { specialElections } from '../data/specialElections';

import ldiData from '../../web_data/us-lame-duck/latest.json';
import houseData from '../../web_data/us-house/latest.json';
import senateData from '../../web_data/us-senate/latest.json';
import governorData from '../../web_data/us-governor/latest.json';
import showdownData from '../../web_data/cusma-showdown/latest.json';
import presData from '../../web_data/us-president/latest.json';
import primaryDesk from '../../web_data/us-primaries/latest.json';

type Lang = 'en' | 'fr' | 'es';
interface Props { lang: Lang; }
const { lang } = Astro.props as Props;

/** Jour du mi-mandat — la seule date autour de laquelle cette page s'organise. */
const MIDTERM = '2026-11-03';

type SeatParty = { party: string; seats_projected?: number; seats_mean?: number; p_majority: number; color: string };
const pick = (rows: SeatParty[], party: string) => rows.find((p) => p.party === party)!;

const ldi = ldiData.ldi;
const houseParties = houseData.parties as unknown as SeatParty[];
const senateParties = senateData.parties as unknown as SeatParty[];
const govParties = governorData.parties as unknown as SeatParty[];
const houseDem = pick(houseParties, 'us_dem');
const houseRep = pick(houseParties, 'us_rep');
const senateDem = pick(senateParties, 'us_dem');
const senateRep = pick(senateParties, 'us_rep');
const govDem = pick(govParties, 'us_dem');
const govRep = pick(govParties, 'us_rep');
// Les sièges ouverts sont le fait saillant du cycle gubernatorial : la moitié
// des courses n'a pas de sortant. Compté sur les données, jamais écrit en dur.
const govOpenSeats = (governorData.ridings as Array<{ open_seat?: boolean }>).filter((r) => r.open_seat).length;

const deltaSign = ldi.delta_7d >= 0 ? '+' : '';
const primaryMeta = (primaryDesk as any).meta;
const nextPrimary = (primaryDesk as any).upcoming?.[0];
const nextPrimaryStates = [...new Set(((primaryDesk as any).upcoming ?? [])
  .filter((g: any) => g.primary_date === nextPrimary?.primary_date)
  .map((g: any) => g.state_name[lang]))].join(' · ');

const presRep = (presData as any).primary.rep;
const presDem = (presData as any).primary.dem;
const presRepLead = presRep.standings.find((s: any) => s.status !== 'ineligible') ?? presRep.standings[0];
const presDemLead = presDem.standings.find((s: any) => s.status !== 'ineligible') ?? presDem.standings[0];

/**
 * Partielles : une course sans date attend son bref, une course datée dans le
 * futur est vive, une course datée dans le passé est une archive. Les sept
 * étaient auparavant rendues à plat, un résultat d'avril à côté d'une vacance
 * ouverte.
 */
const today = new Date().toISOString().slice(0, 10);
const allSpecials = Object.values(specialElections);
const liveSpecials = allSpecials.filter((s) => !s.electionDate || s.electionDate >= today);
const pastSpecials = allSpecials
  .filter((s) => s.electionDate && s.electionDate < today)
  .sort((a, b) => (b.electionDate! < a.electionDate! ? -1 : 1));

const specialHref = (s: (typeof allSpecials)[number]) => s.paths[lang] ?? s.paths.en ?? '#';

const COPY = {
  en: {
