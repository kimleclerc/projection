const t = COPY[lang];
const canonical = `https://vote-scope.com/${lang}/us/`;
const ldiLabel = partyName(ldi, lang);
const showdownLabel = lang === 'fr' ? showdownData.showdown.label_fr
  : lang === 'es' ? showdownData.showdown.label_es : showdownData.showdown.label_en;

const pctTxt = (p: number) => {
  const v = p * 100;
  const n = v > 99 ? (lang === 'en' ? '>99' : '> 99') : v < 1 ? (lang === 'en' ? '<1' : '< 1') : String(Math.round(v));
  return lang === 'en' ? `${n}%` : `${n}\u00a0%`;
};
const othOf = (rows: SeatParty[]) => rows.find((p) => p.party === 'us_oth')?.seats_projected ?? 0;
const senateOth = othOf(senateParties);
const houseOth = othOf(houseParties);
const seatNote = (n: number, oth: number) => {
  const base = lang === 'fr' ? `${n} sièges` : lang === 'es' ? `${n} escaños` : `${n} seats`;
  if (!oth) return base;
  return base + (lang === 'fr' ? `, dont ${oth} indépendant${oth > 1 ? 's' : ''} ou autre${oth > 1 ? 's' : ''}` : lang === 'es' ? `, incluido${oth > 1 ? 's' : ''} ${oth} independiente${oth > 1 ? 's' : ''} u otro${oth > 1 ? 's' : ''}` : `, including ${oth} independent or other`);
};
const chambers = [
  { label: lang === 'fr' ? 'Chambre des représentants' : lang === 'es' ? 'Cámara de Representantes' : 'House of Representatives', href: t.houseHref,
    d: houseDem.seats_projected!, r: houseRep.seats_projected!, chance: pctTxt(houseDem.p_majority), note: seatNote(435, houseOth) },
  { label: lang === 'fr' ? 'Sénat' : lang === 'es' ? 'Senado' : 'Senate', href: t.senateHref,
    d: senateDem.seats_projected ?? Math.round(senateDem.seats_mean!), r: senateRep.seats_projected ?? Math.round(senateRep.seats_mean!), chance: pctTxt(senateDem.p_majority), note: seatNote(100, senateOth) },
  { label: lang === 'fr' ? 'Gouverneurs' : lang === 'es' ? 'Gobernadores' : 'Governors', href: t.govHref,
    d: govDem.seats_projected ?? Math.round(govDem.seats_mean!), r: govRep.seats_projected ?? Math.round(govRep.seats_mean!), chance: '—', note: `${lang === 'fr' ? 'Les 50 États' : lang === 'es' ? 'Los 50 estados' : 'All 50 states'}${lang === 'fr' ? ' ; ' : '; '}${t.govRaces(govOpenSeats).replace(' · ', ', ').replace(/^./, (c) => c.toLowerCase())}` },
];

const firstSentence = (txt: string) => { const m = /^(.+?[.!?])(\s|$)/.exec(txt.trim()); return m ? m[1] : txt; };
const untilItems = [
  { meta: nextPrimary ? `${t.primariesNext} ${nextPrimaryStates}` : undefined, title: t.primaries, text: t.primariesCount(primaryMeta.n_races_decided, primaryMeta.n_races_awaiting), href: t.primariesHref },
  ...liveSpecials.map((sp) => ({ meta: specialKicker(sp), title: specialHeadline(sp).replace(/\n/g, ' '), text: firstSentence(specialDek(sp)), href: specialHref(sp) })),
  (() => {
    const ev: any = earlyVote; const n = ev.states.length;
    const asOf = new Date(`${ev.meta.as_of}T12:00:00`).toLocaleDateString(lang === 'fr' ? 'fr-CA' : lang === 'es' ? 'es' : 'en-US', { day: 'numeric', month: 'long' });
    return {
      meta: lang === 'fr' ? `${n} États · données au ${asOf}` : lang === 'es' ? `${n} estados · datos al ${asOf}` : `${n} states · data as of ${asOf}`,
      title: lang === 'fr' ? 'Vote anticipé : qui a déjà voté ?' : lang === 'es' ? 'Voto anticipado: ¿quién ya votó?' : 'Early vote: who has already voted?',
      text: lang === 'fr' ? 'Démocrates, républicains et non-affiliés parmi les bulletins déjà déposés, comparés au même stade de 2022.' : lang === 'es' ? 'Demócratas, republicanos y no afiliados entre las papeletas ya emitidas, frente al mismo momento de 2022.' : 'Democrats, Republicans and unaffiliated voters among ballots already cast, compared with the same point in 2022.',
      href: lang === 'fr' ? '/fr/us/vote-anticipe/' : lang === 'es' ? '/es/us/voto-anticipado/' : '/en/us/early-vote/',
    };
  })(),
];
const ldiDelta = `${ldi.delta_7d >= 0 ? '+' : '−'}${num(Math.abs(ldi.delta_7d), lang, 1)}`;
const indexItems = [
  { meta: lang === 'fr' ? `${Math.round(ldi.score)} sur 100 · ${ldiLabel} · ${ldiDelta} en 7 jours` : lang === 'es' ? `${Math.round(ldi.score)} sobre 100 · ${ldiLabel} · ${ldiDelta} en 7 días` : `${Math.round(ldi.score)} out of 100 · ${ldiLabel} · ${ldiDelta} over 7 days`,
    color: ldi.zone_color, title: t.ldiTitle, text: lang === 'fr' ? 'Ce qu’il reste de poids au président avant les élections de mi-mandat.' : lang === 'es' ? 'El peso que le queda al presidente antes de las intermedias.' : 'How much weight the president has left before the midterms.', href: t.ldiHref },
  { title: t.radar, text: t.radarBody, href: t.radarHref },
  { meta: lang === 'fr' ? `Écart de ${Math.round(showdownData.showdown.gap)} points · ${showdownLabel}` : lang === 'es' ? `Diferencia de ${Math.round(showdownData.showdown.gap)} puntos · ${showdownLabel}` : `${Math.round(showdownData.showdown.gap)}-point gap · ${showdownLabel}`,
    title: lang === 'fr' ? 'Guerre commerciale Canada–États-Unis' : lang === 'es' ? 'Guerra comercial Canadá–EE. UU.' : 'Canada–U.S. trade war', text: lang === 'fr' ? 'Le rapport de force entre Ottawa et Washington.' : lang === 'es' ? 'La relación de fuerzas entre Ottawa y Washington.' : 'The balance of power between Ottawa and Washington.', href: t.cusmaHref },
];
const presItems = [
  { meta: lang === 'fr' ? `Primaires : ${presRepLead.short_label} ${Math.round(presRepLead.share)} % chez les républicains, ${presDemLead.short_label} ${Math.round(presDemLead.share)} % chez les démocrates`
      : lang === 'es' ? `Primarias: ${presRepLead.short_label} ${Math.round(presRepLead.share)} % entre los republicanos, ${presDemLead.short_label} ${Math.round(presDemLead.share)} % entre los demócratas`
      : `Primaries: ${presRepLead.short_label} ${Math.round(presRepLead.share)}% among Republicans, ${presDemLead.short_label} ${Math.round(presDemLead.share)}% among Democrats`,
    title: lang === 'fr' ? 'Présidentielle de 2028' : lang === 'es' ? 'Presidencial de 2028' : 'The 2028 presidential race',
    text: lang === 'fr' ? 'Les candidatures dans les deux partis et la carte du collège électoral.' : lang === 'es' ? 'Las candidaturas en ambos partidos y el mapa del colegio electoral.' : 'The candidates in both parties and the electoral-college map.', href: t.presHref },
];
---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={lang}
  currentPage="usa-hub"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/us/', fr: 'https://vote-scope.com/fr/us/', es: 'https://vote-scope.com/es/us/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: t.title,
      url: canonical,
      inLanguage: lang,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: t.homeHref },
        { '@type': 'ListItem', position: 2, name: t.breadcrumb, item: canonical },
      ],
    },
  ]}
>
  <PageHeader title={t.heroTitle} promise={t.heroPromise} preferredSourceLocale={lang} />

  <section class="container us-block" aria-labelledby="us-proj">
    <h2 id="us-proj">{t.projTitle}</h2>
    <div class="table-scroll">
      <table class="us-table">
        <thead>
          <tr><th>{t.colRace}</th><th class="num">{t.colD}</th><th class="num">{t.colR}</th><th class="num">{t.colChance}</th></tr>
        </thead>
        <tbody>
          {chambers.map((c) => (
            <tr>
              <th scope="row"><a class="vs-link" href={c.href}>{c.label}</a>{c.note && <span class="us-note">{c.note}</span>}</th>
              <td class="num"><span class="dot" style={`background:${houseDem.color}`} aria-hidden="true"></span>{c.d}</td>
              <td class="num"><span class="dot" style={`background:${houseRep.color}`} aria-hidden="true"></span>{c.r}</td>
              <td class="num">{c.chance}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="vs-meta">{t.updated} : {longDate(houseData.meta.run_date, lang)}</p>
  </section>

  <section class="container us-block">
    <StoryList heading={t.untilTitle} items={untilItems} size="sm" />
    {pastSpecials.length > 0 && (
      <details class="us-archive">
        <summary>{t.archiveTitle} ({pastSpecials.length})</summary>
        <ul>
          {pastSpecials.map((s) => (
            <li>
              <a href={specialHref(s)}>{specialHeadline(s).replace(/\n/g, ' ')}</a>
              <span class="us-small"> · {longDate(s.electionDate, lang)}</span>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <section class="container us-block">
    <StoryList heading={t.indexTitle2} items={indexItems} size="sm" />
  </section>

  <section class="container us-block">
    <StoryList heading={t.presTitle} items={presItems} size="sm" />
  </section>

  <section class="container us-block" aria-labelledby="us-markets">
    <h2 id="us-markets">{t.marketEyebrow}</h2>
    <PolymarketEmbed lang={lang} slug="2026-balance-of-power-d-senate-d-house-949" title={t.marketBalance} />
    <PolymarketEmbed lang={lang} slug="will-gavin-newsom-win-the-2028-us-presidential-election" title={t.marketPres} />
  </section>

  <section class="content-band">
    <div class="container">
      <AffiliateCard partner="proton" lang={lang} visual placement="us-desk" />
    </div>
  </section>

  <DeskSections lang={lang} desk="us" />

  <MethodologyNote
    title={t.methodTitle}
    body={t.methodBody}
    bullets={t.methodBullets}
  />
</EditorialLayout>

<style>
  .us-block { padding-block: 32px; }
  .us-block h2 { margin: 0 0 12px; font-size: clamp(24px, 3vw, 30px); font-weight: 700; }
  .us-table { width: 100%; border-collapse: collapse; border-top: 4px solid var(--ink); font-size: 17px; }
  .us-table th, .us-table td { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .us-table thead th { font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .us-table tbody th { font-weight: 700; }
  .us-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .us-note { display: block; margin-top: 2px; font-size: 14px; font-weight: 400; color: var(--ink-3); }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; }
  .us-small { font-size: 14px; color: var(--ink-3); }
  .us-archive { margin-top: 16px; }
  .us-archive summary { cursor: pointer; font-weight: 600; }
  .us-archive ul { margin: 0.75rem 0 0; padding-left: 1.1rem; }
  .us-archive li { margin-bottom: 0.35rem; }
</style>
