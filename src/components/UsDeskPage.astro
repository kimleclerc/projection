const t = COPY[lang];
const canonical = `https://vote-scope.com/${lang}/us/`;
const ldiLabel = lang === 'fr' ? ldi.label_fr : ldi.label_en;
const showdownLabel = lang === 'fr' ? showdownData.showdown.label_fr
  : lang === 'es' ? showdownData.showdown.label_es : showdownData.showdown.label_en;
---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={lang}
  currentPage="usa-hub"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/us/', fr: 'https://vote-scope.com/fr/us/', es: 'https://vote-scope.com/es/us/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: t.title,
      url: canonical,
      inLanguage: lang,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: t.homeHref },
        { '@type': 'ListItem', position: 2, name: t.breadcrumb, item: canonical },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    promise={t.heroPromise}
    question={t.heroQuestion}
    primaryHref={t.ldiHref}
    primaryLabel={t.heroPrimary}
    secondaryHref={t.indexesHref}
    secondaryLabel={t.heroSecondary}
    preferredSourceLocale={lang}
  />

  <section class="content-band us-midterm">
    <div class="container">
      <p class="eyebrow">{t.midtermEyebrow}</p>
      <h2>{t.midtermTitle}</h2>
      <p class="us-lede">{t.midtermLede}</p>
      <p class="us-countdown">
        <strong data-midterm-days data-midterm={MIDTERM}>—</strong>
        <span
          data-midterm-label
          data-day={t.dayLabel}
          data-days={t.daysLabel}
          data-today={t.todayLabel}
        >{t.daysLabel}</span>
      </p>

      <div class="us-chambers">
        <article class="note-card us-chamber" style={`--accent:${houseDem.color};`}>
          <p class="eyebrow">{t.house}</p>
          <p class="us-seats">
            <span class="us-seat-d"><AnimatedNumber client:visible value={houseDem.seats_projected!} /></span>
            <span class="us-seat-sep">·</span>
            <span class="us-seat-r"><AnimatedNumber client:visible value={houseRep.seats_projected!} /></span>
            <span class="us-seat-total">{t.seatsOf} 435</span>
          </p>
          <p class="us-majority">{t.majorityD} : <strong>{Math.round(houseDem.p_majority * 100)} %</strong></p>
          <a href={t.houseHref} class="cta-link">{t.houseCta}</a>
        </article>

        <article class="note-card us-chamber" style={`--accent:${senateDem.color};`}>
          <p class="eyebrow">{t.senate}</p>
          <p class="us-seats">
            <span class="us-seat-d"><AnimatedNumber client:visible value={Math.round(senateDem.seats_mean!)} /></span>
            <span class="us-seat-sep">·</span>
            <span class="us-seat-r"><AnimatedNumber client:visible value={Math.round(senateRep.seats_mean!)} /></span>
            <span class="us-seat-total">{t.seatsOf} 100</span>
          </p>
          <p class="us-majority">{t.majorityD} : <strong>{Math.round(senateDem.p_majority * 100)} %</strong></p>
          <a href={t.senateHref} class="cta-link">{t.senateCta}</a>
        </article>

        <article class="note-card us-chamber" style={`--accent:${govDem.color};`}>
          <p class="eyebrow">{t.governors}</p>
          <p class="us-seats">
            <span class="us-seat-d"><AnimatedNumber client:visible value={Math.round(govDem.seats_mean!)} /></span>
            <span class="us-seat-sep">·</span>
            <span class="us-seat-r"><AnimatedNumber client:visible value={Math.round(govRep.seats_mean!)} /></span>
            <span class="us-seat-total">{t.seatsOf} 50</span>
          </p>
          <p class="us-majority">{t.govRaces(govOpenSeats)}</p>
          <a href={t.govHref} class="cta-link">{t.govCta}</a>
        </article>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.roadEyebrow}</p>
      <h2>{t.roadTitle}</h2>
      <div class="content-grid-2">
        <article class="note-card">
          <p class="eyebrow">{t.primaries}</p>
          {nextPrimary && <p><strong>{t.primariesNext} {nextPrimaryStates}</strong></p>}
          <p class="us-small">{t.primariesCount(primaryMeta.n_races_decided, primaryMeta.n_races_awaiting)}</p>
          <a href={t.primariesHref} class="cta-link">{t.primariesCta}</a>
        </article>
        <div class="us-stack">
          <p class="eyebrow">{t.liveSpecials}</p>
          {liveSpecials.length === 0 && <p class="us-small">{t.noLiveSpecials}</p>}
          {liveSpecials.map((s) => (
            <a class="note-card us-special" href={specialHref(s)}>
              <p class="eyebrow">{s.kicker}</p>
              <h3>{s.headline.replace(/\n/g, ' ')}</h3>
              <p class="us-small">{s.dek.slice(0, 160)}…</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.indexEyebrow}</p>
      <h2>{t.indexTitle}</h2>
      <div class="us-indexes">
        <article class="note-card us-chamber" style={`--accent:${ldi.zone_color};`}>
          <p class="eyebrow">Lame-Duck Index</p>
          <p class="us-score">
            <AnimatedNumber client:visible value={ldi.score} decimals={1} /><span>/100</span>
          </p>
          <p class="us-zone" style={`color:${ldi.zone_color};`}>{ldiLabel}</p>
          <p class="us-small">{t.delta7} : <strong>{deltaSign}{ldi.delta_7d}</strong></p>
          <a href={t.ldiHref} class="cta-link">{t.ldiCta}</a>
        </article>
        <article class="note-card us-chamber" style="--accent:#c64d2d;">
          <p class="eyebrow">{t.radar}</p>
          <p class="us-small">{t.radarBody}</p>
          <a href={t.radarHref} class="cta-link">{t.radarCta}</a>
        </article>
        <article class="note-card us-chamber" style={`--accent:${showdownData.showdown.zone_color};`}>
          <p class="eyebrow">{t.cusma}</p>
          <p class="us-score" style={`color:${showdownData.showdown.zone_color};font-size:2.2rem;`}>
            {showdownData.showdown.gap > 0 ? '+' : ''}{showdownData.showdown.gap}
          </p>
          <p class="us-small">{t.cusmaGap} — {showdownLabel}</p>
          <a href={t.cusmaHref} class="cta-link">{t.cusmaCta}</a>
        </article>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.beyondEyebrow}</p>
      <article class="note-card us-chamber" style={`--accent:${presRep.color};`}>
        <p class="eyebrow">{t.pres}</p>
        <p>
          REP <strong>{presRepLead.short_label} {presRepLead.share.toFixed(0)} %</strong> ·
          DEM <strong>{presDemLead.short_label} {presDemLead.share.toFixed(0)} %</strong>
        </p>
        <p class="us-small">{t.presBody}</p>
        <a href={t.presHref} class="cta-link">{t.presCta}</a>
      </article>
    </div>
  </section>

  {pastSpecials.length > 0 && (
    <section class="content-band">
      <div class="container">
        <p class="eyebrow">{t.archiveEyebrow}</p>
        <details class="us-archive">
          <summary>{t.archiveTitle} ({pastSpecials.length})</summary>
          <p class="us-small">{t.archiveHint}</p>
          <ul>
            {pastSpecials.map((s) => (
              <li>
                <a href={specialHref(s)}>{s.headline.replace(/\n/g, ' ')}</a>
                <span class="us-small"> — {s.electionDate}</span>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>
  )}

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.marketEyebrow}</p>
      <h2>{t.marketTitle}</h2>
      <PolymarketEmbed slug="2026-balance-of-power-d-senate-d-house-949" title={t.marketBalance} />
      <PolymarketEmbed slug="will-gavin-newsom-win-the-2028-us-presidential-election" title={t.marketPres} />
    </div>
  </section>

  <MarketCheck
    kicker={t.mcKicker}
    title={t.mcTitle}
    body={t.mcBody}
    modelLabel={t.mcModel}
    marketLabel={t.mcMarket}
    note={t.mcNote}
  />

  <section class="content-band">
    <div class="container">
      <AffiliateCard partner="proton" lang={lang} visual placement="us-desk" />
    </div>
  </section>

  <DeskSections lang={lang} desk="us" />

  <MethodologyNote
    title={t.methodTitle}
    body={t.methodBody}
    bullets={t.methodBullets}
  />
</EditorialLayout>

<style>
  .us-lede { max-width: 62ch; }

  /* Le compte à rebours se calcule chez le lecteur : un nombre de jours figé au
     build serait faux dès le lendemain d'une publication sans nouveau run. */
  .us-countdown {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
  }
  .us-countdown strong {
    font-size: 3.4rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .us-countdown span {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .us-chambers,
  .us-indexes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 30px;
  }
  .us-chamber { border-left: 4px solid var(--accent, var(--rule)); }

  .us-seats {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0.4rem 0 0.6rem;
    font-size: 2.4rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .us-seat-d { color: var(--accent); }
  .us-seat-sep { color: var(--ink-3); font-weight: 300; }
  .us-seat-total {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--ink-3);
    margin-left: 0.25rem;
  }
  .us-majority { margin: 0 0 0.9rem; }

  .us-score {
    font-size: 3rem;
    font-weight: 600;
    margin: 0.25rem 0;
    line-height: 1;
  }
  .us-score span { font-size: 1.1rem; font-weight: 400; color: var(--ink-3); }
  .us-zone { font-weight: 700; font-size: 1.05rem; margin: 0 0 0.4rem; }

  .us-small { font-size: 0.88rem; }
  .us-stack { display: flex; flex-direction: column; gap: 1rem; }
  .us-special { text-decoration: none; color: inherit; display: block; }
  .us-special h3 { margin: 0.25rem 0; }

  .us-archive summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .us-archive ul { margin: 0.75rem 0 0; padding-left: 1.1rem; }
