  @media (max-width: 920px) {
    .us-chambers,
    .us-indexes { grid-template-columns: 1fr; }
    .us-countdown strong { font-size: 2.6rem; }
  }
</style>

<script>
  // Jours restants avant le mi-mandat, calculés dans le navigateur du lecteur.
  const node = document.querySelector<HTMLElement>('[data-midterm-days]');
  const label = document.querySelector<HTMLElement>('[data-midterm-label]');
  if (node && label) {
    const target = new Date(`${node.dataset.midterm}T00:00:00`);
    const now = new Date();
    const days = Math.ceil((target.getTime() - new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()) / 86_400_000);
    if (days > 0) {
      node.textContent = String(days);
      label.textContent = days === 1 ? (label.dataset.day ?? '') : (label.dataset.days ?? '');
    } else {
      node.textContent = days === 0 ? '0' : '';
      label.textContent = label.dataset.today ?? '';
    }
  }
</script>
