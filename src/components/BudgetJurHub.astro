---
// /{lang}/budget/{slug}/ : la liste des éditions d'une juridiction.
import PageHeader from './PageHeader.astro';
import StoryList from './StoryList.astro';
import { editionsFor } from '../lib/budget-data';
import { t, JURISDICTION_LABEL, TYPE_LABEL, editionLabel, budgetEdition, budgetHub, answerOf, type Locale } from '../lib/budget';

interface Props { slug: string; locale: Locale }
const { slug, locale } = Astro.props;
const jur = JURISDICTION_LABEL[slug]?.[locale] ?? slug;
const COPY = {
  fr: { title: `Budgets : ${jur}`, back: 'Tous les budgets', crumb: 'Fil d’Ariane' },
  en: { title: `Budgets: ${jur}`, back: 'All budgets', crumb: 'Breadcrumb' },
  es: { title: `Presupuestos: ${jur}`, back: 'Todos los presupuestos', crumb: 'Ruta de navegación' },
}[locale];
const items = editionsFor(slug).map((d) => ({
  meta: `${TYPE_LABEL[d.type][locale]} · ${t(d.date_tabled, locale)}`,
  title: editionLabel(d, locale),
  text: answerOf(d, locale),
  href: budgetEdition(locale, d.slug, d.edition),
}));
---
<article data-content-area>
  <PageHeader title={COPY.title} />
  <div class="container bj-list">
    <StoryList items={items} />
    <p><a class="vs-link" href={budgetHub(locale)}>{COPY.back}</a></p>
  </div>
</article>
<style>.bj-list { padding-block: 32px 64px; }</style>
