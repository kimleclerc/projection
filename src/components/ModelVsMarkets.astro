---
/**
 * « Modèle contre marchés » — Vote-Scope, Kalshi, Polymarket, côte à côte.
 *
 * Côté SEO : « kalshi » vaut 222 500 impressions de recherche sur trois mois et
 * « polymarket » plus de 130 000 (Bing, relevé du 2026-09-19). Aucune des deux
 * bourses ne montre l'autre ; nous montrons les deux, et notre modèle.
 *
 * Ce que la page ne fait pas : elle ne classe pas les sources et ne dit pas qui
 * a raison. Un modèle énonce une probabilité, une bourse un prix.
 *
 * Le comparatif PAR COURSE avait été retenu jusqu'au 2026-09-24 : nos
 * probabilités de district étaient trop serrées (écart-type implicite de 1,8
 * point de marge contre 5 à 8 d'erreur réelle), si bien que les « désaccords »
 * auraient mesuré notre variance. L'incertitude calibrée du 24 septembre
 * (docs/US_INCERTITUDE_CALIBREE_2026_09_24.md du moteur) lève cet obstacle :
 * les écarts affichés sont maintenant de vrais désaccords de lecture.
 *
 * Données : web_data/us-model-vs-markets/latest.json (export_model_vs_markets.py).
 * Les courses sans argent en jeu (moins de 1 000 $) sont déjà écartées par le moteur.
 */
import data from '../../web_data/us-model-vs-markets/latest.json';

interface Props { locale: 'en' | 'fr' | 'es' }
const { locale } = Astro.props as Props;

type Chamber = {
  id: string; label_en: string; label_fr: string; label_es: string;
  votescope: number | null; kalshi: number | null; polymarket: number | null;
  kalshi_url?: string; polymarket_url?: string; votescope_href?: string;
};
type Race = {
  jurisdiction: 'us-senate' | 'us-house' | 'us-governor'; riding_id: string; name: string;
  votescope: number; kalshi: number | null; polymarket: number | null;
  gap: number | null; gap_kalshi: number | null;
  kalshi_url: string | null; polymarket_url: string | null;
};
const doc = data as any;
const chambers = (doc.chambers ?? []) as Chamber[];
const races = (doc.races ?? []) as Race[];

const NL = locale === 'fr' ? 'fr-CA' : locale === 'es' ? 'es-ES' : 'en-CA';
const num = (n: number) => n.toLocaleString(NL, { maximumFractionDigits: 1 });
const pct = (n: number | null) => (n === null ? '—' : `${num(n)}${locale === 'en' ? '%' : ' %'}`);
const pts = (n: number) => `${num(Math.abs(n))} pt${Math.abs(n) >= 2 ? 's' : ''}`;
const fmtDate = (iso?: string) => iso
  ? new Date(`${iso}T12:00:00Z`).toLocaleDateString(NL, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : '';
const label = (c: Chamber) => (locale === 'fr' ? c.label_fr : locale === 'es' ? c.label_es : c.label_en);

// Le marché de référence d'une course : Kalshi s'il la cote, sinon Polymarket.
const market = (r: Race) => (r.kalshi !== null ? { name: 'Kalshi', v: r.kalshi, url: r.kalshi_url }
  : r.polymarket !== null ? { name: 'Polymarket', v: r.polymarket, url: r.polymarket_url } : null);
const gapOf = (r: Race) => { const m = market(r); return m ? r.votescope - m.v : 0; };

const C = {
  fr: {
    eyebrow: 'Modèle contre marchés',
    h1: 'Midterms 2026 : notre prévision contre Kalshi et Polymarket',
    lede: 'Un modèle statistique et deux bourses où des gens engagent de l’argent, côte à côte, course par course. C’est une comparaison, pas un classement.',
    controlTitle: 'Qui contrôlera le Congrès ?',
    controlLede: 'Probabilité d’une victoire démocrate. La ligne pointillée marque 50 %.',
    ours: 'Vote-Scope (nous)',
    divTitle: 'Là où nous divergeons le plus des marchés',
    divLede: 'Chaque ligne : notre probabilité de victoire démocrate (point noir) et celle du marché (point hachuré). Plus le trait est long, plus le désaccord est grand.',
    moreDem: (p: string, m: string) => `Nous sommes plus démocrates que ${m} de ${p}`,
    moreRep: (p: string, m: string) => `Nous sommes plus républicains que ${m} de ${p}`,
    allTitle: 'Toutes les courses cotées',
    course: 'Course', gap: 'Écart',
    senate: 'Sénat', governor: 'Gouverneurs', house: 'Chambre des représentants',
    showHouse: (n: number) => `Afficher les ${n} districts de la Chambre`,
    note: 'Probabilité de victoire démocrate. Kalshi : prix renormalisés sur les issues ; Polymarket : dernier prix échangé. Les courses sans argent en jeu sont écartées.',
    asOf: (d: string) => `Données au ${d}. Vote-Scope n’est ni affilié aux bourses présentées, ni approuvé par elles ; chaque cote renvoie à sa page d’origine.`,
    compare: 'Comparer aussi avec The Economist, DDHQ, Cook… →',
  },
  en: {
    eyebrow: 'Model vs markets',
    h1: '2026 midterms: our forecast vs Kalshi and Polymarket',
    lede: 'A statistical model and two exchanges where people put money down, side by side, race by race. A comparison, not a ranking.',
    controlTitle: 'Who will control Congress?',
    controlLede: 'Probability of a Democratic win. The dotted line is 50%.',
    ours: 'Vote-Scope (ours)',
    divTitle: 'Where we disagree most with the markets',
    divLede: 'Each row: our probability of a Democratic win (black dot) and the market’s (hatched dot). The longer the line, the bigger the disagreement.',
    moreDem: (p: string, m: string) => `We are more Democratic than ${m} by ${p}`,
    moreRep: (p: string, m: string) => `We are more Republican than ${m} by ${p}`,
    allTitle: 'Every race with odds',
    course: 'Race', gap: 'Gap',
    senate: 'Senate', governor: 'Governors', house: 'House of Representatives',
    showHouse: (n: number) => `Show all ${n} House districts`,
    note: 'Probability of a Democratic win. Kalshi: prices renormalized across outcomes; Polymarket: last traded price. Races with no money at stake are left out.',
    asOf: (d: string) => `Data as of ${d}. Vote-Scope is not affiliated with or endorsed by the exchanges shown; every price links to its source.`,
    compare: 'Also compare with The Economist, DDHQ, Cook… →',
  },
  es: {
    eyebrow: 'Modelo frente a mercados',
    h1: 'Elecciones de medio mandato 2026: nuestro pronóstico frente a Kalshi y Polymarket',
    lede: 'Un modelo estadístico y dos bolsas donde la gente apuesta dinero, lado a lado, contienda por contienda. Una comparación, no una clasificación.',
    controlTitle: '¿Quién controlará el Congreso?',
    controlLede: 'Probabilidad de victoria demócrata. La línea punteada marca el 50 %.',
    ours: 'Vote-Scope (nosotros)',
    divTitle: 'Donde más discrepamos de los mercados',
    divLede: 'Cada fila: nuestra probabilidad de victoria demócrata (punto negro) y la del mercado (punto rayado). Cuanto más larga la línea, mayor el desacuerdo.',
    moreDem: (p: string, m: string) => `Somos más demócratas que ${m} por ${p}`,
    moreRep: (p: string, m: string) => `Somos más republicanos que ${m} por ${p}`,
    allTitle: 'Todas las contiendas cotizadas',
    course: 'Contienda', gap: 'Diferencia',
    senate: 'Senado', governor: 'Gobernadores', house: 'Cámara de Representantes',
    showHouse: (n: number) => `Mostrar los ${n} distritos de la Cámara`,
    note: 'Probabilidad de victoria demócrata. Kalshi: precios renormalizados entre resultados; Polymarket: último precio negociado. Se excluyen las contiendas sin dinero en juego.',
    asOf: (d: string) => `Datos al ${d}. Vote-Scope no está afiliado a las bolsas mostradas ni cuenta con su respaldo; cada precio enlaza a su fuente.`,
    compare: 'Comparar también con The Economist, DDHQ, Cook… →',
  },
}[locale];

const compareHref = { fr: '/fr/us/senat/comparer-les-previsions/', en: '/en/us/senate/compare-forecasts/', es: '/es/us/senate/comparar-pronosticos/' }[locale];

// Lignes du graphique de contrôle, préparées ici (le gabarit Astro digère mal
// les tableaux littéraux filtrés en ligne).
const chamberRows = chambers.map((c) => ({
  title: label(c),
  rows: [
    { name: C.ours, v: c.votescope, url: null as string | null, kind: 'ours' },
    { name: 'Kalshi', v: c.kalshi, url: c.kalshi_url ?? null, kind: 'market' },
    { name: 'Polymarket', v: c.polymarket, url: c.polymarket_url ?? null, kind: 'market' },
  ].filter((x) => x.v !== null) as Array<{ name: string; v: number; url: string | null; kind: string }>,
}));

// Divergences : les 12 plus gros écarts, un marché suffit.
const divergences = [...races].filter((r) => market(r)).sort((a, b) => Math.abs(gapOf(b)) - Math.abs(gapOf(a))).slice(0, 12)
  .map((r) => {
    const m = market(r)!;
    const g = r.votescope - m.v;
    const office = r.jurisdiction === 'us-senate' ? C.senate : r.jurisdiction === 'us-governor' ? C.governor : C.house;
    return { ...r, m, g, office, lo: Math.min(r.votescope, m.v), hi: Math.max(r.votescope, m.v),
      phrase: g > 0 ? C.moreDem(pts(g), m.name) : C.moreRep(pts(g), m.name),
      marketText: `${m.name} ${pct(m.v)}` };
  });

const byOffice = (j: Race['jurisdiction']) => races.filter((r) => r.jurisdiction === j)
  .sort((a, b) => Math.abs(gapOf(b)) - Math.abs(gapOf(a)))
  .map((r) => {
    const g = gapOf(r);
    return { ...r, gapText: market(r) ? `${g > 0 ? '+' : g < 0 ? '−' : ''}${num(Math.abs(g))}` : '—', gapClass: g > 0 ? 'is-dem' : g < 0 ? 'is-rep' : '' };
  });
const groups = [
  { title: C.senate, rows: byOffice('us-senate'), open: true },
  { title: C.governor, rows: byOffice('us-governor'), open: true },
  { title: C.house, rows: byOffice('us-house'), open: false },
].filter((g) => g.rows.length).map((g) => ({ ...g, summary: g.open ? `${g.title} · ${g.rows.length}` : C.showHouse(g.rows.length) }));
const asOf = fmtDate(doc.meta?.run_date);
---

<section class="mvm" aria-labelledby="mvm-heading">
  <div class="container mvm-inner">
    <p class="mvm-eyebrow">{C.eyebrow}</p>
    <h1 id="mvm-heading">{C.h1}</h1>
    <p class="mvm-lede">{C.lede}</p>

    <div class="mvm-block">
      <h2>{C.controlTitle}</h2>
      <p class="mvm-help">{C.controlLede}</p>
      <div class="mvm-chambers">
        {chamberRows.map((c) => (
          <div class="mvm-chamber">
            <h3>{c.title}</h3>
            <ul class="mvm-prob">
              {c.rows.map((x) => (
                <li class={`is-${x.kind}`}>
                  <span class="mvm-name">{x.url ? <a href={x.url} rel="nofollow noopener" target="_blank">{x.name}</a> : x.name}</span>
                  <span class="mvm-track"><span class="mvm-fill" style={`width:${x.v}%`} /><span class="mvm-half" /></span>
                  <span class="mvm-val">{pct(x.v)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {divergences.length > 0 && (
      <div class="mvm-block">
        <h2>{C.divTitle}</h2>
        <p class="mvm-help">{C.divLede}</p>
        <ul class="mvm-div">
          {divergences.map((r) => (
            <li>
              <span class="mvm-race"><b>{r.name}</b><small>{r.office}</small></span>
              <span class="mvm-axis" aria-hidden="true">
                <span class="mvm-half" />
                <span class="mvm-span" style={`left:${r.lo}%;width:${r.hi - r.lo}%`} />
                <span class="mvm-dot is-market" style={`left:${r.m.v}%`} />
                <span class="mvm-dot is-ours" style={`left:${r.votescope}%`} />
              </span>
              <span class="mvm-div-vals">
                <span>{pct(r.votescope)} · {r.m.url ? <a href={r.m.url} rel="nofollow noopener" target="_blank">{r.marketText}</a> : r.marketText}</span>
                <small>{r.phrase}</small>
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="mvm-block">
      <h2>{C.allTitle}</h2>
      {groups.map((g) => (
        <details class="mvm-group" open={g.open}>
          <summary>{g.summary}</summary>
          <div class="mvm-scroll">
            <table class="mvm-table">
              <thead><tr><th scope="col">{C.course}</th><th scope="col">Vote-Scope</th><th scope="col">Kalshi</th><th scope="col">Polymarket</th><th scope="col">{C.gap}</th></tr></thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.name}</th>
                    <td>{pct(r.votescope)}</td>
                    <td>{r.kalshi_url && r.kalshi !== null ? <a href={r.kalshi_url} rel="nofollow noopener" target="_blank">{pct(r.kalshi)}</a> : pct(r.kalshi)}</td>
                    <td>{r.polymarket_url && r.polymarket !== null ? <a href={r.polymarket_url} rel="nofollow noopener" target="_blank">{pct(r.polymarket)}</a> : pct(r.polymarket)}</td>
                    <td class={r.gapClass}>{r.gapText}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
      <p class="mvm-note">{C.note}</p>
    </div>

    <p class="mvm-links"><a href={compareHref}>{C.compare}</a></p>
    <p class="mvm-disclaimer">{C.asOf(asOf)}</p>
  </div>
</section>

<style>
  .mvm { padding: 44px 0 56px; }
  .mvm-inner { max-width: 1000px; margin-inline: auto; }
  .mvm-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 8px; }
  .mvm h1 { font-family: var(--serif); font-size: clamp(30px, 4.6vw, 50px); font-weight: 430; line-height: 1.05; letter-spacing: -0.015em; margin: 0 0 12px; }
  .mvm-lede { margin: 0 0 8px; color: var(--ink-2); max-width: 68ch; font-size: 16px; line-height: 1.6; }
  .mvm-block { padding-top: 36px; }
  .mvm-block h2 { font-family: var(--serif); font-size: clamp(22px, 2.6vw, 30px); font-weight: 430; margin: 0 0 6px; }
  .mvm-help { margin: 0 0 16px; color: var(--ink-3); font-family: var(--mono); font-size: 12px; line-height: 1.6; max-width: 72ch; }
  .mvm-chambers { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .mvm-chamber { border: 1px solid var(--rule); border-radius: 6px; background: var(--card); padding: 14px 16px; }
  .mvm-chamber h3 { margin: 0 0 10px; font-family: var(--serif); font-size: 17px; font-weight: 450; }
  .mvm-prob { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .mvm-prob li { display: grid; grid-template-columns: 7.5rem 1fr 3.6rem; gap: 10px; align-items: center; font-size: 13px; }
  .mvm-prob li.is-ours { font-weight: 600; }
  .mvm-track { position: relative; height: 14px; background: var(--paper-2, var(--rule)); border-radius: 3px; overflow: hidden; }
  .mvm-fill { position: absolute; inset-block: 0; left: 0; background: var(--ink-3); border-radius: 3px; }
  .is-ours .mvm-fill { background: var(--ink); }
  .is-market .mvm-fill { background: repeating-linear-gradient(45deg, var(--ink-3) 0 4px, var(--ink-4, #aaa) 4px 8px); }
  .mvm-half { position: absolute; top: -2px; bottom: -2px; left: 50%; border-left: 1px dashed var(--ink-2); }
  .mvm-val { font-family: var(--mono); font-size: 13px; text-align: right; font-variant-numeric: tabular-nums; }
  .mvm-div { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .mvm-div li { display: grid; grid-template-columns: 8rem 1fr minmax(12rem, 16rem); gap: 14px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: 14px; }
  .mvm-race { display: flex; flex-direction: column; }
  .mvm-race small, .mvm-div-vals small { font-family: var(--mono); font-size: 10px; color: var(--ink-3); }
  .mvm-div-vals { display: flex; flex-direction: column; gap: 2px; font-family: var(--mono); font-size: 12px; }
  .mvm-axis { position: relative; height: 18px; background: var(--paper-2, var(--rule)); border-radius: 9px; }
  .mvm-span { position: absolute; top: 8px; height: 2px; background: var(--ink-2); }
  .mvm-dot { position: absolute; top: 3px; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; }
  .mvm-dot.is-ours { background: var(--ink); }
  .mvm-dot.is-market { background: repeating-linear-gradient(45deg, var(--ink-3) 0 2px, var(--paper, #fff) 2px 4px); border: 1px solid var(--ink-2); }
  .mvm-group { margin-top: 14px; }
  .mvm-group summary { cursor: pointer; font-family: var(--serif); font-size: 18px; padding: 6px 0; }
  .mvm-scroll { overflow-x: auto; }
  .mvm-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 6px; }
  .mvm-table th, .mvm-table td { padding: 7px 10px; border-bottom: 1px solid var(--rule); text-align: right; font-variant-numeric: tabular-nums; }
  .mvm-table th[scope="row"], .mvm-table thead th:first-child { text-align: left; }
  .mvm-table thead th { font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
  .mvm-table td { font-family: var(--mono); }
  .mvm-table td.is-dem { color: #2E86D3; }
  .mvm-table td.is-rep { color: #D2222D; }
  .mvm-note { margin: 12px 0 0; font-size: 12px; color: var(--ink-3); max-width: 80ch; }
  .mvm-links { margin: 28px 0 0; font-family: var(--mono); font-size: 13px; }
  .mvm-disclaimer { margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 12px; color: var(--ink-3); max-width: 80ch; }
  @media (max-width: 640px) {
    .mvm-div li { grid-template-columns: 1fr; gap: 6px; }
    .mvm-prob li { grid-template-columns: 6.5rem 1fr 3.4rem; }
  }
</style>
