---
import { affiliates, disclosureMicrocopy, disclosurePath } from '../data/affiliates';

interface Props {
  partner: keyof typeof affiliates | string;
  lang: 'en' | 'fr' | 'es';
  visual?: boolean;
  placement?: string;
  variant?: 'default' | 'evergreen';
}

const { partner, lang, visual = false, placement = 'unspecified', variant = 'default' } = Astro.props;
const p = affiliates[partner];
const live = p && p.url.trim() !== '';
const copy = live ? (variant === 'evergreen' ? p.evergreenCopy?.[lang] ?? p.copy[lang] : p.copy[lang]) : null;
const micro = disclosureMicrocopy[lang];
const accent = partner === 'proton' ? '#6d4aff' : '#3975f5';
---

{live && copy && (
  <aside
    class:list={['affiliate-card', 'note-card', { 'affiliate-card--visual': visual }]}
    aria-label={copy.kicker}
    style={`--affiliate-accent:${accent}`}
    data-affiliate-partner={p.id}
    data-affiliate-placement={placement}
  >
    {visual && (
      <div class="affiliate-visual" aria-hidden="true">
        <svg viewBox="0 0 260 180" role="presentation">
          <path class="affiliate-orbit" d="M29 111C53 42 160 10 229 64C263 91 218 151 151 156C83 162 11 148 29 111Z" />
          <path class="affiliate-route" d="M48 126L95 78L132 112L202 54" />
          <circle cx="48" cy="126" r="7" />
          <circle cx="95" cy="78" r="7" />
          <circle cx="132" cy="112" r="7" />
          <circle cx="202" cy="54" r="7" />
          <path class="affiliate-shield" d="M130 43L166 55V88C166 112 151 131 130 140C109 131 94 112 94 88V55L130 43Z" />
          <path class="affiliate-check" d="M114 88L125 99L148 74" />
        </svg>
        <div class="affiliate-wordmark">
          <span>{p.name}</span>
          <small>{lang === 'fr' ? 'Connexion privée' : lang === 'es' ? 'Conexión privada' : 'Private connection'}</small>
        </div>
      </div>
    )}
    <div class="affiliate-copy">
      <p class="eyebrow">{copy.kicker}</p>
      <h3>{copy.title}</h3>
      <p class="affiliate-body">{copy.body}</p>
      <p class="affiliate-cta-row">
        <a class="affiliate-cta" href={p.url} target="_blank" rel="sponsored noopener">{copy.cta} →</a>
      </p>
      <p class="affiliate-disclosure">
        {micro.notice}
        <a href={disclosurePath[lang]}>{micro.link}</a>
      </p>
    </div>
  </aside>
)}

<style>
  .affiliate-card {
    border-left: 4px solid var(--affiliate-accent, var(--red, #c33));
    max-width: 640px;
  }
  .affiliate-card--visual {
    display: grid;
    grid-template-columns: minmax(220px, .85fr) minmax(280px, 1.15fr);
    gap: 24px;
    max-width: none;
    overflow: hidden;
    padding: 0;
  }
  .affiliate-card--visual .affiliate-copy {
    padding: 26px 28px 24px 0;
    align-self: center;
  }
  .affiliate-card h3 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.35rem;
  }
  .affiliate-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .affiliate-cta-row {
    margin-top: 0.85rem;
  }
  .affiliate-cta {
    display: inline-block;
    padding: 8px 18px;
    background: var(--affiliate-accent, var(--red, #c33));
    color: #fff;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .affiliate-cta:hover {
    opacity: 0.9;
  }
  .affiliate-disclosure {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-3, #666);
    line-height: 1.5;
  }
  .affiliate-disclosure a {
    color: inherit;
    text-decoration: underline;
    margin-left: 4px;
  }
  .affiliate-visual {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 25%, color-mix(in oklab, var(--affiliate-accent) 30%, white), transparent 42%),
      linear-gradient(145deg, color-mix(in oklab, var(--affiliate-accent) 14%, var(--paper-2)), var(--paper-2));
  }
  .affiliate-visual svg {
    position: absolute;
    inset: 10px -12px auto auto;
    width: 108%;
    height: auto;
    color: var(--affiliate-accent);
  }
  .affiliate-orbit {
    fill: color-mix(in oklab, var(--affiliate-accent) 10%, transparent);
    stroke: color-mix(in oklab, var(--affiliate-accent) 38%, transparent);
    stroke-width: 1;
  }
  .affiliate-route {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-dasharray: 5 6;
    opacity: .42;
  }
  .affiliate-visual circle {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 2;
  }
  .affiliate-shield {
    fill: color-mix(in oklab, var(--affiliate-accent) 84%, #111);
    stroke: color-mix(in oklab, var(--affiliate-accent) 68%, white);
    stroke-width: 2;
  }
  .affiliate-check {
    fill: none;
    stroke: #fff;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .affiliate-wordmark {
    position: absolute;
    inset: auto 18px 17px;
    display: flex;
    flex-direction: column;
  }
  .affiliate-wordmark span {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -.02em;
    color: var(--ink);
  }
  .affiliate-wordmark small {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  @media (max-width: 680px) {
    .affiliate-card--visual { grid-template-columns: 1fr; }
    .affiliate-card--visual .affiliate-copy { padding: 0 20px 20px; }
    .affiliate-visual { min-height: 170px; }
    .affiliate-visual svg { inset: -10px -22px auto auto; width: 85%; }
  }
</style>
