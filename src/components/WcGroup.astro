---
// Page groupe du tournoi mondial 2026 — corps partagé en/fr/es.
// Classement projeté complet + matchs + liens pays + scores live filtrés au groupe.
// Langage générique, aucune marque officielle. Disclaimer obligatoire sur la page.
import WcBreadcrumb from './WcBreadcrumb.astro';
import WcDisclaimer from './WcDisclaimer.astro';
import WcLiveScores from '../islands/WcLiveScores';
import {
  groups, groupFixtures, label, getTeam, teamLabel, PATH_SEG, wcBase,
  type Lang,
} from '../lib/wc';

interface Props { lang: Lang; groupKey: string; }
const { lang, groupKey } = Astro.props;

const T: Record<Lang, Record<string, string>> = {
  en: { grp: 'Group', heading: 'Projected standings', note: 'Our model — group-stage finish probabilities.', team: 'Team', first: '1st%', second: '2nd%', advance: 'Advance%', champ: 'Champion%', host: 'Host nation', fixtures: 'Group-stage fixtures', vs: 'vs', tz: 'Times ET.', view: 'View team →', live: 'Live & recent scores' },
  fr: { grp: 'Groupe', heading: 'Classement projeté', note: 'Notre modèle — probabilités de fin de phase de groupes.', team: 'Équipe', first: '1er%', second: '2e%', advance: 'Passage%', champ: 'Champion%', host: 'Nation hôte', fixtures: 'Matchs de groupe', vs: 'c.', tz: 'Heures HE.', view: 'Voir l’équipe →', live: 'Scores en direct et récents' },
  es: { grp: 'Grupo', heading: 'Clasificación proyectada', note: 'Nuestro modelo — probabilidad de final de fase de grupos.', team: 'Equipo', first: '1.º%', second: '2.º%', advance: 'Avance%', champ: 'Campeón%', host: 'Selección sede', fixtures: 'Partidos de grupo', vs: 'vs', tz: 'Hora ET.', view: 'Ver equipo →', live: 'Marcadores en directo y recientes' },
};
const t = T[lang];
const standings = groups[groupKey]?.standings ?? [];
const fixtures = groupFixtures(groupKey);
const teamHref = (code: string) => `${wcBase(lang)}/${code}/`;
const locales: Record<Lang, string> = { en: 'en-US', fr: 'fr-CA', es: 'es-ES' };
const fmtDate = (iso?: string) => iso ? new Date(iso + 'T12:00:00Z').toLocaleDateString(locales[lang], { month: 'short', day: 'numeric', timeZone: 'UTC' }) : '';
// Filtre live : libellés anglais des équipes du groupe (l'API ESPN renvoie des noms EN).
const liveFilter = standings.map((s) => label(s.labels, 'en', s.team));
---

<section class="content-band">
  <div class="container">
    <WcBreadcrumb lang={lang} trail={[{ label: `${t.grp} ${groupKey}` }]} />
    <h1 style="margin:0.25rem 0;">{t.grp} {groupKey}</h1>
    <p class="eyebrow">{t.note}</p>
  </div>
</section>

<section class="content-band">
  <div class="container">
    <p class="eyebrow">{t.heading}</p>
    <h2>{t.grp} {groupKey}</h2>
    <div style="overflow-x:auto;">
      <table class="wc-group-table">
        <thead>
          <tr>
            <th>{t.team}</th>
            <th style="text-align:right;">{t.first}</th>
            <th style="text-align:right;">{t.second}</th>
            <th style="text-align:right;">{t.advance}</th>
            <th style="text-align:right;">{t.champ}</th>
          </tr>
        </thead>
        <tbody>
          {standings.map((s) => {
            const isHost = s.is_host ?? getTeam(s.team)?.is_host;
            return (
              <tr>
                <td>
                  <a href={teamHref(s.team)}>{label(s.labels, lang, s.team)}</a>{isHost ? ' ★' : ''}
                </td>
                <td style="text-align:right;">{s.p_1st != null ? `${s.p_1st}%` : '—'}</td>
                <td style="text-align:right;">{s.p_2nd != null ? `${s.p_2nd}%` : '—'}</td>
                <td style="text-align:right;">{s.p_advance != null ? `${s.p_advance}%` : '—'}</td>
                <td style="text-align:right;">{s.p_champion != null ? `${s.p_champion}%` : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="content-band">
  <div class="container">
    <p class="eyebrow">{t.live}</p>
    <WcLiveScores client:idle lang={lang} teamFilter={liveFilter} />
  </div>
</section>

{fixtures.length > 0 && (
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.fixtures}</p>
      <h2>{t.grp} {groupKey}</h2>
      <p style="font-size:0.85rem;color:var(--ink-3);margin-bottom:1rem;">{t.tz}</p>
      <ul class="wc-group-fixtures">
        {fixtures.map((m) => (
          <li>
            <span class="wc-fx-date">{fmtDate(m.date)} · {m.time_et}</span>
            <span class="wc-fx-teams">
              {label(m.home_label, lang, m.home_team)} <span class="wc-fx-vs">{t.vs}</span> {label(m.away_label, lang, m.away_team)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<WcDisclaimer lang={lang} />

<style>
  .wc-group-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; max-width: 560px; }
  .wc-group-table th {
    font-family: var(--mono, monospace); font-size: 10px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3, #666); font-weight: 400;
    padding: 6px 10px; border-bottom: 1px solid var(--rule, #ddd); text-align: left;
  }
  .wc-group-table td { padding: 6px 10px; border-bottom: 1px solid var(--rule, #eee); }
  .wc-group-table a { color: var(--ink, #111); text-decoration: none; }
  .wc-group-table a:hover { color: var(--accent, #c00); }
  .wc-group-fixtures { list-style: none; padding: 0; margin: 0; max-width: 520px; }
  .wc-group-fixtures li {
    display: flex; justify-content: space-between; gap: 1rem; align-items: baseline;
    padding: 8px 0; border-bottom: 1px solid var(--rule, #eee); font-size: 0.9rem;
  }
  .wc-fx-date { color: var(--ink-3, #888); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .wc-fx-vs { color: var(--ink-3, #999); font-size: 0.8rem; }
</style>
