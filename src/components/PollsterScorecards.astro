---
/**
 * Bulletin des sondeurs — sous-page de la méthodologie, trois langues.
 * Données : src/data/pollster-scorecards.json (bilan_<élection>.py du moteur,
 * export_web). Une entrée par élection dans `elections` (la plus récente en
 * premier à l'affichage) ; `history` porte les dernières mesures des élections
 * antérieures sans bulletin détaillé. Le classement cumulé se calcule ici.
 * Blocs en enfants directs de [data-content-area] pour l'insertion publicitaire.
 */
import { partyMeta, subjectFr } from '../lib/riding-adapters/parties';
import data from '../data/pollster-scorecards.json';

interface Props { locale: 'fr' | 'en' | 'es'; }
const { locale } = Astro.props;

const D: any = data;
const loc = locale === 'fr' ? 'fr-CA' : locale === 'es' ? 'es' : 'en-CA';
const num = (n: number, d = 1) => n.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d });
const sg = (n: number, d = 1) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${num(Math.abs(n), d)}`;
const label = (j: string, code: string) => {
  const m = partyMeta(j, code);
  return locale === 'en' ? m.label_en : m.label_fr;
};
const color = (j: string, code: string) => partyMeta(j, code).color;
// Nom du parti en complément d'objet : « la CAQ », "the CAQ", « a la CAQ ».
const object = (j: string, code: string) => {
  const m: any = partyMeta(j, code);
  if (locale === 'fr') return m.mention_fr ? subjectFr(m.mention_fr) : m.label_fr;
  if (locale === 'en') return m.mention_en ?? m.label_en;
  const es = m.mention_es ?? m.label_fr;
  return es.startsWith('el ') ? `al ${es.slice(3)}` : `a ${es}`;
};
const points = (n: number) => `${num(n)} ${locale === 'es' ? 'puntos' : Math.abs(n) >= 2 || locale === 'en' ? 'points' : 'point'}`;
const MONTHS = {
  fr: ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juill.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'],
  en: ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'June', 'July', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'],
  es: ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sept.', 'oct.', 'nov.', 'dic.'],
}[locale];
const day = (iso: string) => {
  const [, m, d] = iso.split('-').map(Number);
  const dd = locale === 'fr' && d === 1 ? '1er' : String(d);
  return locale === 'en' ? `${MONTHS[m - 1]} ${d}` : `${dd} ${MONTHS[m - 1]}`;
};
const field = (a: string, b: string) => {
  if (!a || a === b || a === 'nan') return day(b);
  const [, ma, da] = a.split('-').map(Number);
  const [, mb, db] = b.split('-').map(Number);
  if (ma !== mb) return `${day(a)}–${day(b)}`;
  return locale === 'en' ? `${MONTHS[mb - 1]} ${da}–${db}` : `${da === 1 && locale === 'fr' ? '1er' : da}–${db} ${MONTHS[mb - 1]}`;
};

const ELECTION_NAMES: Record<string, Record<string, string>> = {
  qc_2026: { fr: 'Québec 2026', en: 'Quebec 2026', es: 'Quebec 2026' },
  qc_2022: { fr: 'Québec 2022', en: 'Quebec 2022', es: 'Quebec 2022' },
  qc_2018: { fr: 'Québec 2018', en: 'Quebec 2018', es: 'Quebec 2018' },
};
const ename = (id: string) => ELECTION_NAMES[id]?.[locale] ?? id;
const METHOD: Record<string, Record<string, string>> = {
  online: { fr: 'Web', en: 'Online', es: 'En línea' },
  ivr: { fr: 'Téléphone automatisé', en: 'Automated phone', es: 'Teléfono automatizado' },
  mixed: { fr: 'Téléphone et Web', en: 'Phone and online', es: 'Teléfono y en línea' },
  other: { fr: 'Autre', en: 'Other', es: 'Otro' },
};

// Classement cumulé : pour chaque élection, l'écart de chaque maison est comparé
// à la moyenne des maisons de cette élection (une élection difficile pèse sur
// tout le monde). La somme est divisée par (n + 2) : une maison mesurée une seule
// fois est rapprochée de la moyenne, pour qu'un coup de chance ne la place pas
// au sommet.
type Entry = { election: string; firm: string; name: string; mae: number };
const entries: Entry[] = [
  ...D.history.map((h: any) => ({ election: h.election, firm: h.firm, name: h.name, mae: h.mae })),
  ...D.elections.flatMap((e: any) => e.firms.map((f: any) => ({ election: e.id, firm: f.firm, name: f.name, mae: f.mae }))),
];
const electionMean = new Map<string, number>();
for (const id of new Set(entries.map((e) => e.election))) {
  const xs = entries.filter((e) => e.election === id).map((e) => e.mae);
  electionMean.set(id, xs.reduce((s, x) => s + x, 0) / xs.length);
}
const K = 2;
const byFirm = new Map<string, Entry[]>();
for (const e of entries) byFirm.set(e.firm, [...(byFirm.get(e.firm) ?? []), e]);
const overall = [...byFirm.entries()].map(([firm, es]) => {
  const rel = es.reduce((s, e) => s + (e.mae - electionMean.get(e.election)!), 0);
  return {
    firm, name: es[es.length - 1].name, n: es.length,
    elections: es.map((e) => ename(e.election)).join(', '),
    mae: es.reduce((s, e) => s + e.mae, 0) / es.length,
    score: rel / (es.length + K),
  };
}).sort((a, b) => a.score - b.score);
const MIN_ELECTIONS = 2;
const ranked = overall.filter((f) => f.n >= MIN_ELECTIONS);
const newcomers = overall.filter((f) => f.n < MIN_ELECTIONS);

const elections = [...D.elections].sort((a: any, b: any) => b.date.localeCompare(a.date));
const SPAN = 8;
const pos = (e: number) => 50 + (Math.max(-SPAN, Math.min(SPAN, e)) / SPAN) * 50;
const cls = (x: number, good: number, bad: number) => (x <= good ? 'good' : x >= bad ? 'bad' : '');

const T = {
  fr: {
    eyebrow: 'Méthodologie · bulletin des sondeurs',
    h1: 'Quels sondeurs croire ?',
    lede: 'Après chaque élection, nous comparons le dernier sondage de chaque maison au résultat. Ce bulletin se met à jour à chaque scrutin, ici et ailleurs.',
    overallTitle: 'Le classement de toutes les élections',
    overallIntro: 'Chaque maison est comparée aux autres maisons de la même élection, puis on fait la moyenne. Pour être classée, une maison doit avoir été mesurée sur au moins deux élections : un seul bon ou mauvais résultat peut tenir de la chance.',
    newTitle: 'Une seule élection mesurée',
    newIntro: 'Ces maisons seront classées après leur deuxième élection.',
    thOverall: ['', 'Maison', 'Élections', 'Écart moyen', 'Par rapport aux autres'],
    better: 'mieux', worse: 'moins bien',
    resultTitle: 'Le résultat et la moyenne des derniers sondages',
    legendRes: 'Résultat', legendAvg: 'Moyenne des derniers sondages',
    avgRead: (e: any) => {
      const errs = e.parties.map((p: string) => ({ p, d: e.average[p] - e.result[p] })).sort((a: any, b: any) => Math.abs(b.d) - Math.abs(a.d));
      const [a, b] = errs;
      return `Ensemble, les sondeurs ont ${a.d > 0 ? 'surestimé' : 'sous-estimé'} ${object(e.jurisdiction, a.p)} de ${points(Math.abs(a.d))} et ${b.d > 0 ? 'surestimé' : 'sous-estimé'} ${object(e.jurisdiction, b.p)} de ${points(Math.abs(b.d))}.`;
    },
    rankTitle: 'Le classement',
    rankIntro: 'Le rang combine cinq mesures, expliquées plus bas. Le graphique montre l’erreur du dernier sondage sur chaque parti : à gauche du trait, le parti était sous-estimé ; à droite, surestimé.',
    under: 'sous-estimé', over: 'surestimé',
    stats: ['Écart moyen', 'Course clé', 'Erreur ÷ hasard', 'Constance 3 sem.', 'Ordre des partis', 'Jours avant le vote'],
    resp: 'rép.',
    detailTitle: 'Le détail, parti par parti',
    thDetail: ['Maison', 'Terrain'],
    thMae: 'Écart moyen', resultRow: 'Résultat',
    detailNote: 'Intentions de vote du dernier sondage de chaque maison, en %. En couleur : plus de 2 points d’écart avec le résultat.',
    unrankedTitle: 'Non classées',
    unranked: (xs: string) => `${xs} n’ont pas publié de sondage dans les dix derniers jours. On ne peut pas les juger sur le résultat sans les pénaliser pour la date. Une fois cet éloignement pris en compte, aucune ne s’écarte de ce qu’on attendait à cette date.`,
    localTitle: 'Sondages de circonscription',
    local: (f: string, rows: string) => `${f} a publié des sondages locaux dans la dernière semaine : ${rows}. Le gagnant était le bon partout.`,
    localRow: (r: any) => `${r.riding} (écart moyen de ${points(r.mae)}, environ ${Math.round(r.n / 50) * 50} répondants)`,
    methodTitle: 'Comment on classe',
    methodIntro: 'L’écart moyen seul récompense une maison chanceuse et ne tient pas compte de la date. On classe donc chaque maison sur cinq mesures, puis on fait la moyenne des rangs.',
    method: [
      ['Écart moyen.', 'La moyenne des écarts entre le dernier sondage et le résultat, sur les principaux partis.'],
      ['Course clé.', 'L’erreur sur l’écart entre les deux premiers partis, la course qui décidait du gouvernement.'],
      ['Erreur sur les petits partis.', 'Rater un parti à 12 % de 2 points, c’est se tromper d’un sixième de son vote ; rater un parti à 28 % de 2 points, d’un quatorzième. Cette mesure compte l’erreur en proportion de la taille du parti.'],
      ['Erreur comparée au hasard.', 'On divise l’erreur par celle que produirait le seul hasard de l’échantillon. Sous 1, la maison ne pouvait pas faire mieux avec son nombre de répondants. Au-dessus de 2, l’écart vient d’ailleurs.'],
      ['Constance sur trois semaines.', 'Chaque sondage des 21 derniers jours est comparé à l’erreur normale à sa date : plus on s’éloigne du vote, plus l’erreur attendue grandit. Un chiffre négatif veut dire mieux que prévu.'],
    ],
    status: 'Résultats préliminaires ; mis à jour avec les résultats officiels.',
    foot: 'Sondages tels que publiés par les maisons, intentions de vote après répartition des indécis.',
    links: [['Méthodologie', '/fr/methodologie'], ['Notre bilan du Québec 2026', '/fr/track-record/quebec-2026'], ['Sondages du Québec', '/fr/canada/quebec/sondages']],
  },
  en: {
    eyebrow: 'Methodology · pollster report card',
    h1: 'Which pollsters can you trust?',
    lede: "After every election, we compare each firm's final poll with the result. This report card is updated after every vote, here and elsewhere.",
    overallTitle: 'The ranking across all elections',
    overallIntro: 'Each firm is compared with the other firms in the same election, then averaged. To be ranked, a firm must have been measured over at least two elections: a single good or bad result can be luck.',
    newTitle: 'Measured in a single election',
    newIntro: 'These firms will be ranked after their second election.',
    thOverall: ['', 'Firm', 'Elections', 'Average miss', 'Versus the others'],
    better: 'better', worse: 'worse',
    resultTitle: 'The result and the average of the final polls',
    legendRes: 'Result', legendAvg: 'Average of the final polls',
    avgRead: (e: any) => {
      const errs = e.parties.map((p: string) => ({ p, d: e.average[p] - e.result[p] })).sort((a: any, b: any) => Math.abs(b.d) - Math.abs(a.d));
      const [a, b] = errs;
      return `Together, the pollsters ${a.d > 0 ? 'overestimated' : 'underestimated'} ${object(e.jurisdiction, a.p)} by ${points(Math.abs(a.d))} and ${b.d > 0 ? 'overestimated' : 'underestimated'} ${object(e.jurisdiction, b.p)} by ${points(Math.abs(b.d))}.`;
    },
    rankTitle: 'The ranking',
    rankIntro: "The rank combines five measures, explained below. The chart shows the final poll's error on each party: left of the line, the party was underestimated; right, overestimated.",
    under: 'underestimated', over: 'overestimated',
    stats: ['Average miss', 'Key race', 'Error ÷ chance', 'Consistency 3 wk', 'Party order', 'Days before vote'],
    resp: 'resp.',
    detailTitle: 'Party by party',
    thDetail: ['Firm', 'Field dates'],
    thMae: 'Average miss', resultRow: 'Result',
    detailNote: "Voting intentions in each firm's final poll, in %. Highlighted: more than 2 points from the result.",
    unrankedTitle: 'Not ranked',
    unranked: (xs: string) => `${xs} did not publish a poll in the final ten days. They cannot be judged on the result without penalising them for the date. Once that distance is taken into account, none stands out from what was expected at that date.`,
    localTitle: 'Riding polls',
    local: (f: string, rows: string) => `${f} published local polls in the final week: ${rows}. It had the right winner in each.`,
    localRow: (r: any) => `${r.riding} (average miss ${points(r.mae)}, about ${Math.round(r.n / 50) * 50} respondents)`,
    methodTitle: 'How we rank',
    methodIntro: 'The average miss alone rewards a lucky firm and ignores the date. So we rank each firm on five measures, then average the ranks.',
    method: [
      ['Average miss.', 'The average gap between the final poll and the result, across the main parties.'],
      ['Key race.', 'The error on the gap between the top two parties, the race that decided the government.'],
      ['Error on smaller parties.', 'Missing a party at 12% by 2 points is a sixth of its vote; missing a party at 28% by 2 points, a fourteenth. This measure counts the error relative to the party\'s size.'],
      ['Error versus chance.', 'We divide the error by what sampling chance alone would produce. Below 1, the firm could not do better with its number of respondents. Above 2, the gap comes from somewhere else.'],
      ['Consistency over three weeks.', 'Each poll from the final 21 days is compared with the normal error at its date: the further from the vote, the larger the expected error. A negative number means better than expected.'],
    ],
    status: 'Preliminary results; updated with the official results.',
    foot: 'Polls as published by the firms, voting intentions after allocating undecided voters.',
    links: [['Methodology', '/en/methodology'], ['How we did in Quebec 2026', '/en/track-record/quebec-2026'], ['Quebec polls', '/en/canada/quebec/polls']],
  },
  es: {
    eyebrow: 'Metodología · boletín de encuestadoras',
    h1: '¿A qué encuestadoras creer?',
    lede: 'Después de cada elección, comparamos la última encuesta de cada casa con el resultado. Este boletín se actualiza tras cada votación, aquí y en otros lugares.',
    overallTitle: 'La clasificación de todas las elecciones',
    overallIntro: 'Cada casa se compara con las demás casas de la misma elección, y luego se promedia. Para entrar en la clasificación, una casa debe haberse medido en al menos dos elecciones: un solo resultado, bueno o malo, puede ser suerte.',
    newTitle: 'Medidas en una sola elección',
    newIntro: 'Estas casas se clasificarán tras su segunda elección.',
    thOverall: ['', 'Casa', 'Elecciones', 'Error medio', 'Frente a las demás'],
    better: 'mejor', worse: 'peor',
    resultTitle: 'El resultado y la media de las últimas encuestas',
    legendRes: 'Resultado', legendAvg: 'Media de las últimas encuestas',
    avgRead: (e: any) => {
      const errs = e.parties.map((p: string) => ({ p, d: e.average[p] - e.result[p] })).sort((a: any, b: any) => Math.abs(b.d) - Math.abs(a.d));
      const [a, b] = errs;
      return `En conjunto, las encuestadoras ${a.d > 0 ? 'sobrestimaron' : 'subestimaron'} ${object(e.jurisdiction, a.p)} en ${points(Math.abs(a.d))} y ${b.d > 0 ? 'sobrestimaron' : 'subestimaron'} ${object(e.jurisdiction, b.p)} en ${points(Math.abs(b.d))}.`;
    },
    rankTitle: 'La clasificación',
    rankIntro: 'El puesto combina cinco medidas, explicadas más abajo. El gráfico muestra el error de la última encuesta en cada partido: a la izquierda de la línea, el partido estaba subestimado; a la derecha, sobrestimado.',
    under: 'subestimado', over: 'sobrestimado',
    stats: ['Error medio', 'Carrera clave', 'Error ÷ azar', 'Constancia 3 sem.', 'Orden de partidos', 'Días antes del voto'],
    resp: 'resp.',
    detailTitle: 'Partido por partido',
    thDetail: ['Casa', 'Trabajo de campo'],
    thMae: 'Error medio', resultRow: 'Resultado',
    detailNote: 'Intención de voto de la última encuesta de cada casa, en %. En color: más de 2 puntos de diferencia con el resultado.',
    unrankedTitle: 'Sin clasificar',
    unranked: (xs: string) => `${xs} no publicaron encuestas en los últimos diez días. No se las puede juzgar por el resultado sin penalizarlas por la fecha. Teniendo en cuenta esa distancia, ninguna se aparta de lo esperado en esa fecha.`,
    localTitle: 'Encuestas de distrito',
    local: (f: string, rows: string) => `${f} publicó encuestas locales en la última semana: ${rows}. Acertó el ganador en todas.`,
    localRow: (r: any) => `${r.riding} (error medio de ${points(r.mae)}, unas ${Math.round(r.n / 50) * 50} respuestas)`,
    methodTitle: 'Cómo clasificamos',
    methodIntro: 'El error medio por sí solo premia a una casa con suerte y no tiene en cuenta la fecha. Por eso clasificamos cada casa según cinco medidas y promediamos los puestos.',
    method: [
      ['Error medio.', 'La media de las diferencias entre la última encuesta y el resultado, en los principales partidos.'],
      ['Carrera clave.', 'El error en la distancia entre los dos primeros partidos, la carrera que decidía el gobierno.'],
      ['Error en los partidos pequeños.', 'Fallar por 2 puntos a un partido del 12 % es equivocarse en un sexto de su voto; a uno del 28 %, en un catorceavo. Esta medida cuenta el error en proporción al tamaño del partido.'],
      ['Error frente al azar.', 'Dividimos el error por el que produciría solo el azar de la muestra. Por debajo de 1, la casa no podía hacerlo mejor con su número de respuestas. Por encima de 2, la diferencia viene de otra parte.'],
      ['Constancia en tres semanas.', 'Cada encuesta de los últimos 21 días se compara con el error normal en su fecha: cuanto más lejos del voto, mayor es el error esperado. Un número negativo significa mejor de lo previsto.'],
    ],
    status: 'Resultados preliminares; se actualizará con los resultados oficiales.',
    foot: 'Encuestas tal como las publicaron las casas, intención de voto tras repartir a los indecisos.',
    links: [['Metodología', '/es/metodologia'], ['Nuestro balance de Quebec 2026', '/es/track-record/quebec-2026'], ['Encuestas de Quebec', '/es/canada/quebec/sondeos']],
  },
}[locale];

const listJoin = (xs: string[]) => {
  const and = locale === 'fr' ? ' et ' : locale === 'es' ? ' y ' : ' and ';
  return xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')}${and}${xs[xs.length - 1]}`;
};
---

<article class="ps" data-content-area>
  <header class="container ps-head">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
    <p class="ps-lede">{T.lede}</p>
  </header>

  <section class="container ps-block">
    <h2>{T.overallTitle}</h2>
    <p class="ps-intro">{T.overallIntro}</p>
    <div class="ps-scroll">
      <table>
        <thead><tr>{T.thOverall.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {ranked.map((f, i) => (
            <tr>
              <td class="ps-rank">{i + 1}</td>
              <th scope="row">{f.name}</th>
              <td class="ps-left">{f.elections}</td>
              <td>{num(f.mae, 2)}</td>
              <td class={f.score < -0.1 ? 'good' : f.score > 0.1 ? 'bad' : ''}>{sg(f.score, 2)} <small>{f.score < 0 ? T.better : T.worse}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {newcomers.length > 0 && (
      <>
        <h3>{T.newTitle}</h3>
        <p class="ps-intro">{T.newIntro}</p>
        <div class="ps-scroll">
          <table>
            <tbody>
              {newcomers.map((f) => (
                <tr>
                  <th scope="row">{f.name}</th>
                  <td class="ps-left">{f.elections}</td>
                  <td>{num(f.mae, 2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </section>

  {elections.map((e: any) => {
    const J = e.jurisdiction;
    const maxV = Math.max(...e.parties.map((p: string) => Math.max(e.result[p], e.average[p]))) * 1.12;
    return (
      <>
        <section class="container ps-block">
          <p class="eyebrow">{ename(e.id)} · {day(e.date)}</p>
          <h2>{T.resultTitle}</h2>
          <div class="ps-result">
            {e.parties.map((p: string) => (
              <div class="ps-rrow">
                <span class="ps-pname">{label(J, p)}</span>
                <div class="ps-bars" aria-hidden="true">
                  <i class="ps-bar" style={`width:${(e.result[p] / maxV) * 100}%;--c:${color(J, p)}`}></i>
                  <i class="ps-tick" style={`left:calc(${(e.average[p] / maxV) * 100}% - 1px)`}></i>
                </div>
                <span class="ps-vals">{num(e.result[p])} <small>· {num(e.average[p])}</small></span>
              </div>
            ))}
          </div>
          <p class="ps-legend"><span><i class="sw"></i>{T.legendRes}</span><span><i class="tk"></i>{T.legendAvg}</span></p>
          <p>{T.avgRead(e)}</p>
        </section>

        <section class="container ps-block">
          <h2>{T.rankTitle} · {ename(e.id)}</h2>
          <p class="ps-intro">{T.rankIntro}</p>
          <p class="ps-plegend">{e.parties.map((p: string) => <span><i style={`--c:${color(J, p)}`}></i>{label(J, p)}</span>)}</p>
          <div class="ps-board">
            {e.firms.map((f: any) => {
              const errs = e.parties.map((p: string) => ({ p, d: f.poll[p] - e.result[p] })).sort((a: any, b: any) => Math.abs(a.d) - Math.abs(b.d));
              const aria = errs.map((x: any) => `${label(J, x.p)} ${sg(x.d)}`).join(', ');
              return (
                <div class={`ps-firm${f.rank <= 3 ? ' top' : ''}`}>
                  <div class="ps-r">{f.rank}</div>
                  <div class="ps-name">
                    <h3>{f.name}</h3>
                    <span>{field(f.field_start, f.field_end)} · {f.n.toLocaleString(loc)} {T.resp} · {METHOD[f.method]?.[locale]}</span>
                  </div>
                  <dl class="ps-stats">
                    <div><dt>{T.stats[0]}</dt><dd class={cls(f.mae, 1, 2)}>{num(f.mae, 2)}</dd></div>
                    <div><dt>{T.stats[1]}</dt><dd class={cls(Math.abs(f.key_race_err), 1, 2.5)}>{sg(f.key_race_err)}</dd></div>
                    <div><dt>{T.stats[2]}</dt><dd class={cls(f.vs_chance, 1, 2)}>{num(f.vs_chance, 2)}</dd></div>
                    <div><dt>{T.stats[3]}</dt><dd class={cls(f.consistency, -0.15, 0.5)}>{sg(f.consistency, 2)}</dd></div>
                    <div><dt>{T.stats[4]}</dt><dd>{f.order_ok}/{e.parties.length}</dd></div>
                    <div><dt>{T.stats[5]}</dt><dd>{f.days_out}</dd></div>
                  </dl>
                  <div class="ps-errs" role="img" aria-label={aria}>
                    <div class="ps-errhead"><span>{T.under}</span><span>{T.over}</span></div>
                    <div class="ps-track">
                      <i class="zero"></i>
                      {[-6, -4, -2, 2, 4, 6].map((g) => <i class="grid" style={`left:${pos(g)}%`}></i>)}
                      {errs.map((x: any) => <i class="dot" title={`${label(J, x.p)} ${sg(x.d)}`} style={`left:${pos(x.d)}%;--c:${color(J, x.p)}`}></i>)}
                    </div>
                    <div class="ps-scale">{[-8, -4, 0, 4, 8].map((t) => <span style={`left:${pos(t)}%`}>{t > 0 ? `+${t}` : t < 0 ? `−${-t}` : '0'}</span>)}</div>
                  </div>
                  {f.note?.[locale] && <p class="ps-note">{f.note[locale]}</p>}
                </div>
              );
            })}
          </div>
        </section>

        <section class="container ps-block">
          <h2>{T.detailTitle}</h2>
          <div class="ps-scroll">
            <table>
              <thead><tr>{T.thDetail.map((h) => <th>{h}</th>)}{e.parties.map((p: string) => <th>{label(J, p)}</th>)}<th>{T.thMae}</th></tr></thead>
              <tbody>
                {e.firms.map((f: any) => (
                  <tr>
                    <th scope="row">{f.name}</th>
                    <td class="ps-left">{field(f.field_start, f.field_end)}</td>
                    {e.parties.map((p: string) => {
                      const d = f.poll[p] - e.result[p];
                      return <td class={Math.abs(d) > 2 ? (d > 0 ? 'bad' : 'under') : ''}>{num(f.poll[p])}</td>;
                    })}
                    <td>{num(f.mae, 2)}</td>
                  </tr>
                ))}
                <tr class="ps-res"><th scope="row">{T.resultRow}</th><td class="ps-left">{day(e.date)}</td>{e.parties.map((p: string) => <td>{num(e.result[p])}</td>)}<td></td></tr>
              </tbody>
            </table>
          </div>
          <p class="ps-small">{T.detailNote}</p>
        </section>

        {(e.unranked?.length > 0 || e.local_polls?.length > 0) && (
          <section class="container ps-block">
            {e.unranked?.length > 0 && (<><h2>{T.unrankedTitle}</h2><p>{T.unranked(listJoin(e.unranked.map((u: any) => `${u.name} (${day(u.field_end)})`)))}</p></>)}
            {e.local_polls?.length > 0 && (
              <>
                <h3>{T.localTitle}</h3>
                <p>{T.local(e.firms.find((f: any) => f.firm === e.local_polls[0].firm)?.name ?? e.unranked.find((u: any) => u.firm === e.local_polls[0].firm)?.name ?? e.local_polls[0].firm, listJoin(e.local_polls.map(T.localRow)))}</p>
              </>
            )}
            <p class="ps-small">{T.status}</p>
          </section>
        )}
      </>
    );
  })}

  <section class="container ps-block">
    <h2>{T.methodTitle}</h2>
    <p>{T.methodIntro}</p>
    <ol class="ps-method">{T.method.map(([a, b]) => <li><strong>{a}</strong> {b}</li>)}</ol>
  </section>

  <section class="container ps-foot">
    <p>{T.foot}</p>
    <nav>{T.links.map(([l, h]) => <a href={h}>{l} →</a>)}</nav>
  </section>
</article>

