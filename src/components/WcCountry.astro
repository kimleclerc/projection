---
// Page pays du tournoi mondial 2026 — corps partagé en/fr/es.
// Angle unique Vote-Scope : probabilités prospectives tour par tour + scores live.
// Langage générique (pays, « tournoi »), aucune marque officielle. Disclaimer sur la page.
import WcBreadcrumb from './WcBreadcrumb.astro';
import { flagFor } from '../lib/wc-flags';
import WcDisclaimer from './WcDisclaimer.astro';
import WcPathProb from './WcPathProb.astro';
import WcLiveScores from '../islands/WcLiveScores';
import AnimatedNumber from '../islands/AnimatedNumber';
import {
  groups, teamFixtures, label, teamLabel, PATH_SEG, wcBase,
  type BoardTeam, type Lang,
} from '../lib/wc';

interface Props { lang: Lang; team: BoardTeam; }
const { lang, team } = Astro.props;

const T: Record<Lang, Record<string, string>> = {
  en: { champ: 'to win the tournament', path: 'Path through the tournament', pathNote: 'Our model — round-by-round reach probabilities.', groupCtx: 'Group context', fixtures: 'Group-stage fixtures', vs: 'vs', host: 'Host nation', conf: 'Confederation', grp: 'Group', advance: 'Advance%', first: '1st%', viewGroup: 'View full group', tz: 'Times ET.', peers: 'in this group' },
  fr: { champ: 'de remporter le tournoi', path: 'Parcours dans le tournoi', pathNote: 'Notre modèle — probabilités d’atteindre chaque tour.', groupCtx: 'Contexte de groupe', fixtures: 'Matchs de groupe', vs: 'c.', host: 'Nation hôte', conf: 'Confédération', grp: 'Groupe', advance: 'Passage%', first: '1er%', viewGroup: 'Voir le groupe complet', tz: 'Heures HE.', peers: 'dans ce groupe' },
  es: { champ: 'de ganar el torneo', path: 'Recorrido por el torneo', pathNote: 'Nuestro modelo — probabilidad de alcanzar cada ronda.', groupCtx: 'Contexto de grupo', fixtures: 'Partidos de grupo', vs: 'vs', host: 'Selección sede', conf: 'Confederación', grp: 'Grupo', advance: 'Avance%', first: '1.º%', viewGroup: 'Ver el grupo completo', tz: 'Hora ET.', peers: 'en este grupo' },
};
const t = T[lang];
const name = teamLabel(team.team, lang);
const grpStandings = groups[team.group]?.standings ?? [];
const fixtures = teamFixtures(team.team);
const groupHref = `${wcBase(lang)}/${PATH_SEG[lang].groups}/${team.group.toLowerCase()}/`;
const locales: Record<Lang, string> = { en: 'en-US', fr: 'fr-CA', es: 'es-ES' };
const fmtDate = (iso?: string) => iso ? new Date(iso + 'T12:00:00Z').toLocaleDateString(locales[lang], { month: 'short', day: 'numeric', timeZone: 'UTC' }) : '';
---

<section class="content-band">
  <div class="container">
    <WcBreadcrumb lang={lang} trail={[{ label: name }]} />
    <p class="eyebrow">
      {t.conf}: {team.confederation} · {t.grp} {team.group}{team.is_host ? ` · ${t.host}` : ''}
    </p>
    <h1 style="margin:0.25rem 0;">{flagFor(team.team)} {name}</h1>
    <p style="font-size:2.5rem;font-weight:700;color:var(--accent);margin:0.5rem 0;">
      <AnimatedNumber client:visible value={team.p_champion} decimals={2} suffix="%" />
    </p>
    <p style="font-size:0.95rem;color:var(--ink-3);">{t.champ}</p>
  </div>
</section>

<section class="content-band">
  <div class="container">
    <p class="eyebrow">{t.path}</p>
    <h2>{t.pathNote}</h2>
    <WcPathProb lang={lang} team={team} />
  </div>
</section>

<section class="content-band">
  <div class="container">
    <WcLiveScores client:idle lang={lang} teamFilter={[label(team.labels, 'en', team.team)]} />
  </div>
</section>

<section class="content-band">
  <div class="container">
    <p class="eyebrow">{t.groupCtx}</p>
    <h2>{t.grp} {team.group}</h2>
    <div style="overflow-x:auto;">
      <table class="wc-country-table">
        <thead>
          <tr>
            <th>{t.grp}</th>
            <th style="text-align:right;">{t.first}</th>
            <th style="text-align:right;">{t.advance}</th>
          </tr>
        </thead>
        <tbody>
          {grpStandings.map((s) => (
            <tr style={s.team === team.team ? 'font-weight:700;background:rgba(204,0,0,0.05);' : ''}>
              <td>{label(s.labels, lang, s.team)}{s.is_host ? ' ★' : ''}</td>
              <td style="text-align:right;">{s.p_1st != null ? `${s.p_1st}%` : '—'}</td>
              <td style="text-align:right;">{s.p_advance != null ? `${s.p_advance}%` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:0.75rem;"><a href={groupHref}>{t.viewGroup} →</a></p>
  </div>
</section>

{fixtures.length > 0 && (
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">{t.fixtures}</p>
      <h2>{name} · {t.grp} {team.group}</h2>
      <p style="font-size:0.85rem;color:var(--ink-3);margin-bottom:1rem;">{t.tz}</p>
      <ul class="wc-country-fixtures">
        {fixtures.map((m) => (
          <li>
            <span class="wc-fx-date">{fmtDate(m.date)} · {m.time_et}</span>
            <span class="wc-fx-teams">
              {label(m.home_label, lang, m.home_team)} <span class="wc-fx-vs">{t.vs}</span> {label(m.away_label, lang, m.away_team)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<WcDisclaimer lang={lang} />

<style>
  .wc-country-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; max-width: 480px; }
  .wc-country-table th {
    font-family: var(--mono, monospace); font-size: 10px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3, #666); font-weight: 400;
    padding: 6px 10px; border-bottom: 1px solid var(--rule, #ddd); text-align: left;
  }
  .wc-country-table td { padding: 6px 10px; border-bottom: 1px solid var(--rule, #eee); }
  .wc-country-fixtures { list-style: none; padding: 0; margin: 0; max-width: 520px; }
  .wc-country-fixtures li {
    display: flex; justify-content: space-between; gap: 1rem; align-items: baseline;
    padding: 8px 0; border-bottom: 1px solid var(--rule, #eee); font-size: 0.9rem;
  }
  .wc-fx-date { color: var(--ink-3, #888); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .wc-fx-vs { color: var(--ink-3, #999); font-size: 0.8rem; }
</style>
