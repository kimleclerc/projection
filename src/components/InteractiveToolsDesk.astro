---
/**
 * Répertoire d'outils (docs/DESIGN.md § 7) : ce qu'on peut faire, en liste.
 * Chaque simulateur montre en aperçu son vrai point de départ (la projection du jour),
 * pas une illustration. Pas d'« indice phare », pas de vitrine.
 */
import EditorialLayout from '../layouts/EditorialLayout.astro';
import PageHeader from './PageHeader.astro';
import { partyName } from '../lib/party-names';
import quebecDoc from '../../web_data/quebec/simulator.json';
import federalDoc from '../../web_data/federal/simulator.json';
import ontarioDoc from '../../web_data/ontario/simulator.json';
import usHouseDoc from '../../web_data/us-house/simulator.json';
import spainDoc from '../../web_data/spain/dhondt.json';

interface Props { locale: 'fr' | 'en' | 'es' }
const { locale } = Astro.props;
const L = (fr: string, en: string, es: string) => ({ fr, en, es }[locale]);

const paths = {
  fr: { labs: '/fr/labs/', hub: '/fr/outils', qc: '/fr/outils/simulateur-quebec', ca: '/fr/outils/simulateur-canada', on: '/fr/outils/simulateur-ontario', match: '/fr/canada/quebec/match', house: '/fr/outils/simulateur-chambre-us', es: '/fr/outils/simulateur-espagne' },
  en: { labs: '/en/labs/', hub: '/en/tools', qc: '/en/tools/quebec-simulator', ca: '/en/tools/canada-simulator', on: '/en/tools/ontario-simulator', match: '/en/canada/quebec/match', house: '/en/tools/us-house-simulator', es: '/en/tools/spain-simulator' },
  es: { labs: '/es/labs/', hub: '/es/herramientas', qc: '/es/herramientas/simulador-quebec', ca: '/es/herramientas/simulador-canada', on: '/es/herramientas/simulador-ontario', match: '/es/canada/quebec/match', house: '/es/herramientas/simulador-camara-us', es: '/es/herramientas/simulador-espana' },
}[locale];

const dateFmt = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString(
  locale === 'en' ? 'en-CA' : locale === 'es' ? 'es-ES' : 'fr-CA', { day: 'numeric', month: 'long', timeZone: 'UTC' });

// Aperçu réel : la répartition des sièges du point de départ de chaque simulateur.
const preview = (doc: any, label: (p: any) => string) => {
  const total = doc.meta.total_seats;
  const majority = doc.meta.majority_threshold ?? Math.floor(total / 2) + 1;
  const parties = [...doc.parties].filter((p: any) => p.seats_projected > 0).sort((a: any, b: any) => b.seats_projected - a.seats_projected);
  const top = parties.slice(0, 2).map((p: any) => `${label(p)} ${Math.round(p.seats_projected)}`).join(' · ');
  return { total, majority, parties, top, date: dateFmt(doc.meta.run_date) };
};
const simLabel = (p: any) => partyName({ ...p, party: p.code }, locale);
const spainLabel = (p: any) => p.label ?? p.code;

const sims = [
  { href: paths.ca, name: L('Élections fédérales canadiennes', 'Canadian federal election', 'Elecciones federales de Canadá'),
    what: L('Changez les intentions de vote province par province et voyez les 343 sièges de la Chambre des communes se redistribuer.', 'Change the vote by province and watch the 343 House of Commons seats move.', 'Cambie la intención de voto por provincia y vea moverse los 343 escaños de la Cámara de los Comunes.'),
    cta: L('Ouvrir le simulateur fédéral', 'Open the federal simulator', 'Abrir el simulador federal'), p: preview(federalDoc, simLabel) },
  { href: paths.house, name: L('Chambre des représentants des États-Unis', 'U.S. House of Representatives', 'Cámara de Representantes de EE. UU.'),
    what: L('Déplacez le vote national et régional : combien de districts faut-il pour que la majorité de 218 sièges change de camp?', 'Shift the national and regional vote: how many districts does it take for the 218-seat majority to flip?', 'Mueva el voto nacional y regional: ¿cuántos distritos hacen falta para que la mayoría de 218 escaños cambie de manos?'),
    cta: L('Ouvrir le simulateur de la Chambre', 'Open the House simulator', 'Abrir el simulador de la Cámara'), p: preview(usHouseDoc, simLabel) },
  { href: paths.es, name: L('Congrès des députés d’Espagne', 'Spain’s Congress of Deputies', 'Congreso de los Diputados'),
    what: L('Répartissez les voix et voyez la règle D’Hondt attribuer les 350 sièges, province par province.', 'Set the vote shares and watch the D’Hondt rule allocate the 350 seats, province by province.', 'Reparta los votos y vea cómo la regla D’Hondt asigna los 350 escaños, provincia por provincia.'),
    cta: L('Ouvrir le simulateur espagnol', 'Open the Spain simulator', 'Abrir el simulador de España'), p: preview(spainDoc, spainLabel) },
  { href: paths.on, name: L('Assemblée législative de l’Ontario', 'Ontario Legislative Assembly', 'Asamblea Legislativa de Ontario'),
    what: L('Modifiez les intentions de vote ontariennes et voyez les 124 circonscriptions changer de couleur.', 'Change Ontario vote intentions and watch the 124 ridings change colour.', 'Cambie la intención de voto en Ontario y vea cambiar de color las 124 circunscripciones.'),
    cta: L('Ouvrir le simulateur ontarien', 'Open the Ontario simulator', 'Abrir el simulador de Ontario'), p: preview(ontarioDoc, simLabel) },
  { href: paths.qc, name: L('Assemblée nationale du Québec', 'Quebec National Assembly', 'Asamblea Nacional de Quebec'),
    what: L('Rejouez l’élection du 5 octobre : partez de notre dernière projection et voyez ce qu’il aurait fallu pour changer le résultat.', 'Replay the October 5 election: start from our final forecast and see what it would have taken to change the outcome.', 'Vuelva a jugar la elección del 5 de octubre: parta de nuestra última proyección y vea qué habría hecho falta para cambiar el resultado.'),
    cta: L('Ouvrir le simulateur québécois', 'Open the Quebec simulator', 'Abrir el simulador de Quebec'), p: preview(quebecDoc, simLabel) },
];

const T = {
  title: L('Simulateurs et outils', 'Simulators and tools', 'Simuladores y herramientas'),
  promise: L('Changez les intentions de vote et voyez les sièges bouger. Votre scénario reste le vôtre : il ne remplace pas notre projection.',
             'Change the vote and watch the seats move. Your scenario is yours: it does not replace our forecast.',
             'Cambie la intención de voto y vea moverse los escaños. Su escenario es suyo: no sustituye a nuestra proyección.'),
  simsTitle: L('Simulateurs de sièges', 'Seat simulators', 'Simuladores de escaños'),
  start: (d: string, total: number) => L(`Point de départ : notre projection du ${d}, sur ${total} sièges`, `Starting point: our ${d} forecast, out of ${total} seats`, `Punto de partida: nuestra proyección del ${d}, de ${total} escaños`),
  majority: (m: number) => L(`majorité à ${m}`, `${m} for a majority`, `mayoría con ${m}`),
  otherTitle: L('Autres outils', 'Other tools', 'Otras herramientas'),
  matchName: L('Le Match', 'The Match', 'El Match'),
  matchWhat: L('Quelle circonscription du Québec vous ressemble? Répondez à quelques questions sur l’économie, le logement ou l’environnement, et comparez vos réponses aux votes réels.',
               'Which Quebec riding is most like you? Answer a few questions on the economy, housing or the environment and compare your answers with how places actually voted.',
               '¿Qué circunscripción de Quebec se parece más a usted? Responda unas preguntas sobre economía, vivienda o medio ambiente y compare sus respuestas con el voto real.'),
  matchCta: L('Faire le Match', 'Take the Match', 'Hacer el Match'),
  labsName: L('Orbite, modèle expérimental', 'Orbit, an experimental model', 'Órbita, modelo experimental'),
  labsWhat: L('Un second modèle, construit autrement, comparé à notre projection au Québec, en Colombie-Britannique et aux États-Unis. Utile pour voir où les deux s’accordent. C’est une expérience : ce n’est pas notre projection officielle.',
              'A second model, built differently, compared with our forecast in Quebec, British Columbia and the United States. Useful to see where the two agree. It is an experiment, not our official forecast.',
              'Un segundo modelo, construido de otra manera, comparado con nuestra proyección en Quebec, Columbia Británica y Estados Unidos. Sirve para ver dónde coinciden. Es un experimento, no nuestra proyección oficial.'),
  labsCta: L('Voir la comparaison Orbite', 'See the Orbit comparison', 'Ver la comparación de Órbita'),
};
const canonical = `https://vote-scope.com${paths.hub}`;
const alternates = { en: 'https://vote-scope.com/en/tools', fr: 'https://vote-scope.com/fr/outils', es: 'https://vote-scope.com/es/herramientas' };
---

<EditorialLayout
  title={`${T.title} — Vote-Scope`}
  description={T.promise}
  canonical={canonical}
  lang={locale}
  currentPage="match"
  alternates={alternates}
  jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: T.title, description: T.promise, url: canonical, inLanguage: locale }}
>
  <PageHeader title={T.title} promise={T.promise} />

  <section class="tools-list">
    <div class="container">
      <h2 class="tools-h2">{T.simsTitle}</h2>
      <ul>
        {sims.map((s) => (
          <li class="tool-row">
            <div class="tool-text">
              <h3><a href={s.href}>{s.name}</a></h3>
              <p>{s.what}</p>
              <a class="vs-link" href={s.href}>{s.cta}</a>
            </div>
            <div class="tool-preview" aria-hidden="true">
              <div class="tool-bar">
                {s.p.parties.map((p: any) => <span style={`width:${(p.seats_projected / s.p.total) * 100}%;background:${p.color}`}></span>)}
                <i style={`left:${(s.p.majority / s.p.total) * 100}%`}></i>
              </div>
              <p class="vs-meta">{s.p.top} · {T.majority(s.p.majority)}</p>
              <p class="vs-meta">{T.start(s.p.date, s.p.total)}</p>
            </div>
          </li>
        ))}
      </ul>

      <h2 class="tools-h2">{T.otherTitle}</h2>
      <ul>
        <li class="tool-row is-text">
          <div class="tool-text">
            <h3><a href={paths.match}>{T.matchName}</a></h3>
            <p>{T.matchWhat}</p>
            <a class="vs-link" href={paths.match}>{T.matchCta}</a>
          </div>
        </li>
        <li class="tool-row is-text">
          <div class="tool-text">
            <h3><a href={paths.labs}>{T.labsName}</a></h3>
            <p>{T.labsWhat}</p>
            <a class="vs-link" href={paths.labs}>{T.labsCta}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>
</EditorialLayout>

<style>
  .tools-list { padding: 8px 0 56px; }
  .tools-h2 { margin: 32px 0 0; padding-bottom: 8px; border-bottom: 3px solid var(--ink); font-size: 24px; font-weight: 700; }
  ul { margin: 0; padding: 0; list-style: none; }
  .tool-row { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; padding: 20px 0; border-bottom: 1px solid var(--rule); }
  .tool-row.is-text { grid-template-columns: minmax(0, 760px); }
  .tool-text h3 { margin: 0 0 6px; font-size: 22px; font-weight: 700; line-height: 1.2; }
  .tool-text h3 a { color: var(--ink); text-decoration: none; }
  .tool-text h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tool-text p { margin: 0 0 10px; color: var(--ink-2); font-size: 16px; line-height: 1.5; max-width: 620px; }
  .tool-preview { align-self: center; }
  .tool-bar { position: relative; display: flex; height: 18px; background: var(--rule); }
  .tool-bar span { height: 100%; }
  .tool-bar i { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--ink); }
  .tool-preview .vs-meta { margin: 6px 0 0; }
  @media (max-width: 760px) { .tool-row { grid-template-columns: 1fr; gap: 12px; } }
</style>
