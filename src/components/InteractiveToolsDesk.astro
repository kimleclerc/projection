---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import SimulatorSeatPreview from './SimulatorSeatPreview.astro';
import '../styles/interactive-tools.css';
import quebecDoc from '../../web_data/quebec/simulator.json';
import federalDoc from '../../web_data/federal/simulator.json';
import ontarioDoc from '../../web_data/ontario/simulator.json';
import usHouseDoc from '../../web_data/us-house/simulator.json';
import spainDoc from '../../web_data/spain/dhondt.json';
import senateDoc from '../../web_data/us-senate/latest.json';

interface Props {
  locale: 'fr' | 'en' | 'es';
}
const { locale } = Astro.props;
const paths = {
  fr: { labs:'/fr/labs/', hub:'/fr/outils', qc:'/fr/outils/simulateur-quebec', ca:'/fr/outils/simulateur-canada', on:'/fr/outils/simulateur-ontario', match:'/fr/canada/quebec/match' , house:'/fr/outils/simulateur-chambre-us', senate:'/fr/us/senat/', es:'/fr/outils/simulateur-espagne' },
  en: { labs:'/en/labs/', hub:'/en/tools', qc:'/en/tools/quebec-simulator', ca:'/en/tools/canada-simulator', on:'/en/tools/ontario-simulator', match:'/en/canada/quebec/match' , house:'/en/tools/us-house-simulator', senate:'/en/us/senate/', es:'/en/tools/spain-simulator' },
  es: { labs:'/es/labs/', hub:'/es/herramientas', qc:'/es/herramientas/simulador-quebec', ca:'/es/herramientas/simulador-canada', on:'/es/herramientas/simulador-ontario', match:'/es/canada/quebec/match' , house:'/es/herramientas/simulador-camara-us', senate:'/es/us/senate/', es:'/es/herramientas/simulador-espana' },
}[locale];
const copy = {
  fr: {
    title:'Jouez avec la politique.',
    description:'Simulateurs, jeux et outils interactifs pour voir comment une course peut changer — sans confondre votre scénario avec notre projection.',
    featured:'Instrument phare', senate:'Sénat américain', senateSub:'100 sièges · mi-mandat du 3 novembre', senateOpen:'Ouvrir le desk Sénat', control:'Contrôle démocrate', close:'Les courses les plus serrées', qc:'Simulateur Québec', open:'Ouvrir le simulateur', ridings:'circonscriptions',
    available:'Autres simulateurs disponibles', ca:'Simulateur Canada', on:'Simulateur Ontario', house:'Simulateur Chambre US', es:'Simulateur Espagne', esSub:'350 sièges · D’Hondt', play:'Jouer', districts:'districts',
    match:'Le Match', matchBody:'Quelques cartes à glisser. Une circonscription qui vous ressemble.', matchCta:'Trouver mon match',
    labs:'Orbite, le moteur quantique', labsBody:'Et si on prévoyait une élection avec la physique d’Einstein? Orbite, notre moteur expérimental à qubits, affronte notre projection de référence au Québec, en Colombie-Britannique et aux États-Unis. Science en direct : voyez où ils s’entendent, et où ils se contredisent.', labsCta:'Découvrir Orbite',
  },
  en: {
    title:'Play with politics.',
    description:'Simulators, games and interactive tools to see how a race can change — without confusing your scenario with our projection.',
    featured:'Featured instrument', senate:'U.S. Senate', senateSub:'100 seats · November 3 midterms', senateOpen:'Open the Senate desk', control:'Democratic control', close:'Closest races', qc:'Quebec simulator', open:'Open the simulator', ridings:'ridings',
    available:'Other available simulators', ca:'Canada simulator', on:'Ontario simulator', house:'U.S. House simulator', es:'Spain simulator', esSub:'350 seats · D’Hondt', play:'Play', districts:'districts',
    match:'The Match', matchBody:'Swipe a few cards. Find a riding that feels like you.', matchCta:'Find my match',
    labs:'Orbit, the quantum engine', labsBody:'What if you forecast an election with Einstein’s physics? Orbit, our experimental qubit engine, goes head to head with our reference forecast in Quebec, British Columbia and the United States. Live science: see where they agree, and where they clash.', labsCta:'Discover Orbit',
  },
  es: {
    title:'Juega con la política.',
    description:'Simuladores, juegos y herramientas interactivas para ver cómo puede cambiar una carrera — sin confundir tu escenario con nuestra proyección.',
    featured:'Instrumento destacado', senate:'Senado de EE. UU.', senateSub:'100 escaños · elecciones intermedias del 3 de noviembre', senateOpen:'Abrir el desk del Senado', control:'Control demócrata', close:'Las contiendas más reñidas', qc:'Simulador Quebec', open:'Abrir el simulador', ridings:'distritos',
    available:'Otros simuladores disponibles', ca:'Simulador Canadá', on:'Simulador Ontario', house:'Simulador Cámara EE. UU.', es:'Simulador España', esSub:'350 escaños · D’Hondt', play:'Jugar', districts:'distritos',
    match:'El Match', matchBody:'Desliza unas cartas. Encuentra un distrito que se parezca a ti.', matchCta:'Encontrar mi match',
    labs:'Órbita, el motor cuántico', labsBody:'¿Y si pronosticáramos una elección con la física de Einstein? Órbita, nuestro motor experimental con qubits, se enfrenta a nuestra proyección de referencia en Quebec, Columbia Británica y Estados Unidos. Ciencia en directo: vea dónde coinciden y dónde se contradicen.', labsCta:'Descubrir Órbita',
  },
}[locale];
// Instrument phare : la course qui capte l'attention (choix éditorial, à revoir à chaque scrutin).
const senateParties = (senateDoc as any).parties.filter((p: any) => p.seats_projected > 0).sort((a: any, b: any) => b.seats_projected - a.seats_projected);
const senateDem = (senateDoc as any).parties.find((p: any) => p.party === 'us_dem');
const partyName = (p: any) => (locale === 'en' ? (p.label_en ?? p.label_fr) : (p.label_fr ?? p.label_en));
const senateClose = ((senateDoc as any).ridings as any[])
  .filter((r) => r.projection?.p_winner != null)
  .sort((a, b) => Math.abs(a.projection.p_winner - 0.5) - Math.abs(b.projection.p_winner - 0.5))
  .slice(0, 6)
  .map((r) => ({ name: locale === 'en' ? (r.name_en ?? r.name_fr) : (r.name_fr ?? r.name_en), winner: r.projection.winner, p: r.projection.p_winner }));
const senateColor = (code: string) => (senateDoc as any).parties.find((p: any) => p.party === code)?.color ?? '#888';
const senateShort = (code: string) => ({ us_dem: 'D', us_rep: 'R' } as Record<string, string>)[code] ?? 'I';
const canonical = `https://vote-scope.com${paths.hub}`;
const alternates = { en:'https://vote-scope.com/en/tools', fr:'https://vote-scope.com/fr/outils', es:'https://vote-scope.com/es/herramientas' };
---

<EditorialLayout
  title={`${copy.title} — Vote-Scope`}
  description={copy.description}
  canonical={canonical}
  lang={locale}
  currentPage="match"
  alternates={alternates}
  jsonLd={{ '@context':'https://schema.org', '@type':'CollectionPage', name:copy.title, description:copy.description, url:canonical, inLanguage:locale }}
>
  <header class="tools-hero">
    <div class="container-wide">
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
    </div>
  </header>

  <section class="tools-featured">
    <div class="container-wide">
      <p class="eyebrow">{copy.featured}</p>
      <div class="tools-featured-frame">
        <div class="tools-featured-copy">
          <h2>{copy.senate}</h2>
          <p>{copy.senateSub}</p>
          <ul>
            {senateParties.map((party: any) => (
              <li><i style={{background:party.color}}></i><span>{partyName(party)}</span><strong>{Math.round(party.seats_projected)}</strong></li>
            ))}
          </ul>
          <p class="tools-control">{copy.control} : <strong>{Math.round(100 * senateDem.p_majority)}{locale === 'en' ? '%' : ' %'}</strong></p>
          <a class="tools-primary" href={paths.senate}>{copy.senateOpen}</a>
        </div>
        <a class="tools-featured-map tools-featured-races" href={paths.senate} aria-label={copy.senateOpen}>
          <p class="eyebrow">{copy.close}</p>
          <ol>
            {senateClose.map((r) => (
              <li><span>{r.name}</span><b style={{background: senateColor(r.winner)}}>{senateShort(r.winner)}</b><strong>{Math.round(100 * r.p)}{locale === 'en' ? '%' : ' %'}</strong></li>
            ))}
          </ol>
        </a>
      </div>
    </div>
  </section>

  <section class="tools-available">
    <div class="container-wide">
      <h2>{copy.available}</h2>
      <div class="tools-rail">
        <a href={paths.qc}>
          <div><h3>{copy.qc}</h3><p>{quebecDoc.meta.total_seats} {copy.ridings}</p><strong>{copy.play}</strong></div>
          <span><SimulatorSeatPreview doc={quebecDoc} label={copy.qc} /></span>
        </a>
        <a href={paths.ca}>
          <div><h3>{copy.ca}</h3><p>{federalDoc.meta.total_seats} {copy.ridings}</p><strong>{copy.play}</strong></div>
          <span><SimulatorSeatPreview doc={federalDoc} label={copy.ca} /></span>
        </a>
        <a href={paths.on}>
          <div><h3>{copy.on}</h3><p>{ontarioDoc.meta.total_seats} {copy.ridings}</p><strong>{copy.play}</strong></div>
          <span><SimulatorSeatPreview doc={ontarioDoc} label={copy.on} /></span>
        </a>
        <a href={paths.es}>
          <div><h3>{copy.es}</h3><p>{copy.esSub}</p><strong>{copy.play}</strong></div>
          <span class="tools-es-preview" aria-hidden="true">
            {(spainDoc as any).parties.filter((p: any) => p.seats_projected > 0).sort((a: any, b: any) => b.seats_projected - a.seats_projected).map((p: any) => (
              <i style={`flex:${p.seats_projected};background:${p.color}`}></i>
            ))}
          </span>
        </a>
        <a href={paths.house}>
          <div><h3>{copy.house}</h3><p>{usHouseDoc.meta.total_seats} {copy.districts}</p><strong>{copy.play}</strong></div>
          <span><SimulatorSeatPreview doc={usHouseDoc} label={copy.house} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="tools-match">
    <div class="container-wide tools-match-inner">
      <div><h2>{copy.match}</h2><p>{copy.matchBody}</p><a class="tools-primary" href={paths.match}>{copy.matchCta}</a></div>
      <div class="tools-match-cards" aria-hidden="true"><span>Économie</span><span>Logement</span><span>Environnement</span><strong>→</strong></div>
    </div>
  </section>

  <section class="tools-labs">
    <div class="container-wide tools-labs-inner">
      <h2>{copy.labs}</h2>
      <p>{copy.labsBody}</p>
      <a class="tools-primary" href={paths.labs}>{copy.labsCta}</a>
    </div>
  </section>
</EditorialLayout>

<style>
  .tools-hero { padding:clamp(54px,9vw,110px) 0 48px; border-bottom:1px solid var(--rule); }
  .tools-hero h1 { max-width:1000px; margin:0; font:430 clamp(54px,9vw,112px)/.88 var(--serif); letter-spacing:-.055em; }
  .tools-hero p { max-width:790px; margin:24px 0 0; color:var(--ink-2); font-size:clamp(18px,2vw,24px); line-height:1.45; }
  .tools-featured,.tools-available,.tools-match { padding:52px 0; border-bottom:1px solid var(--rule); }
  .tools-featured-frame { display:grid; grid-template-columns:310px minmax(0,1fr); margin-top:15px; border:1px solid var(--rule); background:var(--card); }
  .tools-featured-copy { padding:30px; border-right:1px solid var(--rule); }
  .tools-featured-copy h2,.tools-match h2 { margin:0; font:430 clamp(36px,4vw,54px)/.95 var(--serif); }
  .tools-featured-copy > p { margin:8px 0 20px; color:var(--ink-3); font:11px var(--mono); letter-spacing: 0; }
  .tools-featured-copy ul { list-style:none; margin:0 0 24px; padding:16px 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); }
  .tools-featured-copy li { display:grid; grid-template-columns:10px 1fr auto; align-items:center; gap:8px; padding:4px 0; }
  .tools-featured-copy li i { width:9px; height:9px; }
  .tools-featured-copy li strong { font:600 18px var(--mono); }
  .tools-primary { display:inline-flex; padding:13px 17px; background:var(--ink); color:var(--paper-3); font:600 11px var(--mono); letter-spacing: 0; }
  .tools-featured-map { display:block; min-height:560px; padding:16px; background: var(--paper-2); }
  .tools-available h2 { margin:0 0 18px; font:600 11px var(--mono); letter-spacing: 0; }
  .tools-rail { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--rule); border-left:1px solid var(--rule); }
  .tools-rail > a { display:grid; grid-template-columns:190px 1fr; min-height:260px; border-right:1px solid var(--rule); border-bottom:1px solid var(--rule); background:var(--card); }
  .tools-rail > a > div { padding:24px; }
  .tools-rail h3 { margin:0; font:430 34px/1 var(--serif); }
  .tools-rail p { margin:8px 0 26px; color:var(--ink-3); font-size:13px; }
  .tools-rail strong { font:600 11px var(--mono); letter-spacing: 0; }
  .tools-rail > a > span { min-width:0; padding:10px; background:var(--paper-2); }
  .tools-es-preview { display:flex !important; align-items:center; gap:2px; padding:40px 14px !important; }
  .tools-es-preview i { display:block; height:34px; border-radius:2px; }
  .tools-match { background:var(--paper-2); }
  .tools-labs { padding:52px 0; border-bottom:1px solid var(--rule); }
  .tools-labs h2 { margin:0; font:430 clamp(36px,4vw,54px)/.95 var(--serif); }
  .tools-labs p { max-width:640px; margin:16px 0 24px; color:var(--ink-2); font-size:18px; line-height:1.5; }
  .tools-match-inner { display:grid; grid-template-columns:minmax(260px,420px) 1fr; align-items:center; gap:clamp(40px,8vw,120px); }
  .tools-match p { max-width:380px; margin:16px 0 24px; color:var(--ink-2); font-size:18px; }
  .tools-match-cards { position:relative; min-height:260px; }
  .tools-match-cards span { position:absolute; top:35px; left:12%; width:210px; padding:24px 20px 150px; border:1px solid var(--rule); background:var(--card);  font:600 12px var(--mono); transform:rotate(-6deg); }
  .tools-match-cards span:nth-child(2) { left:34%; transform:rotate(1deg); }
  .tools-match-cards span:nth-child(3) { left:56%; transform:rotate(7deg); }
  .tools-match-cards strong { position:absolute; right:2%; top:45%; font:430 60px var(--serif); }
  @media(max-width:850px){.tools-featured-frame{grid-template-columns:1fr}.tools-featured-copy{border-right:0;border-bottom:1px solid var(--rule)}.tools-featured-map{min-height:430px}.tools-rail{grid-template-columns:1fr}.tools-match-inner{grid-template-columns:1fr}.tools-match-cards{min-height:230px}}
  @media(max-width:560px){.tools-featured-map{min-height:330px}.tools-rail>a{grid-template-columns:145px 1fr}.tools-rail h3{font-size:28px}.tools-match-cards span{width:155px;padding-bottom:110px}.tools-match-cards span:nth-child(2){left:28%}.tools-match-cards span:nth-child(3){left:49%}}
  .tools-control { margin: 0 0 20px; font: 13px var(--mono); color: var(--ink-2); }
  .tools-featured-races { padding: 26px 30px; color: inherit; text-decoration: none; }
  .tools-featured-races ol { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 2px; }
  .tools-featured-races li { display: grid; grid-template-columns: 1fr auto 56px; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 17px; }
  .tools-featured-races b { display: inline-flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 4px; color: #fff; font: 700 12px var(--mono); }
  .tools-featured-races strong { font: 600 16px var(--mono); text-align: right; }
</style>
