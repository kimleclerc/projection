---
/**
 * Auto-generated tournament read. All sentences are derived from the current
 * model run (web_data/sports/worldcup2026_latest.json), so the text stays
 * accurate after every update without manual rewriting — and gives search
 * engines real prose on a page that is otherwise mostly tables.
 */

interface BoardTeam {
  team: string;
  labels: { en: string; fr: string; es: string };
  group: string;
  confederation: string;
  is_host: boolean;
  p_champion: number;
  p_final: number;
  p_semifinal: number;
  p_knockout_stage: number;
}

interface GroupStanding {
  team: string;
  labels: { en: string; fr: string; es: string };
  p_advance: number;
  p_1st: number;
  is_host: boolean;
}

interface BracketMatch {
  num?: number;
  date?: string;
  team1?: string | null;
  team2?: string | null;
  team1_label?: Record<string, string>;
  team2_label?: Record<string, string>;
  score?: [number, number] | null;
  winner?: string | null;
  decided?: boolean;
  win_probs?: Record<string, number>;
}
interface Bracket {
  current_round: string;
  sf?: BracketMatch[];
  final?: BracketMatch[];
}

interface Props {
  lang: 'en' | 'fr' | 'es';
  board: BoardTeam[];
  groups: Record<string, { teams: string[]; standings: GroupStanding[] }>;
  runDate: string;
  bracket?: Bracket;
}

const { lang, board, groups, runDate, bracket } = Astro.props;

const fav = board[0];
const second = board[1];
const third = board[2];

// Le tournoi est-il entré en phase à élimination directe ?
const knockout = !!bracket && bracket.current_round !== 'group_stage';

// Dark horse: best semifinal odds among teams outside the top 6 championship ranks.
const darkHorse = board.slice(6, 24).reduce((best, t) => (t.p_semifinal > best.p_semifinal ? t : best), board[6]);

// Tightest group: smallest gap in p_1st between the top two teams.
let tightest = { key: 'A', gap: Infinity, leader: null as GroupStanding | null, chaser: null as GroupStanding | null };
for (const [key, g] of Object.entries(groups)) {
  const byFirst = [...g.standings].sort((a, b) => b.p_1st - a.p_1st);
  const gap = byFirst[0].p_1st - byFirst[1].p_1st;
  if (gap < tightest.gap) tightest = { key, gap, leader: byFirst[0], chaser: byFirst[1] };
}

const hosts = board.filter((t) => t.is_host);
const bestHost = hosts.length ? hosts.reduce((b, t) => (t.p_champion > b.p_champion ? t : b), hosts[0]) : null;

import { flagFor } from '../lib/wc-flags';
const n = (t: BoardTeam | GroupStanding) => `${flagFor((t as { team?: string }).team ?? '')} ${t.labels[lang]}`.trim();
const pct = (v: number) => (lang === 'en' ? `${v}%` : `${String(v).replace('.', ',')} %`);

const heading: Record<string, { eyebrow: string; title: string }> = {
  en: { eyebrow: `The model's read — run ${runDate}`, title: 'Favorites, dark horses and the group to watch.' },
  fr: { eyebrow: `La lecture du modèle — run ${runDate}`, title: 'Favoris, négligés et le groupe à surveiller.' },
  es: { eyebrow: `La lectura del modelo — corrida ${runDate}`, title: 'Favoritos, tapados y el grupo a seguir.' },
};

const paragraphs: Record<string, string[]> = {
  en: [
    `<strong>${n(fav)}</strong> opens the tournament as the model's favorite at ${pct(fav.p_champion)} to lift the trophy — ahead of <strong>${n(second)}</strong> (${pct(second.p_champion)}) and <strong>${n(third)}</strong> (${pct(third.p_champion)}). In a 48-team field, even the favorite is more likely to lose than to win: that single-digit number is what a genuinely open tournament looks like.`,
    `The dark horse on the board is <strong>${n(darkHorse)}</strong>: only ${pct(darkHorse.p_champion)} to win it all, but ${pct(darkHorse.p_semifinal)} to reach the semifinals — the kind of bracket path that turns a quiet contender into the story of the knockout rounds.`,
    `The tightest race for first place is <strong>Group ${tightest.key}</strong>, where ${n(tightest.leader!)} edges ${n(tightest.chaser!)} by ${pct(Math.round(tightest.gap * 10) / 10)} for the top spot. Group winners draw the kinder side of the bracket, so this margin matters more than it looks.`,
    bestHost
      ? `Among the host nations, <strong>${n(bestHost)}</strong> is best positioned at ${pct(bestHost.p_champion)} to win and ${pct(bestHost.p_knockout_stage)} to reach the knockout stage — home crowds have historically been worth real points at this stage of the tournament.`
      : '',
  ],
  fr: [
    `<strong>${n(fav)}</strong> aborde le tournoi en favori du modèle à ${pct(fav.p_champion)} de soulever le trophée — devant <strong>${n(second)}</strong> (${pct(second.p_champion)}) et <strong>${n(third)}</strong> (${pct(third.p_champion)}). Dans un plateau à 48 équipes, même le favori a plus de chances de perdre que de gagner : ce chiffre à un seul chiffre, c'est le visage d'un tournoi réellement ouvert.`,
    `Le négligé du tableau, c'est <strong>${n(darkHorse)}</strong> : seulement ${pct(darkHorse.p_champion)} de tout gagner, mais ${pct(darkHorse.p_semifinal)} d'atteindre les demi-finales — le genre de parcours de tableau qui transforme un prétendant discret en histoire des rondes éliminatoires.`,
    `La course la plus serrée pour la première place se joue dans le <strong>groupe ${tightest.key}</strong>, où ${n(tightest.leader!)} devance ${n(tightest.chaser!)} de ${pct(Math.round(tightest.gap * 10) / 10)} pour le sommet. Les premiers de groupe héritent du côté le plus clément du tableau : cette marge compte plus qu'elle n'en a l'air.`,
    bestHost
      ? `Parmi les nations hôtes, <strong>${n(bestHost)}</strong> est la mieux placée à ${pct(bestHost.p_champion)} de gagner et ${pct(bestHost.p_knockout_stage)} d'atteindre la phase éliminatoire — le public à domicile a historiquement valu de vrais points à ce stade du tournoi.`
      : '',
  ],
  es: [
    `<strong>${n(fav)}</strong> llega al torneo como favorito del modelo con ${pct(fav.p_champion)} de levantar el trofeo — por delante de <strong>${n(second)}</strong> (${pct(second.p_champion)}) y <strong>${n(third)}</strong> (${pct(third.p_champion)}). En un cuadro de 48 equipos, incluso el favorito tiene más probabilidades de perder que de ganar: esa cifra de un solo dígito es el rostro de un torneo realmente abierto.`,
    `El tapado del tablero es <strong>${n(darkHorse)}</strong>: solo ${pct(darkHorse.p_champion)} de ganarlo todo, pero ${pct(darkHorse.p_semifinal)} de alcanzar las semifinales — el tipo de camino que convierte a un aspirante discreto en la historia de las rondas eliminatorias.`,
    `La carrera más apretada por el primer puesto está en el <strong>grupo ${tightest.key}</strong>, donde ${n(tightest.leader!)} supera a ${n(tightest.chaser!)} por ${pct(Math.round(tightest.gap * 10) / 10)}. Los primeros de grupo heredan el lado más amable del cuadro: ese margen importa más de lo que parece.`,
    bestHost
      ? `Entre las naciones anfitrionas, <strong>${n(bestHost)}</strong> es la mejor situada con ${pct(bestHost.p_champion)} de ganar y ${pct(bestHost.p_knockout_stage)} de alcanzar la fase eliminatoria — el público local históricamente ha valido puntos reales en esta etapa del torneo.`
      : '',
  ],
};

// ─────────────────────────────────────────────────────────────────────────────
// Lecture « phase éliminatoire » : dérivée du bracket, remplace le récit de
// phase de groupes dès que le tableau se remplit (demi-finales, finale…).
const codeMap = new Map(board.map((t) => [t.team, t]));
const nc = (code: string | null | undefined): string => {
  const tt = code ? codeMap.get(code) : undefined;
  return tt ? n(tt) : (code ? code.toUpperCase() : '?');
};
const conj: Record<string, string> = { en: 'and', fr: 'et', es: 'y' };
const joinList = (items: string[]): string => {
  if (items.length <= 1) return items[0] ?? '';
  return `${items.slice(0, -1).join(', ')} ${conj[lang]} ${items[items.length - 1]}`;
};
const fmtDate = (d?: string): string =>
  d ? new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long' }).format(new Date(`${d}T12:00:00`)) : '';

const sf = bracket?.sf ?? [];
const finalMatch = (bracket?.final ?? [])[0];
const liveSemi = sf.find((m) => !m.decided);
const doneSemis = sf.filter((m) => m.decided && m.winner);
const throughFinal = doneSemis.map((m) => m.winner as string);

// Résultat de la demi-finale du favori (pour raconter comment il a atteint la finale).
const favSemi = doneSemis.find((m) => m.team1 === fav.team || m.team2 === fav.team);
let favSemiText = '';
if (favSemi && favSemi.score) {
  const favIs1 = favSemi.team1 === fav.team;
  const favScore = favSemi.score[favIs1 ? 0 : 1];
  const oppScore = favSemi.score[favIs1 ? 1 : 0];
  const oppCode = favIs1 ? favSemi.team2 : favSemi.team1;
  const beat: Record<string, string> = {
    en: `, already into the final after beating ${nc(oppCode)} ${favScore}–${oppScore} in the semifinals`,
    fr: `, déjà en finale après avoir battu ${nc(oppCode)} ${favScore}–${oppScore} en demi-finale`,
    es: `, ya en la final tras vencer a ${nc(oppCode)} por ${favScore}–${oppScore} en semifinales`,
  };
  favSemiText = beat[lang];
}

// Favori de la demi-finale encore à jouer.
let liveSemiSentence: Record<string, string> = { en: '', fr: '', es: '' };
if (liveSemi) {
  const wp = liveSemi.win_probs ?? {};
  const c1 = liveSemi.team1!, c2 = liveSemi.team2!;
  const p1 = Math.round((wp[c1] ?? 0) * 100);
  const p2 = Math.round((wp[c2] ?? 0) * 100);
  const [favC, favP] = p1 >= p2 ? [c1, p1] : [c2, p2];
  const opp = nc(throughFinal[0]);
  liveSemiSentence = {
    en: `The last ticket to the final goes through ${nc(c1)} vs ${nc(c2)} on ${fmtDate(liveSemi.date)}, with ${nc(favC)} a narrow favorite at ${pct(favP)}. The winner meets ${opp} in the final on ${fmtDate(finalMatch?.date)}.`,
    fr: `Le dernier billet pour la finale se joue dans ${nc(c1)} contre ${nc(c2)} le ${fmtDate(liveSemi.date)}, avec ${nc(favC)} léger favori à ${pct(favP)}. Le vainqueur retrouve ${opp} en finale le ${fmtDate(finalMatch?.date)}.`,
    es: `El último billete para la final se juega en ${nc(c1)} contra ${nc(c2)} el ${fmtDate(liveSemi.date)}, con ${nc(favC)} ligero favorito con ${pct(favP)}. El ganador se cruza con ${opp} en la final del ${fmtDate(finalMatch?.date)}.`,
  };
} else if (throughFinal.length >= 2) {
  liveSemiSentence = {
    en: `The final is set: ${nc(throughFinal[0])} vs ${nc(throughFinal[1])} on ${fmtDate(finalMatch?.date)}.`,
    fr: `La finale est connue : ${nc(throughFinal[0])} contre ${nc(throughFinal[1])} le ${fmtDate(finalMatch?.date)}.`,
    es: `La final está definida: ${nc(throughFinal[0])} contra ${nc(throughFinal[1])} el ${fmtDate(finalMatch?.date)}.`,
  };
}

const alive = board.filter((t) => t.p_champion > 0);
const aliveNames = joinList(alive.map((t) => n(t)));

const koHeading: Record<string, { eyebrow: string; title: string }> = {
  en: { eyebrow: `The model's read — run ${runDate}`, title: 'The favorite, the finalist and the last semifinal.' },
  fr: { eyebrow: `La lecture du modèle — run ${runDate}`, title: 'Le favori, le finaliste et la dernière demi-finale.' },
  es: { eyebrow: `La lectura del modelo — corrida ${runDate}`, title: 'El favorito, el finalista y la última semifinal.' },
};

const koParagraphs: Record<string, string[]> = {
  en: [
    `<strong>${n(fav)}</strong> is the model's favorite at ${pct(fav.p_champion)} to lift the trophy${favSemiText} — ahead of <strong>${n(second)}</strong> (${pct(second.p_champion)}) and <strong>${n(third)}</strong> (${pct(third.p_champion)}).`,
    liveSemiSentence.en,
    alive.length <= 4
      ? `A tournament that opened with 48 teams is down to its final ${alive.length}: ${aliveNames} are the only sides still alive.`
      : `From 48 teams, ${alive.length} are still alive with a path to the title.`,
  ],
  fr: [
    `<strong>${n(fav)}</strong> est le favori du modèle à ${pct(fav.p_champion)} de soulever le trophée${favSemiText} — devant <strong>${n(second)}</strong> (${pct(second.p_champion)}) et <strong>${n(third)}</strong> (${pct(third.p_champion)}).`,
    liveSemiSentence.fr,
    alive.length <= 4
      ? `Un tournoi ouvert à 48 équipes est réduit à ses ${alive.length} dernières : ${aliveNames} sont les seules encore en lice.`
      : `Sur 48 équipes, ${alive.length} sont encore en lice avec un chemin vers le titre.`,
  ],
  es: [
    `<strong>${n(fav)}</strong> es el favorito del modelo con ${pct(fav.p_champion)} de levantar el trofeo${favSemiText} — por delante de <strong>${n(second)}</strong> (${pct(second.p_champion)}) y <strong>${n(third)}</strong> (${pct(third.p_champion)}).`,
    liveSemiSentence.es,
    alive.length <= 4
      ? `Un torneo que abrió con 48 equipos se reduce a sus ${alive.length} últimos: ${aliveNames} son los únicos que siguen con vida.`
      : `De 48 equipos, ${alive.length} siguen vivos con camino al título.`,
  ],
};

const H = knockout ? koHeading[lang] : heading[lang];
const P = knockout ? koParagraphs[lang] : paragraphs[lang];
---

<section class="content-band">
  <div class="container">
    <p class="eyebrow">{H.eyebrow}</p>
    <h2>{H.title}</h2>
    <div class="wc-editorial">
      {P.filter(Boolean).map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>

<style>
  .wc-editorial {
    max-width: 720px;
    margin-top: 1rem;
  }
  .wc-editorial p {
    margin: 0 0 1rem;
    line-height: 1.7;
    font-size: 1.02rem;
  }
</style>
