---
// Desk présidentiel France 2027 — composant partagé fr/en (pattern
// ProjectionEngine : logique + markup + style une seule fois, langue en prop).
// Le modèle est PAR SCÉNARIOS (castings hypothétiques → 1er tour mean±sd +
// duel 2d tour), pas une projection par sièges.
import '../styles/fse.css';
import ElectionCountdown from '../islands/ElectionCountdown.tsx';
import FranceScenarioExplorer from '../islands/FranceScenarioExplorer.tsx';
import JurisdictionNav from './JurisdictionNav.astro';
import GooglePreferredSource from './GooglePreferredSource.astro';
import KeepDigging from './KeepDigging.astro';
import PolymarketEmbed from './PolymarketEmbed.astro';
import ContextualBookShelf from './ContextualBookShelf.astro';
import latest from '../../web_data/france-presidential/latest.json';
import dataSheets from '../../web_data/france-presidential/data_sheets.json';
import barrageLatest from '../../web_data/fr-barrage/latest.json';
import frLegLatest from '../../web_data/france-legislative/latest.json';
import byPoll from '../../web_data/france-presidential/polls_by_poll.json';
import candidacyEffects from '../../web_data/france-presidential/candidacy_effects.json';
import {
  toScenarioCard,
  blocVar,
  blocLabel,
  statusLabel,
  fmtPct1,
  scenarioProvenance,
  type FrScenario,
  type Locale,
} from '../lib/fr-pres';
import { slugify } from '../lib/fr-candidates';
import { franceCandBase } from '../lib/fr-pres';
import { pickHeroScenario, buildExplorerCards } from '../lib/fr-explorer';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const candBase = franceCandBase(locale);

// Législatives — carte teaser vers le desk (web_data/france-legislative).
const legPayload = frLegLatest as any;
const legCentralSc = legPayload.scenarios?.find((s: any) => s.id === legPayload.meta?.central_scenario);
const legPMaj = Math.round((legCentralSc?.p_majority_far_right ?? 0) * 100);
const legHref = { fr: '/fr/france/legislatives/', en: '/en/france/legislative-election/', es: '/es/france/legislativas/' }[locale];
const legCopy = {
  fr: {
    eyebrow: 'Législatives — en cas de dissolution',
    title: `p(majorité absolue RN) : ${legPMaj} % si front républicain au niveau 2024`,
    body: 'Les sondages législatifs français sont événementiels — il n’y en a presque jamais hors crise. Le modèle ancre donc sa projection au dernier sondage direct (oct. 2025) et lui applique le mouvement des intentions présidentielles, mesurées en continu : c’est le pont différentiel. Les 577 circonscriptions sont ensuite simulées avec des reports et désistements calibrés sur les 1 646 seconds tours de 2017-2024, en trois scénarios de front républicain.',
    cta: 'Voir la projection des législatives',
  },
  en: {
    eyebrow: 'Legislative — if dissolved today',
    title: `p(absolute RN majority): ${legPMaj}% under a 2024-level republican front`,
    body: 'French legislative polling is event-driven — it all but disappears outside crises. The model therefore anchors its projection to the last direct poll (Oct. 2025) and applies the movement of continuously-measured presidential intentions: the differential bridge. The 577 constituencies are then simulated with transfers and withdrawals calibrated on the 1,646 runoffs of 2017-2024, across three republican-front scenarios.',
    cta: 'See the legislative forecast',
  },
  es: {
    eyebrow: 'Legislativas — si se disolviera hoy',
    title: `p(mayoría absoluta RN): ${legPMaj}% con frente republicano al nivel de 2024`,
    body: 'Las encuestas legislativas francesas son episódicas — casi desaparecen fuera de las crisis. El modelo ancla su proyección a la última encuesta directa (oct. 2025) y le aplica el movimiento de las intenciones presidenciales, medidas en continuo: el puente diferencial. Las 577 circunscripciones se simulan luego con transferencias y retiradas calibradas sobre las 1.646 segundas vueltas de 2017-2024, en tres escenarios de frente republicano.',
    cta: 'Ver la proyección legislativa',
  },
}[locale];

// Cartes 2022 — teaser vers les résultats réels par circonscription.
const mapsHref = { fr: '/fr/france/presidentielle/cartes/', en: '/en/france/presidential/maps/', es: '/es/france/presidencial/mapas/' }[locale];
const mapsCopy = {
  fr: {
    eyebrow: 'Résultats officiels 2022',
    title: 'La carte de 2022, circonscription par circonscription',
    body: 'Bloc et candidat en tête au premier tour, duel Macron / Le Pen au second : les 566 circonscriptions, résultats réels du ministère de l’Intérieur.',
    cta: 'Voir la carte',
  },
  en: {
    eyebrow: 'Official 2022 results',
    title: 'The 2022 map, constituency by constituency',
    body: 'Leading bloc and leading candidate in round one, the Macron / Le Pen runoff in round two: all 566 constituencies, actual Ministry of the Interior results.',
    cta: 'See the map',
  },
  es: {
    eyebrow: 'Resultados oficiales de 2022',
    title: 'El mapa de 2022, circunscripción por circunscripción',
    body: 'Bloque y candidato en cabeza en la primera vuelta, el duelo Macron / Le Pen en la segunda: las 566 circunscripciones, resultados reales del ministerio del Interior.',
    cta: 'Ver el mapa',
  },
}[locale];

const marketCopy = {
  fr: {
    title: 'Marché — vainqueur de la présidentielle française 2027',
    subtitle: 'Probabilités implicites des traders, présentées comme repère indépendant de la projection Vote-Scope.',
  },
  en: {
    title: 'Market — winner of the 2027 French presidential election',
    subtitle: 'Trader-implied probabilities, shown as an independent benchmark beside the Vote-Scope forecast.',
  },
  es: {
    title: 'Mercado — ganador de la elección presidencial francesa de 2027',
    subtitle: 'Probabilidades implícitas de los operadores, como referencia independiente junto al pronóstico de Vote-Scope.',
  },
}[locale];

// Effet candidature — la carte s'accroche au plus gros report mesuré.
const effectHref = { fr: '/fr/france/effet-candidature/', en: '/en/france/candidacy-effect/', es: '/es/france/efecto-candidatura/' }[locale];
const topExit = (((candidacyEffects as any).exits ?? []) as any[])
  .filter((e) => e.destinations?.length)
  .sort((a, b) => b.own.mean - a.own.mean)[0];
const topShare = topExit ? Math.round(topExit.destinations[0].share_of_votes * 100) : 0;
const effectCopy = topExit ? {
  fr: { eyebrow: 'Effet candidature', title: `Sans ${topExit.short}, ${topShare} % de ses électeurs vont à ${topExit.destinations[0].short}`, body: 'Mesuré dans les sondages eux-mêmes : deux hypothèses d’une même enquête, un seul nom qui change. À qui chaque candidature prend ses voix.', cta: 'Voir l’effet candidature' },
  en: { eyebrow: 'Candidacy effect', title: `Without ${topExit.short}, ${topShare}% of those voters go to ${topExit.destinations[0].short}`, body: 'Measured inside the polls: two lineups from the same survey, one name changed. Where each candidacy takes its votes from.', cta: 'See the candidacy effect' },
  es: { eyebrow: 'Efecto candidatura', title: `Sin ${topExit.short}, el ${topShare} % de sus votantes va a ${topExit.destinations[0].short}`, body: 'Medido dentro de las encuestas: dos combinaciones de una misma encuesta, un solo nombre distinto. De quién toma sus votos cada candidatura.', cta: 'Ver el efecto candidatura' },
}[locale] : null;

// Barrage Index — carte promo live vers l'instrument (web_data/fr-barrage).
const bfi = (barrageLatest as any).bfi ?? {};
const barrageHref = `/${locale}/france/indexes/barrage/`;
const barrageCopy = {
  fr: {
    eyebrow: 'Indicateur suivi en continu',
    title: 'Indice du barrage',
    question: 'Le barrage républicain tient-il face au RN ?',
    zone: bfi.label_fr,
    cta: "Voir l'indice",
  },
  en: {
    eyebrow: 'Tracked continuously',
    title: 'Barrage Index',
    question: 'Does France’s republican front still hold against the RN?',
    zone: bfi.label_en,
    cta: 'Open the instrument',
  },
  es: {
    eyebrow: 'Indicador en continuo',
    title: 'Índice del barrage',
    question: '¿Aguanta el frente republicano francés ante el RN?',
    zone: bfi.label_es,
    cta: 'Abrir el instrumento',
  },
}[locale];

const meta = (latest as any).meta;
const scenarios = (latest as any).scenarios as FrScenario[];
const defaultId = (latest as any).default_scenario_id as string;

const candidates = ((dataSheets as any).candidates ?? []) as any[];

// Hero + explorateur : logique éditoriale partagée avec la page embed
// (voir ../lib/fr-explorer.ts pour le détail — RN déclaré, vedettes ≥ 3 sondages).
const { heroScenario, heroId, rnDeclared } = pickHeroScenario(scenarios, candidates, defaultId);
const heroCard = toScenarioCard(heroScenario, locale);
const headlineName = rnDeclared?.candidate_name ?? heroCard.qualification[0]?.name ?? '';

const explorerScenarios = buildExplorerCards(scenarios, heroId, locale);
// Sur quoi repose le casting mis en avant, et depuis quand. Le hero est le
// chiffre que la page affirme le plus fort : c'est là qu'une configuration
// jamais sondée telle quelle doit le dire elle-même.
const heroProvenance = scenarioProvenance(heroCard, locale);

const registry = candidates
  .filter((c) => ['declared', 'primary', 'probable'].includes(c.status))
  .sort((a, b) => {
    const order: Record<string, number> = { declared: 0, primary: 1, probable: 2 };
    const s = (order[a.status] ?? 9) - (order[b.status] ?? 9);
    if (s !== 0) return s;
    return (b.default_first_round_mean ?? 0) - (a.default_first_round_mean ?? 0);
  });
const nDeclared = candidates.filter((c) => c.status === 'declared').length;

const runDate = meta.run_date;
const nPolls = meta.n_first_round_polls;
const heroLead = heroCard.qualification[0];
const heroSecond = heroCard.qualification[1];

const firstRoundDate = new Date(`${meta.election_date_first_round}T00:00:00`);
const dateLocale = locale === 'fr' ? 'fr-FR' : locale === 'es' ? 'es-ES' : 'en-CA';
const dateLong = firstRoundDate.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const runDateLong = new Date(`${runDate}T12:00:00Z`).toLocaleDateString(dateLocale, {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const fmtDay = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', timeZone: 'UTC' });

// ── Derniers sondages — ce que les lecteurs viennent chercher ─────────────
// « sondage présidentielle 2027 aujourd'hui », « dernier sondage… » : l'en-tête
// montre d'abord les enquêtes les plus récentes, chacune liée à sa page.
const pollsBase = { fr: '/fr/france/sondages/', en: '/en/france/polls/', es: '/es/france/sondeos/' }[locale];
const shortById = new Map(candidates.map((c) => [c.candidate_id, c.short_label]));
const pollAnchor = (x: any) => String(x.field_end ?? x.release_date ?? '');
const latestPolls = [...(((byPoll as any).polls ?? []) as any[])]
  .sort((a, b) => pollAnchor(b).localeCompare(pollAnchor(a)) || String(b.release_date).localeCompare(String(a.release_date)))
  .slice(0, 4);
const nSurveys: number = (byPoll as any).meta?.n_polls ?? latestPolls.length;
// « 9-10 septembre » plutôt que « 9 septembre – 10 septembre ».
const fieldLabel = (x: any) => {
  if (!x.field_start || x.field_start === x.field_end) return fmtDay(pollAnchor(x));
  const sameMonth = String(x.field_start).slice(0, 7) === String(x.field_end).slice(0, 7);
  if (!sameMonth) return `${fmtDay(x.field_start)} – ${fmtDay(x.field_end)}`;
  const day = Number(String(x.field_start).slice(8, 10));
  return locale === 'en'
    ? `${fmtDay(x.field_end).replace(/\d+/, (d) => `${day}–${d}`)}`
    : `${day}-${fmtDay(x.field_end)}`;
};
const pollTop = (x: any, n = 3) =>
  ((x.lead_entries ?? []) as any[]).slice(0, n).map((e) => ({
    name: shortById.get(e.id) ?? e.name,
    share: e.share,
  }));

// ── Qui affronterait le premier au second tour ────────────────────────────
// Ce qu'aucun sondage isolé ne donne : la chance de chaque candidat d'être
// au second tour, et le score de son duel face au premier. On n'affiche PAS
// de probabilité de victoire globale ici : à sept mois, le modèle la donne
// trop tranchée (calibration de la confiance à revoir).
const leader = heroCard.qualification[0];
const heroDuels = ((heroScenario as any).duels ?? []) as any[];
const opponents = heroCard.qualification
  .filter((q) => q.id !== leader?.id && q.pTop2 >= 0.05)
  .sort((a, b) => b.pTop2 - a.pTop2)
  .slice(0, 3)
  .map((q) => {
    const d = heroDuels.find(
      (x) =>
        (x.duel_left_id === q.id && x.duel_right_id === leader?.id) ||
        (x.duel_right_id === q.id && x.duel_left_id === leader?.id),
    );
    const share: number | null = d
      ? d.duel_left_id === q.id ? d.left_share_expressed_mean : d.right_share_expressed_mean
      : null;
    return { ...q, duelShare: share };
  });
const pctInt = (v: number) => `${Math.round(v * 100)}${locale === 'en' ? '%' : ' %'}`;

// ── Prose SEO auto-générée (change à chaque run/sondage) ──────────────────
// Vrai texte au-dessus des graphiques, dérivé du run courant : donne aux
// moteurs de recherche autre chose à citer que des cellules de barre, et
// reste exact sans réécriture manuelle. Même principe que le desk Québec.
const hDuel = heroCard.duel;
const duelWinnerName = hDuel
  ? hDuel.winnerId === hDuel.leftId
    ? hDuel.leftName
    : hDuel.rightName
  : '';
const duelLoserName = hDuel
  ? hDuel.winnerId === hDuel.leftId
    ? hDuel.rightName
    : hDuel.leftName
  : '';
const duelWinShare = hDuel ? Math.max(hDuel.leftShare, hDuel.rightShare) : 0;
const duelLoseShare = hDuel ? Math.min(hDuel.leftShare, hDuel.rightShare) : 0;

const headlineLeads = heroLead?.name === headlineName;
const introParagraphs =
  locale === 'es'
    ? [
        heroLead && heroSecond
          ? headlineLeads
            ? `Según nuestra agregación de ${nPolls} encuestas (actualización del ${runDateLong}), en la combinación más sondeada ${headlineName} — candidata de la Agrupación Nacional oficialmente declarada — encabeza la primera vuelta con ${fmtPct1(heroLead.mean, locale)}, por delante de ${heroSecond.name} con ${fmtPct1(heroSecond.mean, locale)}. Ambos pasarían a la segunda vuelta.`
            : `Según nuestra agregación de ${nPolls} encuestas (actualización del ${runDateLong}), en la combinación más sondeada que incluye a ${headlineName} (candidata de la Agrupación Nacional oficialmente declarada), ${heroLead.name} encabeza la primera vuelta con ${fmtPct1(heroLead.mean, locale)}, por delante de ${heroSecond.name} con ${fmtPct1(heroSecond.mean, locale)}. Ambos pasarían a la segunda vuelta.`
          : '',
        hDuel
          ? `En segunda vuelta, nuestro pronóstico sitúa a ${duelWinnerName} en cabeza con ${fmtPct1(duelWinShare, locale)} frente a ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), a partir de encuestas de duelo y transferencias históricas. Es nuestra mejor estimación central para esta combinación, dentro de un abanico de resultados plausibles; la campaña de 2027 apenas comienza y el campo de ${nDeclared} candidaturas declaradas sigue cambiando.`
          : '',
      ]
    : locale === 'fr'
    ? [
        heroLead && heroSecond
          ? headlineLeads
            ? `D'après notre moyenne des sondages (${nSurveys} enquêtes, ${nPolls} hypothèses testées, mise à jour du ${runDateLong}), dans l’hypothèse la plus testée, ${headlineName} — candidate du Rassemblement national officiellement déclarée — mène le premier tour à ${fmtPct1(heroLead.mean, locale)}, devant ${heroSecond.name} à ${fmtPct1(heroSecond.mean, locale)}. Les deux se qualifieraient pour le second tour.`
            : `D'après notre moyenne des sondages (${nSurveys} enquêtes, ${nPolls} hypothèses testées, mise à jour du ${runDateLong}), dans l’hypothèse la plus testée incluant ${headlineName} (candidate du Rassemblement national officiellement déclarée), ${heroLead.name} mène le premier tour à ${fmtPct1(heroLead.mean, locale)}, devant ${heroSecond.name} à ${fmtPct1(heroSecond.mean, locale)}. Les deux se qualifieraient pour le second tour.`
          : '',
        hDuel
          ? `Au second tour, notre projection donne ${duelWinnerName} en tête à ${fmtPct1(duelWinShare, locale)} face à ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), à partir des sondages de duel et des reports historiques. C’est notre estimation centrale pour cette hypothèse, entourée d’une marge d’incertitude ; la campagne ne fait que commencer et le champ des ${nDeclared} candidatures déclarées continue d’évoluer.`
          : '',
      ]
    : [
        heroLead && heroSecond
          ? headlineLeads
            ? `Based on our aggregation of ${nPolls} polls (updated ${runDateLong}), in the most-polled lineup ${headlineName} — the officially declared National Rally candidate — leads the first round at ${fmtPct1(heroLead.mean, locale)}, ahead of ${heroSecond.name} at ${fmtPct1(heroSecond.mean, locale)}. Both would advance to the runoff.`
            : `Based on our aggregation of ${nPolls} polls (updated ${runDateLong}), in the most-polled lineup featuring ${headlineName} (the officially declared National Rally candidate), ${heroLead.name} leads the first round at ${fmtPct1(heroLead.mean, locale)}, ahead of ${heroSecond.name} at ${fmtPct1(heroSecond.mean, locale)}. Both would advance to the runoff.`
          : '',
        hDuel
          ? `In the runoff, our forecast has ${duelWinnerName} ahead at ${fmtPct1(duelWinShare, locale)} against ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), based on head-to-head polls and historical transfers. This is our best central estimate for that lineup, surrounded by a range of plausible outcomes; the 2027 campaign is just starting and the field of ${nDeclared} declared candidates keeps shifting.`
          : '',
      ];


