    kdLinks: [
      { href: '/en/uk/', label: 'U.K. general election', detail: 'Westminster projection' },
      { href: '/en/canada/federal/', label: 'Canada federal', detail: '343 seats' },
      { href: '/en/us/indexes/lame-duck/', label: 'Lame-Duck Index', detail: 'U.S. pre-election drag' },
      { href: '/en/', label: 'All elections', detail: 'Vote-Scope home' },
    ],
    summaryLabel: 'Forecast summary',
  },
  es: {
    kicker: 'Presidencial francesa 2027 · Promedio de encuestas y pronóstico',
    titleA: 'Francia 2027: ¿quién puede ',
    titleEm: 'ganar',
    titleB: '?',
    dek: 'Todas las encuestas publicadas, reunidas en un promedio, y la elección simulada 50.000 veces: quién pasa a la segunda vuelta y quién la gana.',
    voteDay: `Primera vuelta el ${dateLong}`,
    updated: `Actualizado el ${runDateLong}`,
    surveys: `${nSurveys} encuestas`,
    tested: `${nPolls} combinaciones probadas`,
    latestLabel: 'Última encuesta',
    firstAvg: 'Primera vuelta — nuestro promedio',
    secondWho: (name: string) => `¿Quién se enfrentaría a ${name} en la segunda vuelta?`,
    qualifies: 'de probabilidad de llegar',
    duelLabel: 'Segunda vuelta:',
    seePoll: 'Ver esta encuesta',
    latestTitle: 'Últimas encuestas',
    allPolls: 'Todas las encuestas presidenciales de 2027',
    sample: (n: number) => `${n.toLocaleString('es-ES')} pers.`,
    ctaExplore: 'Comparar las combinaciones',
    ctaMethod: 'Metodología',
    methodHref: '/es/metodologia/',
    countdownTitle: `Primera vuelta el ${dateLong}.`,
    explorerTitle: 'Comparar las combinaciones de candidatos',
    explorerHelp:
      'Mientras las candidaturas no sean definitivas, los institutos prueban varias listas de candidatos. Elija una para ver nuestro promedio de la primera vuelta y la segunda vuelta más probable.',
    addTitle: 'Lo que Vote-Scope añade a las encuestas',
    addItems: [
      { h: 'Todas las encuestas en un solo lugar', p: 'Ifop, Ipsos BVA, Elabe, OpinionWay, Harris, Odoxa, Cluster17, Verian… Cada encuesta registrada ante la comisión francesa de sondeos entra en el promedio en la siguiente actualización, con todas sus combinaciones.' },
      { h: 'Un promedio, no una encuesta aislada', p: 'Una encuesta sola puede desviarse dos o tres puntos. Cada una pesa según su fecha, su tamaño y el sesgo habitual de su instituto: el promedio se mueve menos, y por razones reales.' },
      { h: 'La segunda vuelta, calculada', p: 'Los institutos solo prueban algunos duelos. Simulamos la primera vuelta y luego cada duelo posible con las transferencias de voto observadas desde 2017: quién tiene más probabilidades de clasificarse, y con qué resultado.' },
    ],
    howTitle: 'Cómo leer esta página',
    howItems: [
      'Arriba: la última encuesta publicada y nuestro promedio para la combinación más probada.',
      'El comparador muestra el efecto de una candidatura: con o sin Attal, Philippe u Hollande.',
      'Cada candidato tiene su ficha y cada encuesta su página, con la nota oficial.',
    ],
    registryTitle: 'Los candidatos',
    registryHelp: `Estado al ${runDateLong}. Haga clic en un nombre para ver su ficha: trayectoria, encuestas y duelos.`,
    allCandidates: 'Todos los candidatos',
    moreTitle: 'Ir más lejos',
    kdEyebrow: 'Seguir explorando',
    kdTitle: 'Nuestros otros pronósticos.',
    kdBody: 'Elecciones y encuestas que Vote-Scope sigue en el mundo.',
    kdLinks: [
      { href: '/es/uk/', label: 'Elección general R.U.', detail: 'Proyección Westminster' },
      { href: '/es/canada/federal/', label: 'Canadá federal', detail: '343 escaños' },
      { href: '/es/us/indexes/lame-duck/', label: 'Índice Lame-Duck', detail: 'Presión preelectoral EE. UU.' },
      { href: '/es/', label: 'Todas las elecciones', detail: 'Inicio de Vote-Scope' },
    ],
    summaryLabel: 'Resumen del pronóstico',
  },
};
const C = COPY[locale];
---

<JurisdictionNav webKey="france" lang={locale} active="projection" />

<article class="fr-desk" data-content-area>
  <!-- EN-TÊTE — ce qu'on fait et les chiffres clés (dernier sondage, notre
       moyenne, second tour) dans le premier écran. Les pubs s'insèrent entre
       les enfants directs de l'article : cinq petits encarts en tête
       repoussaient les chiffres à 5 268 px, derrière six pubs. Règle : les
       chiffres d'abord, la pub au premier défilement. -->
  <header class="fr-hero container" aria-label={C.summaryLabel}>
    <p class="fr-kicker">{C.kicker}</p>
    <h1 class="fr-title">{C.titleA}<em>{C.titleEm}</em>{C.titleB}</h1>
    <p class="fr-dek">{C.dek}</p>
    <div class="fr-meta">
      <span>{C.updated}</span>
      <span aria-hidden="true">·</span>
      <span>{C.surveys}</span>
      <span aria-hidden="true">·</span>
      <span>{C.tested}</span>
      <span aria-hidden="true">·</span>
      <span>{C.voteDay}</span>
    </div>

    <div class="fr-hero-headline">
      {latestPolls[0] && (
        <a class="fr-hl-card fr-hl-latest" href={`${pollsBase}${latestPolls[0].slug}/`}>
          <span class="fr-hl-label">{C.latestLabel}</span>
          <p class="fr-hl-firm">{latestPolls[0].firm_name}<span>{fieldLabel(latestPolls[0])}</span></p>
          <div class="fr-hl-pair">
            {pollTop(latestPolls[0]).map((e) => (
              <span class="fr-hl-cand">{e.name} <b>{fmtPct1(e.share, locale)}</b></span>
            ))}
          </div>
          <span class="fr-hl-more">{C.seePoll} →</span>
        </a>
      )}
      {heroLead && (
        <div class="fr-hl-card">
          <span class="fr-hl-label">{C.firstAvg}</span>
          <p class="fr-hl-scenario">{heroCard.label}</p>
          <div class="fr-hl-pair">
            {heroCard.qualification.slice(0, 4).map((q) => (
              <span class="fr-hl-cand">
                <span class="fr-swatch" style={`background:${blocVar(q.bloc)}`} />
                {q.name} <b>{fmtPct1(q.mean, locale)}</b>
              </span>
            ))}
          </div>
        </div>
      )}
      {leader && opponents.length > 0 && (
        <div class="fr-hl-card">
          <span class="fr-hl-label">{C.secondWho(leader.name)}</span>
          <ul class="fr-hl-opp">
            {opponents.map((o) => (
              <li>
                <span class="fr-hl-opp-name">
                  <span class="fr-swatch" style={`background:${blocVar(o.bloc)}`} />
                  {o.name}
                </span>
                <span class="fr-hl-opp-p"><b>{pctInt(o.pTop2)}</b> {C.qualifies}</span>
                {typeof o.duelShare === 'number' && (
                  <span class="fr-hl-opp-duel">
                    {C.duelLabel} {shortById.get(o.id) ?? o.name} {fmtPct1(o.duelShare, locale)} – {shortById.get(leader.id) ?? leader.name} {fmtPct1(100 - o.duelShare, locale)}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <p class={`fr-provenance${heroProvenance.stale ? ' is-stale' : ''}${heroProvenance.borrowed ? ' is-borrowed' : ''}`}>
      {heroProvenance.text}
    </p>

    <GooglePreferredSource locale={locale} />
  </header>

  <!-- DERNIERS SONDAGES — après la première pub : le lecteur a déjà vu les
       chiffres clés en haut, la pub passe au premier défilement. -->
  {latestPolls.length > 1 && (
    <section class="fr-section container fr-latest" aria-labelledby="fr-latest-title">
      <h2 id="fr-latest-title" class="fr-section-title">{C.latestTitle}</h2>
      <ol class="fr-latest-list">
        {latestPolls.map((x) => (
          <li>
            <a href={`${pollsBase}${x.slug}/`}>
              <span class="fr-latest-firm">{x.firm_name}</span>
              <span class="fr-latest-date">{fieldLabel(x)}{x.sample_size ? ` · ${C.sample(x.sample_size)}` : ''}</span>
              <span class="fr-latest-top">
                {pollTop(x).map((e) => <span>{e.name} <b>{fmtPct1(e.share, locale)}</b></span>)}
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="fr-cta-row">
        <a class="fr-cta fr-cta-strong" href={pollsBase}>{C.allPolls} →</a>
        <a class="fr-cta" href="#fr-explorer-title">{C.ctaExplore} ↓</a>
      </div>
    </section>
  )}

  <!-- COMPARATEUR — les chiffres, après les derniers sondages -->
  <section id="fr-explorer" class="fr-section container" aria-labelledby="fr-explorer-title">
    <h2 id="fr-explorer-title" class="fr-section-title">{C.explorerTitle}</h2>
    <p class="fr-section-help">{C.explorerHelp}</p>
    <div class="fr-explorer-card">
      <FranceScenarioExplorer scenarios={explorerScenarios} locale={locale} embedPath={`/${locale}/embed/france-scenarios`} client:visible />
    </div>
  </section>

  <!-- CE QU'ON AJOUTE AUX SONDAGES + COMMENT LIRE LA PAGE -->
  <section class="fr-section container fr-explain" aria-labelledby="fr-explain-title">
    <h2 id="fr-explain-title" class="fr-section-title">{C.addTitle}</h2>
    <ol class="fr-add">
      {C.addItems.map((it, i) => (
        <li><span class="fr-add-n">{i + 1}</span><h3>{it.h}</h3><p>{it.p}</p></li>
      ))}
    </ol>
    <div class="fr-how">
      <h3>{C.howTitle}</h3>
      <ul>{C.howItems.map((t) => <li>{t}</li>)}</ul>
      <a class="fr-cta" href={C.methodHref}>{C.ctaMethod} →</a>
    </div>
  </section>

  <!-- RÉSUMÉ EN PROSE (auto-généré depuis le run) -->
  <section class="fr-section container fr-intro" aria-label={C.summaryLabel}>
    {introParagraphs.filter(Boolean).map((para) => <p>{para}</p>)}
  </section>

  <!-- CANDIDATS -->
  <section class="fr-section container" aria-labelledby="fr-registry-title">
    <h2 id="fr-registry-title" class="fr-section-title">{C.registryTitle}</h2>
    <p class="fr-section-help">{C.registryHelp}</p>
    <ul class="fr-registry">
      {registry.map((c) => (
        <li>
          <a class="fr-reg-item" href={`${candBase}/${slugify(c.candidate_name)}/`}>
            <span class="fr-swatch" style={`background:${blocVar(c.bloc)}`} />
            <span class="fr-reg-name">{c.candidate_name}</span>
            <span class="fr-reg-bloc">{blocLabel(c.bloc, locale, c.party_family)}</span>
            <span class={`fr-reg-status is-${c.status}`}>{statusLabel(c.status, locale)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="fr-cta-row" style="margin-top:18px;">
      <a class="fr-cta" href={candBase}>{C.allCandidates} →</a>
    </div>
  </section>

  <!-- ALLER PLUS LOIN — un seul bloc (une seule insertion publicitaire) -->
  <section class="fr-section container" aria-labelledby="fr-more-title">
    <h2 id="fr-more-title" class="fr-section-title">{C.moreTitle}</h2>
    <div class="fr-more-grid">
      <div class="fr-more-countdown">
        <ElectionCountdown
          targetDate={meta.election_date_first_round}
          locale={locale}
          title={C.countdownTitle}
          client:load
        />
      </div>
      {effectCopy && (
        <a class="note-card" href={effectHref} style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--ink);">
          <p class="eyebrow">{effectCopy.eyebrow}</p>
          <h3 style="margin:0.25rem 0;">{effectCopy.title}</h3>
          <p>{effectCopy.body}</p>
          <footer style="margin-top:0.75rem;"><span class="cta-link">{effectCopy.cta} →</span></footer>
        </a>
      )}
      <a class="note-card" href={barrageHref} style={`display:block;text-decoration:none;color:inherit;border-left:4px solid ${bfi.zone_color ?? 'var(--ink-3)'};`}>
        <p class="eyebrow">{barrageCopy.eyebrow}</p>
        <h3 style="margin:0.25rem 0;">{barrageCopy.title} — <span style={`color:${bfi.zone_color ?? 'inherit'}`}>{typeof bfi.score === 'number' ? (locale === 'en' ? bfi.score.toFixed(1) : bfi.score.toFixed(1).replace('.', ',')) : '—'}/100 · {barrageCopy.zone ?? ''}</span></h3>
        <p>{barrageCopy.question}</p>
        <footer style="margin-top:0.75rem;"><span class="cta-link">{barrageCopy.cta} →</span></footer>
      </a>
      <a class="note-card" href={legHref} style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--bloc-far_right, #2b4f8c);">
        <p class="eyebrow">{legCopy.eyebrow}</p>
        <h3 style="margin:0.25rem 0;">{legCopy.title}</h3>
        <p>{legCopy.body}</p>
        <footer style="margin-top:0.75rem;"><span class="cta-link">{legCopy.cta} →</span></footer>
      </a>
      <a class="note-card" href={mapsHref} style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--bloc-centre, #b7860f);">
        <p class="eyebrow">{mapsCopy.eyebrow}</p>
        <h3 style="margin:0.25rem 0;">{mapsCopy.title}</h3>
        <p>{mapsCopy.body}</p>
        <footer style="margin-top:0.75rem;"><span class="cta-link">{mapsCopy.cta} →</span></footer>
      </a>
    </div>
  </section>

  <!-- MARCHÉ DE PRÉDICTION — repère indépendant, plus bas -->
  <section class="fr-section container fr-market" aria-label={marketCopy.title}>
    <PolymarketEmbed
      slug="next-french-presidential-election"
      kind="event"
      lang={locale}
      eventUrl="https://polymarket.com/event/next-french-presidential-election"
      title={marketCopy.title}
      subtitle={marketCopy.subtitle}
      height={520}
    />
  </section>

  <section class="fr-section container">
    <ContextualBookShelf lang={locale} context="france-president" />
  </section>

  <section class="fr-section container">
    <KeepDigging
      eyebrow={C.kdEyebrow}
      title={C.kdTitle}
      body={C.kdBody}
      links={C.kdLinks}
    />
  </section>
</article>

<style>
  /* Palette de blocs — convention politique française, validée dataviz
     (six-checks, clair + sombre). Identité portée aussi par les étiquettes.
     Thème piloté par [data-theme] (Base.astro), jamais @media seul. */
  .fr-desk {
    --bloc-far_left: #6b1f2e;
    --bloc-left: #b0202a;
    --bloc-left_radical: #c1272d;
    --bloc-left_populist: #d4602e;
    --bloc-left_social_dem: #e5567f;
    --bloc-greens: #4a9d5b;
    --bloc-centre: #b7860f;
    --bloc-centre_right: #bf6d1f;
    --bloc-right: #3f82d6;
    --bloc-sovereignist: #6d4c8a;
    --bloc-far_right: #2b4f8c;
    --bloc-other: var(--ink-3);
    padding-block: 64px 96px;
  }
  :global(:root[data-theme='dark']) .fr-desk {
    --bloc-far_left: #a8474f;
    --bloc-left: #d24b52;
    --bloc-left_radical: #e0574f;
    --bloc-left_populist: #e08a5a;
    --bloc-left_social_dem: #d5628a;
    --bloc-greens: #4fa460;
    --bloc-centre: #b88d2c;
    --bloc-centre_right: #cc7f3e;
    --bloc-right: #5a95d8;
    --bloc-sovereignist: #9c7ac0;
    --bloc-far_right: #3a6bb0;
  }

  .fr-hero {
    max-width: 1080px;
    padding-bottom: 44px;
    border-bottom: 1px solid var(--rule);
  }
  .fr-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fr-title {
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(36px, 6.5vw, 78px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .fr-title em {
    font-style: italic;
    color: var(--ink-2);
  }
  .fr-dek {
    max-width: 680px;
    margin: 0 0 22px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
  }
  .fr-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }
  .fr-meta span[aria-hidden] {
    color: var(--rule);
  }
  /* Provenance du casting mis en avant — discrète, mais jamais absente. */
  .fr-provenance {
    margin-top: 12px;
    padding-left: 10px;
    border-left: 2px solid var(--rule);
    max-width: 62ch;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .fr-provenance.is-stale,
  .fr-provenance.is-borrowed {
    border-left-color: var(--ink-4);
    color: var(--ink-2);
  }
  .fr-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .fr-cta {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .fr-cta:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .fr-cta-strong {
    background: var(--ink);
    color: var(--paper-3);
    border-color: var(--ink);
  }
  .fr-cta-strong:hover {
    color: var(--paper-3);
    filter: brightness(1.15);
  }
  .fr-intro {
    max-width: 760px;
  }
  .fr-intro p {
    margin: 0 0 0.85rem;
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .fr-hero-headline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .fr-hl-label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 10px;
  }
  .fr-hl-pair {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fr-hl-cand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--ink-2);
  }
  .fr-hl-cand b {
    margin-left: auto;
    color: var(--ink);
  }
  .fr-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex: none;
  }

  .fr-hl-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    padding: 16px 18px;
    color: inherit;
    text-decoration: none;
  }
  a.fr-hl-card { transition: border-color 0.15s ease; }
  a.fr-hl-card:hover { border-color: var(--ink); }
  .fr-hl-latest { border-top: 3px solid var(--ink); }
  .fr-hl-firm {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 20px;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fr-hl-firm span, .fr-hl-scenario {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .fr-hl-scenario { margin: -4px 0 10px; }
  .fr-hl-more {
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .fr-hl-opp { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .fr-hl-opp li { display: grid; gap: 2px; }
  .fr-hl-opp-name { display: flex; align-items: center; gap: 8px; font-family: var(--serif); font-size: 17px; color: var(--ink); }
  .fr-hl-opp-p { font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .fr-hl-opp-p b { color: var(--ink); }
  .fr-hl-opp-duel { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  .fr-latest-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .fr-latest-list a {
    display: grid;
    grid-template-columns: minmax(110px, 160px) minmax(150px, 220px) 1fr;
    gap: 6px 16px;
    align-items: baseline;
    padding: 12px 2px;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .fr-latest-list a:hover { background: var(--card); }
  .fr-latest-firm { font-family: var(--serif); font-size: 17px; color: var(--ink); }
  .fr-latest-date { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  .fr-latest-top { display: flex; flex-wrap: wrap; gap: 4px 14px; font-family: var(--mono); font-size: 13px; color: var(--ink-2); }
  .fr-latest-top b { color: var(--ink); }
  @media (max-width: 640px) {
    .fr-latest-list a { grid-template-columns: 1fr; }
  }
  .fr-add { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .fr-add li { border: 1px solid var(--rule); border-radius: 6px; background: var(--card); padding: 18px; }
  .fr-add-n { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: var(--paper-3); font-family: var(--mono); font-size: 12px; }
