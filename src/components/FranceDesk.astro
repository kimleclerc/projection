    allPolls: 'Tous les sondages de la présidentielle',
    sample: (n: number) => `${n.toLocaleString('fr-FR')} pers.`,
    ctaExplore: 'Comparer les hypothèses',
    ctaMethod: 'Méthodologie',
    methodHref: '/fr/methodologie/',
    countdownTitle: `Premier tour le ${dateLong}.`,
    explorerTitle: 'Comparer les hypothèses de candidatures',
    explorerHelp:
      'Tant que les candidatures ne sont pas arrêtées, les instituts testent plusieurs listes de candidats. Choisissez-en une : vous voyez notre moyenne du premier tour et le second tour le plus probable.',
    addTitle: 'Ce que Vote-Scope ajoute aux sondages',
    addItems: [
      { h: 'Tous les sondages au même endroit', p: 'Ifop, Ipsos BVA, Elabe, OpinionWay, Harris, Odoxa, Cluster17, Verian… Chaque enquête déposée à la Commission des sondages entre dans la moyenne à la mise à jour suivante, avec toutes ses hypothèses.' },
      { h: 'Une moyenne plutôt qu’un sondage isolé', p: 'Un sondage seul peut s’écarter de deux ou trois points. Chaque enquête pèse selon sa date, sa taille et les écarts habituels de son institut : la moyenne bouge moins, et bouge pour de vraies raisons.' },
      { h: 'Le second tour, calculé', p: 'Les instituts ne testent que quelques duels. Nous simulons le premier tour, puis chaque duel possible avec les reports de voix observés depuis 2017 : qui a le plus de chances de se qualifier, et avec quel score.' },
