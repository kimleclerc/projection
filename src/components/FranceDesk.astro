---
// Desk présidentiel France 2027 — composant partagé fr/en (pattern
// ProjectionEngine : logique + markup + style une seule fois, langue en prop).
// Le modèle est PAR SCÉNARIOS (castings hypothétiques → 1er tour mean±sd +
// duel 2d tour), pas une projection par sièges.
import ElectionCountdown from '../islands/ElectionCountdown.tsx';
import FranceScenarioExplorer from '../islands/FranceScenarioExplorer.tsx';
import KeepDigging from './KeepDigging.astro';
import latest from '../../web_data/france-presidential/latest.json';
import dataSheets from '../../web_data/france-presidential/data_sheets.json';
import barrageLatest from '../../web_data/fr-barrage/latest.json';
import frLegLatest from '../../web_data/france-legislative/latest.json';
import {
  toScenarioCard,
  blocVar,
  blocLabel,
  statusLabel,
  fmtPct1,
  type FrScenario,
  type Locale,
} from '../lib/fr-pres';
import { slugify } from '../lib/fr-candidates';
import { franceCandBase } from '../lib/fr-pres';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const candBase = franceCandBase(locale);

// Législatives — carte teaser vers le desk (web_data/france-legislative).
const legPayload = frLegLatest as any;
const legCentralSc = legPayload.scenarios?.find((s: any) => s.id === legPayload.meta?.central_scenario);
const legPMaj = Math.round((legCentralSc?.p_majority_far_right ?? 0) * 100);
const legHref = { fr: '/fr/france/legislatives', en: '/en/france/legislative-election', es: '/es/france/legislativas' }[locale];
const legCopy = {
  fr: {
    eyebrow: 'Législatives — en cas de dissolution',
    title: `p(majorité absolue RN) : ${legPMaj} % si front républicain au niveau 2024`,
    body: 'Les sondages législatifs français sont événementiels — il n’y en a presque jamais hors crise. Le modèle ancre donc sa projection au dernier sondage direct (oct. 2025) et lui applique le mouvement des intentions présidentielles, mesurées en continu : c’est le pont différentiel. Les 577 circonscriptions sont ensuite simulées avec des reports et désistements calibrés sur les 1 646 seconds tours de 2017-2024, en trois scénarios de front républicain.',
    cta: 'Ouvrir le desk législatif',
  },
  en: {
    eyebrow: 'Legislative — if dissolved today',
    title: `p(absolute RN majority): ${legPMaj}% under a 2024-level republican front`,
    body: 'French legislative polling is event-driven — it all but disappears outside crises. The model therefore anchors its projection to the last direct poll (Oct. 2025) and applies the movement of continuously-measured presidential intentions: the differential bridge. The 577 constituencies are then simulated with transfers and withdrawals calibrated on the 1,646 runoffs of 2017-2024, across three republican-front scenarios.',
    cta: 'Open the legislative desk',
  },
  es: {
    eyebrow: 'Legislativas — si se disolviera hoy',
    title: `p(mayoría absoluta RN): ${legPMaj}% con frente republicano al nivel de 2024`,
    body: 'Las encuestas legislativas francesas son episódicas — casi desaparecen fuera de las crisis. El modelo ancla su proyección a la última encuesta directa (oct. 2025) y le aplica el movimiento de las intenciones presidenciales, medidas en continuo: el puente diferencial. Las 577 circunscripciones se simulan luego con transferencias y retiradas calibradas sobre las 1.646 segundas vueltas de 2017-2024, en tres escenarios de frente republicano.',
    cta: 'Abrir el desk legislativo',
  },
}[locale];

// Barrage Index — carte promo live vers l'instrument (web_data/fr-barrage).
const bfi = (barrageLatest as any).bfi ?? {};
const barrageHref = `/${locale}/france/indexes/barrage/`;
const barrageCopy = {
  fr: {
    eyebrow: 'Instrument live',
    title: 'Barrage Index',
    question: 'Le barrage républicain tient-il face au RN ?',
    zone: bfi.label_fr,
    cta: "Ouvrir l'instrument",
  },
  en: {
    eyebrow: 'Live instrument',
    title: 'Barrage Index',
    question: 'Does France’s republican front still hold against the RN?',
    zone: bfi.label_en,
    cta: 'Open the instrument',
  },
  es: {
    eyebrow: 'Instrumento en vivo',
    title: 'Barrage Index',
    question: '¿Aguanta el frente republicano francés ante el RN?',
    zone: bfi.label_es,
    cta: 'Abrir el instrumento',
  },
}[locale];

const meta = (latest as any).meta;
const scenarios = (latest as any).scenarios as FrScenario[];
const defaultId = (latest as any).default_scenario_id as string;

const candidates = ((dataSheets as any).candidates ?? []) as any[];
const defaultScenario =
  scenarios.find((s) => s.scenario.scenario_id === defaultId) ?? scenarios[0];

// MISE EN AVANT DU CANDIDAT RN DÉCLARÉ (éditorial, data-driven) : au juillet
// 2026 c'est Marine Le Pen, pas Bardella. Le hero features le casting vedette
// LE PLUS SONDÉ qui inclut le candidat d'extrême droite officiellement
// déclaré. Si une décision de justice rebascule la candidature (Bardella),
// le hero suit automatiquement — aucune valeur codée en dur. Repli sur le
// scénario par défaut du modèle si aucun RN déclaré.
const declaredCandidates = candidates.filter((c) => c.status === 'declared');
const rnDeclared = declaredCandidates.find((c) => c.bloc === 'far_right');
const rnHeroScenario = rnDeclared
  ? [...scenarios]
      .filter(
        (s) =>
          s.scenario.featured &&
          s.scenario.active_candidate_ids.includes(rnDeclared.candidate_id),
      )
      .sort((a, b) => (b.diagnostics?.n_polls_used ?? 0) - (a.diagnostics?.n_polls_used ?? 0))[0]
  : undefined;
const heroScenario = rnHeroScenario ?? defaultScenario;
const heroId = heroScenario.scenario.scenario_id;
const heroCard = toScenarioCard(heroScenario, locale);
const headlineName = rnDeclared?.candidate_name ?? heroCard.qualification[0]?.name ?? '';

// Explorateur : vedettes robustes (≥ 3 sondages), scénario du hero en tête,
// castings Le Pen ensuite, puis par nombre de sondages.
const featured = scenarios.filter((s) => s.scenario.featured);
const explorerScenarios = [...featured]
  .filter((s) => s.scenario.scenario_id === heroId || (s.diagnostics?.n_polls_used ?? 0) >= 3)
  .sort((a, b) => {
    if (a.scenario.scenario_id === heroId) return -1;
    if (b.scenario.scenario_id === heroId) return 1;
    const aLepen = a.scenario.category === 'le_pen' ? 1 : 0;
    const bLepen = b.scenario.category === 'le_pen' ? 1 : 0;
    if (aLepen !== bLepen) return bLepen - aLepen;
    return (b.diagnostics?.n_polls_used ?? 0) - (a.diagnostics?.n_polls_used ?? 0);
  })
  .slice(0, 8)
  .map((s) => toScenarioCard(s, locale));

const registry = candidates
  .filter((c) => ['declared', 'probable'].includes(c.status))
  .sort((a, b) => {
    const order: Record<string, number> = { declared: 0, probable: 1 };
    const s = (order[a.status] ?? 9) - (order[b.status] ?? 9);
    if (s !== 0) return s;
    return (b.default_first_round_mean ?? 0) - (a.default_first_round_mean ?? 0);
  });
const nDeclared = declaredCandidates.length;

const runDate = meta.run_date;
const nPolls = meta.n_first_round_polls;
const heroLead = heroCard.qualification[0];
const heroSecond = heroCard.qualification[1];

// ── Prose SEO auto-générée (change à chaque run/sondage) ──────────────────
// Vrai texte au-dessus des graphiques, dérivé du run courant : donne aux
// moteurs de recherche autre chose à citer que des cellules de barre, et
// reste exact sans réécriture manuelle. Même principe que le desk Québec.
const hDuel = heroCard.duel;
const duelWinnerName = hDuel
  ? hDuel.winnerId === hDuel.leftId
    ? hDuel.leftName
    : hDuel.rightName
  : '';
const duelLoserName = hDuel
  ? hDuel.winnerId === hDuel.leftId
    ? hDuel.rightName
    : hDuel.leftName
  : '';
const duelWinShare = hDuel ? Math.max(hDuel.leftShare, hDuel.rightShare) : 0;
const duelLoseShare = hDuel ? Math.min(hDuel.leftShare, hDuel.rightShare) : 0;

const headlineLeads = heroLead?.name === headlineName;
const introParagraphs =
  locale === 'es'
    ? [
        heroLead && heroSecond
          ? headlineLeads
            ? `Según nuestra agregación de ${nPolls} sondeos (ejecución del ${runDate}), en la combinación más sondeada ${headlineName} — candidata de la Agrupación Nacional oficialmente declarada — encabeza la primera vuelta con ${fmtPct1(heroLead.mean, locale)}, por delante de ${heroSecond.name} con ${fmtPct1(heroSecond.mean, locale)}. Ambos pasarían a la segunda vuelta.`
            : `Según nuestra agregación de ${nPolls} sondeos (ejecución del ${runDate}), en la combinación más sondeada que incluye a ${headlineName} (candidata de la Agrupación Nacional oficialmente declarada), ${heroLead.name} encabeza la primera vuelta con ${fmtPct1(heroLead.mean, locale)}, por delante de ${heroSecond.name} con ${fmtPct1(heroSecond.mean, locale)}. Ambos pasarían a la segunda vuelta.`
          : '',
        hDuel
          ? `En segunda vuelta, nuestro modelo proyecta a ${duelWinnerName} en cabeza con ${fmtPct1(duelWinShare, locale)} frente a ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), estimado a partir de sondeos de duelo y transferencias históricas. Son promedios de simulación por combinación, no predicciones: la campaña de 2027 apenas comienza y el campo de ${nDeclared} candidaturas declaradas sigue cambiando.`
          : '',
      ]
    : locale === 'fr'
    ? [
        heroLead && heroSecond
          ? headlineLeads
            ? `D'après notre agrégation de ${nPolls} sondages (run du ${runDate}), dans le casting le plus testé, ${headlineName} — candidate du Rassemblement national officiellement déclarée — mène le premier tour à ${fmtPct1(heroLead.mean, locale)}, devant ${heroSecond.name} à ${fmtPct1(heroSecond.mean, locale)}. Les deux se qualifieraient pour le second tour.`
            : `D'après notre agrégation de ${nPolls} sondages (run du ${runDate}), dans le casting le plus testé incluant ${headlineName} (candidate du Rassemblement national officiellement déclarée), ${heroLead.name} mène le premier tour à ${fmtPct1(heroLead.mean, locale)}, devant ${heroSecond.name} à ${fmtPct1(heroSecond.mean, locale)}. Les deux se qualifieraient pour le second tour.`
          : '',
        hDuel
          ? `Au second tour, notre modèle projette ${duelWinnerName} en tête à ${fmtPct1(duelWinShare, locale)} face à ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), estimé à partir des sondages de duel et des reports historiques. Ce sont des moyennes de simulation par casting, pas des prédictions : la campagne 2027 ne fait que commencer et le champ des ${nDeclared} candidatures déclarées continue d'évoluer.`
          : '',
      ]
    : [
        heroLead && heroSecond
          ? headlineLeads
            ? `Based on our aggregation of ${nPolls} polls (run of ${runDate}), in the most-polled lineup ${headlineName} — the officially declared National Rally candidate — leads the first round at ${fmtPct1(heroLead.mean, locale)}, ahead of ${heroSecond.name} at ${fmtPct1(heroSecond.mean, locale)}. Both would advance to the runoff.`
            : `Based on our aggregation of ${nPolls} polls (run of ${runDate}), in the most-polled lineup featuring ${headlineName} (the officially declared National Rally candidate), ${heroLead.name} leads the first round at ${fmtPct1(heroLead.mean, locale)}, ahead of ${heroSecond.name} at ${fmtPct1(heroSecond.mean, locale)}. Both would advance to the runoff.`
          : '',
        hDuel
          ? `In the runoff, our model projects ${duelWinnerName} ahead at ${fmtPct1(duelWinShare, locale)} against ${duelLoserName} (${fmtPct1(duelLoseShare, locale)}), estimated from head-to-head polls and historical transfers. These are per-lineup simulation averages, not predictions: the 2027 campaign is just starting and the field of ${nDeclared} declared candidates keeps shifting.`
          : '',
      ];

const firstRoundDate = new Date(`${meta.election_date_first_round}T00:00:00`);
const dateLocale = locale === 'fr' ? 'fr-FR' : locale === 'es' ? 'es-ES' : 'en-CA';
const dateLong = firstRoundDate.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const COPY = {
  fr: {
        kicker: 'Présidentielle 2027 · Modèle par scénarios',
        titleA: 'La France vote en ',
        titleEm: 'avril 2027',
        dekA: 'Notre modèle ne projette pas des sièges mais des ',
        dekStrong: 'castings',
        dekB: " : pour chaque configuration de candidatures, l'intention de vote au premier tour et l'issue probable du duel de second tour. Scénario de référence : ",
        pollsAgg: `${nPolls} sondages agrégés`,
        scenarios: `${meta.n_scenarios} scénarios`,
        runOf: `Run du ${runDate}`,
        firstLead: 'Premier tour — tête',
        secondProj: 'Second tour projeté',
        wins: "l'emporte",
        ctaExplore: 'Explorer les castings',
        ctaMethod: 'Méthodologie',
        methodHref: '/fr/methodologie/',
        countdownTitle: `Premier tour le ${dateLong}.`,
        explorerTitle: 'Explorer les castings',
        explorerHelp:
          'Chaque casting est une hypothèse de candidatures réellement testée par les sondeurs. Basculez pour comparer premier tour et second tour projetés.',
        registryTitle: 'Candidats suivis',
        registryHelp: `Statut au ${runDate}. Cliquez un candidat pour sa fiche — bio, sondages et duels. La projection s'ajuste lorsqu'un candidat se déclare.`,
        allCandidates: 'Tous les candidats',
        kdEyebrow: 'Continuer à creuser',
        kdTitle: 'La projection continue ailleurs.',
        kdBody: "Comparez les autres instruments Vote-Scope en attendant l'ouverture de la campagne 2027.",
        kdLinks: [
          { href: '/fr/uk/', label: 'Élection générale R.-U.', detail: 'Projection Westminster' },
          { href: '/fr/canada/federal/', label: 'Canada fédéral', detail: '343 sièges' },
          { href: '/fr/us/indexes/lame-duck/', label: 'Index canard boiteux', detail: 'Pression pré-électorale US' },
          { href: '/fr/', label: 'Tous les bureaux', detail: 'Tous les instruments' },
        ],
        summaryLabel: 'Résumé de la projection',
      },
  en: {
        kicker: '2027 Presidential · Scenario model',
        titleA: 'France votes in ',
        titleEm: 'April 2027',
        dekA: 'Our model does not project seats but ',
        dekStrong: 'lineups',
        dekB: ': for each configuration of candidates, first-round voting intention and the likely outcome of the runoff. Reference scenario: ',
        pollsAgg: `${nPolls} polls aggregated`,
        scenarios: `${meta.n_scenarios} scenarios`,
        runOf: `Run of ${runDate}`,
        firstLead: 'First round — leaders',
        secondProj: 'Projected runoff',
        wins: 'wins',
        ctaExplore: 'Explore the lineups',
        ctaMethod: 'Methodology',
        methodHref: '/en/methodology/',
        countdownTitle: `First round on ${dateLong}.`,
        explorerTitle: 'Explore the lineups',
        explorerHelp:
          'Each lineup is a candidate configuration actually tested by pollsters. Switch to compare projected first and second rounds.',
        registryTitle: 'Candidates tracked',
        registryHelp: `Status as of ${runDate}. Click a candidate for their profile — bio, polls and matchups. The projection adjusts when a candidate declares.`,
        allCandidates: 'All candidates',
        kdEyebrow: 'Keep digging',
        kdTitle: 'The projection keeps going.',
        kdBody: 'Compare the other Vote-Scope instruments while the 2027 campaign gets going.',
        kdLinks: [
          { href: '/en/uk/', label: 'U.K. general election', detail: 'Westminster projection' },
          { href: '/en/canada/federal/', label: 'Canada federal', detail: '343 seats' },
          { href: '/en/us/indexes/lame-duck/', label: 'Lame-Duck Index', detail: 'U.S. pre-election drag' },
          { href: '/en/', label: 'All desks', detail: 'Every instrument' },
        ],
        summaryLabel: 'Projection summary',
      },
  es: {
        kicker: 'Presidencial 2027 · Modelo por escenarios',
        titleA: 'Francia vota en ',
        titleEm: 'abril de 2027',
        dekA: 'Nuestro modelo no proyecta escaños sino ',
        dekStrong: 'combinaciones',
        dekB: ': para cada configuración de candidaturas, la intención de voto en primera vuelta y el resultado probable de la segunda vuelta. Escenario de referencia: ',
        pollsAgg: `${nPolls} sondeos agregados`,
        scenarios: `${meta.n_scenarios} escenarios`,
        runOf: `Ejecución del ${runDate}`,
        firstLead: 'Primera vuelta — cabeza',
        secondProj: 'Segunda vuelta proyectada',
        wins: 'gana',
        ctaExplore: 'Explorar las combinaciones',
        ctaMethod: 'Metodología',
        methodHref: '/es/metodologia/',
        countdownTitle: `Primera vuelta el ${dateLong}.`,
        explorerTitle: 'Explorar las combinaciones',
        explorerHelp:
          'Cada combinación es una configuración de candidaturas realmente sondeada. Cambie para comparar la primera y la segunda vuelta proyectadas.',
        registryTitle: 'Candidatos seguidos',
        registryHelp: `Estado al ${runDate}. Haga clic en un candidato para su ficha — biografía, sondeos y duelos. La proyección se ajusta cuando un candidato se declara.`,
        allCandidates: 'Todos los candidatos',
        kdEyebrow: 'Seguir explorando',
        kdTitle: 'La proyección continúa.',
        kdBody: 'Compare los demás instrumentos de Vote-Scope mientras arranca la campaña de 2027.',
        kdLinks: [
          { href: '/es/uk/', label: 'Elección general R.U.', detail: 'Proyección Westminster' },
          { href: '/es/canada/federal/', label: 'Canadá federal', detail: '343 escaños' },
          { href: '/es/us/indexes/lame-duck/', label: 'Índice Lame-Duck', detail: 'Presión preelectoral EE. UU.' },
          { href: '/es/', label: 'Todas las mesas', detail: 'Todos los instrumentos' },
        ],
        summaryLabel: 'Resumen de la proyección',
      },
} as const;
const C = COPY[locale];
---

<article class="fr-desk">
  <!-- HERO -->
  <header class="fr-hero container" aria-label={C.summaryLabel}>
    <p class="fr-kicker">{C.kicker}</p>
    <h1 class="fr-title">{C.titleA}<em>{C.titleEm}</em>.</h1>
    <p class="fr-dek">
      {C.dekA}<strong>{C.dekStrong}</strong>{C.dekB}<strong>{heroCard.label}</strong>.
    </p>
    <div class="fr-meta">
      <span>{C.runOf}</span>
      <span aria-hidden="true">·</span>
      <span>{C.pollsAgg}</span>
      <span aria-hidden="true">·</span>
      <span>{C.scenarios}</span>
    </div>

    {heroLead && heroSecond && (
      <div class="fr-hero-headline">
        <div class="fr-hero-first">
          <span class="fr-hl-label">{C.firstLead}</span>
          <div class="fr-hl-pair">
            <span class="fr-hl-cand">
              <span class="fr-swatch" style={`background:${blocVar(heroLead.bloc)}`} />
              {heroLead.name} <b>{fmtPct1(heroLead.mean, locale)}</b>
            </span>
            <span class="fr-hl-cand">
              <span class="fr-swatch" style={`background:${blocVar(heroSecond.bloc)}`} />
              {heroSecond.name} <b>{fmtPct1(heroSecond.mean, locale)}</b>
            </span>
          </div>
        </div>
        {heroCard.duel && (
          <div class="fr-hero-duel">
            <span class="fr-hl-label">{C.secondProj}</span>
            <p class="fr-hl-duel">
              <b>
                {heroCard.duel.winnerId === heroCard.duel.leftId
                  ? heroCard.duel.leftName
                  : heroCard.duel.rightName}
              </b>{' '}
              {C.wins} —{' '}
              {fmtPct1(Math.max(heroCard.duel.leftShare, heroCard.duel.rightShare), locale)}{' '}
              vs {fmtPct1(Math.min(heroCard.duel.leftShare, heroCard.duel.rightShare), locale)}
            </p>
          </div>
        )}
      </div>
    )}

    <div class="fr-cta-row">
      <a class="fr-cta fr-cta-strong" href="#fr-explorer-title">{C.ctaExplore} ↓</a>
      <a class="fr-cta" href={C.methodHref}>{C.ctaMethod} →</a>
    </div>
  </header>

  <!-- INTRO SEO (auto-générée depuis le run) -->
  <section class="fr-section container fr-intro" aria-label={C.summaryLabel}>
    {introParagraphs.filter(Boolean).map((p) => <p>{p}</p>)}
  </section>

  <!-- COMPTE À REBOURS -->
  <section class="fr-section container">
    <ElectionCountdown
      targetDate={meta.election_date_first_round}
      locale={locale}
      title={C.countdownTitle}
      client:load
    />
  </section>

  <!-- BARRAGE INDEX (instrument live) -->
  <section class="fr-section container" aria-label={barrageCopy.title}>
    <a class="note-card" href={barrageHref} style={`display:block;text-decoration:none;color:inherit;border-left:4px solid ${bfi.zone_color ?? 'var(--ink-3)'};`}>
      <p class="eyebrow">{barrageCopy.eyebrow}</p>
      <h3 style="margin:0.25rem 0;">{barrageCopy.title} — <span style={`color:${bfi.zone_color ?? 'inherit'}`}>{typeof bfi.score === 'number' ? (locale === 'en' ? bfi.score.toFixed(1) : bfi.score.toFixed(1).replace('.', ',')) : '—'}/100 · {barrageCopy.zone ?? ''}</span></h3>
      <p>{barrageCopy.question}</p>
      <footer style="margin-top:0.75rem;"><span class="cta-link">{barrageCopy.cta} →</span></footer>
    </a>
  </section>

  <!-- LÉGISLATIVES (desk complet, nowcast indirect) -->
  <section class="fr-section container" aria-label={legCopy.eyebrow}>
    <a class="note-card" href={legHref} style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--bloc-far_right, #2b4f8c);">
      <p class="eyebrow">{legCopy.eyebrow}</p>
      <h3 style="margin:0.25rem 0;">{legCopy.title}</h3>
      <p>{legCopy.body}</p>
      <footer style="margin-top:0.75rem;"><span class="cta-link">{legCopy.cta} →</span></footer>
    </a>
  </section>

  <!-- EXPLORATEUR -->
  <section class="fr-section container" aria-labelledby="fr-explorer-title">
    <h2 id="fr-explorer-title" class="fr-section-title">{C.explorerTitle}</h2>
    <p class="fr-section-help">{C.explorerHelp}</p>
    <div class="fr-explorer-card">
      <FranceScenarioExplorer scenarios={explorerScenarios} locale={locale} client:visible />
    </div>
  </section>

  <!-- REGISTRE -->
  <section class="fr-section container" aria-labelledby="fr-registry-title">
    <h2 id="fr-registry-title" class="fr-section-title">{C.registryTitle}</h2>
    <p class="fr-section-help">{C.registryHelp}</p>
    <ul class="fr-registry">
      {registry.map((c) => (
        <li>
          <a class="fr-reg-item" href={`${candBase}/${slugify(c.candidate_name)}/`}>
            <span class="fr-swatch" style={`background:${blocVar(c.bloc)}`} />
            <span class="fr-reg-name">{c.candidate_name}</span>
            <span class="fr-reg-bloc">{blocLabel(c.bloc, locale)}</span>
            <span class={`fr-reg-status is-${c.status}`}>{statusLabel(c.status, locale)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="fr-cta-row" style="margin-top:18px;">
      <a class="fr-cta" href={candBase}>{C.allCandidates} →</a>
    </div>
  </section>

  <section class="fr-section container">
    <KeepDigging
      eyebrow={C.kdEyebrow}
      title={C.kdTitle}
      body={C.kdBody}
      links={C.kdLinks}
    />
  </section>
</article>

<style>
  /* Palette de blocs — convention politique française, validée dataviz
     (six-checks, clair + sombre). Identité portée aussi par les étiquettes.
     Thème piloté par [data-theme] (Base.astro), jamais @media seul. */
  .fr-desk {
