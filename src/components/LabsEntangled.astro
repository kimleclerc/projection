---
// L'élection intriquée : les circonscriptions qui bougent ensemble survivent-
// elles au bruit d'une vraie puce? Même expérience à 10, 30, 60 et 90
// circonscriptions, sur deux puces IBM et sur un simulateur parfait.
import { type Locale, type LabsKey, fmt } from '../lib/labs';
import { loadQuantumFile } from '../lib/labs-quantum';
import { MODEL_RELEASES } from '../data/modelVersion';

interface Props { locale: Locale; labsKey: LabsKey }
const { locale, labsKey } = Astro.props;
const SUFFIX = '10-30-60-90';
const refName = MODEL_RELEASES[0].name;
const ideal = loadQuantumFile(`entangled_${labsKey}_ideal_${SUFFIX}`);
const chips = ['ibm_marrakesh', 'ibm_fez']
  .map((m) => loadQuantumFile(`entangled_${labsKey}_${m}_${SUFFIX}`))
  .filter(Boolean) as any[];

// Part du mouvement d'ensemble retrouvée : 1 − (erreur intriquée / erreur sans intrication),
// sur les corrélations entre paires de circonscriptions, contre la loi exacte.
const regained = (run: any) => {
  const e = run.entangled.vs_exact.corr_mae, p = run.product.vs_exact.corr_mae;
  return p > 0 ? Math.max(0, 1 - e / p) : null;
};
const rows = (ideal?.runs ?? chips[0]?.runs ?? []).map((_: any, i: number) => {
  const base = chips[0]?.runs[i] ?? ideal.runs[i];
  return {
    n: base.n_ridings, qubits: base.qubits[1], gates: chips[0]?.runs[i]?.two_qubit_gates?.[1] ?? null,
    ideal: ideal ? regained(ideal.runs[i]) : null,
    chips: chips.map((c) => regained(c.runs[i])),
    sdExact: base.entangled.vs_exact.sd_wins_ref,
    sdProduct: chips[0] ? chips[0].runs[i].product.vs_exact.sd_wins : null,
    sdEnt: chips[0] ? chips[0].runs[i].entangled.vs_exact.sd_wins : null,
  };
});
const P = (v: number | null) => v === null ? '—' : `${fmt(100 * v, locale, 0)}${locale === 'en' ? '%' : ' %'}`;
const seconds = chips.reduce((a, c) => a + (c.ibm_job?.qpu_seconds ?? 0), 0);

const TX = {
  fr: {
    kicker: 'Deuxième expérience',
    title: 'L’élection intriquée : le mouvement d’ensemble survit-il au bruit?',
    dek: 'Une élection ne se joue pas circonscription par circonscription : une erreur de sondage ou une vague régionale déplace des dizaines de circonscriptions dans le même sens. On a demandé à deux puces IBM de reproduire ce mouvement d’ensemble sur les circonscriptions les plus incertaines selon nos deux modèles — 10, puis 30, 60 et 90. Deux circuits à chaque fois : l’un sans intrication, où chaque circonscription est tirée seule ; l’autre où deux qubits « climat », intriqués avec toutes les circonscriptions, portent l’humeur de la campagne. La bonne réponse est connue d’avance : on la calcule exactement sur un ordinateur ordinaire.',
    colN: 'Circonscriptions', colQ: 'Qubits', colG: 'Opérations à 2 qubits', colIdeal: 'Machine parfaite',
    colChip: (m: string) => m.replace('ibm_', '').replace(/^./, (c) => c.toUpperCase()),
    head: 'Part du mouvement d’ensemble retrouvée',
    note: 'Lecture : 100 % = les corrélations entre circonscriptions sont reproduites parfaitement ; 0 % = pas mieux que le circuit sans intrication, qui n’en reproduit aucune. « Machine parfaite » : le même circuit sur un simulateur sans bruit.',
    sdTitle: 'Le nombre de favoris qui gagnent, d’un tirage à l’autre (écart-type)',
    sdNote: (n: number, ex: string, pr: string, en: string) => `${n} circonscriptions : ${ex} selon la loi exacte, ${pr} sans intrication, ${en} avec. Plus il est grand, plus les circonscriptions basculent en bloc.`,
    tTitle: 'Ce que ça veut dire pour le vote',
    tDek: (lo: number, hi: number) => `Quand les circonscriptions bougent ensemble, l’élection a tendance à partir d’un bord ou de l’autre : très favorable au PQ, ou nettement moins, plutôt qu’au milieu. Voici les sièges du PQ selon nos deux moteurs, tels qu’ils sont (circonscriptions liées), puis avec les mêmes chances par circonscription mais sans aucun lien entre elles. La zone du milieu va de ${lo} à ${hi} sièges.`,
    tEngine: 'Moteur', tTogether: 'liées (réalité)', tIndep: 'indépendantes',
    tRange: '8 chances sur 10', tLow: 'PQ ≤ 55', tHigh: 'PQ ≥ 70', tMid: 'Au milieu', tMaj: 'Majorité',
    tRead: 'Les deux moteurs s’entendent : à cause du mouvement d’ensemble, un résultat tranché, dans un sens ou dans l’autre, est bien plus probable que si les circonscriptions votaient chacune de leur côté — deux à trois fois plus pour un PQ sous les 56 sièges, des dizaines de fois plus pour un PQ à 70 ou plus. Orbite voit des mouvements communs bien plus forts que notre projection de référence : pour lui, le scénario du milieu est minoritaire. Les quelques circonscriptions serrées où les deux moteurs divergent sont celles qui décideront de quel côté ça penche.',
    whatTitle: 'Ce qu’on retient',
    what: [
      'À petite échelle, l’intrication fait son travail sur une vraie puce : avec 10 circonscriptions, elle retrouve l’essentiel du mouvement d’ensemble, que le circuit sans intrication ne peut pas produire du tout.',
      'Le bruit l’efface à mesure que les opérations s’accumulent : au-delà d’environ mille opérations entre qubits, le signal commun s’éteint presque, et les chances de chaque circonscription se dégradent aussi.',
      'Les deux puces s’accordent : on mesure une propriété de cette génération de machines, pas un défaut d’une puce en particulier.',
      'Ça ne prédit rien de plus : cette loi se calcule exactement sur un ordinateur ordinaire. C’est un banc d’essai, gelé avant le vote, pour mesurer où en sont les machines quantiques.',
    ],
    cost: (s: string) => `Temps de machine pour les deux puces : ${s} s.`,
  },
  en: {
    kicker: 'Second experiment',
    title: 'The entangled election: does the joint movement survive the noise?',
    dek: 'An election is not decided riding by riding: a polling error or a regional wave moves dozens of ridings in the same direction. We asked two IBM chips to reproduce that joint movement on the ridings our two models find most uncertain — 10, then 30, 60 and 90. Two circuits each time: one without entanglement, where each riding is drawn on its own; the other where two “climate” qubits, entangled with every riding, carry the mood of the campaign. The right answer is known in advance: we compute it exactly on an ordinary computer.',
    colN: 'Ridings', colQ: 'Qubits', colG: 'Two-qubit operations', colIdeal: 'Perfect machine',
    colChip: (m: string) => m.replace('ibm_', '').replace(/^./, (c) => c.toUpperCase()),
    head: 'Share of the joint movement recovered',
    note: 'How to read it: 100% = correlations between ridings reproduced perfectly; 0% = no better than the circuit without entanglement, which reproduces none. “Perfect machine”: the same circuit on a noiseless simulator.',
    sdTitle: 'How many favourites win, from one draw to the next (standard deviation)',
    sdNote: (n: number, ex: string, pr: string, en: string) => `${n} ridings: ${ex} under the exact distribution, ${pr} without entanglement, ${en} with it. The larger it is, the more ridings flip as a block.`,
    tTitle: 'What it means for the vote',
    tDek: (lo: number, hi: number) => `When ridings move together, the election tends to break one way or the other — very good for the PQ, or clearly less so — rather than landing in the middle. Here are the PQ’s seats according to our two engines, as they are (linked ridings), then with the same chance in each riding but no link between them. The middle zone runs from ${lo} to ${hi} seats.`,
    tEngine: 'Engine', tTogether: 'linked (reality)', tIndep: 'independent',
    tRange: '8 in 10 range', tLow: 'PQ ≤ 55', tHigh: 'PQ ≥ 70', tMid: 'In the middle', tMaj: 'Majority',
    tRead: 'Both engines agree: because ridings move together, a lopsided result in one direction or the other is far more likely than if each riding voted on its own — two to three times more for a PQ below 56 seats, dozens of times more for a PQ at 70 or more. Orbit sees much stronger common movements than our reference forecast: for Orbit, the middle scenario is the minority one. The few close ridings where the two engines disagree are the ones that will decide which way it tips.',
    whatTitle: 'What we take away',
    what: [
      'At small scale, entanglement does its job on a real chip: with 10 ridings it recovers most of the joint movement, which the circuit without entanglement cannot produce at all.',
      'Noise erases it as operations pile up: beyond about a thousand operations between qubits, the shared signal nearly vanishes, and each riding’s chances degrade too.',
      'Both chips agree: we are measuring a property of this generation of machines, not a flaw in one particular chip.',
      'It predicts nothing more: this distribution can be computed exactly on an ordinary computer. It is a benchmark, frozen before the vote, to measure where quantum machines stand.',
    ],
    cost: (s: string) => `Machine time for both chips: ${s} s.`,
  },
  es: {
    kicker: 'Segundo experimento',
    title: 'La elección entrelazada: ¿sobrevive el movimiento conjunto al ruido?',
    dek: 'Una elección no se decide circunscripción por circunscripción: un error de las encuestas o una ola regional mueve decenas de circunscripciones en el mismo sentido. Pedimos a dos chips de IBM que reprodujeran ese movimiento conjunto en las circunscripciones más inciertas según nuestros dos modelos: 10, luego 30, 60 y 90. Dos circuitos cada vez: uno sin entrelazamiento, donde cada circunscripción se sortea sola; el otro, donde dos cúbits «clima», entrelazados con todas las circunscripciones, llevan el ánimo de la campaña. La respuesta correcta se conoce de antemano: la calculamos exactamente en un ordenador común.',
    colN: 'Circunscripciones', colQ: 'Cúbits', colG: 'Operaciones de 2 cúbits', colIdeal: 'Máquina perfecta',
    colChip: (m: string) => m.replace('ibm_', '').replace(/^./, (c) => c.toUpperCase()),
    head: 'Parte del movimiento conjunto recuperada',
    note: 'Cómo leerlo: 100 % = las correlaciones entre circunscripciones se reproducen perfectamente; 0 % = no mejor que el circuito sin entrelazamiento, que no reproduce ninguna. «Máquina perfecta»: el mismo circuito en un simulador sin ruido.',
    sdTitle: 'Cuántos favoritos ganan, de un sorteo a otro (desviación típica)',
    sdNote: (n: number, ex: string, pr: string, en: string) => `${n} circunscripciones: ${ex} según la distribución exacta, ${pr} sin entrelazamiento, ${en} con él. Cuanto mayor, más circunscripciones cambian en bloque.`,
    tTitle: 'Lo que significa para la votación',
    tDek: (lo: number, hi: number) => `Cuando las circunscripciones se mueven juntas, la elección tiende a inclinarse hacia un lado u otro —muy favorable al PQ o claramente menos— en lugar de quedarse en el medio. Estos son los escaños del PQ según nuestros dos motores, tal como son (circunscripciones vinculadas), y luego con la misma probabilidad en cada circunscripción pero sin vínculo entre ellas. La zona media va de ${lo} a ${hi} escaños.`,
    tEngine: 'Motor', tTogether: 'vinculadas (realidad)', tIndep: 'independientes',
    tRange: '8 de cada 10', tLow: 'PQ ≤ 55', tHigh: 'PQ ≥ 70', tMid: 'En el medio', tMaj: 'Mayoría',
    tRead: 'Los dos motores coinciden: como las circunscripciones se mueven juntas, un resultado contundente en un sentido u otro es mucho más probable que si cada una votara por su cuenta: de dos a tres veces más para un PQ por debajo de 56 escaños, decenas de veces más para un PQ con 70 o más. Órbita ve movimientos comunes mucho más fuertes que nuestra proyección de referencia: para Órbita, el escenario del medio es el minoritario. Las pocas circunscripciones reñidas donde los dos motores discrepan son las que decidirán hacia qué lado se inclina.',
    whatTitle: 'Lo que retenemos',
    what: [
      'A pequeña escala, el entrelazamiento cumple su función en un chip real: con 10 circunscripciones recupera lo esencial del movimiento conjunto, que el circuito sin entrelazamiento no puede producir.',
      'El ruido lo borra a medida que se acumulan las operaciones: más allá de unas mil operaciones entre cúbits, la señal común casi desaparece, y las probabilidades de cada circunscripción también se degradan.',
      'Los dos chips coinciden: medimos una propiedad de esta generación de máquinas, no un defecto de un chip en particular.',
      'No predice nada más: esta distribución se calcula exactamente en un ordenador común. Es un banco de pruebas, congelado antes de la votación, para medir dónde están las máquinas cuánticas.',
    ],
    cost: (s: string) => `Tiempo de máquina para los dos chips: ${s} s.`,
  },
}[locale];
const big = rows[rows.length - 1];
// Ce que ça veut dire pour le vote : sièges du PQ, circonscriptions qui bougent
// ensemble (la réalité des deux moteurs) contre indépendantes (même chance par
// circonscription, sans lien entre elles).
const corr = loadQuantumFile(`correlation_${labsKey}`);
const engines = corr ? [
  { key: 'reference', name: refName },
  { key: 'orbit', name: locale === 'es' ? 'Órbita' : locale === 'en' ? 'Orbit' : 'Orbite' },
] : [];
---

{chips.length > 0 && rows.length > 0 && (
  <section class="le" aria-labelledby="le-title">
    <p class="le-kicker"><span aria-hidden="true">⚛</span> {TX.kicker}</p>
    <h2 id="le-title">{TX.title}</h2>
    <p class="le-dek">{TX.dek}</p>
    <h3>{TX.head}</h3>
    <div class="le-scroll">
      <table class="le-table">
        <thead><tr>
          <th>{TX.colN}</th><th>{TX.colQ}</th><th>{TX.colG}</th>
          {ideal && <th>{TX.colIdeal}</th>}
          {chips.map((c) => <th>{TX.colChip(c.machine)}</th>)}
        </tr></thead>
        <tbody>
          {rows.map((r: any) => (
            <tr>
              <td>{r.n}</td><td class="le-dim">{r.qubits}</td><td class="le-dim">{r.gates === null ? '—' : fmt(r.gates, locale, 0)}</td>
              {ideal && <td class="le-dim">{P(r.ideal)}</td>}
              {r.chips.map((v: number | null) => <td><strong>{P(v)}</strong></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="le-note">{TX.note}</p>
    {big?.sdProduct != null && (
      <>
        <h3>{TX.sdTitle}</h3>
        <p class="le-small">{TX.sdNote(big.n, fmt(big.sdExact, locale, 1), fmt(big.sdProduct, locale, 1), fmt(big.sdEnt, locale, 1))}</p>
      </>
    )}
    {corr && (
      <>
        <h3>{TX.tTitle}</h3>
        <p class="le-small">{TX.tDek(corr.middle[0], corr.middle[1])}</p>
        <div class="le-scroll">
          <table class="le-table">
            <thead><tr><th>{TX.tEngine}</th><th></th><th>{TX.tRange}</th><th>{TX.tLow}</th><th>{TX.tMid}</th><th>{TX.tHigh}</th><th>{TX.tMaj}</th></tr></thead>
            <tbody>
              {engines.flatMap((e) => (['together', 'independent'] as const).map((k) => {
                const v = corr[e.key][k];
                return (
                  <tr class={k === 'independent' ? 'le-ghost' : ''}>
                    <td>{k === 'together' ? <strong>{e.name}</strong> : ''}</td>
                    <td class="le-dim">{k === 'together' ? TX.tTogether : TX.tIndep}</td>
                    <td>{v.p10}–{v.p90}</td>
                    <td>{P(v.p_le55)}</td><td>{P(v.p_58_67)}</td><td>{P(v.p_ge70)}</td><td>{P(v.p_majority)}</td>
                  </tr>
                );
              }))}
            </tbody>
          </table>
        </div>
        <p class="le-small le-read">{TX.tRead}</p>
      </>
    )}

    <h3>{TX.whatTitle}</h3>
    <ul class="le-what">{TX.what.map((w) => <li>{w}</li>)}</ul>
    {seconds > 0 && <p class="le-note">{TX.cost(fmt(seconds, locale, 0))}</p>}
  </section>
)}

<style>
  .le { margin-top: 40px; padding: 28px 28px 24px; border-radius: 10px; border: 1px solid var(--rule); background: var(--card); }
  .le-kicker { margin: 0 0 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .le h2 { font-family: var(--serif); font-size: clamp(24px, 3.2vw, 32px); font-weight: 450; margin: 0 0 12px; }
  .le h3 { font-family: var(--serif); font-size: 20px; font-weight: 450; margin: 26px 0 10px; }
  .le-dek { max-width: 780px; margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .le-scroll { overflow-x: auto; }
  .le-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .le-table th { text-align: left; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); border-bottom: 1px solid var(--rule); padding: 8px 10px; white-space: nowrap; }
  .le-table td { border-bottom: 1px solid var(--rule-2); padding: 9px 10px; white-space: nowrap; }
  .le-dim { color: var(--ink-3); }
  .le-note { margin: 10px 0 0; font-size: 13px; color: var(--ink-3); line-height: 1.5; max-width: 780px; }
  .le-small { margin: 0; font-size: 15px; color: var(--ink-2); line-height: 1.55; max-width: 780px; }
  .le-ghost td { color: var(--ink-3); }
  .le-read { margin-top: 12px; }
  .le-what { margin: 0; padding-left: 20px; color: var(--ink-2); line-height: 1.6; max-width: 780px; }
  .le-what li + li { margin-top: 8px; }
  @media (max-width: 560px) { .le { padding: 22px 16px 18px; } }
</style>
