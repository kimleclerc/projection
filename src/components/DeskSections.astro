---
/**
 * DeskSections — the uniform "what's in this desk" band.
 *
 * Two variants, one registry (lib/desk-sections.ts):
 *   · desk="us" → the sections of a single desk, dropped under the editorial
 *     content of /us/, /canada/, /uk/, /france/, /indexes/ and /sports/.
 *   · directory → every desk at once, for the home page.
 *
 * Pure HTML, no island: this is wayfinding, it must render before hydration
 * and work with JS off. Styling follows the editorial system (rules, not
 * shadows; serif headings; mono eyebrows) so it reads as part of the paper
 * rather than as a widget bolted on.
 */
import { DESKS, getDesk, deskItems, itemLinks, type NavLang } from '../lib/desk-sections';

interface Props {
  lang: NavLang;
  /** Omit for the full directory (home page). */
  desk?: 'us' | 'canada' | 'uk' | 'france' | 'spain' | 'indexes' | 'sports';
  /** Override the band heading. */
  title?: string;
  /** Override the eyebrow. */
  eyebrow?: string;
  /** Hide the desk-level "open the desk" link (already there on a hub). */
  showHubLink?: boolean;
}

const { lang, desk: deskId, title, eyebrow, showHubLink = false } = Astro.props as Props;

const T = {
  en: {
    eyebrowDesk: 'In this desk',
    eyebrowAll: 'Every forecast',
    titleDesk: 'In this section',
    titleAll: 'Forecasts by country',
    hub: 'Open the desk',
  },
  fr: {
    eyebrowDesk: 'Dans cette rubrique',
    eyebrowAll: 'Toutes les prévisions',
    titleDesk: 'Dans cette rubrique',
    titleAll: 'Les prévisions, pays par pays',
    hub: 'Ouvrir la rubrique',
  },
  es: {
    eyebrowDesk: 'En esta mesa',
    eyebrowAll: 'Todos los pronósticos',
    titleDesk: 'En esta sección',
    titleAll: 'Los pronósticos, país por país',
    hub: 'Abrir la mesa',
  },
}[lang];

const single = deskId ? getDesk(deskId) : undefined;
const groups = single ? [single] : DESKS;
const isDirectory = !single;

const bandEyebrow = eyebrow ?? (isDirectory ? T.eyebrowAll : T.eyebrowDesk);
const bandTitle = title ?? (isDirectory ? T.titleAll : T.titleDesk);
---

<section class="content-band desk-sections">
  <div class="container">
    <p class="eyebrow">{bandEyebrow}</p>
    <h2>{bandTitle}</h2>

    {groups.map((group) => (
      <div class="ds-group">
        {isDirectory && (
          <div class="ds-group-head">
            <h3>{group.label[lang]}</h3>
            <a href={group.hub[lang]}>{T.hub}</a>
          </div>
        )}

        <ul class="ds-grid">
          {deskItems(group, lang).map((item) => (
            <li class="ds-card">
              <a class="ds-card-title" href={item.href[lang]}>{item.label[lang]}</a>
              <p class="ds-blurb">{item.blurb[lang]}</p>
              {itemLinks(item, lang).length > 0 && (
                <p class="ds-links">
                  {itemLinks(item, lang).map((link, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true"> · </span>}
                      <a href={link.href[lang]}>{link.label[lang]}</a>
                    </>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}

    {showHubLink && single && (
      <p class="ds-hub-link">
        <a href={single.hub[lang]}>{T.hub}</a>
      </p>
    )}
  </div>
</section>

<style>
  .desk-sections h2 {
    margin-bottom: 6px;
  }

  .ds-group + .ds-group {
    margin-top: 44px;
  }

  .ds-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }

  .ds-group-head h3 {
    font-family: var(--serif);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .ds-group-head a {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-3);
    text-decoration: none;
    white-space: nowrap;
  }

  .ds-group-head a:hover {
    color: var(--ink);
  }

  .ds-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: 32px;
  }

  /* The directory repeats the grid per desk; the head already carries a rule. */
  .ds-group-head + .ds-grid {
    border-top: none;
  }

  /* Index de journal : des lignes séparées par un filet, pas des boîtes. */
  .ds-card {
    padding: 14px 0 16px;
    border-bottom: 1px solid var(--rule);
  }

  .ds-card-title {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .ds-card-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ds-blurb {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .ds-links {
    margin-top: 8px;
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-4);
  }

  .ds-links a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .ds-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ds-hub-link {
    margin-top: 24px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  @media (max-width: 640px) {
    .ds-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
