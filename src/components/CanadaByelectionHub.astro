---
/**
 * Partielles fédérales, communes aux trois langues (docs/DESIGN.md § 7) :
 * 1. PageHeader : combien de sièges votent, quand, et la réponse en une phrase.
 * 2. La prochaine journée de scrutin en tableau, avec l'image à télécharger.
 * 3. Les sièges vacants ou annoncés, sans date. 4. Les partielles passées.
 * Tout ce qui dépend du calendrier se calcule à partir des données : une phrase
 * figée sur l'actualité se périme sans que personne la voie vieillir.
 */
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import StoryList from './StoryList.astro';
import KeepDigging from './KeepDigging.astro';
import RidingShareButton from '../islands/RidingShareButton.tsx';
import { canadaByelections } from '../data/canadaByelections';
import { writSource, type ByelectionRaceLocale } from '../data/canadaByelectionRaces';
import { byelectionSlate, nextByelectionDay, byelectionRunDate, chance } from '../lib/canada-byelection-slate';
import { longDate } from '../lib/format';

interface Props {
  lang: ByelectionRaceLocale;
}
const { lang } = Astro.props;
const L = <T,>(fr: T, en: T, es: T): T => (lang === 'fr' ? fr : lang === 'es' ? es : en);
const loc = L('fr-CA', 'en-CA', 'es-ES');

const slate = byelectionSlate(lang);
const next = nextByelectionDay(lang);
const day = next?.rows ?? [];
const waiting = slate.filter((r) => !(next && r.electionDate === next.date));
const archives = Object.values(canadaByelections).sort((a: any, b: any) => b.electionDate.localeCompare(a.electionDate));

const WORDS: Record<ByelectionRaceLocale, string[]> = {
  fr: ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix'],
  en: ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'],
  es: ['cero', 'un', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez'],
};
const word = (n: number) => WORDS[lang][n] ?? String(n);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const join = (xs: string[]) => {
  const and = L('et', 'and', 'y');
  return xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} ${and} ${xs[xs.length - 1]}`;
};

/** Sujet pluriel d'un parti fédéral : « les libéraux », « the Liberals ». */
const PLURAL: Record<string, [string, string, string]> = {
  lib: ['les libéraux', 'the Liberals', 'los liberales'],
  con: ['les conservateurs', 'the Conservatives', 'los conservadores'],
  bq: ['le Bloc', 'the Bloc', 'el Bloque'],
  ndp: ['le NPD', 'the NDP', 'el NPD'],
  grn: ['les verts', 'the Greens', 'los verdes'],
  ppc: ['le PPC', 'the PPC', 'el PPC'],
};
const plural = (code: string) => {
  const p = PLURAL[code];
  return p ? L(p[0], p[1], p[2]) : code.toUpperCase();
};

// « Trois au Québec, deux en Ontario, une en Saskatchewan. »
const byProvince = [...day.reduce((m, r) => m.set(r.province, (m.get(r.province) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1]);
const IN: Record<string, [string, string, string]> = {
  Québec: ['au Québec', 'in Quebec', 'en Quebec'], Quebec: ['au Québec', 'in Quebec', 'en Quebec'],
  Ontario: ['en Ontario', 'in Ontario', 'en Ontario'], Saskatchewan: ['en Saskatchewan', 'in Saskatchewan', 'en Saskatchewan'],
};
const inProv = (p: string) => (IN[p] ? L(IN[p][0], IN[p][1], IN[p][2]) : p);
const fem = (n: number) => (lang === 'fr' && n === 1 ? 'une' : lang === 'es' && n === 1 ? 'una' : word(n));
const provinceLine = join(byProvince.map(([p, n]) => `${fem(n)} ${inProv(p)}`));

// « Les libéraux sont favoris dans quatre des six, le Bloc dans Saint-Hyacinthe… »
const byParty = [...day.reduce((m, r) => m.set(r.party, [...(m.get(r.party) ?? []), r]), new Map<string, typeof day>())]
  .sort((a, b) => b[1].length - a[1].length);
const partyBits = byParty.map(([code, rows], i) => {
  const where = rows.length === 1 ? L(`dans ${rows[0].name}`, `in ${rows[0].name}`, `en ${rows[0].name}`)
    : L(`dans ${word(rows.length)} des ${word(day.length)}`, `in ${word(rows.length)} of the ${word(day.length)}`, `en ${word(rows.length)} de las ${word(day.length)}`);
  if (i > 0) return `${plural(code)} ${where}`;
  const verb = L(PLURAL[code]?.[0].startsWith('les') ? 'sont favoris' : 'est favori', PLURAL[code]?.[1].endsWith('s') ? 'are favoured' : 'is favoured', PLURAL[code]?.[2].startsWith('los') ? 'son favoritos' : 'es favorito');
  return `${cap(plural(code))} ${verb} ${where}`;
});
const flips = day.filter((r) => r.incumbent && r.incumbent !== r.party);

const nDay = day.length;
const t = {
  title: next
    ? L(`Partielles fédérales du ${longDate(next.date, lang)} : ${nDay} circonscriptions — Vote-Scope`,
        `Canada federal by-elections, ${longDate(next.date, lang)}: ${nDay} ridings — Vote-Scope`,
        `Elecciones parciales federales del ${longDate(next.date, lang)}: ${nDay} circunscripciones — Vote-Scope`)
    : L('Partielles fédérales — Vote-Scope', 'Canada federal by-elections — Vote-Scope', 'Elecciones parciales federales de Canadá — Vote-Scope'),
  description: next
    ? L(`Projections pour les ${nDay} partielles fédérales du ${longDate(next.date, lang)} : ${join(day.map((r) => r.name))}. Favori et chances dans chaque circonscription.`,
        `Forecasts for the ${nDay} federal by-elections on ${longDate(next.date, lang)}: ${join(day.map((r) => r.name))}. Favourite and chances in each riding.`,
        `Proyecciones para las ${nDay} elecciones parciales federales del ${longDate(next.date, lang)}: ${join(day.map((r) => r.name))}. Favorito y probabilidades en cada circunscripción.`)
    : L('Les partielles fédérales à venir, avec une projection pour chaque circonscription.', 'Upcoming federal by-elections, with a forecast for each riding.', 'Las próximas elecciones parciales federales, con una proyección para cada circunscripción.'),
  h1: L('Élections partielles fédérales', 'Federal by-elections', 'Elecciones parciales federales'),
  promise: next
    ? L(`${cap(word(nDay))} circonscriptions votent le ${longDate(next.date, lang)} : ${provinceLine}.`,
        `${cap(word(nDay))} ridings vote on ${longDate(next.date, lang)}: ${provinceLine}.`,
        `${cap(word(nDay))} circunscripciones votan el ${longDate(next.date, lang)}: ${provinceLine}.`)
    : L('Aucune partielle fédérale n’est déclenchée pour le moment.', 'No federal by-election has been called at the moment.', 'Por ahora no hay ninguna elección parcial federal convocada.'),
  answer: next ? `${join(partyBits)}.` + (flips.length
    ? L(` ${flips.length === 1 ? 'Un siège changerait' : `${cap(word(flips.length))} sièges changeraient`} de camp : ${join(flips.map((r) => r.name))}.`,
        ` ${flips.length === 1 ? 'One seat would' : `${cap(word(flips.length))} seats would`} change hands: ${join(flips.map((r) => r.name))}.`,
        ` ${flips.length === 1 ? 'Un escaño cambiaría' : `${cap(word(flips.length))} escaños cambiarían`} de manos: ${join(flips.map((r) => r.name))}.`)
    : '') : '',
  dayHeading: next ? L(`Le ${longDate(next.date, lang)}`, `On ${longDate(next.date, lang)}`, `El ${longDate(next.date, lang)}`) : '',
  thRiding: L('Circonscription', 'Riding', 'Circunscripción'),
  thHeld: L('Élu en 2025', 'Won in 2025', 'Ganado en 2025'),
  thFav: L('Favori', 'Favourite', 'Favorito'),
  thP: L('Chances', 'Chance', 'Probabilidad'),
  thShare: L('Part projetée', 'Projected share', 'Cuota proyectada'),
  meta: L(`Projections du ${longDate(byelectionRunDate, lang)}. Scrutin déclenché par le premier ministre le 1er novembre 2026.`,
          `Forecasts of ${longDate(byelectionRunDate, lang)}. By-elections called by the Prime Minister on November 1, 2026.`,
          `Proyecciones del ${longDate(byelectionRunDate, lang)}. Elecciones convocadas por el primer ministro el 1 de noviembre de 2026.`),
  source: L('Communiqué du premier ministre', 'Prime Minister’s news release', 'Comunicado del primer ministro'),
  waiting: L('Sans date de scrutin', 'No polling day yet', 'Sin fecha de votación'),
  vacant: L('Siège vacant', 'Seat vacant', 'Escaño vacante'),
  announced: L('Départ annoncé', 'Departure announced', 'Salida anunciada'),
  archive: L('Les partielles passées', 'Past by-elections', 'Parciales anteriores'),
  more: L('Voir aussi', 'See also', 'Ver también'),
  federal: L('Projection fédérale', 'Canada federal projection', 'Proyección federal de Canadá'),
  track: L('Bilan des prévisions', 'Track record', 'Historial'),
  shareTitle: L('Partielles fédérales', 'Federal by-elections', 'Parciales federales'),
};

const sharePayload = next ? {
  card: 'slate' as const,
  slug: `partielles-${next.date}`,
  jurisdiction: 'canada-byelection',
  title: t.shareTitle,
  heading: t.promise.split(':')[0].replace(/\s+$/, ''),
  rows: day.map((r) => ({ name: r.name, where: r.province, fav: r.partyLabel, color: r.color, p: chance(r.p, lang) })),
  thFav: t.thFav,
  thP: t.thP,
  voteDay: next.date,
  foot: L(`Projection du ${longDate(byelectionRunDate, lang)}`, `Forecast of ${longDate(byelectionRunDate, lang)}`, `Proyección del ${longDate(byelectionRunDate, lang)}`),
} : null;

const waitingItems = waiting.map((r) => ({
  meta: `${r.province} · ${r.status === 'expected' ? t.announced : t.vacant}`,
  title: r.name,
  text: L(`Favori : ${r.partyLabel}, ${chance(r.p, lang)} de chances.`, `Favourite: ${r.partyLabel}, ${chance(r.p, lang)} chance.`, `Favorito: ${r.partyLabel}, ${chance(r.p, lang)} de probabilidades.`),
  href: r.href,
  color: r.color,
}));
const archiveItems = archives.map((c: any) => ({
  meta: (lang === 'en' ? undefined : c[`kicker_${lang}`]) ?? c.kicker,
  title: ((lang === 'en' ? undefined : c[`headline_${lang}`]) ?? c.headline).replace(/\.$/, ''),
  href: c.paths?.[lang] ?? c.paths?.en,
}));

const canonical = `https://vote-scope.com/${lang}/canada/byelections/`;
const fmtShare = (v: number) => {
  const s = v.toLocaleString(loc, { maximumFractionDigits: 0 });
  return lang === 'en' ? `${s}%` : `${s} %`;
};
---

<Base
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={lang}
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: 'https://vote-scope.com/en/canada/byelections/',
    fr: 'https://vote-scope.com/fr/canada/byelections/',
    es: 'https://vote-scope.com/es/canada/byelections/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: t.title.replace(' — Vote-Scope', ''), url: canonical, inLanguage: lang },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${lang}/` },
      { '@type': 'ListItem', position: 2, name: 'Canada', item: `https://vote-scope.com/${lang}/canada/` },
      { '@type': 'ListItem', position: 3, name: t.h1, item: canonical },
    ]},
  ]}
>
  <article class="byhub" data-content-area>
    <PageHeader title={t.h1} promise={t.promise} question={t.answer} preferredSourceLocale={lang} />

    {next && (
      <section class="container byhub-block" id="forecast" aria-labelledby="byhub-day">
        <h2 id="byhub-day">{t.dayHeading}</h2>
        <div class="table-scroll">
          <table class="byhub-table">
            <thead>
              <tr><th>{t.thRiding}</th><th class="byhub-held">{t.thHeld}</th><th>{t.thFav}</th><th class="num">{t.thP}</th><th class="num byhub-share">{t.thShare}</th></tr>
            </thead>
            <tbody>
              {day.map((r) => (
                <tr>
                  <th scope="row"><a class="vs-link" href={r.href}>{r.name}</a><span class="byhub-sub">{r.province}{r.departing ? ` · ${r.departing}` : ''}</span></th>
                  <td class="byhub-held">{r.incumbentLabel}</td>
                  <td><span class="dot" style={`background:${r.color}`} aria-hidden="true"></span>{r.partyLabel}</td>
                  <td class="num byhub-big">{chance(r.p, lang)}</td>
                  <td class="num byhub-share">{fmtShare(r.share)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="vs-meta">{t.meta} <a href={writSource.url} rel="noopener">{t.source}</a></p>
        {sharePayload && <RidingShareButton client:idle lang={lang} payload={sharePayload} />}
      </section>
    )}

    {waitingItems.length > 0 && (
      <section class="container byhub-block">
        <StoryList heading={t.waiting} items={waitingItems} size="sm" />
      </section>
    )}

    <section class="container byhub-block">
      <StoryList heading={t.archive} items={archiveItems} size="sm" columns={2} />
    </section>

    <KeepDigging
      eyebrow={t.more}
      title={t.more}
      body=""
      links={[
        { href: `/${lang}/canada/federal/`, label: t.federal },
        { href: `/${lang}/track-record/`, label: t.track },
      ]}
    />
  </article>
</Base>

<style>
  .byhub { padding-bottom: 64px; }
  .byhub-block { padding-block: 28px; }
  /* Module : filet noir de 2 px au-dessus (DESIGN § 4), dans la marge du conteneur. */
  .byhub-block > h2:first-child { padding-top: 12px; border-top: 2px solid var(--ink); }
  .byhub-block h2 { margin: 12px 0 14px; font-size: clamp(24px, 3vw, 30px); font-weight: 700; }
  .byhub-table { width: 100%; border-collapse: collapse; border-top: 4px solid var(--ink); font-size: 17px; }
  .byhub-table th, .byhub-table td { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .byhub-table thead th { font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .byhub-table tbody th { font-weight: 700; }
  .byhub-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .byhub-big { font-family: var(--numeric); font-size: 24px; font-weight: 700; line-height: 1.1; }
  .byhub-sub { display: block; margin-top: 2px; font-size: 14px; font-weight: 400; color: var(--ink-3); }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; }
  .byhub-block .vs-meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .byhub-held, .byhub-share { display: none; }
    .byhub-table { font-size: 16px; }
  }
</style>
