---
interface KeepDiggingLink {
  href: string;
  label: string;
  detail?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  links: KeepDiggingLink[];
}

const { eyebrow, title, body, links } = Astro.props;
---

<aside class="keep-digging" aria-labelledby="keep-digging-title">
  <div class="keep-digging-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="keep-digging-title">{title}</h2>
    <p>{body}</p>
  </div>
  <nav class="keep-digging-links" aria-label={eyebrow}>
    {links.map((link) => (
      <a href={link.href}>
        <span>{link.label}</span>
        {link.detail && <small>{link.detail}</small>}
      </a>
    ))}
  </nav>
</aside>

<style>
  .keep-digging {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 28px;
    padding: 30px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--duck) 16%, transparent), transparent 36%),
      var(--card);
  }

  .keep-digging-copy h2 {
    margin: 12px 0 14px;
    font-family: var(--serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .keep-digging-copy p:not(.eyebrow) {
    max-width: 56ch;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .keep-digging-links {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--rule);
  }

  .keep-digging-links a {
    display: grid;
    gap: 6px;
    padding: 17px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }

  .keep-digging-links span {
    font-family: var(--serif);
    font-size: 25px;
    line-height: 1.05;
  }

  .keep-digging-links small {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .keep-digging-links a:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 820px) {
    .keep-digging {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
</style>
