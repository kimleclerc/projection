---
/**
 * Homepage band for the CUSMA trade-war desk.
 *
 * Everything visible here is read from web_data/cusma-showdown/latest.json —
 * the war headline, the fact cards and the leverage gap. Nothing is hardcoded,
 * so the nightly run moves this band without a site edit. The one exception is
 * the poll line, which quotes a dated Angus Reid reading and is meant to be
 * edited by a human when a newer wave lands.
 */
import cusmaData from '../../web_data/cusma-showdown/latest.json';

interface Props {
  lang: 'en' | 'fr' | 'es';
}
const { lang } = Astro.props;

const data = cusmaData as any;
const war = data.war_status;
const showdown = data.showdown;

const pick = (obj: any, key: string) => obj?.[`${key}_${lang}`] ?? obj?.[`${key}_en`] ?? '';
const factValue = (fact: any) =>
  (lang === 'en' ? fact.value_en : lang === 'es' ? fact.value_es : undefined) ?? fact.value;

const wanted = ['rate', 'retaliation', 'support'];
const facts = wanted
  .map((id) => war?.facts?.find((f: any) => f.id === id))
  .filter(Boolean);

const gapSign = showdown.gap > 0 ? '+' : '';

const copy = {
  en: {
    eyebrow: 'Live desk · Canada–U.S. trade war',
    lede:
      'Talks collapsed on August 21. The 50% tariffs are in force, Ottawa answers dollar for dollar on September 8, and three Canadians in four say the walkout was right. One page keeps the leverage gap, the prediction markets and both countries’ polling on the same screen.',
    poll: '76% of Canadians say Canada was right to end the talks',
    pollSub: 'Angus Reid Institute · fielded Aug 22–23 · n = 1,468',
    gapLabel: 'Leverage gap',
    cta: 'Open the trade-war desk →',
    updated: 'Updated',
    href: '/en/indexes/cusma-showdown/',
  },
  fr: {
    eyebrow: 'Bureau en direct · Guerre commerciale Canada–É.-U.',
    lede:
      'Les pourparlers ont échoué le 21 août. Les tarifs de 50 % sont en vigueur, Ottawa riposte dollar pour dollar le 8 septembre, et trois Canadiens sur quatre donnent raison au refus. Une seule page tient l’écart de levier, les marchés prédictifs et les sondages des deux pays sur le même écran.',
    poll: '76 % des Canadiens estiment que le Canada a eu raison de quitter la table',
    pollSub: 'Angus Reid Institute · terrain du 22 au 23 août · n = 1 468',
    gapLabel: 'Écart de levier',
    cta: 'Ouvrir le bureau guerre commerciale →',
    updated: 'Mis à jour',
    href: '/fr/indexes/cusma-showdown/',
  },
  es: {
    eyebrow: 'Mesa en vivo · Guerra comercial Canadá–EE. UU.',
    lede:
      'Las negociaciones fracasaron el 21 de agosto. Los aranceles del 50 % están en vigor, Ottawa responde dólar por dólar el 8 de septiembre, y tres de cada cuatro canadienses dan la razón al rechazo. Una sola página reúne la brecha de ventaja, los mercados predictivos y las encuestas de ambos países.',
    poll: '76 % de los canadienses cree que Canadá hizo bien en dejar la mesa',
    pollSub: 'Angus Reid Institute · campo del 22 al 23 de agosto · n = 1468',
    gapLabel: 'Brecha de ventaja',
    cta: 'Abrir la mesa de guerra comercial →',
    updated: 'Actualizado',
    href: '/es/indexes/cusma-showdown/',
  },
}[lang];
---

<section class="tw-band" aria-labelledby="tw-band-title">
  <div class="container tw-band-inner">
    <div class="tw-band-copy">
      <p class="tw-band-eyebrow"><span class="tw-band-dot" aria-hidden="true"></span>{copy.eyebrow}</p>
      <h2 id="tw-band-title">{pick(war, 'headline')}</h2>
      <p class="tw-band-lede">{copy.lede}</p>
      <p class="tw-band-poll">
        <strong>{copy.poll}</strong>
        <span>{copy.pollSub}</span>
      </p>
      <a class="tw-band-cta" href={copy.href}>{copy.cta}</a>
    </div>

    <div class="tw-band-facts">
      <article class="tw-band-gap">
        <span>{copy.gapLabel}</span>
        <strong style={`color:${showdown.zone_color}`}>{gapSign}{showdown.gap}</strong>
        <em>{pick(showdown, 'label')}</em>
      </article>
      {facts.map((fact: any) => (
        <article class={`tw-band-fact is-${fact.tone ?? 'neutral'}`}>
          <span>{pick(fact, 'label')}</span>
          <strong>{factValue(fact)}</strong>
        </article>
      ))}
      <p class="tw-band-stamp">{copy.updated} {data.meta.as_of_date}</p>
    </div>
  </div>
</section>

<style>
  .tw-band {
    border-block: 1px solid var(--rule, #e2ded4);
    background: var(--surface-alt, #f9f7f2);
    padding-block: 2.4rem;
  }
  .tw-band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.85fr);
    gap: 2.2rem;
    align-items: start;
  }
  .tw-band-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-family: var(--mono, monospace);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3, #7a7466);
  }
  .tw-band-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c94040;
    box-shadow: 0 0 0 3px rgba(201, 64, 64, 0.18);
  }
  .tw-band-copy h2 {
    margin: 0 0 0.7rem;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(24px, 3.1vw, 36px);
    font-weight: 430;
    line-height: 1.08;
  }
  .tw-band-lede {
    margin: 0 0 0.9rem;
    max-width: 62ch;
    color: var(--ink-2, #4a4639);
    line-height: 1.62;
  }
  .tw-band-poll {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0 0 1.1rem;
    padding-left: 0.85rem;
    border-left: 3px solid #2f6fb0;
  }
  .tw-band-poll strong { font-size: 0.98rem; line-height: 1.4; }
  .tw-band-poll span {
    font-family: var(--mono, monospace);
    font-size: 11px;
    color: var(--ink-3, #7a7466);
  }
  .tw-band-cta {
    display: inline-block;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 1px;
  }
  .tw-band-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    gap: 0.7rem;
  }
  .tw-band-gap,
  .tw-band-fact {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--rule, #e2ded4);
    border-radius: 7px;
    background: var(--card, #fff);
  }
  .tw-band-gap { grid-column: 1 / -1; }
  .tw-band-gap span,
  .tw-band-fact span {
    font-family: var(--mono, monospace);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3, #7a7466);
  }
  .tw-band-gap strong { font-size: 2.1rem; font-weight: 800; line-height: 1; }
  .tw-band-gap em { font-style: normal; font-size: 0.85rem; color: var(--ink-2, #4a4639); }
  .tw-band-fact strong { font-size: 1.35rem; font-weight: 700; line-height: 1.1; }
  .tw-band-fact.is-bad strong { color: #b3372f; }
  .tw-band-stamp {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--mono, monospace);
    font-size: 10px;
    color: var(--ink-3, #7a7466);
  }
  @media (max-width: 860px) {
    .tw-band-inner { grid-template-columns: 1fr; }
  }
</style>
