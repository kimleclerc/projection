---
interface Props {
  lang: 'en' | 'fr' | 'es';
}

const { lang } = Astro.props;

const media = [
  {
    outlet: 'Québec Nouvelles',
    date: '2026-09-30',
    displayDate: { en: 'September 30, 2026', fr: '30 septembre 2026', es: '30 de septiembre de 2026' },
    title: {
      en: 'The last Quebec projection before the vote',
      fr: 'Le PQ en route vers une majorité fragile : la dernière projection avant le vote',
      es: 'La última proyección de Quebec antes de la votación',
    },
    body: {
      en: 'An interview on the final Vote-Scope projection: the ridings that would decide a majority and where the Conservatives could surprise.',
      fr: 'Un entretien sur la projection finale de Vote-Scope : les circonscriptions qui décideraient d’une majorité et celles où les conservateurs pouvaient surprendre.',
      es: 'Una entrevista sobre la proyección final de Vote-Scope: los distritos que decidirían una mayoría y dónde los conservadores podían sorprender.',
    },
    url: 'https://quebecnouvelles.substack.com/p/le-pq-en-route-vers-une-majorite',
    type: 'Article',
