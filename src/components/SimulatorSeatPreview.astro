---
import type { SimDoc } from '../lib/mini-sim';

interface Props {
  doc: SimDoc;
  label: string;
}

const { doc, label } = Astro.props;
const parties = doc.parties
  .filter((party) => party.seats_projected >= .5)
  .sort((a, b) => b.seats_projected - a.seats_projected);
const seats = parties.flatMap((party) =>
  Array.from({ length: Math.round(party.seats_projected) }, () => party.color),
).slice(0, doc.meta.total_seats);
---

<div class="sim-seat-preview" role="img" aria-label={label}>
  <div class="sim-seat-bar">
    {parties.map((party) => (
      <span style={{ width:`${party.seats_projected / doc.meta.total_seats * 100}%`, background:party.color }}></span>
    ))}
  </div>
  <div class="sim-seat-field" style={`--seat-count:${Math.ceil(Math.sqrt(doc.meta.total_seats * 1.5))}`}>
    {seats.map((color) => <i style={{ background:color }}></i>)}
  </div>
  <strong>{doc.meta.total_seats}</strong>
</div>

<style>
  .sim-seat-preview { position:relative; display:grid; align-content:center; gap:26px; width:100%; height:100%; min-height:220px; padding:clamp(24px,5vw,64px); overflow:hidden; }
  .sim-seat-preview::before { content:""; position:absolute; width:55%; aspect-ratio:1; right:-8%; top:8%; border:1px solid var(--rule); border-radius:50%; opacity:.55; }
  .sim-seat-bar { position:relative; z-index:1; display:flex; height:18px; overflow:hidden; border:1px solid color-mix(in srgb,var(--ink) 12%,transparent); border-radius:2px; }
  .sim-seat-field { position:relative; z-index:1; display:grid; grid-template-columns:repeat(var(--seat-count),1fr); gap:clamp(3px,.45vw,7px); max-width:720px; }
  .sim-seat-field i { display:block; aspect-ratio:1; border-radius:50%; box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ink) 12%,transparent); }
  .sim-seat-preview > strong { position:absolute; right:5%; bottom:3%; color:color-mix(in srgb,var(--ink) 8%,transparent); font:500 clamp(90px,18vw,240px)/.8 var(--serif); }
</style>
