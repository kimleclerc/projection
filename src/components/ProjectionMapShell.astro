---
interface Props {
  title: string;
  body: string;
  dataUrl: string;
  geoUrl: string;
  islandName: string;
  href?: string;
  actionLabel?: string;
}

const { title, body, dataUrl, geoUrl, islandName, href, actionLabel } = Astro.props;
---

<section class="map-shell" data-map-shell={islandName}>
  <div class="map-copy">
    <p class="eyebrow">Reusable map island</p>
    <h2>{title}</h2>
    <p>{body}</p>
    {href && actionLabel && <a class="map-link" href={href}>{actionLabel}</a>}
  </div>
  <div class="map-frame">
    <div class="map-placeholder">
      <span>{islandName}</span>
      <strong>{dataUrl}</strong>
      <small>{geoUrl}</small>
    </div>
  </div>
</section>

<style>
  .map-shell {
    display: grid;
    grid-template-columns: .55fr 1fr;
    gap: 28px;
    padding: 32px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
  }

  h2 {
    margin-top: 10px;
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1.04;
  }

  p {
    margin-top: 14px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    margin-top: 20px;
    border-bottom: 1px solid currentColor;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .map-link:hover {
    color: var(--accent);
  }

  .map-frame {
    min-height: 310px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background:
      linear-gradient(90deg, color-mix(in oklab, var(--rule) 52%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in oklab, var(--rule) 52%, transparent) 1px, transparent 1px),
      var(--paper-3);
    background-size: 34px 34px;
    display: grid;
    place-items: center;
  }

  .map-placeholder {
    max-width: 420px;
    padding: 22px;
    text-align: center;
  }

  .map-placeholder span,
  .map-placeholder small {
    display: block;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .map-placeholder strong {
    display: block;
    margin: 10px 0;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 420;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .map-shell {
      grid-template-columns: 1fr;
      padding: 22px;
    }
  }
</style>
