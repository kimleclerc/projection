---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import CusmaTugOfWar from '../../islands/CusmaTugOfWar.tsx';
import PolymarketEmbed from '../PolymarketEmbed.astro';
import NewsletterCta from '../NewsletterCta.astro';
import { showdownLabel, pick, pickList } from '../../data/cusmaShowdown';
import type { ShowdownData, ShowdownLocale, MarketCard, PollCard } from '../../data/cusmaShowdown';
import '../../styles/lame-duck.css';
import '../../styles/cusma-desk.css';

interface Props {
  data: ShowdownData;
  locale: ShowdownLocale;
  canonicalPath: string;
}

const { data, locale, canonicalPath } = Astro.props;

const copy = {
  en: {
    title: 'Canada–U.S. Trade War — Live Desk, Markets & Polls — Vote-Scope',
    description:
      'The Canada–U.S. tariff war, tracked live: 50% U.S. tariffs in effect, Ottawa’s dollar-for-dollar reply, Polymarket and Kalshi odds, Léger, Abacus and Angus Reid polling on both sides of the border, and the CUSMA leverage gap between Carney and Trump.',
    eyebrow: 'Vote-Scope · CUSMA · Trade-war desk',
    headline: 'The trade war desk.',
    dek:
      'Talks collapsed. The tariffs landed. This page keeps one instrument, one market board and one polling wall on the same screen — updated daily, sourced line by line.',
    updated: 'Updated',
    live: 'Live',
    meterTitle: 'Leverage gap.',
    alertNext: 'Next: Canadian counter-tariffs',
    factsEyebrow: 'What is actually in force',
