---
/**
 * National Latino Vote Index — the aggregated series, with its own precision
 * printed beside it rather than in a footnote.
 *
 * The product promise is the subsample size in plain sight. Every competing
 * page either stops at the national horse race or prints demographic crosstabs
 * with no n and no per-group margin, so the one thing this section must never
 * do is show a number without showing what stands behind it.
 *
 * Deliberately chart-free while the series is young: three usable waves from
 * two houses that sit ~5 points apart would produce a line describing the gap
 * between the houses, not the electorate. The table is the honest form until
 * waves accumulate. See build_us_latino_vote_index.py in the engine.
 */
import voteIndex from '../../../web_data/us-latino-radar/vote_index.json';
import { radarCopy, type RadarLocale } from '../../data/latinoRadar';

const { locale } = Astro.props as { locale: RadarLocale };
const C = radarCopy[locale].voteIndex;
const idx = voteIndex.index;
const spread = idx.house_spread;

const nf = new Intl.NumberFormat(locale === 'en' ? 'en-CA' : locale === 'es' ? 'es-US' : 'fr-CA');
/** French sets a narrow no-break space before % and before a colon; English
 *  and Spanish set the percent tight and the colon flush. Getting this wrong
 *  is the tell that a page was written in one language and translated. */
const nbsp = locale === 'fr' ? '\u202f' : '';
const colon = locale === 'fr' ? '\u202f: ' : ': ';
/** Decimal separator follows the locale too: fr-CA writes 65,1 where en-CA and
 *  es-US write 65.1. toFixed() would have printed a dot in all three. */
const d1 = new Intl.NumberFormat(
  locale === 'en' ? 'en-CA' : locale === 'es' ? 'es-US' : 'fr-CA',
  { minimumFractionDigits: 1, maximumFractionDigits: 1 },
);
const pct = (v: number | null) => (v === null || v === undefined ? '—' : `${d1.format(v)}${nbsp}%`);
const signed = (v: number | null) =>
  v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${d1.format(v)}`;

/** Field window as a compact range — the dates that actually govern a wave. */
const fieldRange = (start: string | null, end: string | null) => {
  if (!end) return '—';
  const fmt = (d: string) =>
    new Date(`${d}T12:00:00`).toLocaleDateString(
      locale === 'en' ? 'en-CA' : locale === 'es' ? 'es-US' : 'fr-CA',
      { month: 'short', day: 'numeric', year: 'numeric' },
    );
  return start && start !== end ? `${fmt(start)} – ${fmt(end)}` : fmt(end);
};

/** Waves that carry a usable two-party share, newest first. */
const waves = [...voteIndex.waves].sort((a, b) =>
  (b.field_end ?? '').localeCompare(a.field_end ?? ''),
);
---

<section class="lvi" aria-labelledby="lvi-title">
  <div class="radar-container">
    <p class="radar-eyebrow">{C.eyebrow}</p>
    <h2 id="lvi-title">{C.title}</h2>
    <p class="lvi-dek">{C.dek}</p>

    <div class="lvi-headline">
      <div class="lvi-figure">
        <span class="lvi-label">{C.headline}</span>
        <strong>{pct(idx.two_party_dem)}</strong>
        <p class="lvi-ci">
          {C.ci}{colon}{pct(idx.ci95[0])} – {pct(idx.ci95[1])}
          <span aria-hidden="true"> · </span>
          {C.marginLabel} D{signed(idx.two_party_margin_dem)}
        </p>
      </div>

      <div class="lvi-quality" role="note">
        <span class="lvi-label">{C.cautionTitle}</span>
        <p>{C.thin(idx.effective_sample, idx.distinct_houses, idx.days_since_latest_field)}</p>
        {spread.spread !== null && <p>{C.spread(spread.spread)}</p>}
        <p class="lvi-nochart">{C.noChart}</p>
      </div>
    </div>

    <div class="lvi-why">
      <span class="lvi-label">{C.whyTwoParty}</span>
      <p>{voteIndex.meta.why_two_party[locale]}</p>
    </div>

    <h3>{C.wavesTitle}</h3>
    <p class="lvi-gapdek">{C.gapDek}</p>

    <div class="lvi-scroll">
      <table class="lvi-table">
        <thead>
          <tr>
            <th scope="col">{C.thHouse}</th>
            <th scope="col">{C.thField}</th>
            <th scope="col" class="num">{C.thSample}</th>
            <th scope="col" class="num">{C.thShares}</th>
            <th scope="col" class="num">{C.thTwoParty}</th>
            <th scope="col" class="num">{C.thGap}</th>
          </tr>
        </thead>
        <tbody>
          {waves.map((w) => (
            <tr class={w.two_party_dem === null ? 'is-excluded' : undefined}>
              <th scope="row">
                {w.firm}
                {w.client && w.client !== w.firm && <span class="lvi-client">{w.client}</span>}
              </th>
              <td>{fieldRange(w.field_start, w.field_end)}</td>
              <td class="num">
                {w.sample_size ? nf.format(w.sample_size) : '—'}
                {w.moe !== null && <span class="lvi-moe">±{d1.format(w.moe)}</span>}
              </td>
              <td class="num">
                {w.dem !== null && w.rep !== null
                  ? `${w.dem.toFixed(0)} / ${w.rep.toFixed(0)}`
                  : w.margin_dem !== null
                    ? <span class="lvi-note">{C.marginOnly}</span>
                    : <span class="lvi-note">{C.noBallot}</span>}
              </td>
              <td class="num">{w.two_party_dem === null ? '—' : pct(w.two_party_dem)}</td>
              <td class="num lvi-gap">{w.gap_vs_total_electorate === null ? '—' : signed(w.gap_vs_total_electorate)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .lvi { padding: 52px 0 64px; border-bottom: 1px solid var(--rule); }
  .lvi h2 { margin: 14px 0 12px; font: 430 clamp(34px, 4vw, 54px)/1 var(--serif); letter-spacing: -.025em; }
  .lvi h3 { margin: 44px 0 6px; font: 430 26px/1.1 var(--serif); }
  .lvi-dek { max-width: 760px; font: 430 clamp(18px, 1.8vw, 22px)/1.35 var(--serif); color: var(--ink-2); }
  .lvi-label { display: block; font: 650 10px/1.2 var(--mono); letter-spacing: .11em; text-transform: uppercase; color: var(--ink-3); }

  .lvi-headline { display: grid; grid-template-columns: minmax(240px, 340px) 1fr; gap: 34px; margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--ink); }
  .lvi-figure strong { display: block; margin-top: 10px; font: 430 clamp(48px, 6vw, 72px)/.95 var(--serif); letter-spacing: -.03em; }
  .lvi-ci { margin-top: 10px; font: 11px/1.5 var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; }

  /* The caution box is not a disclaimer tucked under the fold — it sits beside
     the number it qualifies, at the same visual weight as the figure's label. */
  .lvi-quality { padding-left: 30px; border-left: 1px solid var(--rule); }
  .lvi-quality p { margin-top: 10px; color: var(--ink-2); line-height: 1.55; font-size: 14px; }
  .lvi-nochart { font-style: italic; }

  .lvi-why { margin-top: 30px; padding: 18px 22px; background: color-mix(in srgb, var(--radar-accent) 7%, transparent); border-radius: 3px; }
  .lvi-why p { margin-top: 8px; max-width: 820px; line-height: 1.55; font-size: 14px; }
  .lvi-gapdek { max-width: 780px; color: var(--ink-2); line-height: 1.55; font-size: 14px; }

  .lvi-scroll { margin-top: 18px; overflow-x: auto; }
  .lvi-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .lvi-table th, .lvi-table td { padding: 11px 12px; text-align: left; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .lvi-table thead th { font: 650 10px/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); border-bottom: 1px solid var(--ink); white-space: nowrap; }
  .lvi-table tbody th { font-weight: 600; }
  .lvi-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lvi-table thead .num { text-align: right; }
  .lvi-client { display: block; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); }
  .lvi-moe { margin-left: 6px; font: 10px var(--mono); color: var(--ink-3); }
  .lvi-gap { font-weight: 600; }
  .lvi-note { font: 10px/1.3 var(--mono); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-3); }
  .is-excluded { background: color-mix(in srgb, var(--ink) 3%, transparent); }

  @media (max-width: 880px) {
    .lvi-headline { grid-template-columns: 1fr; gap: 24px; }
    .lvi-quality { padding-left: 0; border-left: 0; padding-top: 18px; border-top: 1px solid var(--rule); }
  }
</style>
