---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import LatinoRadarTable from '../../islands/LatinoRadarTable';
import LatinoVoteIndex from './LatinoVoteIndex.astro';
import { radarCopy, radarRoots, type RadarLocale } from '../../data/latinoRadar';
import '../../styles/latino-radar.css';
import radarData from '../../../web_data/us-latino-radar/latest.json';

const { locale } = Astro.props as { locale: RadarLocale };
const copy = radarCopy[locale];
const weights = radarData.meta.weights;
const longDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString(locale === 'en' ? 'en-US' : locale === 'es' ? 'es-ES' : 'fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const pctW = (n: number) => locale === 'en' ? `${n}%` : `${n}\u00a0%`;
const title = `${copy.title} — Vote-Scope`;
const canonical = `https://vote-scope.com${radarRoots[locale]}`;
const alternates = {
  fr: `https://vote-scope.com${radarRoots.fr}`,
  en: `https://vote-scope.com${radarRoots.en}`,
  es: `https://vote-scope.com${radarRoots.es}`,
};
---
<EditorialLayout
  title={title}
  description={copy.dek}
  canonical={canonical}
  lang={locale}
  currentPage="usa-hub"
  alternates={alternates}
  ogImage={`https://vote-scope.com/og/latino-radar/house-ca-22-${locale}.png`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: copy.title,
    description: copy.dek,
    url: canonical,
    inLanguage: locale,
    dateModified: radarData.meta.run_date,
    creator: { '@type': 'Organization', name: 'Vote-Scope' },
  }}
>
  <main class="latino-radar" data-content-area>
    <header class="radar-hero vs-page-head">
      <div class="radar-container">
        <p class="radar-eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="radar-dek">{copy.dek}</p>
        <p class="radar-explainer">{copy.explainer}</p>
        <p class="radar-explainer">{copy.signals(radarData.national_signals.house.eligible_races, radarData.national_signals.senate.eligible_races)}</p>
        <p class="radar-updated">{copy.updated} · {longDate(radarData.meta.run_date)} · {copy.vintage}</p>
      </div>
    </header>

    <LatinoVoteIndex locale={locale} />

    <section class="radar-ranking">
      <div class="radar-container">
        <div class="radar-section-head">
          <h2>{copy.race}</h2>
          <p>{copy.rankingIntro(radarData.meta.race_count)}</p>
        </div>
        <LatinoRadarTable client:load races={radarData.races} locale={locale} />
        <noscript>
          <ul class="radar-nojs">
            {radarData.races.map((race) => <li><a href={race.urls[locale]}>#{race.rank} · {race.name} · {race.score}/100</a></li>)}
          </ul>
        </noscript>
      </div>
    </section>

    <section class="radar-method">
      <div class="radar-container radar-method-grid">
        <h2>{copy.methodology}</h2>
        <div>
          <p>{copy.methodologyBody}</p>
          <ul class="radar-weights">
            {Object.entries(weights).map(([key, weight]) => {
              const component = radarData.races[0]?.components.find((item) => item.key === key);
              return <li>{component?.labels[locale] ?? key}{locale === 'fr' ? '\u00a0: ' : ': '}{pctW(weight as number)}</li>;
            })}
          </ul>
        </div>
      </div>
    </section>
  </main>
</EditorialLayout>
