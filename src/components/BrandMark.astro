---
/**
 * Le symbole de Vote-Scope : le cercle du bulletin de vote canadien, coché d'une
 * croix, mi-bleu mi-rouge. Une seule source pour le site, le favicon et les images.
 */
interface Props { size?: number; class?: string }
const { size = 40, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 44 44" role="img" aria-label="Vote-Scope">
  <path d="M22 2 A20 20 0 0 0 22 42 Z" fill="#1f77d0" />
  <path d="M22 2 A20 20 0 0 1 22 42 Z" fill="#c62828" />
  <path d="M13 13 L31 31 M31 13 L13 31" stroke="#fff" stroke-width="4.5" stroke-linecap="round" />
</svg>
