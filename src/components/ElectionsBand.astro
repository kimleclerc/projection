---
/**
 * Calendrier électoral — UN seul ordre pour l'accueil, le desk Canada et Labs.
 *
 * Règle (post-scrutin, standard pour toutes les juridictions) :
 *   1. les résultats d'une élection des 21 derniers jours, du plus récent au
 *      plus ancien ;
 *   2. puis les élections à venir, de la plus proche à la plus lointaine ;
 *   3. une élection passée de plus de 21 jours sort du bandeau.
 * Ajouter une élection = ajouter une entrée à CALENDAR ci-dessous. Les chiffres
 * viennent des données publiées, jamais écrits à la main (sauf la date).
 */
import { partyMeta, subjectFr } from '../lib/riding-adapters/parties';
import StoryList from './StoryList.astro';
import qcResults from '../data/qc-results-2026.json';
import bcLatest from '../../web_data/british-columbia/latest.json';
import houseLatest from '../../web_data/us-house/latest.json';
import spainLatest from '../../web_data/spain/latest.json';

type Lang = 'fr' | 'en' | 'es';
/** compact : sans bande ni conteneur, pour une colonne (une de l'accueil). */
interface Props { lang: Lang; scope?: 'all' | 'canada'; compact?: boolean; exclude?: string[] }
const { lang, scope = 'all', compact = false, exclude = [] } = Astro.props;

const L = (fr: string, en: string, es: string) => ({ fr, en, es }[lang]);
const label = (jur: string, code: string) => {
  const m = partyMeta(jur, code) as any;
  return lang === 'en' ? m.label_en : (m.label_fr ?? m.label_en);
};
// Sujet de phrase : « Les conservateurs », « The Conservatives », sinon le sigle.
const subject = (jur: string, code: string) => {
  const m = partyMeta(jur, code) as any;
  const cap = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);
  if (lang === 'fr' && m.mention_fr) return cap(subjectFr(m.mention_fr));
  if (lang === 'en' && m.mention_en) return cap(m.mention_en);
  if (lang === 'es' && m.mention_es) return cap(m.mention_es);
  return label(jur, code);
};
const lead = (doc: any) => [...doc.parties].sort((a: any, b: any) => (b.seats_projected ?? 0) - (a.seats_projected ?? 0))[0];

const today = new Date(new Date().toISOString().slice(0, 10) + 'T12:00:00Z');
const days = (iso: string) => Math.round((Date.parse(iso + 'T12:00:00Z') - today.getTime()) / 86_400_000);
const dateFmt = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString(
  lang === 'en' ? 'en-CA' : lang === 'es' ? 'es-ES' : 'fr-CA', { day: 'numeric', month: 'long', timeZone: 'UTC' });

const qcSeats = (qcResults as any).parties.filter((p: any) => p.seats > 0 || p.party === 'caq')
  .map((p: any) => `${label('quebec', p.party)} ${p.seats}`).join(' · ');
const qcWinner = label('quebec', (qcResults as any).winner);
const bc = lead(bcLatest); const house = (houseLatest as any).parties.find((p: any) => p.party === 'us_dem');
const es = lead(spainLatest);

const CALENDAR = [
  { id: 'qc-2026', canada: true, date: '2026-10-05', place: L('Québec', 'Quebec', 'Quebec'),
    headline: (qcResults as any).government === 'minority'
      ? L(`Le ${qcWinner} formera un gouvernement minoritaire`, `The ${qcWinner} will form a minority government`, `El ${qcWinner} formará un gobierno minoritario`)
      : L(`Le ${qcWinner} formera un gouvernement majoritaire`, `The ${qcWinner} will form a majority government`, `El ${qcWinner} formará un gobierno mayoritario`),
    detail: qcSeats,
    href: L('/fr/canada/quebec/resultats/', '/en/canada/quebec/results/', '/es/canada/quebec/resultados/'),
    cta: L('Voir les résultats', 'See the results', 'Ver los resultados') },
  { id: 'bc-2026', canada: true, date: '2026-10-24', place: L('Colombie-Britannique', 'British Columbia', 'Columbia Británica'),
    headline: L(`${subject('british-columbia', bc.party)} en tête : ${bc.seats_projected} sièges projetés sur 93`,
                `${subject('british-columbia', bc.party)} ahead: ${bc.seats_projected} projected seats of 93`,
                `${subject('british-columbia', bc.party)} en cabeza: ${bc.seats_projected} escaños proyectados de 93`),
    detail: L(`Chances de majorité : ${Math.round(100 * (bc.p_majority ?? 0))} %`, `Majority chance: ${Math.round(100 * (bc.p_majority ?? 0))}%`, `Probabilidad de mayoría: ${Math.round(100 * (bc.p_majority ?? 0))} %`),
    href: L('/fr/canada/colombie-britannique/', '/en/canada/british-columbia/', '/es/canada/columbia-britanica/'),
    cta: L('Ouvrir la projection', 'Open the forecast', 'Abrir la proyección') },
  { id: 'us-2026', canada: false, date: '2026-11-03', place: L('États-Unis · mi-mandat', 'United States · midterms', 'Estados Unidos · elecciones intermedias'),
    headline: L(`Chambre : ${house.seats_projected} sièges démocrates projetés`, `House: ${house.seats_projected} projected Democratic seats`, `Cámara: ${house.seats_projected} escaños demócratas proyectados`),
    detail: L(`Chances d'une Chambre démocrate : ${Math.round(100 * house.p_majority)} %`, `Chance of a Democratic House: ${Math.round(100 * house.p_majority)}%`, `Probabilidad de una Cámara demócrata: ${Math.round(100 * house.p_majority)} %`),
    href: L('/fr/us/', '/en/us/', '/es/us/'),
    cta: L('Ouvrir la rubrique É.-U.', 'Open the U.S. section', 'Abrir la sección EE. UU.') },
  { id: 'es-2026', canada: false, date: '2026-11-29', place: L('Espagne', 'Spain', 'España'),
    headline: L(`${subject('spain', es.party)} en tête : ${es.seats_projected} sièges projetés sur 350`, `${subject('spain', es.party)} ahead: ${es.seats_projected} projected seats of 350`, `${subject('spain', es.party)} en cabeza: ${es.seats_projected} escaños proyectados de 350`),
    detail: L('Élections générales anticipées', 'Snap general election', 'Elecciones generales anticipadas'),
    href: L('/fr/spain/', '/en/spain/', '/es/spain/'),
    cta: L('Ouvrir la projection', 'Open the forecast', 'Abrir la proyección') },
];

const RECENT_DAYS = 21;
const items = CALENDAR
  .filter((e) => scope === 'all' || e.canada)
  .filter((e) => !exclude.includes(e.id))
  .map((e) => ({ ...e, d: days(e.date) }))
  .filter((e) => e.d >= -RECENT_DAYS);
const results = items.filter((e) => e.d < 0).sort((a, b) => b.d - a.d);
const upcoming = items.filter((e) => e.d >= 0).sort((a, b) => a.d - b.d);
// Les scrutins à venir d'abord ; un résultat récent passe après.
const ordered = [...upcoming, ...results];

const when = (e: { d: number; date: string }) => e.d < 0
  ? L(`Résultats · ${dateFmt(e.date)}`, `Results · ${dateFmt(e.date)}`, `Resultados · ${dateFmt(e.date)}`)
  : e.d === 0 ? L('Aujourd’hui', 'Today', 'Hoy')
  : L(`${dateFmt(e.date)} · dans ${e.d} jours`, `${dateFmt(e.date)} · in ${e.d} days`, `${dateFmt(e.date)} · en ${e.d} días`);
// « Ajouter à mon agenda » : un fichier .ics fabriqué dans le lien lui-même
// (data:), journée entière, aucun fichier publié en plus.
const icsDate = (iso: string) => iso.replaceAll('-', '');
const nextDay = (iso: string) => new Date(Date.parse(iso + 'T12:00:00Z') + 86_400_000).toISOString().slice(0, 10);
const ics = (e: { id: string; date: string; place: string; href: string }) => {
  const body = [
    'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Vote-Scope//Calendrier//FR', 'BEGIN:VEVENT',
    `UID:${e.id}@vote-scope.com`, `DTSTAMP:${icsDate(new Date().toISOString().slice(0, 10))}T000000Z`,
    `DTSTART;VALUE=DATE:${icsDate(e.date)}`, `DTEND;VALUE=DATE:${icsDate(nextDay(e.date))}`,
    `SUMMARY:${L('Élection', 'Election', 'Elección')} — ${e.place}`,
    `URL:https://vote-scope.com${e.href}`,
    `DESCRIPTION:${L('Projection et résultats sur Vote-Scope', 'Forecast and results on Vote-Scope', 'Proyección y resultados en Vote-Scope')} : https://vote-scope.com${e.href}`,
    'END:VEVENT', 'END:VCALENDAR',
  ].join('\r\n');
  return `data:text/calendar;charset=utf-8,${encodeURIComponent(body)}`;
};
const storyItems = ordered.map((e) => ({
  meta: `${e.place} · ${when(e)}`,
  title: e.headline,
  text: e.detail,
  href: e.href,
  strong: e.d < 0,
  extra: e.d > 0 ? { href: ics(e), label: L('Ajouter à mon agenda', 'Add to my calendar', 'Añadir a mi calendario'), download: `vote-scope-${e.id}.ics` } : undefined,
}));
const title = scope === 'canada' ? L('Élections au Canada', 'Elections in Canada', 'Elecciones en Canadá')
  : L('Élections en cours', 'Elections now', 'Elecciones en curso');
---
{ordered.length > 0 && (compact ? (
  <StoryList heading={title} items={storyItems} size="sm" />
) : (
  <section class="elections-band">
    <div class="container">
      <StoryList heading={title} items={storyItems} columns={2} />
    </div>
  </section>
))}

<style>
  .elections-band { padding: 2rem 0; border-bottom: 1px solid var(--rule); }
</style>
