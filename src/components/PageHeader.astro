---
/**
 * En-tête de page canonique (docs/DESIGN.md §5–6). Une colonne : titre, phrase de
 * présentation, réponse clé en gras, actions. Pas d'étiquette au-dessus du titre,
 * pas d'encadré décoratif. Toute page de desk ou d'index part de ce composant.
 */
import GooglePreferredSource from './GooglePreferredSource.astro';

interface Props {
  title: string;
  promise?: string;
  /** La réponse chiffrée de la page, en une phrase. */
  question?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  preferredSourceLocale?: 'en' | 'fr' | 'es';
  /** Hérités d'EditorialHero, ignorés (plus d'étiquette au-dessus du titre). */
  eyebrow?: string;
  questionLabel?: string;
}
const { title, promise, question, primaryHref, primaryLabel, secondaryHref, secondaryLabel, preferredSourceLocale } = Astro.props;
---
<header class="vs-page-header vs-page-head">
  <div class="container">
    <h1>{title}</h1>
    {promise && <p class="ph-promise">{promise}</p>}
    {question && <p class="ph-answer">{question}</p>}
    {(primaryHref || secondaryHref) && (
      <p class="ph-actions">
        {primaryHref && <a class="vs-btn" href={primaryHref}>{primaryLabel}</a>}
        {secondaryHref && <a class="vs-btn-secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </p>
    )}
    {preferredSourceLocale && <div class="ph-source"><GooglePreferredSource locale={preferredSourceLocale} /></div>}
  </div>
</header>

<style>
  .vs-page-header { padding: 40px 0 28px; }
  .ph-promise { max-width: 760px; margin: 0; color: var(--ink-2); font-size: 18px; line-height: 1.5; }
  .ph-answer { max-width: 760px; margin: 16px 0 0; padding-top: 14px; border-top: 3px solid var(--ink); font-size: 22px; font-weight: 700; line-height: 1.3; }
  .ph-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 0; }
  .ph-source { margin-top: 18px; }
</style>
