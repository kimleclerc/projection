    thMiss: ['Distrito', 'Ganador', 'Sus probabilidades según Harfang', 'Favorito de Harfang', 'Órbita', 'Mezcla', 'Margen final'],
    regTitle: 'Dónde nos equivocamos',
    regIntro: 'Diferencia media entre nuestra proyección y el resultado, por distrito, en puntos. Positivo: teníamos al partido demasiado alto.',
    thReg: ['Región', 'Distr.', 'Aciertos'],
    regRead: `Destacan dos errores. Québec solidaire estaba subestimado en 7 puntos en los distritos de Montreal: su voto allí está más concentrado de lo que pensábamos, y ganó Rosemont, Taschereau y Sherbrooke. Y la CAQ se hundió sobre todo en sus antiguos bastiones de la Beauce y Quebec, en beneficio del PCQ, mientras nosotros repartíamos su caída de forma más pareja.`,
    disTitle: 'Harfang frente a Órbita',
    disText: `Los dos motores no tenían el mismo favorito en ${disagree.length} distritos. Órbita acertó ${orbRight} veces, Harfang ${harRight}.`,
    thDis: ['Distrito', 'Harfang', 'Órbita', 'Ganador'],
    qTitle: 'Órbita en un ordenador clásico y en un chip cuántico',
    qIntro: `La víspera de la votación, Órbita sorteó ${Q.elections.toLocaleString(loc)} elecciones en el chip cuántico Fez de IBM, en ${Q.qpu_seconds} segundos de máquina. Mismo modelo, dos máquinas: esto daba cada una.`,
    thQ: ['', 'Ordenador clásico', 'Chip Fez', 'Resultado'],
    qRows: { hits: 'Ganadores acertados', maj: 'Probabilidad de mayoría del PQ' },
    qRead: (d: any) => `El chip reproduce el cálculo clásico casi idéntico: el mismo número de ganadores acertados, y un solo distrito donde cambia el favorito (${d.name}, ganado por ${label(d.winner)}, que ambas máquinas fallan). El ruido del chip mueve cerca de un escaño, sobre todo hacia la CAQ. Las máquinas cuánticas de hoy no hacen la proyección más precisa; la rehacen, con algo de ruido.`,
    callTitle: 'Fastest Call, la noche electoral',
    callText: `Anunciamos el ganador de los ${C.n} distritos, sin que el escrutinio desmintiera ningún anuncio. ${C.auto} se anunciaron automáticamente, cuando nuestros dos motores daban luz verde; ${C.console} tras una verificación, ${C.against_model} de ellos contra la opinión del modelo, todos acertados. El gobierno del PQ se anunció a las ${clock(C.government)}, su minoría a las ${clock(C.minority)}.`,
    callK: [['antes de las 21:00', '21h'], ['antes de las 22:00', '22h'], ['antes de medianoche', '24h']],
    mediaTitle: 'Nuestros anuncios frente a las grandes cadenas',
    mediaIntro: 'Dos anuncios contaban el lunes por la noche: quién formaría el gobierno y si sería mayoritario o minoritario.',
    thMedia: ['', 'El PQ formará gobierno', 'Gobierno minoritario'],
    media: [['Vote-Scope', '20:27', '21:22'], ['CTV News', 'hacia las 20:18', '21:38'], ['Radio-Canada', '20:37', '22:00'], ['TVA Nouvelles', 'hacia las 20:45', 'hacia las 22:00']],
    mediaRead: 'CTV fue la primera en anunciar el gobierno del PQ, nueve minutos antes que nosotros. Sobre la minoría, el anuncio que decidía la noche, fuimos los primeros: 16 minutos antes que CTV y unos 38 minutos antes que Radio-Canada y TVA. Si seguía la noche con Vote-Scope, podía irse a dormir temprano sin sorpresas a la mañana siguiente: ninguno de nuestros 127 anuncios fue desmentido.',
    mediaSrc: 'Horas de las cadenas según sus propios reportajes y directos; «hacia» cuando no dan el minuto.',
    callMedian: `una mediana de ${C.median_minutes} minutos tras el cierre de las mesas`,
    lessTitle: 'Lo que retenemos',
    less: [
      'Nuestros rangos de voto eran demasiado estrechos cuando todas las encuestadoras fallan en el mismo sentido, como con la CAQ y QS. Los ampliaremos para tener en cuenta ese error común.',
      'Nuestro mapa debe seguir mejor dónde gana o pierde un partido: un voto concentrado en Montreal para QS, una caída concentrada en sus bastiones para la CAQ.',
      'La mezcla de nuestros dos motores acertó más ganadores que cada uno. Le daremos más peso.',
      'La noche electoral, mostrar juntos la mediana de escaños y el recuento de distritos en cabeza, diciendo de antemano cuántos distritos pueden cambiar: es el retrato más honesto.',
    ],
    note: 'Resultados preliminares de Élections Québec, todas las mesas escrutadas; este balance se revisará con los resultados oficiales. Proyecciones tal como se publicaron la víspera.',
    links: [['Metodología', '/es/metodologia/'], ['Boletín de encuestadoras', '/es/metodologia/encuestadoras/'], ['Los resultados', '/es/canada/quebec/resultados/'], ['Historial', '/es/track-record/']],
    seatsUnit: 'escaños', none: '—',
  },
}[locale];

const favLine = (k: string) => PARTIES.map((p) => `${label(p)} ${B.seats[p][k]}`).join(', ');
const favErr = (k: string) => num(seatErr(k));
const favH = `${favLine('harfang_fav')} (${favErr('harfang_fav')} ${T.seatsUnit})`;
const favB = `${favLine('blend_fav')} (${favErr('blend_fav')})`;
const range = (r: number[], d = 0) => `${num(r[0], d)}–${num(r[1], d)}`;
const calRows = RS.harfang.calibration.map((c: any, i: number) => ({
  label: c.from >= 0.99 ? '≥ 99 %' : `${Math.round(c.from * 100)}–${Math.round(c.to * 100)} %`,
  n: c.n, h: c.got, o: RS.orbite.calibration[i]?.got, b: RS.blend.calibration[i]?.got,
}));
const pctCell = (x: number | undefined) => (x == null ? T.none : pct(x));
---

<article class="qr" data-content-area>
  <header class="container qr-head vs-page-head">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
    <p class="qr-lede">{T.lede}</p>
  </header>

  <section class="container qr-keys">
    {T.k.map(([k, v, s]) => (<div><span>{k}</span><strong>{v}</strong><em>{s}</em></div>))}
  </section>

  <section class="container qr-block">
    <h2>{T.seatsTitle}</h2>
    <p class="qr-intro">{T.seatsIntro}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thSeats.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {PARTIES.map((p) => {
            const s = B.seats[p];
            return (
              <tr>
                <th scope="row"><i class="chip" style={`--c:${color(p)}`}></i>{label(p)}</th>
                <td class="qr-strong">{res.seats[p]}</td>
                <td>{s.harfang_median} <small class={inRange(res.seats[p], s.harfang_80) ? '' : 'out'}>{range(s.harfang_80)}</small></td>
                <td>{s.harfang_fav}</td>
                <td>{s.orbite_median} <small class={inRange(res.seats[p], s.orbite_80) ? '' : 'out'}>{range(s.orbite_80)}</small></td>
                <td>{s.orbite_fav}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p>{T.seatsRead}</p>
    <h3>{T.favTitle}</h3>
    <p>{T.favText(favH, favB)}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.voteTitle}</h2>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thVote.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {PARTIES.map((p) => {
            const v = B.vote[p];
            return (
              <tr>
                <th scope="row"><i class="chip" style={`--c:${color(p)}`}></i>{label(p)}</th>
                <td class="qr-strong">{num(res.vote[p])}</td>
                <td>{num(v.harfang)} <small class={inRange(res.vote[p], v.harfang_80) ? '' : 'out'}>{range(v.harfang_80, 1)}</small></td>
                <td>{num(v.orbite)} <small class={inRange(res.vote[p], v.orbite_80) ? '' : 'out'}>{range(v.orbite_80, 1)}</small></td>
                <td>{num(v.polls)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p>{T.voteRead}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.ridTitle}</h2>
    <p class="qr-intro">{T.ridIntro}</p>
    <div class="qr-engines">
      {(['harfang', 'orbite', 'blend'] as const).map((k) => (
        <div class={k === 'blend' ? 'is-best' : ''}>
          <span>{T.ridLabels[k]}</span>
          <strong>{RS[k].hits}<small> / 127 · {pct(RS[k].hits / 127)}</small></strong>
          <div class="qr-meter" aria-hidden="true"><i style={`width:${(RS[k].hits / 127) * 100}%`}></i></div>
          <em>{T.expected(num(RS[k].expected, 0))}</em>
        </div>
      ))}
    </div>
    <p>{T.ridRead}</p>
    <h3>{T.calTitle}</h3>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thCal.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {calRows.map((c: any) => (
            <tr><th scope="row">{locale === 'en' ? c.label.replace(' %', '%') : c.label}</th><td>{pctCell(c.h)}</td><td>{pctCell(c.o)}</td><td>{pctCell(c.b)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="qr-small">{T.calRead}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.missTitle}</h2>
    <p class="qr-intro">{T.missIntro}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thMiss.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {misses.map((r: any) => (
            <tr>
              <th scope="row">{hrefOf(r.id) ? <a href={hrefOf(r.id)}>{r.name}</a> : r.name}</th>
              <td><i class="chip" style={`--c:${color(r.winner)}`}></i>{label(r.winner)}</td>
              <td class="qr-strong">{pct(r.harfang.p_winner)}</td>
              <td>{label(r.harfang.fav)} <small>{pct(r.harfang.p)}</small></td>
              <td class={r.orbite.fav === r.winner ? 'ok' : ''}>{label(r.orbite.fav)} <small>{pct(r.orbite.p)}</small></td>
              <td class={r.blend.fav === r.winner ? 'ok' : ''}>{label(r.blend.fav)} <small>{pct(r.blend.p)}</small></td>
              <td>{num(r.margin)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container qr-block">
    <h2>{T.regTitle}</h2>
    <p class="qr-intro">{T.regIntro}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thReg.map((h) => <th>{h}</th>)}{PARTIES.map((p) => <th>{label(p)}</th>)}</tr></thead>
        <tbody>
          {B.regions.map((g: any) => (
            <tr>
              <th scope="row">{REGIONS[g.key]?.[locale] ?? g.key}</th>
              <td>{g.n}</td><td>{g.hits}</td>
              {PARTIES.map((p) => <td class={Math.abs(g.err[p]) >= 4 ? 'big' : ''}>{pt(g.err[p])}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{T.regRead}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.disTitle}</h2>
    <p>{T.disText}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thDis.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {disagree.map((r: any) => (
            <tr>
              <th scope="row">{hrefOf(r.id) ? <a href={hrefOf(r.id)}>{r.name}</a> : r.name}</th>
              <td class={r.harfang.fav === r.winner ? 'ok' : ''}>{label(r.harfang.fav)} <small>{pct(r.harfang.p)}</small></td>
              <td class={r.orbite.fav === r.winner ? 'ok' : ''}>{label(r.orbite.fav)} <small>{pct(r.orbite.p)}</small></td>
              <td><i class="chip" style={`--c:${color(r.winner)}`}></i>{label(r.winner)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container qr-block">
    <h2>{T.qTitle}</h2>
    <p class="qr-intro">{T.qIntro}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thQ.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {PARTIES.map((p) => (
            <tr>
              <th scope="row"><i class="chip" style={`--c:${color(p)}`}></i>{label(p)} <small>({T.seatsUnit})</small></th>
              <td>{num(Q.seats[p].classical)}</td><td>{num(Q.seats[p].quantum)}</td><td class="qr-strong">{res.seats[p]}</td>
            </tr>
          ))}
          <tr><th scope="row">{T.qRows.hits}</th><td>{Q.ridings.exact.hits}</td><td>{Q.ridings.drawn.hits}</td><td>127</td></tr>
          <tr><th scope="row">{T.qRows.maj}</th><td>{pct(Q.pq_majority.classical)}</td><td>{pct(Q.pq_majority.quantum)}</td><td>{T.none}</td></tr>
        </tbody>
      </table>
    </div>
    {Q.differs.length > 0 && <p>{T.qRead(Q.differs[0])}</p>}
  </section>

  <section class="container qr-block">
    <h2>{T.callTitle}</h2>
    <p>{T.callText}</p>
    <div class="qr-calls">
      {T.callK.map(([l, k]) => (
        <div><strong>{C.by_hour[k]}</strong><span>{l}</span><div class="qr-meter" aria-hidden="true"><i style={`width:${(C.by_hour[k] / C.n) * 100}%`}></i></div></div>
      ))}
    </div>
    <p class="qr-small">{C.n} {locale === 'fr' ? 'annonces' : locale === 'es' ? 'anuncios' : 'calls'} · {T.callMedian}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.mediaTitle}</h2>
    <p class="qr-intro">{T.mediaIntro}</p>
    <div class="qr-scroll">
      <table>
        <thead><tr>{T.thMedia.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>
          {T.media.map(([n, g, m], i) => (
            <tr class={i === 0 ? 'qr-us' : ''}><th scope="row">{n}</th><td>{g}</td><td>{m}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{T.mediaRead}</p>
    <p class="qr-small">{T.mediaSrc}</p>
  </section>

  <section class="container qr-block">
    <h2>{T.lessTitle}</h2>
    <ul class="qr-less">{T.less.map((l) => <li>{l}</li>)}</ul>
  </section>

  <section class="container qr-foot">
    <p>{T.note}</p>
    <nav>{T.links.map(([l, h]) => <a href={h}>{l}</a>)}</nav>
  </section>
</article>

<style>
  .qr-head { padding-top: 2rem; display: grid; gap: .75rem; }
  .qr-head h1 { font-family: var(--serif); font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.08; text-wrap: balance; }
  .qr-lede { font-family: var(--serif); font-size: clamp(1.05rem, 1.8vw, 1.25rem); line-height: 1.55; color: var(--ink-2); max-width: 68ch; }
  .qr-keys { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; margin: 1.75rem auto; }
  .qr-keys > div { border: 0; border-top: 1px solid var(--rule); background: transparent; border-radius: 0; padding: .9rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
  .qr-keys span { font-family: var(--mono); font-size: 13px; letter-spacing: 0; color: var(--ink-3); }
  .qr-keys strong { font-family: var(--serif); font-size: 1.7rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.15; }
  .qr-keys em { font-style: normal; font-size: .88rem; color: var(--ink-2); }
  .qr-block { margin: 2.5rem auto; display: grid; gap: .9rem; }
  .qr-block h2 { font-family: var(--serif); font-size: 1.6rem; line-height: 1.2; }
  .qr-block h3 { font-family: var(--serif); font-size: 1.15rem; margin-top: .5rem; }
  .qr-block p { max-width: 70ch; line-height: 1.6; color: var(--ink-2); }
  .qr-intro { color: var(--ink-3) !important; }
  .qr-small { font-size: .9rem; color: var(--ink-3) !important; }
  .qr-scroll { overflow-x: auto; }
  .qr table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: .95rem; }
  .qr th, .qr td { text-align: right; padding: .5rem .6rem; border-bottom: 1px solid var(--rule-2); white-space: nowrap; }
  .qr th:first-child { text-align: left; }
  .qr thead th { font-family: var(--mono); font-size: 13px; font-weight: 500; letter-spacing: 0; color: var(--ink-3); border-bottom: 1px solid var(--rule); }
  .qr tbody th { font-weight: 500; }
  .qr tbody th a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .qr td small, .qr th small { color: var(--ink-3); font-size: .8rem; margin-left: .25rem; }
  .qr td small.out { color: var(--red); }
  .qr td.ok { color: var(--blue); font-weight: 600; }
  .qr td.big { color: var(--red); font-weight: 600; }
  .qr-strong { font-weight: 700; }
  .qr tr.qr-us th, .qr tr.qr-us td { font-weight: 700; color: var(--blue); }
  .chip { display: inline-block; width: .7rem; height: .7rem; border-radius: 2px; background: var(--c); margin-right: .45rem; vertical-align: -1px; }
  .qr-engines { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .75rem; }
  .qr-engines > div { border: 0; border-top: 1px solid var(--rule); border-radius: 0; padding: 1rem; display: grid; gap: .35rem; background: transparent; }
  .qr-engines > div.is-best { border-color: var(--blue); }
  .qr-engines span { font-size: .9rem; color: var(--ink-2); font-weight: 500; }
  .qr-engines strong { font-family: var(--serif); font-size: 2.2rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .qr-engines strong small { font-size: 1rem; color: var(--ink-3); font-weight: 400; }
  .qr-engines em { font-style: normal; font-size: .85rem; color: var(--ink-3); }
  .qr-meter { height: 6px; background: var(--paper-2); border-radius: 2px; overflow: hidden; }
  .qr-meter i { display: block; height: 100%; background: var(--blue); }
  .qr-calls { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .75rem; }
  .qr-calls > div { display: grid; gap: .3rem; }
  .qr-calls strong { font-family: var(--serif); font-size: 1.9rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .qr-calls span { font-size: .88rem; color: var(--ink-3); }
  .qr-less { display: grid; gap: .6rem; padding-left: 1.2rem; max-width: 70ch; color: var(--ink-2); line-height: 1.6; }
  .qr-foot { margin: 2.5rem auto 3rem; border-top: 1px solid var(--rule); padding-top: 1.25rem; display: grid; gap: .75rem; }
  .qr-foot p { font-size: .9rem; color: var(--ink-3); max-width: 75ch; }
  .qr-foot nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .qr-foot a { color: var(--blue); font-weight: 500; }
</style>
