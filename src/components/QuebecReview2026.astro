---
/**
 * Bilan de nos projections, élection québécoise du 5 octobre 2026.
 * Sous-page du Track Record, trois langues. Données : src/data/qc-bilan-2026.json
 * (bilan_qc_2026.py du moteur, export_web). Compare la projection de référence
 * (Harfang des neiges), Orbite, le mélange 50/50 et Fastest Call au résultat.
 * Blocs en enfants directs de [data-content-area] pour l'insertion publicitaire.
 */
import { getAllQuebecRidings } from '../lib/riding-adapters/quebec';
import { partyMeta } from '../lib/riding-adapters/parties';
import bilan from '../data/qc-bilan-2026.json';

interface Props { locale: 'fr' | 'en' | 'es'; }
const { locale } = Astro.props;

const B: any = bilan;
const PARTIES = ['pq', 'plq', 'pcq', 'qs', 'caq'];
const loc = locale === 'fr' ? 'fr-CA' : locale === 'es' ? 'es' : 'en-CA';
const num = (n: number, d = 1) => n.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d });
const pct = (p: number) => `${Math.round(p * 100)}${locale === 'en' ? '%' : ' %'}`;
const pt = (n: number, d = 1) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${num(Math.abs(n), d)}`;
const label = (code: string) => {
  const m = partyMeta('quebec', code);
  return locale === 'en' ? m.label_en : m.label_fr;
};
const color = (code: string) => partyMeta('quebec', code).color;
const clock = (hm: string) => {
  const [h, m] = hm.split(':').map(Number);
  if (locale === 'en') return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'a.m.' : 'p.m.'}`;
  if (locale === 'fr') return `${h} h ${String(m).padStart(2, '0')}`;
  return hm;
};

const slugById = new Map(getAllQuebecRidings().map((r) => [r.id, r.slug]));
const ridingBase = { fr: '/fr/canada/quebec/circonscriptions/', en: '/en/canada/quebec/ridings/', es: '/es/canada/quebec/distritos/' }[locale];
const hrefOf = (id: string) => (slugById.get(id) ? `${ridingBase}${slugById.get(id)}/` : undefined);

const res = B.result;
const mean = (xs: number[]) => xs.reduce((s, x) => s + x, 0) / xs.length;
const voteErr = (k: string) => mean(PARTIES.map((p) => Math.abs(B.vote[p][k] - res.vote[p])));
const seatErr = (k: string) => mean(PARTIES.map((p) => Math.abs(B.seats[p][k] - res.seats[p])));
const inRange = (v: number, r: number[]) => v >= r[0] && v <= r[1];
const covered = (k: string, kind: 'vote' | 'seats') =>
  PARTIES.filter((p) => inRange(kind === 'vote' ? res.vote[p] : res.seats[p], B[kind][p][k])).length;

const RS = B.ridings_summary;
// Du raté le plus serré (on donnait de bonnes chances au gagnant) au plus net.
const misses = (B.ridings as any[]).filter((r) => r.harfang.fav !== r.winner).sort((a, b) => b.harfang.p_winner - a.harfang.p_winner);
const disagree = (B.ridings as any[]).filter((r) => r.harfang.fav !== r.orbite.fav);
const orbRight = disagree.filter((r) => r.orbite.fav === r.winner).length;
const harRight = disagree.filter((r) => r.harfang.fav === r.winner).length;
const Q = B.quantum;
const C = B.calls;

const REGIONS: Record<string, Record<string, string>> = {
  mtl: { fr: 'Montréal et Laval', en: 'Montreal and Laval', es: 'Montreal y Laval' },
  crown: { fr: 'Couronnes de Montréal', en: 'Montreal suburbs', es: 'Coronas de Montreal' },
  qcc: { fr: 'Région de Québec', en: 'Quebec City region', es: 'Región de Quebec' },
  chap: { fr: 'Chaudière-Appalaches', en: 'Chaudière-Appalaches', es: 'Chaudière-Appalaches' },
  estrie: { fr: 'Estrie', en: 'Eastern Townships', es: 'Estrie' },
  rest: { fr: 'Reste du Québec', en: 'Rest of Quebec', es: 'Resto de Quebec' },
};

const T = {
