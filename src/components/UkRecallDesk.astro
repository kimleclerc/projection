---
// Desk « Clacton 2.0 » — deux questions, tenues séparées.
//
//   1. Le siège retombe-t-il vacant, et quand ? (chaîne institutionnelle)
//   2. Si oui, qui gagnerait ? (grille de 24 scénarios, sélectionnable)
//
// ⚠ CE QUE CETTE PAGE NE FAIT PAS. Elle ne dit pas si Nigel Farage a commis une
// infraction : rien n'est jugé, il nie l'ensemble des allégations, et ce n'est
// ni notre rôle ni une chose qu'un modèle tranche. Elle modélise un événement
// institutionnel — une vacance de siège — dont les conditions sont écrites dans
// le Recall of MPs Act 2015. Un gardien du moteur vérifie mécaniquement
// qu'aucun paramètre ne porte de jugement de culpabilité.
import EditorialLayout from '../layouts/EditorialLayout.astro';
import GooglePreferredSource from './GooglePreferredSource.astro';
import MethodologyNote from './MethodologyNote.astro';
import ClactonScenarioPicker from '../islands/ClactonScenarioPicker.tsx';
import recall from '../../web_data/uk-clacton-recall/latest.json';
import '../styles/clacton-scenarios.css';

type Locale = 'en' | 'fr' | 'es';
interface Props { locale: Locale }
const { locale } = Astro.props;

const d = recall as any;
const race = d.race;
const chain = d.chain;
const horizons = d.horizons;
const validation = race.validation_august_2026;
const published = race.published_forecast_august_2026;

const BUCKETS = ['ref', 'con', 'lab', 'ld', 'grn', 'binface', 'oth'];
const COLORS: Record<string, string> = {
  ref: '#12B6CF', con: '#0087DC', lab: '#E4003B', ld: '#FAA61A',
  grn: '#6AB023', binface: '#1a1a1a', oth: '#9a938a',
};

const nf = (v: number, dg = 1) => (locale === 'en' ? v.toFixed(dg) : v.toFixed(dg).replace('.', ','));
const pct = (v: number, dg = 1) => nf(v * 100, dg);
const dayLabel = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(
    locale === 'en' ? 'en-GB' : locale === 'es' ? 'es-ES' : 'fr-FR',
    { day: 'numeric', month: 'long', year: 'numeric' },
  );
const canonical = `https://vote-scope.com/${locale}/uk/byelections/clacton-next/`;
const alternates = {
  en: 'https://vote-scope.com/en/uk/byelections/clacton-next/',
  fr: 'https://vote-scope.com/fr/uk/byelections/clacton-next/',
  es: 'https://vote-scope.com/es/uk/byelections/clacton-next/',
};

