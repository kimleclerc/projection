---
/**
 * Une de l'accueil, commune aux trois langues (docs/DESIGN.md §7) :
 * une ligne de titre du site, puis l'élection principale du moment en grand
 * (les résultats des mi-mandats américains) et, en colonne, les autres
 * élections par date.
 */
import ElectionsBand from './ElectionsBand.astro';
import UsMidtermsHomeCard from '../islands/UsMidtermsHomeCard.tsx';
import { usResultsHome, priorMajority } from '../data/us-results-context';

type Lang = 'en' | 'fr' | 'es';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (fr: string, en: string, es: string) => ({ fr, en, es }[lang]);

const T = {
  h1: L('Projections électorales indépendantes : États-Unis, Canada, Royaume-Uni, France, Espagne.', 'Independent election forecasts: United States, Canada, United Kingdom, France, Spain.', 'Proyecciones electorales independientes: Estados Unidos, Canadá, Reino Unido, Francia, España.'),
  promise: L(
    'Les midterms américains, le Canada, le Royaume-Uni, la France et l’Espagne, mis à jour chaque jour. Par Kim Leclerc, vingt ans de campagnes électorales.',
    'U.S. midterms, Canada, the U.K., France and Spain, updated daily. By Kim Leclerc, twenty years of election campaigns.',
    'Las elecciones intermedias de EE. UU., Canadá, el Reino Unido, Francia y España, actualizadas cada día. Por Kim Leclerc, veinte años de campañas electorales.'),
  senate: L('Résultats du Sénat', 'Senate results', 'Resultados del Senado'),
  house: L('Résultats de la Chambre', 'House results', 'Resultados de la Cámara'),
  gov: L('Gouverneurs', 'Governors', 'Gobernadores'),
  href: {
    senate: L('/fr/us/senat/', '/en/us/senate/', '/es/us/senate/'),
    house: L('/fr/us/chambre/', '/en/us/house/', '/es/us/house/'),
    gov: L('/fr/us/gouverneurs/', '/en/us/governors/', '/es/us/gobernadores/'),
  },
};
const usRes = usResultsHome(lang);
const usHome = lang === 'fr' ? '/fr/us/' : lang === 'es' ? '/es/us/' : '/en/us/';
---
<section class="home-front">
  <div class="container">
    <header class="hf-mast vs-page-head">
      <h1>{T.h1}</h1>
      <p class="hf-promise">{T.promise}</p>
    </header>

    <div class="hf-grid">
      <article class="hf-lead">
        <UsMidtermsHomeCard client:load lang={lang} initial={usRes.initial} ctx={usRes.ctx} urls={usRes.urls} colors={usRes.colors}
          before={{ house: priorMajority('house'), senate: priorMajority('senate') }} href={usHome} />
        <p class="hf-actions">
          <a class="vs-btn" href={`${T.href.senate}#resultats`}>{T.senate}</a>
          <a class="vs-btn-secondary" href={`${T.href.house}#resultats`}>{T.house}</a>
          <a class="vs-link" href={`${T.href.gov}#resultats`}>{T.gov}</a>
        </p>
      </article>
      <aside class="hf-side">
        <ElectionsBand lang={lang} compact exclude={['us-2026']} />
      </aside>
    </div>
  </div>
</section>

<style>
  .home-front { padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .hf-mast { padding: 34px 0 18px; border-bottom: 0 !important; }
  .hf-mast h1 { font-size: clamp(30px, 3.6vw, 44px) !important; margin-bottom: 8px !important; }
  .hf-promise { margin: 0; max-width: 760px; color: var(--ink-2); font-size: 17px; line-height: 1.5; }
  .hf-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 44px; padding-top: 22px; border-top: 3px solid var(--ink); }
  .hf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin: 18px 0 0; }
  @media (max-width: 900px) {
    .hf-grid { grid-template-columns: 1fr; gap: 28px; }
  }
  /* Téléphone : les résultats au premier écran (la présentation reste dans le titre du site). */
  @media (max-width: 640px) {
    .hf-promise { display: none; }
    .hf-mast { padding: 18px 0 10px; }
    .hf-grid { padding-top: 14px; }
  }
</style>
