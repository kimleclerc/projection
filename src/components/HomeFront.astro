---
/**
 * Une de l'accueil, commune aux trois langues (docs/DESIGN.md §7) :
 * une ligne de titre du site, puis l'élection principale du moment en grand
 * (les résultats des mi-mandats américains) et, en colonne, les autres
 * élections par date.
 */
import StoryList from './StoryList.astro';
import { latestFor } from '../lib/budget-data';
import { t as budgetText, answerOf, budgetEdition } from '../lib/budget';
import ElectionsBand from './ElectionsBand.astro';
import UsMidtermsHomeCard from '../islands/UsMidtermsHomeCard.tsx';
import { usResultsHome, priorMajority } from '../data/us-results-context';

type Lang = 'en' | 'fr' | 'es';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (fr: string, en: string, es: string) => ({ fr, en, es }[lang]);

const T = {
  h1: L('Sondages et projections électorales : États-Unis, Canada, Royaume-Uni, France, Espagne.', 'Election forecasts and polls: United States, Canada, United Kingdom, France, Spain.', 'Encuestas electorales y proyecciones: Estados Unidos, Canadá, Reino Unido, Francia, España.'),
  promise: L(
    'Projections indépendantes et moyennes de sondages : présidentielle américaine 2028, Canada, Royaume-Uni, présidentielle 2027, élections espagnoles du 29 novembre. Mises à jour chaque jour. Par Kim Leclerc, vingt ans de campagnes électorales.',
    'Independent forecasts and polling averages: the 2028 U.S. presidential race, Canada, the U.K., France 2027 and Spain’s November 29 election, updated daily. By Kim Leclerc, twenty years of election campaigns.',
    'Proyecciones independientes y promedios de encuestas: presidenciales de EE. UU. 2028, Canadá, Reino Unido, Francia 2027 y las elecciones generales del 29 de noviembre, actualizados cada día. Por Kim Leclerc, veinte años de campañas electorales.'),
  senate: L('Résultats du Sénat', 'Senate results', 'Resultados del Senado'),
  house: L('Résultats de la Chambre', 'House results', 'Resultados de la Cámara'),
  gov: L('Gouverneurs', 'Governors', 'Gobernadores'),
  href: {
    senate: L('/fr/us/senat/', '/en/us/senate/', '/es/us/senate/'),
    house: L('/fr/us/chambre/', '/en/us/house/', '/es/us/house/'),
    gov: L('/fr/us/gouverneurs/', '/en/us/governors/', '/es/us/gobernadores/'),
  },
};
const usRes = usResultsHome(lang);
// Le dernier budget fédéral reste en tête de la colonne pendant 30 jours après son dépôt.
const budget = latestFor('canada');
const budgetFresh = budget?.date_iso && (Date.now() - Date.parse(budget.date_iso)) / 86400000 <= 30;
const budgetItems = budget && budgetFresh ? [{ meta: budgetText(budget.date_tabled, lang), title: budgetText(budget.title, lang), text: answerOf(budget, lang), href: budgetEdition(lang, budget.slug, budget.edition), strong: true }] : [];
const usHome = lang === 'fr' ? '/fr/us/' : lang === 'es' ? '/es/us/' : '/en/us/';

// Comparer avec les autres modèles et les marchés : ceux qui cherchent 538, Silver
// Bulletin, The Economist, Kalshi ou Polymarket trouvent ici la confrontation.
const COMPARE = {
  title: L('Comparer avec les autres modèles', 'Compare with other forecasts', 'Comparar con otros modelos'),
  items: [
    { href: L('/fr/us/chambre/comparer-les-previsions/', '/en/us/house/compare-forecasts/', '/es/us/house/comparar-pronosticos/'), label: L('Chambre US : Vote-Scope face aux autres modèles', 'U.S. House: Vote-Scope vs other models', 'Cámara de EE. UU.: Vote-Scope frente a otros modelos') },
    { href: L('/fr/us/senat/comparer-les-previsions/', '/en/us/senate/compare-forecasts/', '/es/us/senate/comparar-pronosticos/'), label: L('Sénat US : face aux autres modèles', 'U.S. Senate: vs other models', 'Senado de EE. UU.: frente a otros modelos') },
    { href: L('/fr/us/gouverneurs/comparer-les-previsions/', '/en/us/governors/compare-forecasts/', '/es/us/gobernadores/comparar-pronosticos/'), label: L('Gouverneurs : face aux autres modèles', 'Governors: vs other models', 'Gobernadores: frente a otros modelos') },
    { href: L('/fr/spain/#comparar', '/en/spain/#comparar', '/es/spain/#comparar'), label: L('Espagne : face aux autres projections', 'Spain: vs other projections', 'España: frente a otras proyecciones') },
    { href: L('/fr/us/marches-previsionnels/', '/en/us/prediction-markets/', '/es/us/mercados-de-prediccion/'), label: L('Kalshi et Polymarket face à nos projections', 'Kalshi and Polymarket vs our forecasts', 'Kalshi y Polymarket frente a nuestras proyecciones') },
    { href: L('/fr/track-record/', '/en/track-record/', '/es/track-record/'), label: L('Notre bilan : appels réussis et ratés', 'Our track record: calls made and missed', 'Nuestro historial: aciertos y fallos') },
  ],
};
---
<section class="home-front">
  <div class="container">
    <header class="hf-mast vs-page-head">
      <h1>{T.h1}</h1>
      <p class="hf-promise">{T.promise}</p>
    </header>

    <div class="hf-grid">
      <article class="hf-lead">
        <UsMidtermsHomeCard client:load lang={lang} initial={usRes.initial} ctx={usRes.ctx} urls={usRes.urls} colors={usRes.colors}
          before={{ house: priorMajority('house'), senate: priorMajority('senate') }} href={usHome} />
        <p class="hf-actions">
          <a class="vs-btn" href={`${T.href.senate}#resultats`}>{T.senate}</a>
          <a class="vs-btn-secondary" href={`${T.href.house}#resultats`}>{T.house}</a>
          <a class="vs-link" href={`${T.href.gov}#resultats`}>{T.gov}</a>
        </p>
      </article>
      <aside class="hf-side">
        {budgetItems.length > 0 && <div class="hf-budget"><StoryList items={budgetItems} size="sm" /></div>}
        <ElectionsBand lang={lang} compact exclude={['us-2026']} />
        <nav class="hf-compare" aria-labelledby="hf-compare-title">
          <h2 id="hf-compare-title">{COMPARE.title}</h2>
          <ul>{COMPARE.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
        </nav>
      </aside>
    </div>
  </div>
</section>

<style>
  .home-front { padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .hf-mast { padding: 34px 0 18px; border-bottom: 0 !important; }
  .hf-mast h1 { font-size: clamp(30px, 3.6vw, 44px) !important; margin-bottom: 8px !important; }
  .hf-promise { margin: 0; max-width: 760px; color: var(--ink-2); font-size: 17px; line-height: 1.5; }
  .hf-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 44px; padding-top: 22px; border-top: 3px solid var(--ink); }
  .hf-budget { margin-bottom: 24px; }
  .hf-compare { margin-top: 26px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .hf-compare h2 { margin: 0 0 8px; font-family: var(--mono); font-size: 13px; font-weight: 600; letter-spacing: 0; color: var(--ink-2); text-transform: none; }
  .hf-compare ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .hf-compare a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; font-size: 15px; line-height: 1.35; }
  .hf-compare a:hover { text-decoration-color: var(--ink); }
  .hf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin: 18px 0 0; }
  @media (max-width: 900px) {
    .hf-grid { grid-template-columns: 1fr; gap: 28px; }
  }
  /* Téléphone : les résultats au premier écran (la présentation reste dans le titre du site). */
  @media (max-width: 640px) {
    .hf-promise { display: none; }
    .hf-mast { padding: 18px 0 10px; }
    .hf-grid { padding-top: 14px; }
  }
</style>
