const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.title,
    url: canonical,
    inLanguage: locale,
    dateModified: meta.run_date,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: t.whenLabel,
        acceptedAnswer: { '@type': 'Answer', text: t.whenAnswer },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${locale}/` },
      { '@type': 'ListItem', position: 2, name: locale === 'en' ? 'Spain' : locale === 'fr' ? 'Espagne' : 'España', item: canonical },
    ],
  },
];

const barTotal = 350;
---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={locale}
  currentPage="spain"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="es-desk" data-content-area>
    <header class="es-head">
      <div class="container">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.h1}</h1>

        <div class="es-when">
          <span class="es-when-label">{t.whenLabel}</span>
          <p>{t.whenAnswer} <a href="#fechas">{t.whenLink} →</a></p>
        </div>

        <p class="es-headline">{t.headline}</p>

        <div class="es-bar" role="img" aria-label={withSeats.map((k) => `${name(k)} ${nat[k].seats_median}`).join(', ')}>
          {withSeats.map((k) => (
            <div style={`width:${(nat[k].seats_median / barTotal) * 100}%;background:${color(k)};`} title={`${name(k)}: ${nat[k].seats_median}`} />
          ))}
          <span class="es-bar-majority" aria-hidden="true"></span>
        </div>
        <p class="es-bar-caption">{t.majority}</p>

        <div class="es-tiles">
          {top.map((k) => (
            <div class="es-tile" style={`--party-color:${color(k)}`}>
              <span class="es-tile-party">{name(k)}</span>
              <strong>{nat[k].seats_median}</strong>
              <span class="es-tile-sub">{t.seats} · {nat[k].seats_p10}–{nat[k].seats_p90}</span>
              <span class="es-tile-sub">{dec(nat[k].vote_mean)} % {t.vote} · {t.since2023(k)}</span>
            </div>
          ))}
        </div>
        <p class="es-updated">{t.updated}</p>
        <GooglePreferredSource locale={locale} />
      </div>
    </header>

    <section class="content-band">
      <div class="container es-two">
        <div class="note-card es-adelanto">
          <p class="eyebrow">{t.adelantoKicker}</p>
          <h2>{t.adelantoTitle}</h2>
          <dl>
            {t.adelantoRows.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd><strong>{r.value}</strong><span>{r.note}</span></dd>
              </div>
            ))}
          </dl>
          <p>{t.adelantoBody}</p>
        </div>
        <div class="note-card es-left">
          <p class="eyebrow">{t.leftKicker}</p>
          <h2>{t.leftTitle}</h2>
          <p>{t.leftBody}</p>
          <div class="es-left-compare">
            <div><span style={`background:${color('sumar')}`}></span>Sumar {nat.sumar.seats_median} + Podemos {nat.podemos.seats_median} = {leftDivided}</div>
            <div><span style={`background:${color('sumar')}`}></span>Sumar + Podemos = {united.sumar_podemos_seats_median} ({united.p10}–{united.p90})</div>
          </div>
        </div>
      </div>
    </section>

    <section class="content-band" id="fechas">
      <div class="container">
        <p class="eyebrow">{t.calendarKicker}</p>
        <h2 class="es-h2">{t.calendarTitle}</h2>
        <p class="es-lede">{t.calendarBody}</p>
        <table class="es-table es-cal">
          <thead><tr><th>{t.calBoe}</th><th>{t.calVote}</th></tr></thead>
          <tbody>
            {WINDOWS.map((w) => (
              <tr><td>{capFirst(longDate(w.boe))}</td><td><strong>{capFirst(longDate(w.vote))}</strong></td></tr>
            ))}
          </tbody>
        </table>
        <p class="es-lede">{t.cal2027}</p>
        <p class="es-lede"><strong>{t.calLimit}</strong></p>
      </div>
    </section>

    <section class="content-band">
      <div class="container">
        <p class="eyebrow">{t.provKicker}</p>
        <h2 class="es-h2">{t.provTitle}</h2>
        <p class="es-lede">{t.provBody}</p>
        <div class="es-contested">
          {contested.map((p) => (
            <div class="es-prov-card">
              <h3>{p.name} <span>{p.seats} {t.seats}</span></h3>
              <p class="es-chips">
                {Object.entries(p.modal)
                  .sort((a, b) => b[1] - a[1])
                  .map(([k, n]) => (
                    <span style={`--party-color:${color(k)}`}>{name(k)} {n}</span>
                  ))}
              </p>
              {p.swing.length > 0 && (
                <p class="es-swing">{t.provSwing} {p.swing.map((k) => `${name(k)} (${pct(p.parties[k].p_at_least_one)} %)`).join(', ')}</p>
              )}
            </div>
          ))}
        </div>

        <h3 class="es-h3">{t.provAllTitle}</h3>
        <div class="es-table-wrap">
          <table class="es-table">
            <thead><tr><th>{t.provCol}</th><th>{t.seatsCol}</th><th>{t.projCol}</th><th>{t.probCol}</th></tr></thead>
            <tbody>
              {provinceRows.map((p) => (
                <tr>
                  <td>{p.name}</td>
                  <td class="num">{p.seats}</td>
                  <td class="es-chips">
                    {Object.entries(p.modal)
                      .sort((a, b) => b[1] - a[1])
                      .map(([k, n]) => (
                        <span style={`--party-color:${color(k)}`}>{name(k)} {n}</span>
                      ))}
                  </td>
                  <td class="num">{pct(p.p_modal)} %</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="content-band">
      <div class="container">
        <div class="note-card es-track">
          <p class="eyebrow">{t.trackKicker}</p>
          <h2>{t.trackTitle}</h2>
          <p>{t.trackBody}</p>
          <p>{t.trackClacton}</p>
          {t.trackMore.map((x) => <p>{x}</p>)}
        </div>
      </div>
    </section>

    <MethodologyNote title={t.methodTitle} body={t.methodBody} bullets={t.methodBullets} />
  </article>
</EditorialLayout>

<style>
  .es-head {
    border-bottom: 1px solid var(--rule);
    background: linear-gradient(135deg, color-mix(in oklab, var(--paper) 90%, var(--blue-tint)), var(--paper));
    padding: 34px 0 26px;
  }
  .es-head h1 {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0.35rem 0 1rem;
    max-width: 22ch;
  }
  .es-when {
    max-width: 760px;
    border-left: 4px solid var(--blue);
    padding: 8px 0 8px 14px;
    margin-bottom: 18px;
  }
  .es-when-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .es-when p { margin: 4px 0 0; font-size: 16px; line-height: 1.5; }
  .es-headline {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    margin: 0 0 14px;
    max-width: 46ch;
  }
  .es-bar { position: relative; display: flex; height: 22px; border-radius: 3px; overflow: hidden; }
  .es-bar-majority {
    position: absolute;
    left: calc(176 / 350 * 100%);
    top: -4px;
    bottom: -4px;
    width: 2px;
    background: var(--ink);
  }
  .es-bar-caption { font-family: var(--mono); font-size: 11px; color: var(--ink-3); margin: 6px 0 0; padding-left: calc(176 / 350 * 100% - 40px); }
  .es-tiles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-top: 16px; }
  .es-tile {
    border: 1px solid var(--rule);
    border-top: 3px solid var(--party-color);
    border-radius: 4px;
    background: var(--card);
    padding: 10px 12px;
    display: grid;
    gap: 2px;
  }
  .es-tile-party { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-2); }
  .es-tile strong { font-family: var(--serif); font-size: 30px; font-weight: 430; line-height: 1.05; }
  .es-tile-sub { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); line-height: 1.4; }
  .es-updated { font-family: var(--mono); font-size: 11px; color: var(--ink-3); margin: 12px 0 0; }
  .es-two { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; }
  .es-adelanto h2, .es-left h2, .es-track h2 {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    line-height: 1.2;
    margin: 0.3rem 0 1rem;
  }
  .es-adelanto dl { margin: 0 0 1rem; }
  .es-adelanto dl > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 14px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule-2);
  }
  .es-adelanto dt { font-size: 14px; }
  .es-adelanto dd { margin: 0; text-align: right; display: grid; }
  .es-adelanto dd strong { font-family: var(--serif); font-size: 20px; font-weight: 450; }
  .es-adelanto dd span { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); }
  .es-left-compare { display: grid; gap: 8px; margin-top: 12px; font-family: var(--mono); font-size: 12px; }
  .es-left-compare span { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 7px; }
  .es-h2 { font-family: var(--serif); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.2; margin: 0.3rem 0 0.6rem; }
  .es-h3 { font-family: var(--serif); font-size: 1.3rem; margin: 2rem 0 0.6rem; }
  .es-lede { max-width: 70ch; color: var(--ink-2); line-height: 1.6; }
  .es-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .es-table th { text-align: left; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding: 8px 6px; border-bottom: 1px solid var(--rule); }
  .es-table td { padding: 8px 6px; border-bottom: 1px solid var(--rule-2); vertical-align: top; }
  .es-table td.num { font-family: var(--mono); }
  .es-cal { max-width: 560px; margin: 0.8rem 0 1rem; }
  .es-cal td, .es-cal td strong { text-transform: none; }
  .es-table-wrap { overflow-x: auto; }
  .es-chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; }
  .es-chips span {
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 2px 7px;
    border-radius: 3px;
    border-left: 3px solid var(--party-color);
    background: color-mix(in oklab, var(--party-color) 10%, var(--card));
  }
  .es-contested { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 1rem; }
  .es-prov-card { border: 1px solid var(--rule); border-radius: 5px; background: var(--card); padding: 14px; }
  .es-prov-card h3 { font-family: var(--serif); font-size: 1.15rem; margin: 0 0 8px; display: flex; justify-content: space-between; gap: 8px; }
  .es-prov-card h3 span { font-family: var(--mono); font-size: 11px; color: var(--ink-3); font-weight: 400; }
  .es-swing { font-size: 12.5px; color: var(--ink-2); margin: 10px 0 0; line-height: 1.45; }
  .es-track { max-width: 900px; border-left: 4px solid var(--blue); }
  @media (max-width: 900px) {
    .es-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .es-two { grid-template-columns: 1fr; }
    .es-contested { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .es-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .es-bar-caption { padding-left: 0; }
  }
</style>
