      { label: 'PSOE', value: `${psoe.seats_median} sièges`, note: `121 en 2023 · fourchette ${psoe.seats_p10}–${psoe.seats_p90}` },
      { label: 'Le bloc qui a investi Sánchez en 2023', value: `${blocs.investiture_2023.median} sièges`, note: `179 en 2023 · majorité dans ${pct(blocs.investiture_2023.p_majority)} simulations sur 100` },
      { label: 'PP + Vox', value: `${blocs.pp_vox.median} sièges`, note: `fourchette ${blocs.pp_vox.p10}–${blocs.pp_vox.p90} · majorité dans ${pct(blocs.pp_vox.p_majority)} sur 100` },
