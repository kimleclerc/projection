    since2023: (k: string) => k === 'sumar' ? '31 en 2023 avec Podemos' : `${nat[k].seats_2023 ? `${nat[k].seats_2023} en 2023` : 'nouveau'}`,
    adelantoKicker: 'Une élection anticipée avec les sondages contre lui',
    adelantoTitle: 'Sánchez dissout quand les chiffres lui sont défavorables.',
