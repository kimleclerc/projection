---
// Desk Espagne — élections générales (Congreso, 350 sièges, D'Hondt par
// province). Même patron que UkDesk/FranceDesk : un composant, locale en prop.
// Les chiffres clés tiennent dans le premier enfant de [data-content-area]
// (règle « chiffres d'abord ») ; le reste suit en sections.
import ResultsTable from './ResultsTable.astro';
import EditorialLayout from '../layouts/EditorialLayout.astro';
import MethodologyNote from './MethodologyNote.astro';
import GooglePreferredSource from './GooglePreferredSource.astro';
import JurisdictionNav from './JurisdictionNav.astro';
import DeskSections from './DeskSections.astro';
import { partyMeta } from '../lib/riding-adapters/parties';
import { CURRENT_RELEASE } from '../data/modelVersion';
import es from '../../web_data/spain/latest.json';

type Locale = 'en' | 'fr' | 'es';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const data = es as any;
const meta = data.meta;
const nat = data.national as Record<string, any>;
const blocs = data.blocs;
const provinces = data.provinces as Record<string, any>;
const united = data.scenarios.united_left;
const clacton = data.track_record.clacton_2026;
const football = data.track_record.football_2026;

// Palette commune du site (src/lib/riding-adapters/parties.ts, clé « spain »).
const name = (k: string) => partyMeta('spain', k).label_en;
const color = (k: string) => partyMeta('spain', k).color;

const order = Object.keys(nat).sort((a, b) => nat[b].seats_median - nat[a].seats_median || nat[b].vote_mean - nat[a].vote_mean);
// La barre range PP et Vox côte à côte, depuis la gauche : on voit d'un
// coup d'œil s'ils franchissent la ligne des 176.
const BAR_ORDER = ['pp', 'vox', 'upn', 'salf', 'cc', 'pnv', 'junts', 'alianca_cat', 'bng', 'bildu', 'erc', 'cup', 'adelante_andalucia', 'podemos', 'sumar', 'psoe'];
const withSeats = [...BAR_ORDER.filter((k) => nat[k]), ...order.filter((k) => !BAR_ORDER.includes(k))].filter((k) => nat[k].seats_median > 0);

const dec = (v: number, d = 1) => (locale === 'en' ? v.toFixed(d) : v.toFixed(d).replace('.', ','));
const pct = (p: number) => {
  const v = p * 100;
  if (v > 99) return locale === 'en' ? '>99' : '>99';
  if (v < 1) return '<1';
  return String(Math.round(v));
};

// Dans une phrase : « más de 99 », pas « >99 ».
const pctW = (p: number) => {
  const v = pct(p);
  const more = { es: 'más de', fr: 'plus de', en: 'more than' }[locale];
  const less = { es: 'menos de', fr: 'moins de', en: 'fewer than' }[locale];
  return v === '>99' ? `${more} 99` : v === '<1' ? `${less} 1` : v;
};

const runDate = new Date(`${meta.run_date}T12:00:00`).toLocaleDateString(
  locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'es-ES',
  { day: 'numeric', month: 'long', year: 'numeric' },
);

const psoe = nat.psoe;
const leftDivided = united.divided_seats_median;
const leftGain = united.sumar_podemos_seats_median - leftDivided;

// Fenêtres de vote : le scrutin a lieu 54 jours après la publication du
// décret de dissolution au BOE (LOREG, art. 42).
// Calendrier légal (LOREG) à partir du décret publié au BOE le 6 octobre
// 2026 ; recoupé avec 2023 (décret du 30 mai → campagne du 7 juillet).
const CALENDAR: { date: string; step: Record<Locale, string> }[] = [
  { date: '2026-10-06', step: { es: 'Publicación del decreto de disolución en el BOE', fr: 'Publication du décret de dissolution au BOE', en: 'Dissolution decree published in the BOE' } },
  { date: '2026-10-16', step: { es: 'Último día para inscribir coaliciones', fr: 'Dernier jour pour inscrire les coalitions', en: 'Last day to register coalitions' } },
  { date: '2026-10-26', step: { es: 'Fin de la presentación de candidaturas (desde el 21 de octubre)', fr: 'Fin du dépôt des candidatures (depuis le 21 octobre)', en: 'Candidate lists close (open from October 21)' } },
  { date: '2026-11-02', step: { es: 'Proclamación de las candidaturas', fr: 'Proclamation des candidatures', en: 'Candidate lists proclaimed' } },
  { date: '2026-11-13', step: { es: 'Arranca la campaña (hasta el 27 de noviembre)', fr: 'Début de la campagne (jusqu’au 27 novembre)', en: 'Campaign opens (until November 27)' } },
  { date: '2026-11-24', step: { es: 'Desde este día está prohibido publicar encuestas en España', fr: 'Publication de sondages interdite en Espagne à partir de ce jour', en: 'Publishing polls in Spain is banned from this day' } },
  { date: '2026-11-28', step: { es: 'Jornada de reflexión', fr: 'Jour de réflexion', en: 'Day of reflection' } },
  { date: '2026-11-29', step: { es: 'Día de la votación', fr: 'Jour du vote', en: 'Polling day' } },
];
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'es-ES', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
const capFirst = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);

// Provinces où un siège se joue : au moins un parti entre 25 % et 75 %
// de chances d'en avoir un, ou un parti dont le siège médian est fragile.
const contested = Object.entries(provinces)
  .map(([code, p]) => {
    const swing = Object.entries(p.parties as Record<string, any>)
      .filter(([, v]) => v.p_at_least_one > 0.2 && v.p_at_least_one < 0.8)
      .map(([k]) => k);
    const frac = Object.values(p.parties as Record<string, any>).reduce(
      (acc: number, v: any) => acc + Math.min(Math.abs(v.seats_mean - Math.round(v.seats_mean)), 0.5),
      0,
    );
    return { code, ...p, swing, frac };
  })
  .sort((a, b) => b.frac - a.frac)
  .slice(0, 12);

const provinceRows = Object.entries(provinces)
  .map(([code, p]) => ({ code, ...p }))
  .sort((a: any, b: any) => b.seats - a.seats || a.name.localeCompare(b.name, 'es'));

// ── Traqueur logement ────────────────────────────────────────────────
const viv = data.vivienda;
const vSeries = viv.series as { d: string; v: number }[];
const CH = { w: 760, h: 260, l: 38, r: 64, t: 16, b: 30 };
const tMin = Date.parse('2015-01-01');
const tMax = Date.parse('2026-12-31');
const yMax = 50;
const vx = (iso: string) => CH.l + ((Date.parse(iso) - tMin) / (tMax - tMin)) * (CH.w - CH.l - CH.r);
const vy = (v: number) => CH.t + (1 - v / yMax) * (CH.h - CH.t - CH.b);
const vPath = vSeries.map((p, i) => `${i ? 'L' : 'M'}${vx(p.d).toFixed(1)},${vy(p.v).toFixed(1)}`).join(' ');
const vArea = `${vPath} L${vx(vSeries[vSeries.length - 1].d).toFixed(1)},${vy(0)} L${vx(vSeries[0].d).toFixed(1)},${vy(0)} Z`;
const vLast = vSeries[vSeries.length - 1];
const vYears = [2015, 2017, 2019, 2021, 2023, 2025];
const vDecree = vx('2026-10-02');
const TOPIC: Record<string, Record<Locale, string>> = {
  vivienda: { es: 'Vivienda', fr: 'Logement', en: 'Housing' },
  economia: { es: 'Economía', fr: 'Économie', en: 'Economy' },
  inmigracion: { es: 'Inmigración', fr: 'Immigration', en: 'Immigration' },
  politicos: { es: 'Los políticos', fr: 'Les politiciens', en: 'Politicians' },
  paro: { es: 'Paro', fr: 'Chômage', en: 'Unemployment' },
  sanidad: { es: 'Sanidad', fr: 'Santé', en: 'Health care' },
  corrupcion: { es: 'Corrupción', fr: 'Corruption', en: 'Corruption' },
};
const topics = viv.topics as { problem_id: string; pct: number }[];
const topicMax = Math.max(...topics.map((x) => x.pct));
const trustPolls = viv.trust as { firm: string; field_end: string; source_url: string; options: Record<string, number> }[];
const trustFirst = trustPolls[0];
const trustLast = trustPolls[trustPolls.length - 1];
const TRUST_ROWS = ['psoe', 'pp', 'vox', 'sumar', 'podemos', 'ninguno'];
const trustName = (k: string) =>
  k === 'ninguno' ? (locale === 'es' ? 'Ninguno' : locale === 'fr' ? 'Aucun' : 'None') : name(k);
const delta = (k: string) => {
  const a = trustFirst.options[k];
  const b = trustLast.options[k];
  return a == null || b == null ? null : b - a;
};
const monthYear = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'es-ES', {
    month: 'long',
    year: 'numeric',
  });
const viv2022 = viv.yearly['2022'];
const viv2026 = viv.yearly['2026'];
const vivPoints = (x: number) => dec(Math.abs(x));


// ── Orbite (bêta) et mélange 50/50 ──────────────────────────────────
const orbit = data.orbit;
const blend = data.blend;
const orbitBt = data.orbit_backtest;
const MODEL_ROWS = ['pp', 'psoe', 'vox', 'sumar', 'podemos', 'erc', 'bildu', 'junts', 'pnv', 'salf'];
const orbitAgrees = (orbit.blocs.pp_vox.p_majority >= 0.5) === (blocs.pp_vox.p_majority >= 0.5);
const simHref = { es: '/es/herramientas/simulador-espana', fr: '/fr/outils/simulateur-espagne', en: '/en/tools/spain-simulator' }[locale];
const simLabel = { es: 'Calcula tu propio escenario con el simulador D’Hondt', fr: 'Calculez votre propre scénario avec le simulateur D’Hondt', en: 'Build your own scenario with the D’Hondt simulator' }[locale];
const labsHref = `/${locale}/labs/${locale === 'es' ? 'como-funciona' : locale === 'fr' ? 'comment-ca-marche' : 'how-it-works'}`;


// ── Comparaison avec les autres projections (lignes vérifiées seulement) ──
const others = (data.comparisons ?? []) as any[];
const cmpRows = [
  { name: `Vote-Scope · ${CURRENT_RELEASE.name}`, href: null, date: meta.run_date, pp: nat.pp.seats_median, psoe: nat.psoe.seats_median, vox: nat.vox.seats_median, pp_vox: blocs.pp_vox.median, p: blocs.pp_vox.p_majority, own: true },
  { name: 'Orbite (beta)', href: labsHref, date: meta.run_date, pp: orbit.national.pp.seats_median, psoe: orbit.national.psoe.seats_median, vox: orbit.national.vox.seats_median, pp_vox: orbit.blocs.pp_vox.median, p: orbit.blocs.pp_vox.p_majority, own: true },
  ...others.map((o) => ({ name: o.name, href: o.url, date: o.date, pp: o.pp, psoe: o.psoe, vox: o.vox, pp_vox: o.pp_vox, p: o.p_majority, own: false })),
];
const shortDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'es-ES', { day: 'numeric', month: 'short' });


// Période d'interdiction des sondages en Espagne (LOREG, art. 69.7 : cinq
// jours avant le vote). Vote-Scope est publié depuis le Canada et continue sa
// projection ; la note s'affiche seulement pendant la période (date du build,
// la nuit reconstruit le site chaque jour).
const today = new Date().toISOString().slice(0, 10);
const inBlackout = today >= '2026-11-24' && today <= '2026-11-29';
const blackoutNote = {
  es: 'Vote-Scope se publica desde Canadá. La ley electoral española prohíbe a los medios sujetos a ella publicar encuestas en los cinco días previos a la votación; nuestra proyección sigue actualizándose hasta el 29 de noviembre.',
  fr: 'Vote-Scope est publié depuis le Canada. La loi électorale espagnole interdit aux médias qui y sont soumis de publier des sondages dans les cinq jours précédant le vote ; notre projection continue d’être mise à jour jusqu’au 29 novembre.',
  en: 'Vote-Scope is published from Canada. Spanish electoral law bars media subject to it from publishing polls in the five days before the vote; our projection keeps updating through November 29.',
}[locale];

