    whenLabel: 'When is the next Spanish election?',
    whenAnswer: 'Sunday, November 29, 2026. Pedro Sánchez announced the dissolution of the Cortes on October 5; the decree is published in the official gazette (BOE) on October 6.',
    whenLink: 'Election calendar',
    headline: `On today's polls, PP and Vox win an outright majority in ${pctW(blocs.pp_vox.p_majority)} of 100 simulations.`,
    seats: 'seats',
    vote: 'of the vote',
    range: 'likely range',
    majority: 'Majority: 176',
    updated: `Updated ${runDate} · latest poll ${meta.last_poll_field_end}`,
    since2023: (k: string) => k === 'sumar' ? '31 in 2023 with Podemos' : `${nat[k].seats_2023 ? `${nat[k].seats_2023} in 2023` : 'new'}`,
    adelantoKicker: 'A snap election against the polls',
    adelantoTitle: 'Sánchez goes to the country with the numbers against him.',
    adelantoRows: [
      { label: 'PSOE', value: `${psoe.seats_median} seats`, note: `121 in 2023 · range ${psoe.seats_p10}–${psoe.seats_p90}` },
      { label: 'The bloc that re-elected Sánchez in 2023', value: `${blocs.investiture_2023.median} seats`, note: `179 in 2023 · majority in ${pctW(blocs.investiture_2023.p_majority)} of 100 simulations` },
      { label: 'PP + Vox', value: `${blocs.pp_vox.median} seats`, note: `range ${blocs.pp_vox.p10}–${blocs.pp_vox.p90} · majority in ${pctW(blocs.pp_vox.p_majority)} of 100` },
      { label: 'PP alone', value: `${nat.pp.seats_median} seats`, note: `outright majority in ${pctW(blocs.pp_alone.p_majority)} of 100` },
    ],
    adelantoBody: `On today's polls, the PSOE would lose about ${121 - psoe.seats_median} seats and the majority that re-elected him in 2023 would be out of reach. The campaign opens on November 13: the last chance to move these numbers.`,
    leftKicker: 'The split left of the PSOE',
    leftTitle: `Running apart, Sumar and Podemos win ${leftDivided} seats. Together, on the same votes, they would win ${united.sumar_podemos_seats_median}.`,
    leftBody: `D'Hondt punishes mid-sized parties that split in small provinces. The gap (${leftGain} seats) is bigger than most groups in Congress.`,
    vivKicker: 'Housing · the issue behind the snap election',
    vivTitle: `Housing went from ${dec(viv2022)}% in 2022 to ${dec(viv2026)}% in 2026: it is now what worries Spaniards most.`,
    vivLede: `Share of Spaniards naming housing among the country’s top three problems, CIS barometer month by month. In ${monthYear(viv.latest.field_end)}: ${dec(viv.latest.pct_multi)}%, ahead of the economy and immigration. ${dec(viv.latest.pct_personal)}% say it affects them personally.`,
    vivChartLabel: 'Names housing among Spain’s main problems (%)',
    vivDecree: 'Dashed line: October 2, 2026, Congress votes down the housing decrees.',
    vivTopicsTitle: `What worries Spaniards most (CIS, ${monthYear(viv.latest.field_end)})`,
    vivTrustTitle: 'Which party would handle housing best?',
    vivTrustFirm: `40dB for El País and SER`,
    vivTrustBody: `Nobody convinces: “none” is the most common answer (${dec(trustLast.options.ninguno)}%). The PSOE still leads (${dec(trustLast.options.psoe)}%) but is down ${vivPoints(delta('psoe') ?? 0)} points since January 2025; the PP is down ${vivPoints(delta('pp') ?? 0)} and Vox holds (${dec(trustLast.options.vox)}%). So far the crisis has no clear winner.`,
    vivNotPublished: 'not published',
    vivTable: 'See the data by year',
    vivYear: 'Year',
    vivAvg: 'Average',
    vivSource: 'Source: CIS monthly barometers (multiple-answer question: up to three problems).',
    orbKicker: 'Second model · Orbit (beta)',
    orbTitle: orbitAgrees
      ? `Orbit, our experimental model, reaches the same conclusion: PP and Vox win a majority in ${pctW(orbit.blocs.pp_vox.p_majority)} of 100 simulations.`
      : `Orbit, our experimental model, reaches a different conclusion: PP and Vox win a majority in ${pctW(orbit.blocs.pp_vox.p_majority)} of 100 simulations.`,
    orbBody: `Orbit uses the same polls with different mathematics: it treats opinion as a position moving on a sphere rather than as an average. It is still in beta: we publish it for comparison, and a 50/50 mix with our main model, ${CURRENT_RELEASE.name}, gives a third reading. On eve-of-election polls, Orbit would have misplaced ${orbitBt.es_2023.seats_misplaced} seats in 2023 and ${orbitBt.es_2019n.seats_misplaced} in November 2019.`,
    orbParty: 'Party',
    orbMain: CURRENT_RELEASE.name,
    orbOrbit: 'Orbit (beta)',
    orbBlend: '50/50 mix',
    orbMajority: 'PP + Vox majority',
    orbHow: 'How Orbit works',
    cmpKicker: 'How we compare',
    cmpTitle: 'The other forecasts reach the same sum: PP and Vox above 176.',
    cmpBody: 'We only publish figures checked at the original source, with their date and link. A probability only appears when the source computes one.',
    cmpSource: 'Source',
    cmpDate: 'Date',
    cmpP: 'PP+Vox majority odds',
    calendarKicker: 'Election calendar',
    calendarTitle: 'Key dates up to November 29',
    calendarBody: 'Dates set by electoral law from the publication of the decree in the official gazette.',
    calBoe: 'Date',
    calVote: 'Step',
    provKicker: 'Province by province',
    provTitle: 'Where the last seat is decided',
    provBody: 'In these provinces the last seat changes hands on a handful of votes. That is where the majority is won.',
    provSwing: 'Seat in play for',
    provAllTitle: 'All 52 constituencies',
    provCol: 'Province',
    seatsCol: 'Seats',
    projCol: 'Most likely split',
    probCol: 'Chance',
    trackKicker: 'Why trust it',
    trackTitle: 'Tested on past elections before going live.',
    trackBody: `Using eve-of-election polls, this method would have misplaced ${meta.backtest.es_2023.seats_misplaced} of 350 seats in 2023 and ${meta.backtest.es_2019n.seats_misplaced} in November 2019. The real result landed inside our ranges ${Math.round(meta.backtest.es_2023.inside90 * 100)} times out of 100.`,
    trackClacton: `In the Clacton by-election (U.K., August 13, 2026) we projected Nigel Farage at ${dec(clacton.farage_projected_median)}%: he won ${dec(clacton.farage_actual)}%, with Count Binface second, as forecast.`,
    trackMore: [
      'We were among the first models to flag that Texas could tip toward the Democrats.',
      `Before the 2026 international football tournament, our model had Spain as title favourite (1st of ${football.n_teams} teams). Spain won the final.`,
    ],
    methodTitle: 'How it works',
    methodBody: 'A polling average, carried into every province and allocated under the real electoral law, thousands of times.',
    methodBullets: [
      'Published polls go through a Bayesian time-series model (BSTS), the same one behind all our forecasts, after correcting each pollster for its measured lean. Third-party re-estimates of CIS data are left out.',
      'The national vote is carried into each province from the 2023 general election. New parties start from their latest result: SALF from the 2024 European election, Aliança Catalana and Adelante Andalucía from their regional elections.',
      `Each simulation adds the real error of Spanish polls (measured 2015–2023), a regional effect and a provincial effect, then allocates seats under D'Hondt with the 3% threshold. ${meta.n_draws.toLocaleString('en-GB')} simulations.`,
      `Polling day: ${longDate(meta.election_day_assumed)}. Seats per province are computed from INE population until the official BOE allocation is published.`,
    ],
  },
}[locale];
// Accord en français : « moins de 1 simulations » → « moins d'une simulation ».
const frFix = (x: any): any =>
  typeof x === 'string'
    ? x.replace(/moins de 1 simulations sur 100/g, "moins d'une simulation sur 100").replace(/moins de 1 sur 100/g, "moins d'une sur 100")
    : Array.isArray(x)
      ? x.map(frFix)
      : x && typeof x === 'object' && typeof x !== 'function'
        ? Object.fromEntries(Object.entries(x).map(([k, v]) => [k, frFix(v)]))
        : x;
const t = locale === 'fr' ? frFix(copy) : copy;

const canonical = `https://vote-scope.com/${locale}/spain/`;
const alternates = {
  en: 'https://vote-scope.com/en/spain/',
  fr: 'https://vote-scope.com/fr/spain/',
  es: 'https://vote-scope.com/es/spain/',
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.title,
    url: canonical,
    inLanguage: locale,
    dateModified: meta.run_date,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: t.whenLabel,
        acceptedAnswer: { '@type': 'Answer', text: t.whenAnswer },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${locale}/` },
      { '@type': 'ListItem', position: 2, name: locale === 'en' ? 'Spain' : locale === 'fr' ? 'Espagne' : 'España', item: canonical },
    ],
  },
];



---

<EditorialLayout
  title={t.title}
  description={t.description}
  canonical={canonical}
  lang={locale}
  currentPage="spain"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <JurisdictionNav webKey="spain" lang={locale} active="projection" />
  <article class="es-desk" data-content-area>
    <header class="es-head vs-page-head">
      <div class="container">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.h1}</h1>

        <div class="es-when">
          <span class="es-when-label">{t.whenLabel}</span>
          <p>{t.whenAnswer} <a href="#fechas">{t.whenLink}</a></p>
        </div>

        {inBlackout && <p class="es-blackout">{blackoutNote}</p>}
        <p class="es-headline">{t.headline}</p>

        <ResultsTable
          lang={locale}
          rows={withSeats.map((k) => ({ label: name(k), color: color(k), seats: nat[k].seats_median, low: nat[k].seats_p10, high: nat[k].seats_p90, chance: nat[k].vote_mean / 100 }))}
          totalSeats={350}
          majority={176}
          chanceKind="vote"
          limit={6}
        />
        <p class="es-sim-link"><a class="cta-link" href={simHref}>{simLabel}</a></p>
        <p class="es-updated">{t.updated}</p>
        <GooglePreferredSource locale={locale} />
      </div>
    </header>

    <section class="content-band">
      <div class="container es-two">
        <div class="note-card es-adelanto">
          <p class="eyebrow">{t.adelantoKicker}</p>
          <h2>{t.adelantoTitle}</h2>
          <dl>
            {t.adelantoRows.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd><strong>{r.value}</strong><span>{r.note}</span></dd>
              </div>
            ))}
          </dl>
          <p>{t.adelantoBody}</p>
        </div>
        <div class="note-card es-left">
          <p class="eyebrow">{t.leftKicker}</p>
          <h2>{t.leftTitle}</h2>
          <p>{t.leftBody}</p>
          <div class="es-left-compare">
            <div><span style={`background:${color('sumar')}`}></span>Sumar {nat.sumar.seats_median} + Podemos {nat.podemos.seats_median} = {leftDivided}</div>
            <div><span style={`background:${color('sumar')}`}></span>Sumar + Podemos = {united.sumar_podemos_seats_median} ({united.p10}–{united.p90})</div>
          </div>
        </div>
      </div>
    </section>

    <section class="content-band es-viv" id="vivienda">
      <div class="container">
        <p class="eyebrow">{t.vivKicker}</p>
        <h2 class="es-h2">{t.vivTitle}</h2>
        <p class="es-lede">{t.vivLede}</p>
        <figure class="es-viv-chart" data-locale={locale}>
          <figcaption>{t.vivChartLabel}</figcaption>
          <div class="es-viv-plot">
            <svg viewBox={`0 0 ${CH.w} ${CH.h}`} role="img" aria-label={`${t.vivChartLabel}: ${dec(vSeries[0].v)} % (${monthYear(vSeries[0].d)}) → ${dec(vLast.v)} % (${monthYear(vLast.d)})`}>
              {[0, 10, 20, 30, 40, 50].map((g) => (
                <g>
                  <line x1={CH.l} x2={CH.w - CH.r} y1={vy(g)} y2={vy(g)} class={g === 0 ? 'es-axis' : 'es-grid'} />
                  <text x={CH.l - 8} y={vy(g) + 4} class="es-tick" text-anchor="end">{g}</text>
                </g>
              ))}
              {vYears.map((y) => (
                <text x={vx(`${y}-01-01`)} y={CH.h - 8} class="es-tick" text-anchor="middle">{y}</text>
              ))}
              <line x1={vDecree} x2={vDecree} y1={CH.t} y2={vy(0)} class="es-event" />
              <path d={vArea} class="es-viv-area" />
              <path d={vPath} class="es-viv-line" />
              <circle cx={vx(vLast.d)} cy={vy(vLast.v)} r="4.5" class="es-viv-end" />
              <text x={vx(vLast.d) + 9} y={vy(vLast.v) + 4} class="es-viv-endlabel">{dec(vLast.v)} %</text>
              <line class="es-viv-cross" x1="0" x2="0" y1={CH.t} y2={vy(0)} visibility="hidden" />
              <circle class="es-viv-dot" r="5" cx="0" cy="0" visibility="hidden" />
              <rect class="es-viv-hit" x={CH.l} y={CH.t} width={CH.w - CH.l - CH.r} height={CH.h - CH.t - CH.b} />
            </svg>
            <div class="es-viv-tip" hidden></div>
            <script type="application/json" class="es-viv-data" set:html={JSON.stringify(vSeries.map((p) => [p.d, p.v, vx(p.d), vy(p.v)]))} />
          </div>
          <p class="es-source"><span class="es-dash" aria-hidden="true"></span>{t.vivDecree}</p>
          <details class="es-viv-table">
            <summary>{t.vivTable}</summary>
            <table class="es-table">
              <thead><tr><th>{t.vivYear}</th><th>{t.vivAvg}</th></tr></thead>
              <tbody>
                {Object.entries(viv.yearly).map(([y, v]) => (
                  <tr><td>{y}</td><td class="num">{dec(v as number)} %</td></tr>
                ))}
              </tbody>
            </table>
          </details>
          <p class="es-source">{t.vivSource} <a href={viv.latest.source_url} rel="noopener">CIS {viv.latest.study_id}</a></p>
        </figure>

        <div class="es-two es-viv-two">
          <div class="note-card">
            <h3 class="es-h3 es-h3-tight">{t.vivTopicsTitle}</h3>
            <ul class="es-topics">
              {topics.map((x) => (
                <li class={x.problem_id === 'vivienda' ? 'is-viv' : ''}>
                  <span class="es-topic-name">{TOPIC[x.problem_id]?.[locale] ?? x.problem_id}</span>
                  <span class="es-topic-bar"><i style={`width:${(x.pct / topicMax) * 100}%`}></i></span>
                  <span class="es-topic-val">{dec(x.pct)} %</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="note-card">
            <h3 class="es-h3 es-h3-tight">{t.vivTrustTitle}</h3>
            <table class="es-table es-trust">
              <thead>
                <tr><th></th><th>{monthYear(trustFirst.field_end)}</th><th>{monthYear(trustLast.field_end)}</th></tr>
              </thead>
              <tbody>
                {TRUST_ROWS.map((k) => (
                  <tr>
                    <td><i class="es-swatch" style={`background:${k === 'ninguno' ? 'var(--ink-3)' : color(k)}`}></i>{trustName(k)}</td>
                    <td class="num">{trustFirst.options[k] != null ? `${dec(trustFirst.options[k])} %` : t.vivNotPublished}</td>
