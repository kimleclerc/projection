  en: {
    title: `Spain Election, November 29: Polls & Seat Projection — PP ${nat.pp.seats_median}, PSOE ${psoe.seats_median}, Vox ${nat.vox.seats_median} — Vote-Scope`,
    description: `Spain election polls and a projection of all 350 seats, province by province: PP ${nat.pp.seats_median}, PSOE ${psoe.seats_median}, Vox ${nat.vox.seats_median}. Polling day: November 29.`,
