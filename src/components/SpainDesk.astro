    provBody: 'En estas provincias, el último escaño cambia de manos con pocos votos. Ahí se juega la mayoría.',
    provSwing: 'Escaño en juego para',
    provAllTitle: 'Las 52 circunscripciones',
    provCol: 'Provincia',
    seatsCol: 'Escaños',
