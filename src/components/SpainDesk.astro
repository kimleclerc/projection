    since2023: (k: string) => k === 'sumar' ? '31 en 2023 con Podemos' : `${nat[k].seats_2023 ? `${nat[k].seats_2023} en 2023` : 'nuevo'}`,
    adelantoKicker: 'Un adelanto con las encuestas en contra',
    adelantoTitle: 'Sánchez convoca cuando los números le son desfavorables.',
    adelantoRows: [
      { label: 'PSOE', value: `${psoe.seats_median} escaños`, note: `121 en 2023 · rango ${psoe.seats_p10}–${psoe.seats_p90}` },
      { label: 'Bloque que invistió a Sánchez en 2023', value: `${blocs.investiture_2023.median} escaños`, note: `179 en 2023 · mayoría en ${pctW(blocs.investiture_2023.p_majority)} de cada 100 simulaciones` },
      { label: 'PP + Vox', value: `${blocs.pp_vox.median} escaños`, note: `rango ${blocs.pp_vox.p10}–${blocs.pp_vox.p90} · mayoría en ${pctW(blocs.pp_vox.p_majority)} de cada 100` },
      { label: 'PP solo', value: `${nat.pp.seats_median} escaños`, note: `mayoría absoluta en ${pctW(blocs.pp_alone.p_majority)} de cada 100` },
    ],
    adelantoBody: `Con las encuestas de hoy, el PSOE perdería unos ${121 - psoe.seats_median} escaños y la mayoría que lo invistió en 2023 quedaría lejos. La campaña empieza el 13 de noviembre: es la última oportunidad de mover estos números.`,
