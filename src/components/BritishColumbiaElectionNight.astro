  .qen-majority-label { margin-top: 8px; font-family: var(--mono); font-size: 13px; letter-spacing: 0; color: var(--ink-3); }
  .qen-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 18px; }
