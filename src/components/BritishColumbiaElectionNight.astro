  .qen-method { padding: 56px 0; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .qen-thresholds { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .qen-thresholds li { padding: 20px; border: 0; border-top: 1px solid var(--rule); border-radius: 0; background: transparent; }
  .qen-thresholds strong { display: block; font-family: var(--mono); font-size: 28px; font-weight: 500; color: var(--ink); margin-bottom: 8px; }
  .qen-thresholds p { font-size: 14px; line-height: 1.6; color: var(--ink-2); }

  .qen-projection { padding: 56px 0; background: var(--paper-2); border-bottom: 1px solid var(--rule); }
