---
/**
 * Universal riding page — used by every jurisdiction (CA federal, QC, ON, US, UK, FR).
 * Sections render conditionally based on data presence, so as new fields land in
 * adapters (candidates, polls, demographics, byelection flag…) they light up across
 * all ~600 pages automatically. Edit this file → every riding page rebuilds.
 */
import type { RidingData } from '../../lib/riding-adapters/types';
import { getNavEntryForRiding } from '../../lib/jurisdiction-nav';
import JurisdictionNav from '../JurisdictionNav.astro';
import OnThisPage from '../OnThisPage.astro';
import Hero from './sections/Hero.astro';
import RidingQuestion from './sections/RidingQuestion.astro';
import PrimaryStatus from './sections/PrimaryStatus.astro';
import RedistrictingImpact from './sections/RedistrictingImpact.astro';
import ProjectionPanel from './sections/ProjectionPanel.astro';
import ByelectionForecast from './sections/ByelectionForecast.astro';
import VoteBars from './sections/VoteBars.astro';
import HistoryTimeline from './sections/HistoryTimeline.astro';
import Demographics from './sections/Demographics.astro';
import EditorialBlurb from './sections/EditorialBlurb.astro';
import DataFreshness from './sections/DataFreshness.astro';
import CurrentMember from './sections/CurrentMember.astro';
import CandidatesTable from './sections/CandidatesTable.astro';
import CandidateSlate from './sections/CandidateSlate.astro';
import ProjectionHistory from './sections/ProjectionHistory.astro';
import RegionalContext from './sections/RegionalContext.astro';
import NeighborRidings from './sections/NeighborRidings.astro';
import LocalPolls from './sections/LocalPolls.astro';
import PolymarketEmbed from '../PolymarketEmbed.astro';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const navWebKey = data.navWebKey ?? getNavEntryForRiding(data.jurisdiction)?.webKey;
const pageNavItems = [
  {
    href: '#projection',
    label: { en: 'Projection', fr: 'Projection', es: 'Proyección' }[lang],
  },
  {
    href: '#vote-share',
    label: { en: 'Vote share', fr: 'Intentions de vote', es: 'Intención de voto' }[lang],
  },
  ...(data.polls?.length ? [{
    href: '#local-polls',
    label: { en: 'Local polls', fr: 'Sondages locaux', es: 'Sondeos locales' }[lang],
  }] : []),
  ...(data.baseline ? [{
    href: '#history',
    label: { en: 'Election history', fr: 'Historique électoral', es: 'Historial electoral' }[lang],
  }] : []),
  ...(data.neighbors?.length ? [{
    href: '#nearby',
    // Une course de gouverneur n'a pas de circonscription voisine : le bloc
    // montre les autres courses de la carte (cf. NeighborRidings.astro).
    label: data.jurisdiction === 'us-governor'
      ? { en: 'Other races', fr: 'Autres courses', es: 'Otras contiendas' }[lang]
      : { en: 'Nearby districts', fr: 'Circonscriptions voisines', es: 'Distritos cercanos' }[lang],
  }] : []),
];
---

{navWebKey && <JurisdictionNav webKey={navWebKey} lang={lang} active="districts" />}
<Hero data={data} lang={lang} />
<RidingQuestion data={data} lang={lang} />
<OnThisPage locale={lang} items={pageNavItems} />
<slot name="local-feature" />
{data.byelection && <ByelectionForecast data={data} lang={lang} />}
<div id="projection" class="riding-anchor"><ProjectionPanel data={data} lang={lang} /></div>
<div id="vote-share" class="riding-anchor"><VoteBars data={data} lang={lang} /></div>
{data.regionalContext && <RegionalContext data={data} lang={lang} />}
{data.hasProjectionHistory && <ProjectionHistory data={data} lang={lang} />}
{data.polls && data.polls.length > 0 && <div id="local-polls" class="riding-anchor"><LocalPolls data={data} lang={lang} /></div>}

<EditorialBlurb data={data} lang={lang} />
{data.member && <CurrentMember data={data} lang={lang} />}
{data.primaries && <PrimaryStatus data={data} lang={lang} />}
{data.declaredCandidates && data.declaredCandidates.length > 0 && <CandidateSlate data={data} lang={lang} />}
{data.baseline && <div id="history" class="riding-anchor"><HistoryTimeline data={data} lang={lang} /></div>}
{data.candidates && data.candidates.length > 0 && <CandidatesTable data={data} lang={lang} />}
{data.redistrictingImpact && data.redistrictingImpact.length > 0 && <RedistrictingImpact data={data} lang={lang} />}
{data.demographics && <Demographics data={data} lang={lang} />}
{data.neighbors && data.neighbors.length > 0 && <div id="nearby" class="riding-anchor"><NeighborRidings data={data} lang={lang} /></div>}
{data.runDate && <DataFreshness data={data} lang={lang} />}

{/* Marché de prédiction — s'allume dès que le registre porte cette course.
    Placé APRÈS la prévision : la page répond d'abord avec son propre modèle,
    le marché est un point de comparaison, jamais la manchette. */}
{data.isByelection && data.predictionMarket && (
  <section class="slot-market"><div class="container">
    <PolymarketEmbed
      slug={data.predictionMarket.slug}
      kind={data.predictionMarket.kind}
      eventUrl={data.predictionMarket.eventUrl}
      lang={lang}
      title={{ en: 'Prediction market', fr: 'Marché de prédiction', es: 'Mercado de predicción' }[lang]}
      subtitle={{
        en: 'Traders’ prices, not the Vote-Scope forecast. The two can disagree.',
        fr: 'Les cotes des parieurs, pas la prévision Vote-Scope. Les deux peuvent diverger.',
        es: 'Las cuotas de los apostadores, no la previsión Vote-Scope. Ambas pueden diferir.',
      }[lang]}
      height={420}
    />
  </div></section>
)}

<style>
  .riding-anchor { scroll-margin-top: 92px; }
</style>
