---
import { partyName } from '../../../lib/party-names';
/**
 * LocalPolls — district-level polls as dense rows inside a riding forecast page
 * (NYT/Upshot model, NOT 338's page-per-poll). Static Astro, no island.
 *
 * District polls are topline-only (no breakdowns), so they live here as rows
 * and never earn their own page — keeps us clear of AdSense thin content
 * (cf. project memory votescope-polls-vertical). One row = one poll:
 * pollster · field dates · sample · topline (bars + numbers) · source.
 *
 * Party palette + colors come from `data.parties` (this riding's projection
 * buckets), so the bars match the rest of the page. The `_oth`/Other bucket is
 * dropped — "never show a party that holds no seat and wins none" (Kim).
 * cleanSource() mirrors PollsHub: never link to aggregators (338Canada/QC125).
 */
import type { RidingData, RidingPoll } from '../../../lib/riding-adapters/types';
import PollShare from '../../PollShare.astro';
import { pollShareRow, packRow, voteDayFor, type Chip } from '../../../lib/share/poll-payload';
import { ridingTitle } from '../../../lib/riding-title';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const polls = data.polls ?? [];
if (polls.length === 0) return null;

const LOCALE = lang === 'fr' ? 'fr-CA' : lang === 'es' ? 'es-ES' : 'en-US';

function fmtLong(iso?: string | null): string {
  if (!iso) return '—';
  const d = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString(LOCALE, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
function dayNum(iso: string): number {
  return new Date(`${iso}T00:00:00Z`).getUTCDate();
}
function fmtShort(iso: string): string {
  const d = new Date(`${iso}T00:00:00Z`);
  return d.toLocaleDateString(LOCALE, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
}

const T = {
  en: {
    eyebrow: 'District polls',
    title: data.jurisdiction.startsWith('us-') ? 'Polls in this district' : 'Polls in this riding',
    firm: 'Pollster',
    dates: 'Field dates',
    sample: 'Sample',
    pop: 'Population',
    result: 'Topline',
    source: 'Source',
    image: 'Image',
    src: 'See the poll',
    pop_lv: 'likely voters', pop_rv: 'registered voters', pop_a: 'adults',
    nPolls: (n: number) => `${n} poll${n === 1 ? '' : 's'}`,
    note: 'Each poll as the pollster published it; these are not the Vote-Scope projection. When a pollster tests several ballots (with or without a given candidate), each one is shown as a scenario.',
    oth: 'Independent and others', scenario: (i: number) => `Scenario ${i}`, nSurveys: (n: number, rows: number) => `${n} poll${n === 1 ? '' : 's'}${rows > n ? `, ${rows} scenarios` : ''}`,
  },
  fr: {
    eyebrow: 'Sondages de circonscription',
    title: data.jurisdiction.startsWith('us-') ? 'Sondages dans ce district' : 'Sondages dans cette circonscription',
    firm: 'Institut',
    dates: 'Terrain',
    sample: 'Échantillon',
    pop: 'Population',
    result: 'Intentions',
    source: 'Source',
    image: 'Image',
    src: 'Voir le sondage',
    pop_lv: 'électeurs probables', pop_rv: 'électeurs inscrits', pop_a: 'adultes',
    nPolls: (n: number) => `${n} sondage${n > 1 ? 's' : ''}`,
    note: 'Chaque sondage tel que l’institut l’a publié ; ces chiffres ne sont pas la projection de Vote-Scope. Quand un institut teste plusieurs affiches (avec ou sans tel candidat), chacune est présentée comme un scénario.',
    oth: 'Indépendant et autres', scenario: (i: number) => `Scénario ${i}`, nSurveys: (n: number, rows: number) => `${n} sondage${n > 1 ? 's' : ''}${rows > n ? `, ${rows} scénarios` : ''}`,
  },
  es: {
    eyebrow: 'Encuestas del distrito',
    title: 'Encuestas en este distrito',
    firm: 'Encuestadora',
    dates: 'Trabajo de campo',
    sample: 'Muestra',
    pop: 'Población',
    result: 'Intención',
    source: 'Fuente',
    image: 'Imagen',
    src: 'Ver la encuesta',
    pop_lv: 'votantes probables', pop_rv: 'votantes registrados', pop_a: 'adultos',
    nPolls: (n: number) => `${n} encuesta${n === 1 ? '' : 's'}`,
    note: 'Cada encuesta tal como la publicó la encuestadora; estas cifras no son la proyección de Vote-Scope. Cuando una encuestadora prueba varias papeletas (con o sin cierto candidato), cada una aparece como un escenario.',
    oth: 'Independiente y otros', scenario: (i: number) => `Escenario ${i}`, nSurveys: (n: number, rows: number) => `${n} encuesta${n === 1 ? '' : 's'}${rows > n ? `, ${rows} escenarios` : ''}`,
  },
}[lang];

function fmtPop(pop?: string | null): string {
  if (!pop) return '—';
  const k = pop.toLowerCase();
  if (k === 'lv') return T.pop_lv;
  if (k === 'rv') return T.pop_rv;
  if (k === 'a' || k === 'adults') return T.pop_a;
  return /^[a-z]{1,3}$/.test(k) ? pop.toUpperCase() : '—';
}

function fmtDates(p: RidingPoll): string {
  const s = p.field_start;
  const e = p.field_end || p.display_date;
  if (!e) return p.release_date ? fmtLong(p.release_date) : '—';
  if (s && s !== e) {
    const sameMonth = s.slice(0, 7) === e.slice(0, 7);
    return sameMonth ? `${dayNum(s)}–${fmtShort(e)}` : `${fmtShort(s)} – ${fmtShort(e)}`;
  }
  return fmtLong(e);
}

function fmtSample(n?: number | null): string {
  if (!n || n <= 0) return '—';
  return n.toLocaleString(LOCALE);
}

/** Outbound-source guard — never link to competing aggregators (338Canada/QC125);
 *  attribution stays on the pollster. Tolerates ";"-joined URLs + stray punctuation. */
const BLOCKED_SOURCE_HOSTS = ['338canada', 'qc125'];
function cleanSource(url?: string | null): string | null {
  if (!url) return null;
  const first = url.split(/[;\s]+/).find(Boolean) ?? '';
  if (!first || !/^https?:\/\//i.test(first)) return null;
  const lower = first.toLowerCase();
  if (BLOCKED_SOURCE_HOSTS.some((h) => lower.includes(h))) return null;
  return first;
}

// Party palette from this riding's projection buckets — drop _oth/Other.
const OTH_RE = /_oth$|^(oth|other|autre|others|autres)$/i;
const colorByCode: Record<string, string> = {};
const labelByCode: Record<string, string> = {};
const allowed = new Set<string>();
// Le seau « autre » s'affiche quand il pèse (Alaska : un indépendant à 35-47 %).
const othCode = data.parties.find((p) => OTH_RE.test(p.code))?.code;
const othMatters = !!othCode && polls.some((p) => (p.topline[othCode] ?? 0) >= 10);
for (const p of data.parties) {
  if (OTH_RE.test(p.code) && !othMatters) continue;
  allowed.add(p.code);
  colorByCode[p.code] = p.color;
  labelByCode[p.code] = OTH_RE.test(p.code) ? T.oth : partyName(p, lang);
}

// Une même enquête (institut + dates + échantillon) peut porter plusieurs scénarios.
const surveyKey = (p: RidingPoll) => `${p.firm_name}|${p.field_start}|${p.field_end}`;
const groups = new Map<string, number>();
for (const p of polls) groups.set(surveyKey(p), (groups.get(surveyKey(p)) ?? 0) + 1);
const seen = new Map<string, number>();
const scenarioOf = (p: RidingPoll) => { const k = surveyKey(p); const i = (seen.get(k) ?? 0) + 1; seen.set(k, i); return (groups.get(k) ?? 1) > 1 ? i : 0; };

/** Candidats nommés (quand l'importateur les fournit) : nom + parti, couleur du parti. */
const NYT_PARTY: Record<string, { code?: string; short: Record<'en' | 'fr' | 'es', string> }> = {
  REP: { code: 'us_rep', short: { en: 'R', fr: 'R', es: 'R' } },
  DEM: { code: 'us_dem', short: { en: 'D', fr: 'D', es: 'D' } },
  IND: { short: { en: 'Ind.', fr: 'ind.', es: 'ind.' } },
  LIB: { short: { en: 'Lib.', fr: 'libertarien', es: 'libertario' } },
  GRN: { short: { en: 'Green', fr: 'vert', es: 'verde' } },
};
const colorOfParty = (party: string) => {
  const code = NYT_PARTY[party]?.code;
  return (code && colorByCode[code]) || data.parties.find((x) => x.code === code)?.color || 'var(--ink-3)';
};
const candidateEntries = (p: RidingPoll): Array<{ label: string; v: number; color: string }> =>
  (p.candidates ?? []).filter((c) => c.pct > 0).map((c) => ({
    label: `${c.name} (${NYT_PARTY[c.party]?.short[lang] ?? c.party})`, v: c.pct, color: colorOfParty(c.party),
  }));

/** Topline entries (desc), restricted to displayed parties, value > 0. */
function toplineEntries(p: RidingPoll): Array<[string, number]> {
  return Object.entries(p.topline)
    .filter(([code, v]) => typeof v === 'number' && v > 0 && allowed.has(code))
    .sort((a, b) => b[1] - a[1]);
}

// Image de chaque sondage : même dessin que les tableaux nationaux (PollShare).
// Les candidats nommés passent comme « partis » de l'image, à la couleur de leur parti.
const shareChips: Chip[] = [...allowed].map((code) => ({ code, label: labelByCode[code], color: colorByCode[code] }));
for (const p of polls) for (const c of candidateEntries(p)) {
  if (!shareChips.some((x) => x.code === c.label)) shareChips.push({ code: c.label, label: c.label, color: c.color.startsWith('var(') ? '#666666' : c.color });
}
const shareTitle = ridingTitle(data, lang).title;
const shareVoteDay = data.byelection?.electionDate ?? voteDayFor(data.jurisdiction, data.runDate ?? '');
---

<section class="local-polls">
  <div class="container">
    <h2>{T.title}</h2>
    <p class="count">{T.nSurveys(groups.size, polls.length)}</p>

    <PollShare lang={lang} title={shareTitle} chips={shareChips} voteDay={shareVoteDay}>
    <div class="poll-table-wrap">
      <table class="poll-table">
        <thead>
          <tr>
            <th class="c-firm">{T.firm}</th>
            <th class="c-dates">{T.dates}</th>
            <th class="c-sample">{T.sample}</th>
            <th class="c-pop">{T.pop}</th>
            <th class="c-result">{T.result}</th>
            <th class="c-src">{T.source}</th>
            <th class="c-share">{T.image}</th>
          </tr>
        </thead>
        <tbody>
          {polls.map((p) => {
            const named = candidateEntries(p);
            const entries = named.length
              ? named.map((c) => [c.label, c.v] as [string, number])
              : toplineEntries(p);
            const colorOf = (code: string) => named.find((c) => c.label === code)?.color ?? colorByCode[code] ?? 'var(--ink-2)';
            const labelOf = (code: string) => named.length ? code : (labelByCode[code] || code);
            const sc = scenarioOf(p);
            const max = Math.max(1, ...entries.map(([, v]) => v));
            return (
              <tr>
                <td class="c-firm">
                  <span>{p.firm_name}</span>
                  {p.client && <span class="client">{p.client}</span>}
                  {sc > 0 && <span class="client">{T.scenario(sc)}</span>}
                </td>
                <td class="c-dates">{fmtDates(p)}</td>
                <td class="c-sample">{fmtSample(p.sample_size)}</td>
                <td class="c-pop">{fmtPop(p.population)}</td>
                <td class="c-result">
                  <div class="bars">
                    {entries.map(([code, v]) => (
                      <span class="bar-row">
                        <span class="bar-label" style={`--c:${colorOf(code)}`}>
                          {labelOf(code)}
                        </span>
                        <span class="bar-track">
                          <span class="bar-fill" style={`width:${(v / max) * 100}%;--c:${colorOf(code)}`}></span>
                        </span>
                        <span class="bar-val">{v.toFixed(0)}</span>
                      </span>
                    ))}
                  </div>
                </td>
                <td class="c-src">
                  {cleanSource(p.source_url) ? (
                    <a href={cleanSource(p.source_url)!} target="_blank" rel="nofollow noopener">{T.src}</a>
                  ) : (
                    <span class="muted">—</span>
                  )}
                </td>
                <td class="c-share">
                  <button type="button" class="poll-share-btn" aria-haspopup="menu"
                    data-poll={packRow({ ...pollShareRow(p, lang, sc > 0 ? T.scenario(sc) : undefined), p: entries })}>{T.image}</button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    </PollShare>

    <p class="note">{T.note}</p>
  </div>
</section>

<style>
  .local-polls { padding: 56px 0; border-bottom: 1px solid var(--rule); }
  h2 { margin: 8px 0 4px; font-family: var(--serif); font-size: clamp(28px, 3.4vw, 40px); font-weight: 700; letter-spacing: -0.01em; }
  .count { margin: 0 0 24px; font-family: var(--mono); font-size: 13px; letter-spacing: 0; color: var(--ink-2); }

  .poll-table-wrap { overflow-x: auto; border: 1px solid var(--rule); background: var(--card); border-radius: 2px; }
  .poll-table { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 13px; }
  .poll-table thead th { background: var(--paper); text-align: left; font-weight: 500; letter-spacing: 0; font-size: 10px; color: var(--ink-2); padding: 10px 12px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .poll-table tbody td { padding: 10px 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .poll-table tbody tr:last-child td { border-bottom: 0; }
  .poll-table tbody tr:hover { background: color-mix(in oklab, var(--accent, var(--ink)) 5%, var(--card)); }

  .c-firm { font-family: var(--serif); font-size: 14px; min-width: 160px; }
  .client { display: block; font-family: var(--mono); font-size: 13px; color: var(--ink-2); margin-top: 2px; }
  .c-dates, .c-sample, .c-pop { white-space: nowrap; color: var(--ink-2); }
  .c-sample { text-align: right; }
  .c-result { min-width: 220px; }
  .c-src a { color: var(--ink-2); text-decoration: none; border-bottom: 1px dotted var(--rule); }
  .c-src a:hover { color: var(--ink); }
  .muted { color: var(--rule); }
  .c-share { white-space: nowrap; }

  .bars { display: flex; flex-direction: column; gap: 4px; }
  .bar-row { display: grid; grid-template-columns: 54px 1fr 28px; align-items: center; gap: 8px; }
  .bar-label { color: var(--c); font-size: 10px; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-track { height: 8px; background: color-mix(in oklab, var(--ink) 8%, transparent); border-radius: 2px; overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: var(--c); border-radius: 2px; }
  .bar-val { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }

  .note { margin-top: 16px; font-family: var(--serif); font-style: italic; font-size: 14px; color: var(--ink-2); max-width: 720px; }
</style>
