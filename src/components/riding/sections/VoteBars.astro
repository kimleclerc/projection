---
import type { RidingData } from '../../../lib/riding-adapters/types';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const parties = data.parties.filter((p) => p.vote_mean_pct >= 0.5);

// L'échelle doit accommoder les DEUX séries tracées sur la piste : la barre
// projetée ET le repère du scrutin précédent. La borner à la seule plus grande
// part PROJETÉE sort le repère de sa piste dès qu'un parti recule — 1399 des
// 2292 courses du site, dont 95 % du Royaume-Uni et 68 % du Québec. La piste
// est en `overflow: visible` à dessein (le repère déborde de 3px en haut et en
// bas), alors le repère continuait vers la droite jusqu'à 199 % de la piste et
// poussait la PAGE ENTIÈRE en défilement horizontal sur mobile.
// Prix mesuré : la barre de tête tombe au pire à 50 % de la piste (Lothian
// East), 97 % à la médiane, et 893 courses gardent leur échelle intacte.
const baselinePct = (code: string) => data.baseline?.party_pcts[code];
const maxPct = Math.max(
  ...parties.map((p) => p.vote_mean_pct),
  ...parties.map((p) => baselinePct(p.code) ?? 0),
  1,
);

const T = {
  en: {
    eyebrow: 'Projected vote share',
    title: 'Projection by party',
    baseline_label: (cycle: string) => `${cycle.replace('_', ' ')} result`,
    incumbent: 'incumbent',
  },
  fr: {
    eyebrow: 'Part de voix projetée',
    title: 'Projection par parti',
    baseline_label: (cycle: string) => `Résultat ${cycle.replace('_', ' ')}`,
    incumbent: 'sortant·e',
  },
  es: {
    eyebrow: 'Cuota de voto proyectada',
    title: 'Proyección por partido',
    baseline_label: (cycle: string) => `Resultado ${cycle.replace('_', ' ')}`,
    incumbent: 'titular',
  },
}[lang];

// Le seau « autre » rassemble plusieurs partis : quand il ne porte qu'une
// personne, son vrai parti de bulletin en dit plus que l'étiquette du seau —
// « AUTRE 1,5 % · Christian Savard » ne dit pas sous quelle bannière.
const showsRawParty = (code: string) => /(^|_)oth$/.test(code);

// Valeurs qui ne nomment aucun parti : les afficher serait pire que rien.
// « TOP_TWO » signale une primaire top-two où le parti n'a pas été relevé.
const UNINFORMATIVE = new Set(['', 'OTH', 'OTHER', 'TOP_TWO', 'UN', 'UNK', 'NNE', 'NONE']);

/**
 * Le champ ne porte pas la même chose des deux côtés de la frontière : un
 * sigle aux États-Unis (« LIB »), le nom complet au Québec, parfois bilingue
 * et séparé d'une barre oblique — « Parti vert du Québec/Green Party of
 * Québec ». On ne garde que la moitié qui correspond à la langue lue.
 */
function rawPartyLabel(raw: string | undefined): string | undefined {
  const value = (raw ?? '').trim();
  if (UNINFORMATIVE.has(value.toUpperCase())) return undefined;
  const halves = value.split('/').map((h) => h.trim()).filter(Boolean);
  if (halves.length !== 2) return value;
  return lang === 'en' ? halves[1] : halves[0];
}
---

<section class="vote-bars">
  <div class="container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h2>{T.title}</h2>

    <ul class="bars">
      {parties.map((p) => {
        const label = lang === 'fr' ? p.label_fr : p.label_en;
        const baseline = baselinePct(p.code);
        const widthPct = (p.vote_mean_pct / maxPct) * 100;
        return (
          <li>
            <div class="row">
              <span class="party-label" style={`--accent:${p.color}`}>
                <span class="swatch" aria-hidden="true"></span>{label}
              </span>
              <span class="pct">{p.vote_mean_pct.toFixed(1)}%</span>
            </div>
            {p.nominee && (
              <p class="nominee">
                {p.nominee.name}
                {showsRawParty(p.code) && rawPartyLabel(p.nominee.party_raw) && (
                  <span class="raw-party">{rawPartyLabel(p.nominee.party_raw)}</span>
                )}
                {p.nominee.status === 'incumbent' && (
                  <span class="tag">{T.incumbent}</span>
                )}
              </p>
            )}
            <div class="track">
              <div class="fill" style={`width:${widthPct}%;background:${p.color}`}></div>
              {baseline !== undefined && (
                <div
                  class="baseline-tick"
                  style={`left:${(baseline / maxPct) * 100}%`}
                  title={T.baseline_label(data.baseline!.cycle) + ` — ${baseline.toFixed(1)}%`}
                ></div>
              )}
            </div>
          </li>
        );
      })}
    </ul>
    {/* Baseline cycle is communicated in EditorialBlurb prose and via the
        tick mark's title hover; the bottom legend was redundant noise. */}
  </div>
</section>

<style>
  .vote-bars {
    padding: 56px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin: 8px 0 24px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  .bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .party-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .pct {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 430;
  }
  /* Le nom se lit comme une personne, pas comme une étiquette de série :
     sérif et casse normale, sous le sigle du parti et au-dessus de sa barre. */
  .nominee {
    margin: -2px 0 6px;
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink-2);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }
  .nominee .raw-party,
  .nominee .tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .06em;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 1px 5px;
  }
  /* « sortant·e » est un mot, pas un sigle : la capitale lui va. Le nom d'un
     parti québécois fait jusqu'à 38 caractères — en capitales il écraserait
     le nom du candidat, qui est l'information principale de la ligne. */
  .nominee .tag { text-transform: uppercase; }
  .track {
    position: relative;
    height: 10px;
    background: color-mix(in oklab, var(--ink) 8%, transparent);
    border-radius: 2px;
    overflow: visible;
  }
  .fill {
    height: 100%;
    border-radius: 2px;
    transition: width .3s ease;
  }
  .baseline-tick {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: var(--ink);
    opacity: .55;
  }
  .legend {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tick-demo {
    display: inline-block;
    width: 2px;
    height: 14px;
    background: var(--ink);
    opacity: .55;
  }
</style>
