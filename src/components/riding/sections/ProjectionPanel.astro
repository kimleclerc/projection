---
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';
import { certainty, CERTAINTY_LABEL } from '../../../lib/riding-certainty';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const winnerMeta = partyMeta(data.jurisdiction, data.projection.winner);
const winnerLabel = partyName(winnerMeta, lang);
const closeRacePct = (data.projection.p_close_race * 100).toFixed(0);

const T = {
  en: {
    eyebrow: 'Current forecast',
    close: 'Chance of a finish within 5 points',
  },
  fr: {
    eyebrow: 'Prévision actuelle',
    close: 'Chance d’un écart final de moins de 5 points',
  },
  es: {
    eyebrow: 'Pronóstico actual',
    close: 'Probabilidad de un margen final inferior a 5 puntos',
  },
}[lang];

const competitiveness = CERTAINTY_LABEL[lang][certainty(data.projection)];
---

<section class="projection-panel">
  <div class="container panel-inner">
    <div>
      <p class="eyebrow">{T.eyebrow}</p>
      <h2 style={`--accent:${winnerMeta.color}`}>
        <span class="dot" aria-hidden="true"></span>
        {winnerLabel}
      </h2>
      <p class="competitiveness">{competitiveness}</p>
    </div>
    <p class="panel-close">{T.close}{lang === 'fr' ? '\u00a0: ' : ': '}<strong>{closeRacePct === '0' ? (lang === 'en' ? 'under 1%' : lang === 'es' ? 'menos del 1 %' : 'moins de 1 %') : lang === 'en' ? `${closeRacePct}%` : `${closeRacePct}\u00a0%`}</strong></p>
  </div>
</section>

<style>
  .projection-panel {
    padding: 48px 0;
    background: var(--card);
    border-bottom: 1px solid var(--rule);
  }
  .panel-inner {
    display: grid;
    grid-template-columns: 1fr .9fr;
    gap: 32px;
    align-items: center;
  }
  h2 {
    margin: 8px 0 4px;
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.02;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    flex-shrink: 0;
  }
  .competitiveness {
    margin-top: 8px;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0;
  }
  .panel-close {
    font-size: 16px;
    color: var(--ink-2);
  }
  .panel-close strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  @media (max-width: 820px) {
    .panel-inner { grid-template-columns: 1fr; }
  }
</style>
