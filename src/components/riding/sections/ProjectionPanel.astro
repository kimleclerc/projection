---
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, partyMark } from '../../../lib/riding-adapters/parties';
import { certainty, CERTAINTY_LABEL } from '../../../lib/riding-certainty';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const winnerMeta = partyMeta(data.jurisdiction, data.projection.winner);
const winnerLabel = partyName(winnerMeta, lang);
const pWinnerPct = Math.round(data.projection.p_winner * 100);
const margin = data.projection.mean_margin.toLocaleString(lang === 'en' ? 'en-CA' : lang === 'es' ? 'es-ES' : 'fr-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const closeRacePct = (data.projection.p_close_race * 100).toFixed(0);

const T = {
  en: {
    eyebrow: 'Current forecast',
    leader_in: 'Projected winner',
    confidence: 'Probability',
    margin: 'Mean margin (pts)',
    close: 'Chance of a margin under 5 pts',
  },
  fr: {
    eyebrow: 'Prévision actuelle',
    leader_in: 'Vainqueur projeté',
    confidence: 'Probabilité',
    margin: 'Marge moyenne (pts)',
    close: 'Chance d’un écart de moins de 5 pts',
  },
  es: {
    eyebrow: 'Pronóstico actual',
    leader_in: 'Ganador proyectado',
    confidence: 'Probabilidad',
    margin: 'Margen medio (pts)',
    close: 'Probabilidad de un margen inferior a 5 pts',
  },
}[lang];

const competitiveness = CERTAINTY_LABEL[lang][certainty(data.projection)];
---

<section class="projection-panel">
  <div class="container panel-inner">
    <div>
      <p class="eyebrow">{T.eyebrow}</p>
      <h2 style={`--accent:${winnerMeta.color}`}>
        {partyMark(winnerMeta)
          ? <img class="winner-logo" src={`/party-logos/${partyMark(winnerMeta)}`} alt="" width="54" height="54" decoding="async" />
          : <span class="dot" aria-hidden="true"></span>}
        {winnerLabel}
      </h2>
      <p class="competitiveness">{competitiveness}</p>
    </div>
    <dl class="stats">
      <div>
        <dt>{T.confidence}</dt>
        <dd>{pWinnerPct >= 100 ? (lang === 'en' ? '>99%' : '> 99 %') : lang === 'en' ? `${pWinnerPct}%` : `${pWinnerPct} %`}</dd>
      </div>
      <div>
        <dt>{T.margin}</dt>
        <dd>{margin}</dd>
      </div>
      <div>
        <dt>{T.close}</dt>
        <dd>{closeRacePct === '0' ? (lang === 'en' ? '<1%' : '< 1 %') : lang === 'en' ? `${closeRacePct}%` : `${closeRacePct} %`}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .projection-panel {
    padding: 48px 0;
    background: var(--card);
    border-bottom: 1px solid var(--rule);
  }
  .panel-inner {
    display: grid;
    grid-template-columns: 1fr .9fr;
    gap: 32px;
    align-items: center;
  }
  h2 {
    margin: 8px 0 4px;
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.02;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    flex-shrink: 0;
  }
  .winner-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
    flex: none;
  }
  .competitiveness {
    margin-top: 8px;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .stats > div {
    padding: 20px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 32px;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .panel-inner { grid-template-columns: 1fr; }
  }
</style>
