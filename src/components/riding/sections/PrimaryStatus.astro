---
/** Official primary results after election day; polling before election day. */
import type { PrimaryResultRow, RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';
import { longDate, pct as fmtPct, properName } from '../../../lib/format';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.primaries) return null;
const held = data.primaries.status === 'held' ? data.primaries : undefined;
const polling = data.primaries.status !== 'held' ? data.primaries : undefined;
const dem = polling?.dem;
const rep = polling?.rep;
if (!held && !dem && !rep) return null;
// A calendar-only held marker suppresses stale polling and candidate slates,
// but must not masquerade as a result before an official feed is available.
if (held && held.results.length === 0) return null;

const demMeta = partyMeta(data.jurisdiction, 'us_dem');
const repMeta = partyMeta(data.jurisdiction, 'us_rep');

const T = {
  en: {
    eyebrow: 'Primary race', pollTitle: 'Who leads in the primary', resultTitle: 'Primary results',
    polledCandidates: (n: number) => `${n} ${n === 1 ? 'candidate' : 'candidates'} polled`,
    asOf: 'Latest poll', by: 'by', heldOn: 'Held', votes: 'votes', pendingTotals: 'Totals pending',
    certified: 'Certified official result', uncertified: 'Official count — not yet certified',
    source: 'Official source', winner: 'Winner', advanced: 'Advanced to the general election',
    runoff: 'Advanced to a runoff', parties: { DEM: 'Democratic primary', REP: 'Republican primary', TOP_TWO: 'Top-two primary', OTHER: 'Other primary' },
    demParty: 'Democratic', repParty: 'Republican',
  },
  fr: {
    eyebrow: 'Course primaire', pollTitle: 'Qui mène en primaire', resultTitle: 'Résultats de la primaire',
    polledCandidates: (n: number) => `${n} ${n === 1 ? 'candidature testée' : 'candidatures testées'}`,
    asOf: 'Dernier sondage', by: 'par', heldOn: 'Tenue le', votes: 'voix', pendingTotals: 'Totaux à venir',
    certified: 'Résultat officiel certifié', uncertified: 'Décompte officiel — non encore certifié',
    source: 'Source officielle', winner: 'Vainqueur', advanced: 'Qualification pour l’élection générale',
    runoff: 'Qualification pour le second tour', parties: { DEM: 'Primaire démocrate', REP: 'Primaire républicaine', TOP_TWO: 'Primaire des deux premiers', OTHER: 'Autre primaire' },
    demParty: 'Démocrate', repParty: 'Républicaine',
  },
  es: {
    eyebrow: 'Primarias', pollTitle: 'Quién lidera la primaria', resultTitle: 'Resultados de las primarias',
    polledCandidates: (n: number) => `${n} ${n === 1 ? 'candidato sondeado' : 'candidatos sondeados'}`,
    asOf: 'Último encuesta', by: 'por', heldOn: 'Celebrada el', votes: 'votos', pendingTotals: 'Totales pendientes',
    certified: 'Resultado oficial certificado', uncertified: 'Recuento oficial — aún no certificado',
    source: 'Fuente oficial', winner: 'Ganador', advanced: 'Pasa a las elecciones generales',
    runoff: 'Pasa a la segunda vuelta', parties: { DEM: 'Primaria demócrata', REP: 'Primaria republicana', TOP_TWO: 'Primaria de los dos primeros', OTHER: 'Otra primaria' },
    demParty: 'Demócrata', repParty: 'Republicana',
  },
}[lang];

function formatDate(iso: string): string {
  if (!iso) return '';
  try {
    const locale = { en: 'en-CA', fr: 'fr-CA', es: 'es-ES' }[lang];
    return new Intl.DateTimeFormat(locale, {
      month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
    }).format(new Date(`${iso}T00:00:00Z`));
  } catch { return iso; }
}

function formatVotes(value: number): string {
  return new Intl.NumberFormat({ en: 'en-US', fr: 'fr-CA', es: 'es-ES' }[lang]).format(value);
}

const resultGroups = held ? Object.entries(
  held.results.reduce<Record<string, PrimaryResultRow[]>>((groups, row) => {
    (groups[row.primary_party] ??= []).push(row);
    return groups;
  }, {}),
).map(([party, rows]) => ({
  party: party as keyof typeof T.parties,
  rows: rows.filter((row) => ['won', 'advanced', 'runoff'].includes(row.outcome)),
})) : [];

function outcomeLabel(outcome: PrimaryResultRow['outcome']): string {
  if (outcome === 'advanced') return T.advanced;
  if (outcome === 'runoff') return T.runoff;
  return T.winner;
}
---

<section class="primary-status">
  <div class="container">
    <h2>{held ? T.resultTitle : T.pollTitle}</h2>

    {held ? (
      <>
        <p class="vs-meta result-context">
          {T.heldOn} {longDate(held.primary_date, lang)}{held.certified && <> · {T.certified}</>} · <a class="vs-link" href={held.source_url} rel="noreferrer">{T.source}</a>
        </p>
        <div class="table-scroll">
          <table class="primary-table">
            <tbody>
              {resultGroups.flatMap((group) => group.rows.map((row) => (
                <tr>
                  <th scope="row">{T.parties[group.party]}</th>
                  <td>
                    {properName(row.candidate_name.replace(/\s*\((I|i)\)\s*$/, ''))}
                    {row.outcome !== 'won' && <span class="outcome"> · {outcomeLabel(row.outcome)}</span>}
                  </td>
                  <td class="num">{row.pct !== null ? fmtPct(row.pct, lang) : T.pendingTotals}</td>
                  <td class="num">{row.votes !== null ? `${formatVotes(row.votes)} ${T.votes}` : ''}</td>
                </tr>
              )))}
            </tbody>
          </table>
        </div>
      </>
    ) : (
      <div class="primary-grid">
        {dem && (
          <article class="party-card" style={`--accent:${demMeta.color}`}>
            <header><span class="party-label">{T.demParty}</span><span class="party-dot" aria-hidden="true"></span></header>
            <p class="leader"><strong>{properName(dem.leader_name)}</strong> <span class="lead-pct">{fmtPct(dem.leader_pct, lang, 0)}</span></p>
            <p class="meta">{T.polledCandidates(dem.n_candidates_polled)} · {T.asOf} {formatDate(dem.field_end)}{dem.firm && <> · {T.by} {dem.firm}</>}</p>
          </article>
        )}
        {rep && (
          <article class="party-card" style={`--accent:${repMeta.color}`}>
            <header><span class="party-label">{T.repParty}</span><span class="party-dot" aria-hidden="true"></span></header>
            <p class="leader"><strong>{properName(rep.leader_name)}</strong> <span class="lead-pct">{fmtPct(rep.leader_pct, lang, 0)}</span></p>
            <p class="meta">{T.polledCandidates(rep.n_candidates_polled)} · {T.asOf} {formatDate(rep.field_end)}{rep.firm && <> · {T.by} {rep.firm}</>}</p>
          </article>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .primary-status { padding:48px 0; border-bottom:1px solid var(--rule); background:var(--paper); }
  h2 { margin:8px 0 24px; font-family:var(--serif); font-size:clamp(26px,3vw,36px); font-weight: 700; letter-spacing:-.01em; }
  .result-context { margin:-12px 0 16px; }
  .primary-table { width:100%; border-collapse:collapse; font-size:16px; border-top:2px solid var(--ink); }
  .primary-table th, .primary-table td { padding:10px 12px 10px 0; border-bottom:1px solid var(--rule); text-align:left; font-weight:400; }
  .primary-table th { color:var(--ink-2); font-size:15px; }
  .primary-table td:nth-child(2) { font-weight:600; }
  .primary-table .num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .primary-table .outcome { font-weight:400; color:var(--ink-2); }
  .primary-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); border-top:1px solid var(--rule); border-left:1px solid var(--rule); }
  .party-card { padding:20px 22px; border-right:1px solid var(--rule); border-bottom:1px solid var(--rule); background:var(--card); }
  .party-card header { display:flex; align-items:center; gap:8px; margin-bottom:14px; }
  .party-label { font-family:var(--mono); font-size: 13px; letter-spacing: 0; color:var(--ink-2); }
  .party-dot { width:10px; height:10px; border-radius:50%; background:var(--accent); margin-left:auto; }
  .leader { margin:0; font-family:var(--serif); font-size:clamp(22px,2.6vw,28px); display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
  .leader strong { font-weight:460; }
  .lead-pct { font-family:var(--mono); font-size:18px; color:var(--accent,var(--blue)); white-space:nowrap; }
  .meta { margin:10px 0 0; font-family:var(--mono); font-size: 13px; color:var(--ink-2); }
  .result-row + .result-row { margin-top:18px; padding-top:18px; border-top:1px solid var(--rule); }
</style>
