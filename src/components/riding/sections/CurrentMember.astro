---
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';
import { longDate, properName } from '../../../lib/format';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.member) return null;
const m = data.member;

const currentMeta = partyMeta(data.jurisdiction, m.party_current);
const electedMeta = m.party_elected ? partyMeta(data.jurisdiction, m.party_elected) : null;
const currentLabel = partyName(currentMeta, lang);
const electedLabel = electedMeta ? (partyName(electedMeta, lang)) : null;
const hasCrossed = !!(m.party_elected && m.party_current !== m.party_elected);
// UN GOUVERNEUR N'EST PAS UN·E DÉPUTÉ·E, ET NE « SIÈGE » AVEC PERSONNE : il
// dirige l'exécutif d'un État. Les libellés parlementaires seraient faux mot
// pour mot sur ces trente-six pages.
const isExecutive = data.jurisdiction === 'us-governor';

const T = {
  en: {
    title: isExecutive ? 'Current governor' : 'Current member',
    since: (d: string) => `In office since ${d}.`,
    parliament: (n: number) => ` ${n}${n % 10 === 1 && n % 100 !== 11 ? 'st' : n % 10 === 2 && n % 100 !== 12 ? 'nd' : n % 10 === 3 && n % 100 !== 13 ? 'rd' : 'th'} Parliament.`,
    crossed: (from: string, d: string) => `Elected as ${from}; changed party${d ? ` on ${d}` : ''}.`,
    byelection: (d: string) => `Won the seat in a by-election${d ? ` on ${d}` : ''}.`,
  },
  fr: {
    title: isExecutive ? 'Titulaire du poste' : 'Titulaire du siège',
    since: (d: string) => `En poste depuis le ${d}.`,
    parliament: (n: number) => ` ${n}${n === 1 ? 're' : 'e'} législature.`,
    crossed: (from: string, d: string) => `Parti à l’élection : ${from} ; changement de parti${d ? ` le ${d}` : ''}.`,
    byelection: (d: string) => `Siège gagné lors d’une élection partielle${d ? ` le ${d}` : ''}.`,
  },
  es: {
    title: isExecutive ? 'Titular del cargo' : 'Titular del escaño',
    since: (d: string) => `En el cargo desde el ${d}.`,
    parliament: (n: number) => ` ${n}.ª legislatura.`,
    crossed: (from: string, d: string) => `Partido en la elección: ${from}; cambio de partido${d ? ` el ${d}` : ''}.`,
    byelection: (d: string) => `Escaño ganado en una elección parcial${d ? ` el ${d}` : ''}.`,
  },
}[lang];

const changeDate = longDate(m.change_date, lang);
const changeNote = hasCrossed && electedLabel
  ? T.crossed(electedLabel, changeDate)
  : m.change_type === 'byelection_win' ? T.byelection(changeDate) : '';
const tenure = [
  m.member_start_date ? T.since(longDate(m.member_start_date, lang)) : '',
  m.parliament !== undefined && m.parliament !== null && !data.jurisdiction.startsWith('us-') ? T.parliament(Number(m.parliament)).trim() : '',
].filter(Boolean).join(' ');
---

<section class="current-member">
  <div class="container">
    <h2>{T.title}</h2>
    <p class="member-line" style={`--accent:${currentMeta.color}`}>
      <span class="dot" aria-hidden="true"></span>
      <strong>{properName(m.mp_name)}</strong> · {currentLabel}
    </p>
    {(tenure || changeNote) && <p class="vs-meta member-meta">{[changeNote, tenure].filter(Boolean).join(' ')}</p>}
  </div>
</section>

<style>
  .current-member {
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
  }
  .member-line {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 19px;
  }
  .member-line strong { font-weight: 700; }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    flex: none;
  }
  .member-meta { margin: 8px 0 0; }
</style>
