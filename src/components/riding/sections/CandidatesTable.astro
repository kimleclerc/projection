---
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';
import { num, properName } from '../../../lib/format';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.candidates || data.candidates.length === 0) return null;

const year = (data.baseline?.cycle ?? '').match(/\d{4}/)?.[0] ?? '';
const T = {
  en: {
    title: year ? `Candidates and votes in ${year}` : 'Candidates and votes',
    candidate: 'Candidate',
    party: 'Party',
    votes: 'Votes',
    pct: '%',
    role: 'Occupation',
    elected: 'Elected',
  },
  fr: {
    title: year ? `Candidats et voix en ${year}` : 'Candidats et voix',
    candidate: 'Candidature',
    party: 'Parti',
    votes: 'Voix',
    pct: '%',
    role: 'Profession',
    elected: 'Siège remporté',
  },
  es: {
    title: year ? `Candidatos y votos en ${year}` : 'Candidatos y votos',
    candidate: 'Candidatura',
    party: 'Partido',
    votes: 'Votos',
    pct: '%',
    role: 'Profesión',
    elected: 'Escaño ganado',
  },
}[lang];

const LOCALE = { en: 'en-CA', fr: 'fr-CA', es: 'es-ES' }[lang];
// Même dénominateur que les barres de la fiche : toutes les voix valides. La liste
// importée ne contient pas toujours chaque candidature (Burnaby Central 2025 : 51 493
// voix listées pour environ 51 900 valides). On déduit le total du vainqueur et de sa
// part officielle, et l'écart devient une ligne « Autres candidatures ».
const winnerC = data.candidates.find((c) => c.is_elected && c.votes);
const winnerPct = winnerC && data.baseline?.party_pcts?.[winnerC.party_code];
const listed = data.candidates.reduce((sum, c) => sum + (c.votes ?? 0), 0);
const totalValid = winnerC && winnerPct && winnerPct > 0 ? (winnerC.votes as number) / (winnerPct / 100) : null;
// Garde-fou : si le total déduit est incohérent (carte redécoupée, données transposées), on garde les parts publiées.
const useTotal = totalValid !== null && totalValid >= listed && totalValid <= listed * 1.1;
const others = useTotal ? Math.round((totalValid as number) - listed) : 0;
const pctOf = (c: { votes?: number; vote_pct?: number | null }) =>
  useTotal && c.votes !== undefined ? (c.votes / (totalValid as number)) * 100 : c.vote_pct ?? null;
const othersLabel = { en: 'Other candidates', fr: 'Autres candidatures', es: 'Otras candidaturas' }[lang];

const numberFmt = new Intl.NumberFormat(LOCALE);
// Une colonne vide partout (le Royaume-Uni ne publie pas les professions) n'apporte rien.
// Élections Canada ne publie les professions qu'en anglais : la colonne reste sur les pages anglaises.
const hasRole = lang === 'en' && data.candidates.some((c) => c.occupation && c.occupation.trim() && c.occupation !== '—');
---

<section class="candidates">
  <div class="container">
    <h2>{T.title}</h2>

    <div class="table-scroll" tabindex="0" role="region" aria-label={T.title}>
    <table>
      <thead>
        <tr>
          <th>{T.candidate}</th>
          <th>{T.party}</th>
          <th class="num">{T.votes}</th>
          <th class="num">{T.pct}</th>
          {hasRole && <th>{T.role}</th>}
        </tr>
      </thead>
      <tbody>
        {data.candidates.map((c) => {
          const meta = partyMeta(data.jurisdiction, c.party_code);
          const partyLabel = partyName(meta, lang);
          return (
            <tr class={c.is_elected ? 'elected' : ''}>
              <td>
                <span class="name">{properName(c.name)}</span>
                {c.is_elected && <span class="badge">{T.elected}</span>}
              </td>
              <td>
                <span class="party" style={`--accent:${meta.color}`}>
                  <span class="swatch" aria-hidden="true"></span>{partyLabel}
                </span>
              </td>
              <td class="num">{c.votes !== undefined ? numberFmt.format(c.votes) : '—'}</td>
              <td class="num">{pctOf(c) != null ? num(pctOf(c) as number, lang, 1) : '—'}</td>
              {hasRole && <td class="role">{c.occupation ?? '—'}</td>}
            </tr>
          );
        })}
        {others > 0 && (totalValid as number) > 0 && others / (totalValid as number) >= 0.002 && (
          <tr>
            <td><span class="name">{othersLabel}</span></td>
            <td></td>
            <td class="num">{numberFmt.format(others)}</td>
            <td class="num">{num((others / (totalValid as number)) * 100, lang, 1)}</td>
            {hasRole && <td></td>}
          </tr>
        )}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .candidates {
    padding: 56px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin: 8px 0 24px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }
  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  th, td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  th {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-2);
    font-weight: 500;
    background: var(--paper-2);
  }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.elected td { background: color-mix(in oklab, var(--ink) 4%, transparent); }
  .name { font-family: var(--serif); font-size: 16px; }
  .badge {
    margin-left: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .party {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .role {
    color: var(--ink-2);
    font-style: italic;
  }
  @media (max-width: 820px) {
    .role { display: none; }
  }
</style>
