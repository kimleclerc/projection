---
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.candidates || data.candidates.length === 0) return null;

const cycleLabel = data.baseline?.cycle?.replace('_', ' ').toUpperCase() ?? '';
const T = {
  en: {
    eyebrow: `Detailed result · ${cycleLabel}`,
    title: 'Candidates and votes',
    candidate: 'Candidate',
    party: 'Party',
    votes: 'Votes',
    pct: '%',
    role: 'Occupation',
    elected: 'Elected',
  },
  fr: {
    eyebrow: `Résultat détaillé · ${cycleLabel}`,
    title: 'Candidats et voix',
    candidate: 'Candidat·e',
    party: 'Parti',
    votes: 'Voix',
    pct: '%',
    role: 'Profession',
    elected: 'Élu·e',
  },
  es: {
    eyebrow: `Resultado detallado · ${cycleLabel}`,
    title: 'Candidatos y votos',
    candidate: 'Candidato·a',
    party: 'Partido',
    votes: 'Votos',
    pct: '%',
    role: 'Profesión',
    elected: 'Electo·a',
  },
}[lang];

const LOCALE = { en: 'en-CA', fr: 'fr-CA', es: 'es-ES' }[lang];
const numberFmt = new Intl.NumberFormat(LOCALE);
---

<section class="candidates">
  <div class="container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h2>{T.title}</h2>

    <div class="table-scroll" tabindex="0" role="region" aria-label={T.title}>
    <table>
      <thead>
        <tr>
          <th>{T.candidate}</th>
          <th>{T.party}</th>
          <th class="num">{T.votes}</th>
          <th class="num">{T.pct}</th>
          <th>{T.role}</th>
        </tr>
      </thead>
      <tbody>
        {data.candidates.map((c) => {
          const meta = partyMeta(data.jurisdiction, c.party_code);
          const partyLabel = lang === 'fr' ? meta.label_fr : meta.label_en;
          return (
            <tr class={c.is_elected ? 'elected' : ''}>
              <td>
                <span class="name">{c.name}</span>
                {c.is_elected && <span class="badge">{T.elected}</span>}
              </td>
              <td>
                <span class="party" style={`--accent:${meta.color}`}>
                  <span class="swatch" aria-hidden="true"></span>{partyLabel}
                </span>
              </td>
              <td class="num">{c.votes !== undefined ? numberFmt.format(c.votes) : '—'}</td>
              <td class="num">{c.vote_pct !== undefined ? c.vote_pct.toFixed(1) : '—'}</td>
              <td class="role">{c.occupation ?? '—'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
  </div>
</section>

<style>
  .candidates {
    padding: 56px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin: 8px 0 24px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }
  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  th, td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  th {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-weight: 500;
    background: var(--paper-2);
  }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.elected td { background: color-mix(in oklab, var(--ink) 4%, transparent); }
  .name { font-family: var(--serif); font-size: 16px; }
  .badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .06em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .party {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .role {
    color: var(--ink-2);
    font-style: italic;
  }
  @media (max-width: 820px) {
    .role { display: none; }
  }
</style>
