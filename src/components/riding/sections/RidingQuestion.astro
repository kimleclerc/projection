---
/**
 * Editorial question framing the page — Vote-Scope's "one page, one question"
 * promise applied to riding pages. Sits between Hero and EditorialBlurb.
 *
 * The question is derived from data: vacancy + byelection date, projection
 * winner vs baseline winner, p_close_race, p_winner. Falls back gracefully
 * across jurisdictions because it only uses fields every adapter provides.
 *
 * Question selection (in order):
 *   1. Vacant + byelection date → "Who succeeds X in this open seat?"
 *   2. Vacant (no date)        → "Who wins this open seat?"
 *   3. p_close_race ≥ 0.35     → "Who wins this toss-up?"
 *   4. winner ≠ baseline.winner → "Will [old] lose [seat] to [new]?"
 *   5. p_winner ≥ 0.85         → "How safely does [winner] hold [seat]?"
 *   6. otherwise (leaning)     → "Can [winner] hold [seat]?"
 *
 * Mention forms use partyMeta.mention_en / mention_fr ("the Conservatives",
 * "Sinn Féin", "du PQ", "de la CAQ"). Stay laconic — one short question.
 */
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, subjectFr, datifFr, aEs, agreementFr, isPluralEs } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const name = lang === 'fr' ? data.name.fr : data.name.en;

const winnerMeta = partyMeta(data.jurisdiction, data.projection.winner);
const baselineMeta = data.baseline ? partyMeta(data.jurisdiction, data.baseline.winner) : null;

// Who actually HOLDS the seat today, for the "hold / lose / flip" framing.
// The sitting member's current caucus wins over the last-election result when
// they differ (floor-crossing, e.g. Nunavut: elected NDP, now sits Liberal),
// because the projection is about defending the seat as it stands now. Falls
// back to the last-election winner when there is no sitting member.
const sittingParty = data.member && data.member.seat_status !== 'vacant' ? data.member.party_current : null;
const incumbentParty = sittingParty ?? data.baseline?.winner ?? null;
const incumbentMeta = incumbentParty ? partyMeta(data.jurisdiction, incumbentParty) : null;

/** Naked party label, used in subject position. */
function naked(meta: ReturnType<typeof partyMeta>, l: 'en' | 'fr' | 'es'): string {
  return l === 'fr' ? meta.label_fr : meta.label_en;
}
/** Genitive / referential mention, used after "lose/hold/replace". */
function mention(meta: ReturnType<typeof partyMeta>, l: 'en' | 'fr' | 'es'): string {
  if (l === 'fr') return meta.mention_fr ?? `du Parti ${meta.label_fr}`;
  if (l === 'es') return meta.mention_es ?? `el Partido ${meta.label_en}`;
  return meta.mention_en ?? `the ${meta.label_en} Party`;
}
/** French interrogative inversion with subject-verb agreement.
 *  `verbSing`/`verbPlural` are the 3rd-person present forms; `euphonicT` adds the
 *  "-t-" liaison for singular verbs ending in a vowel (conserve-t-il, not perd-il). */
function inflectFr(genitive: string, verbSing: string, verbPlural: string, euphonicT: boolean): string {
  const { pron, plural } = agreementFr(genitive);
  return plural ? `${verbPlural}-${pron}` : `${verbSing}${euphonicT ? '-t-' : '-'}${pron}`;
}

const winnerLabel = naked(winnerMeta, lang);
const baselineLabel = baselineMeta ? naked(baselineMeta, lang) : null;
const incumbentLabel = incumbentMeta ? naked(incumbentMeta, lang) : null;

const isVacant = data.member?.seat_status === 'vacant' || (!data.member && !!data.isByelection);
const isByelection = !!data.isByelection;
const isFlip = incumbentMeta && data.projection.winner !== incumbentParty;
const isTossup = data.projection.p_close_race >= 0.35;
const isSafe = data.projection.p_winner >= 0.85;

let questionEn = '';
let questionFr = '';
let questionEs = '';

// Topic-label format: the riding name is a label before the colon, so it never
// needs a grammatical article ("le Nunavut", "la Géorgie") — the question body
// uses a generic "ce siège" / "este escaño" / "this seat". Works for any name
// in any language, no per-riding metadata. FR keeps its " : " and " ?" spacing.
if (isVacant && isByelection && data.byelectionDate) {
  // Byelection with a known date — lean on baseline as the most reliable label.
  if (baselineLabel) {
    questionEn = `${name}: who succeeds ${mention(baselineMeta!, 'en')}?`;
    questionFr = `${name} : qui succède ${datifFr(mention(baselineMeta!, 'fr'))} ?`;
    questionEs = `${name}: ¿quién sucede ${aEs(mention(baselineMeta!, 'es'))}?`;
  } else {
    questionEn = `${name}: who wins this byelection?`;
    questionFr = `${name} : qui remporte cette partielle ?`;
    questionEs = `${name}: ¿quién gana esta elección extraordinaria?`;
  }
} else if (isVacant) {
  questionEn = `${name}: who wins this open seat?`;
  questionFr = `${name} : qui remporte ce siège vacant ?`;
  questionEs = `${name}: ¿quién gana este escaño vacante?`;
} else if (isTossup) {
  questionEn = `${name}: who wins this toss-up?`;
  questionFr = `${name} : qui l'emporte dans cette course incertaine ?`;
  questionEs = `${name}: ¿quién gana esta carrera reñida?`;
} else if (isFlip && incumbentMeta) {
  questionEn = `${name}: will ${incumbentLabel} lose this seat to ${winnerLabel}?`;
  questionFr = `${name} : ${subjectFr(mention(incumbentMeta, 'fr'))} ${inflectFr(mention(incumbentMeta, 'fr'), 'perd', 'perdent', false)} ce siège au profit ${mention(winnerMeta, 'fr')} ?`;
  questionEs = `${name}: ¿${mention(incumbentMeta, 'es')} ${isPluralEs(mention(incumbentMeta, 'es')) ? 'pierden' : 'pierde'} este escaño frente ${aEs(mention(winnerMeta, 'es'))}?`;
} else if (isSafe) {
  questionEn = `${name}: a safe seat for ${mention(winnerMeta, 'en')}?`;
  questionFr = `${name} : un siège sûr pour ${subjectFr(mention(winnerMeta, 'fr'))} ?`;
  questionEs = `${name}: ¿un escaño seguro para ${mention(winnerMeta, 'es')}?`;
} else {
  // Leaning — competitive but a clear favourite.
  questionEn = `${name}: can ${mention(winnerMeta, 'en')} hold this seat?`;
  questionFr = `${name} : ${subjectFr(mention(winnerMeta, 'fr'))} ${inflectFr(mention(winnerMeta, 'fr'), 'conserve', 'conservent', true)} ce siège ?`;
  questionEs = `${name}: ¿${isPluralEs(mention(winnerMeta, 'es')) ? 'pueden' : 'puede'} ${mention(winnerMeta, 'es')} conservar este escaño?`;
}

const question = { en: questionEn, fr: questionFr, es: questionEs }[lang];
const eyebrow = { en: 'The question', fr: 'La question', es: 'La pregunta' }[lang];
---

<section class="riding-question">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{question}</h2>
  </div>
</section>

<style>
  .riding-question {
    padding: 32px 0 16px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  h2 {
    margin: 6px 0 0;
    font-family: var(--serif);
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 420;
    letter-spacing: -0.01em;
    line-height: 1.15;
    max-width: 900px;
    color: var(--ink);
  }
</style>
