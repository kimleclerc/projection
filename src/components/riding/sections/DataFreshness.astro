---
import type { RidingData } from '../../../lib/riding-adapters/types';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.runDate) return null;

const LOCALE = { en: 'en-CA', fr: 'fr-CA', es: 'es-ES' }[lang];
const formatted = new Intl.DateTimeFormat(
  LOCALE,
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }
).format(new Date(data.runDate));

const T = {
  en: { label: 'Last model run', cycle: 'Cycle' },
  fr: { label: 'Dernière exécution du modèle', cycle: 'Cycle' },
  es: { label: 'Última ejecución del modelo', cycle: 'Ciclo' },
}[lang];
---

<section class="data-freshness">
  <div class="container">
    <dl>
      <div>
        <dt>{T.label}</dt>
        <dd><time datetime={data.runDate}>{formatted}</time></dd>
      </div>
      <div>
        <dt>{T.cycle}</dt>
        <dd><code>{data.cycle}</code></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .data-freshness {
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin: 0;
  }
  div { display: flex; flex-direction: column; gap: 4px; }
  dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0;
  }
  dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
  }
  code { font-size: 13px; }
</style>
