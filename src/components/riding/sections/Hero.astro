---
import { usStateName } from '../../../lib/place-names';
import { regionLabel, UK_NATIONS } from '../../../lib/riding-adapters/regions';
import type { RidingData } from '../../../lib/riding-adapters/types';
import RidingShape from './RidingShape.astro';
import FollowButton from '../../../islands/FollowButton.tsx';
import { FOLLOW_ELECTIONS } from '../../../lib/follow';
import { placeName } from '../../../lib/place-names';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const name = lang === 'fr' ? data.name.fr : data.name.en;
// Suivi : seulement pour les scrutins listés dans FOLLOW_ELECTIONS.
const canFollow = !!FOLLOW_ELECTIONS[data.jurisdiction];
const followNames = { fr: data.name.fr, en: data.name.en, es: placeName({ name_en: data.name.en, name_fr: data.name.fr }, 'es') };
const followSnap = data.results
  ? { w: data.results.winner, p: 1, d: data.results.date, final: true }
  : { w: data.projection.winner, p: Math.round(data.projection.p_winner * 1000) / 1000, d: data.runDate ?? '' };

const PROVINCE_PREFIX_EN: Record<string, string> = {
  'federal-ca': 'Federal riding —',
  'quebec':     'Provincial riding —',
  'ontario':    'Provincial riding —',
  'british-columbia': 'Provincial riding —',
  'uk':         'UK constituency —',
  'us-house':   'US House district —',
  'us-senate':  'US Senate seat —',
  'us-governor': 'Governor race —',
  'france':     'Circonscription française —',
};
const PROVINCE_PREFIX_FR: Record<string, string> = {
  'federal-ca': 'Circonscription fédérale —',
  'quebec':     'Circonscription provinciale —',
  'ontario':    'Circonscription provinciale —',
  'british-columbia': 'Circonscription provinciale —',
  'uk':         'Circonscription britannique —',
  'us-house':   'District de la Chambre des représentants —',
  'us-senate':  'Siège au Sénat américain —',
  'us-governor': 'Course au gouvernorat —',
  'france':     'Circonscription française —',
};
const PROVINCE_PREFIX_ES: Record<string, string> = {
  'federal-ca': 'Distrito federal —',
  'quebec':     'Distrito provincial —',
  'ontario':    'Distrito provincial —',
  'british-columbia': 'Distrito provincial —',
  'uk':         'Circunscripción británica —',
  'us-house':   'Distrito de la Cámara de EE. UU. —',
  'us-senate':  'Escaño del Senado de EE. UU. —',
  'us-governor': 'Contienda por la gobernación —',
  'france':     'Circunscripción francesa —',
};
const PROVINCE_PREFIX_BY_LANG = { en: PROVINCE_PREFIX_EN, fr: PROVINCE_PREFIX_FR, es: PROVINCE_PREFIX_ES };
// « Profil de circonscription » ne veut rien dire pour un poste exécutif : un
// gouverneur ne représente pas un district, il dirige un État.
const IS_EXECUTIVE_RACE = data.jurisdiction === 'us-governor';
const T = {
  en: {
    eyebrow: data.isByelection ? 'Byelection' : IS_EXECUTIVE_RACE ? 'Race profile' : 'Riding profile',
    province_prefix: PROVINCE_PREFIX_EN[data.jurisdiction] ?? 'Federal riding —',
    urban: { urban: 'Urban', rural: 'Rural', mixed: 'Mixed', suburban: 'Suburban' } as Record<string, string>,
  },
  fr: {
    eyebrow: data.isByelection ? 'Élection partielle' : IS_EXECUTIVE_RACE ? 'Profil de course' : 'Profil de circonscription',
    province_prefix: PROVINCE_PREFIX_FR[data.jurisdiction] ?? 'Circonscription fédérale —',
    urban: { urban: 'Urbaine', rural: 'Rurale', mixed: 'Mixte', suburban: 'Banlieue' } as Record<string, string>,
  },
  es: {
    eyebrow: data.isByelection ? 'Elección extraordinaria' : IS_EXECUTIVE_RACE ? 'Perfil de contienda' : 'Perfil del distrito',
    province_prefix: PROVINCE_PREFIX_ES[data.jurisdiction] ?? 'Distrito federal —',
    urban: { urban: 'Urbano', rural: 'Rural', mixed: 'Mixto', suburban: 'Suburbano' } as Record<string, string>,
  },
}[lang];

// Un champ géographique absent traverse pandas puis JSON sous la forme de la
// chaîne « nan ». Elle s'affichait telle quelle, en majuscules, à côté du nom
// de la circonscription — constaté en Colombie-Britannique, dont la table géo
// ne porte volontairement pas de classement urbain/rural faute de source.
const regionName = regionLabel(data.jurisdiction, data.region, lang);
const urbanValue = data.urban_rural && data.urban_rural.toLowerCase() !== 'nan'
  ? data.urban_rural : null;
const urbanLabel = urbanValue ? (T.urban[urbanValue] ?? urbanValue) : null;
---

<section class="riding-hero vs-page-head">
  <div class="container hero-grid">
    <div>
      <h1>{name}</h1>
      <p class="meta">
        {T.province_prefix} <strong>{UK_NATIONS[data.province]?.[lang] ?? usStateName(data.province, lang) ?? data.province}</strong>
        {urbanLabel && <> · {urbanLabel}</>}
        {regionName && <> · <span class="region">{regionName}</span></>}
      </p>
      {canFollow && <FollowButton client:idle lang={lang} j={data.jurisdiction} id={data.id} slug={data.slug} name={followNames} snap={followSnap} />}
    </div>
    {data.shapePath && <RidingShape data={data} lang={lang} />}
  </div>
</section>

<style>
  :global(.follow-row) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 16px 0 0; }
  .riding-hero {
    padding: 64px 0 32px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
  }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
  }
  h1 {
    margin: 8px 0 12px;
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .meta {
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
  }
  /* La capitalisation vit dans regionLabel() : un nom déclaré doit garder
     sa casse (« Vallée du Fraser », pas « Vallée Du Fraser »). */
</style>
