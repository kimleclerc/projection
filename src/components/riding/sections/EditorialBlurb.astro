---
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr';
}

const { data, lang } = Astro.props;
const name = lang === 'fr' ? data.name.fr : data.name.en;
const winnerMeta = partyMeta(data.jurisdiction, data.projection.winner);
const winnerLabel = lang === 'fr' ? winnerMeta.label_fr : winnerMeta.label_en;
const baselineMeta = data.baseline ? partyMeta(data.jurisdiction, data.baseline.winner) : null;
const baselineLabel = baselineMeta ? (lang === 'fr' ? baselineMeta.label_fr : baselineMeta.label_en) : null;
const top = data.parties[0];
const second = data.parties[1];
const topLabel = top ? (lang === 'fr' ? top.label_fr : top.label_en) : '';
const secondLabel = second ? (lang === 'fr' ? second.label_fr : second.label_en) : '';

const urban = data.urban_rural ?? 'mixed';
const provinceCode = data.province ?? '';

const URBAN_LABEL_FR: Record<string, string> = { urban: 'urbaine', rural: 'rurale', mixed: 'mixte', suburban: 'de banlieue' };
const URBAN_LABEL_EN: Record<string, string> = { urban: 'urban', rural: 'rural', mixed: 'mixed', suburban: 'suburban' };
const urbanFR = URBAN_LABEL_FR[urban] ?? urban;
const urbanEN = URBAN_LABEL_EN[urban] ?? urban;

const PROVINCE_FR: Record<string, string> = {
  NL: 'de Terre-Neuve-et-Labrador', PE: 'de l\'Île-du-Prince-Édouard', NS: 'de la Nouvelle-Écosse',
  NB: 'du Nouveau-Brunswick', QC: 'du Québec', ON: 'de l\'Ontario',
  MB: 'du Manitoba', SK: 'de la Saskatchewan', AB: 'de l\'Alberta',
  BC: 'de la Colombie-Britannique', YT: 'du Yukon', NT: 'des Territoires du Nord-Ouest', NU: 'du Nunavut',
};
const PROVINCE_EN: Record<string, string> = {
  NL: 'Newfoundland and Labrador', PE: 'Prince Edward Island', NS: 'Nova Scotia',
  NB: 'New Brunswick', QC: 'Quebec', ON: 'Ontario',
  MB: 'Manitoba', SK: 'Saskatchewan', AB: 'Alberta',
  BC: 'British Columbia', YT: 'Yukon', NT: 'Northwest Territories', NU: 'Nunavut',
};
const provinceFR = PROVINCE_FR[provinceCode] ?? provinceCode;
const provinceEN = PROVINCE_EN[provinceCode] ?? provinceCode;

const competitivenessFR =
  data.projection.p_close_race >= 0.35
    ? 'la course pourrait basculer'
    : data.projection.p_close_race >= 0.15
    ? 'la circonscription reste compétitive'
    : 'la probabilité de course serrée est nulle';
const competitivenessEN =
  data.projection.p_close_race >= 0.35
    ? 'the race could swing'
    : data.projection.p_close_race >= 0.15
    ? 'the riding remains competitive'
    : 'the probability of a close race is negligible';

const blurbFR = [
  `${name}, circonscription ${urbanFR} ${provinceFR}, ${baselineLabel ? `a élu un·e député·e du Parti ${baselineLabel.toLowerCase()} lors du scrutin précédent avec une marge de ${data.baseline!.margin.toFixed(0)} points` : 'arrive sans baseline directe pour le cycle courant'}.`,
  `Le modèle Vote-Scope projette le Parti ${winnerLabel.toLowerCase()} en tête avec ${top?.vote_mean_pct.toFixed(0)} % d'intentions de vote, contre ${second?.vote_mean_pct.toFixed(0)} % pour le Parti ${secondLabel.toLowerCase()}, et ${competitivenessFR}.`,
  data.demographics?.francophone_pct !== undefined
    ? `Profil linguistique : ${data.demographics.francophone_pct.toFixed(0)} % francophones, ${data.demographics.anglophone_pct?.toFixed(0) ?? '—'} % anglophones.`
    : null,
].filter(Boolean).join(' ');

const blurbEN = [
  `${name}, an ${urbanEN} riding in ${provinceEN}, ${baselineLabel ? `elected a ${baselineLabel} member in the previous cycle with a ${data.baseline!.margin.toFixed(0)}-point margin` : 'has no direct baseline for the current cycle'}.`,
  `The Vote-Scope model projects the ${winnerLabel} Party ahead at ${top?.vote_mean_pct.toFixed(0)}% vote share, against ${second?.vote_mean_pct.toFixed(0)}% for the ${secondLabel} Party, and ${competitivenessEN}.`,
  data.demographics?.francophone_pct !== undefined
    ? `Linguistic profile: ${data.demographics.francophone_pct.toFixed(0)}% francophone, ${data.demographics.anglophone_pct?.toFixed(0) ?? '—'}% anglophone.`
    : null,
].filter(Boolean).join(' ');

const blurb = lang === 'fr' ? blurbFR : blurbEN;
const eyebrow = lang === 'fr' ? 'Lecture éditoriale' : 'Editorial read';
---

<section class="blurb">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <p class="prose">{blurb}</p>
  </div>
</section>

<style>
  .blurb {
    padding: 48px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .prose {
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 760px;
  }
</style>
