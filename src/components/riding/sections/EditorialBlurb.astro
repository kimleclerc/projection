---
import { certainty } from '../../../lib/riding-certainty';
import { US_STATES, placeNameEs } from '../../../lib/place-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, subjectFr, aEs, deEs } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const name = lang === 'fr' ? data.name.fr : data.name.en;
const winnerMeta = partyMeta(data.jurisdiction, data.projection.winner);
const baselineMeta = data.baseline ? partyMeta(data.jurisdiction, data.baseline.winner) : null;
const top = data.parties[0];
const second = data.parties[1];
const topMeta = top ? partyMeta(data.jurisdiction, top.code) : null;
const secondMeta = second ? partyMeta(data.jurisdiction, second.code) : null;

/** Editorial reference: prefer the per-party `mention_*` field; fall back
 *  to a generic "Parti X" / "X Party" / "el Partido X" pattern using the label. */
function mention(meta: ReturnType<typeof partyMeta> | null, l: 'en' | 'fr' | 'es', fallbackLabel: string): string {
  if (!meta) return '';
  if (l === 'fr') return meta.mention_fr ?? `du Parti ${fallbackLabel.toLowerCase()}`;
  if (l === 'es') return meta.mention_es ?? `el Partido ${fallbackLabel}`;
  return meta.mention_en ?? `the ${fallbackLabel} Party`;
}
function naked(meta: ReturnType<typeof partyMeta> | null, l: 'en' | 'fr' | 'es'): string {
  if (!meta) return '';
  return l === 'fr' ? meta.label_fr : meta.label_en;
}
const winnerMentionFr = mention(winnerMeta, 'fr', winnerMeta.label_fr);
const winnerMentionEn = mention(winnerMeta, 'en', winnerMeta.label_en);
const baselineMentionFr = baselineMeta ? mention(baselineMeta, 'fr', baselineMeta.label_fr) : null;
const baselineMentionEn = baselineMeta ? mention(baselineMeta, 'en', baselineMeta.label_en) : null;
const topMentionFr = topMeta ? mention(topMeta, 'fr', topMeta.label_fr) : '';
const topMentionEn = topMeta ? mention(topMeta, 'en', topMeta.label_en) : '';
const secondMentionFr = secondMeta ? mention(secondMeta, 'fr', secondMeta.label_fr) : '';
const secondMentionEn = secondMeta ? mention(secondMeta, 'en', secondMeta.label_en) : '';
const winnerMentionEs = mention(winnerMeta, 'es', winnerMeta.label_en);
const baselineMentionEs = baselineMeta ? mention(baselineMeta, 'es', baselineMeta.label_en) : null;
const topMentionEs = topMeta ? mention(topMeta, 'es', topMeta.label_en) : '';
const secondMentionEs = secondMeta ? mention(secondMeta, 'es', secondMeta.label_en) : '';

// `?? 'mixed'` ne rattrape pas la chaîne « nan » : une case vide de pandas
// traverse le JSON sous ce nom et se retrouvait dans la prose.
const urbanRaw = data.urban_rural;
const urban = urbanRaw && urbanRaw.toLowerCase() !== 'nan' ? urbanRaw : 'mixed';
const provinceCode = data.province ?? '';

const URBAN_LABEL_FR: Record<string, string> = { urban: 'urbaine', rural: 'rurale', mixed: 'mixte', suburban: 'de banlieue' };
const URBAN_LABEL_EN: Record<string, string> = { urban: 'urban', rural: 'rural', mixed: 'mixed', suburban: 'suburban' };
const URBAN_LABEL_ES: Record<string, string> = { urban: 'urbano', rural: 'rural', mixed: 'mixto', suburban: 'suburbano' };
const URBAN_LABEL_FR_M: Record<string, string> = { urban: 'urbain', rural: 'rural', mixed: 'mixte', suburban: 'de banlieue' };
const urbanFR = (data.jurisdiction === 'us-house' ? URBAN_LABEL_FR_M : URBAN_LABEL_FR)[urban] ?? urban;
const urbanEN = URBAN_LABEL_EN[urban] ?? urban;
const urbanES = URBAN_LABEL_ES[urban] ?? urban;

const PROVINCE_FR: Record<string, string> = {
  // Canadian provinces
  NL: 'de Terre-Neuve-et-Labrador', PE: 'de l\'Île-du-Prince-Édouard', NS: 'de la Nouvelle-Écosse',
  NB: 'du Nouveau-Brunswick', QC: 'du Québec', ON: 'de l\'Ontario',
  MB: 'du Manitoba', SK: 'de la Saskatchewan', AB: 'de l\'Alberta',
  BC: 'de la Colombie-Britannique', YT: 'du Yukon', NT: 'des Territoires du Nord-Ouest', NU: 'du Nunavut',
  // UK nations (set via adapter from `raw.nation`)
  England: 'd\'Angleterre', Scotland: 'd\'Écosse', Wales: 'du Pays de Galles', 'Northern Ireland': 'd\'Irlande du Nord',
};
const PROVINCE_EN: Record<string, string> = {
  // Canadian provinces
  NL: 'Newfoundland and Labrador', PE: 'Prince Edward Island', NS: 'Nova Scotia',
  NB: 'New Brunswick', QC: 'Quebec', ON: 'Ontario',
  MB: 'Manitoba', SK: 'Saskatchewan', AB: 'Alberta',
  BC: 'British Columbia', YT: 'Yukon', NT: 'Northwest Territories', NU: 'Nunavut',
  // UK nations
  England: 'England', Scotland: 'Scotland', Wales: 'Wales', 'Northern Ireland': 'Northern Ireland',
};
const PROVINCE_ES: Record<string, string> = {
  // Canadian provinces (genitive: "de Quebec", "de Ontario", "del Yukón"…)
  NL: 'de Terranova y Labrador', PE: 'de la Isla del Príncipe Eduardo', NS: 'de Nueva Escocia',
  NB: 'de Nuevo Brunswick', QC: 'de Quebec', ON: 'de Ontario',
  MB: 'de Manitoba', SK: 'de Saskatchewan', AB: 'de Alberta',
  BC: 'de la Columbia Británica', YT: 'del Yukón', NT: 'de los Territorios del Noroeste', NU: 'de Nunavut',
  // UK nations
  England: 'de Inglaterra', Scotland: 'de Escocia', Wales: 'del País de Gales', 'Northern Ireland': 'de Irlanda del Norte',
};
const usState = US_STATES[provinceCode];
const provinceFR = PROVINCE_FR[provinceCode] ?? usState?.frDe ?? provinceCode;
const provinceEN = PROVINCE_EN[provinceCode] ?? usState?.en ?? provinceCode;
const provinceES = PROVINCE_ES[provinceCode] ?? (usState ? `de ${placeNameEs(usState.en)}` : provinceCode);

const isUK = data.jurisdiction === 'uk';
// LA PHRASE D'OUVERTURE PORTAIT UN FAIT FAUX. Le gabarit générique écrivait
// « le Michigan a élu un·e député·e des Démocrates lors du scrutin précédent » :
// le Michigan a élu une GOUVERNEURE, et l'État n'est pas une circonscription
// mixte. Sur un poste exécutif, la première phrase est donc reconstruite.
const isGovernor = data.jurisdiction === 'us-governor';
const isUSHouse = data.jurisdiction === 'us-house';
const ridingWordFR = isUSHouse ? 'district' : 'circonscription';
const ridingWordEN = isUK ? 'constituency' : isUSHouse ? 'district' : 'riding';
const ridingWordES = isUK ? 'circunscripción' : 'distrito';

const tier = certainty(data.projection);
const competitivenessFR = {
  tossup: 'la course pourrait basculer',
  competitive: isGovernor ? 'la course reste compétitive' : isUSHouse ? 'le district reste compétitif' : 'la circonscription reste compétitive',
  safe: 'son avance paraît solide',
}[tier];
const competitivenessEN = {
  tossup: 'the race could swing',
  competitive: isGovernor ? 'the race remains competitive' : `the ${ridingWordEN} remains competitive`,
  safe: 'the lead looks solid',
}[tier];
const competitivenessES = {
  tossup: 'la carrera podría dar la vuelta',
  competitive: isGovernor ? 'la carrera sigue competitiva' : 'el distrito sigue competitivo',
  safe: 'su ventaja parece sólida',
}[tier];

/** Redistricting tail: "Cette circonscription est composée des anciennes
 *  Granby (100 %) et Brome-Missisquoi (24 %)." Surfaced only when origin
 *  is fragmented (adapter strips ≥95% single-source cases). */
const origin = data.redistrictingOrigin;
function originSentence(l: 'en' | 'fr' | 'es'): string | null {
  if (!origin || origin.length === 0) return null;
  const pieces = origin.map((o) => {
    const n = l === 'fr' ? o.old_name_fr : (o.old_name_en || o.old_name_fr);
    const p = Math.round(o.overlap_pct * 100);
    return `${n} (${p} %)`;
  });
  if (l === 'fr') {
    const list = pieces.length === 1
      ? pieces[0]
      : pieces.slice(0, -1).join(', ') + ' et ' + pieces[pieces.length - 1];
    return `Cette circonscription est composée des anciennes ${list}.`;
  }
  if (l === 'es') {
    const list = pieces.length === 1
      ? pieces[0]
      : pieces.slice(0, -1).join(', ') + ' y ' + pieces[pieces.length - 1];
    return `Este distrito está compuesto por fragmentos de los antiguos ${list}.`;
  }
  const list = pieces.length === 1
    ? pieces[0]
    : pieces.slice(0, -1).join(', ') + ' and ' + pieces[pieces.length - 1];
  return `This riding is composed of fragments of the former ${list}.`;
}

const openingFR = isGovernor
  // Formulation sans genre ni écriture inclusive : on parle de la victoire, pas de la personne.
  ? `${name} : ${baselineMentionFr ? `à la dernière élection du gouverneur, victoire ${baselineMentionFr} par ${data.baseline!.margin.toFixed(0)} points` : "pas d'élection comparable à la dernière course"}.`
  : `${name}, ${ridingWordFR} ${urbanFR} ${provinceFR} : ${baselineMentionFr ? `au scrutin précédent, victoire ${baselineMentionFr} par ${data.baseline!.margin.toFixed(0)} points` : 'pas de résultat comparable au scrutin précédent'}.`;

const blurbFR = [
  openingFR,
  `Le modèle Vote-Scope projette ${subjectFr(winnerMentionFr)} en tête avec ${top?.vote_mean_pct.toFixed(0)} % d'intentions de vote, contre ${second?.vote_mean_pct.toFixed(0)} % pour ${subjectFr(secondMentionFr)}, et ${competitivenessFR}.`,
  data.demographics?.francophone_pct !== undefined
    ? `Profil linguistique : ${data.demographics.francophone_pct.toFixed(0)} % francophones, ${data.demographics.anglophone_pct?.toFixed(0) ?? '—'} % anglophones.`
    : null,
  originSentence('fr'),
].filter(Boolean).join(' ');

const openingEN = isGovernor
  ? `${name}: ${baselineMentionEn ? `${baselineMentionEn} won the last governor's race by ${data.baseline!.margin.toFixed(0)} points` : 'no comparable previous race'}.`
  : `${name}, ${'aeiou'.includes(urbanEN[0]) ? 'an' : 'a'} ${urbanEN} ${ridingWordEN} in ${provinceEN}: ${baselineMentionEn ? `${baselineMentionEn} won it by ${data.baseline!.margin.toFixed(0)} points at the previous election` : 'no comparable result from the previous election'}.`;

const blurbEN = [
  openingEN,
  `The Vote-Scope model projects ${winnerMentionEn} ahead at ${top?.vote_mean_pct.toFixed(0)}% vote share, against ${second?.vote_mean_pct.toFixed(0)}% for ${secondMentionEn}, and ${competitivenessEN}.`,
  data.demographics?.francophone_pct !== undefined
    ? `Linguistic profile: ${data.demographics.francophone_pct.toFixed(0)}% francophone, ${data.demographics.anglophone_pct?.toFixed(0) ?? '—'}% anglophone.`
    : null,
  originSentence('en'),
].filter(Boolean).join(' ');

const openingES = isGovernor
  ? `${name}: ${baselineMentionEs ? `en la última elección a gobernador, victoria ${deEs(baselineMentionEs)} por ${data.baseline!.margin.toFixed(0)} puntos` : 'sin elección comparable'}.`
  : `${name}, ${ridingWordES} ${urbanES} ${provinceES}: ${baselineMentionEs ? `en la elección anterior, victoria ${deEs(baselineMentionEs)} por ${data.baseline!.margin.toFixed(0)} puntos` : 'sin resultado comparable de la elección anterior'}.`;

const blurbES = [
  openingES,
  `El modelo Vote-Scope proyecta ${aEs(winnerMentionEs)} a la cabeza con ${top?.vote_mean_pct.toFixed(0)} % de intención de voto, frente al ${second?.vote_mean_pct.toFixed(0)} % ${deEs(secondMentionEs)}, y ${competitivenessES}.`,
  data.demographics?.francophone_pct !== undefined
    ? `Perfil lingüístico: ${data.demographics.francophone_pct.toFixed(0)} % francófonos, ${data.demographics.anglophone_pct?.toFixed(0) ?? '—'} % anglófonos.`
    : null,
  originSentence('es'),
].filter(Boolean).join(' ');

const blurb = { en: blurbEN, fr: blurbFR, es: blurbES }[lang];
const eyebrow = '';
---

<section class="blurb">
  <div class="container">
    <p class="prose">{blurb}</p>
  </div>
</section>

<style>
  .blurb {
    padding: 48px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .prose {
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 760px;
  }
</style>
