---
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
// `us_governor_2022`.replace('_', ' ') donnait « US GOVERNOR_2022 » : un seul
// underscore remplacé, le reste tel quel. Ce qui intéresse le lecteur est
// l'ANNÉE, et pour les gouverneurs elle n'est pas la même partout (2024 au
// New Hampshire et au Vermont, qui votent tous les deux ans).
const cycleYear = /(\d{4})$/.exec(String(data.baseline?.cycle ?? ''))?.[1];
const cycleLabel = cycleYear
  ?? String(data.baseline?.cycle ?? '').replace(/_/g, ' ').toUpperCase();
if (!data.baseline) return null;

const winnerMeta = partyMeta(data.jurisdiction, data.baseline.winner);
const winnerLabel = lang === 'fr' ? winnerMeta.label_fr : winnerMeta.label_en;
const swing = data.projection.mean_margin - data.baseline.margin;
const swingSign = swing >= 0 ? '+' : '';

const T = {
  en: {
    eyebrow: 'Previous election',
    cycle: cycleLabel,
    won_by: 'Won by',
    margin: 'Margin',
    turnout: 'Turnout',
    swing: 'Margin shift vs current projection',
    pts: 'pts',
  },
  fr: {
    eyebrow: 'Élection précédente',
    cycle: cycleLabel,
    won_by: 'Vainqueur',
    margin: 'Marge',
    turnout: 'Participation',
    swing: 'Variation de marge vs projection actuelle',
    pts: 'pts',
  },
  es: {
    eyebrow: 'Elección anterior',
    cycle: cycleLabel,
    won_by: 'Ganador',
    margin: 'Margen',
    turnout: 'Participación',
    swing: 'Variación de margen vs proyección actual',
    pts: 'pts',
  },
}[lang];
---

<section class="history">
  <div class="container">
    <p class="eyebrow">{T.eyebrow} · {T.cycle}</p>
    <div class="grid">
      <div>
        <dt>{T.won_by}</dt>
        <dd style={`--accent:${winnerMeta.color}`}>
          <span class="dot" aria-hidden="true"></span>{winnerLabel}
        </dd>
      </div>
      <div>
        <dt>{T.margin}</dt>
        <dd>{data.baseline.margin.toFixed(1)} {T.pts}</dd>
      </div>
      {data.baseline.turnout_pct !== undefined && (
        <div>
          <dt>{T.turnout}</dt>
          <dd>{data.baseline.turnout_pct.toFixed(1)}%</dd>
        </div>
      )}
      <div>
        <dt>{T.swing}</dt>
        <dd class={swing >= 0 ? 'positive' : 'negative'}>
          {swingSign}{swing.toFixed(1)} {T.pts}
        </dd>
      </div>
    </div>
  </div>
</section>

<style>
  .history {
    padding: 48px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .grid > div {
    padding: 20px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--card);
  }
  dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 430;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }
  .positive { color: oklch(0.55 0.15 145); }
  .negative { color: oklch(0.55 0.18 30); }
  @media (max-width: 820px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
