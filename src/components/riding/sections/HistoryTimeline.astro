---
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, subjectFr, deEs } from '../../../lib/riding-adapters/parties';
import { points, pct } from '../../../lib/format';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
// `us_governor_2022`.replace('_', ' ') donnait « US GOVERNOR_2022 » : un seul
// underscore remplacé, le reste tel quel. Ce qui intéresse le lecteur est
// l'ANNÉE, et pour les gouverneurs elle n'est pas la même partout (2024 au
// New Hampshire et au Vermont, qui votent tous les deux ans).
const cycleYear = /(\d{4})$/.exec(String(data.baseline?.cycle ?? ''))?.[1];
const cycleLabel = cycleYear
  ?? String(data.baseline?.cycle ?? '').replace(/_/g, ' ').toUpperCase();
if (!data.baseline) return null;

const winnerMeta = partyMeta(data.jurisdiction, data.baseline.winner);
const projMeta = partyMeta(data.jurisdiction, data.projection.winner);
const b = data.baseline;

/** Mention complète (« du Parti libéral », « the Liberal Party », « el Partido Liberal »). */
const mention = (meta: ReturnType<typeof partyMeta>, l: 'en' | 'fr' | 'es') =>
  l === 'fr' ? meta.mention_fr ?? `du ${partyName(meta, 'fr')}`
  : l === 'es' ? meta.mention_es ?? partyName(meta, 'es')
  : meta.mention_en ?? partyName(meta, 'en');
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const title = { en: `Previous election (${cycleLabel})`, fr: `Élection précédente (${cycleLabel})`, es: `Elección anterior (${cycleLabel})` }[lang];
const turnout = b.turnout_pct !== undefined && b.turnout_pct !== null ? pct(b.turnout_pct, lang) : '';
const past = {
  en: `${cap(mention(winnerMeta, 'en'))} won by ${points(b.margin, 'en')}${turnout ? `, with ${turnout} turnout` : ''}.`,
  fr: `Victoire ${mention(winnerMeta, 'fr')} par ${points(b.margin, 'fr')}${turnout ? `, avec une participation de ${turnout}` : ''}.`,
  es: `Victoria ${deEs(mention(winnerMeta, 'es'))} por ${points(b.margin, 'es')}${turnout ? `, con una participación del ${turnout}` : ''}.`,
}[lang];
const now = {
  en: `Our current projection: ${mention(projMeta, 'en')} ahead by ${points(data.projection.mean_margin, 'en')}.`,
  fr: `Notre projection actuelle : ${subjectFr(mention(projMeta, 'fr'))} en tête par ${points(data.projection.mean_margin, 'fr')}.`,
  es: `Nuestra proyección actual: ${mention(projMeta, 'es')} por delante por ${points(data.projection.mean_margin, 'es')}.`,
}[lang];
---

<section class="history" style={`--accent:${winnerMeta.color}`}>
  <div class="container">
    <h2>{title}</h2>
    <p class="history-line"><span class="dot" aria-hidden="true"></span>{past}</p>
    <p class="history-now">{now}</p>
  </div>
</section>

<style>
  .history {
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 { margin: 0 0 12px; font-size: clamp(24px, 3vw, 30px); font-weight: 700; }
  .history-line { margin: 0; display: flex; align-items: baseline; gap: 10px; font-size: 18px; }
  .history-now { margin: 6px 0 0; color: var(--ink-2); font-size: 16px; }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    flex: none;
  }
</style>
