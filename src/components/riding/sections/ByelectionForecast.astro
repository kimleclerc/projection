---
import { partyName } from '../../../lib/party-names';
/**
 * ByelectionForecast — the operative local forecast for a riding that is about
 * to hold a by-election.
 *
 * Placed ABOVE ProjectionPanel: for these seats the general-election
 * projection answers a hypothetical ("if the whole country voted today"),
 * while this one answers the election that is actually coming. The general
 * projection stays on the page directly underneath, so the two readings are
 * comparable rather than one silently replacing the other.
 *
 * The two numbers routinely disagree, and that is the model working, not
 * failing: by-election turnout is differential, and it costs whichever side is
 * demobilised — Liberal-held seats bore it through 2024, Conservative-held
 * seats bear it now.
 */
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, subjectFr } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
const by = data.byelection!;

const favMeta = partyMeta(data.jurisdiction, by.favorite);
const favLabel = partyName(favMeta, lang);
const favPct = Math.round(by.favoriteProbability * 100);
const num1 = (v: number) => v.toLocaleString(lang === 'en' ? 'en-CA' : lang === 'es' ? 'es-ES' : 'fr-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const pctTxt = (v: number | string) => lang === 'en' ? `${v}%` : `${v}\u00a0%`;

const generalWinner = data.projection.winner;
const flips = generalWinner !== by.favorite;

const genMeta = partyMeta(data.jurisdiction, generalWinner);

const dateFmt = by.electionDate
  ? new Date(`${by.electionDate}T12:00:00Z`).toLocaleDateString(
      { en: 'en-CA', fr: 'fr-CA', es: 'es' }[lang],
      { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
    )
  : null;

// Le parti en position de sujet : « le Parti libéral », « the Liberal Party », « el Partido Liberal ».
const subj = (meta: ReturnType<typeof partyMeta>) =>
  lang === 'fr' ? (meta.mention_fr ? subjectFr(meta.mention_fr) : partyName(meta, 'fr'))
  : lang === 'es' ? (meta.mention_es ?? partyName(meta, 'es'))
  : (meta.mention_en ?? partyName(meta, 'en'));
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const T = {
  en: {
    eyebrow: 'The by-election',
    favorite: 'Favourite',
    probability: 'chance of winning',
    margin: 'Average lead',
    unit: 'points',
    shares: 'Projected vote share',
    scheduled: dateFmt ? `Polling day: ${dateFmt}` : 'Polling day not yet set',
    vacant: 'Seat vacant, polling day not yet set',
    expected: 'Departure announced, seat not yet vacant',
    localPoll: 'Includes a local poll',
    departing: (m: string) => `${m} is leaving`,
    why: 'Why the by-election and the general election differ',
    whyBody:
      'Further down, the projection assumes a general election, with every seat voting on the same day. Fewer people vote in a by-election, and the least motivated supporters are the ones who stay home, so the favourite can change.',
    flip: `In a general election, ${subj(genMeta)} would lead; in the by-election, ${subj(favMeta)}.`,
    hold: `${cap(subj(favMeta))} leads in both cases.`,
    open: 'Full by-election forecast',
  },
  fr: {
    eyebrow: 'La partielle',
    favorite: 'Favori',
    probability: 'de chances de l’emporter',
    margin: 'Avance moyenne',
    unit: 'points',
    shares: 'Intentions de vote projetées',
    scheduled: dateFmt ? `Scrutin le ${dateFmt}` : 'Date du scrutin pas encore fixée',
    vacant: 'Siège vacant, date du scrutin pas encore fixée',
    expected: 'Départ annoncé, siège pas encore vacant',
    localPoll: 'Tient compte d’un sondage local',
    departing: (m: string) => `Départ de ${m}`,
    why: 'Pourquoi la partielle et la générale diffèrent',
    whyBody:
      'Plus bas, la projection suppose une élection générale, où tous les sièges votent le même jour. Une partielle attire moins d’électeurs, et ce sont les partisans les moins motivés qui restent chez eux : le favori peut donc changer.',
    flip: `À une élection générale, ${subj(genMeta)} serait en tête ; à la partielle, ${subj(favMeta)}.`,
    hold: `${cap(subj(favMeta))} est en tête dans les deux cas.`,
    open: 'Toute la projection de cette partielle',
  },
  es: {
    eyebrow: 'La elección parcial',
    favorite: 'Favorito',
    probability: 'de probabilidades de ganar',
    margin: 'Ventaja media',
    unit: 'puntos',
    shares: 'Intención de voto proyectada',
    scheduled: dateFmt ? `Votación el ${dateFmt}` : 'Fecha de votación aún sin fijar',
    vacant: 'Escaño vacante, fecha de votación aún sin fijar',
    expected: 'Salida anunciada, escaño aún no vacante',
    localPoll: 'Incluye una encuesta local',
    departing: (m: string) => `Salida de ${m}`,
    why: 'Por qué difieren la parcial y las generales',
    whyBody:
      'Más abajo, la proyección supone unas elecciones generales, en las que todos los escaños votan el mismo día. En una parcial vota menos gente, y son los simpatizantes menos motivados los que se quedan en casa: el favorito puede cambiar.',
    flip: `En unas generales, ${subj(genMeta)} iría en cabeza; en la parcial, ${subj(favMeta)}.`,
    hold: `${cap(subj(favMeta))} va en cabeza en ambos casos.`,
    open: 'Toda la proyección de esta parcial',
  },
}[lang];

const statusLabel =
  by.status === 'scheduled' ? T.scheduled
  : by.status === 'vacant_pending_writ' ? T.vacant
  : T.expected;

const topParties = by.parties.slice(0, 5);
const maxShare = Math.max(1, ...topParties.map((p) => p.voteMean));
---

<section class="by-forecast">
  <div class="container">
    <h2 class="bf-title">{T.eyebrow}</h2>

    <div class="bf-head">
      <div>
        <p class="bf-label">{T.favorite}</p>
        <p class="bf-fav" style={`color:${favMeta.color};`}>{favLabel}</p>
        <p class="bf-prob">{pctTxt(favPct)} {T.probability}</p>
      </div>
      <ul class="bf-meta">
        <li>{statusLabel}</li>
        {by.departingMember && <li>{T.departing(by.departingMember)}</li>}
        {by.meanMargin !== null && <li>{T.margin}{lang === 'fr' ? '\u00a0: ' : ': '}{num1(by.meanMargin)} {T.unit}</li>}
        {by.hasLocalPoll && <li class="bf-poll">{T.localPoll}</li>}
      </ul>
    </div>

    {topParties.length > 0 && (
      <div class="bf-shares">
        <p class="bf-label">{T.shares}</p>
        {topParties.map((p) => {
          const meta = partyMeta(data.jurisdiction, p.party);
          const label = partyName(meta, lang);
          return (
            <div class="bf-row">
              <span class="bf-party">{label}</span>
              <span class="bf-bar">
                <span style={`width:${(p.voteMean / maxShare) * 100}%;background:${meta.color};`} />
              </span>
              <span class="bf-val">{pctTxt(num1(p.voteMean))}</span>
            </div>
          );
        })}
      </div>
    )}

    <div class="bf-why">
      <p class="bf-label">{T.why}</p>
      <p class="bf-verdict">
        {flips ? T.flip : T.hold}
      </p>
      <p class="bf-body">{T.whyBody}</p>
      <p class="bf-open"><a href={by.href[lang]}>{T.open}</a></p>
    </div>
  </div>
</section>

<style>
  .by-forecast {
    padding: 40px 0;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .bf-title { margin: 0 0 16px; font-size: clamp(24px, 3vw, 30px); font-weight: 700; }
  .bf-head {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 8px;
  }

  .bf-label {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .bf-fav {
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-top: 2px;
  }

  .bf-prob {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-2);
    margin-top: 4px;
  }

  .bf-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-3);
    text-align: right;
  }

  .bf-meta li + li { margin-top: 5px; }
  .bf-meta .bf-poll { color: var(--ink); }

  .bf-shares { margin-top: 26px; }

  .bf-row {
    display: grid;
    grid-template-columns: minmax(90px, 150px) 1fr 56px;
    align-items: center;
    gap: 12px;
    margin-top: 7px;
  }

  .bf-party { font-size: 14px; color: var(--ink-2); }

  .bf-bar {
    display: block;
    height: 12px;
    background: var(--rule-2);
    border-radius: 2px;
    overflow: hidden;
  }

  .bf-bar > span { display: block; height: 100%; }

  .bf-val {
    font-family: var(--mono);
    font-size: 13px;
    text-align: right;
    color: var(--ink-2);
  }

  .bf-why {
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .bf-verdict {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.3;
    margin-top: 6px;
  }

  .bf-body {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .bf-open {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  @media (max-width: 640px) {
    .bf-meta { text-align: left; }
    .bf-row { grid-template-columns: minmax(70px, 110px) 1fr 48px; }
  }
</style>
