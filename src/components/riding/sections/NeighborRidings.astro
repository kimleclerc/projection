---
import { ridingName } from '../../../lib/format';
import { placeName } from '../../../lib/place-names';
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.neighbors || data.neighbors.length === 0) return null;
// Une course de gouverneur n'a pas de voisine : l'État EST l'unité. Ce bloc
// montre donc les autres courses de la carte, et il faut le dire.
const isExecutive = data.jurisdiction === 'us-governor';
// La Chambre n'a pas encore de centroïdes : la liste est celle des autres
// districts du même État, pas des voisins. Le Sénat liste sa région.
const isSameState = data.jurisdiction === 'us-house';
const isSameRegion = data.jurisdiction === 'us-senate';

const TONE_LABEL = {
  en: { safe: 'Safe seat', leaning: 'Party favoured', competitive: 'Competitive', tossup: 'Toss-up', vacant: 'Vacant' },
  fr: { safe: 'Siège sûr',   leaning: 'Parti favorisé',  competitive: 'Compétitif', tossup: 'Course serrée', vacant: 'Vacant' },
  es: { safe: 'Escaño seguro', leaning: 'Partido favorito', competitive: 'Competitivo', tossup: 'Carrera reñida', vacant: 'Vacante' },
}[lang];

const T = {
  en: {
    eyebrow: isExecutive ? 'Elsewhere on the map' : 'Around the region',
    title: isExecutive ? 'Other races to watch' : isSameState ? 'Nearby districts' : isSameRegion ? 'Other races in the region' : 'Nearby ridings',
    cta: 'Open',
    hint: 'Party ahead and how sure the projection is.',
  },
  fr: {
    eyebrow: isExecutive ? 'Ailleurs sur la carte' : 'Autour de la région',
    title: isExecutive ? 'Autres courses à suivre' : isSameState ? 'Districts voisins' : isSameRegion ? 'Autres courses de la région' : 'Circonscriptions voisines',
    cta: 'Ouvrir',
    hint: 'Parti en tête et degré de certitude de la projection.',
  },
  es: {
    eyebrow: isExecutive ? 'En el resto del mapa' : 'En la región',
    title: isExecutive ? 'Otras contiendas a seguir' : isSameState ? 'Distritos cercanos' : isSameRegion ? 'Otras contiendas de la región' : 'Distritos cercanos',
    cta: 'Abrir',
    hint: 'Partido en cabeza y grado de certeza de la proyección.',
  },
}[lang];
---

<section class="neighbors">
  <div class="container">
    <h2>{T.title}</h2>
    <p class="hint">{T.hint}</p>

    <ul class="nb-list">
      {data.neighbors.map((n) => {
        const meta = n.tone_party ? partyMeta(data.jurisdiction, n.tone_party) : null;
        const partyLabel = meta ? (partyName(meta, lang)) : null;
        const toneLabel = n.tone ? TONE_LABEL[n.tone] : null;
        const name = ridingName(placeName(n, lang));
        const href = lang === 'fr' ? n.href_fr
                   : (lang === 'es' && n.href_es) ? n.href_es
                   : n.href_en;
        return (
          <li style={meta ? `--accent:${meta.color}` : ''}>
            <a href={href} class="nb-name">{name}</a>
            <span class="nb-lead"><span class="dot" aria-hidden="true"></span>{[partyLabel, toneLabel && toneLabel.toLowerCase()].filter(Boolean).join(', ')}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .neighbors {
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin: 0 0 6px;
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
  }
  .hint { margin: 0 0 16px; color: var(--ink-2); font-size: 15px; }
  .nb-list { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--ink); }
  .nb-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .nb-name { font-weight: 600; color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .nb-name:hover { text-decoration-color: var(--ink); }
  .nb-lead { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); font-size: 15px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent, var(--ink-3)); flex: none; }
</style>
