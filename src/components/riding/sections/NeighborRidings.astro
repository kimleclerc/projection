---
import { placeName } from '../../../lib/place-names';
import { partyName } from '../../../lib/party-names';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta } from '../../../lib/riding-adapters/parties';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
}

const { data, lang } = Astro.props;
if (!data.neighbors || data.neighbors.length === 0) return null;
// Une course de gouverneur n'a pas de voisine : l'État EST l'unité. Ce bloc
// montre donc les autres courses de la carte, et il faut le dire.
const isExecutive = data.jurisdiction === 'us-governor';
// La Chambre n'a pas encore de centroïdes : la liste est celle des autres
// districts du même État, pas des voisins. Le Sénat liste sa région.
const isSameState = data.jurisdiction === 'us-house';
const isSameRegion = data.jurisdiction === 'us-senate';

const TONE_LABEL = {
  en: { safe: 'Safe seat', leaning: 'Party favoured', competitive: 'Competitive', tossup: 'Toss-up', vacant: 'Vacant' },
  fr: { safe: 'Siège sûr',   leaning: 'Parti favorisé',  competitive: 'Compétitif', tossup: 'Course serrée', vacant: 'Vacant' },
  es: { safe: 'Escaño seguro', leaning: 'Partido favorito', competitive: 'Competitivo', tossup: 'Carrera reñida', vacant: 'Vacante' },
}[lang];

const T = {
  en: {
    eyebrow: isExecutive ? 'Elsewhere on the map' : 'Around the region',
    title: isExecutive ? 'Other races to watch' : isSameState ? 'Other districts in this state' : isSameRegion ? 'Other races in the region' : 'Nearby ridings',
    cta: 'Open',
    hint: isExecutive ? 'Party ahead and race rating; each page has the full numbers.' : 'Party ahead and race rating; each riding page has the full numbers.',
  },
  fr: {
    eyebrow: isExecutive ? 'Ailleurs sur la carte' : 'Autour de la région',
    title: isExecutive ? 'Autres courses à suivre' : isSameState ? 'Autres districts de l’État' : isSameRegion ? 'Autres courses de la région' : 'Circonscriptions voisines',
    cta: 'Ouvrir',
    hint: isExecutive ? 'Parti en tête et niveau de certitude ; chaque page donne les chiffres complets.' : isSameState ? 'Parti en tête et niveau de certitude ; la page de chaque district donne les chiffres complets.' : 'Parti en tête et niveau de certitude ; la page de chaque circonscription donne les chiffres complets.',
  },
  es: {
    eyebrow: isExecutive ? 'En el resto del mapa' : 'En la región',
    title: isExecutive ? 'Otras contiendas a seguir' : isSameState ? 'Otros distritos del estado' : isSameRegion ? 'Otras contiendas de la región' : 'Distritos cercanos',
    cta: 'Abrir',
    hint: isExecutive ? 'Partido en cabeza y grado de certeza; cada página tiene las cifras completas.' : 'Partido en cabeza y grado de certeza; la página de cada distrito tiene las cifras completas.',
  },
}[lang];
---

<section class="neighbors">
  <div class="container">
    <h2>{T.title}</h2>
    <p class="hint">{T.hint}</p>

    <ul class="cards">
      {data.neighbors.map((n) => {
        const meta = n.tone_party ? partyMeta(data.jurisdiction, n.tone_party) : null;
        const partyLabel = meta ? (partyName(meta, lang)) : null;
        const toneLabel = n.tone ? TONE_LABEL[n.tone] : null;
        const name = placeName(n, lang);
        // For ES we use the Spanish href when adapters populate it; otherwise
        // fall back to EN. Defaults aim to keep clicks inside the same locale.
        const href = lang === 'fr' ? n.href_fr
                   : (lang === 'es' && n.href_es) ? n.href_es
                   : n.href_en;
        return (
          <li>
            <a href={href} class="card" style={meta ? `--accent:${meta.color}` : ''}>
              <div class="top">
                <span class="dot" aria-hidden="true"></span>
                <span class="name">{name}</span>
              </div>
              <div class="bottom">
                {partyLabel && <span class="party-tone">{partyLabel}</span>}
                {toneLabel && <span class="tone">{toneLabel}</span>}
              </div>
              <span class="cta">{T.cta}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .neighbors {
    padding: 56px 0;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin: 8px 0 6px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hint {
    margin-bottom: 24px;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 13px;
    font-style: italic;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    background: transparent;
    border: 0; border-top: 1px solid var(--rule);
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    transition: transform .15s ease, border-color .15s ease;
    position: relative;
    min-height: 120px;
  }
  .card:hover {
    border-color: var(--accent, var(--ink));
  }
  .top { display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent, var(--ink-2)); }
  .name { font-family: var(--serif); font-size: 18px; font-weight: 460; }
  .bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .party-tone {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--accent, var(--ink-2));
  }
  .tone {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--ink-2);
    font-style: italic;
  }
  .cta {
    align-self: flex-end;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  .card:hover .cta { color: var(--ink); }
</style>
