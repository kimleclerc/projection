---
/**
 * Entrée unique d'une fiche (docs/DESIGN.md § 7, « Fiche de circonscription ») :
 * le nom humain du territoire, où il se trouve, les dates, UNE phrase de réponse,
 * puis les actions. Remplace l'ancien trio Hero + question automatique + bloc du
 * favori, qui répétait trois fois le même message avant les données.
 */
import { usStateName, placeName, caProvinceName } from '../../../lib/place-names';
import { regionLabel, UK_NATIONS } from '../../../lib/riding-adapters/regions';
import type { RidingData } from '../../../lib/riding-adapters/types';
import { partyMeta, datifFr, aEs } from '../../../lib/riding-adapters/parties';
import { certainty, CERTAINTY_LABEL } from '../../../lib/riding-certainty';
import { longDate } from '../../../lib/format';
import { ridingTitle } from '../../../lib/riding-title';
import FollowButton from '../../../islands/FollowButton.tsx';
import RidingShareButton from '../../../islands/RidingShareButton.tsx';
import { FOLLOW_ELECTIONS } from '../../../lib/follow';

interface Props {
  data: RidingData;
  lang: 'en' | 'fr' | 'es';
  /** Résultats officiels connus : pas de phrase de projection ici (ElectionResult suit). */
  results?: boolean;
}
const { data, lang, results = false } = Astro.props;
const L = <T,>(fr: T, en: T, es: T): T => (lang === 'fr' ? fr : lang === 'es' ? es : en);

// ── Nom humain ───────────────────────────────────────────────────────────
const { title, code } = ridingTitle(data, lang);
const usCode = code !== null;

// ── Où ───────────────────────────────────────────────────────────────────
const PREFIX: Record<string, [string, string, string]> = {
  'federal-ca': ['Circonscription fédérale', 'Federal riding', 'Distrito federal'],
  quebec: ['Circonscription provinciale', 'Provincial riding', 'Distrito provincial'],
  ontario: ['Circonscription provinciale', 'Provincial riding', 'Distrito provincial'],
  'british-columbia': ['Circonscription provinciale', 'Provincial riding', 'Distrito provincial'],
  uk: ['Circonscription de Westminster', 'Westminster constituency', 'Circunscripción de Westminster'],
  'us-house': ['Chambre des représentants', 'U.S. House', 'Cámara de Representantes'],
  'us-senate': ['Sénat des États-Unis', 'U.S. Senate', 'Senado de EE. UU.'],
  'us-governor': ['Course au poste de gouverneur', 'Governor’s race', 'Contienda por la gobernación'],
  france: ['Circonscription législative', 'Legislative constituency', 'Circunscripción legislativa'],
};
const prefix = PREFIX[data.jurisdiction] ? L(...PREFIX[data.jurisdiction]) : '';
const provinceLabel = UK_NATIONS[data.province]?.[lang] ?? usStateName(data.province, lang) ?? caProvinceName(data.province, lang) ?? data.province;
const regionRaw = regionLabel(data.jurisdiction === 'federal-ca' ? 'federal' : data.jurisdiction, data.region, lang);
const regionName = regionRaw && regionRaw !== provinceLabel ? regionRaw : '';
const where = [prefix, usCode ? null : provinceLabel, regionName, code].filter(Boolean).join(' · ');

// ── Quand ────────────────────────────────────────────────────────────────
const ELECTION_DAY: Record<string, string> = {
  'us-house': '2026-11-03', 'us-senate': '2026-11-03', 'us-governor': '2026-11-03',
  'british-columbia': '2026-10-24',
};
const voteDay = data.byelection?.electionDate ?? ELECTION_DAY[data.jurisdiction];
const dates = [
  voteDay ? L(`Scrutin le ${longDate(voteDay, 'fr')}`, `Election day ${longDate(voteDay, 'en')}`, `Elección el ${longDate(voteDay, 'es')}`) : null,
  data.runDate && !results ? L(`projection du ${longDate(data.runDate, 'fr')}`, `forecast of ${longDate(data.runDate, 'en')}`, `proyección del ${longDate(data.runDate, 'es')}`) : null,
].filter(Boolean).join(' · ');
const datesLine = dates ? dates.charAt(0).toUpperCase() + dates.slice(1) : '';

// ── La réponse, en une phrase ────────────────────────────────────────────
const by = data.byelection;
const meta = partyMeta(data.jurisdiction, by ? by.favorite : data.projection.winner);
const p = by ? by.favoriteProbability : data.projection.p_winner;
const lead = by ? by.meanMargin : data.projection.mean_margin;
const mention = (l: 'fr' | 'en' | 'es') =>
  l === 'fr' ? meta.mention_fr ?? `du Parti ${meta.label_fr.toLowerCase()}`
  : l === 'es' ? meta.mention_es ?? `el Partido ${meta.label_en}`
  : meta.mention_en ?? `the ${meta.label_en} Party`;
const pW = Math.round(p * 100);
const pTxt = pW >= 100 ? L('plus de 99 %', 'more than 99%', 'más del 99 %') : lang === 'en' ? `${pW}%` : `${pW} %`;
const leadTxt = (lead ?? 0).toLocaleString(lang === 'en' ? 'en-CA' : lang === 'es' ? 'es-ES' : 'fr-CA', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const hasLead = lead != null && lead >= 0.1;
const pointWord = L((lead ?? 0) < 2 ? 'point' : 'points', 'points', 'puntos');
const answer = results ? '' : L(
  `${by ? 'À la partielle, notre' : 'Notre'} projection donne ${pTxt} de chances ${datifFr(mention('fr'))}${hasLead ? `, avec une avance moyenne de ${leadTxt} ${pointWord}` : ''}.`,
  `${by ? 'In the by-election, our' : 'Our'} forecast gives ${mention('en')} a ${pTxt} chance of winning${hasLead ? `, with an average lead of ${leadTxt} ${pointWord}` : ''}.`,
  `${by ? 'En la elección parcial, nuestra' : 'Nuestra'} proyección da ${pTxt} de probabilidades ${aEs(mention('es'))}${hasLead ? `, con una ventaja media de ${leadTxt} ${pointWord}` : ''}.`,
);
const tier = CERTAINTY_LABEL[lang][certainty(data.projection)];
const close = Math.round(data.projection.p_close_race * 100);
const closeTxt = close < 1 ? L('moins de 1 %', 'under 1%', 'menos del 1 %') : lang === 'en' ? `${close}%` : `${close} %`;
const detail = results || by ? '' : L(
  `${tier}. Chances d’un écart final de moins de 5 points : ${closeTxt}.`,
  `${tier}. Chance of a final gap under 5 points: ${closeTxt}.`,
  `${tier}. Probabilidad de una diferencia final inferior a 5 puntos: ${closeTxt}.`,
);

// ── Actions ──────────────────────────────────────────────────────────────
const canFollow = !!FOLLOW_ELECTIONS[data.jurisdiction];
const followNames = { fr: data.name.fr, en: data.name.en, es: placeName({ name_en: data.name.en, name_fr: data.name.fr }, 'es') };
const followSnap = data.results
  ? { w: data.results.winner, p: 1, d: data.results.date, final: true }
  : { w: data.projection.winner, p: Math.round(data.projection.p_winner * 1000) / 1000, d: data.runDate ?? '' };

// Ce que l'image partagée montre : les mêmes chiffres que la page.
const shareParties = (by ? by.parties.map((x) => ({ code: x.party, v: x.voteMean })) : data.parties.map((x) => ({ code: x.code, v: x.vote_mean_pct })))
  .filter((x) => x.v >= 0.5)
  .slice(0, 6)
  .map((x) => { const m = partyMeta(data.jurisdiction, x.code); return { label: lang === 'fr' ? m.label_fr : (lang === 'es' ? (m as { label_es?: string }).label_es ?? m.label_en : m.label_en), color: m.color, v: Math.round(x.v * 10) / 10 }; });
const sharePayload = {
  title, where: [usCode ? provinceLabel : provinceLabel, prefix].filter(Boolean).join(' · '),
  answer: answer.replace(/^À la partielle, notre /, 'Notre ').replace(/^In the by-election, our /, 'Our ').replace(/^En la elección parcial, nuestra /, 'Nuestra '),
  parties: shareParties, date: data.runDate ?? '', voteDay: voteDay ?? '', slug: data.slug, jurisdiction: data.jurisdiction,
  // Le contour seulement s'il reste léger : un tracé trop détaillé alourdirait la page.
  shape: data.shapePath && data.shapePath.length < 20000
    ? { d: data.shapePath, vb: data.shapeViewBox ?? '0 0 1000 1000', color: partyMeta(data.jurisdiction, data.projection.winner).color }
    : undefined,
};
---

<section class="riding-head vs-page-head">
  <div class="container rh-grid">
    <div class="rh-main">
      <h1>{title}</h1>
      <p class="rh-where">{where}</p>
      {datesLine && <p class="rh-dates">{datesLine}</p>}
      {answer && <p class="rh-answer" style={`--accent:${meta.color}`}><span class="dot" aria-hidden="true"></span><span>{answer}</span></p>}
      {detail && <p class="rh-detail">{detail}</p>}
      <div class="rh-actions">
        {canFollow && <FollowButton client:idle lang={lang} j={data.jurisdiction} id={data.id} slug={data.slug} name={followNames} snap={followSnap} />}
        {!results && <RidingShareButton client:idle lang={lang} payload={sharePayload} />}
      </div>
    </div>
    {data.shapePath && (
      <svg class="rh-shape" viewBox={data.shapeViewBox ?? '0 0 1000 1000'} role="img" aria-label={L(`Contour de ${title}`, `Outline of ${title}`, `Contorno de ${title}`)}>
        <path d={data.shapePath} fill={partyMeta(data.jurisdiction, data.projection.winner).color} fill-opacity="0.35"
              stroke={partyMeta(data.jurisdiction, data.projection.winner).color} stroke-width="4" stroke-linejoin="round" />
      </svg>
    )}
  </div>
</section>

<style>
  .riding-head { padding: 36px 0 24px; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .rh-grid { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; }
  h1 { margin: 0 0 8px; font-size: clamp(34px, 5vw, 56px); font-weight: 700; line-height: 1.02; letter-spacing: -0.01em; }
  .rh-where { margin: 0; color: var(--ink-2); font-size: 15px; font-weight: 600; }
  .rh-dates { margin: 4px 0 0; color: var(--ink-3); font-size: 14px; }
  .rh-answer { margin: 18px 0 0; padding-top: 14px; border-top: 3px solid var(--ink); max-width: 720px; display: flex; gap: 10px; align-items: baseline; font-size: 20px; font-weight: 700; line-height: 1.3; }
  .rh-answer .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); flex: none; transform: translateY(-1px); }
  .rh-detail { margin: 6px 0 0; color: var(--ink-2); font-size: 15px; }
  .rh-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 16px; }
  .rh-actions :global(.follow-row) { margin: 0; }
  .rh-shape { width: 120px; height: 120px; display: block; }
  @media (max-width: 700px) {
    .rh-grid { grid-template-columns: 1fr; }
    .rh-shape { display: none; }
    .riding-head { padding: 24px 0 16px; }
  }
</style>
