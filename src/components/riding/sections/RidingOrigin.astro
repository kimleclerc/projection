---
/**
 * Quebec-specific section: shows how the new 2026 riding is composed of
 * fragments of one or more 2022 ridings, via redistribution overlaps.
 * Future-proof for an eventual hybrid 127-seat map: data shape is generic
 * (any old/new mapping with overlap_pct), only the eyebrow copy is QC.
 */
import type { RidingOriginEntry } from '../../../lib/riding-adapters/quebec';

interface Props {
  origin: RidingOriginEntry[];
  lang: 'en' | 'fr';
  newRidingNameFr: string;
}

const { origin, lang, newRidingNameFr } = Astro.props;
if (!origin || origin.length === 0) return null;

// If a single source >=95%, the redistricting is functionally a rename:
// don't add visual noise.
if (origin.length === 1 && origin[0].overlap_pct >= 0.95) return null;

const T = {
  en: {
    eyebrow: 'Riding redistricting',
    title: 'Where this new riding comes from',
    lede: `The 2026 electoral map redrew Quebec's ridings. ${newRidingNameFr} is composed of fragments of the following 2022 ridings:`,
    overlap: 'overlap',
    note: 'Source: Élections Québec — 2026 boundary redistribution. Only sources with at least 20% territorial overlap are listed.',
  },
  fr: {
    eyebrow: 'Redécoupage électoral',
    title: "D'où vient cette nouvelle circonscription",
    lede: `La carte électorale 2026 a redessiné les circonscriptions du Québec. ${newRidingNameFr} est composée de fragments des anciennes circonscriptions suivantes :`,
    overlap: 'recouvrement',
    note: "Source : Élections Québec — redécoupage des limites 2026. Seules les sources avec au moins 20 % de chevauchement territorial sont affichées.",
  },
}[lang];
---

<section class="riding-origin">
  <div class="container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h2>{T.title}</h2>
    <p class="lede">{T.lede}</p>

    <ul class="origin-list">
      {origin.map((entry) => {
        const name = lang === 'fr' ? entry.old_name_fr : (entry.old_name_en || entry.old_name_fr);
        const pct = Math.round(entry.overlap_pct * 100);
        return (
          <li>
            <div class="row">
              <span class="name">{name}</span>
              <span class="pct">{pct}% {T.overlap}</span>
            </div>
            <div class="bar"><span class="fill" style={`width:${pct}%`}></span></div>
          </li>
        );
      })}
    </ul>

    <p class="note">{T.note}</p>
  </div>
</section>

<style>
  .riding-origin {
    padding: 48px 0;
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 10px;
  }
  h2 {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  .lede {
    max-width: 720px;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 24px;
  }
  .origin-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    max-width: 720px;
  }
  .origin-list li {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }
  .name { font-family: var(--serif); font-size: 16px; }
  .pct {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    letter-spacing: .04em;
  }
  .bar {
    height: 6px;
    background: var(--paper-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--accent, #03A9F4);
  }
  .note {
    font-family: var(--serif);
    font-size: 13px;
    font-style: italic;
    color: var(--ink-2);
    margin-top: 12px;
    max-width: 720px;
  }
</style>
