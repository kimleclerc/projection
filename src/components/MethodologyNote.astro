---
interface Props {
  title: string;
  body: string;
  bullets: string[];
}

const { title, body, bullets } = Astro.props;
---

<section class="method-note">
  <div class="container method-inner">
    <div>
      <p class="eyebrow">Methodology after the signal</p>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <ul>
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  </div>
</section>

<style>
  .method-note {
    padding: 64px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .method-inner {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 44px;
  }

  h2 {
    margin-top: 10px;
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  p {
    margin-top: 16px;
    color: var(--ink-2);
    line-height: 1.65;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    list-style: none;
  }

  li {
    min-height: 128px;
    padding: 20px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink-2);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .method-inner,
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
