---
interface Props {
  src: string;
  label: string;
  size?: number;
  decorative?: boolean;
  class?: string;
}

const { src, label, size = 28, decorative = true, class: className = '' } = Astro.props;
---

<span class={`identity-mark ${className}`} style={`--identity-size:${size}px`}>
  <img
    src={src}
    alt={decorative ? '' : label}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
  />
  <span class="sr-only">{decorative ? '' : label}</span>
</span>

<style>
  .identity-mark {
    display: inline-flex;
    flex: 0 0 var(--identity-size);
    width: var(--identity-size);
    height: var(--identity-size);
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: #f5f1e8;
    vertical-align: middle;
  }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
