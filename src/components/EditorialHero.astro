---
interface Props {
  eyebrow: string;
  title: string;
  promise: string;
  question: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow,
  title,
  promise,
  question,
  primaryHref = '',
  primaryLabel = '',
  secondaryHref = '',
  secondaryLabel = '',
} = Astro.props;
---

<section class="editorial-hero">
  <div class="container editorial-hero-inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-promise">{promise}</p>
    </div>
    <aside class="hero-question" aria-label="Page question">
      <span>One page, one question</span>
      <strong>{question}</strong>
      {(primaryHref || secondaryHref) && (
        <div class="hero-actions">
          {primaryHref && <a class="btn-primary" href={primaryHref}>{primaryLabel}</a>}
          {secondaryHref && <a class="btn-outline" href={secondaryHref}>{secondaryLabel}</a>}
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .editorial-hero {
    border-bottom: 1px solid var(--rule);
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--paper) 90%, var(--blue-tint)), var(--paper)),
      var(--paper);
  }

  .editorial-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    gap: 56px;
    align-items: end;
    padding-top: 72px;
    padding-bottom: 64px;
  }

  h1 {
    max-width: 820px;
    margin: 18px 0 0;
    font-family: var(--serif);
    font-size: clamp(48px, 7vw, 92px);
    font-weight: 420;
    letter-spacing: -0.025em;
    line-height: .94;
  }

  .hero-promise {
    max-width: 720px;
    margin-top: 26px;
    color: var(--ink-2);
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.45;
  }

  .hero-question {
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 6px;
    padding: 24px;
    box-shadow: 0 20px 55px -38px rgba(26, 24, 20, .35);
  }

  .hero-question span {
    display: block;
    margin-bottom: 14px;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero-question strong {
    display: block;
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  @media (max-width: 820px) {
    .editorial-hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 48px;
    }
  }
</style>
