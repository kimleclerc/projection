---
import GooglePreferredSource from './GooglePreferredSource.astro';

interface Props {
  eyebrow: string;
  title: string;
  promise: string;
  question: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  preferredSourceLocale?: 'en' | 'fr' | 'es';
  questionLabel?: string;
}

const {
  eyebrow,
  title,
  promise,
  question,
  primaryHref = '',
  primaryLabel = '',
  secondaryHref = '',
  secondaryLabel = '',
  preferredSourceLocale,
  questionLabel,
} = Astro.props;
const label = questionLabel ?? { fr: 'Une page, une question', es: 'Una página, una pregunta' }[preferredSourceLocale ?? 'en'] ?? 'One page, one question';
---

<section class="editorial-hero vs-page-head">
  <div class="container editorial-hero-inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-promise">{promise}</p>
      {preferredSourceLocale && <GooglePreferredSource locale={preferredSourceLocale} />}
    </div>
    <aside class="hero-question" aria-label="Page question">
      <span>{label}</span>
      <strong>{question}</strong>
      {(primaryHref || secondaryHref) && (
        <div class="hero-actions">
          {primaryHref && <a class="btn-primary" href={primaryHref}>{primaryLabel}</a>}
          {secondaryHref && <a class="btn-outline" href={secondaryHref}>{secondaryLabel}</a>}
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .editorial-hero {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .editorial-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    gap: 56px;
    align-items: end;
    padding-top: 72px;
    padding-bottom: 64px;
  }

  h1 {
    max-width: 820px;
    margin: 18px 0 0;
    font-family: var(--serif);
    font-size: clamp(44px, 6.4vw, 84px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .hero-promise {
    max-width: 720px;
    margin-top: 26px;
    color: var(--ink-2);
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.45;
  }

  .hero-question {
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: 2px;
    padding: 24px;
    border-top: 4px solid var(--ink);
  }

  .hero-question span {
    display: block;
    margin-bottom: 14px;
    color: var(--ink-3);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .hero-question strong {
    display: block;
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  @media (max-width: 820px) {
    .editorial-hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 48px;
    }
  }
</style>
