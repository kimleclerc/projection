---
/**
 * PolymarketEmbed — reusable Polymarket iframe component.
 *
 * Props:
 *   slug     — Polymarket event slug (e.g. 'balance-of-power-2026-midterms').
 *              Pass null | "" to render nothing (future-proof empty-slot mode).
 *   title    — Optional eyebrow label shown above the iframe.
 *   subtitle — Optional small note shown below the label (e.g. liquidity warning).
 *   theme    — 'light' (default) | 'dark'
 *   height   — iframe height in px (default 500)
 */
interface Props {
  slug: string | null | undefined;
  title?: string;
  subtitle?: string;
  theme?: 'light' | 'dark';
  height?: number;
  /** Langue de la page — localise l'iframe (&locale) et le lien sortant. */
  lang?: 'en' | 'fr' | 'es';
  /** URL canonique de l'événement Polymarket (forme EN, /event/...). */
  eventUrl?: string;
}

const { slug, title, subtitle, theme = 'light', height = 500, lang = 'en', eventUrl } = Astro.props;

// Polymarket sert l'EN sans préfixe ; FR/ES via /fr/ /es/.
const localizedEventUrl = eventUrl && lang !== 'en'
  ? eventUrl.replace('polymarket.com/event', `polymarket.com/${lang}/event`)
  : eventUrl;
const localeParam = lang !== 'en' ? `&locale=${lang}` : '';
const viewLabel: Record<'en' | 'fr' | 'es', string> = {
  en: 'View on Polymarket →', fr: 'Voir sur Polymarket →', es: 'Ver en Polymarket →',
};
const oddsLabel: Record<'en' | 'fr' | 'es', string> = {
  en: 'Live odds via Polymarket', fr: 'Cotes en direct via Polymarket', es: 'Cuotas en directo vía Polymarket',
};
---

{slug ? (
  <section class="pm-embed">
    {title && <p class="pm-label">{title}</p>}
    {subtitle && <p class="pm-subtitle">{subtitle}</p>}
    <iframe
      src={`https://embed.polymarket.com/market?market=${slug}&height=${height}${theme === 'dark' ? '&theme=dark' : ''}${localeParam}`}
      title={title ?? 'Polymarket prediction market'}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups"
      width="100%"
      height={height}
      style="border:none;border-radius:6px;display:block;"
      allowtransparency="true"
    />
    <p class="pm-attribution">
      {localizedEventUrl && (
        <a href={localizedEventUrl} target="_blank" rel="noopener" class="pm-view">{viewLabel[lang]}</a>
      )}
      <span>{oddsLabel[lang]}</span>
    </p>
  </section>
) : null}

<style>
  .pm-embed {
    margin-block: 48px 0;
  }

  .pm-label {
    margin: 0 0 4px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3, #666);
  }

  .pm-subtitle {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--ink-3, #999);
    font-style: italic;
  }

  .pm-attribution {
    margin: 8px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3, #999);
  }

  .pm-attribution span { margin-left: auto; text-align: right; }

  .pm-view {
    color: var(--ink-3, #999);
    text-decoration: none;
    border-bottom: 1px solid var(--rule, #ddd);
  }

  .pm-view:hover { color: var(--accent, #c00); border-bottom-color: var(--accent, #c00); }
</style>
