---
/**
 * PolymarketEmbed — reusable Polymarket iframe component.
 *
 * Props:
 *   slug     — Polymarket event slug (e.g. 'balance-of-power-2026-midterms').
 *              Pass null | "" to render nothing (future-proof empty-slot mode).
 *   title    — Optional eyebrow label shown above the iframe.
 *   subtitle — Optional small note shown below the label (e.g. liquidity warning).
 *   theme    — 'light' (default) | 'dark'
 *   height   — iframe height in px (default 500)
 */
interface Props {
  slug: string | null | undefined;
  title?: string;
  subtitle?: string;
  theme?: 'light' | 'dark';
  height?: number;
}

const { slug, title, subtitle, theme = 'light', height = 500 } = Astro.props;
---

{slug ? (
  <section class="pm-embed">
    {title && <p class="pm-label">{title}</p>}
    {subtitle && <p class="pm-subtitle">{subtitle}</p>}
    <iframe
      src={`https://embed.polymarket.com/event/${slug}?features=volume&theme=${theme}`}
      title={title ?? 'Polymarket prediction market'}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups"
      width="100%"
      height={height}
      style="border:none;border-radius:6px;display:block;"
    />
    <p class="pm-attribution">Live odds via Polymarket</p>
  </section>
) : null}

<style>
  .pm-embed {
    margin-block: 48px 0;
  }

  .pm-label {
    margin: 0 0 4px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3, #666);
  }

  .pm-subtitle {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--ink-3, #999);
    font-style: italic;
  }

  .pm-attribution {
    margin: 8px 0 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3, #999);
    text-align: right;
  }
</style>
