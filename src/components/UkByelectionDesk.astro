---
// Desk spécial — partielle de Clacton 2026 (Farage vs Count Binface).
// Page étendue : compte à rebours, snapshot modèle vs marchés, projection
// Monte Carlo (moteur run_clacton_special_projection.py), Path to Victory,
// marchés de prédiction, contexte, timeline et sources. Les marchés sont
// affichés en COMPARAISON — jamais des entrées du modèle.
import Base from '../layouts/Base.astro';
import KeepDigging from './KeepDigging.astro';
import ContextualBookShelf from './ContextualBookShelf.astro';
import ElectionCountdown from '../islands/ElectionCountdown.tsx';
import GooglePreferredSource from './GooglePreferredSource.astro';
import ClactonLiveDesk from '../islands/ClactonLiveDesk.tsx';
import ClactonTurnoutCurve from './ClactonTurnoutCurve.astro';
import special from '../../web_data/uk-clacton-special/latest.json';
import clactonLive from '../../web_data/uk-clacton-live/latest.json';
import {
  ukByelectionAlternates,
  type UkByelectionConfig,
  type UkByelectionLocale,
} from '../data/ukByelections';

interface Props {
  lang: UkByelectionLocale;
  config: UkByelectionConfig;
}

const { lang, config } = Astro.props;
const canonical = `https://vote-scope.com${config.paths[lang]}`;
const alternates = ukByelectionAlternates(config);

const sp = special as any;
const model = sp.model;
const meta = sp.meta;
const markets = sp.markets ?? {};

const fmtPct = (v: number, digits = 1) =>
  lang === 'en' ? v.toFixed(digits) : v.toFixed(digits).replace('.', ',');
// Bornes d'affichage : depuis la révision des priors (v0.6), p(Farage) vaut
// 0,9997 et p(Binface) 0,0003. Arrondi tel quel, la page afficherait « 100 % »
// et « 0 % » — ni l'un ni l'autre n'est vrai, et une page de prévision qui
// annonce une certitude est indéfendable. On plafonne le rendu, jamais la
// valeur du modèle.
const PROB_HI = 0.995;
const PROB_LO = 0.005;
const fmtProb = (p: number) => fmtPct(p * 100, p * 100 < 10 ? 1 : 0);
const fmtProbBounded = (p: number): string =>
  p >= PROB_HI ? `> ${fmtPct(99, 0)}` : p > 0 && p <= PROB_LO ? `< ${fmtPct(1, 0)}` : fmtProb(p);

// ── Extraction marchés ──────────────────────────────────────────────────────
const pmEvents = Object.values(markets.polymarket ?? {}) as any[];
const pmWinner = pmEvents.find((e) => /Winner/i.test(e.title ?? ''));
const pmSecond = pmEvents.find((e) => /2nd place/i.test(e.title ?? ''));
const pmBuckets = pmEvents.find((e) => /Vote %/i.test(e.title ?? ''));
const pmImprove = pmEvents.find((e) => /up his vote share/i.test(e.title ?? ''));
const pmYes = (event: any, needle: string): number | null => {
  const m = (event?.markets ?? []).find((x: any) => x.question?.includes(needle));
  return m ? Number(m.yes) : null;
};
const pmFarage = pmYes(pmWinner, 'Nigel Farage');
const pmBinface = pmYes(pmWinner, 'Count Binface');
const pmFarage2nd = pmYes(pmSecond, 'Nigel Farage');
const pmBinface2nd = pmYes(pmSecond, 'Count Binface');
const pmFarageImproves = pmImprove?.markets?.[0] ? Number(pmImprove.markets[0].yes) : null;
const kalshiFarage = markets.kalshi?.farage?.last_price ?? null;
const kalshiBinface = markets.kalshi?.binface?.last_price ?? null;
const bookies = markets.bookies ?? {};
const marketsAsOf = (markets.as_of ?? '').slice(0, 16).replace('T', ' ');

// ── Sondage local de circonscription ────────────────────────────────────────
// Affiché au même rang que les marchés : les lecteurs vont le chercher, et la
// page doit montrer À LA FOIS le chiffre brut et le poids que le modèle lui
// accorde. Contrairement aux marchés, ce sondage ENTRE dans le modèle.
const localPolls = sp.local_polls ?? {};
const hasLocalPoll = localPolls.available === true && (localPolls.polls ?? []).length > 0;
const localPoll = hasLocalPoll ? localPolls.polls[0] : null;
const pollWeight = localPolls.weighting ?? {};
const postalVoting = sp.postal_voting ?? {};
const reformCoupling = model.reform_coupling ?? {};
const localPollNote = hasLocalPoll
  ? (lang === 'fr' ? localPolls.note_fr : lang === 'es' ? localPolls.note_es : localPolls.note_en)
  : '';
const fmtGap = (v: number | null) =>
  v == null ? '—' : `${v > 0 ? '+' : v < 0 ? '−' : ''}${fmtPct(Math.abs(v), 1)}`;

const bucketRows = [
  { key: 'lt10', label: '< 10 %', needle: 'less than 10%' },
  { key: '10_20', label: '10 – 20 %', needle: '10–20%' },
  { key: '20_30', label: '20 – 30 %', needle: '20–30%' },
  { key: '30_40', label: '30 – 40 %', needle: '30–40%' },
  { key: 'gte40', label: '≥ 40 %', needle: 'at least 40%' },
].map((b) => ({
  ...b,
  model: model.binface_share_buckets?.[b.key] ?? 0,
  market: pmYes(pmBuckets, b.needle),
}));

// ── Candidats ───────────────────────────────────────────────────────────────
const candMeta: Record<string, { name: string; tag_en: string; tag_fr: string; tag_es: string; color: string }> = {
  farage: { name: 'Nigel Farage', tag_en: 'Reform UK', tag_fr: 'Reform UK', tag_es: 'Reform UK', color: '#12B6CF' },
  binface: { name: 'Count Binface', tag_en: 'Independent', tag_fr: 'Indépendant', tag_es: 'Independiente', color: '#1a1a1a' },
  fox: { name: 'Laurence Fox', tag_en: 'Reclaim', tag_fr: 'Reclaim', tag_es: 'Reclaim', color: '#7a2048' },
  others: { name: '', tag_en: 'Micro-field (10+ candidates)', tag_fr: 'Micro-champ (10+ candidatures)', tag_es: 'Micro-campo (10+ candidaturas)', color: '#9a938a' },
};
const candOrder = ['farage', 'binface', 'fox', 'others'];

// ── Path to Victory ─────────────────────────────────────────────────────────
// Depuis la révision des priors (v0.6), toutes les conditionnelles valent
// quelques dixièmes de pour cent. Deux conséquences de rendu : (1) une échelle
// absolue donne sept barres invisibles ; on met donc à l'échelle du scénario le
// plus fort, car la section sert à COMPARER les leviers, pas à afficher un
// niveau ; (2) un arrondi à une décimale écrase tout à « 0,0 % ».
const scenarioMax = Math.max(...model.scenarios.map((s: any) => s.p_binface_win ?? 0), 1e-9);
const scenarioBarPct = (p: number) => Math.max(3, Math.min(100, (p / scenarioMax) * 100));
const fmtProbFine = (p: number) => {
  const v = p * 100;
  if (v === 0) return fmtPct(0, 0);
  return v < 1 ? fmtPct(v, 2) : fmtProb(p);
};

