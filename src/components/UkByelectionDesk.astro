    curveNote: 'La participación es la única cifra que el returning officer anuncia antes del resultado. Nuestra previsión supone una participación del orden de la que suele darse en una elección parcial — la banda sombreada. El modelo también indica hacia dónde inclinaría una afluencia inusual: hacia Count Binface, porque los votantes de Farage de 2024 son el bloque al que la afluencia menos mueve, mientras que el resto de la circunscripción debe ser movilizado para acudir. A partir de qué nivel cambiaría el desenlace es precisamente lo que el modelo no logra fijar, por lo que el gráfico no lleva ninguna cifra.',
    reformNote: `Reform UK está en ${fmtPct(reformCoupling.national_reform_now, 1)} % a nivel nacional frente al ancla de ${fmtPct(reformCoupling.national_reform_anchor, 1)} % del modelo. Eso reduce la retención esperada del bloque Farage de 2024 del ${fmtPct(reformCoupling.farage_retention_mean_base * 100, 1)} % al ${fmtPct(reformCoupling.farage_retention_mean_effective * 100, 1)} %. Las transferencias y la participación se simulan bloque por bloque, con un choque común de movilización.`,
    pathLabel: 'Path to victory — ¿cómo podría ganar el cubo de basura?',
    pathIntro: `Punto de partida: Vote-Scope da a Count Binface un ${fmtProbBounded(model.p_binface_win)} % — los mercados dicen ${pmBinface != null ? fmtProb(pmBinface) : '—'} %. Para la sorpresa, varias cosas deben romperse a la vez. Probabilidades condicionales, de las mismas simulaciones:`,
    pathOutro: 'Veredicto: muy improbable — pero es la elección donde lo improbable es más divertido de ver. Si Binface supera el 25 % mientras Farage cae hacia el 40 %, la noche electoral se pone interesante.',
    marketsLabel: 'Mercados de predicción y casas de apuestas',
    marketsIntro: 'Solo comparación externa — los precios de mercado nunca alimentan el modelo. Binface abrió alrededor de 500/1 y bajó a ~5/1 en días.',
    thMarket: 'Mercado', thFarage: 'Farage / Reform', thBinface: 'Count Binface', thNote: 'Nota',
    rowPmWinner: 'Polymarket — ganador', rowPmSecond: 'Polymarket — 2.º puesto', rowKalshi: 'Kalshi — ganador', rowBookies: 'Casas de apuestas (cuotas)',
    secondNote: pmBinface2nd != null ? `Los mercados dan a Binface un ${fmtProb(pmBinface2nd)} % de acabar segundo.` : '',
    bucketLabel: 'Cuota de Binface — modelo vs buckets de Polymarket',
    bucketModel: 'Vote-Scope', bucketMarket: 'Polymarket',
    improveNote: pmFarageImproves != null ? `Polymarket también da a Farage un ${fmtProb(pmFarageImproves)} % de superar su cuota de 2024 (46,2 %) — el modelo coincide, con ${fmtProb(model.p_farage_improves_2024)} %.` : '',
    ctxLabel: 'Por qué existe esta parcial',
    ctxBullets: [
      'Farage renunció el 7 de julio de 2026 en plena investigación parlamentaria: un pago de 5 M£ de Christopher Harborne, posibles regalos en especie, presunto lobby cripto ante el Bank of England y declaraciones de propiedades — los 5 M£ también fueron reportados a la National Crime Agency.',
      'Al renunciar y volver a presentarse, Farage busca un mandato fresco en el momento que ÉL elige — una suspensión posterior aún podría desencadenar una petición de revocatoria y otra parcial.',
      'Labour, Conservadores, Lib Dems, Verdes y Restore Britain boicotean lo que Kemi Badenoch llama una «parcial falsa».',
      'El precedente más cercano: Haltemprice & Howden 2008 — David Davis renunció para volver a presentarse y los grandes partidos se apartaron.',
    ],
    ipsosLabel: 'Ánimo nacional — solo contexto',
    ipsosCaveat: 'Una pregunta nacional de preferencia, no una encuesta de votantes de Clacton — estas preguntas favorecen a las candidaturas de protesta. Mueve el ambiente, no el modelo.',
    baseLabel: 'Línea de base 2024 — el escaño que dejó Farage',
    timelineLabel: 'Cronología',
    timeline: [
      { date: '2026-07-07', text: 'Farage renuncia; el pago de 5 M£ se reporta a la NCA el mismo día.' },
      { date: '2026-07-07', text: 'Los grandes partidos anuncian el boicot en horas.' },
      { date: '2026-07-08', text: 'Count Binface se declara. Las casas recortan sus cuotas de ~500/1 a ~5/1.' },
      { date: '2026-07-09', text: 'Ipsos: el 33 % prefiere una victoria de Binface, frente al 21 % para Farage.' },
      { date: '2026-07-10', text: 'El Tendring District Council confirma la votación: 13 de agosto de 2026.' },
      { date: '2026-07-17', text: 'Cierre de candidaturas — lista final.' },
      { date: '2026-08-13', text: 'Día de votación.' },
    ],
    sourcesLabel: 'Fuentes',
    subscribeTitle: 'Alertas Clacton',
    subscribeBody: 'Actualizaciones del modelo, movimientos de mercado y el call final — en el boletín de Vote-Scope.',
    subscribeCta: 'Suscribirse en Substack →',
    keepDiggingEyebrow: 'Seguir cavando',
    keepDiggingTitle: 'Más del desk del Reino Unido.',
    keepDiggingBody: 'La proyección de las generales, las 650 fichas de circunscripción y el hub de encuestas.',
    links: [
      { href: '/es/uk/general-election/', label: 'Proyección de las generales del Reino Unido →' },
      { href: '/es/uk/circunscripciones/E14001174-clacton/', label: 'Ficha de la circunscripción de Clacton →' },
      { href: '/es/uk/sondeos/', label: 'Hub de encuestas del Reino Unido →' },
    ],
  },
}[lang];

const t = copy;
const scenarioCondKey = lang === 'fr' ? 'condition_fr' : lang === 'es' ? 'condition_es' : 'condition_en';
const ctxPoll = config.contextPolls[0];
const ctxQuestion = lang === 'fr' ? ctxPoll.question_fr : lang === 'es' ? ctxPoll.question_es : ctxPoll.question_en;

const sources = [
  { label: 'Wikipedia — 2026 Clacton by-election (date, candidats, boycott)', url: 'https://en.wikipedia.org/wiki/2026_Clacton_by-election' },
  { label: 'BBC News — Clacton by-election to be held 13 August', url: 'https://www.bbc.com/news/articles/c15y85gkkx5o' },
  { label: 'The Independent — Survation constituency poll (16–24 July, n=502)', url: 'https://www.independent.co.uk/news/uk/politics/count-binface-nigel-farage-clacton-byelection-poll-b3031765.html' },
  { label: 'Ipsos — British public more likely to prefer Count Binface (8–9 July 2026, n=1000)', url: 'https://www.ipsos.com/en-uk/british-public-more-likely-prefer-count-binface-wins-clacton-election-nigel-farage' },
  { label: 'Electoral Commission — how postal votes are verified and counted', url: 'https://www.electoralcommission.org.uk/voting-and-elections/how-elections-work/how-votes-are-counted' },
  { label: 'Polymarket — Clacton by-election Winner', url: 'https://polymarket.com/event/clacton-by-election-winner-20260707143521303' },
  { label: 'Polymarket — Clacton 2nd place', url: 'https://polymarket.com/event/clacton-by-election-2nd-place-20260707214539733' },
  { label: 'Polymarket — Count Binface Vote %', url: 'https://polymarket.com/event/clacton-by-election-count-binface-vote-20260708142507718' },
  { label: 'Kalshi — Clacton by-election winner', url: 'https://kalshi.com/markets/kxclactonbyelection/clacton-byelection-winner' },
  { label: 'Oddschecker — Clacton by-election odds', url: 'https://www.oddschecker.com/insight/politics/20260708-clacton-by-election-odds-reform-heavy-favourites-to-win-seat' },
  { label: 'The Independent — Binface odds slashed', url: 'https://www.the-independent.com/news/uk/politics/count-binface-nigel-farage-clacton-by-election-poll-b3012680.html' },
];

const breadcrumbUk = { en: 'U.K.', fr: 'UK', es: 'Reino Unido' }[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    name: config.title[lang].replace(' — Vote-Scope', ''),
    description: config.description[lang],
    headline: t.headline,
    dateModified: meta.run_date,
    author: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${lang}/` },
      { '@type': 'ListItem', position: 2, name: breadcrumbUk, item: `https://vote-scope.com/${lang}/uk/` },
      { '@type': 'ListItem', position: 3, name: config.ridingName, item: canonical },
    ],
  },
];

// Bornes des barres de fourchette (échelle commune 0–75 %).
const SCALE_MAX = 75;
const pc = (v: number) => `${Math.min(100, (v / SCALE_MAX) * 100)}%`;
---

<Base
  title={config.title[lang]}
  description={config.description[lang]}
  canonical={canonical}
  currentPage="uk"
  lang={lang}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="ukbye">
    <div class="container" style="padding-top:28px;">
      <ElectionCountdown
        targetDate={config.electionDate}
        locale={lang}
        kicker={t.countdownKicker}
        client:visible
      />
    </div>

    <header class="ukbye-hero container">
      <p class="ukbye-kicker">{t.kicker}</p>
      <h1>{t.headline}</h1>
      <p class="ukbye-dek">{t.dek}</p>
      <GooglePreferredSource locale={lang} />
    </header>

    <div class="container">
      <ClactonLiveDesk initial={clactonLive} lang={lang} client:load />
    </div>

    <section class="container" aria-labelledby="ukbye-snap">
      <p class="ukbye-label" id="ukbye-snap">{t.snapshotLabel}</p>
      <div class="ukbye-snap-grid">
        <div class="ukbye-snap" style="--accent:#12B6CF">
          <strong>{fmtProbBounded(model.p_farage_win)}%</strong>
          <span>{t.snapFarage}</span>
        </div>
        <div class="ukbye-snap" style="--accent:#1a1a1a">
          <strong>{fmtProbBounded(model.p_binface_win)}%</strong>
          <span>{t.snapBinface}</span>
        </div>
        <div class="ukbye-snap" style="--accent:#5aaa8a">
          <strong>{pmFarage != null ? `${fmtProb(pmFarage)}%` : '—'}</strong>
          <span>{t.snapPmFarage}</span>
        </div>
        <div class="ukbye-snap" style="--accent:#c8a030">
          <strong>{fmtPct(model.candidates.binface.share.q50)}%</strong>
          <span>{t.snapBinfaceShare}</span>
        </div>
      </div>
    </section>

    <section class="container" aria-labelledby="ukbye-model">
      <p class="ukbye-label" id="ukbye-model">{t.modelLabel}</p>
      <p class="ukbye-body-text">{t.modelIntro}</p>
      <p class="ukbye-range-label">{t.modelRange}</p>
      <div class="ukbye-ranges">
        {candOrder.map((key) => {
          const c = model.candidates[key];
          const m = candMeta[key];
          const tag = lang === 'fr' ? m.tag_fr : lang === 'es' ? m.tag_es : m.tag_en;
          return (
            <div class="ukbye-range-row">
              <div class="ukbye-range-name">
                <i style={`background:${m.color}`}></i>
                <span>{m.name} <small>{tag}</small></span>
              </div>
              <div class="ukbye-range-track">
                <div class="ukbye-range-band" style={`left:${pc(c.share.q10)};width:calc(${pc(c.share.q90)} - ${pc(c.share.q10)});background:${m.color}22;border-color:${m.color}`}></div>
                <div class="ukbye-range-median" style={`left:${pc(c.share.q50)};background:${m.color}`}></div>
              </div>
              <div class="ukbye-range-nums">
                <strong>{fmtPct(c.share.q50)}%</strong>
                <small>[{fmtPct(c.share.q10, 0)}–{fmtPct(c.share.q90, 0)}]</small>
              </div>
            </div>
          );
        })}
      </div>
      <p class="ukbye-ctx-caveat">{t.modelCaveat}</p>
    </section>

    <section class="container" aria-labelledby="ukbye-path">
      <p class="ukbye-label" id="ukbye-path">{t.pathLabel}</p>
      <p class="ukbye-body-text">{t.pathIntro}</p>
      <div class="ukbye-path-grid">
        {model.scenarios.map((s: any) => (
          <div class="ukbye-path-card">
            <p class="ukbye-path-cond">{s[scenarioCondKey]}</p>
            <div class="ukbye-path-bar">
              <div style={`width:${scenarioBarPct(s.p_binface_win)}%;`}></div>
            </div>
            <p class="ukbye-path-p">
              p(Binface) = <strong>{fmtProbFine(s.p_binface_win)}%</strong>
            </p>
          </div>
        ))}
      </div>
      <p class="ukbye-body-text ukbye-path-outro">{t.pathOutro}</p>
    </section>

    <section class="container">
      <ContextualBookShelf lang={lang} context="clacton" />
    </section>

    {hasLocalPoll && (
      <section class="container" aria-labelledby="ukbye-localpoll">
        <p class="ukbye-label" id="ukbye-localpoll">{t.pollLabel}</p>
        <p class="ukbye-body-text">{t.pollIntro}</p>
        <div class="ukbye-table-wrap">
          <table class="ukbye-table">
            <thead>
              <tr><th>{t.thCandidate}</th><th>{t.thPoll}</th><th>{t.thModel}</th><th>{t.thGap}</th></tr>
            </thead>
            <tbody>
              {(localPoll.rows ?? []).map((row: any) => (
                <tr>
                  <td>{row.label?.[lang] ?? row.label?.en ?? row.bucket}</td>
                  <td>{row.poll_pct != null ? `${fmtPct(row.poll_pct, 0)} %` : '—'}</td>
                  <td>{row.model_pct != null ? `${fmtPct(row.model_pct, 1)} %` : '—'}</td>
                  <td>{fmtGap(row.gap_pts)}</td>
                </tr>
              ))}
              {localPoll.head_to_head && (
                <tr>
                  <td>{t.pollHeadToHead}</td>
                  <td>{`${fmtPct(localPoll.head_to_head.farage, 0)} / ${fmtPct(localPoll.head_to_head.binface, 0)} %`}</td>
                  <td>—</td>
                  <td>—</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
        <p class="ukbye-body-text ukbye-poll-source">
          <a href={localPoll.source_url}>{localPoll.firm === 'survation' ? 'Survation' : localPoll.firm}</a>
          {` / ${localPoll.client} · ${localPoll.field_start} → ${localPoll.field_end} · n = ${localPoll.sample_size_published}`}
        </p>
        <p class="ukbye-label ukbye-poll-weight-label">{t.pollWeightLabel}</p>
        <p class="ukbye-body-text">{localPollNote}</p>
      </section>
    )}

    <section class="container" aria-labelledby="ukbye-turnout">
      <p class="ukbye-label" id="ukbye-turnout">{t.turnoutLabel}</p>
      <p class="ukbye-body-text">{t.turnoutIntro}</p>
      <div class="ukbye-turnout-grid">
        <p>{t.reformNote}</p>
        <p>{lang === 'fr' ? postalVoting.note_fr : lang === 'es' ? postalVoting.note_es : postalVoting.note_en}</p>
      </div>
      <ClactonTurnoutCurve lang={lang} />
      <p class="ukbye-curve-note">{t.curveNote}</p>
    </section>

    <section class="container" aria-labelledby="ukbye-markets">
      <p class="ukbye-label" id="ukbye-markets">{t.marketsLabel}</p>
      <p class="ukbye-body-text">{t.marketsIntro}</p>
      <div class="ukbye-table-wrap">
        <table class="ukbye-table">
          <thead>
            <tr><th>{t.thMarket}</th><th>{t.thFarage}</th><th>{t.thBinface}</th><th>{t.thNote}</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><a href={pmWinner?.url}>{t.rowPmWinner}</a></td>
              <td>{pmFarage != null ? `${fmtProb(pmFarage)}%` : '—'}</td>
              <td>{pmBinface != null ? `${fmtProb(pmBinface)}%` : '—'}</td>
              <td>{pmWinner?.volume ? `vol. $${Math.round(pmWinner.volume / 1000)}k` : ''}</td>
            </tr>
            <tr>
              <td><a href={pmSecond?.url}>{t.rowPmSecond}</a></td>
              <td>{pmFarage2nd != null ? `${fmtProb(pmFarage2nd)}%` : '—'}</td>
              <td>{pmBinface2nd != null ? `${fmtProb(pmBinface2nd)}%` : '—'}</td>
              <td>{t.secondNote}</td>
            </tr>
            <tr>
              <td><a href={markets.kalshi?.farage?.url}>{t.rowKalshi}</a></td>
              <td>{kalshiFarage != null ? `${fmtProb(kalshiFarage)}%` : '—'}</td>
              <td>{kalshiBinface != null ? `${fmtProb(kalshiBinface)}%` : '—'}</td>
              <td></td>
            </tr>
            <tr>
              <td><a href={bookies.source_url}>{t.rowBookies}</a></td>
              <td>{bookies.farage_odds ?? '—'}</td>
              <td>{bookies.binface_odds ?? '—'}</td>
              <td>{lang === 'fr' ? bookies.note_fr : bookies.note_en}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="ukbye-range-label">{t.bucketLabel}</p>
      <div class="ukbye-buckets">
        {bucketRows.map((b) => (
          <div class="ukbye-bucket-row">
            <span class="ukbye-bucket-name">{b.label}</span>
            <div class="ukbye-bucket-track">
              <div class="ukbye-bucket-model" style={`width:${b.model * 100}%`} title={`${t.bucketModel}: ${fmtProb(b.model)}%`}></div>
              {b.market != null && (
                <div class="ukbye-bucket-market" style={`left:${b.market * 100}%`} title={`${t.bucketMarket}: ${fmtProb(b.market)}%`}></div>
              )}
            </div>
            <span class="ukbye-bucket-nums">
              <strong>{fmtProb(b.model)}%</strong>
              <small>{b.market != null ? `pm ${fmtProb(b.market)}%` : ''}</small>
            </span>
          </div>
        ))}
      </div>
      {t.improveNote && <p class="ukbye-ctx-caveat">{t.improveNote}</p>}
    </section>

    <section class="container" aria-labelledby="ukbye-ctx2">
      <p class="ukbye-label" id="ukbye-ctx2">{t.ctxLabel}</p>
      <ul class="ukbye-ctx-list">
        {t.ctxBullets.map((b) => <li>{b}</li>)}
      </ul>
    </section>

    <section class="container" aria-labelledby="ukbye-ipsos">
      <p class="ukbye-label" id="ukbye-ipsos">{t.ipsosLabel}</p>
      <div class="ukbye-ctx-card">
        <p class="ukbye-ctx-question">{ctxQuestion}</p>
        <div class="ukbye-ctx-bars">
          {ctxPoll.options.map((o) => (
            <div class="ukbye-ctx-row">
              <span class="ukbye-ctx-name">{lang === 'fr' ? o.label_fr : lang === 'es' ? o.label_es : o.label_en}</span>
              <div class="ukbye-ctx-track">
                <div class="ukbye-ctx-fill" style={`width:${o.pct}%;background:${o.color};`} />
              </div>
              <strong class="ukbye-ctx-pct">{o.pct}%</strong>
            </div>
          ))}
        </div>
        <p class="ukbye-ctx-meta">
          {ctxPoll.firm} · {ctxPoll.field_dates_label[lang]} · n={ctxPoll.sample_size}
        </p>
        <p class="ukbye-ctx-caveat">{t.ipsosCaveat}</p>
      </div>
    </section>

    <section class="container" aria-labelledby="ukbye-2024">
      <p class="ukbye-label" id="ukbye-2024">{t.baseLabel}</p>
      <div class="ukbye-breakdown-bar">
        {config.last2024.candidates.map((c) => (
          <div style={`width:${c.pct}%;background:${c.color};`} title={`${c.name}: ${c.pct.toFixed(1)}%`} />
        ))}
      </div>
      <div class="ukbye-vote-grid">
        {config.last2024.candidates.map((c) => (
          <div class={`ukbye-vote-row${c.is_winner ? ' ukbye-vote-row--winner' : ''}`}>
            <div class="ukbye-vote-dot" style={`background:${c.color}`} />
            <span class="ukbye-vote-party">
              {lang === 'fr' ? c.party_label_fr : lang === 'es' ? c.party_label_es : c.party_label_en} — {c.name}
            </span>
            <strong>{fmtPct(c.pct)}%</strong>
            {c.is_winner && <span class="ukbye-check">✓</span>}
          </div>
        ))}
      </div>
      <p class="ukbye-ctx-meta">
        {lang === 'fr' ? config.last2024.turnout_note_fr : lang === 'es' ? config.last2024.turnout_note_es : config.last2024.turnout_note_en}
      </p>
    </section>

    <section class="container" aria-labelledby="ukbye-timeline">
      <p class="ukbye-label" id="ukbye-timeline">{t.timelineLabel}</p>
      <ol class="ukbye-timeline">
        {t.timeline.map((e) => (
          <li>
            <span class="ukbye-tl-date">{e.date}</span>
            <span class="ukbye-tl-text">{e.text}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="container">
      <div class="ukbye-subscribe">
        <div>
          <p class="ukbye-label" style="margin-top:0;">{t.subscribeTitle}</p>
          <p class="ukbye-body-text" style="margin-top:6px;">{t.subscribeBody}</p>
        </div>
        <a class="ukbye-subscribe-cta" href="https://leclercswarroom.substack.com/" rel="noopener">{t.subscribeCta}</a>
      </div>
    </section>

    <section class="container" aria-labelledby="ukbye-sources">
      <p class="ukbye-label" id="ukbye-sources">{t.sourcesLabel}</p>
      <ol class="ukbye-sources">
        {sources.map((s) => (
          <li><a href={s.url} rel="noopener">{s.label}</a></li>
        ))}
      </ol>
    </section>

    <KeepDigging
      eyebrow={t.keepDiggingEyebrow}
      title={t.keepDiggingTitle}
      body={t.keepDiggingBody}
      links={t.links}
    />
  </article>
</Base>

<style>
  .ukbye { padding-bottom: 64px; }
  .ukbye .container { max-width: 920px; margin-inline: auto; padding-inline: 1.5rem; }
  .ukbye-hero { padding-top: 40px; }
  .ukbye-kicker {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .ukbye-hero h1 {
    margin-top: 10px; font-family: var(--serif); font-weight: 420;
    font-size: clamp(42px, 7vw, 76px); letter-spacing: -0.02em; line-height: 0.98;
  }
  .ukbye-dek { margin-top: 16px; max-width: 64ch; color: var(--ink-2); line-height: 1.6; font-size: 17px; }
  .ukbye-label {
    margin-top: 48px; font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3);
  }
  .ukbye-body-text { margin-top: 10px; max-width: 70ch; color: var(--ink-2); line-height: 1.65; }

  /* Sondage local : source discrète sous le tableau, et sous-titre du bloc de
