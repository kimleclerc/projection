---
/**
 * L'effet candidature : à qui une candidature prend ses voix.
 *
 * Les instituts français testent plusieurs hypothèses dans la MÊME enquête, auprès
 * des mêmes personnes, en ne changeant souvent qu'un nom. Soustraire deux de ces
 * hypothèses dit où vont les voix — une lecture que les communiqués ne font pas.
 * Données : export_fr_candidacy_effects.py (moteur), fenêtre de 365 jours.
 */
import JurisdictionNav from './JurisdictionNav.astro';
import effects from '../../web_data/france-presidential/candidacy_effects.json';
import { blocHex, type Locale } from '../lib/fr-pres';

interface Props { locale: Locale }
const { locale } = Astro.props;

const data = effects as any;
const L = locale === 'fr' ? 'fr-FR' : locale === 'es' ? 'es-ES' : 'en-CA';
const nf = new Intl.NumberFormat(L, { maximumFractionDigits: 1, minimumFractionDigits: 1 });
const pct = (v: number) => `${nf.format(v)}${locale === 'en' ? '%' : ' %'}`;
const signed = (v: number) => `${v > 0 ? '+' : '−'}${nf.format(Math.abs(v))}`;
const share = (v: number) => `${Math.round(v * 100)}${locale === 'en' ? '%' : ' %'}`;
const day = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(L, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const firmNames: Record<string, string> = {
  ifop: 'Ifop', ipsos: 'Ipsos BVA', elabe: 'Elabe', opinionway: 'OpinionWay', harris: 'Harris Interactive',
  odoxa: 'Odoxa', cluster17: 'Cluster17', verian: 'Verian', csa: 'CSA', bva: 'BVA', yougov: 'YouGov',
};
const firmList = (firms: string[]) => firms.map((f) => firmNames[f] ?? f).join(', ');

const C = {
  fr: {
    kicker: 'Présidentielle 2027 · Effet candidature',
    h1: 'À qui chaque candidature prend ses voix',
    lede: 'Les instituts testent souvent, dans la même enquête et auprès des mêmes personnes, deux listes de candidats qui ne diffèrent que par un nom. La différence entre les deux dit où vont les voix. Nous avons fait la soustraction.',
    meta: `${data.meta.n_polls} sondages · ${data.meta.n_hypotheses} hypothèses · ${day(data.meta.window_start)} – ${day(data.meta.window_end)}`,
    exitsTitle: 'Si un candidat n’est pas sur la liste',
    exitHead: (n: string) => `Sans ${n}`,
    exitLede: (n: string, v: string) => `${n} pèse ${v} en moyenne. Quand il n’est pas proposé, ses électeurs se reportent ainsi (gain en points, puis part de ses voix) :`,
    ofVotes: 'de ses voix',
    others: 'Autres',
    swapsTitle: 'Si un candidat en remplace un autre',
    swapHead: (a: string, b: string) => `${a} à la place ${/^[AEIOUÉÈÊaeiouéèê]/.test(b) ? 'd’' : 'de '}${b}`,
    swapLede: (a: string, av: string, b: string, bv: string) => `${a} fait ${av} là où ${b} fait ${bv}. Autour, les scores bougent ainsi :`,
    pairs: (n: number, p: number, f: string) => `${n} comparaisons dans ${p} sondages · ${f}`,
    range: (lo: string, hi: string) => `de ${lo} à ${hi} selon les sondages`,
    howTitle: 'Comment c’est calculé',
    how: [
      'Nous ne gardons que des paires d’hypothèses d’une même enquête : même terrain, même échantillon, même redressement. Seule la liste des candidats change.',
      `Un effet n’est publié qu’à partir de ${data.meta.min_pairs} comparaisons venant d’au moins ${data.meta.min_firms} instituts. Les scores publiés sont souvent arrondis au point : une comparaison isolée est bruitée, la moyenne l’est beaucoup moins.`,
      'Le Pen et Bardella sont regroupés sous « RN » : sur un an, les deux ont porté la candidature du parti.',
      'Ce sont des intentions de vote à plusieurs mois du scrutin : les reports mesurés aujourd’hui peuvent changer pendant la campagne.',
    ],
    back: 'Notre projection de la présidentielle',
    polls: 'Tous les sondages',
  },
  en: {
    kicker: '2027 French presidential · Candidacy effect',
    h1: 'Where each candidacy takes its votes from',
    lede: 'French pollsters often test, in the same survey and on the same people, two candidate lists that differ by a single name. The difference between the two shows where the votes go. We did the subtraction.',
    meta: `${data.meta.n_polls} polls · ${data.meta.n_hypotheses} lineups · ${day(data.meta.window_start)} – ${day(data.meta.window_end)}`,
    exitsTitle: 'If a candidate is not on the list',
    exitHead: (n: string) => `Without ${n}`,
    exitLede: (n: string, v: string) => `${n} averages ${v}. When left off the list, those voters go (gain in points, then share of the votes):`,
    ofVotes: 'of the votes',
    others: 'Others',
    swapsTitle: 'If one candidate replaces another',
    swapHead: (a: string, b: string) => `${a} instead of ${b}`,
    swapLede: (a: string, av: string, b: string, bv: string) => `${a} scores ${av} where ${b} scores ${bv}. Around them, scores move like this:`,
    pairs: (n: number, p: number, f: string) => `${n} comparisons in ${p} polls · ${f}`,
    range: (lo: string, hi: string) => `from ${lo} to ${hi} depending on the poll`,
    howTitle: 'How it is calculated',
    how: [
      'We only keep pairs of lineups from the same survey: same fieldwork, same sample, same weighting. Only the list of candidates changes.',
      `An effect is published only from ${data.meta.min_pairs} comparisons by at least ${data.meta.min_firms} pollsters. Published shares are often rounded to the point: one comparison is noisy, the average much less so.`,
      'Le Pen and Bardella are grouped as “RN”: over the year, both carried the party’s candidacy.',
      'These are voting intentions months before the vote: transfers measured today can change during the campaign.',
    ],
    back: 'Our presidential forecast',
    polls: 'All polls',
  },
  es: {
    kicker: 'Presidencial francesa 2027 · Efecto candidatura',
    h1: 'De quién toma sus votos cada candidatura',
    lede: 'Los institutos franceses prueban a menudo, en la misma encuesta y con las mismas personas, dos listas de candidatos que solo difieren en un nombre. La diferencia entre ambas muestra adónde van los votos. Hicimos la resta.',
    meta: `${data.meta.n_polls} encuestas · ${data.meta.n_hypotheses} combinaciones · ${day(data.meta.window_start)} – ${day(data.meta.window_end)}`,
    exitsTitle: 'Si un candidato no está en la lista',
    exitHead: (n: string) => `Sin ${n}`,
    exitLede: (n: string, v: string) => `${n} obtiene ${v} de media. Cuando no figura, sus votantes se reparten así (ganancia en puntos y parte de sus votos):`,
    ofVotes: 'de sus votos',
    others: 'Otros',
    swapsTitle: 'Si un candidato sustituye a otro',
    swapHead: (a: string, b: string) => `${a} en lugar de ${b}`,
    swapLede: (a: string, av: string, b: string, bv: string) => `${a} obtiene ${av} donde ${b} obtiene ${bv}. Alrededor, los resultados se mueven así:`,
    pairs: (n: number, p: number, f: string) => `${n} comparaciones en ${p} encuestas · ${f}`,
    range: (lo: string, hi: string) => `de ${lo} a ${hi} según la encuesta`,
    howTitle: 'Cómo se calcula',
    how: [
      'Solo conservamos pares de combinaciones de una misma encuesta: mismo trabajo de campo, misma muestra, misma ponderación. Solo cambia la lista de candidatos.',
      `Un efecto solo se publica a partir de ${data.meta.min_pairs} comparaciones de al menos ${data.meta.min_firms} institutos. Los resultados suelen redondearse al punto: una comparación aislada es ruidosa, la media mucho menos.`,
      'Le Pen y Bardella se agrupan como «RN»: durante el año, ambos encarnaron la candidatura del partido.',
      'Son intenciones de voto a meses de la elección: las transferencias medidas hoy pueden cambiar durante la campaña.',
    ],
    back: 'Nuestro pronóstico presidencial',
    polls: 'Todas las encuestas',
  },
}[locale];

const base = `/${locale}/france`;
const pollsHref = { fr: '/fr/france/sondages/', en: '/en/france/polls/', es: '/es/france/sondeos/' }[locale];
const exits = (data.exits ?? []) as any[];
const swaps = (data.swaps ?? []) as any[];
const maxGain = Math.max(1, ...exits.flatMap((e) => e.destinations.map((d: any) => d.gain.mean)));
const maxMove = Math.max(1, ...swaps.flatMap((s) => s.movers.map((m: any) => Math.abs(m.delta.mean))));
---

<JurisdictionNav webKey="france" lang={locale} active="polls" />

<article class="fce" data-content-area>
  <header class="fce-head container">
    <p class="fce-kicker">{C.kicker}</p>
    <h1>{C.h1}</h1>
    <p class="fce-lede">{C.lede}</p>
    <p class="fce-meta">{C.meta}</p>
  </header>

  {exits.length > 0 && (
    <section class="fce-section container" aria-labelledby="fce-exits">
      <h2 id="fce-exits">{C.exitsTitle}</h2>
      <div class="fce-grid">
        {exits.map((e) => (
          <div class="fce-card">
            <h3>{C.exitHead(e.short)}</h3>
            <p class="fce-card-lede">{C.exitLede(e.short, pct(e.own.mean))}</p>
            <ul class="fce-bars">
              {e.destinations.map((dst: any) => (
                <li>
                  <span class="fce-name">{dst.short}</span>
                  <span class="fce-track"><span class="fce-fill" style={`width:${(dst.gain.mean / maxGain) * 100}%;background:${blocHex(dst.bloc)}`} /></span>
                  <span class="fce-val">{signed(dst.gain.mean)}</span>
                  <span class="fce-share" title={C.ofVotes}>{share(dst.share_of_votes)}</span>
                </li>
              ))}
              {e.other_gain > 0.05 && (
                <li class="is-other">
                  <span class="fce-name">{C.others}</span>
                  <span class="fce-track"><span class="fce-fill" style={`width:${(e.other_gain / maxGain) * 100}%`} /></span>
                  <span class="fce-val">{signed(e.other_gain)}</span>
                  <span class="fce-share" />
                </li>
              )}
            </ul>
            <p class="fce-foot">{C.pairs(e.n_pairs, e.n_polls, firmList(e.firms))}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {swaps.length > 0 && (
    <section class="fce-section container" aria-labelledby="fce-swaps">
      <h2 id="fce-swaps">{C.swapsTitle}</h2>
      <div class="fce-grid">
        {swaps.map((s) => (
          <div class="fce-card">
            <h3>{C.swapHead(s.alt.short, s.base.short)}</h3>
            <p class="fce-card-lede">{C.swapLede(s.alt.short, pct(s.alt_score.mean), s.base.short, pct(s.base_score.mean))}</p>
            <ul class="fce-diverge">
              {s.movers.map((m: any) => (
                <li>
                  <span class="fce-name">{m.short}</span>
                  <span class="fce-axis">
                    <span class={`fce-half ${m.delta.mean < 0 ? 'is-neg' : 'is-pos'}`}>
                      <span class="fce-fill" style={`width:${(Math.abs(m.delta.mean) / maxMove) * 100}%;background:${blocHex(m.bloc)}`} />
                    </span>
                  </span>
                  <span class="fce-val">{signed(m.delta.mean)}</span>
                </li>
              ))}
            </ul>
            <p class="fce-foot">{C.pairs(s.n_pairs, s.n_polls, firmList(s.firms))}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="fce-section container fce-how" aria-labelledby="fce-how">
    <h2 id="fce-how">{C.howTitle}</h2>
    <ul>{C.how.map((t) => <li>{t}</li>)}</ul>
    <p class="fce-links">
      <a href={`${base}/`}>{C.back} →</a>
      <a href={pollsHref}>{C.polls} →</a>
    </p>
  </section>
</article>

<style>
  .fce { padding-block: 48px 96px; }
  .fce-head { max-width: 820px; }
  .fce-kicker { margin: 0 0 14px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .fce-head h1 { margin: 0 0 16px; font-family: var(--serif); font-size: clamp(34px, 5.5vw, 64px); font-weight: 420; line-height: 1.02; letter-spacing: -0.02em; }
  .fce-lede { max-width: 680px; margin: 0 0 12px; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .fce-meta { font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
  .fce-section { max-width: 1080px; margin-top: 44px; }
  .fce-section h2 { margin: 0 0 16px; font-family: var(--serif); font-size: clamp(24px, 3vw, 34px); font-weight: 430; }
  .fce-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
  .fce-card { border: 1px solid var(--rule); border-radius: 6px; background: var(--card); padding: 18px 20px; }
  .fce-card h3 { margin: 0 0 6px; font-family: var(--serif); font-size: 22px; font-weight: 450; }
  .fce-card-lede { margin: 0 0 14px; color: var(--ink-2); font-size: 15px; line-height: 1.55; }
  .fce-bars, .fce-diverge { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .fce-bars li { display: grid; grid-template-columns: 92px 1fr 44px 40px; gap: 10px; align-items: center; }
  .fce-diverge li { display: grid; grid-template-columns: 92px 1fr 44px; gap: 10px; align-items: center; }
  .fce-name { font-family: var(--mono); font-size: 12px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fce-track { position: relative; height: 14px; background: var(--paper-2); border-radius: 3px; overflow: hidden; }
  .fce-fill { position: absolute; inset-block: 0; left: 0; border-radius: 3px; min-width: 2px; background: var(--ink-3); }
  .fce-axis { position: relative; height: 14px; display: grid; grid-template-columns: 1fr 1fr; }
  .fce-axis::before { content: ''; position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: var(--ink-4); }
  .fce-half { position: relative; grid-column: 2; height: 14px; }
  .fce-half.is-neg { grid-column: 1; }
  .fce-half.is-neg .fce-fill { left: auto; right: 0; }
  .fce-val { font-family: var(--mono); font-size: 12px; color: var(--ink); text-align: right; font-variant-numeric: tabular-nums; }
  .fce-share { font-family: var(--mono); font-size: 11px; color: var(--ink-3); text-align: right; }
  .is-other .fce-name, .is-other .fce-val { color: var(--ink-3); }
  .fce-foot { margin: 12px 0 0; font-family: var(--mono); font-size: 11px; color: var(--ink-3); line-height: 1.5; }
  .fce-how ul { max-width: 760px; margin: 0 0 16px; padding-left: 18px; color: var(--ink-2); line-height: 1.7; }
  .fce-links { display: flex; flex-wrap: wrap; gap: 18px; font-family: var(--mono); font-size: 12px; }
  @media (max-width: 520px) {
    .fce-bars li { grid-template-columns: 74px 1fr 38px 34px; gap: 8px; }
    .fce-diverge li { grid-template-columns: 74px 1fr 38px; gap: 8px; }
  }
</style>
