    detailTitle: 'Shares by party in 2026, 2022 and 2024',
    th: ['State', 'Ballots', 'Democrats', 'Republicans', 'Unaffiliated and other', 'D − R gap'],
    row: (y: string, d: number) => `${y}, ${d} days out`,
    notesTitle: 'Where the figures come from',
    notes: {
      NC: 'State Board of Elections files, ballot by ballot. In-person voting opened on the same weekday, 19 days before the election, in 2022, 2024 and 2026.',
      PA: 'Department of State data. Only mail ballots are counted, since the state has almost no in-person early voting. Republicans started voting by mail in 2024, so part of their gain over 2022 is voters who would otherwise have voted on election day.',
      FL: 'County counts compiled by DataRepublican. Their method gives exactly our figures in Pennsylvania, where the official data lets us redo the calculation.',
      CO: 'Daily Secretary of State reports. Colorado votes almost entirely by mail, and unaffiliated voters outnumber the registered voters of either party.',
