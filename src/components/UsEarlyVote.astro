---
/**
 * Vote anticipé, midterms US 2026 : qui a déjà voté, comparé à la même date
 * avant les scrutins de 2022 et de 2024. Page descriptive en trois langues ;
 * rien ici ne modifie les probabilités publiées.
 * Source : web_data/us-senate/early_vote.json (moteur, build_us_early_vote_web.py).
 * Gabarit : PageHeader, puis tableau de synthèse (docs/DESIGN.md § 7).
 * Blocs en enfants directs de [data-content-area] pour l'insertion publicitaire.
 */
import PageHeader from './PageHeader.astro';
import data from '../../web_data/us-senate/early_vote.json';

interface Props { locale: 'fr' | 'en' | 'es'; }
const { locale } = Astro.props;

const loc = locale === 'fr' ? 'fr-CA' : locale === 'es' ? 'es' : 'en-US';
const unit = locale === 'en' ? '%' : ' %';
const num = (n: number) => n.toLocaleString(loc);
const pc = (n: number | null | undefined, d = 1) =>
  n == null ? '—' : `${n.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d })}${unit}`;
const pts = (n: number | null | undefined) => {
  if (n == null) return '—';
  const s = Math.abs(n).toLocaleString(loc, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  return `${n > 0 ? '+' : n < 0 ? '−' : ''}${s}`;
};
const dateFmt = (iso: string, year = true) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString(loc, year ? { day: 'numeric', month: 'long', year: 'numeric' } : { day: 'numeric', month: 'long' });

const meta: any = (data as any).meta;
const states: any[] = (data as any).states;
const C22 = 'us_general_2022', C24 = 'us_general_2024', C26 = 'us_general_2026';
const nc = states.find((s) => s.state === 'NC');
const nameOf = (s: any) => s.state_name[locale];
const words = ({
  fr: ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix', 'onze', 'douze'],
  en: ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'],
  es: ['cero', 'un', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once', 'doce'],
} as any)[locale];
const inWords = (n: number) => words[n] ?? String(n);

// Préposition devant un nom d'État (« au Kansas », « en Floride »).
const FR_AU = new Set(['KS', 'NV', 'ME', 'NE', 'CO']);
const inState = (s: any) => locale === 'fr' ? `${FR_AU.has(s.state) ? 'au' : 'en'} ${nameOf(s)}` : locale === 'es' ? `en ${nameOf(s)}` : `in ${nameOf(s)}`;
const join = (xs: string[]) => {
  const and = locale === 'fr' ? 'et' : locale === 'es' ? 'y' : 'and';
  return xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} ${and} ${xs[xs.length - 1]}`;
};

// Un écart de moins d'un point est « à peu près le même ».
const gap22 = (s: any) => s.headline.change_vs_2022.gap;
const summary = [...states].sort((a, b) => gap22(b) - gap22(a));
const demBetter = summary.filter((s) => gap22(s) >= 1);
const repBetter = summary.filter((s) => gap22(s) <= -1);
const flat = summary.filter((s) => Math.abs(gap22(s)) < 1);
const PRIMARY = new Set(['NC', 'PA', 'CO']);
const srcKind = (s: any) => PRIMARY.has(s.state) ? 'official' : s.state === 'FL' ? 'third_party'
  : (s.source_kinds?.includes('official') ? 'official' : s.source_kinds?.includes('third_party') ? 'third_party' : 'press');
const dayLabel = (s: any, c: string) => s.stage_days_before_by_cycle?.[c] ?? s.stage_days_before;

const T = {
  fr: {
    title: 'Vote anticipé des élections de mi-mandat : qui a déjà voté',
    promise: `Part des inscrits démocrates, républicains et non affiliés parmi les bulletins déjà déposés dans ${inWords(states.length)} États, comparée à la même date avant le scrutin de 2022.`,
    answer: `Dans ${inWords(demBetter.length)} États sur ${inWords(states.length)}, l'écart entre inscrits démocrates et républicains est plus favorable aux démocrates qu'à la même date en 2022. Il est plus favorable aux républicains ${join(repBetter.map(inState))}${flat.length ? `, et presque inchangé ${join(flat.map(inState))}` : ''}.`,
    sumTitle: 'L\'écart démocrates − républicains, État par État',
    sumTh: ['État', '2026', '2022, même date', 'Évolution', 'Source'],
    sumSrc: { official: 'État', press: 'presse', third_party: 'analyste' },
    sumMeta: `Écart en points entre la part des inscrits démocrates et celle des inscrits républicains parmi les votants, au ${dateFmt(meta.as_of)} au plus tard. Une inscription n'est pas un vote. Ces chiffres ne modifient pas nos probabilités.`,
    paNote: 'vote postal seulement',
    detailTitle: 'Les parts par parti en 2026, 2022 et 2024',
    th: ['État', 'Bulletins', 'Démocrates', 'Républicains', 'Non affiliés et autres', 'Écart D − R'],
    row: (y: string, d: number) => `${y}, ${d} jours avant`,
    notesTitle: 'D\'où viennent les chiffres',
    notes: {
      NC: 'Fichiers du conseil électoral de l\'État, bulletin par bulletin. Le vote en personne s\'est ouvert le même jour de la semaine, 19 jours avant le scrutin, en 2022, 2024 et 2026.',
      PA: 'Données du département d\'État. Seul le vote postal est compté, l\'État n\'ayant presque pas de vote anticipé en personne. Les républicains ont commencé à voter par la poste en 2024 : une partie de leur hausse par rapport à 2022 correspond à des électeurs qui votaient avant le jour du scrutin.',
      FL: 'Comptes des comtés compilés par DataRepublican. Leur méthode donne exactement nos chiffres en Pennsylvanie, où les données officielles permettent de refaire le calcul.',
      CO: 'Rapports quotidiens du secrétariat d\'État. Le Colorado vote presque entièrement par la poste, et les non-affiliés y sont plus nombreux que les inscrits de chaque parti.',
      NV: 'Chiffres publiés chaque jour par The Nevada Independent à partir des comtés. Pour 2022, seul l\'écart entre les deux partis a été publié. Depuis 2021, le Nevada envoie un bulletin postal à tous les électeurs, et en 2024 les républicains ont surtout voté en personne avant le scrutin : la comparaison avec 2024 dit peu de chose.',
      AZ: 'Chiffres d\'analystes, l\'État ne publiant pas de bilan par parti : Stealth Analytics pour 2026 (11 jours avant), Data Orbital pour 2022 (12 jours avant), le suivi du Parti démocrate de l\'Arizona pour 2024 (14 jours avant). À 8 jours du scrutin de 2022, l\'avance démocrate était encore de 3 points.',
