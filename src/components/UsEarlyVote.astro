const hist = nc?.composition?.vote_history;
const newp = nc?.new_or_inactive_by_party?.[C26] ?? {};
const lvMode = nc?.likely_voter_samples?.[0]?.dimensions?.planned_mode;
const CYC = [C26, C22, C24];
const yearOf = (c: string) => c.slice(-4);
const rates = nc?.already_voted_rate;
const sources = [...states.flatMap((s) => s.sources), ...((data as any).compiler_sources ?? [])]
  .filter((src, i, all) => all.findIndex((x: any) => x.url === src.url) === i);
---

<article class="uev" data-content-area>
  <PageHeader title={T.title} promise={T.promise} question={T.answer} />

  <section class="container uev-section"><div class="vs-block">
    <h2>{T.sumTitle}</h2>
    <div class="uev-scroll">
      <table class="uev-results">
        <thead><tr>{T.sumTh.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {summary.map((s) => (
            <tr>
              <th scope="row">{nameOf(s)}{s.state === 'PA' && <span class="vs-meta uev-inline">{T.paNote}</span>}</th>
              <td>{pts(s.headline.dem_minus_rep[C26])}</td>
              <td>{pts(s.headline.dem_minus_rep[C22])}</td>
              <td><strong>{pts(gap22(s))}</strong></td>
              <td>{(T.sumSrc as any)[srcKind(s)]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="vs-meta">{T.sumMeta}</p>
  </div></section>

  <section class="container uev-section"><div class="vs-block">
    <h2>{T.detailTitle}</h2>
    <div class="uev-scroll">
      <table class="uev-detail">
        <thead><tr>{T.th.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        {summary.map((s) => (
          <tbody>
            {CYC.map((c) => (
              <tr class={c === C26 ? 'uev-now' : 'uev-ref'}>
                {c === C26 && <th scope="row" rowspan="3">{nameOf(s)}</th>}
                <td>{num(s.totals[c].ballots)} <span class="vs-meta uev-inline">{T.row(yearOf(c), dayLabel(s, c))}</span></td>
                <td>{pc(s.headline.shares[c].dem)}</td>
                <td>{pc(s.headline.shares[c].rep)}</td>
                <td>{pc(s.headline.shares[c].una)}</td>
                <td>{pts(s.headline.dem_minus_rep[c])}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div></section>

  <section class="container uev-section"><div class="vs-block">
    <h2>{T.notesTitle}</h2>
    <dl class="uev-notes">
      {summary.map((s) => ((T.notes as any)[s.state] && (
        <>
          <dt>{nameOf(s)}</dt>
          <dd>{(T.notes as any)[s.state]}</dd>
        </>
      )))}
    </dl>
  </div></section>

  {nc && (
    <section class="container uev-section"><div class="vs-block">
      <h2>{T.ncTitle}</h2>
      <p>{T.ncLede}</p>
      <div class="uev-grid">
        {[['age', T.ageTitle, T.age], ['vote_history', T.histTitle, T.hist], ['race', T.raceTitle, T.race]].map(([dim, title, labels]: any) => (
          nc.composition[dim] && (
            <div>
              <h3>{title}</h3>
              <table>
                <thead><tr><th></th>{CYC.map((c) => <th scope="col">{yearOf(c)}</th>)}</tr></thead>
                <tbody>
                  {nc.composition[dim].categories.map((k: string) => (
                    <tr>
                      <th scope="row">{labels[k] ?? k}</th>
                      {CYC.map((c) => <td>{pc(nc.composition[dim].shares[c][k])}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        ))}
      </div>
      {hist && <p class="vs-meta">{T.histNote}</p>}
      {newp.dem != null && <p>{T.newParty(newp.dem, newp.rep, (newp.una ?? 0) + (newp.other ?? 0))}</p>}
    </div></section>
  )}

  {rates?.regular && (
    <section class="container uev-section"><div class="vs-block">
      <h2>{T.rateTitle}</h2>
      <table class="uev-rates">
        <thead><tr><th></th><th scope="col">2022</th><th scope="col">2026</th></tr></thead>
        <tbody>
          {['regular', 'intermittent'].flatMap((g) => ['dem', 'rep', 'una'].map((p) => (
            <tr>
              <th scope="row">{(T.rateParty as any)[p]} {(T.rateRows as any)[g]}</th>
              <td>{pc(rates[g]?.[p]?.[C22])}</td>
              <td>{pc(rates[g]?.[p]?.[C26])}</td>
            </tr>
          )))}
        </tbody>
      </table>
      <p class="vs-meta">{T.rateMeta}</p>
      <p>{T.rateRead(rates.regular.rep[C22], rates.regular.rep[C26], rates.regular.dem[C22], rates.regular.dem[C26])}</p>
    </div></section>
  )}

  {nc && lvMode && (
    <section class="container uev-section"><div class="vs-block">
      <h2>{T.lvTitle}</h2>
      <p>{T.lv1(lvMode.early_share_lv_pct, lvMode.final_early_share_pct[C22], lvMode.final_early_share_pct[C24])} {T.lv2(nc.totals[C26].share_of_2022_final_turnout_pct)}</p>
    </div></section>
  )}

  <section class="container uev-section"><div class="vs-block">
    <h2>{T.cautionTitle}</h2>
    {T.caution.map((c) => <p>{c}</p>)}
  </div></section>

  <section class="container uev-section"><div class="vs-block">
    <h2>{T.methodTitle}</h2>
    <p>{T.method}</p>
    <ul class="uev-sources vs-meta">
      {sources.map((src: any) => <li><a href={src.url} rel="noopener">{src.label[locale] ?? src.label.en}</a></li>)}
      {nc?.likely_voter_samples?.[0] && <li><a href={nc.likely_voter_samples[0].source_url} rel="noopener">{T.elon}</a></li>}
    </ul>
  </div></section>
</article>

<style>
  .uev-section { margin-top: 32px; margin-bottom: 32px; }
  .uev-section p, .uev-notes dd { max-width: 72ch; }
  .uev table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .uev th, .uev td { text-align: left; padding: 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .uev td { text-align: right; }
  .uev thead th { font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .uev thead th:not(:first-child) { text-align: right; }
  .uev-results { border-top: 4px solid var(--ink); }
  .uev-scroll { overflow-x: auto; }
  .uev-inline { display: block; font-weight: 400; }
  td .uev-inline { display: inline; }
  .uev-detail tbody .uev-now td { border-top: 1px solid var(--ink); }
  .uev-ref td { color: var(--ink-2); font-size: 15px; }
  .uev-notes { margin: 0; }
  .uev-notes dt { font-weight: 700; margin-top: 12px; }
  .uev-notes dd { margin: 4px 0 0; color: var(--ink-2); }
  .uev-grid > div { max-width: 560px; margin: 24px 0; }
  .uev-grid h3 { font-size: 19px; margin: 0 0 4px; }
  .uev-rates { max-width: 520px; }
  .uev-sources { padding-left: 18px; }
</style>
