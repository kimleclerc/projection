    rateParty: { dem: 'Democratic', rep: 'Republican', una: 'Unaffiliated' },
    rateRead: (r22: number, r26: number, d22: number, d26: number) => Math.abs(r26 - r22) < 2
      ? `Regular Republican voters are voting at the same pace as in 2022 (${pc(r26)} vs ${pc(r22)}). The Republican share is down because regular Democratic voters are voting much earlier (${pc(d26)} vs ${pc(d22)}), and many of them would have voted anyway, on election day.`
      : `At this point, ${pc(r26)} of regular Republican voters have voted, vs ${pc(r22)} in 2022, and ${pc(d26)} of regular Democratic voters, vs ${pc(d22)}.`,
    lvTitle: 'What the polls expected',
    lv1: (lv: number, f22: number, f24: number) => `In Elon University's early-October poll, ${pc(lv, 0)} of likely voters planned to vote before election day. In 2022, ${pc(f22, 0)} of the final electorate did, and ${pc(f24, 0)} in 2024.`,
    lv2: (share: number) => `The ballots already cast amount to ${pc(share, 0)} of total 2022 turnout.`,
    cautionTitle: 'Limits',
    caution: [
      'Party registration is not a vote. Some registered Democrats vote Republican, and unaffiliated voters lean differently from state to state.',
