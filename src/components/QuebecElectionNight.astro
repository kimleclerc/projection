---
import { partyName } from '../lib/party-names';
/**
 * Soirée électorale québécoise du 5 octobre 2026.
 *
 * Cette page est le GABARIT de soirée, pas une page d'événement : le 5 octobre
 * elle reçoit la couche directe (dépouillement, sièges, appels) au-dessus des
 * sections ci-dessous, à la MÊME URL. C'est pour ça qu'elle existe dès
 * septembre — une URL créée le soir du scrutin n'a aucune chance d'être
 * indexée le soir du scrutin, et les partielles ont montré qu'une page de
 * soirée capte à elle seule une fraction majeure du trafic d'un mois.
 *
 * Tout ce qui est chiffré ici vient des données, jamais d'une valeur écrite en
 * dur : la projection est relue à chaque build nocturne et la feuille de route
 * est recomptée depuis le registre des appels résolus.
 */
import { getAllQuebecRidings } from '../lib/riding-adapters/quebec';
import { partyMeta } from '../lib/riding-adapters/parties';
import quebecMeta from '../../web_data/quebec/latest.json';
import resolvedCalls from '../../web_data/resolved-calls.json';
import type { Locale } from '../data/editorial';
import QuebecElectionNightLive from '../islands/QuebecElectionNightLive.tsx';
import QcLiveTileMap from '../islands/QcLiveTileMap.tsx';
import QcLiveFeed from '../islands/QcLiveFeed.tsx';
import QcLiveList from '../islands/QcLiveList.tsx';
import ridingsSource from '../../web_data/quebec/ridings.json';
import liveRidingData from '../data/qc-live-ridings.json';

// LECTURE PUBLIQUE = RAIL STATIQUE. Chaque lecture du Worker est une invocation
// facturée, même servie par `caches.default` : le cache protège le Durable
// Object, pas le quota. Le plan gratuit plafonne à 100 000 requêtes/jour, soit
// ~830 onglets sur une soirée à un sondage/90 s — et la seule page Clacton a
// fait 3 665 vues en une partielle. Le service s'arrêterait net en plein
// dépouillement. Les actifs statiques de Pages n'ont pas de plafond publié.
// Voir `models/docs/NOTE_VOLUME_SOIREE_QC_2026-10-05.md` §3.2 et §3.5.
//
// Le Worker reste le REPLI, pas le chemin : une fraction infime du trafic, donc
// sans risque de quota, mais une panne du statique ne nous laisse pas muets.
//
// `votescope-live.pages.dev` est le nom actuel du projet ; `live.vote-scope.com`
// est le nom visé une fois l'enregistrement DNS posé — changer la valeur par
// défaut ci-dessous le jour où il existe.
const LIVE_EVENT_ID = import.meta.env.PUBLIC_LIVE_EVENT_ID ?? 'qc-2026-10-05';
const liveApiBase = import.meta.env.PUBLIC_LIVE_API_BASE ?? 'https://votescope-live.pages.dev';
const liveFallbackApiBase = import.meta.env.PUBLIC_LIVE_FALLBACK_API_BASE ?? 'https://vote-scope.com';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// ── Données ────────────────────────────────────────────────────────
const meta = quebecMeta.meta;
const totalSeats = meta.total_seats;
const majority = meta.majority_threshold;
const runDate = meta.run_date;

const seatParties = quebecMeta.parties
  .filter((p) => p.seats_projected > 0)
  .slice()
  .sort((a, b) => b.seats_projected - a.seats_projected);

// Sélection par probabilité de course serrée — c'est elle qui dit si une course
// PEUT basculer, pas l'écart seul. L'affichage, lui, est réordonné par écart :
// une liste qui montre 2,1 pt avant 1,9 pt a l'air d'un tri cassé, même quand
// le classement sous-jacent est le bon.
const closest = getAllQuebecRidings()
  .slice()
  .sort((a, b) => b.projection.p_close_race - a.projection.p_close_race)
  .slice(0, 8)
  .sort((a, b) => a.projection.mean_margin - b.projection.mean_margin);

// Feuille de route : recomptée, jamais écrite en dur.
const electionCalls = (resolvedCalls.calls as Array<{ domain?: string; result?: { status?: string } }>)
  .filter((c) => c.domain === 'election');
const callsTotal = electionCalls.length;
const callsCorrect = electionCalls.filter((c) => c.result?.status === 'correct').length;

// Le point décimal est anglais : le français et l'espagnol prennent la virgule.
// Même convention que CalibrationSection / CanadaByelectionRaceDesk.
const num = (v: number, d = 1) =>
  locale === 'en' ? v.toFixed(d) : v.toFixed(d).replace('.', ',');

const ridingsBase = { fr: 'circonscriptions', en: 'ridings', es: 'distritos' }[locale];

// Blocs du direct (carte, annonces, liste) : partis et circonscriptions joints
// au build. Le gagnant de 2022 sert aux « gains »; le live.json ne le porte pas.
const LIVE_PARTIES = ['pq', 'caq', 'plq', 'pcq', 'qs', 'qc_oth'].map((code) => {
  const m = partyMeta('quebec', code);
  return { code, color: m.color, label: partyName(m, locale) };
});
const slugById = new Map(getAllQuebecRidings().map((d) => [d.id, d.slug]));
const liveRidings = (ridingsSource as any).ridings.map((r: any) => ({
  id: r.riding_id,
  name: locale === 'en' ? (r.name_en || r.name_fr) : (r.name_fr || r.name_en),
  href: `/${locale}/canada/quebec/${ridingsBase}/${slugById.get(r.riding_id) ?? r.riding_id}/`,
  region: r.region ?? 'rest',
  winner2022: r.baseline_result?.winner ?? null,
  projected: r.projection?.winner ?? null,
  ...((liveRidingData as any)[r.riding_id] ?? {}),
}));
// Sièges projetés avant le scrutin, pour la jauge « vs projection ».
const projectedSeats = Object.fromEntries(quebecMeta.parties.map((p: any) => [p.party, p.seats_projected]));
const projectedBy = Object.fromEntries((ridingsSource as any).ridings.map((r: any) => [r.riding_id, r.projection?.winner]).filter(([, w]: any) => w));
const pollsBase = { fr: 'sondages', en: 'polls', es: 'sondeos' }[locale];

// ── Textes ─────────────────────────────────────────────────────────
const COPY = {
  fr: {
    eyebrow: 'Élection générale québécoise · 5 octobre 2026',
    h1: 'Élections Québec 2026 : les résultats, le PQ forme un gouvernement minoritaire',
    lede: 'Dès la fermeture des bureaux, à 20 h le 5 octobre, cette page porte le dépouillement en direct des 127 circonscriptions : voix, bureaux dépouillés, sièges, et les gagnants annoncés dès que le résultat est certain. Elle se met à jour d’elle-même : l’heure de chaque annonce, qui forme le gouvernement, et l’écart avec notre projection.',
    scheduleTitle: 'Le déroulé de la soirée',
    schedule: [
      { time: '20 h 00', label: 'Fermeture des bureaux', text: 'Élections Québec commence à publier les résultats par bureau de vote. La source officielle se rafraîchit toutes les deux à cinq minutes; cette page suit la même cadence.' },
      { time: '20 h 15', label: 'Les premiers bureaux', text: 'Une avance de quelques centaines de voix ne veut encore rien dire. Les bureaux ne se ressemblent pas, et l’ordre dans lequel ils rentrent fabrique des mirages — c’est le moment de la soirée où les chiffres bruts trompent le plus.' },
      { time: 'En continu', label: 'Les gagnants annoncés', text: 'Dès que le résultat d’une circonscription est certain, nous annonçons le gagnant et elle change de couleur sur la carte. Les courses serrées attendent, parfois longtemps.' },
      { time: 'Fin de soirée', label: 'Le portrait complet', text: 'Le décompte circonscription par circonscription, la composition de l’Assemblée nationale, et l’écart entre notre projection d’avant-scrutin et le résultat réel.' },
    ],
    methodTitle: 'Quand annonçons-nous un gagnant?',
    methodLede: 'Être en avance au décompte ne suffit pas. Nous annonçons un gagnant seulement quand plus rien ne peut changer le résultat dans la circonscription.',
    thresholds: [
      { value: 'Gagnant', text: 'L’avance ne peut plus être rattrapée avec les bureaux qui restent à dépouiller : la circonscription est annoncée et change de couleur.' },
      { value: 'Serré', text: 'Quand ça se joue à quelques centaines de voix, on attend. Mieux vaut annoncer tard que se tromper.' },
      { value: 'Deux modèles', text: 'Une annonce part seulement si nos deux modèles indépendants la jugent sûre pour le même parti; sinon une personne décide. Dans le doute, on attend.' },
    ],
    methodNote: `Notre bilan : ${callsCorrect} bonnes annonces sur ${callsTotal} lors des dernières élections.`,
    trackCta: 'Voir toutes nos annonces',
    projectionTitle: 'Notre projection d’avant-scrutin',
    projectionLede: 'Les sièges que notre modèle donnait à chaque parti la veille du vote, à comparer au résultat ci-dessus.',
    majorityLabel: `Majorité : ${majority} sièges`,
    seatsLabel: 'sièges projetés',
    runLabel: 'Projection du',
    deskCta: 'Ouvrir la projection détaillée',
    closeTitle: 'Les courses qui se décideront tard',
    closeLede: 'Les huit circonscriptions où l’écart projeté est le plus mince. Ce sont celles qui seront appelées en dernier, et souvent celles qui décident de la majorité.',
    marginLabel: 'écart projeté',
    linksTitle: 'Pendant ce temps',
    links: [
      { href: `/fr/canada/quebec/${ridingsBase}/`, label: 'Les 127 circonscriptions', text: 'Projection, député·e sortant·e, candidats déclarés et trajectoire, une page par circonscription.' },
      { href: `/fr/canada/quebec/${pollsBase}/`, label: 'Tous les sondages', text: 'Chaque sondage québécois publié depuis 2022, avec sa maison, son terrain et son poids dans le modèle.' },
      { href: '/fr/outils/simulateur-quebec/', label: 'Le simulateur', text: 'Faites bouger le vote et regardez les 127 circonscriptions réagir, sans confondre votre scénario avec notre projection.' },
      { href: '/fr/methodologie/', label: 'La méthodologie', text: 'Comment le modèle passe des sondages aux sièges, et ce qu’il ne prétend pas savoir.' },
    ],
    sourceNote: 'Source officielle du dépouillement : Élections Québec. Les projections, les seuils de décision et les appels appartiennent à Vote-Scope; Élections Québec ne fait et ne fournit aucun appel.',
    licenceNote: 'Comprend des données ouvertes octroyées sous la licence d’utilisation des données ouvertes du directeur général des élections disponible à l’adresse Web dgeq.org. L’octroi de la licence n’implique aucune approbation par le directeur général des élections de l’utilisation des données ouvertes qui en est faite.',
  },
  en: {
    eyebrow: 'Quebec general election · October 5, 2026',
    h1: 'Quebec election 2026 results: the PQ forms a minority government',
    lede: 'From the moment polls close at 8 p.m. on October 5, this page carries the live count across all 127 ridings: votes, polls reporting, seats, and our race calls the moment they are safe enough to publish. It updates on its own: the time of every call, who forms the government, and the gap with our forecast.',
    scheduleTitle: 'How the night unfolds',
    schedule: [
      { time: '8:00 p.m.', label: 'Polls close', text: 'Élections Québec begins publishing results poll by poll. The official source refreshes every two to five minutes; this page follows the same cadence.' },
      { time: '8:15 p.m.', label: 'The first boxes', text: 'A lead of a few hundred votes means nothing yet. Polling stations are not alike, and the order they report in manufactures mirages — this is the hour of the night when raw numbers mislead most.' },
      { time: 'Throughout', label: 'The calls', text: 'The moment a riding clears our certainty threshold, it is called and changes colour on the map. Close races wait, sometimes for a long time.' },
      { time: 'Late night', label: 'The full picture', text: 'The count riding by riding, the composition of the National Assembly, and the gap between our pre-election projection and the actual result.' },
    ],
    methodTitle: 'When do we call a winner?',
    methodLede: 'Being ahead in the count is not enough. We only call a winner when nothing left to count can change the result in that riding.',
    thresholds: [
      { value: 'Called', text: 'The lead can no longer be overtaken with the polls still to count: the riding is called and changes colour.' },
      { value: 'Too close', text: 'When it comes down to a few hundred votes, we wait. Better late than wrong.' },
      { value: 'Two models', text: 'A call goes out only when our two independent models both judge it safe for the same party; otherwise a person decides. When in doubt, we wait.' },
    ],
    methodNote: `Our record: ${callsCorrect} correct calls out of ${callsTotal} in recent elections.`,
    trackCta: 'See all our calls',
    projectionTitle: 'Our pre-election forecast',
    projectionLede: 'The seats our model gave each party on the eve of the vote, to compare with the result above.',
    majorityLabel: `Majority: ${majority} seats`,
    seatsLabel: 'projected seats',
    runLabel: 'Projection of',
    deskCta: 'Open the full forecast',
    closeTitle: 'The races that will be decided late',
    closeLede: 'The eight ridings with the thinnest projected margin. These are the last to be called, and often the ones that decide the majority.',
    marginLabel: 'projected margin',
    linksTitle: 'In the meantime',
    links: [
      { href: `/en/canada/quebec/${ridingsBase}/`, label: 'All 127 ridings', text: 'Projection, sitting member, declared candidates and trajectory — one page per riding.' },
      { href: `/en/canada/quebec/${pollsBase}/`, label: 'Every poll', text: 'Every Quebec poll published since 2022, with its firm, field dates and weight in the model.' },
      { href: '/en/tools/quebec-simulator/', label: 'The simulator', text: 'Move the vote and watch all 127 ridings react, without confusing your scenario with our projection.' },
      { href: '/en/methodology/', label: 'The methodology', text: 'How the model goes from polls to seats, and what it does not claim to know.' },
    ],
    sourceNote: 'Official count source: Élections Québec. Projections, decision thresholds and calls belong to Vote-Scope; Élections Québec makes and supplies no calls.',
    licenceNote: 'Comprend des données ouvertes octroyées sous la licence d’utilisation des données ouvertes du directeur général des élections disponible à l’adresse Web dgeq.org. L’octroi de la licence n’implique aucune approbation par le directeur général des élections de l’utilisation des données ouvertes qui en est faite. (Contains open data licensed under the Chief Electoral Officer’s open data licence, available at dgeq.org; the licence implies no endorsement of how the data is used.)',
  },
  es: {
    eyebrow: 'Elección general de Quebec · 5 de octubre de 2026',
    h1: 'Elecciones de Quebec 2026: resultados, el PQ forma un gobierno minoritario',
    lede: 'Desde el cierre de las urnas, a las 20:00 del 5 de octubre, esta página lleva el recuento en directo de los 127 distritos: votos, mesas escrutadas, escaños y nuestros pronunciamientos en cuanto son lo bastante seguros para publicarse. Se actualiza sola: la hora de cada anuncio, quién forma el gobierno y la diferencia con nuestra proyección.',
    scheduleTitle: 'El desarrollo de la noche',
    schedule: [
      { time: '20:00', label: 'Cierre de las mesas', text: 'Élections Québec empieza a publicar los resultados mesa por mesa. La fuente oficial se actualiza cada dos a cinco minutos; esta página sigue la misma cadencia.' },
      { time: '20:15', label: 'Las primeras mesas', text: 'Una ventaja de unos cientos de votos todavía no significa nada. Las mesas no se parecen entre sí, y el orden en que llegan fabrica espejismos: es el momento de la noche en que las cifras brutas más engañan.' },
      { time: 'En continuo', label: 'Los pronunciamientos', text: 'En cuanto un distrito supera nuestro umbral de certeza, se adjudica y cambia de color en el mapa. Las contiendas ajustadas esperan, a veces mucho.' },
      { time: 'Final de la noche', label: 'El panorama completo', text: 'El recuento distrito por distrito, la composición de la Asamblea Nacional y la distancia entre nuestra proyección previa y el resultado real.' },
    ],
    methodTitle: '¿Cuándo anunciamos un ganador?',
    methodLede: 'Ir por delante en el recuento no basta. Solo anunciamos un ganador cuando nada de lo que queda por contar puede cambiar el resultado del distrito.',
    thresholds: [
      { value: 'Ganador', text: 'La ventaja ya no puede ser alcanzada con las mesas que quedan por contar: el distrito se anuncia y cambia de color.' },
      { value: 'Ajustado', text: 'Cuando se decide por unos cientos de votos, esperamos. Mejor tarde que equivocados.' },
      { value: 'Dos modelos', text: 'Un anuncio sale solo si nuestros dos modelos independientes lo consideran seguro para el mismo partido; si no, decide una persona. Ante la duda, esperamos.' },
    ],
    methodNote: `Nuestro historial: ${callsCorrect} anuncios acertados de ${callsTotal} en las últimas elecciones.`,
    trackCta: 'Ver todos nuestros anuncios',
    projectionTitle: 'Nuestra proyección previa',
    projectionLede: 'Los escaños que nuestro modelo daba a cada partido la víspera de la votación, para comparar con el resultado de arriba.',
    majorityLabel: `Mayoría: ${majority} escaños`,
    seatsLabel: 'escaños proyectados',
    runLabel: 'Proyección del',
    deskCta: 'Abrir la proyección detallada',
    closeTitle: 'Las contiendas que se decidirán tarde',
    closeLede: 'Los ocho distritos con el margen proyectado más estrecho. Son los últimos en adjudicarse, y a menudo los que deciden la mayoría.',
    marginLabel: 'margen proyectado',
    linksTitle: 'Mientras tanto',
    links: [
      { href: `/es/canada/quebec/${ridingsBase}/`, label: 'Los 127 distritos', text: 'Proyección, diputado saliente, candidaturas declaradas y trayectoria: una página por distrito.' },
      { href: `/es/canada/quebec/${pollsBase}/`, label: 'Todos los sondeos', text: 'Cada sondeo quebequés publicado desde 2022, con su casa, su trabajo de campo y su peso en el modelo.' },
      { href: '/es/herramientas/simulador-quebec/', label: 'El simulador', text: 'Mueva el voto y vea reaccionar a los 127 distritos, sin confundir su escenario con nuestra proyección.' },
      { href: '/es/metodologia/', label: 'La metodología', text: 'Cómo pasa el modelo de los sondeos a los escaños, y qué no pretende saber.' },
    ],
    sourceNote: 'Fuente oficial del recuento: Élections Québec. Las proyecciones, los umbrales de decisión y los pronunciamientos son de Vote-Scope; Élections Québec no emite ni suministra ningún pronunciamiento.',
    licenceNote: 'Comprend des données ouvertes octroyées sous la licence d’utilisation des données ouvertes du directeur général des élections disponible à l’adresse Web dgeq.org. L’octroi de la licence n’implique aucune approbation par le directeur général des élections de l’utilisation des données ouvertes qui en est faite. (Incluye datos abiertos bajo la licencia de datos abiertos del director general de elecciones, disponible en dgeq.org; la licencia no implica aprobación alguna del uso que se hace de los datos.)',
  },
}[locale];

const deskHref = `/${locale}/canada/quebec/`;
const trackHref = `/${locale}/track-record/`;
// Bilan d'après-scrutin : notre projection et les sondeurs face au résultat.
const REVIEW = {
  fr: { title: 'Le bilan', ours: ['Notre bilan', 'Ce qu’on a vu juste, nos erreurs, nos deux moteurs et nos annonces du soir.', '/fr/track-record/quebec-2026/'], polls: ['Quels sondeurs croire ?', 'Léger, Forum, Pallas, Mainstreet… le classement des maisons de sondage.', '/fr/methodologie/sondeurs/'] },
  en: { title: 'The review', ours: ['How we did', 'What we got right, our misses, our two engines and our election-night calls.', '/en/track-record/quebec-2026/'], polls: ['Which pollsters to trust?', 'Léger, Forum, Pallas, Mainstreet… polling firms ranked by accuracy.', '/en/methodology/pollsters/'] },
  es: { title: 'El balance', ours: ['Nuestro balance', 'Lo que acertamos, nuestros errores, nuestros dos motores y los anuncios de la noche.', '/es/track-record/quebec-2026/'], polls: ['¿A qué encuestadoras creer?', 'Léger, Forum, Pallas, Mainstreet… la clasificación de las encuestadoras.', '/es/metodologia/encuestadoras/'] },
}[locale];
const seatTotal = seatParties.reduce((s, p) => s + p.seats_projected, 0) || totalSeats;
const runDateText = new Intl.DateTimeFormat(
  { fr: 'fr-CA', en: 'en-CA', es: 'es-ES' }[locale],
  { day: 'numeric', month: 'long', year: 'numeric' },
).format(new Date(`${runDate}T12:00:00Z`));
---

<article class="qen" data-content-area>
<section class="qen-hero vs-page-head">
  <div class="container">
    <p class="eyebrow">{COPY.eyebrow}</p>
    <h1>{COPY.h1}</h1>
    <p class="lede">{COPY.lede}</p>
  </div>
</section>

<section class="qen-live">
  <div class="container">
    <QuebecElectionNightLive client:load eventId={LIVE_EVENT_ID} lang={locale} apiBase={liveApiBase} fallbackApiBase={liveFallbackApiBase} projected={projectedSeats} projectedBy={projectedBy} />
  </div>
</section>

<section class="qen-review">
  <div class="container">
    <h2>{REVIEW.title}</h2>
    <div class="qen-review-grid">
      {[REVIEW.ours, REVIEW.polls].map(([t, d, h]) => (
        <a href={h}><strong>{t}</strong><span>{d}</span></a>
      ))}
    </div>
  </div>
</section>

<section class="qen-map">
  <div class="container">
    <QcLiveTileMap client:load lang={locale} parties={LIVE_PARTIES} ridings={liveRidings} />
  </div>
</section>

<section class="qen-feed">
  <div class="container">
    <QcLiveFeed client:load lang={locale} parties={LIVE_PARTIES} ridings={liveRidings} />
  </div>
</section>

<section class="qen-list">
  <div class="container">
    <QcLiveList client:load lang={locale} parties={LIVE_PARTIES} ridings={liveRidings} />
  </div>
</section>


<section class="qen-method">
  <div class="container">
    <h2>{COPY.methodTitle}</h2>
    <p class="qen-lede">{COPY.methodLede}</p>
    <ul class="qen-thresholds">
      {COPY.thresholds.map((t) => (
        <li>
          <strong>{t.value}</strong>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>
    <p class="qen-note">{COPY.methodNote} <a href={trackHref}>{COPY.trackCta}</a></p>
  </div>
</section>

<section class="qen-projection">
  <div class="container">
    <h2>{COPY.projectionTitle}</h2>
    <p class="qen-lede">{COPY.projectionLede}</p>

    <div class="qen-bar" role="img" aria-label={`${COPY.seatsLabel} — ${seatParties.map((p) => `${partyName(p, locale)} ${p.seats_projected}`).join(', ')}`}>
      {seatParties.map((p) => (
        <span style={`--w:${(100 * p.seats_projected) / seatTotal}%;--c:${p.color}`}></span>
      ))}
      <i class="qen-majority" style={`--m:${(100 * majority) / totalSeats}%`} aria-hidden="true"></i>
    </div>
    <p class="qen-majority-label">{COPY.majorityLabel}</p>

    <ul class="qen-legend">
      {seatParties.map((p) => (
        <li>
          <i style={`--c:${p.color}`} aria-hidden="true"></i>
          <span class="qen-party">{partyName(p, locale)}</span>
          <strong>{p.seats_projected}</strong>
        </li>
      ))}
    </ul>

    <p class="qen-note">
      <span class="mono">{COPY.runLabel} {runDateText}</span> · <a href={deskHref}>{COPY.deskCta}</a>
    </p>
  </div>
</section>

<section class="qen-close">
  <div class="container">
    <h2>{COPY.closeTitle}</h2>
    <p class="qen-lede">{COPY.closeLede}</p>
    <ul class="qen-races">
      {closest.map((r) => {
        const pm = partyMeta(r.jurisdiction, r.projection.winner);
        return (
          <li>
            <a href={`/${locale}/canada/quebec/${ridingsBase}/${r.slug}/`} style={`--c:${pm.color}`}>
              <span class="qen-dot" aria-hidden="true"></span>
              <span class="qen-riding">{locale === 'fr' ? r.name.fr : r.name.en}</span>
              <span class="qen-lead">{partyName(pm, locale)}</span>
              <span class="qen-margin">{num(r.projection.mean_margin)} pt · {COPY.marginLabel}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<section class="qen-links">
  <div class="container">
    <h2>{COPY.linksTitle}</h2>
