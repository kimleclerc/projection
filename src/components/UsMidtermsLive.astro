---
/**
 * Mi-mandat américaines du 3 novembre 2026 : la couche directe des pages
 * Chambre, Sénat et gouverneurs, et de leurs versions intégrables.
 *
 * L'îlot lit `live.json` (même contrat qu'au Québec et en C.-B. : rail Pages
 * d'abord, Worker en repli) et ne garde que les courses de sa chambre. Avant
 * 17 h 30 HNE le 3 novembre, il ne fait aucune lecture et annonce l'heure des
 * premières fermetures.
 */
import UsMidtermsLive from '../islands/UsMidtermsLive.tsx';
import UsNationalCalls from '../islands/UsNationalCalls.tsx';
import { partyMeta } from '../lib/riding-adapters/parties';
import { EMBED, US_LIVE_API_BASE, US_LIVE_EVENT_ID, US_LIVE_FALLBACK_API_BASE, usLiveProps } from '../data/us-live';
import type { Chamber } from '../islands/usLive';

interface Props { chamber: Chamber; locale: 'fr' | 'en' | 'es'; compact?: boolean }
const { chamber, locale, compact = false } = Astro.props;
const props = usLiveProps(chamber, locale);
const liveUrl = (base: string) => `${base.replace(/\/$/, '')}/api/v1/elections/${US_LIVE_EVENT_ID}/live.json`;
---
<div class={`usl-wrap${compact ? ' is-compact' : ''}`} id="resultats">
  <UsNationalCalls client:load lang={locale} liveUrl={liveUrl(US_LIVE_API_BASE)} fallbackUrl={liveUrl(US_LIVE_FALLBACK_API_BASE)}
    demColor={partyMeta('us-house', 'us_dem').color} repColor={partyMeta('us-house', 'us_rep').color} pageUrl={`https://vote-scope.com/${locale}/us/`} />
  <UsMidtermsLive client:load eventId={US_LIVE_EVENT_ID} lang={locale} apiBase={US_LIVE_API_BASE}
    fallbackApiBase={US_LIVE_FALLBACK_API_BASE} embedPath={EMBED[chamber][locale]} compact={compact} {...props} />
</div>
<style>
  .usl-wrap { max-width: 1080px; margin-inline: auto; padding-inline: 1.5rem; }
  .usl-wrap.is-compact { padding-inline: 0; }
  @media (max-width: 620px) { .usl-wrap { padding-inline: 16px; } .usl-wrap.is-compact { padding-inline: 0; } }
</style>
