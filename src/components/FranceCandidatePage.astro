---
// Page profil d'un candidat présidentiel France 2027 — composant partagé fr/en.
// Répond à « Qui est X ? Comment est-il/elle sondé·e ? » (une question, une
// page). Contenu factuel + data-driven → texte SEO qui s'auto-alimente.
import { blocVar, blocLabel, statusLabel, fmtPct1, franceBase, franceCandBase, type Locale } from '../lib/fr-pres';
import { candidateProse, slugify, getAllCandidates, type CandidateProfile } from '../lib/fr-candidates';
import ContextualBookShelf from './ContextualBookShelf.astro';
import ShareModule from '../islands/lib/ShareModule.tsx';
import frLatest from '../../web_data/france-presidential/latest.json';
import { contextualBooks } from '../data/contextualBooks';

interface Props {
  candidate: CandidateProfile;
  locale: Locale;
}
const { candidate: c, locale } = Astro.props;

const prose = candidateProse(c, locale);
const bio = c.bio ? c.bio[locale] : null;
const AXIS_MAX = Math.max(45, Math.ceil((c.polling.ceiling ?? 0) / 15) * 15);
const dateLabel = (value: string) => new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : locale === 'es' ? 'es-ES' : 'en-GB', {day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'}).format(new Date(value.slice(0, 10) + 'T00:00:00Z')); // échelle de l'axe des intentions de vote (%)

// Autres candidats du même bloc + quelques têtes d'affiche (rabbit-hole).
const others = getAllCandidates().filter((x) => x.id !== c.id && !x.archived);
const sameBloc = others.filter((x) => x.bloc === c.bloc).slice(0, 3);
const topOthers = others.filter((x) => x.bloc !== c.bloc).slice(0, 4);
const related = [...sameBloc, ...topOthers].slice(0, 5);
const hasCandidateBooks = contextualBooks.some((book) => book.candidateIds?.includes(c.id));

const base = franceBase(locale);
const candBase = franceCandBase(locale);

const COPY = {
  fr: {
        back: '← Présidentielle 2027',
        party: 'Famille politique',
        status: 'Statut',
        pollingTitle: 'Intentions de vote au premier tour',
        pollingHelp: `Minimum et maximum publiés dans les sondages des 90 derniers jours : ${c.polling.surveys} enquête(s), ${c.polling.hypotheses} hypothèse(s) de candidatures. Les listes diffèrent; ce n’est pas une marge d’erreur.`,
        floor: 'Minimum observé',
        ceiling: 'Maximum observé',
        best: 'Meilleure hypothèse',
        top2: 'Qualification — meilleure hypothèse',
        duelsTitle: 'Duels de second tour',
        duelsHelp: 'Estimations conditionnelles à la qualification des deux candidats. Pour chaque adversaire, le duel le plus probable parmi les hypothèses actuellement modélisées.',
        wins: 'en tête',
        loses: 'défaite',
        vs: 'face à',
        relatedTitle: 'Autres candidats',
        exploreCta: 'Comparer toutes les hypothèses',
        allCandidates: 'Tous les candidats',
        noDuel: 'Aucune estimation de second tour disponible dans les hypothèses actuellement modélisées.',
      },
  en: {
        back: '← France Desk',
        party: 'Political family',
        status: 'Status',
        pollingTitle: 'First-round voting intention',
        pollingHelp: `Published minimum and maximum over the last 90 days: ${c.polling.surveys} survey(s), ${c.polling.hypotheses} hypothetical lineup(s). Fields differ; this is not a margin of error.`,
        floor: 'Observed minimum',
        ceiling: 'Observed maximum',
        best: 'Best lineup',
        top2: 'Qualification — best lineup',
        duelsTitle: 'Runoff matchups',
        duelsHelp: 'Estimates conditional on both candidates qualifying. Each opponent uses the most probable matchup across currently modelled lineups.',
        wins: 'ahead',
        loses: 'behind',
        vs: 'vs',
        relatedTitle: 'Other candidates',
        exploreCta: 'See all lineups',
        allCandidates: 'All candidates',
        noDuel: 'No projected runoff matchup yet.',
      },
  es: {
        back: '← Mesa Francia',
        party: 'Familia política',
        status: 'Estado',
        pollingTitle: 'Intención de voto en primera vuelta',
        pollingHelp: `Mínimo y máximo publicados en los últimos 90 días: ${c.polling.surveys} encuesta(s), ${c.polling.hypotheses} combinación(es). Las listas difieren; no es un margen de error.`,
        floor: 'Mínimo observado',
        ceiling: 'Máximo observado',
        best: 'Mejor combinación',
        top2: 'Clasificación — mejor combinación',
        duelsTitle: 'Duelos de segunda vuelta',
        duelsHelp: 'Estimaciones condicionadas a que ambos candidatos se clasifiquen. Para cada rival se muestra el duelo más probable entre las combinaciones modelizadas.',
        wins: 'en cabeza',
        loses: 'por detrás',
        vs: 'frente a',
        relatedTitle: 'Otros candidatos',
        exploreCta: 'Ver todas las combinaciones',
        allCandidates: 'Todos los candidatos',
        noDuel: 'Aún no hay duelo de segunda vuelta proyectado.',
      },
} as const;
const C = COPY[locale];
const detail = {
  fr: {updated: 'Données et projections du', reviewed: 'Statut vérifié le', source: 'Source du statut', noPoll: 'Aucune intention de vote publiée dans les 90 derniers jours dans notre base.', lastPoll: 'Dernière mesure connue :', never: 'Aucune intention de vote recensée dans notre base.', model: 'Projection du modèle', modelHelp: `${c.activeScenarios} hypothèse(s) actuellement modélisée(s). Les chiffres ci-dessous dépendent de la liste des candidats; la probabilité est conditionnelle à la présence de cette candidature.`, noModel: 'Aucune projection actuelle pour cette candidature. Une absence de mesure ne vaut pas 0 %.', recent: 'Derniers sondages', trend: 'Voir la tendance de cette candidature', archive: 'Archive de campagne — candidature terminée', archiveHelp: 'Les éventuelles mesures ci-dessous sont historiques. Aucune probabilité actuelle de qualification n’est attribuée à cette candidature.'},
  en: {updated: 'Data and forecasts as of', reviewed: 'Status reviewed on', source: 'Status source', noPoll: 'No published first-round voting intention in our database over the last 90 days.', lastPoll: 'Last known observation:', never: 'No first-round voting intention recorded in our database.', model: 'Model forecast', modelHelp: `${c.activeScenarios} currently modelled lineup(s). Estimates depend on the candidate field; qualification is conditional on this candidate appearing.`, noModel: 'No current forecast for this candidate. Missing data does not mean 0%.', recent: 'Latest polls', trend: 'See this candidate’s trend', archive: 'Campaign archive — candidacy ended', archiveHelp: 'Any observations below are historical. No current qualification probability is assigned to this candidacy.'},
  es: {updated: 'Datos y proyecciones del', reviewed: 'Estado revisado el', source: 'Fuente del estado', noPoll: 'No hay intención de voto publicada en nuestra base durante los últimos 90 días.', lastPoll: 'Última observación conocida:', never: 'No hay intención de voto registrada en nuestra base.', model: 'Proyección del modelo', modelHelp: `${c.activeScenarios} combinación(es) modelizada(s). Las estimaciones dependen de la lista; la clasificación está condicionada a la presencia de esta candidatura.`, noModel: 'No hay proyección actual para esta candidatura. La falta de datos no significa 0 %.', recent: 'Últimas encuestas', trend: 'Ver la tendencia de esta candidatura', archive: 'Archivo de campaña — candidatura terminada', archiveHelp: 'Las posibles observaciones siguientes son históricas. No se atribuye una probabilidad actual de clasificación a esta candidatura.'},
}[locale];

---

<article class="frc" data-content-area>
  <header class="frc-hero container vs-page-head">
    <a class="frc-back" href={base}>{C.back}</a>
    <div class="frc-id">
      <span class="frc-swatch" style={`background:${blocVar(c.bloc)}`} />
      <h1 class="frc-name">{c.name}</h1>
    </div>
    <div class="frc-badges">
      <span class="frc-badge">{blocLabel(c.bloc, locale, c.partyFamily)}</span>
      <span class={`frc-badge frc-status is-${c.status}`}>{statusLabel(c.status, locale)}</span>
    </div>
    <p class="frc-section-help">{detail.updated} <time datetime={c.runDate}>{dateLabel(c.runDate)}</time></p>
    {c.archived && <p class="frc-archive">{detail.archive}</p>}
    <ShareModule lang={locale} kind="candidate" election={c.slug} runDate={(frLatest as any).meta.run_date} client:idle />
  </header>

  <section class="frc-section container frc-prose" aria-label={c.name}>
    {bio && <p class="frc-bio">{bio}</p>}
    {prose.map((p) => <p>{p}</p>)}
    {locale === 'fr' && c.statusNote && <p>{c.statusNote}</p>}
    {c.statusReviewedOn && <p class="frc-section-help">{detail.reviewed} <time datetime={c.statusReviewedOn}>{dateLabel(c.statusReviewedOn)}</time>. {c.statusSource && <a href={c.statusSource}>{detail.source}</a>}</p>}

  </section>

  {hasCandidateBooks && (
    <section class="frc-section container">
      <ContextualBookShelf lang={locale} candidateId={c.id} candidateName={c.name} limit={2} />
    </section>
  )}

  <!-- FOURCHETTE 1er TOUR -->
  <section class="frc-section container" aria-labelledby="frc-polling">
    <h2 id="frc-polling" class="frc-section-title">{C.pollingTitle}</h2>
    {c.archived && <p class="frc-section-help">{detail.archiveHelp}</p>}
    {c.polling.floor !== null && c.polling.ceiling !== null ? <>
      <p class="frc-section-help">{C.pollingHelp}</p>
      <div class="frc-range" role="img" aria-label={`${C.floor} ${fmtPct1(c.polling.floor, locale)}, ${C.ceiling} ${fmtPct1(c.polling.ceiling, locale)}`}>
        <div class="frc-range-track"><div class="frc-range-band" style={`left:${c.polling.floor / AXIS_MAX * 100}%; width:${Math.max(0.2, (c.polling.ceiling - c.polling.floor) / AXIS_MAX * 100)}%; background:${blocVar(c.bloc)}`} /></div>
        <div class="frc-range-scale">{[0, AXIS_MAX / 3, AXIS_MAX * 2 / 3, AXIS_MAX].map(v => <span>{v} %</span>)}</div>
      </div>
      <dl class="frc-stats"><div><dt>{C.floor}</dt><dd>{fmtPct1(c.polling.floor, locale)}</dd></div><div><dt>{C.ceiling}</dt><dd>{fmtPct1(c.polling.ceiling, locale)}</dd></div></dl>
    </> : <p class="frc-empty">{detail.noPoll} {c.polling.lastFieldEnd ? `${detail.lastPoll} ${dateLabel(c.polling.lastFieldEnd)}.` : detail.never}</p>}
    {c.polling.recent.length > 0 && <>
      <h3>{detail.recent}</h3>
      <ul class="frc-polls">{c.polling.recent.map(p => <li>
        <span>{p.source ? <a href={p.source}>{p.firm}</a> : p.firm} · <time datetime={p.date}>{dateLabel(p.date)}</time></span>
        <strong>{p.min === p.max ? fmtPct1(p.min, locale) : `${fmtPct1(p.min, locale)} – ${fmtPct1(p.max, locale)}`}</strong>
      </li>)}</ul>
      <a href={`${base}?fr-candidates=${encodeURIComponent(c.id)}&fr-months=3#fr-trend`}>{detail.trend}</a>
    </>}
  </section>

  {!c.archived && <section class="frc-section container" aria-labelledby="frc-model">
    <h2 id="frc-model" class="frc-section-title">{detail.model}</h2>
    {typeof c.bestMean === 'number' ? <>
      <p class="frc-section-help">{detail.modelHelp}</p>
      <dl class="frc-stats"><div><dt>{C.best}</dt><dd>{fmtPct1(c.bestMean, locale)}</dd></div>
        {typeof c.bestPTop2 === 'number' && <div><dt>{C.top2}</dt><dd>{Math.round(c.bestPTop2 * 100)} %</dd></div>}
      </dl>
    </> : <p class="frc-empty">{detail.noModel}</p>}
  </section>}

  <!-- DUELS -->
  {!c.archived && <section class="frc-section container" aria-labelledby="frc-duels">
    <h2 id="frc-duels" class="frc-section-title">{C.duelsTitle}</h2>
    <p class="frc-section-help">{C.duelsHelp}</p>
    {c.duels.length ? (
      <ul class="frc-duels">
        {c.duels.map((d) => (
          <li class="frc-duel">
            <span class={`frc-duel-out ${d.wins ? 'win' : 'lose'}`}>
              {d.wins ? C.wins : C.loses}
            </span>
            <span class="frc-duel-vs">
              {C.vs} <a href={`${candBase}/${slugify(d.opponentName)}/`}>{d.opponentName}</a>
            </span>
            <span class="frc-duel-score">
              {fmtPct1(d.ownShare, locale)} — {fmtPct1(d.opponentShare, locale)}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="frc-empty">{C.noDuel}</p>
    )}
  </section>}

  <!-- RABBIT-HOLE : autres candidats + retour desk -->
  <section class="frc-section container" aria-labelledby="frc-related">
    <h2 id="frc-related" class="frc-section-title">{C.relatedTitle}</h2>
    <ul class="frc-related">
      {related.map((x) => (
        <li>
          <a class="frc-related-item" href={`${candBase}/${x.slug}/`}>
            <span class="frc-swatch" style={`background:${blocVar(x.bloc)}`} />
            <span class="frc-related-name">{x.name}</span>
            <span class="frc-related-bloc">{blocLabel(x.bloc, locale, x.partyFamily)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="frc-cta-row">
      <a class="frc-cta frc-cta-strong" href={`${base}#fr-explorer-title`}>{C.exploreCta}</a>
      <a class="frc-cta" href={candBase}>{C.allCandidates}</a>
    </div>
  </section>
</article>

<style>
  .frc {
    --bloc-far_left: #6b1f2e; --bloc-left: #b0202a; --bloc-left_radical: #c1272d;
    --bloc-left_populist: #d4602e; --bloc-left_social_dem: #e5567f; --bloc-greens: #4a9d5b;
    --bloc-centre: #b7860f; --bloc-centre_right: #bf6d1f; --bloc-right: #3f82d6;
    --bloc-sovereignist: #6d4c8a; --bloc-far_right: #2b4f8c; --bloc-other: var(--ink-3);
    padding-block: 48px 96px;
  }
  :global(:root[data-theme='dark']) .frc {
    --bloc-far_left: #a8474f; --bloc-left: #d24b52; --bloc-left_radical: #e0574f;
    --bloc-left_populist: #e08a5a; --bloc-left_social_dem: #d5628a; --bloc-greens: #4fa460;
    --bloc-centre: #b88d2c; --bloc-centre_right: #cc7f3e; --bloc-right: #5a95d8;
    --bloc-sovereignist: #9c7ac0; --bloc-far_right: #3a6bb0;
  }
  .frc-hero { max-width: 900px; padding-bottom: 28px; border-bottom: 1px solid var(--rule); }
  .frc-back {
    font-family: var(--mono); font-size: 13px; color: var(--ink-3); text-decoration: none;
  }
  .frc-back:hover { color: var(--ink); }
  .frc-id { display: flex; align-items: center; gap: 12px; margin: 18px 0 14px; }
  .frc-name {
    margin: 0; font-family: var(--serif); font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 700; letter-spacing: -0.01em; line-height: 1;
  }
  .frc-swatch { width: 16px; height: 16px; border-radius: 50%; flex: none; }
  .frc-badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .frc-badge {
    font-family: var(--mono); font-size: 13px; letter-spacing: 0;
    padding: 4px 10px; border: 1px solid var(--rule); border-radius: 2px; color: var(--ink-2);
  }
  .frc-status.is-declared { background: var(--blue-tint); border-color: var(--blue-soft); color: var(--blue); }
  .frc-section { max-width: 900px; margin-top: 44px; }
  .frc-prose { max-width: 720px; }
  .frc-prose p { margin: 0 0 0.9rem; color: var(--ink-2); font-size: 1.02rem; line-height: 1.7; }
  .frc-bio { font-family: var(--serif); font-size: 1.15rem; color: var(--ink) !important; }
  .frc-section-title {
    margin: 0 0 10px; font-family: var(--serif); font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 700; letter-spacing: -0.01em;
  }
  .frc-section-help {
    max-width: 620px; margin: 0 0 20px; font-family: var(--mono); font-size: 13px;
    line-height: 1.6; color: var(--ink-3);
  }
  .frc-archive { border-top: 1px solid var(--rule); padding-top: 12px; }
  .frc-polls { list-style: none; padding: 0; }
  .frc-polls li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule); flex-wrap: wrap; }
  .frc-range-track {
    position: relative; height: 26px; background: var(--paper-2);
    border: 1px solid var(--rule); border-radius: 2px; overflow: hidden;
  }
  .frc-range-band { position: absolute; inset-block: 0; border-radius: 2px; opacity: 0.85; }
  .frc-range-marker {
    position: absolute; inset-block: -3px; width: 2px; background: var(--ink);
  }
  .frc-range-marker::after {
    content: ''; position: absolute; top: -4px; left: -3px; width: 8px; height: 8px;
    border-radius: 50%; background: var(--ink);
  }
  .frc-range-scale {
    display: flex; justify-content: space-between; margin-top: 6px;
    font-family: var(--mono); font-size: 13px; color: var(--ink-3);
  }
  .frc-stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px; margin: 24px 0 0;
  }
  .frc-stats > div {
    border: 0; border-top: 1px solid var(--rule); border-radius: 0; background: transparent; padding: 12px 14px;
  }
  .frc-stats dt {
    font-family: var(--mono); font-size: 13px; letter-spacing: 0;
    color: var(--ink-3); margin-bottom: 6px;
  }
  .frc-stats dd {
    margin: 0; font-family: var(--serif); font-size: 26px; color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .frc-duels { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .frc-duel {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px;
    border: 0; border-top: 1px solid var(--rule); border-radius: 0; background: transparent; padding: 11px 14px;
  }
  .frc-duel-out {
    font-family: var(--mono); font-size: 13px; letter-spacing: 0;
    padding: 3px 8px; border-radius: 2px;
  }
  .frc-duel-out.win { background: color-mix(in oklab, #2e6f40 22%, transparent); color: #2e6f40; }
  .frc-duel-out.lose { background: color-mix(in oklab, #8b0000 18%, transparent); color: #b03030; }
  .frc-duel-vs { font-family: var(--mono); font-size: 13px; color: var(--ink-2); }
  .frc-duel-vs a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--rule); }
  .frc-duel-vs a:hover { text-decoration-color: var(--ink); }
  .frc-duel-score { font-family: var(--mono); font-size: 13px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .frc-related { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
  .frc-related-item {
    display: flex; align-items: center; gap: 10px; border: 0; border-top: 1px solid var(--rule);
    border-radius: 0; background: transparent; padding: 11px 14px; text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .frc-related-item:hover { border-color: var(--ink); }
  .frc-related-name { font-family: var(--serif); font-size: 15px; color: var(--ink); }
  .frc-related-bloc { font-family: var(--mono); font-size: 13px; color: var(--ink-3); margin-left: auto; }
  .frc-cta-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .frc-cta {
    display: inline-flex; align-items: center; padding: 9px 16px; border: 1px solid var(--rule);
    border-radius: 2px; font-family: var(--mono); font-size: 13px; color: var(--ink-2); text-decoration: none;
  }
  .frc-cta:hover { border-color: var(--ink); color: var(--ink); }
  .frc-cta-strong { background: var(--ink); color: var(--paper-3); border-color: var(--ink); }
  @media (max-width: 560px) {
    .frc-duel { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
