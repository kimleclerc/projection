  .cabye-band { position: absolute; top: 0; bottom: 0; opacity: 0.55; } /* design-ok : la fourchette, couleur du parti */
  .cabye-median { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--ink); }
  .cabye-range-txt { display: block; margin-top: 4px; font-size: 13px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .cabye-siblings { min-width: 0; }
