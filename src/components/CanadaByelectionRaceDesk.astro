---
/**
 * Page d'une partielle (fédérale, ou ontarienne via hubPath), gabarit « fiche de
 * scrutin » de docs/DESIGN.md § 7 :
 * 1. PageHeader : la circonscription, le scrutin et sa date, la réponse en une phrase.
 * 2. La projection en tableau (part projetée, fourchette, chances), avec l'image à
 *    télécharger. 3. Le sondage local s'il y en a un. 4. Ce que la projection corrige.
 * 5. Le résultat de 2025. 6. Lecture de la course. 7. Les autres partielles du même
 *    jour. 8. Marché, sources.
 * Les chiffres viennent du moteur (export_fed_byelections_web.py), jamais du markup.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import KeepDigging from './KeepDigging.astro';
import CanadaByelectionLive from '../islands/CanadaByelectionLive.tsx';
import RidingShareButton from '../islands/RidingShareButton.tsx';
import PolymarketEmbed from './PolymarketEmbed.astro';
import { marketForByelection } from '../lib/prediction-markets';
import { partyMeta, subjectFr } from '../lib/riding-adapters/parties';
import { longDate } from '../lib/format';
import shapesSource from '../../web_data/federal/shapes.json';
import {
  canadaByelectionRaces,
  byelectionRaceAlternates,
  byelectionSourceUrl,
  writSource,
  type ByelectionRaceConfig,
  type ByelectionRaceLocale,
} from '../data/canadaByelectionRaces';

interface Props {
  lang: ByelectionRaceLocale;
  config: ByelectionRaceConfig;
}

const { lang, config } = Astro.props;
const L = <T,>(fr: T, en: T, es: T): T => (lang === 'fr' ? fr : lang === 'es' ? es : en);
const canonical = `https://vote-scope.com${config.paths[lang]}`;
const alternates = byelectionRaceAlternates(config);
const federal = !config.hubPath;

const readData = (dataPath: string) => JSON.parse(
  readFileSync(resolve(process.cwd(), 'web_data', dataPath, 'latest.json'), 'utf-8'),
);
const data = readData(config.dataPath);
const candidates = (data.candidates ?? []) as any[];
const summary = data.summary ?? {};
const byel = data.byelection ?? {};
const lastResult = data.benchmarks?.last_result ?? {};
const localPoll = byel.local_poll ?? null;
const personalVote = byel.personal_vote_applied ?? null;
const turnoutResidual = byel.turnout_residual_applied ?? null;
const anchorWeight = personalVote?.local_poll_anchor_weight ?? null;
const market = marketForByelection(config.dataPath, config.ridingId);

const loc = L('fr-CA', 'en-CA', 'es-ES');
const fmtPct = (v: number, d = 1) => {
  const s = v.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d });
  return lang === 'en' ? `${s}%` : `${s} %`;
};
/** Aucune course n'est certaine : on ne publie jamais 100 %. */
const fmtProb = (p: number) => {
  const v = p * 100;
  const s = v >= 99.5 ? (lang === 'en' ? '>99' : '> 99') : v < 0.5 ? (lang === 'en' ? '<1' : '< 1') : String(Math.round(v));
  return lang === 'en' ? `${s}%` : `${s} %`;
};
/** « pallas » → « Pallas ». */
const titleCase = (s: string) =>
  String(s ?? '').replace(/(^|[\s\-—])(\p{Ll})/gu, (_, a, b) => a + b.toUpperCase());
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const shown = candidates
  .filter((c) => c.projected_vote_mean >= 1 || c.first_place_probability >= 0.01)
  .sort((a, b) => b.projected_vote_mean - a.projected_vote_mean);
const partyLabel = (c: any) => c.party_label?.[lang] ?? c.party;
const colorFor = (party: string) => candidates.find((c: any) => c.party_code === party)?.color ?? '#9a938a';
const labelFor = (party: string) =>
  candidates.find((c: any) => c.party_code === party)?.party_label?.[lang] ?? party.toUpperCase();

// Échelle des barres : la borne haute de la fourchette la plus large, arrondie.
const SCALE_MAX = Math.min(100, Math.max(50, Math.ceil(Math.max(...shown.map((c: any) => c.vote_quantiles?.q90 ?? c.projected_vote_mean)) / 10) * 10 + 5));
const pc = (v: number) => `${Math.min(100, (v / SCALE_MAX) * 100)}%`;

// ── Noms ────────────────────────────────────────────────────────────────
const ridingName = config.ridingName?.[lang] ?? data.district?.name ?? config.slug;
const PROVINCE: Record<string, [string, string, string]> = {
  QC: ['au Québec', 'Quebec', 'Quebec'],
  ON: ['en Ontario', 'Ontario', 'Ontario'],
  SK: ['en Saskatchewan', 'Saskatchewan', 'Saskatchewan'],
  BC: ['en Colombie-Britannique', 'British Columbia', 'Columbia Británica'],
  AB: ['en Alberta', 'Alberta', 'Alberta'],
  MB: ['au Manitoba', 'Manitoba', 'Manitoba'],
};
const prov = PROVINCE[config.province] ?? [config.province, config.province, config.province];
const provinceName = L(prov[0].replace(/^(au|en) /, ''), prov[1], prov[2]);

/** Sujet de phrase : « Le Parti libéral », « The Liberal Party » ; null sans forme connue. */
const subject = (code: string): string | null => {
  const jur = code.startsWith('on_') ? 'ontario' : 'federal-ca';
  const m = partyMeta(jur, code) as { mention_fr?: string; mention_en?: string; mention_es?: string };
  if (lang === 'fr') return m.mention_fr && /^(du|de la|de l’|de l'|des) /.test(m.mention_fr) ? cap(subjectFr(m.mention_fr)) : null;
  if (lang === 'es') return m.mention_es ? cap(m.mention_es) : null;
  return m.mention_en ? cap(m.mention_en) : null;
};
/** Libellé-adjectif en minuscules dans une phrase (« conservateur ») ; un nom propre
 *  (Bloc québécois) ou un sigle (NPD) reste tel quel, et l'anglais garde sa majuscule. */
const inline = (label: string) =>
  lang !== 'en' && /^(Libéral|Conservateur|Vert|Liberal|Conservador|Verde)$/.test(label) ? label.toLowerCase() : label;

// ── En-tête : le scrutin, sa date, la réponse ───────────────────────────
const kind = federal
  ? L('Élection partielle fédérale', 'Federal by-election', 'Elección parcial federal')
  : L('Élection partielle provinciale', 'Provincial by-election', 'Elección parcial provincial');
const departing = byel.departing_member;
const incumbent = byel.incumbent_party ? labelFor(byel.incumbent_party) : '';
const after = departing
  ? L(` après le départ de ${departing}${incumbent ? ` (${inline(incumbent)})` : ''}`,
      ` after the departure of ${departing}${incumbent ? ` (${incumbent})` : ''}`,
      ` tras la salida de ${departing}${incumbent ? ` (${inline(incumbent)})` : ''}`)
  : '';
const promise = config.electionDate
  ? L(`${kind} du ${longDate(config.electionDate, lang)} ${prov[0]},${after}.`,
      `${kind} in ${provinceName} on ${longDate(config.electionDate, lang)},${after}.`,
      `${kind} del ${longDate(config.electionDate, lang)} en ${provinceName},${after}.`)
  : config.status === 'vacant_pending_writ'
    ? L(`${kind} ${prov[0]}${after}. Le siège est vacant ; la date du scrutin n’est pas encore fixée.`,
        `${kind} in ${provinceName}${after}. The seat is vacant; no polling day has been set.`,
        `${kind} en ${provinceName}${after}. El escaño está vacante; aún no hay fecha de votación.`)
    : L(`${kind} attendue ${prov[0]}${after}. Le siège n’est pas encore vacant.`,
        `Expected ${kind.toLowerCase()} in ${provinceName}${after}. The seat is not vacant yet.`,
        `${kind} prevista en ${provinceName}${after}. El escaño aún no está vacante.`);

const fav = shown[0];
const favId = summary.favorite_id ?? fav?.party_code;
const favProb = summary.favorite_probability ?? fav?.first_place_probability ?? 0;
const favShare = candidates.find((c: any) => c.party_code === favId)?.projected_vote_mean;
const probWords = favProb >= 0.995
  ? L('plus de 99 % de chances de gagner', 'a better than 99% chance of winning', 'más del 99 % de probabilidades de ganar')
  : L(`${fmtProb(favProb)} de chances de gagner`, `a ${fmtProb(favProb)} chance of winning`, `un ${fmtProb(favProb)} de probabilidades de ganar`);
const favSubject = favId ? subject(favId) : null;
const favLabel = favId ? labelFor(favId) : '';
const answer = !favId ? '' : favSubject
  ? L(`${favSubject} est favori, avec ${probWords} et ${fmtPct(favShare ?? 0, 0)} des voix projetées.`,
      `${favSubject} is the favourite, with ${probWords} and ${fmtPct(favShare ?? 0, 0)} of the projected vote.`,
      `${favSubject} es favorito, con ${probWords} y el ${fmtPct(favShare ?? 0, 0)} del voto proyectado.`)
  : L(`Favori : ${favLabel}, avec ${probWords} et ${fmtPct(favShare ?? 0, 0)} des voix projetées.`,
      `Favourite: ${favLabel}, with ${probWords} and ${fmtPct(favShare ?? 0, 0)} of the projected vote.`,
      `Favorito: ${favLabel}, con ${probWords} y el ${fmtPct(favShare ?? 0, 0)} del voto proyectado.`);

// ── Image à télécharger : les mêmes chiffres que le tableau ────────────
const shape = federal ? (shapesSource as Record<string, { path: string; viewBox: string } | undefined>)[config.ridingId] : undefined;
const sharePayload = {
  title: ridingName,
  where: `${federal ? L('Partielle fédérale', 'Federal by-election', 'Parcial federal') : L('Partielle provinciale', 'Provincial by-election', 'Parcial provincial')} · ${provinceName}`,
  answer: favId ? L(`Favori : ${favLabel}, ${probWords}`, `Favourite: ${favLabel}, ${probWords}`, `Favorito: ${favLabel}, ${probWords}`) : ridingName,
  parties: shown.slice(0, 6).map((c: any) => ({ label: partyLabel(c), color: c.color, v: Math.round(c.projected_vote_mean * 10) / 10 })),
  date: data.meta?.run_date ?? '',
  voteDay: config.electionDate ?? '',
  slug: `partielle-${config.slug}`,
  jurisdiction: federal ? 'canada-byelection' : 'ontario-byelection',
  shape: shape && shape.path.length < 20000 && favId ? { d: shape.path, vb: shape.viewBox, color: colorFor(favId) } : undefined,
};

// ── Les autres partielles du même jour ──────────────────────────────────
const siblings = federal && config.electionDate
  ? Object.values(canadaByelectionRaces)
    .filter((r) => r.slug !== config.slug && r.electionDate === config.electionDate)
    .map((r) => {
      const d = readData(r.dataPath);
      const id = d.summary?.favorite_id;
      return {
        name: (r as ByelectionRaceConfig).ridingName?.[lang] ?? d.district?.name ?? r.slug,
        href: r.paths[lang],
        province: (PROVINCE[r.province] ?? [r.province, r.province, r.province])[lang === 'fr' ? 0 : lang === 'en' ? 1 : 2].replace(/^(au|en) /, ''),
        party: id ? (d.candidates ?? []).find((c: any) => c.party_code === id) : null,
        p: d.summary?.favorite_probability ?? 0,
      };
    })
  : [];

const t = {
  forecast: L('La projection', 'The forecast', 'La proyección'),
  thParty: L('Parti', 'Party', 'Partido'),
  thShare: L('Part projetée', 'Projected share', 'Cuota proyectada'),
  thRange: L('Fourchette (80 %)', 'Range (80%)', 'Horquilla (80 %)'),
  thWin: L('Chances de gagner', 'Chance of winning', 'Probabilidad de ganar'),
  forecastMeta: (d: string, n: string) => L(
    `Projection du ${d}, ${n} simulations. La fourchette contient 8 résultats simulés sur 10 ; le trait marque la médiane.`,
    `Forecast of ${d}, ${n} simulations. The range holds 8 of 10 simulated results; the tick marks the median.`,
    `Proyección del ${d}, ${n} simulaciones. La horquilla contiene 8 de cada 10 resultados simulados; la marca señala la mediana.`),
  pollLabel: L('Le sondage local', 'The local poll', 'La encuesta local'),
  undecided: L('Indécis', 'Undecided', 'Indecisos'),
  respondents: L('répondants', 'respondents', 'encuestados'),
  pollCaveat: L(
    'Une seule firme, une seule vague. La taille d’échantillon, la marge d’erreur et le mode de collecte n’ont pas été publiés : nous lui donnons une incertitude large.',
    'One firm, one wave. Sample size, margin of error and method were not published, so we treat it with wide uncertainty.',
    'Una sola firma, una sola ola. El tamaño de muestra, el margen de error y el método no se publicaron, así que la tratamos con amplia incertidumbre.'),
  undecidedNote: (u: string) => L(
    `Les chiffres publiés comptent ${u} d’indécis. Faute de ventilation, nous les répartissons au prorata des intentions exprimées.`,
    `The published figures include ${u} undecided. With no breakdown released, we split them in proportion to stated intentions.`,
    `Las cifras publicadas incluyen un ${u} de indecisos. Sin desglose, los repartimos en proporción a las intenciones expresadas.`),
  anchorNote: (w: string) => L(
    `Le sondage pèse environ ${w} dans le point de départ de la circonscription, avant les simulations. Ce poids augmente à chaque nouveau sondage, selon sa taille et sa date.`,
    `The poll carries about ${w} of the riding’s starting point, before the simulations run. That weight rises with each new poll, according to its size and date.`,
    `La encuesta pesa alrededor del ${w} en el punto de partida de la circunscripción, antes de las simulaciones. Ese peso sube con cada nueva encuesta, según su tamaño y su fecha.`),
  pollPredates: L(
    'Le terrain a eu lieu avant l’annonce du candidat libéral.',
    'Fieldwork took place before the Liberal candidate was announced.',
    'El trabajo de campo se hizo antes del anuncio del candidato liberal.'),
  howLabel: L('Ce que la projection corrige', 'What the forecast adjusts', 'Qué corrige la proyección'),
  personalLabel: L('Vote personnel retiré', 'Personal vote removed', 'Voto personal retirado'),
  personalBody: (p: string, pts: number, member: string) => L(
    `${pts} points retirés au parti sortant (${inline(p)}) : la part du vote qui allait à ${member} plutôt qu’au parti.`,
    `${pts} points removed from the ${p} vote: the share that went to ${member} rather than to the party.`,
    `${pts} puntos retirados al partido saliente (${inline(p)}): la parte del voto que iba a ${member} y no al partido.`),
  floorLabel: L('plancher', 'floor', 'suelo'),
  turnoutLabel: L('Participation aux partielles', 'By-election turnout', 'Participación en parciales'),
  turnoutBody: L(
    'Aux partielles du 13 avril 2026, à évolution nationale égale, le vote conservateur a reculé d’environ 3 points de plus et le vote libéral a progressé d’autant : les électeurs de l’opposition se déplacent moins que ceux du gouvernement.',
    'At the April 13, 2026 by-elections, for the same national shift, the Conservative vote fell about 3 points further and the Liberal vote rose by as much: opposition voters turn out less than government voters.',
    'En las parciales del 13 de abril de 2026, con la misma evolución nacional, el voto conservador cayó unos 3 puntos más y el liberal subió otro tanto: los votantes de la oposición acuden menos que los del gobierno.'),
  baseline2025: L('Le résultat de 2025', 'The 2025 result', 'El resultado de 2025'),
  turnout: (v: string) => L(`Participation : ${v}.`, `Turnout: ${v}.`, `Participación: ${v}.`),
  why: L('La course', 'The race', 'La carrera'),
  noDate: L(
    'La Loi électorale du Canada prévoit que le scrutin est déclenché entre 11 et 180 jours après que le président de la Chambre a avisé le directeur général des élections de la vacance.',
    'Under the Canada Elections Act, the by-election must be called between 11 and 180 days after the Speaker notifies the Chief Electoral Officer of the vacancy.',
    'Según la Ley Electoral de Canadá, la parcial debe convocarse entre 11 y 180 días después de que el presidente de la Cámara notifique la vacante al director general de elecciones.'),
  siblings: (d: string) => L(`Les autres partielles du ${d}`, `The other by-elections on ${d}`, `Las otras parciales del ${d}`),
  thRiding: L('Circonscription', 'Riding', 'Circunscripción'),
  thFav: L('Favori', 'Favourite', 'Favorito'),
  sources: L('Sources', 'Sources', 'Fuentes'),
  marketLabel: L('Marché de prédiction', 'Prediction market', 'Mercado de predicción'),
  marketNote: L('Les cotes des parieurs, pas notre projection. Les deux peuvent diverger.', 'Traders’ prices, not our forecast. The two can disagree.', 'Las cuotas de los apostadores, no nuestra proyección. Ambas pueden diferir.'),
  more: L('Voir aussi', 'See also', 'Ver también'),
  allByelections: L('Toutes les partielles', 'All by-elections', 'Todas las parciales'),
  federalProj: L('Projection fédérale', 'Canada federal projection', 'Proyección federal de Canadá'),
};

// Rattachement : fédéral par défaut, surchargeable par juridiction.
const hubPath = config.hubPath?.[lang] ?? `/${lang}/canada/byelections/`;
const hubLabel = config.hubLabel?.[lang] ?? t.allByelections;
const projectionPath = config.projectionPath?.[lang] ?? `/${lang}/canada/federal/`;
const projectionLabel = config.projectionLabel?.[lang] ?? t.federalProj;
const sectionLabel = config.sectionLabel?.[lang] ?? 'Canada';
const sectionPath = config.sectionPath?.[lang] ?? `/${lang}/canada/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    name: config.title[lang].replace(' — Vote-Scope', ''),
    description: config.description[lang],
    headline: config.title[lang].replace(' — Vote-Scope', ''),
    dateModified: data.meta?.run_date,
    author: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    url: canonical,
  },
  ...(config.electionDate ? [{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: L(`Élection partielle de ${ridingName}`, `${ridingName} by-election`, `Elección parcial de ${ridingName}`),
    startDate: config.electionDate,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: ridingName, address: { '@type': 'PostalAddress', addressRegion: config.province, addressCountry: 'CA' } },
    url: canonical,
  }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: `https://vote-scope.com/${lang}/` },
      { '@type': 'ListItem', position: 2, name: sectionLabel, item: `https://vote-scope.com${sectionPath}` },
      { '@type': 'ListItem', position: 3, name: hubLabel, item: `https://vote-scope.com${hubPath}` },
      { '@type': 'ListItem', position: 4, name: ridingName, item: canonical },
    ],
  },
];

const lastShares = Object.entries(lastResult.shares ?? {})
  .map(([p, v]) => ({ party: p, pct: Number(v) }))
  .filter((x) => x.pct >= 1)
  .sort((a, b) => b.pct - a.pct);
const nSims = Number(data.meta?.n_simulations ?? 0).toLocaleString(loc);
---

<Base
  title={config.title[lang]}
  description={config.description[lang]}
  canonical={canonical}
  currentPage={config.currentPage}
  lang={lang}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="cabye" data-content-area>
    <PageHeader title={ridingName} promise={promise} question={answer} preferredSourceLocale={lang} />

    {config.liveEventId && (
      <div class="container">
        <CanadaByelectionLive
          eventId={config.liveEventId}
          ridingId={config.liveRidingId ?? config.ridingId}
          lang={lang}
          sourceName={config.liveSourceName?.[lang]}
          client:load
        />
      </div>
    )}

    <section class="container cabye-block" id="forecast" aria-labelledby="cabye-forecast">
      <h2 id="cabye-forecast">{t.forecast}</h2>
      <div class="table-scroll">
        <table class="cabye-table">
          <thead>
            <tr><th>{t.thParty}</th><th class="num">{t.thShare}</th><th class="cabye-range-col">{t.thRange}</th><th class="num">{t.thWin}</th></tr>
          </thead>
          <tbody>
            {shown.map((c: any) => {
              const q10 = c.vote_quantiles?.q10 ?? c.projected_vote_mean;
              const q50 = c.vote_quantiles?.q50 ?? c.projected_vote_mean;
              const q90 = c.vote_quantiles?.q90 ?? c.projected_vote_mean;
              return (
                <tr>
                  <th scope="row">
                    <span class="cabye-nowrap"><span class="dot" style={`background:${c.color}`} aria-hidden="true"></span>{c.candidate_declared ? c.name : partyLabel(c)}</span>
                    {c.candidate_declared && <span class="cabye-sub">{partyLabel(c)}</span>}
                  </th>
                  <td class="num cabye-big">{fmtPct(c.projected_vote_mean)}</td>
                  <td class="cabye-range-col">
                    <div class="cabye-track" role="img" aria-label={`${fmtPct(q10, 0)} – ${fmtPct(q90, 0)}`}>
                      <div class="cabye-band" style={`left:${pc(q10)};width:calc(${pc(q90)} - ${pc(q10)});background:${c.color}`}></div>
                      <div class="cabye-median" style={`left:${pc(q50)}`}></div>
                    </div>
                    <span class="cabye-range-txt">{fmtPct(q10, 0)} – {fmtPct(q90, 0)}</span>
                  </td>
                  <td class="num">{fmtProb(c.first_place_probability)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="vs-meta">{t.forecastMeta(longDate(data.meta?.run_date, lang), nSims)}</p>
      <RidingShareButton client:idle lang={lang} payload={sharePayload} />
      <p class="cabye-text">{config.modelNote[lang]}</p>
    </section>

    {localPoll && (
      <section class="container cabye-block" aria-labelledby="cabye-poll">
        <h2 id="cabye-poll">{t.pollLabel}</h2>
        <div class="cabye-bars">
          {Object.entries(localPoll.shares ?? {})
            .map(([p, v]) => ({ p, v: Number(v) }))
            .sort((a, b) => b.v - a.v)
            .map(({ p, v }) => (
              <div class="cabye-bar-row">
                <span>{labelFor(p)}</span>
                <div class="cabye-bar-track"><div style={`width:${v}%;background:${colorFor(p)};`} /></div>
                <strong>{fmtPct(v, 0)}</strong>
              </div>
            ))}
          {localPoll.undecided != null && (
            <div class="cabye-bar-row">
              <span>{t.undecided}</span>
              <div class="cabye-bar-track"><div style={`width:${localPoll.undecided}%;background:var(--ink-3);`} /></div>
              <strong>{fmtPct(localPoll.undecided, 0)}</strong>
            </div>
          )}
        </div>
        <p class="vs-meta">
          {titleCase(localPoll.firm)} · {longDate(localPoll.field_end ?? localPoll.release_date, lang)}
          {localPoll.sample_size ? ` · ${Number(localPoll.sample_size).toLocaleString(loc)} ${t.respondents}` : ''}
        </p>
        {localPoll.undecided != null && <p class="cabye-text">{t.undecidedNote(fmtPct(localPoll.undecided, 0))}</p>}
        {anchorWeight != null && <p class="cabye-text">{t.anchorNote(fmtProb(anchorWeight))}</p>}
        <p class="cabye-text">{t.pollCaveat}</p>
        {byel.star_candidate?.announced_after_poll && <p class="cabye-text">{t.pollPredates}</p>}
      </section>
    )}

    {(personalVote || turnoutResidual) && (
      <section class="container cabye-block" aria-labelledby="cabye-how">
        <h2 id="cabye-how">{t.howLabel}</h2>
        <dl class="cabye-adjust">
          {personalVote && (
            <div>
              <dt>{t.personalLabel}</dt>
              <dd>
                {t.personalBody(labelFor(personalVote.party), personalVote.points, personalVote.member ?? departing ?? '')}
                <span class="cabye-num">
                  {fmtPct(personalVote.before)} → {fmtPct(personalVote.after)}
                  {personalVote.floor ? ` · ${t.floorLabel} ${fmtPct(personalVote.floor, 0)}` : ''}
                </span>
              </dd>
            </div>
          )}
          {turnoutResidual && (
            <div>
              <dt>{t.turnoutLabel}</dt>
              <dd>
                {t.turnoutBody}
                <span class="cabye-num">
                  {Object.entries(turnoutResidual)
                    .map(([p, v]) => `${labelFor(p)} ${Number(v) > 0 ? '+' : Number(v) < 0 ? '−' : ''}${Math.abs(Number(v)).toLocaleString(loc, { minimumFractionDigits: 1, maximumFractionDigits: 1 })}`)
                    .join(' · ')}
                </span>
              </dd>
            </div>
          )}
        </dl>
      </section>
    )}

    {lastShares.length > 0 && (
      <section class="container cabye-block" aria-labelledby="cabye-2025">
        <h2 id="cabye-2025">{t.baseline2025}</h2>
        <div class="cabye-bars">
          {lastShares.map((s) => (
            <div class="cabye-bar-row">
              <span>{labelFor(s.party)}</span>
              <div class="cabye-bar-track"><div style={`width:${s.pct}%;background:${colorFor(s.party)};`} /></div>
              <strong>{fmtPct(s.pct)}</strong>
            </div>
          ))}
        </div>
        <p class="vs-meta">
          {longDate(lastResult.election_date, lang)}
          {lastResult.turnout_pct ? ` · ${t.turnout(fmtPct(lastResult.turnout_pct))}` : ''}
        </p>
      </section>
    )}

    <section class="container cabye-block" aria-labelledby="cabye-why">
      <h2 id="cabye-why">{t.why}</h2>
      <p class="cabye-lede">{config.dek[lang]}</p>
      <ul class="cabye-list">
        {config.why[lang].map((b) => <li>{b}</li>)}
      </ul>
      {!config.electionDate && <p class="cabye-text">{t.noDate}</p>}
    </section>

    {siblings.length > 0 && config.electionDate && (
      <section class="container cabye-block" aria-labelledby="cabye-siblings">
        <h2 id="cabye-siblings">{t.siblings(longDate(config.electionDate, lang))}</h2>
        <div class="table-scroll">
          <table class="cabye-table cabye-siblings">
            <thead><tr><th>{t.thRiding}</th><th>{t.thFav}</th><th class="num">{t.thWin}</th></tr></thead>
            <tbody>
              {siblings.map((s) => (
                <tr>
                  <th scope="row"><a class="vs-link" href={s.href}>{s.name}</a><span class="cabye-sub">{s.province}</span></th>
                  <td>{s.party && <><span class="dot" style={`background:${s.party.color}`} aria-hidden="true"></span>{s.party.party_label?.[lang] ?? s.party.party}</>}</td>
                  <td class="num">{fmtProb(s.p)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {market && (
      <section class="container cabye-block">
        <PolymarketEmbed
          slug={market.slug}
          kind={market.kind}
          eventUrl={market.eventUrl}
          lang={lang}
          title={t.marketLabel}
          subtitle={t.marketNote}
          height={420}
        />
      </section>
    )}

    <section class="container cabye-block" aria-labelledby="cabye-sources">
      <h2 id="cabye-sources">{t.sources}</h2>
      <ul class="cabye-sources">
        {federal && config.electionDate === writSource.date && (
          <li><a href={writSource.url} rel="noopener">{writSource.label[lang]}</a></li>
        )}
        <li><a href={byelectionSourceUrl} rel="noopener">By-elections to the 45th Canadian Parliament (Wikipedia)</a></li>
        {(data.sources ?? []).filter((s: any) => s?.url && s.url !== byelectionSourceUrl).map((s: any) => (
          <li><a href={s.url} rel="noopener">{s.label}</a></li>
        ))}
        {localPoll?.source_url && (
          <li><a href={localPoll.source_url} rel="noopener">{titleCase(localPoll.firm)}, {ridingName} ({longDate(localPoll.field_end ?? localPoll.release_date, lang)})</a></li>
        )}
        <li><a href="https://www.elections.ca/" rel="noopener">{L('Élections Canada', 'Elections Canada', 'Elecciones Canadá')}</a></li>
      </ul>
    </section>

    <KeepDigging
      eyebrow={t.more}
      title={t.more}
      body=""
      links={[
        { href: hubPath, label: hubLabel },
        { href: projectionPath, label: projectionLabel },
      ]}
    />
  </article>
</Base>

