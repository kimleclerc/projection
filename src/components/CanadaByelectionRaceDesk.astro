  .cabye-num { display: block; margin-top: 6px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

  .cabye-list { margin: 14px 0 0; padding-left: 18px; display: grid; gap: 10px; max-width: 72ch; }
