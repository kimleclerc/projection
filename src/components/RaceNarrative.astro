---
import OnThisPage from './OnThisPage.astro';

interface EventItem { date: string; title: string; body: string; status?: string }
interface LinkItem { href: string; label: string; detail?: string }
interface Props {
  locale: 'en' | 'fr' | 'es';
  question: string;
  verdict: string;
  history: string[];
  sinceRun: EventItem[];
  turningPoints: string[];
  relatedIndexes?: LinkItem[];
}
const { locale, question, verdict, history, sinceRun, turningPoints, relatedIndexes = [] } = Astro.props;
const t = locale === 'fr'
  ? { history: 'Comment nous en sommes arrivés là', since: 'Depuis le dernier run', turns: 'Ce qui peut encore faire basculer la course', indexes: 'Indices liés', status: 'État du modèle' }
  : locale === 'es'
    ? { history: 'Cómo llegamos hasta aquí', since: 'Desde la última actualización', turns: 'Qué todavía puede cambiar la carrera', indexes: 'Índices relacionados', status: 'Estado del modelo' }
    : { history: 'How we got here', since: 'Since the last run', turns: 'What can still change the race', indexes: 'Related indexes', status: 'Model status' };
const navItems = [
  { href: '#race-history', label: t.history },
  { href: '#since-last-run', label: t.since },
  { href: '#turning-points', label: t.turns },
  ...(relatedIndexes.length ? [{ href: '#related-indexes', label: t.indexes }] : []),
];
---

<section class="race-intro container" aria-labelledby="race-question-title">
  <p class="eyebrow">{locale === 'fr' ? 'La question de la course' : locale === 'es' ? 'La pregunta de la carrera' : 'The race question'}</p>
  <h2 id="race-question-title">{question}</h2>
  <p class="race-verdict">{verdict}</p>
</section>

<OnThisPage locale={locale} items={navItems} />

<section id="race-history" class="race-band container" aria-labelledby="race-history-title">
  <p class="eyebrow">{t.history}</p>
  <h2 id="race-history-title">{t.history}</h2>
  <div class="prose">{history.map((paragraph) => <p>{paragraph}</p>)}</div>
</section>

<section id="since-last-run" class="race-band container" aria-labelledby="since-run-title">
  <p class="eyebrow">{t.since}</p>
  <h2 id="since-run-title">{t.since}</h2>
  <div class="event-grid">
    {sinceRun.map((event) => (
      <article class="event-card">
        <p class="event-date">{event.date}</p>
        <h3>{event.title}</h3>
        <p>{event.body}</p>
        {event.status && <p class="event-status"><strong>{t.status}:</strong> {event.status}</p>}
      </article>
    ))}
  </div>
</section>

<section id="turning-points" class="race-band container" aria-labelledby="turning-points-title">
  <p class="eyebrow">{t.turns}</p>
  <h2 id="turning-points-title">{t.turns}</h2>
  <ol class="turning-list">{turningPoints.map((item) => <li>{item}</li>)}</ol>
</section>

{relatedIndexes.length > 0 && (
  <section id="related-indexes" class="race-band container" aria-labelledby="related-indexes-title">
    <p class="eyebrow">{t.indexes}</p>
    <h2 id="related-indexes-title">{t.indexes}</h2>
    <div class="index-links">{relatedIndexes.map((item) => <a href={item.href}><strong>{item.label}</strong>{item.detail && <span>{item.detail}</span>}</a>)}</div>
  </section>
)}

<style>
  .race-intro, .race-band { padding-block: 56px; border-bottom: 1px solid var(--rule); }
  h2 { max-width: 900px; margin-top: 10px; font-family: var(--serif); font-size: clamp(34px, 5vw, 64px); font-weight: 420; line-height: 1.02; letter-spacing: -.02em; }
  .race-verdict { max-width: 820px; margin-top: 20px; color: var(--ink-2); font-family: var(--serif); font-size: clamp(21px, 2.4vw, 30px); line-height: 1.25; }
  .prose { max-width: 820px; }
  .prose p { margin-top: 16px; color: var(--ink-2); font-size: 17px; line-height: 1.7; }
  .event-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; margin-top: 24px; }
  .event-card { border: 1px solid var(--rule); border-radius: 5px; padding: 22px; background: var(--card); }
  .event-card h3 { margin-top: 8px; font-family: var(--serif); font-size: 25px; font-weight: 430; line-height: 1.08; }
  .event-card > p:not(.event-date) { margin-top: 12px; color: var(--ink-2); line-height: 1.55; }
  .event-date, .event-status { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; }
  .turning-list { max-width: 900px; margin: 24px 0 0 22px; }
  .turning-list li { padding: 12px 0 12px 10px; border-bottom: 1px solid var(--rule-2); color: var(--ink-2); font-size: 17px; line-height: 1.5; }
  .index-links { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-top: 24px; }
  .index-links a { display: flex; flex-direction: column; gap: 5px; border: 1px solid var(--rule); padding: 18px; background: var(--card); }
  .index-links span { color: var(--ink-3); }
  @media (max-width: 800px) { .event-grid, .index-links { grid-template-columns: 1fr; } }
</style>
