---
/**
 * Page d'essai (non indexée, non liée) : trois signatures visuelles possibles pour
 * Vote-Scope, montées en vrai (bandeau, logo, menu, une). À supprimer une fois le choix fait.
 */
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import senate from '../../web_data/us-senate/latest.json';
import '../styles/tokens.css';
import KimNote from '../components/KimNote.astro';

const parties = (senate as any).parties;
const dem = parties.find((p: any) => p.party === 'us_dem');
const rep = parties.find((p: any) => p.party === 'us_rep');
const pct = Math.round(dem.p_majority * 100);
const today = new Date(new Date().toISOString().slice(0, 10) + 'T12:00:00Z');
const daysLeft = Math.round((Date.parse('2026-11-03T12:00:00Z') - today.getTime()) / 86_400_000);
const rawDate = today.toLocaleDateString('fr-CA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateline = rawDate.charAt(0).toUpperCase() + rawDate.slice(1);
const nav = ['États-Unis', 'Canada', 'Royaume-Uni', 'France', 'Espagne', 'Indices', 'Sports'];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Essai de signature — Vote-Scope</title>
</head>
<body>
  <header class="intro">
    <h1>Trois signatures pour Vote-Scope</h1>
    <p>Même contenu, mêmes chiffres. Ce qui change : le bandeau, le logo, la couleur signature et la façon d'afficher la course du jour.</p>
    <nav><a href="#a">A · L’antenne</a><a href="#b">B · Le bulletin</a><a href="#c">C · Le viseur</a></nav>
  </header>

  <!-- A · L'ANTENNE -->
  <section id="a" class="variant va">
    <p class="vlabel"><strong>A · L’antenne</strong> — bandeau noir, jaune « dernière heure », la croix du bulletin.</p>
    <div class="frame">
      <div class="a-bar">
        <a class="a-logo" href="#a">
          <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="1" y="1" width="38" height="38" fill="#FFD400"/><path d="M10 10 L30 30 M30 10 L10 30" stroke="#111" stroke-width="6" stroke-linecap="square"/></svg>
          <span>VOTE-SCOPE</span>
        </a>
        <nav class="a-nav">{nav.map((n) => <a href="#a">{n}</a>)}</nav>
      </div>
      <div class="a-ticker"><span class="a-tag">MIDTERMS · J-{daysLeft}</span><span>Sénat : démocrates {pct}&#8239;% · Chambre : démocrates 98&#8239;% · C.-B. : conservateurs 55 sièges sur 93</span></div>
      <div class="a-main">
        <p class="a-kicker">Sénat américain · 3 novembre</p>
        <h2 class="a-q">Qui contrôlera le Sénat?</h2>
        <div class="a-score">
          <div style={`--c:${dem.color}`}><b>{Math.round(dem.seats_projected)}</b><span>Démocrates</span></div>
          <div style={`--c:${rep.color}`}><b>{Math.round(rep.seats_projected)}</b><span>Républicains</span></div>
          <div class="a-pct"><b>{pct}&#8239;%</b><span>chances de majorité démocrate</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- B · LE BULLETIN -->
  <section id="b" class="variant vb">
    <p class="vlabel"><strong>B · Le bulletin</strong> — page de journal, gros filet noir, le cercle du bulletin canadien.</p>
    <div class="frame">
      <div class="b-top">
        <span class="b-date">{dateline}</span>
        <a class="b-logo" href="#b">
          <svg viewBox="0 0 44 44" aria-hidden="true"><path d="M22 2 A20 20 0 0 0 22 42 Z" fill={dem.color}/><path d="M22 2 A20 20 0 0 1 22 42 Z" fill={rep.color}/><path d="M13 13 L31 31 M31 13 L13 31" stroke="#fff" stroke-width="4.5" stroke-linecap="round"/></svg>
          <span>Vote-Scope</span>
        </a>
        <span class="b-count">Midterms dans <b>{daysLeft}</b> jours</span>
      </div>
      <nav class="b-nav">{nav.map((n) => <a href="#b">{n}</a>)}</nav>
      <div class="b-main">
        <p class="b-kicker">Sénat américain</p>
        <h2 class="b-q">Les démocrates ont {pct}&#8239;% de chances d’obtenir la majorité au Sénat</h2>
        <div class="b-bar"><span style={`width:${dem.seats_projected}%;background:${dem.color}`}>{Math.round(dem.seats_projected)}</span><span style={`width:${rep.seats_projected}%;background:${rep.color}`}>{Math.round(rep.seats_projected)}</span><i></i></div>
        <p class="b-note">51 sièges pour la majorité · par Kim Leclerc</p>
      </div>
    </div>
  </section>

  <section class="variant">
    <p class="vlabel"><strong>Le mot de Kim</strong> — brouillons à réécrire ou approuver (non publiés).</p>
    <div class="frame" style="padding-bottom:22px">
      <KimNote note="us-senate" lang="fr" draft />
      <KimNote note="british-columbia" lang="fr" draft />
    </div>
  </section>

  <!-- C · LE VISEUR -->
  <section id="c" class="variant vc">
    <p class="vlabel"><strong>C · Le viseur</strong> — bleu nuit, réticule, chiffres clés soulignés au jaune.</p>
    <div class="frame">
      <div class="c-bar">
        <a class="c-logo" href="#c">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="15" fill="none" stroke="#FFD400" stroke-width="3.5"/><circle cx="20" cy="20" r="4" fill="#FFD400"/><path d="M20 0 V11 M20 29 V40 M0 20 H11 M29 20 H40" stroke="#FFD400" stroke-width="3.5"/></svg>
          <span>Vote<b>Scope</b></span>
        </a>
        <nav class="c-nav">{nav.map((n) => <a href="#c">{n}</a>)}</nav>
      </div>
      <div class="c-main">
        <p class="c-kicker">Sénat américain · élection le 3 novembre</p>
        <h2 class="c-q">Les démocrates ont <mark>{pct}&#8239;%</mark> de chances d’obtenir la majorité au Sénat.</h2>
        <p class="c-sub">Sièges projetés : démocrates <mark>{Math.round(dem.seats_projected)}</mark>, républicains <mark>{Math.round(rep.seats_projected)}</mark>. Majorité à 51.</p>
      </div>
    </div>
  </section>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f1f1f1; color: #111; font-family: Barlow, system-ui, sans-serif; }
  .intro { max-width: 1180px; margin: 0 auto; padding: 36px 20px 8px; }
  .intro h1 { margin: 0 0 8px; font-size: 34px; }
  .intro p { margin: 0; color: #444; font-size: 17px; }
  .intro nav { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; }
  .intro nav a { color: #111; font-weight: 600; }
  .variant { max-width: 1180px; margin: 30px auto; padding: 0 20px; }
  .vlabel { margin: 0 0 10px; font-size: 15px; color: #444; }
  .frame { background: #fff; border: 1px solid #ddd; overflow: hidden; }

  /* A */
  .a-bar { display: flex; align-items: center; gap: 28px; padding: 12px 24px; background: #111; flex-wrap: wrap; }
  .a-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .a-logo svg { width: 36px; height: 36px; }
  .a-logo span { color: #fff; font-family: "Barlow Condensed"; font-weight: 700; font-size: 30px; letter-spacing: .02em; }
  .a-nav { display: flex; gap: 18px; flex-wrap: wrap; }
  .a-nav a { color: #fff; text-decoration: none; font-weight: 600; font-size: 15px; }
  .a-ticker { display: flex; align-items: stretch; background: #FFD400; font-weight: 600; font-size: 15px; }
  .a-ticker span { padding: 8px 14px; }
  .a-tag { background: #111; color: #FFD400; font-family: "Barlow Condensed"; font-weight: 700; font-size: 16px; }
  .a-main { padding: 26px 24px 30px; }
  .a-kicker { margin: 0; font-weight: 600; color: #555; }
  .a-q { margin: 4px 0 16px; font-size: 46px; font-weight: 700; line-height: 1.05; }
  .a-score { display: flex; gap: 0; flex-wrap: wrap; }
  .a-score div { display: flex; flex-direction: column; padding: 8px 22px 8px 14px; border-left: 10px solid var(--c, #111); margin-right: 18px; background: #f4f4f4; }
  .a-score b { font-family: "Barlow Condensed"; font-size: 64px; line-height: 1; color: var(--c, #111); }
  .a-score .a-pct { border-left-color: #FFD400; }
  .a-score span { font-weight: 600; font-size: 14px; color: #333; }

  /* B */
  .b-top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 18px 24px 12px; }
  .b-date { font-size: 14px; color: #555;  }
  .b-count { justify-self: end; font-size: 15px; font-weight: 600; }
  .b-count b { font-family: "Barlow Condensed"; font-size: 22px; }
  .b-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: #111; }
  .b-logo svg { width: 44px; height: 44px; }
  .b-logo span { font-weight: 700; font-size: 44px; letter-spacing: -0.01em; }
  .b-nav { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; padding: 10px 24px; border-top: 6px solid #111; border-bottom: 1px solid #111; }
  .b-nav a { color: #111; text-decoration: none; font-weight: 600; }
  .b-main { padding: 26px 24px 30px; max-width: 900px; margin: 0 auto; text-align: left; }
  .b-kicker { margin: 0; font-weight: 600; color: #555; }
  .b-q { margin: 4px 0 18px; font-size: 44px; font-weight: 700; line-height: 1.06; }
  .b-bar { position: relative; display: flex; height: 44px; }
  .b-bar span { display: flex; align-items: center; padding: 0 12px; color: #fff; font-family: "Barlow Condensed"; font-weight: 700; font-size: 28px; }
  .b-bar span + span { justify-content: flex-end; }
  .b-bar i { position: absolute; left: 51%; top: -6px; bottom: -6px; width: 3px; background: #111; }
  .b-note { margin: 10px 0 0; font-size: 14px; color: #555; font-weight: 600; }

  /* C */
  .c-bar { display: flex; align-items: center; gap: 28px; padding: 14px 24px; background: #0B1F3A; flex-wrap: wrap; }
  .c-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
  .c-logo svg { width: 36px; height: 36px; }
  .c-logo span { font-weight: 500; font-size: 28px; }
  .c-logo b { font-weight: 700; color: #FFD400; }
  .c-nav { display: flex; gap: 18px; flex-wrap: wrap; }
  .c-nav a { color: #dfe6f0; text-decoration: none; font-weight: 600; font-size: 15px; }
  .c-main { padding: 28px 24px 32px; }
  .c-kicker { margin: 0; font-weight: 600; color: #555; }
  .c-q { margin: 4px 0 12px; font-size: 46px; font-weight: 700; line-height: 1.06; max-width: 900px; }
  .c-sub { margin: 0; font-size: 19px; color: #333; }
  mark { background: linear-gradient(transparent 55%, #FFD400 55%); color: inherit; padding: 0 2px; }

  @media (max-width: 700px) {
    .a-q, .b-q, .c-q { font-size: 32px; }
    .b-top { grid-template-columns: 1fr; gap: 8px; justify-items: start; }
    .b-count { justify-self: start; }
    .a-score b { font-size: 48px; }
  }
</style>
