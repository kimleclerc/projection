---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import AmazonShelf from '../../components/AmazonShelf.astro';
import { amazon } from '../../data/affiliates';

const live = amazon.tag.trim() !== '';
---

<EditorialLayout
  title="La bibliothèque du desk — Vote-Scope"
  description="Les livres derrière les modèles : prévision, statistiques, biais cognitifs et analytique du football — la liste de lecture qui a façonné la manière dont Vote-Scope projette élections et tournois."
  canonical="https://vote-scope.com/fr/bibliotheque/"
  lang="fr"
  currentPage="library"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/library/', fr: 'https://vote-scope.com/fr/bibliotheque/', es: 'https://vote-scope.com/es/biblioteca/' }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'La bibliothèque du desk — Vote-Scope', url: 'https://vote-scope.com/fr/bibliotheque/', inLanguage: 'fr' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Bibliothèque', item: 'https://vote-scope.com/fr/bibliotheque/' },
    ]},
  ]}
>
  <EditorialHero
    eyebrow="La bibliothèque du desk"
    title="Les livres derrière les modèles."
    promise="Tout ce que fait Vote-Scope — house effects, simulations, intervalles de confiance — quelqu'un a d'abord écrit un excellent livre là-dessus. Voici l'étagère."
    question="Envie de comprendre pourquoi le modèle pense comme il pense?"
    primaryHref="/fr/methodologie/"
    primaryLabel="Lire la méthodologie"
    secondaryHref="/fr/track-record/"
    secondaryLabel="Voir le track record"
  />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Prévision & statistiques</p>
      <h2>Commencez ici.</h2>
      <AmazonShelf lang="fr" kind="book" />
      {!live && <p>La liste de lecture arrive sous peu.</p>}
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Le vestiaire · Coupe du monde 2026</p>
      <h2>Pour le tournoi.</h2>
      <AmazonShelf lang="fr" kind="wc" />
      {!live && <p>Les choix du tournoi arrivent sous peu.</p>}
      <p style="margin-top:1.5rem;"><a href="/fr/sports/wc2026/">Notre projection WC2026 — 50 000 simulations →</a></p>
    </div>
  </section>
</EditorialLayout>
