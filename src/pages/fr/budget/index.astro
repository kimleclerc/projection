---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import BudgetHub from '../../../components/BudgetHub.astro';

const canonical = 'https://vote-scope.com/fr/budget';
const alternates = { en: 'https://vote-scope.com/en/budget', fr: canonical, es: 'https://vote-scope.com/es/budget' };
---
<EditorialLayout
  title="Budgets du Canada, de l’Ontario et du Québec — Vote-Scope"
  description="Budgets fédéraux et provinciaux : les chiffres, les secteurs et ce qui change selon votre situation. Analyse indépendante, une page par édition."
  canonical={canonical}
  lang="fr"
  currentPage="budget"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Budgets — analyse fiscale indépendante', url: canonical, inLanguage: 'fr' }]}
>
  <BudgetHub locale="fr" />
</EditorialLayout>
