---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import BudgetDesk from '../../../../components/BudgetDesk.astro';
import { ALL } from '../../../../lib/budget-data';
import { t, editionTitle, JURISDICTION_LABEL, budgetEdition } from '../../../../lib/budget';

export function getStaticPaths() {
  return ALL.map((d) => ({ params: { jurisdiction: d.slug, edition: d.edition }, props: { data: d } }));
}

const { data } = Astro.props;
const locale = 'fr' as const;
const jur = JURISDICTION_LABEL[data.slug]?.[locale] ?? data.slug;
const heading = editionTitle(data, locale);
const canonical = `https://vote-scope.com${budgetEdition(locale, data.slug, data.edition)}`;
const alternates = {
  en: `https://vote-scope.com${budgetEdition('en', data.slug, data.edition)}`,
  fr: canonical,
  es: `https://vote-scope.com${budgetEdition('es', data.slug, data.edition)}`,
};
const desc = (t(data.headline, locale) ? `${t(data.headline, locale)} ` : '') + `Analyse indépendante du ${heading} (${jur}) : les chiffres, les secteurs et ce qui change pour vous. Déposé par ${data.minister}. Non affiliée à un gouvernement.`;
---

<EditorialLayout
  title={t(data.seo_title, locale) ? `${t(data.seo_title, locale)} — Vote-Scope` : `${heading} — ${jur} · Analyse indépendante — Vote-Scope`}
  description={desc}
  canonical={canonical}
  lang="fr"
  currentPage="budget"
  ogImage={`https://vote-scope.com/og/budget/${data.slug}/${data.edition}/fr.png?v=${data.meta.ingested_at}`}
  ogType="article"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: `${heading} — ${jur} : analyse indépendante`,
      description: desc,
      url: canonical,
      inLanguage: 'fr',
      datePublished: data.date_iso,
      dateModified: data.meta.ingested_at,
      author: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      about: `${heading}, ${jur}`,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Budget', item: 'https://vote-scope.com/fr/budget/' },
        { '@type': 'ListItem', position: 3, name: jur, item: `https://vote-scope.com/fr/budget/${data.slug}/` },
        { '@type': 'ListItem', position: 4, name: heading, item: canonical },
      ],
    },
  ]}
>
  <BudgetDesk data={data} locale="fr" />
</EditorialLayout>
