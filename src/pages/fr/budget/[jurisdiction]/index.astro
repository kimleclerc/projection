---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import BudgetJurHub from '../../../../components/BudgetJurHub.astro';
import { jurisdictions } from '../../../../lib/budget-data';
import { JURISDICTION_LABEL } from '../../../../lib/budget';

export function getStaticPaths() {
  return jurisdictions().map((slug) => ({ params: { jurisdiction: slug }, props: { slug } }));
}
const { slug } = Astro.props;
const locale = 'fr' as const;
const jur = JURISDICTION_LABEL[slug]?.[locale] ?? slug;
const canonical = `https://vote-scope.com/fr/budget/${slug}/`;
const alternates = { en: `https://vote-scope.com/en/budget/${slug}/`, fr: canonical, es: `https://vote-scope.com/es/budget/${slug}/` };
---
<EditorialLayout
  title={`Budgets ${jur} — Analyse indépendante — Vote-Scope`}
  description={`Chaque budget et mise à jour économique du ${jur}, analysé indépendamment — chiffres, secteurs et impact concret. Archives conservées, une page par édition.`}
  canonical={canonical}
  lang="fr"
  currentPage="budget"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: `Budgets ${jur}`, url: canonical, inLanguage: 'fr' }]}
>
  <BudgetJurHub slug={slug} locale="fr" />
</EditorialLayout>
