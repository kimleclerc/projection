---
import SimulatorPage from '../../../components/SimulatorPage.astro';
import quebecDoc from '../../../../web_data/quebec/simulator.json';
import federalDoc from '../../../../web_data/federal/simulator.json';
import ontarioDoc from '../../../../web_data/ontario/simulator.json';
import usHouseDoc from '../../../../web_data/us-house/simulator.json';

export function getStaticPaths() {
  return [
    { params:{slug:'simulateur-quebec'}, props:{doc:quebecDoc,title:'Et si les sondages bougeaient au Québec?',description:'Construisez un scénario électoral québécois et regardez les 127 circonscriptions changer sur la carte.',lede:'Faites bouger le vote. Regardez la carte et les 127 circonscriptions réagir.',jurisdiction:'Québec · 127 circonscriptions',projectionHref:'/fr/canada/quebec/',enSlug:'quebec-simulator',esSlug:'simulador-quebec'} },
    { params:{slug:'simulateur-canada'}, props:{doc:federalDoc,title:'Et si les sondages bougeaient au Canada?',description:'Construisez un scénario électoral fédéral et regardez les 343 circonscriptions changer sur la carte.',lede:'Déplacez le vote national ou régional et voyez les 343 circonscriptions réagir.',jurisdiction:'Canada · 343 circonscriptions',projectionHref:'/fr/canada/federal/',enSlug:'canada-simulator',esSlug:'simulador-canada'} },
    { params:{slug:'simulateur-ontario'}, props:{doc:ontarioDoc,title:'Et si les sondages bougeaient en Ontario?',description:'Construisez un scénario électoral ontarien et regardez les 124 circonscriptions changer sur la carte.',lede:'Faites bouger les partis et regardez la carte ontarienne se recomposer.',jurisdiction:'Ontario · 124 circonscriptions',projectionHref:'/fr/canada/ontario/',enSlug:'ontario-simulator',esSlug:'simulador-ontario'} },
    { params:{slug:'simulateur-chambre-us'}, props:{doc:usHouseDoc,title:'Et si les sondages bougeaient aux États-Unis?',description:'Construisez un scénario pour les élections de mi-mandat et regardez les 435 districts changer sur la carte.',lede:'Déplacez le vote national ou régional et voyez les 435 districts réagir.',jurisdiction:'États-Unis · 435 districts',projectionHref:'/fr/us/chambre/',enSlug:'us-house-simulator',esSlug:'simulador-camara-us'} },
  ];
}
const { doc, title, description, lede, jurisdiction, projectionHref, enSlug, esSlug } = Astro.props;
const slug = Astro.params.slug!;
const map = {
  qc_2026: { geoUrl:'/web_data/quebec/ridings.geojson', center:[46.6,-72.0], zoom:6, idProp:'CO_CEP', baselineYear:2022 },
  fed_46: { geoUrl:'/web_data/federal/ridings.geojson', center:[56,-96], zoom:4, idProp:'FEDNUM', baselineYear:2025 },
  on_2029: { geoUrl:'/web_data/ontario/ridings.geojson', center:[50,-85], zoom:5, idProp:'FEDNUM', baselineYear:2022 },
  us_house_2026: { geoUrl:'/web_data/us-house/ridings.geojson', center:[37.9,-95.9], zoom:4, idProp:'FEDNUM', baselineYear:2024 },
}[doc.meta.election_cycle];
---
<SimulatorPage locale="fr" doc={doc} map={map} title={title} description={description} lede={lede} jurisdiction={jurisdiction} projectionHref={projectionHref} hubHref="/fr/outils" canonical={`https://vote-scope.com/fr/outils/${slug}`} alternates={{fr:`https://vote-scope.com/fr/outils/${slug}`,en:`https://vote-scope.com/en/tools/${enSlug}`,es:`https://vote-scope.com/es/herramientas/${esSlug}`}} />
