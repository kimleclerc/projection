---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MarketCheck from '../../../components/MarketCheck.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import { specialElections } from '../../../data/specialElections';

import ldiData from '../../../../web_data/us-lame-duck/latest.json';
import houseData from '../../../../web_data/us-house/latest.json';
import senateData from '../../../../web_data/us-senate/latest.json';
import showdownData from '../../../../web_data/cusma-showdown/latest.json';
import presData from '../../../../web_data/us-president/latest.json';

const ldi = ldiData.ldi;
const houseDem = (houseData.parties as Array<{party:string;seats_projected:number;p_majority:number;label_fr:string;color:string}>).find((p) => p.party === 'us_dem')!;
const houseRep = (houseData.parties as Array<{party:string;seats_projected:number;p_majority:number;label_fr:string;color:string}>).find((p) => p.party === 'us_rep')!;
const senateDem = (senateData.parties as Array<{party:string;seats_mean:number;p_majority:number;label_fr:string;color:string}>).find((p) => p.party === 'us_dem')!;
const senateRep = (senateData.parties as Array<{party:string;seats_mean:number;p_majority:number;label_fr:string;color:string}>).find((p) => p.party === 'us_rep')!;

const specials = Object.values(specialElections);
const deltaSign = ldi.delta_7d >= 0 ? '+' : '';
const presRep = (presData as any).primary.rep;
const presDem = (presData as any).primary.dem;
const presRepLead = presRep.standings.find((s: any) => s.status !== 'ineligible') ?? presRep.standings[0];
const presDemLead = presDem.standings.find((s: any) => s.status !== 'ineligible') ?? presDem.standings[0];
---

<EditorialLayout
  title="Politique américaine — Vote-Scope"
  description="Contrôle de la Chambre, fragilité du Sénat, partielles et Lame-Duck Index réunis. Projections en direct mises à jour à chaque nouveau sondage — Vote-Scope."
  canonical="https://vote-scope.com/fr/us/"
  lang="fr"
  currentPage="usa-hub"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/us/', fr: 'https://vote-scope.com/fr/us/', es: 'https://vote-scope.com/es/us/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Politique américaine — Vote-Scope',
      url: 'https://vote-scope.com/fr/us/',
      inLanguage: 'fr',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Desk États-Unis"
    title="Qui contrôle Washington quand la carte cesse d'être théorique?"
    promise="Chambre, Sénat, partielles et poids présidentiel — projetés à partir de sondages publics et mis à jour à mesure que les chiffres tombent."
    question="La carte américaine est-elle stable, fragile, ou mal lue par le marché?"
    primaryHref="/fr/us/indexes/lame-duck/"
    primaryLabel="Ouvrir Lame-Duck"
    secondaryHref="/fr/indexes/"
    secondaryLabel="Tous les index"
  />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Nouveau · Indice propriétaire</p>
      <div class="note-card" style="border-left:4px solid #c64d2d;">
        <h2>Radar Latino USA</h2>
        <p>Les courses Chambre et Sénat où l’électorat latino, la compétitivité et le contrôle du Congrès se rencontrent — classées sur 100.</p>
        <p><a href="/fr/us/radar-latino/" class="cta-link">Ouvrir le radar →</a></p>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <AffiliateCard partner="proton" lang="fr" visual placement="us-desk" />
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Instrument live</p>
      <div class="content-grid-2" style="gap:1.5rem;align-items:start;">
        <div class="note-card" style={`border-left:4px solid ${ldi.zone_color};`}>
          <p class="eyebrow">Lame-Duck Index</p>
          <h2 style="font-size:3rem;margin:0.25rem 0;color:var(--text);">
            <AnimatedNumber client:visible value={ldi.score} decimals={1} />
            <span style="font-size:1.1rem;font-weight:400;">/100</span>
          </h2>
          <p style={`font-weight:700;color:${ldi.zone_color};font-size:1.1rem;`}>{ldi.label_fr}</p>
          <p>Delta 7 jours: <strong>{deltaSign}{ldi.delta_7d}</strong></p>
          <p style="margin-top:1rem;">
            <a href="/fr/us/indexes/lame-duck/" class="cta-link">Index complet →</a>
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div class="note-card" style={`border-left:4px solid ${houseDem.color};`}>
            <p class="eyebrow">Chambre 2026</p>
            <p>
              Dém <strong><AnimatedNumber client:visible value={houseDem.seats_projected} /></strong> ·
              Rép <strong><AnimatedNumber client:visible value={houseRep.seats_projected} /></strong>
              <span style="font-size:0.85rem;"> / 435</span>
            </p>
            <p>Probabilité majorité D: <strong>{Math.round(houseDem.p_majority * 100)}%</strong></p>
            <a href="/fr/us/chambre/" class="cta-link" style="font-size:0.85rem;">Projection Chambre →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${senateDem.color};`}>
            <p class="eyebrow">Sénat 2026</p>
            <p>
              Dém ~<strong><AnimatedNumber client:visible value={Math.round(senateDem.seats_mean)} /></strong> ·
              Rép ~<strong><AnimatedNumber client:visible value={Math.round(senateRep.seats_mean)} /></strong>
              <span style="font-size:0.85rem;"> / 100</span>
            </p>
            <p>Probabilité majorité D: <strong>{Math.round(senateDem.p_majority * 100)}%</strong></p>
            <a href="/fr/us/senat/" class="cta-link" style="font-size:0.85rem;">Projection Sénat →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${presRep.color};`}>
            <p class="eyebrow">Présidentielle 2028 · Primaire invisible</p>
            <p>
              REP <strong>{presRepLead.short_label} {presRepLead.share.toFixed(0)} %</strong> ·
              DEM <strong>{presDemLead.short_label} {presDemLead.share.toFixed(0)} %</strong>
            </p>
            <p style="font-size:0.85rem;">Champs de primaire + carte du collège électoral.</p>
            <a href="/fr/us/presidentielle/" class="cta-link" style="font-size:0.85rem;">Desk présidentiel →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${showdownData.showdown.zone_color};`}>
            <p class="eyebrow">Duel ACEUM</p>
            <p>Écart de levier : <strong style={`color:${showdownData.showdown.zone_color};`}>{showdownData.showdown.gap > 0 ? '+' : ''}{showdownData.showdown.gap}</strong> — {showdownData.showdown.label_fr}</p>
            <a href="/fr/indexes/cusma-showdown/" class="cta-link" style="font-size:0.85rem;">Bernache vs Canard boiteux →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Élections partielles</p>
      <h2>Partielles actives et récentes</h2>
      <div class="content-grid-2" style="gap:1rem;margin-top:1rem;">
        {specials.map((s) => (
          <a class="note-card" href={s.paths.fr ?? s.paths.en ?? '#'} style="text-decoration:none;color:inherit;">
            <p class="eyebrow">{s.kicker}</p>
            <h3 style="margin:0.25rem 0;">{s.headline.replace(/\n/g, ' ')}</h3>
            <p style="font-size:0.9rem;">{s.dek.slice(0, 180)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Marchés de prédiction</p>
      <h2>Ce que les marchés disent en parallèle du modèle</h2>
      <PolymarketEmbed slug="2026-balance-of-power-d-senate-d-house-949" title="Mi-mandat américain 2026 — équilibre des pouvoirs" />
      <PolymarketEmbed slug="will-gavin-newsom-win-the-2028-us-presidential-election" title="Présidentielle américaine 2028" />
    </div>
  </section>

  <MarketCheck
    kicker="Modèle vs marché"
    title="Là où le modèle et le marché divergent."
    body="Contrôle des chambres, confiance par course et les moments où les traders paniquent — placés juste à côté de notre projection, pour que les écarts sautent aux yeux."
    modelLabel="Modèle"
    marketLabel="Marché"
    note="Repères Polymarket, actualisés chaque jour à côté de chaque projection."
  />

  <MethodologyNote
    title="Comment les projections américaines sont bâties."
    body="Contrôle de la Chambre et du Sénat, fragilité des sièges et désaccord avec le marché — chacun bâti à partir de sondages publics dans un modèle bayésien aux biais corrigés, calibré sur les résultats passés, la simulation ne faisant que traduire les votes en sièges. Le tout ouvert sur la page."
    bullets={[
      'Les sondages Chambre et Sénat sont agrégés avec un modèle BSTS bayésien et soumis à des simulations district par district (435 et 100 respectivement).',
      'Le Lame-Duck Index (LDI) combine approbation présidentielle, indicateurs économiques, marges de district et cotes de marchés de prédiction en un score de 0 à 100.',
      'Les élections partielles utilisent un modèle de fondamentaux: titularité, marge historique, profil des candidats, et sondages locaux disponibles.',
      'Les repères de marchés de prédiction (Polymarket) sont affichés aux côtés du modèle comme signal de désaccord indépendant, mis à jour quotidiennement.',
    ]}
  />
</EditorialLayout>
