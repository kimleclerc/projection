---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsEarlyVote from '../../../components/UsEarlyVote.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';

const canonical = 'https://vote-scope.com/fr/us/vote-anticipe/';
---

<EditorialLayout
  title="Vote anticipé des midterms 2026 : qui a déjà voté ? — Vote-Scope"
  description="Démocrates, républicains et non-affiliés parmi les bulletins déjà déposés en Caroline du Nord, en Pennsylvanie et en Floride, comparés au même stade de 2022 et de 2024."
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/us/early-vote/', fr: 'https://vote-scope.com/fr/us/vote-anticipe/', es: 'https://vote-scope.com/es/us/voto-anticipado/' }}
>
  <UsEarlyVote locale="fr" />
  <NewsletterCta lang="fr" placement="us-early-vote" />
</EditorialLayout>
