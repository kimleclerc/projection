---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import PollsHub from '../../../../../components/PollsHub.astro';
import { getPollsMeta, getNationalPolls, getFirms } from '../../../../../lib/polls-adapter';
import { pollPartyChips } from '../../../../../lib/poll-parties';

const WEB_KEY = 'us-house';
const meta = getPollsMeta(WEB_KEY)!;
const polls = getNationalPolls(WEB_KEY);
const firms = getFirms(WEB_KEY);
const chips = pollPartyChips(WEB_KEY, meta.parties, 'fr');

const canonical = 'https://vote-scope.com/fr/us/chambre/sondages/';
---

<EditorialLayout
  title="Sondages Chambre des représentants 2026 — Vote-Scope"
  description="Tous les sondages d’intentions de vote pour la Chambre des représentants (cycle 2026) : maison, dates de terrain, échantillon et intentions. Mis à jour en continu."
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/us-house/polls/fr.png"
  alternates={{
    en: 'https://vote-scope.com/en/us/house/polls/',
    fr: canonical,
    es: 'https://vote-scope.com/es/us/house/sondeos/',
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sondages Chambre des représentants 2026',
      url: canonical,
      inLanguage: 'fr',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
    },
  ]}
>
  <section class="polls-hero">
    <div class="container">
      <p class="eyebrow">Sondages · Chambre US · cycle 2026</p>
      <h1>Le vote générique.</h1>
      <p class="lede">Chaque sondage national d’intentions de vote, avec sa maison, son terrain et ses intentions. Les sondages de circonscription apparaissent sur la page de prévision de chaque circonscription.</p>
    </div>
  </section>

  <PollsHub lang="fr" meta={meta} polls={polls} firms={firms} parties={chips} pollsBase="/fr/us/chambre/sondages" />
</EditorialLayout>

<style>
  .polls-hero { padding: 80px 0 28px; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .polls-hero .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .polls-hero h1 { margin: 8px 0 16px; font-family: var(--serif); font-size: clamp(40px, 5vw, 64px); font-weight: 420; letter-spacing: -0.02em; line-height: 1.02; max-width: 900px; }
  .polls-hero .lede { max-width: 760px; font-family: var(--serif); font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; color: var(--ink-2); }
</style>
