---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import senateMeta from '../../../../web_data/us-senate/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.usSenate;
const canonical = 'https://vote-scope.com/fr/us/senat/';
const alternates = {
  en: 'https://vote-scope.com/en/us/senate/',
  fr: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection Sénat américain 2026',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: senateMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-senate/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Sénat américain', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr"><Fragment slot="narrative"><RaceNarrative locale="fr" {...raceEditorial.usSenate.fr} /></Fragment></ProjectionEngine>
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections" title="Sénat 2026 — contrôle du parti" />
  </div>

  <RidingsCta
    eyebrow="Profil de siège"
    title="Plonger dans une course sénatoriale"
    blurb="Projection, résultat de référence, classement de la course, sièges compétitifs voisins — pour chacune des 35 courses contestées en 2026 (33 régulières Classe III + 2 partielles)."
    href="/fr/us/senat/sieges/"
    cta="Parcourir les 35 courses →"
  />
</EditorialLayout>

