---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import houseMeta from '../../../../web_data/us-house/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.usHouse;
const canonical = 'https://vote-scope.com/fr/us/chambre/';
const alternates = {
  en: 'https://vote-scope.com/en/us/house/',
  fr: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection Chambre des représentants 2026',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: houseMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-house/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Chambre des représentants', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr"><Fragment slot="narrative"><RaceNarrative locale="fr" {...raceEditorial.usHouse.fr} /></Fragment></ProjectionEngine>
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-house-after-the-2026-midterm-elections" title="Chambre 2026 — contrôle du parti" />
  </div>

  <RidingsCta
    eyebrow="Profil de district"
    title="Plonger dans un district"
    blurb="Projection, représentant·e en fonction, candidat·e·s 2026, leader de la primaire (lorsque sondé·e), impact du redécoupage 2025-2026 — pour chacun des 435 districts de la Chambre."
    href="/fr/us/chambre/districts/"
    cta="Parcourir les 435 districts →"
  />
</EditorialLayout>

