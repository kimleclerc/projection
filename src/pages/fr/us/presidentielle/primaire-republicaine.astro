---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const block = (latest as any).primary.rep;
const elig = block.standings.filter((s: any) => s.status !== 'ineligible');
const [lead, second, third] = elig;
const pct = (s: any) => `${s.share.toFixed(1).replace('.', ',')}\u00a0%`;
const canonical = 'https://vote-scope.com/fr/us/presidentielle/primaire-republicaine/';
const alternates = { en: 'https://vote-scope.com/en/us/president/republican-primary/', fr: 'https://vote-scope.com/fr/us/presidentielle/primaire-republicaine/', es: 'https://vote-scope.com/es/us/presidencial/primaria-republicana/' };
---

<EditorialLayout
  title="Primaire républicaine 2028 : les sondages, candidat par candidat | Vote-Scope"
  description={`Moyenne des sondages de la primaire républicaine 2028 : ${lead.name} mène avec ${pct(lead)}, devant ${second.name} et ${third.name}${third.name.endsWith('.') ? '' : '.'} Tous les candidats testés, les scénarios et les premiers États.`}
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Primaire républicaine 2028 : les sondages, candidat par candidat',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Présidentielle', item: 'https://vote-scope.com/fr/us/presidentielle/' },
        { '@type': 'ListItem', position: 4, name: 'Primaire républicaine', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="fr" view="rep" />
</EditorialLayout>
