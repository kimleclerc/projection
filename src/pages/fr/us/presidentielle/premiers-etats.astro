---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/fr/us/presidentielle/premiers-etats/';
const alternates = { en: 'https://vote-scope.com/en/us/president/early-states/', fr: 'https://vote-scope.com/fr/us/presidentielle/premiers-etats/', es: 'https://vote-scope.com/es/us/presidencial/primeros-estados/' };
---

<EditorialLayout
  title="Primaires 2028 : sondages en Iowa, au New Hampshire, en Caroline du Sud et au Nevada | Vote-Scope"
  description="Moyennes des sondages d’État pour les premières primaires présidentielles 2028, démocrate et républicaine : Iowa, New Hampshire, Caroline du Sud et Nevada, avec le nombre de sondages de chacune."
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Primaires 2028 : sondages en Iowa, au New Hampshire, en Caroline du Sud et au Nevada',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Présidentielle', item: 'https://vote-scope.com/fr/us/presidentielle/' },
        { '@type': 'ListItem', position: 4, name: 'Premiers États', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="fr" view="early" />
</EditorialLayout>
