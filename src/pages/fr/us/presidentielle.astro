---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsPresidentDesk from '../../../components/UsPresidentDesk.astro';
import latest from '../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const demLead = (latest as any).primary.dem.standings[0];
const repLead = (latest as any).primary.rep.standings[0];
const demTop = demLead.short_label;
const repTop = repLead.short_label;
const demLeadName = demLead.name;
const repLeadName = repLead.name;
const demLeadShare = demLead.share.toFixed(1).replace('.', ',');
const repLeadShare = repLead.share.toFixed(1).replace('.', ',');
const canonical = 'https://vote-scope.com/fr/us/presidentielle/';
const alternates = {
  en: 'https://vote-scope.com/en/us/president/',
  fr: canonical,
  es: 'https://vote-scope.com/es/us/presidencial/',
};
---

<EditorialLayout
  title={`Présidentielle américaine 2028 : sondages et candidats — ${repTop} ou ${demTop} ? — Vote-Scope`}
  description={`Sondages de la présidentielle américaine 2028 : ${demLeadName} mène chez les démocrates (${demLeadShare} %), ${repLeadName} chez les républicains (${repLeadShare} %). Les candidats, la moyenne des sondages des primaires, les premiers États et la carte électorale. ${meta.n_primary_polls} sondages, mis à jour le ${meta.run_date}.`}
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/share/projection/us-president/fr.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Présidentielle US 2028 — Primaire invisible',
      description: 'Agrégat pondéré qualité des sondages de primaire 2028 et cadre du collège électoral.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Quand a lieu la prochaine élection présidentielle américaine ?', acceptedAnswer: { '@type': 'Answer', text: 'La prochaine présidentielle américaine a lieu le mardi 7 novembre 2028. Les primaires et caucus commencent au début de 2028.' } },
        { '@type': 'Question', name: 'Qui mène dans les sondages des primaires de 2028 ?', acceptedAnswer: { '@type': 'Answer', text: `Dans notre moyenne des sondages, ${demLeadName} mène la primaire démocrate avec ${demLeadShare} % et ${repLeadName} la primaire républicaine avec ${repLeadShare} %.` } },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Présidentielle', item: canonical },
      ],
    },
  ]}
>
  <UsPresidentDesk locale="fr" />
</EditorialLayout>
