---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsPresidentDesk from '../../../components/UsPresidentDesk.astro';
import latest from '../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const demLead = (latest as any).primary.dem.standings.find((candidate: { status: string }) => candidate.status !== "ineligible") ?? (latest as any).primary.dem.standings[0];
const repLead = (latest as any).primary.rep.standings.find((candidate: { status: string }) => candidate.status !== "ineligible") ?? (latest as any).primary.rep.standings[0];
const demLeadName = demLead.name;
const repLeadName = repLead.name;
const demLeadShare = demLead.share.toFixed(1).replace('.', ',');
const repLeadShare = repLead.share.toFixed(1).replace('.', ',');
const canonical = 'https://vote-scope.com/fr/us/presidentielle/';
const alternates = {
  en: 'https://vote-scope.com/en/us/president/',
  fr: canonical,
  es: 'https://vote-scope.com/es/us/presidencial/',
};
---

<EditorialLayout
  title="Présidentielle américaine 2028 : sondages des primaires démocrate et républicaine | Vote-Scope"
  description={`Moyenne des sondages des primaires américaines de 2028 : ${repLeadName} mène chez les républicains (${repLeadShare} %) et ${demLeadName} chez les démocrates (${demLeadShare} %). Les candidats, le calendrier des débats et la carte électorale.`}
  canonical={canonical}
  lang="fr"
  currentPage="us"
  ogImage="https://vote-scope.com/og/share/projection/us-president/fr.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Présidentielle US 2028 — Primaire invisible',
      description: 'Agrégat pondéré qualité des sondages de primaire 2028 et cadre du collège électoral.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Présidentielle', item: canonical },
      ],
    },
  ]}
>
  <UsPresidentDesk locale="fr" />
</EditorialLayout>
