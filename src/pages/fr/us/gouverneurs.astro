---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import governorMeta from '../../../../web_data/us-governor/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.usGovernor;
const canonical = 'https://vote-scope.com/fr/us/gouverneurs/';
const alternates = {
  en: 'https://vote-scope.com/en/us/governors/',
  fr: 'https://vote-scope.com/fr/us/gouverneurs/',
  es: 'https://vote-scope.com/es/us/gobernadores/',
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/projections/us-governor/fr.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: '2026 U.S. Governor Projection',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: governorMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-governor/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'États-Unis', item: 'https://vote-scope.com/fr/us/' },
        { '@type': 'ListItem', position: 3, name: 'Projection des gouverneurs', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr"><Fragment slot="narrative"><RaceNarrative locale="fr" {...raceEditorial.usGovernor.fr} /></Fragment></ProjectionEngine>

  <RidingsCta
    eyebrow="Profil de course"
    title="Plonger dans une course gubernatoriale"
    blurb="Projection, résultat précédent, classement de la course et courses voisines — pour chacun des 36 États qui élisent un gouverneur en 2026, dont les 18 sièges ouverts."
    href="/fr/us/gouverneurs/courses/"
    cta="Parcourir les 36 courses →"
  />
  <NewsletterCta lang="fr" placement="gouverneurs" />
</EditorialLayout>
