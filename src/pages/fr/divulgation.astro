---
import { getEntry } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import EditorialStory from '../../components/EditorialStory.astro';

const entry = await getEntry('editorial', 'fr/divulgation');
if (!entry) throw new Error('Missing editorial entry: fr/divulgation');
const d = entry.data;
---

<EditorialLayout
  title={d.title}
  description={d.description}
  canonical={d.alternates.fr}
  lang="fr"
  currentPage="disclosure"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={d.alternates}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: d.title, url: d.alternates.fr, inLanguage: 'fr' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Divulgation', item: d.alternates.fr },
    ]},
  ]}
>
  <EditorialStory entry={entry} />
</EditorialLayout>
