---
import UkByelectionDesk from '../../../../components/UkByelectionDesk.astro';
import UkRaceDesk from '../../../../components/UkRaceDesk.astro';
import { ukByelections } from '../../../../data/ukByelections';

export function getStaticPaths() {
  return Object.values(ukByelections)
    .filter((config) => config.paths.fr)
    .map((config) => ({ params: { slug: config.slug }, props: { config } }));
}

const { config } = Astro.props;
---

{/* UkByelectionDesk est le dossier de Clacton — marchés, fil de dépouillement,
    courbe de participation, sondage local : tout est propre à cette course, et
    il rend désormais son RÉSULTAT. Une course en cours sans sondage de
    circonscription n'a rien de tout ça, d'où un desk distinct. */}
{config.result ? (
  <UkByelectionDesk lang="fr" config={config} />
) : (
  <UkRaceDesk lang="fr" config={config} />
)}
