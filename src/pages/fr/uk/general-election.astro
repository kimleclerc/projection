---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ukMeta from '../../../../web_data/uk/latest.json';

const j = jurisdictions.uk;
const canonical = 'https://vote-scope.com/fr/uk/general-election/';
const alternates = {
  en: 'https://vote-scope.com/en/uk/general-election/',
  fr: canonical,
  es: 'https://vote-scope.com/es/uk/general-election/',
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection élection générale R.-U.',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: ukMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/uk/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'R.-U.', item: 'https://vote-scope.com/fr/uk/' },
        { '@type': 'ListItem', position: 3, name: 'Élection générale', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <!-- TODO: when UK general-election Polymarket emerges, set slug here -->
    <PolymarketEmbed slug={null} />
  </div>

  <RidingsCta
    eyebrow="Profil de circonscription"
    title="Plonger dans une circonscription"
    blurb="Projection, député·e en fonction, candidats 2024 et circonscriptions voisines — pour chacune des 650 circonscriptions de Westminster. Les sièges nord-irlandais conservent leur identité partisane (DUP, Sinn Féin, SDLP, Alliance, UUP, TUV) même lorsque le modèle utilise le bucket « autre »."
    href="/fr/uk/circonscriptions/"
    cta="Parcourir les 650 circonscriptions →"
  />
</EditorialLayout>

