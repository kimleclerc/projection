---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../components/riding/RidingPage.astro';
import { getAllUKRidings } from '../../../../lib/riding-adapters/uk';

export function getStaticPaths() {
  return getAllUKRidings().map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/fr/uk/circonscriptions/${data.slug}/`;
const alternateEn = `https://vote-scope.com/en/uk/constituencies/${data.slug}/`;
const title = `${data.name.fr || data.name.en} — Projection législatives britanniques — Vote-Scope`;
const description = `Projection Vote-Scope pour ${data.name.fr || data.name.en} (${data.province || 'Royaume-Uni'}) : parts de voix par parti, député·e en fonction, candidats 2024.`;
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="fr"
  currentPage="uk"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: alternateEn, fr: canonical }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: data.name.fr || data.name.en,
      containedInPlace: { '@type': 'AdministrativeArea', name: data.province || 'Royaume-Uni' },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope',       item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Royaume-Uni',      item: 'https://vote-scope.com/fr/uk/' },
        { '@type': 'ListItem', position: 3, name: 'Législatives',     item: 'https://vote-scope.com/fr/uk/general-election/' },
        { '@type': 'ListItem', position: 4, name: 'Circonscriptions', item: 'https://vote-scope.com/fr/uk/circonscriptions/' },
        { '@type': 'ListItem', position: 5, name: data.name.fr || data.name.en, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="fr" />
</EditorialLayout>
