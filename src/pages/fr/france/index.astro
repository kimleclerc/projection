---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FranceDesk from '../../../components/FranceDesk.astro';
import latest from '../../../../web_data/france-presidential/latest.json';
import DeskSections from '../../../components/DeskSections.astro';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/fr/france/';
---

<EditorialLayout
  title="Présidentielle française 2027 — Projection Vote-Scope"
  description={`Projection par scénarios de la présidentielle française 2027 : premier tour, duels du second tour et castings hypothétiques. ${meta.n_first_round_polls} sondages agrégés, run du ${meta.run_date}.`}
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/france-desk/fr.png"
  alternates={{ en: 'https://vote-scope.com/en/france/', fr: canonical, es: 'https://vote-scope.com/es/france/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection présidentielle France 2027',
      description: 'Projection par scénarios : premier tour et duels du second tour.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
    },
  ]}
>
  <FranceDesk locale="fr" />
  <DeskSections lang="fr" desk="france" />
</EditorialLayout>
