---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FranceDesk from '../../../components/FranceDesk.astro';
import latest from '../../../../web_data/france-presidential/latest.json';
import DeskSections from '../../../components/DeskSections.astro';
import dataSheets from '../../../../web_data/france-presidential/data_sheets.json';
import { pickHeroScenario } from '../../../lib/fr-explorer';
import { toScenarioCard, fmtPct1 } from '../../../lib/fr-pres';

const meta = (latest as any).meta;
// Chiffres du jour dans la description : même hypothèse que l'en-tête de page.
const { heroScenario } = pickHeroScenario((latest as any).scenarios, (dataSheets as any).candidates ?? [], (latest as any).default_scenario_id);
const heroTop = toScenarioCard(heroScenario, 'fr').qualification.slice(0, 3);
const leadName = heroTop[0]?.name ?? '';
const seo = heroTop.map((q) => `${q.name} ${fmtPct1(q.mean, 'fr')}`).join(', ');
const seoDate = new Date(`${meta.run_date}T12:00:00Z`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const canonical = 'https://vote-scope.com/fr/france/';
---

<EditorialLayout
  title="Présidentielle 2027 : qui va gagner ? Projection des sondages — Vote-Scope"
  description={`Qui va gagner la présidentielle 2027 ? Notre moyenne des sondages : ${seo}. Qui affronterait ${leadName} au second tour, et avec quel score. Mise à jour le ${seoDate}.`}
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/france-desk/fr.png"
  alternates={{ en: 'https://vote-scope.com/en/france/', fr: canonical, es: 'https://vote-scope.com/es/france/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection présidentielle France 2027',
      description: 'Projection par scénarios : premier tour et duels du second tour.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
    },
  ]}
>
  <FranceDesk locale="fr" />
  <DeskSections lang="fr" desk="france" />
</EditorialLayout>
