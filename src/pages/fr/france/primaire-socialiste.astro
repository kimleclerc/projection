---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FrancePsPrimary from '../../../components/FrancePsPrimary.astro';
const canonical = 'https://vote-scope.com/fr/france/primaire-socialiste/';
---

<EditorialLayout
  title="Primaire socialiste 2026 : Raphaël Glucksmann l’emporte avec 66 % — résultats — Vote-Scope"
  description="Résultats de la primaire sociale-démocrate du 11 octobre 2026 : Raphaël Glucksmann gagne dès le premier tour avec 66,2 %, devant Olivier Faure (14,5 %), Ségolène Royal, Emmanuel Maurel et Jérôme Guedj. Participation et enjeux pour la présidentielle 2027."
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/share/projection/france-presidential/fr.png"
  alternates={{ en: 'https://vote-scope.com/en/france/socialist-primary/', fr: 'https://vote-scope.com/fr/france/primaire-socialiste/', es: 'https://vote-scope.com/es/france/primarias-socialistas/' }}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Primaire socialiste 2026 ',
    startDate: '2026-10-09',
    endDate: '2026-10-11',
    eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'VirtualLocation', url: 'https://parti-socialiste.fr/actualites/participe-a-la-primaire-socialiste/' },
    organizer: { '@type': 'Organization', name: 'Parti socialiste', url: 'https://parti-socialiste.fr' },
    url: canonical,
  }]}
>
  <FrancePsPrimary locale="fr" />
</EditorialLayout>
