---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FranceCandidatesIndex from '../../../../components/FranceCandidatesIndex.astro';

const canonical = 'https://vote-scope.com/fr/france/candidats/';
---

<EditorialLayout
  title="Candidats à la présidentielle 2027 — Vote-Scope"
  description="Tous les candidats à l'élection présidentielle française de 2027 : déclarés et probables. Une page par candidat — bio, intentions de vote au premier tour et duels de second tour."
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/france/candidates/', fr: canonical }}
>
  <FranceCandidatesIndex locale="fr" />
</EditorialLayout>
