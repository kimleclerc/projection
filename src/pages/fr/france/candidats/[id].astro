---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FranceCandidatePage from '../../../../components/FranceCandidatePage.astro';
import { getAllCandidates, slugify, candidateProse } from '../../../../lib/fr-candidates';
import { blocLabel, statusLabel } from '../../../../lib/fr-pres';
import latest from '../../../../../web_data/france-presidential/latest.json';

export function getStaticPaths() {
  return getAllCandidates().map((candidate) => ({
    params: { id: candidate.slug },
    props: { candidate },
  }));
}

const { candidate } = Astro.props;
const meta = (latest as any).meta;
const canonical = `https://vote-scope.com/fr/france/candidats/${candidate.slug}/`;
const enSlug = slugify(candidate.name);
const desc = candidateProse(candidate, 'fr').join(' ') + ' · ' + meta.run_date;
---

<EditorialLayout
  title={`${candidate.name} : sondages présidentielle 2027 et second tour — Vote-Scope`}
  description={desc}
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage={`https://vote-scope.com/og/share/candidate/${candidate.slug}/fr.png`}
  alternates={{
    en: `https://vote-scope.com/en/france/candidates/${enSlug}/`,
    fr: canonical,
    es: `https://vote-scope.com/es/france/candidatos/${enSlug}/`,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: candidate.name,
      url: canonical,
      description: candidateProse(candidate, 'fr')[0],
    },
  ]}
>
  <FranceCandidatePage candidate={candidate} locale="fr" />
</EditorialLayout>
