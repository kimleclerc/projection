---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FrancePollsPage from '../../../../components/FrancePollsPage.astro';
import polls from '../../../../../web_data/france-presidential/polls.json';

const meta = (polls as any).meta;
const lastPoll = meta.last_release_date
  ? new Date(meta.last_release_date + 'T12:00:00Z').toLocaleDateString('fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
const lastPollShort = meta.last_release_date
  ? new Date(meta.last_release_date + 'T12:00:00Z').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' })
  : null;
const canonical = 'https://vote-scope.com/fr/france/sondages/';
const alternates = {
  en: 'https://vote-scope.com/en/france/polls/',
  fr: canonical,
  es: 'https://vote-scope.com/es/france/sondeos/',
};
---

<EditorialLayout
  title={lastPollShort
    ? `Sondage présidentielle 2027 : dernier sondage au ${lastPollShort}`
    : 'Sondage présidentielle 2027 : le dernier sondage et la moyenne'}
  description={`Où en est la présidentielle 2027 ? ${meta.n_first_round_polls} sondages de premier tour et ${meta.n_runoff_polls} duels de second tour${meta.n_firms ? ` de ${meta.n_firms} instituts` : ''}${lastPoll ? `, à jour au ${lastPoll}` : ''}. Moyenne pondérée et sondage par sondage.`}
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Sondages présidentielle France 2027',
    description: 'Compilation des sondages de premier et second tour de la présidentielle française 2027.',
    url: canonical,
    dateModified: meta.generated_at,
    creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    license: 'https://vote-scope.com/fr/conditions/',
    isAccessibleForFree: true,
  }]}
>
  <FrancePollsPage locale="fr" />
</EditorialLayout>
