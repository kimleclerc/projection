---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FrancePollPage from '../../../../components/FrancePollPage.astro';
import type { FrPoll } from '../../../../components/FrancePollPage.astro';
import byPoll from '../../../../../web_data/france-presidential/polls_by_poll.json';

export function getStaticPaths() {
  return (byPoll.polls as FrPoll[]).map((poll) => ({ params: { slug: poll.slug }, props: { poll } }));
}

const { poll } = Astro.props as { poll: FrPoll };
const locale = 'fr' as 'en' | 'fr' | 'es';
const dateLabel = new Date(`${poll.release_date}T12:00:00Z`).toLocaleDateString(
  locale === 'fr' ? 'fr-CA' : locale === 'es' ? 'es-ES' : 'en-CA',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' },
);
const lead = poll.lead_entries.slice(0, 3).map((e) => `${e.name} ${e.share} %`).join(', ');
const canonical = `https://vote-scope.com/fr/france/sondages/${poll.slug}/`;
---

<EditorialLayout
  title={`Sondage ${poll.firm_name} du ${dateLabel} — présidentielle 2027 — Vote-Scope`}
  description={`Sondage ${poll.firm_name} publié le ${dateLabel} pour la présidentielle 2027 : ${lead} — et les ${poll.n_scenarios} configurations de candidatures testées par la même enquête.`}
  canonical={canonical}
  lang="fr"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: `https://vote-scope.com/en/france/polls/${poll.slug}/`, fr: `https://vote-scope.com/fr/france/sondages/${poll.slug}/`, es: `https://vote-scope.com/es/france/sondeos/${poll.slug}/` }}
>
  <FrancePollPage poll={poll} locale="fr" base="/fr/france/sondages" hubHref="/fr/france/sondages/" deskHref="/fr/france/" />
</EditorialLayout>
