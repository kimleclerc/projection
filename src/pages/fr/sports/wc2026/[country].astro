---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import WcCountry from '../../../../components/WcCountry.astro';
import { teamSlugs, getTeam, teamLabel, wcAlternates } from '../../../../lib/wc';

export function getStaticPaths() {
  return teamSlugs.map((slug) => ({ params: { country: slug } }));
}

const { country } = Astro.params;
const team = getTeam(country!)!;
const lang = 'fr' as const;
const name = teamLabel(country!, lang);
const alts = wcAlternates(`/${country}`);
---

<EditorialLayout
  title={`${name} — pronostic tournoi 2026 — Vote-Scope`}
  description={`Le parcours projeté de ${name} au tournoi international de football 2026 : ${team.p_champion}% de remporter le titre, avec les probabilités de la phase de groupes à la finale. Modèle Vote-Scope.`}
  canonical={alts.fr}
  lang="fr"
  currentPage="sports"
  alternates={alts}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: `${name} — pronostic tournoi 2026`,
      description: `Probabilités d'atteindre chaque tour pour ${name} au tournoi international de football 2026.`,
      url: alts.fr,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Sports Scope', item: 'https://vote-scope.com/fr/sports/' },
        { '@type': 'ListItem', position: 2, name: 'WC2026', item: 'https://vote-scope.com/fr/sports/wc2026/' },
        { '@type': 'ListItem', position: 3, name, item: alts.fr },
      ],
    },
  ]}
>
  <WcCountry lang="fr" team={team} />
</EditorialLayout>
