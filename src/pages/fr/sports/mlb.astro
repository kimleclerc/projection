---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import MlbDesk from '../../../components/MlbDesk.astro';
import mlbData from '../../../../web_data/sports/mlb2026_latest.json';

const meta = mlbData.board_meta;
const canonical = 'https://vote-scope.com/fr/sports/mlb/';
---

<EditorialLayout
  title="MLB 2026 — Projection Série mondiale — Vote-Scope"
  description={`Projette le chemin des 30 équipes MLB vers la Série mondiale 2026 — probabilités de séries, de division, de championnat et de titre. ${meta.sims.toLocaleString('fr-CA')} simulations chaque nuit — Vote-Scope.`}
  canonical={canonical}
  lang="fr"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/mlb-desk/fr.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/mlb/', fr: canonical, es: 'https://vote-scope.com/es/sports/mlb/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection MLB 2026 — Série mondiale',
      description: `Modèle de probabilités de la Série mondiale pour les 30 équipes MLB : ${meta.sims.toLocaleString('fr-CA')} simulations par run, ${meta.model}, données ${meta.source}.`,
      url: canonical,
      dateModified: mlbData.generated_at,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      license: 'https://vote-scope.com/fr/conditions/',
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/sports/mlb2026_latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/fr/sports/' },
        { '@type': 'ListItem', position: 3, name: 'MLB', item: canonical },
      ],
    },
  ]}
>
  <MlbDesk locale="fr" />
</EditorialLayout>
