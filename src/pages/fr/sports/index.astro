---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MarketCheck from '../../../components/MarketCheck.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';

import sportsData from '../../../../web_data/sports/latest.json';

const hero = sportsData.hero;
const boardMeta = sportsData.board_meta;
---

<EditorialLayout
  title="Sports Scope — projections LNH et Coupe du monde — Vote-Scope"
  description="Projette les chemins de Coupe NHL, suit la volatilité des gardiens et compare les écarts modèle-marché à chaque ronde. Mis à jour quotidiennement — Vote-Scope."
  canonical="https://vote-scope.com/fr/sports/"
  lang="fr"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/', fr: 'https://vote-scope.com/fr/sports/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sports Scope — Vote-Scope',
      url: 'https://vote-scope.com/fr/sports/',
      inLanguage: 'fr',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/fr/sports/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Sports Scope"
    title="Qui a le chemin le plus propre, et qui vit sur une séquence fragile?"
    promise="Une verticale plus sportive pour chemins de séries, volatilité des gardiens, scores live, marchés et chaos de tournoi."
    question="Le favori est-il vraiment construit pour la prochaine ronde?"
    primaryHref="/fr/sports/wc2026/"
    primaryLabel="Desk Coupe du monde"
    secondaryHref="/fr/sports/nhl/"
    secondaryLabel="Desk NHL"
  />


  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Coupe du monde 2026 · terminée · 19 juillet</p>
      <h2>L’Espagne est championne du monde.</h2>
      <p>L’Espagne a battu l’Argentine 1–0 après prolongation. L’archive conserve tout le bilan du modèle : Espagne première à l’ouverture à 7,36 %, mais Argentine légèrement favorite au dernier run avant la finale, 53,59–46,41.</p>
      <p style="margin-top:0.5rem;">
        <a href="/fr/sports/wc2026/" class="cta-link">Ouvrir l’archive Coupe du monde →</a>
        &nbsp;·&nbsp;
        <a href="/fr/sports/wc2026/equipes/" class="cta-link">Histoires des équipes →</a>
      </p>
    </div>
  </section>

  <section class="content-band">
    <div class="container content-grid-2">
      <div class="note-card">
        <p class="eyebrow">Historique sport</p>
        <h3><a href="/fr/sports/track-record/">Historique du modèle.</a></h3>
        <p>Simulations éliminatoires NHL et appels de séries — chaque cycle de modèle, chaque prédiction publiée, archivée.</p>
        <p style="margin-top:1rem;">
          <a href="/fr/sports/track-record/" class="cta-link">Voir l'historique →</a>
        </p>
      </div>
      <a class="note-card" href="/fr/sports/wc2026/" style="text-decoration:none;color:inherit;">
        <p class="eyebrow">Tournoi international de football 2026</p>
        <h3>🇪🇸 Espagne — championne du monde 2026</h3>
        <p>Finale : Espagne 1–0 Argentine après prolongation · instantanés d’ouverture et d’avant-finale archivés.</p>
        <footer style="margin-top:1rem;">
          <span class="cta-link">Ouvrir l’archive du tournoi →</span>
        </footer>
      </a>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <PolymarketEmbed slug="world-cup-winner" title="Polymarket — Champion du Monde 2026" />
    </div>
  </section>

  <section class="content-band" style="padding:1.5rem 0;">
    <div class="container">
      <div class="note-card" style="opacity:.85;">
        <p class="eyebrow">LNH — saison 2025-26 terminée</p>
        <h3>{hero.favorite_label_fr} : champions de la Coupe Stanley 2026.</h3>
        <p>Finaliste : {hero.runner_up_label_fr}. Le desk et l'historique complet du modèle restent consultables — retour des instruments LNH au camp d'entraînement.</p>
        <p style="margin-top:0.75rem;"><a href="/fr/sports/nhl/" class="cta-link">Desk NHL →</a>&nbsp;·&nbsp;<a href="/fr/sports/track-record/" class="cta-link">Historique →</a></p>
      </div>
    </div>
  </section>

  <MarketCheck
    kicker="Pouls du marché sport"
    title="Le marché voit le même match. Le modèle voit le chemin."
    body="Les cotes Polymarket et Kalshi sur la Coupe du monde accompagnent le modèle comme repère indépendant. Là où ils convergent, le signal est fort. Là où ils divergent, c'est la story."
    modelLabel="Modèle Coupe"
    marketLabel="Pouls marché"
    note="Les données de marchés de prédiction sont affichées comme repère uniquement. Le modèle et le marché sont mis à jour selon des cadences indépendantes."
  />

  <MethodologyNote
    title="Deux desks sport. Un seul standard."
    body="Coupe du monde et LNH partagent le même pipeline Monte Carlo : les résultats sont simulés 50 000 fois par cycle, conditionnés aux résultats réels au fil du tournoi."
    bullets={[
      "Coupe du monde 2026 : 48 équipes, 50 000 simulations conditionnées aux résultats réels (classement FIFA, forme récente, avantage du terrain), mises à jour à chaque match jusqu'à la finale.",
      "NHL Cup Path: 50 000 simulations par ronde éliminatoire, mis à jour après chaque résultat de série. La couche volatilité des gardiens est conditionnée sur le taux d'arrêts récent et le statut des blessures.",
      "Le bilan est public: chaque cycle de modèle publié et chaque appel de série sont archivés et vérifiables.",
      "Les sorties du modèle sont disponibles en JSON public à chaque desk, mis à jour en continu.",
    ]}
  />
</EditorialLayout>
