---
import Base from '../../../layouts/Base.astro';
import LabsDesk from '../../../components/LabsDesk.astro';
import LabsPresidential from '../../../components/LabsPresidential.astro';
import { loadLabs, LABS_KEYS, SLUGS, NAMES, hasLabs, keyFromSlug, type LabsKey } from '../../../lib/labs';

export function getStaticPaths() {
  return LABS_KEYS.filter(hasLabs).map((k) => ({ params: { slug: SLUGS['fr'][k] } }));
}

const LOCALE = 'fr' as const;
const key = keyFromSlug(LOCALE, Astro.params.slug as string) as LabsKey;
const name = NAMES[key][LOCALE];
const url = `https://vote-scope.com/fr/labs/${SLUGS[LOCALE][key]}/`;
const desc = `{n} selon Orbite, le moteur quantique et relativiste de VoteScope Labs : sièges, majorité et chaque circonscription où il contredit notre projection de référence.`.replace('{n}', name);
---

<Base
  title={`${name} — Orbite · VoteScope Labs`}
  description={desc}
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: `https://vote-scope.com/en/labs/${SLUGS.en[key]}/`,
    fr: `https://vote-scope.com/fr/labs/${SLUGS.fr[key]}/`,
    es: `https://vote-scope.com/es/labs/${SLUGS.es[key]}/`,
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: `${name} — Orbite · VoteScope Labs`, url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: 'https://vote-scope.com/fr/labs/' },
      { '@type': 'ListItem', position: 3, name, item: url },
    ]},
  ]}
>
  {key === 'fr_pres_2027'
    ? <LabsPresidential locale={LOCALE} d={loadLabs(key)} />
    : <LabsDesk locale={LOCALE} labsKey={key} />}
</Base>
