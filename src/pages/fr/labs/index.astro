---
import Base from '../../../layouts/Base.astro';
import LabsHub from '../../../components/LabsHub.astro';

const LOCALE = 'fr' as const;
const url = 'https://vote-scope.com/fr/labs/';
---

<Base
  title="Orbite — le moteur quantique et relativiste de VoteScope Labs"
  description="Et si on prévoyait une élection avec la physique d’Einstein? Orbite, notre moteur expérimental à qubits, lit les mêmes sondages que notre projection de référence et se compare à elle au Québec, en Colombie-Britannique et aux États-Unis."
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: 'https://vote-scope.com/en/labs/',
    fr: 'https://vote-scope.com/fr/labs/',
    es: 'https://vote-scope.com/es/labs/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Orbite — le moteur quantique et relativiste de VoteScope Labs', url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: url },
    ]},
  ]}
>
  <LabsHub locale={LOCALE} />
</Base>
