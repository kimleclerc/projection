---
import Base from '../../../layouts/Base.astro';
import LabsHub from '../../../components/LabsHub.astro';

const LOCALE = 'fr' as const;
const url = 'https://vote-scope.com/fr/labs/';
---

<Base
  title="VoteScope Labs — le moteur de projection expérimental"
  description="Un second moteur de projection, construit de zéro : mêmes sondages, autre mécanique (géométrie courbe, mesures quantiques, sièges comptés sans tirage). Comparé à nos projections de référence."
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: 'https://vote-scope.com/en/labs/',
    fr: 'https://vote-scope.com/fr/labs/',
    es: 'https://vote-scope.com/es/labs/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'VoteScope Labs', url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: url },
    ]},
  ]}
>
  <LabsHub locale={LOCALE} />
</Base>
