---
import GameLayout from '../../../../layouts/GameLayout.astro';
import VibeMatch from '../../../../islands/VibeMatch';
import { vibeMatchParties, vibeMatchRidings, runDate, calibration } from '../../../../lib/vibe-match-data';

const canonical = 'https://vote-scope.com/fr/canada/quebec/match/';
const alternates = {
  fr: canonical,
  en: 'https://vote-scope.com/en/canada/quebec/match/',
  es: 'https://vote-scope.com/es/canada/quebec/match/',
};
---

<GameLayout
  title="Ton match électoral aujourd’hui — Vote-Scope"
  description="Glisse quelques cartes et découvre les partis québécois qui correspondent le mieux à ta vibe aujourd’hui."
  canonical={canonical}
  lang="fr"
  alternates={alternates}
>
  <VibeMatch
    client:load
    parties={vibeMatchParties('fr')}
    ridings={vibeMatchRidings('fr')}
    locale="fr"
    campaignVersion={runDate}
    calibration={calibration}
  />
</GameLayout>
