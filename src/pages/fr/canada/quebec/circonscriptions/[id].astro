---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../../components/riding/RidingPage.astro';
import { getAllQuebecRidings } from '../../../../../lib/riding-adapters/quebec';

export function getStaticPaths() {
  return getAllQuebecRidings().map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/fr/canada/quebec/circonscriptions/${data.slug}/`;
const alternateEn = `https://vote-scope.com/en/canada/quebec/ridings/${data.slug}/`;
const title = `${data.name.fr} — Projection provinciale (Québec) — Vote-Scope`;
const description = `Projection Vote-Scope pour ${data.name.fr} (Québec) : parts de voix, probabilité de victoire, député·e en fonction et candidats 2022.`;
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="fr"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: alternateEn, fr: canonical }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: data.name.fr,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Québec' },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada',     item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Québec',     item: 'https://vote-scope.com/fr/canada/quebec/' },
        { '@type': 'ListItem', position: 4, name: 'Circonscriptions', item: 'https://vote-scope.com/fr/canada/quebec/circonscriptions/' },
        { '@type': 'ListItem', position: 5, name: data.name.fr, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="fr" />
</EditorialLayout>
