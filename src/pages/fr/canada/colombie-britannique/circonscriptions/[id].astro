---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../../components/riding/RidingPage.astro';
import { getAllBcRidings } from '../../../../../lib/riding-adapters/bc';

export function getStaticPaths() {
  return getAllBcRidings().map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/fr/canada/colombie-britannique/circonscriptions/${data.slug}`;
const alternates = { en: `https://vote-scope.com/en/canada/british-columbia/ridings/${data.slug}`, fr: `https://vote-scope.com/fr/canada/colombie-britannique/circonscriptions/${data.slug}`, es: `https://vote-scope.com/es/canada/columbia-britanica/distritos/${data.slug}` };
const name = data.name.fr || data.name.en;
const title = `${name} — Projection provinciale (Colombie-Britannique) — Vote-Scope`;
const description = `Vote-Scope — ${name} : parts de voix, probabilité de victoire, député·e en poste et candidats de 2024.`;
---

<EditorialLayout
  searchIndex={false}
  title={title}
  description={description}
  canonical={canonical}
  lang="fr"
  currentPage="canada"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Colombie-Britannique' },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Colombie-Britannique', item: 'https://vote-scope.com/fr/canada/colombie-britannique/' },
        { '@type': 'ListItem', position: 4, name: 'Circonscriptions', item: 'https://vote-scope.com/fr/canada/colombie-britannique/circonscriptions/' },
        { '@type': 'ListItem', position: 5, name, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="fr" />
</EditorialLayout>
