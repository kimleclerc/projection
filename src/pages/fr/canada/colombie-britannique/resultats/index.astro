---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import BritishColumbiaElectionNight from '../../../../../components/BritishColumbiaElectionNight.astro';

const canonical = "https://vote-scope.com/fr/canada/colombie-britannique/resultats/";
const title = "Élections Colombie-Britannique 2026 : résultats en direct | Vote-Scope";
const description = "Résultats en direct de l’élection en Colombie-Britannique du 24 octobre 2026 : voix, sièges et gagnants dans les 93 circonscriptions dès 20 h heure du Pacifique, et les courses suspendues au dépouillement final.";
const eventName = "Élection générale de la Colombie-Britannique de 2026";
const ogImage = "https://vote-scope.com/og/share/map/british-columbia/fr.png";
const alternates = {
  fr: "https://vote-scope.com/fr/canada/colombie-britannique/resultats/",
  en: "https://vote-scope.com/en/canada/british-columbia/results/",
  es: "https://vote-scope.com/es/canada/columbia-britanica/resultados/",
};
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="fr"
  currentPage="canada"
  ogImage={ogImage}
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'fr',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
      about: {
        '@type': 'Event',
        name: eventName,
        description,
        image: [ogImage],
        startDate: '2026-10-24T20:00:00-07:00',
        endDate: '2026-10-25T02:00:00-07:00',
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@type': 'Place', name: "Colombie-Britannique", address: { '@type': 'PostalAddress', addressRegion: 'BC', addressCountry: 'CA' } },
        organizer: { '@type': 'GovernmentOrganization', name: 'Elections BC', url: 'https://elections.bc.ca/' },
        performer: [
          { '@type': 'PoliticalParty', name: 'BC NDP' },
          { '@type': 'PoliticalParty', name: 'Conservative Party of BC' },
          { '@type': 'PoliticalParty', name: 'BC Greens' },
        ],
        offers: { '@type': 'Offer', price: 0, priceCurrency: 'CAD', availability: 'https://schema.org/InStock', url: canonical, validFrom: '2026-10-20T00:00:00-07:00' },
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: "Colombie-Britannique", item: "https://vote-scope.com/fr/canada/colombie-britannique/" },
        { '@type': 'ListItem', position: 4, name: eventName, item: canonical },
      ],
    },
  ]}
>
  <BritishColumbiaElectionNight locale="fr" />
</EditorialLayout>
