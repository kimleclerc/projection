---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import { getAllFederalRidings } from '../../../../../lib/riding-adapters/federal';
import { partyMeta } from '../../../../../lib/riding-adapters/parties';

const PROVINCE_FR: Record<string, string> = {
  NL: 'Terre-Neuve-et-Labrador', PE: 'Île-du-Prince-Édouard', NS: 'Nouvelle-Écosse',
  NB: 'Nouveau-Brunswick', QC: 'Québec', ON: 'Ontario', MB: 'Manitoba', SK: 'Saskatchewan',
  AB: 'Alberta', BC: 'Colombie-Britannique', YT: 'Yukon', NT: 'Territoires du Nord-Ouest', NU: 'Nunavut',
};
const PROVINCE_ORDER = ['BC','AB','SK','MB','ON','QC','NB','NS','PE','NL','YT','NT','NU'];

const all = getAllFederalRidings();
const byProvince: Record<string, typeof all> = {};
for (const r of all) {
  const p = r.province ?? 'XX';
  (byProvince[p] ??= []).push(r);
}
for (const p of Object.keys(byProvince)) {
  byProvince[p].sort((a, b) => a.name.fr.localeCompare(b.name.fr, 'fr'));
}

const canonical = 'https://vote-scope.com/fr/canada/federal/circonscriptions/';
---

<EditorialLayout
  title="Circonscriptions fédérales — Vote-Scope"
  description="Toutes les 343 circonscriptions fédérales du Canada, projection Vote-Scope par parti, député·e en exercice et marges. Accès direct par province."
  canonical={canonical}
  lang="fr"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/canada/federal/ridings/', fr: canonical }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Circonscriptions fédérales',
      url: canonical,
      inLanguage: 'fr',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
    },
  ]}
>
  <section class="ridings-index-hero">
    <div class="container">
      <p class="eyebrow">Index par circonscription · fédéral</p>
      <h1>Les 343 circonscriptions, une par une.</h1>
      <p class="lede">Projection, député·e en exercice, candidats du dernier scrutin, démographie et trajectoire. Sélectionnez votre province pour parcourir, ou plongez dans une circonscription au hasard.</p>
    </div>
  </section>

  <section class="ridings-index">
    <div class="container">
      {PROVINCE_ORDER.filter((p) => byProvince[p]).map((p) => (
        <div class="prov-block">
          <h2 id={p.toLowerCase()}>{PROVINCE_FR[p]} <span class="count">{byProvince[p].length}</span></h2>
          <ul class="riding-list">
            {byProvince[p].map((r) => {
              const meta = partyMeta(r.jurisdiction, r.projection.winner);
              return (
                <li>
                  <a href={`/fr/canada/federal/circonscriptions/${r.slug}/`} style={`--accent:${meta.color}`}>
                    <span class="dot" aria-hidden="true"></span>
                    <span class="name">{r.name.fr}</span>
                    <span class="party">{meta.label_fr}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
</EditorialLayout>

<style>
  .ridings-index-hero {
    padding: 80px 0 32px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .ridings-index-hero h1 {
    margin: 8px 0 16px;
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1.02;
    max-width: 900px;
  }
  .ridings-index-hero .lede {
    max-width: 760px;
    font-family: var(--serif);
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .ridings-index { padding: 48px 0; background: var(--paper-2); }
  .prov-block { margin-bottom: 48px; }
  .prov-block h2 {
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  .prov-block .count {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-2);
    margin-left: 10px;
  }
  .riding-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .riding-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--card);
    text-decoration: none;
    color: inherit;
    transition: background .15s ease;
  }
  .riding-list a:hover {
    background: color-mix(in oklab, var(--accent) 12%, var(--card));
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
  .name { font-family: var(--serif); font-size: 15px; flex: 1; }
  .party {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
</style>
