---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ontarioMeta from '../../../../web_data/ontario/latest.json';

const j = jurisdictions.ontario;
const canonical = 'https://vote-scope.com/fr/canada/ontario/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/ontario/',
  fr: canonical,
  es: 'https://vote-scope.com/es/canada/ontario/',
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection Ontario 2026',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: ontarioMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/ontario/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Projection Ontario', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr" />
  <RidingsCta
    eyebrow="Partielles provinciales"
    title="Trois partielles ontariennes le 3 septembre"
    blurb="Hamilton-Est—Stoney Creek, Scarborough-Sud-Ouest et York—Simcoe. Deux sièges progressistes-conservateurs se défendent sans la personne qui les a gagnés — dont un dans la controverse des hôtels. Projections par course."
    href="/fr/canada/ontario/byelections/"
    cta="Voir les trois projections →"
  />
  <RidingsCta
    eyebrow="Profil par circonscription"
    title="Plonger dans une circonscription précise"
    blurb="Projection, député·e en fonction, candidats 2025, trajectoire des projections et circonscriptions voisines — pour chacune des 124 circonscriptions provinciales de l'Ontario."
    href="/fr/canada/ontario/circonscriptions/"
    cta="Parcourir les 124 circonscriptions →"
  />
  <NewsletterCta lang="fr" placement="ontario" />
</EditorialLayout>

