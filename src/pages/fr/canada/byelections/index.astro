---
import Base from '../../../../layouts/Base.astro';
import KeepDigging from '../../../../components/KeepDigging.astro';
import { canadaByelections } from '../../../../data/canadaByelections';

const byelections = Object.values(canadaByelections);
---

<Base
  title="Élections partielles Canada 2026 — Vote-Scope"
  description="Trois élections partielles fédérales, trois bons appels : Scarborough Southwest, Terrebonne et University—Rosedale, le 13 avril 2026. Consultez chaque desk et son résultat archivé."
  canonical="https://vote-scope.com/fr/canada/byelections/"
  lang="fr"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: 'https://vote-scope.com/en/canada/byelections/',
    fr: 'https://vote-scope.com/fr/canada/byelections/',
    es: 'https://vote-scope.com/es/canada/byelections/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Élections partielles Canada 2026', url: 'https://vote-scope.com/fr/canada/byelections/', inLanguage: 'fr' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
      { '@type': 'ListItem', position: 3, name: 'Élections partielles', item: 'https://vote-scope.com/fr/canada/byelections/' },
    ]},
  ]}
>
  <article class="byelections-hub-page">
    <header class="byelections-hub-hero container">
      <p class="byelections-hub-kicker">Bureau Canada · Élections partielles</p>
      <h1>Trois partielles, trois bons appels.</h1>
      <p class="byelections-hub-dek">
        Le 13 avril 2026, trois élections partielles fédérales ont eu lieu. VoteScope a appelé les trois correctement avant le jour du scrutin — un maintien libéral à Scarborough Southwest, un maintien libéral à University—Rosedale, et un gain libéral sur le Bloc à Terrebonne.
      </p>
    </header>

    <section class="byelections-hub-list container">
      {byelections.map((config) => (
        <a href={config.paths.fr!} class="byelection-card">
          <div class="byelection-card-meta">
            <span class="byelection-card-kicker">{config.kicker}</span>
          </div>
          <h2>{config.headline}</h2>
          <p>{config.dek}</p>
          <span class="byelection-card-cta">Voir la page →</span>
        </a>
      ))}
    </section>

    <div class="byelections-hub-keep-digging container">
      <KeepDigging
        eyebrow="Continuer à creuser"
        title="Plus du bureau Canada."
        body="Explorez la projection fédérale, les modèles provinciaux et le palmarès derrière ces appels."
        links={[
          {
            href: '/fr/canada/federal/',
            label: 'Projection fédérale Canada',
            detail: 'Modèle par circonscription · 343 sièges',
          },
          {
            href: '/fr/canada/',
            label: 'Bureau Canada',
            detail: 'Fédéral · Québec · Ontario',
          },
          {
            href: '/fr/track-record/',
            label: 'Historique des appels',
            detail: '6 appels résolus, 6 corrects',
          },
          {
            href: '/en/us/specials/ca1/',
            label: 'CA-1 Special Forecast',
            detail: '2 juin 2026 · Chambre américaine',
          },
        ]}
      />
    </div>
  </article>
</Base>

<style>
  .byelections-hub-page {
    padding-block: 64px 96px;
  }

  .byelections-hub-hero {
    max-width: 1080px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--rule);
  }

  .byelections-hub-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .byelections-hub-hero h1 {
    max-width: 750px;
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .byelections-hub-dek {
    max-width: 680px;
    margin: 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .byelections-hub-list {
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .byelection-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    padding: 24px;
    color: var(--ink);
    transition: border-color 0.15s;
  }

  .byelection-card:hover {
    border-color: var(--ink-3);
  }

  .byelection-card-kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .byelection-card h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 420;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .byelection-card p {
    flex: 1;
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .byelection-card-cta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .byelections-hub-keep-digging {
    max-width: 1080px;
    margin-top: 64px;
  }

  @media (max-width: 820px) {
    .byelections-hub-list {
      grid-template-columns: 1fr;
    }
  }
</style>
