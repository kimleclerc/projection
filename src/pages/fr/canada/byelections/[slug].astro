---
// Une seule route sert les deux familles : les partielles résolues (archives)
// et les partielles en attente (desk de projection).
import CanadaByelectionEngine from '../../../../components/CanadaByelectionEngine.astro';
import CanadaByelectionRaceDesk from '../../../../components/CanadaByelectionRaceDesk.astro';
import { canadaByelections } from '../../../../data/canadaByelections';
import { canadaByelectionRaces } from '../../../../data/canadaByelectionRaces';

export function getStaticPaths() {
  const resolved = Object.values(canadaByelections)
    .filter((config) => config.paths.fr)
    .map((config) => ({ params: { slug: config.slug }, props: { config, pending: false } }));
  const pending = Object.values(canadaByelectionRaces)
    .map((config) => ({ params: { slug: config.slug }, props: { config, pending: true } }));
  return [...resolved, ...pending];
}

const { config, pending } = Astro.props;
---

{pending
  ? <CanadaByelectionRaceDesk lang="fr" config={config as any} />
  : <CanadaByelectionEngine lang="fr" config={config as any} />}
