---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import federalMeta from '../../../../web_data/federal/latest.json';

const j = jurisdictions.federal;
const canonical = 'https://vote-scope.com/fr/canada/federal';
const alternates = {
  en: 'https://vote-scope.com/en/canada/federal',
  fr: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection fédérale Canada 2025',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: federalMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/federal/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Projection fédérale', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <!-- TODO: when Federal Canada Polymarket emerges, set slug here -->
    <PolymarketEmbed slug={null} />
  </div>
</EditorialLayout>
