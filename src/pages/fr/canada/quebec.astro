---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import quebecMeta from '../../../../web_data/quebec/latest.json';

const j = jurisdictions.quebec;
const canonical = 'https://vote-scope.com/fr/canada/quebec';
const alternates = {
  en: 'https://vote-scope.com/en/canada/quebec',
  fr: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Projection Québec 2026',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: quebecMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/quebec/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Projection Québec', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="fr" />
  <section class="ridings-cta">
    <div class="container">
      <p class="eyebrow">Profil par circonscription</p>
      <h2>Plonger dans une circonscription précise</h2>
      <p>Projection, député·e en fonction, candidats 2022, trajectoire des projections et circonscriptions voisines — pour chacune des 125 circonscriptions provinciales sur la carte 2026.</p>
      <a href="/fr/canada/quebec/circonscriptions/" class="cta-btn">Parcourir les 125 circonscriptions →</a>
    </div>
  </section>
</EditorialLayout>

<style>
  .ridings-cta { padding: 56px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--paper-2); }
  .ridings-cta h2 { margin: 8px 0 12px; font-family: var(--serif); font-size: clamp(28px,3.2vw,40px); font-weight: 420; letter-spacing: -0.01em; }
  .ridings-cta p { max-width: 720px; color: var(--ink-2); margin: 0 0 20px; line-height: 1.55; }
  .cta-btn { display: inline-block; padding: 12px 22px; background: var(--ink); color: var(--paper); text-decoration: none; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .cta-btn:hover { background: color-mix(in oklab, var(--ink) 80%, transparent); }
</style>
