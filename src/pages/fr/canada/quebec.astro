---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import quebecMeta from '../../../../web_data/quebec/latest.json';
import advanceVote from '../../../../web_data/quebec/advance_vote.json';
const nfFr = (x: number) => x.toLocaleString('fr-CA', { maximumFractionDigits: 1 });

const j = jurisdictions.quebec;
const canonical = 'https://vote-scope.com/fr/canada/quebec/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/quebec/',
  fr: canonical,
  es: 'https://vote-scope.com/es/canada/quebec/',
};
---

<EditorialLayout
  title={j.pageTitle.fr}
  description={j.metaDescription.fr}
  canonical={canonical}
  lang="fr"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/projections/quebec/fr.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Élections Québec 2026 : résultats et projection',
      description: j.metaDescription.fr,
      url: canonical,
      dateModified: quebecMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/fr/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/quebec/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/fr/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Projection Québec', item: canonical },
      ],
    },
  ]}
>
  <RidingsCta
    eyebrow="Résultats du 5 octobre"
    title="Le PQ forme un gouvernement minoritaire"
    blurb="Qui a gagné chez vous? Les gagnants des 127 circonscriptions, les sièges et le vote populaire, et l’écart avec notre projection."
    href="/fr/canada/quebec/resultats/"
    cta="Voir les résultats"
  />
  <ProjectionEngine jurisdiction={j} locale="fr" />
  <RidingsCta
    eyebrow="Vote par anticipation"
    title={`Environ ${advanceVote.meta.provincial.advance_share_est_pct} % des votes déjà dans l'urne`}
    blurb={`${nfFr(advanceVote.meta.provincial.advance_turnout_pct)} % des électeurs inscrits ont voté par anticipation les 27 et 28 septembre. Le taux de chacune des 127 circonscriptions, sur la carte et par région.`}
    href="/fr/canada/quebec/vote-par-anticipation/"
    cta="Voir la participation par circonscription"
  />
  <RidingsCta
    eyebrow="Le simulateur"
    title="Et si le Québec votait autrement?"
    blurb="Faites bouger le vote sur une page dédiée et regardez les sièges, la carte et les 127 circonscriptions réagir — sans confondre votre scénario avec notre projection."
    href="/fr/outils/simulateur-quebec"
    cta="Ouvrir le simulateur"
  />
  <RidingsCta
    eyebrow="Profil par circonscription"
    title="Plonger dans une circonscription précise"
    blurb="Projection, député·e en fonction, candidats 2022, trajectoire des projections et circonscriptions voisines — pour chacune des 127 circonscriptions provinciales sur la carte 2026."
    href="/fr/canada/quebec/circonscriptions/"
    cta="Parcourir les 127 circonscriptions"
  />
  <RidingsCta
    eyebrow="Baromètre des candidatures"
    title="Genre et accès aux comtés gagnables"
    blurb="La course aux 127 candidatures, parti par parti — et si chaque parti confie à ses candidates les comtés où il est réellement compétitif. Calibré sur 2018 et 2022."
    href="/fr/canada/quebec/barometre-candidatures/"
    cta="Ouvrir le Baromètre des candidatures"
  />
  <NewsletterCta lang="fr" placement="quebec" />
</EditorialLayout>
