---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import AboutVoteScope from '../../components/AboutVoteScope.astro';

const canonical = 'https://vote-scope.com/fr/a-propos/';
const alternates = {
  en: 'https://vote-scope.com/en/about/',
  fr: canonical,
  es: 'https://vote-scope.com/es/acerca-de/',
};
const subjectOf = [
  { '@type': 'Article', name: 'Lancement du modèle de projections électorales Vote-Scope', url: 'https://pilulerouge.ca/projections-electorales-kim-leclerc-lance-un-nouveau-site-pour-decoder-la-carte-politique/', datePublished: '2026-04-23' },
  { '@type': 'VideoObject', name: 'Gouvernance et gestion de crise chez Air Canada', url: 'https://www.cbc.ca/player/play/video/9.7143764' },
  { '@type': 'VideoObject', name: 'Débats politiques et préparation des chefs', url: 'https://www.cbc.ca/player/play/video/9.6999303' },
  { '@type': 'Article', name: 'Coûts du F-35 et solutions de remplacement pour les pays alliés', url: 'https://www.aa.com.tr/en/americas/experts-believe-countries-could-seek-alternatives-amid-rising-costs-of-us-made-f-35-fighter-jets/3621045', datePublished: '2025-07-03' },
];
---

<EditorialLayout
  title="À propos de Vote-Scope — Projections électorales indépendantes"
  description="Qui crée Vote-Scope, comment évaluer ses projections indépendantes et une sélection d’entrevues médiatiques de Kim Leclerc."
  canonical={canonical}
  lang="fr"
  currentPage="about"
  alternates={alternates}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'À propos de Vote-Scope', url: canonical, inLanguage: 'fr-CA', mainEntity: { '@id': 'https://vote-scope.com/#organization' } },
    { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://vote-scope.com/#organization', name: 'Vote-Scope', url: 'https://vote-scope.com/', logo: 'https://vote-scope.com/favicon.svg', founder: { '@id': 'https://vote-scope.com/#kim-leclerc' } },
    { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://vote-scope.com/#kim-leclerc', name: 'Kim Leclerc', url: 'https://kimleclerc.ca', sameAs: ['https://x.com/kimleclerc'], knowsAbout: ['Projections électorales', 'Sondages', 'Modélisation bayésienne', 'Analyse politique', 'Approvisionnement de défense'], subjectOf },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/fr/' },
      { '@type': 'ListItem', position: 2, name: 'À propos', item: canonical },
    ]},
  ]}
>
  <AboutVoteScope lang="fr" />
</EditorialLayout>
