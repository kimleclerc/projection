---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import HomeFront from '../../components/HomeFront.astro';
import StoryList from '../../components/StoryList.astro';
import DeskSections from '../../components/DeskSections.astro';
import MethodologyNote from '../../components/MethodologyNote.astro';
import SearchFastPath from '../../components/SearchFastPath.astro';
import AuthorStrip from '../../components/AuthorStrip.astro';
import LabsHomeBand from '../../components/LabsHomeBand.astro';
import { editorialPhilosophy, instruments } from '../../data/editorial';

const philosophy = editorialPhilosophy.en;
// Une de journal (docs/DESIGN.md §7) : la course principale en grand, les autres
// élections en colonne, puis la signature, la recherche, les desks et les indices.
const indexItems = instruments.en.filter((i) => i.status === 'live').slice(0, 6).map((i) => ({
  meta: i.cadence,
  title: i.name,
  text: i.question,
  href: i.href,
}));
---

<EditorialLayout
  title="Vote-Scope — Election forecasts: U.S. midterms, Canada and Europe"
  description="Independent election forecasts for the 2026 U.S. midterms, Canada, the U.K., France and Spain: Senate, House and governor odds, polls and seat projections, updated daily. By Kim Leclerc."
  canonical="https://vote-scope.com/en/"
  lang="en"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/', fr: 'https://vote-scope.com/fr/', es: 'https://vote-scope.com/es/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      inLanguage: 'en',
      description: philosophy.position,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      logo: 'https://vote-scope.com/favicon.svg',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
      ],
    },
  ]}
>
  <HomeFront lang="en" />

  <AuthorStrip lang="en" />

  <SearchFastPath lang="en" />

  <DeskSections lang="en" />

  <section class="content-band">
    <div class="container">
      <StoryList heading="Indexes we track" items={indexItems} columns={2} />
    </div>
  </section>

  <LabsHomeBand lang="en" />

  <MethodologyNote
    title="How the projections are built."
    body={philosophy.proof}
    bullets={[
      'Most of our projections aggregate public polls in a Bayesian BSTS model — house effects measured and corrected, accuracy calibrated on past elections. Simulation only translates it all into seats.',
      'Prediction-market data (Polymarket) sits beside the model as a disagreement detector, not a substitute.',
      'Riding and constituency probabilities are conditioned on national and regional swings, then re-aggregated to seat distributions.',
      'Source data, methodology notes, and model outputs are public at each desk. Updated on a rolling basis as new polls arrive.',
    ]}
  />
</EditorialLayout>
