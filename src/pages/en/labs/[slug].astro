---
import Base from '../../../layouts/Base.astro';
import LabsDesk from '../../../components/LabsDesk.astro';
import { LABS_KEYS, SLUGS, NAMES, hasLabs, keyFromSlug, type LabsKey } from '../../../lib/labs';

export function getStaticPaths() {
  return LABS_KEYS.filter(hasLabs).map((k) => ({ params: { slug: SLUGS['en'][k] } }));
}

const LOCALE = 'en' as const;
const key = keyFromSlug(LOCALE, Astro.params.slug as string) as LabsKey;
const name = NAMES[key][LOCALE];
const url = `https://vote-scope.com/en/labs/${SLUGS[LOCALE][key]}/`;
const desc = `{n} according to Orbit, the quantum and relativistic engine of VoteScope Labs: seats, majority odds and every riding where it contradicts our reference forecast.`.replace('{n}', name);
---

<Base
  title={`${name} — Orbit · VoteScope Labs`}
  description={desc}
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: `https://vote-scope.com/en/labs/${SLUGS.en[key]}/`,
    fr: `https://vote-scope.com/fr/labs/${SLUGS.fr[key]}/`,
    es: `https://vote-scope.com/es/labs/${SLUGS.es[key]}/`,
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: `${name} — Orbit · VoteScope Labs`, url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: 'https://vote-scope.com/en/labs/' },
      { '@type': 'ListItem', position: 3, name, item: url },
    ]},
  ]}
>
  <LabsDesk locale={LOCALE} labsKey={key} />
</Base>
