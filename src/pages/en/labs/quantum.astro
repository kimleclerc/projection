---
import Base from '../../../layouts/Base.astro';
import LabsQuantumHub from '../../../components/LabsQuantumHub.astro';

const LOCALE = 'en' as const;
const title = 'Our elections, drawn on a quantum computer — Vote-Scope Labs';
const description = 'Quebec, the US Senate and the US House drawn on 156-qubit IBM chips by Orbit, our experimental model: machine, date, machine time and gap to the exact calculation.';
const url = 'https://vote-scope.com/en/labs/quantum/';
---

<Base
  title={title}
  description={description}
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: 'https://vote-scope.com/en/labs/quantum/',
    fr: 'https://vote-scope.com/fr/labs/quantique/',
    es: 'https://vote-scope.com/es/labs/cuantico/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, url, inLanguage: LOCALE,
       author: { '@type': 'Organization', name: 'Vote-Scope' }, publisher: { '@type': 'Organization', name: 'Vote-Scope' } },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: 'https://vote-scope.com/en/labs/' },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ]},
  ]}
>
  <LabsQuantumHub locale={LOCALE} />
</Base>
