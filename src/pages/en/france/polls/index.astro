---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FrancePollsPage from '../../../../components/FrancePollsPage.astro';
import polls from '../../../../../web_data/france-presidential/polls.json';

const meta = (polls as any).meta;
const lastPoll = meta.last_release_date
  ? new Date(meta.last_release_date + 'T12:00:00Z').toLocaleDateString('en-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
const canonical = 'https://vote-scope.com/en/france/polls/';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/france/sondages/',
  es: 'https://vote-scope.com/es/france/sondeos/',
};
---

<EditorialLayout
  title={lastPoll
    ? `France 2027 Presidential Polls — Standing as of ${lastPoll}`
    : 'France 2027 Presidential Polls — Latest Standing'}
  description={`Who leads the 2027 French presidential race? ${meta.n_first_round_polls} first-round polls and ${meta.n_runoff_polls} runoff match-ups${meta.n_firms ? ` from ${meta.n_firms} pollsters` : ''}${lastPoll ? `, current to ${lastPoll}` : ''}. Weighted average plus every poll.`}
  canonical={canonical}
  lang="en"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'France 2027 presidential polls',
    description: 'Compilation of first-round and runoff polls for the 2027 French presidential election.',
    url: canonical,
    dateModified: meta.generated_at,
    creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    license: 'https://vote-scope.com/en/terms/',
    isAccessibleForFree: true,
  }]}
>
  <FrancePollsPage locale="en" />
</EditorialLayout>
