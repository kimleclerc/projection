---
import Base from '../../../layouts/Base.astro';
import KeepDigging from '../../../components/KeepDigging.astro';
---

<Base
  title="France — Coming Soon — Vote-Scope"
  description="The Vote-Scope France desk is being rebuilt for the 2027 presidential election. Explore live instruments in the meantime — Vote-Scope."
  canonical="https://vote-scope.com/en/france/"
  lang="en"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: 'https://vote-scope.com/en/france/',
    fr: 'https://vote-scope.com/fr/france/',
  }}
  noindex={true}
>
  <article class="france-page">
    <header class="france-hero container">
      <p class="france-kicker">Coming soon · Présidentielle 2027</p>
      <h1>France is being rebuilt.</h1>
      <p class="france-dek">
        We're rebuilding France projection on the modern Astro stack with the same visual language as our other instruments. In the meantime, explore the <a href="/en/us/indexes/lame-duck/">Lame-Duck Index</a>, <a href="/en/canada/federal/">Canada Federal</a>, or <a href="/en/uk/">U.K. General Election</a>.
      </p>
    </header>

    <div class="france-keep-digging container">
      <KeepDigging
        eyebrow="While you wait"
        title="Explore our live instruments."
        body="France projection returns before the 2027 Présidentielle. In the meantime, every other desk is live."
        links={[
          {
            href: '/en/us/indexes/lame-duck/',
            label: 'Lame-Duck Index',
            detail: 'U.S. pre-election pressure · Live',
          },
          {
            href: '/en/canada/federal/',
            label: 'Canada Federal',
            detail: 'Riding-level model · 343 ridings',
          },
          {
            href: '/en/uk/',
            label: 'U.K. General Election',
            detail: 'Westminster seat projection',
          },
          {
            href: '/en/',
            label: 'All Desks',
            detail: 'Every instrument on one page',
          },
        ]}
      />
    </div>
  </article>
</Base>

<style>
  .france-page {
    padding-block: 64px 96px;
  }

  .france-hero {
    max-width: 1080px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--rule);
  }

  .france-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .france-hero h1 {
    max-width: 700px;
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .france-dek {
    max-width: 680px;
    margin: 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .france-dek a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }

  .france-dek a:hover {
    text-decoration-color: var(--ink);
  }

  .france-keep-digging {
    max-width: 1080px;
    margin-top: 64px;
  }
</style>
