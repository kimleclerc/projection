---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FranceCandidatePage from '../../../../components/FranceCandidatePage.astro';
import { getAllCandidates, slugify } from '../../../../lib/fr-candidates';
import { blocLabel, statusLabel } from '../../../../lib/fr-pres';
import latest from '../../../../../web_data/france-presidential/latest.json';

export function getStaticPaths() {
  return getAllCandidates().map((candidate) => ({
    params: { id: candidate.slug },
    props: { candidate },
  }));
}

const { candidate } = Astro.props;
const meta = (latest as any).meta;
const canonical = `https://vote-scope.com/en/france/candidates/${candidate.slug}/`;
const desc = `${candidate.name} — 2027 French presidential election: ${statusLabel(candidate.status, 'en').toLowerCase()}, ${blocLabel(candidate.bloc, 'en')}. First-round voting intention and runoff matchups across ${candidate.activeScenarios} lineups. Run of ${meta.run_date}.`;
---

<EditorialLayout
  title={`${candidate.name} — 2027 French Presidential — Vote-Scope`}
  description={desc}
  canonical={canonical}
  lang="en"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: canonical,
    fr: `https://vote-scope.com/fr/france/candidats/${slugify(candidate.name)}/`,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: candidate.name,
      url: canonical,
      description: `Candidate in the 2027 French presidential election (${blocLabel(candidate.bloc, 'en')}).`,
    },
  ]}
>
  <FranceCandidatePage candidate={candidate} locale="en" />
</EditorialLayout>
