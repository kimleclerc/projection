---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
---

<EditorialLayout
  title="U.K. Politics — Vote-Scope"
  description="Projects the British general election constituency by constituency. Compares polling signals and decodes which marginals the market is misreading — Vote-Scope."
  canonical="https://vote-scope.com/en/uk/"
  lang="en"
  currentPage="uk"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/uk/', fr: 'https://vote-scope.com/fr/uk/', es: 'https://vote-scope.com/es/uk/'  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'U.K. Politics — Vote-Scope',
      url: 'https://vote-scope.com/en/uk/',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.K.', item: 'https://vote-scope.com/en/uk/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="U.K. Desk"
    title="Where is the British map genuinely settled, and where is it quietly fragile?"
    promise="Constituency projections from aggregated polls and Monte Carlo simulations — every seat, updated as new polls land."
    question="Which seats are safe, which are marginals hiding as safe, and what does the model say the market is missing?"
    primaryHref="/en/uk/general-election/"
    primaryLabel="Open projection"
    secondaryHref="/en/indexes/"
    secondaryLabel="All indexes"
  />

  <section class="content-band">
    <div class="container content-grid-2">
      <a class="note-card" href="/en/uk/general-election/" style="text-decoration:none;color:inherit;">
        <p class="eyebrow">General election projection</p>
        <h3>U.K. General Election</h3>
        <p>650-seat projection. Bayesian poll aggregation, 50,000 Monte Carlo simulations, riding-level probabilities and composition chart.</p>
        <footer style="margin-top:1rem;">
          <span class="cta-link">Open projection →</span>
        </footer>
      </a>
      <a class="note-card" href="/en/uk/constituencies/" style="text-decoration:none;color:inherit;">
        <p class="eyebrow">Constituency profiles</p>
        <h3>650 Westminster constituencies</h3>
        <p>A page for every seat: projection, sitting MP, 2024 candidates, ONS demographics, and neighbouring constituencies. Northern Ireland seats keep their party identity (DUP, Sinn Féin, SDLP, Alliance, UUP, TUV).</p>
        <footer style="margin-top:1rem;">
          <span class="cta-link">Explore all 650 constituencies →</span>
        </footer>
      </a>
    </div>
  </section>

  <MethodologyNote
    title="Built for depth, down to the marginal seat."
    body="The British electoral map rewards granularity: tactical voting, regional swings, and third-party dynamics all shift individual seats in ways national polls can't predict. Vote-Scope projects every seat, so you can see exactly where the contest lives."
    bullets={[
      'Polling aggregation uses a Bayesian BSTS model with region-level adjustments.',
      '50,000 Monte Carlo simulations produce seat distributions and win probabilities.',
      'Every one of the 650 constituencies has its own page: projection, sitting MP, and 2024 result.',
      'By-elections are tracked separately as live race desks when data is available.',
    ]}
  />
</EditorialLayout>
