---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ukMeta from '../../../../web_data/uk/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.uk;
const canonical = 'https://vote-scope.com/en/uk/general-election/';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/uk/general-election/',
  es: 'https://vote-scope.com/es/uk/general-election/',
};
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/projections/uk/en.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'U.K. General Election Projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: ukMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/uk/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.K.', item: 'https://vote-scope.com/en/uk/' },
        { '@type': 'ListItem', position: 3, name: 'General Election Projection', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en"><Fragment slot="narrative"><RaceNarrative locale="en" {...raceEditorial.uk.en} /></Fragment></ProjectionEngine>
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <!-- TODO: when UK general-election Polymarket emerges, set slug here -->
    <PolymarketEmbed slug={null} />
  </div>

  <RidingsCta
    eyebrow="Constituency profile"
    title="Dive into a specific constituency"
    blurb={'Projection, sitting MP, 2024 candidates and nearby seats — for each of the 650 Westminster constituencies. Northern Ireland seats keep their party identity (DUP, Sinn Féin, SDLP, Alliance, UUP, TUV) even where the projection model uses an "other" bucket.'}
    href="/en/uk/constituencies/"
    cta="Browse all 650 constituencies →"
  />
  <NewsletterCta lang="en" placement="general-election" />
</EditorialLayout>
