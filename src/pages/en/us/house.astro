---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import houseMeta from '../../../../web_data/us-house/latest.json';

const j = jurisdictions.usHouse;
const canonical = 'https://vote-scope.com/en/us/house';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/us/chambre',
};
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'U.S. House 2026 Projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: houseMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-house/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'House Projection', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-house-after-the-2026-midterm-elections" title="House 2026 — party control" />
  </div>
</EditorialLayout>
