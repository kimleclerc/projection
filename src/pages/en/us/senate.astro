---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import senateMeta from '../../../../web_data/us-senate/latest.json';

const j = jurisdictions.usSenate;
const canonical = 'https://vote-scope.com/en/us/senate';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/us/senat',
};
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'U.S. Senate 2026 Projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: senateMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-senate/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'Senate Projection', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections" title="Senate 2026 — party control" />
  </div>

  <RidingsCta
    eyebrow="Seat profile"
    title="Dive into a specific Senate race"
    blurb="Projection, baseline result, race rating, nearby competitive seats — for each of the 35 contested 2026 Senate races (33 regular Class III + 2 specials)."
    href="/en/us/senate/seats/"
    cta="Browse all 35 races →"
  />
</EditorialLayout>

