---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/en/us/president/early-states/';
const alternates = { en: 'https://vote-scope.com/en/us/president/early-states/', fr: 'https://vote-scope.com/fr/us/presidentielle/premiers-etats/', es: 'https://vote-scope.com/es/us/presidencial/primeros-estados/' };
---

<EditorialLayout
  title="2028 Primary Polls in Iowa, New Hampshire, South Carolina and Nevada | Vote-Scope"
  description="State polling averages for the first 2028 presidential primaries, Democratic and Republican: Iowa, New Hampshire, South Carolina and Nevada, with the number of polls behind each."
  canonical={canonical}
  lang="en"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: '2028 Primary Polls in Iowa, New Hampshire, South Carolina and Nevada',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'President', item: 'https://vote-scope.com/en/us/president/' },
        { '@type': 'ListItem', position: 4, name: 'Early states', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="en" view="early" />
</EditorialLayout>
