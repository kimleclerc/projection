---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const block = (latest as any).primary.rep;
const elig = block.standings.filter((s: any) => s.status !== 'ineligible');
const [lead, second, third] = elig;
const pct = (s: any) => `${s.share.toFixed(1)}%`;
const canonical = 'https://vote-scope.com/en/us/president/republican-primary/';
const alternates = { en: 'https://vote-scope.com/en/us/president/republican-primary/', fr: 'https://vote-scope.com/fr/us/presidentielle/primaire-republicaine/', es: 'https://vote-scope.com/es/us/presidencial/primaria-republicana/' };
---

<EditorialLayout
  title="2028 Republican Primary Polls: Who Leads the Field? | Vote-Scope"
  description={`2028 Republican primary polling average: ${lead.name} leads at ${pct(lead)}, ahead of ${second.name} and ${third.name}${third.name.endsWith('.') ? '' : '.'} Every candidate tested, field scenarios and the early states.`}
  canonical={canonical}
  lang="en"
  currentPage="us"
  ogImage={`https://vote-scope.com/og/share/projection/us-president-rep/en.png?v=${meta.run_date}`}
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: '2028 Republican Primary Polls: Who Leads the Field?',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'President', item: 'https://vote-scope.com/en/us/president/' },
        { '@type': 'ListItem', position: 4, name: 'Republican primary', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="en" view="rep" />
</EditorialLayout>
