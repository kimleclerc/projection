---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsPresidentDesk from '../../../components/UsPresidentDesk.astro';
import latest from '../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const demLead = (latest as any).primary.dem.standings.find((candidate: { status: string }) => candidate.status !== "ineligible") ?? (latest as any).primary.dem.standings[0];
const repLead = (latest as any).primary.rep.standings.find((candidate: { status: string }) => candidate.status !== "ineligible") ?? (latest as any).primary.rep.standings[0];
const demLeadName = demLead.name;
const repLeadName = repLead.name;
const demLeadShare = demLead.share.toFixed(1);
const repLeadShare = repLead.share.toFixed(1);
const canonical = 'https://vote-scope.com/en/us/president/';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/us/presidentielle/',
  es: 'https://vote-scope.com/es/us/presidencial/',
};
---

<EditorialLayout
  title="2028 Presidential Primary Polls: Democratic and Republican Averages | Vote-Scope"
  description={`2028 Democratic and Republican primary polling averages: ${repLeadName} leads Republicans (${repLeadShare}%) and ${demLeadName} leads Democrats (${demLeadShare}%). Who is running, the debate calendar and the electoral map.`}
  canonical={canonical}
  lang="en"
  currentPage="us"
  ogImage="https://vote-scope.com/og/share/projection/us-president/en.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: '2028 U.S. Presidential — Invisible Primary',
      description: 'Quality-weighted aggregate of 2028 presidential primary polls plus the electoral-college framework.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'President', item: canonical },
      ],
    },
  ]}
>
  <UsPresidentDesk locale="en" />
</EditorialLayout>
