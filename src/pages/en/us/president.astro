---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsPresidentDesk from '../../../components/UsPresidentDesk.astro';
import latest from '../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/en/us/president';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/us/presidentielle',
  es: 'https://vote-scope.com/es/us/presidencial',
};
---

<EditorialLayout
  title="2028 U.S. Presidential — Invisible Primary & Electoral College — Vote-Scope"
  description={`Quality-weighted aggregate of the 2028 U.S. presidential primary polls (DEM & REP), field scenarios, early states, and the electoral-college map. ${meta.n_primary_polls} polls, run of ${meta.run_date}.`}
  canonical={canonical}
  lang="en"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: '2028 U.S. Presidential — Invisible Primary',
      description: 'Quality-weighted aggregate of 2028 presidential primary polls plus the electoral-college framework.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'U.S.', item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: 'President', item: canonical },
      ],
    },
  ]}
>
  <UsPresidentDesk locale="en" />
</EditorialLayout>
