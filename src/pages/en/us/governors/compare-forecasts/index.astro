---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import ForecasterComparison from '../../../../../components/ForecasterComparison.astro';
import NewsletterCta from '../../../../../components/NewsletterCta.astro';

const canonical = "https://vote-scope.com/en/us/governors/compare-forecasts/";
const pageName = "2026 Governor Forecast Comparison";
---

<EditorialLayout
  title={"2026 Governor Forecast Comparison: Vote-Scope vs Other Models — Vote-Scope"}
  description={"Every 2026 governor forecast in one place: the Vote-Scope model, live Kalshi prices, plus Cook, Sabato, Inside Elections, DDHQ, Split Ticket and more, each linked to its source."}
  canonical={canonical}
  lang="en"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: "https://vote-scope.com/en/us/governors/compare-forecasts/", fr: "https://vote-scope.com/fr/us/gouverneurs/comparer-les-previsions/", es: "https://vote-scope.com/es/us/gobernadores/comparar-pronosticos/" }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: "U.S.", item: 'https://vote-scope.com/en/us/' },
        { '@type': 'ListItem', position: 3, name: pageName, item: canonical },
      ],
    },
  ]}
>
  <ForecasterComparison locale="en" jurisdiction="governor" />
  <NewsletterCta lang="en" placement="compare-governors" />
</EditorialLayout>
