---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import KeepDigging from '../../components/KeepDigging.astro';
import AnimatedNumber from '../../islands/AnimatedNumber.tsx';

const dataPath = resolve(process.cwd(), 'web_data', 'track-record', 'predictions.json');
const data = JSON.parse(readFileSync(dataPath, 'utf-8'));

interface Prediction {
  flag: string; title_en: string; subtitle_en: string; date: string;
  confidence: number; call_en: string; result_en: string; correct: boolean;
  status: string; markets: Array<{ volume_usd: number }>;
}
interface UpcomingItem { flag: string; title_en: string; date: string; }

const meta = data.meta;
const predictions: Prediction[] = data.predictions;
const upcoming: UpcomingItem[] = data.upcoming;

function fmtCurrency(n: number) {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(2)}M`;
  if (n >= 1_000) return `$${Math.round(n / 1_000)}K`;
  return `$${n.toLocaleString('en-CA')}`;
}

function fmtDate(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Base
  title="Track Record — Vote-Scope"
  description="Every Vote-Scope prediction, tracked and verified: calls made, results confirmed, and prediction-market volume behind each one. Transparency over trust."
  canonical="https://vote-scope.com/en/track-record/"
  lang="en"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: 'https://vote-scope.com/en/track-record/',
    fr: 'https://vote-scope.com/fr/track-record/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Track Record — Vote-Scope', url: 'https://vote-scope.com/en/track-record/', inLanguage: 'en' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'Track Record', item: 'https://vote-scope.com/en/track-record/' },
    ]},
  ]}
>
  <article class="track-page">
    <header class="track-hero container">
      <p class="track-kicker">Verified predictions · Updated {fmtDate(meta.last_updated)}</p>
      <h1>Every call.<br />Every result.</h1>
      <p class="track-dek">
        {meta.note_en}
      </p>
    </header>

    <section class="track-stats container" aria-label="Prediction scoreboard">
      <div class="track-stat-card">
        <p class="track-stat-label">Scoreboard</p>
        <strong class="track-stat-value">
          <AnimatedNumber value={meta.correct} client:visible /> / {meta.resolved}
        </strong>
        <span class="track-stat-note">out of {meta.resolved} resolved calls</span>
      </div>
      <div class="track-stat-card track-stat-card--gold">
        <p class="track-stat-label">Accuracy rate</p>
        <strong class="track-stat-value track-stat-value--gold">
          <AnimatedNumber value={Math.round(meta.accuracy_rate * 100)} suffix="%" client:visible />
        </strong>
        <span class="track-stat-note">Based on resolved predictions only</span>
      </div>
      <div class="track-stat-card">
        <p class="track-stat-label">Net validated market volume</p>
        <strong class="track-stat-value">
          <AnimatedNumber value={meta.net_market_volume_usd} format="thousands" prefix="$" client:visible />
        </strong>
        <span class="track-stat-note">Correct-call volume minus any future miss volume</span>
      </div>
    </section>

    <section class="track-resolved container" aria-labelledby="track-resolved-title">
      <p class="track-section-label" id="track-resolved-title">Resolved predictions</p>
      <div class="track-pred-list">
        {predictions.map((pred, i) => {
          const totalVol = pred.markets.reduce((sum, m) => sum + m.volume_usd, 0);
          const resultClass = pred.correct ? 'track-pred-correct' : 'track-pred-miss';
          const resultPrefix = pred.correct ? '✓ ' : '✗ ';
          const isResolvedCorrect = pred.status === 'resolved' && pred.correct;
          const isPending = pred.status === 'pending';
          const isResolvedMiss = pred.status === 'resolved' && !pred.correct;
          return (
            <article class="track-pred-row">
              <div class="track-pred-num">{i + 1}</div>
              <div class="track-pred-info">
                <strong>{pred.flag} {pred.title_en}</strong>
                <span>{pred.subtitle_en} · {fmtDate(pred.date)}</span>
              </div>
              <div class="track-pred-conf">
                <strong>{pred.confidence.toFixed(1)}%</strong>
                <span>confidence</span>
              </div>
              <div class="track-pred-call">
                <span class="track-pred-label">Our call</span>
                <strong>{pred.call_en}</strong>
              </div>
              <div class="track-pred-result">
                <strong class={resultClass}>{resultPrefix}{pred.result_en}</strong>
              </div>
              <div class="track-pred-volume">
                <strong>{fmtCurrency(totalVol)}</strong>
                <span>market volume</span>
              </div>
              <div class="track-pred-badge">
                {isResolvedCorrect && <span class="track-badge track-badge--correct">Correct</span>}
                {isPending && <span class="track-badge track-badge--pending">Pending</span>}
                {isResolvedMiss && <span class="track-badge track-badge--miss">Miss</span>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="track-upcoming container" aria-labelledby="track-upcoming-title">
      <p class="track-section-label" id="track-upcoming-title">What is still ahead</p>
      <div class="track-upcoming-box">
        <h2>Upcoming desks and cycles</h2>
        <p>Resolved calls move into the archive, while upcoming specials and major cycles stay on the active desks.</p>
        <div class="track-upcoming-list">
          {upcoming.map((item) => (
            <div class="track-upcoming-item">
              <div>
                <strong>{item.flag} {item.title_en}</strong>
                <span>{fmtDate(item.date)}</span>
              </div>
              <span class="track-upcoming-date">{item.date.split('-')[0]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="track-markets container" aria-labelledby="track-markets-title">
      <p class="track-section-label" id="track-markets-title">Validated market volume breakdown</p>
      <div class="track-market-row">
        <span class="track-market-name">Kalshi</span>
        <span class="track-market-vol">{fmtCurrency(meta.kalshi_volume_usd)}</span>
      </div>
      <div class="track-market-row">
        <span class="track-market-name">Polymarket</span>
        <span class="track-market-vol">{fmtCurrency(meta.polymarket_volume_usd)}</span>
      </div>
    </section>

    <section class="track-method container">
      <div class="track-method-box">
        <h2>What "net validated market volume" means</h2>
        <p>
          When VoteScope makes a prediction, traders on platforms like Kalshi and Polymarket independently price the same outcome. The net validated figure adds the volume traded on markets that resolved in the direction of our correct calls, minus the volume that would have resolved against any misses. It is an accountability counter, not personal P&L.
        </p>
      </div>
    </section>

    <div class="track-keep-digging container">
      <KeepDigging
        eyebrow="Keep digging"
        title="Back to the instruments."
        body="All resolved calls link to their original projection pages. Active desks update as new data arrives."
        links={[
          {
            href: '/en/us/specials/ca1/',
            label: 'CA-1 Special Forecast',
            detail: 'June 2, 2026 · U.S. House',
          },
          {
            href: '/en/canada/byelections/',
            label: 'Canada By-elections',
            detail: '3 resolved · April 2026',
          },
          {
            href: '/en/us/',
            label: 'U.S. Desk',
            detail: 'House · Senate · indexes',
          },
          {
            href: '/en/methodology/',
            label: 'Methodology',
            detail: 'How the models work',
          },
        ]}
      />
    </div>
  </article>
</Base>

<style>
  .track-page {
    padding-block: 64px 96px;
  }

  .track-hero {
    max-width: 1080px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--rule);
  }

  .track-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-hero h1 {
    max-width: 700px;
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 0.96;
  }

  .track-dek {
    max-width: 680px;
    margin: 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .track-stats {
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .track-stat-card {
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    padding: 24px 24px 20px;
    position: relative;
    overflow: hidden;
  }

  .track-stat-card--gold {
    background: color-mix(in oklab, var(--duck) 8%, var(--card));
  }

  .track-stat-label {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-stat-value {
    display: block;
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .track-stat-value--gold {
    color: var(--duck-deep);
  }

  .track-stat-note {
    display: block;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.5;
  }

  .track-resolved {
    max-width: 1080px;
    margin-top: 56px;
  }

  .track-section-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 14px;
  }

  .track-pred-list {
    display: grid;
    gap: 10px;
  }

  .track-pred-row {
    display: grid;
    grid-template-columns: 36px 1fr 100px 180px 1fr 120px 90px;
    gap: 12px;
    align-items: center;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
  }

  .track-pred-row:hover {
    border-color: var(--ink-3);
  }

  .track-pred-num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    text-align: center;
  }

  .track-pred-info strong {
    display: block;
    font-size: 14px;
    margin-bottom: 3px;
  }

  .track-pred-info span {
    color: var(--ink-3);
    font-size: 12px;
  }

  .track-pred-conf {
    text-align: center;
  }

  .track-pred-conf strong {
    display: block;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-pred-conf span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-pred-label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 4px;
  }

  .track-pred-call strong {
    font-size: 13px;
  }

  .track-pred-correct {
    color: oklch(0.52 0.14 160);
    font-size: 13px;
  }

  .track-pred-miss {
    color: var(--red);
    font-size: 13px;
  }

  .track-pred-volume {
    text-align: right;
  }

  .track-pred-volume strong {
    display: block;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 430;
    letter-spacing: -0.01em;
  }

  .track-pred-volume span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-badge {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .track-badge--correct {
    background: oklch(0.93 0.06 160);
    border: 1px solid oklch(0.75 0.12 160);
    color: oklch(0.40 0.14 160);
  }

  [data-theme="dark"] .track-badge--correct {
    background: oklch(0.28 0.08 160);
    border-color: oklch(0.45 0.12 160);
    color: oklch(0.72 0.14 160);
  }

  .track-badge--pending {
    background: color-mix(in oklab, var(--duck) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--duck) 30%, transparent);
    color: var(--duck-deep);
  }

  .track-badge--miss {
    background: var(--red-tint);
    border: 1px solid var(--red-soft);
    color: var(--red);
  }

  .track-upcoming {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-upcoming-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 22px 24px;
  }

  .track-upcoming-box h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-upcoming-box > p {
    margin: 0 0 16px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .track-upcoming-list {
    display: grid;
    gap: 10px;
  }

  .track-upcoming-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
  }

  .track-upcoming-item strong {
    display: block;
    font-size: 14px;
    margin-bottom: 3px;
  }

  .track-upcoming-item span {
    color: var(--ink-3);
    font-size: 12px;
  }

  .track-upcoming-date {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--duck-deep);
    white-space: nowrap;
    font-weight: 600;
  }

  .track-markets {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-market-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
    margin-bottom: 8px;
  }

  .track-market-name {
    font-weight: 600;
    font-size: 14px;
  }

  .track-market-vol {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    letter-spacing: -0.01em;
    color: oklch(0.52 0.14 160);
  }

  [data-theme="dark"] .track-market-vol {
    color: oklch(0.72 0.14 160);
  }

  .track-method {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-method-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 22px 24px;
  }

  .track-method-box h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-method-box p {
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.7;
  }

  .track-keep-digging {
    max-width: 1080px;
    margin-top: 64px;
  }

  @media (max-width: 1020px) {
    .track-pred-row {
      grid-template-columns: 36px 1fr 90px;
      gap: 10px;
    }

    .track-pred-conf,
    .track-pred-call,
    .track-pred-volume,
    .track-pred-badge {
      display: none;
    }

    .track-pred-result {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .track-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
