---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import QuebecReview2026 from '../../../components/QuebecReview2026.astro';

const canonical = 'https://vote-scope.com/en/track-record/quebec-2026';
const title = 'Quebec election 2026: how our projection did | Vote-Scope';
const description = 'Our projection for the October 5, 2026 Quebec election against the result: seats, vote, all 127 ridings, our two engines, the 50/50 blend and our election-night calls.';
const alternates = { fr: 'https://vote-scope.com/fr/track-record/quebec-2026', en: 'https://vote-scope.com/en/track-record/quebec-2026', es: 'https://vote-scope.com/es/track-record/quebec-2026' };
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="en"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/projections/quebec/en.png"
  alternates={alternates}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'en' },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Track Record', item: 'https://vote-scope.com/en/track-record' },
        { '@type': 'ListItem', position: 3, name: 'Quebec 2026', item: 'https://vote-scope.com/en/track-record/quebec-2026' },
      ],
    },
  ]}
>
  <QuebecReview2026 locale="en" />
</EditorialLayout>
