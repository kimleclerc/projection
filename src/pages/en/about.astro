---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import AboutVoteScope from '../../components/AboutVoteScope.astro';

const canonical = 'https://vote-scope.com/en/about/';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/a-propos/',
  es: 'https://vote-scope.com/es/acerca-de/',
};
const subjectOf = [
  { '@type': 'Article', name: 'Launching Vote-Scope’s electoral projection model', url: 'https://pilulerouge.ca/projections-electorales-kim-leclerc-lance-un-nouveau-site-pour-decoder-la-carte-politique/', datePublished: '2026-04-23' },
  { '@type': 'VideoObject', name: 'Air Canada governance and crisis management', url: 'https://www.cbc.ca/player/play/video/9.7143764' },
  { '@type': 'VideoObject', name: 'Political debates and leaders’ preparation', url: 'https://www.cbc.ca/player/play/video/9.6999303' },
  { '@type': 'Article', name: 'Experts believe countries could seek alternatives amid rising costs of US-made F-35 fighter jets', url: 'https://www.aa.com.tr/en/americas/experts-believe-countries-could-seek-alternatives-amid-rising-costs-of-us-made-f-35-fighter-jets/3621045', datePublished: '2025-07-03' },
];
---

<EditorialLayout
  title="About Vote-Scope — Independent election forecasting"
  description="Who creates Vote-Scope, how its independent forecasts can be assessed, and selected media interviews featuring Kim Leclerc."
  canonical={canonical}
  lang="en"
  currentPage="about"
  alternates={alternates}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Vote-Scope', url: canonical, inLanguage: 'en', mainEntity: { '@id': 'https://vote-scope.com/#organization' } },
    { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://vote-scope.com/#organization', name: 'Vote-Scope', url: 'https://vote-scope.com/', logo: 'https://vote-scope.com/favicon.svg', founder: { '@id': 'https://vote-scope.com/#kim-leclerc' } },
    { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://vote-scope.com/#kim-leclerc', name: 'Kim Leclerc', url: 'https://kimleclerc.ca', sameAs: ['https://x.com/kimleclerc'], knowsAbout: ['Election forecasting', 'Polling', 'Bayesian modelling', 'Political analysis', 'Defence procurement'], subjectOf },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: canonical },
    ]},
  ]}
>
  <AboutVoteScope lang="en" />
</EditorialLayout>
