---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import KeepDigging from '../../../components/KeepDigging.astro';
import ResolvedCalls from '../../../components/ResolvedCalls.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber.tsx';

import sportsData from '../../../../web_data/sports/latest.json';

const meta = sportsData.board_meta;
const board = sportsData.board as Array<{ p_cup_win: number; label_en: string }>;
const nTeams = board.length;
---

<EditorialLayout
  title="Sports Scope Track Record — Vote-Scope"
  description="Every published Sports Scope call, tracked and verified: NHL Stanley Cup playoff model performance, simulation counts, and accuracy history — Vote-Scope."
  canonical="https://vote-scope.com/en/sports/track-record/"
  lang="en"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/track-record/', fr: 'https://vote-scope.com/fr/sports/track-record/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Sports Scope Track Record — Vote-Scope',
      url: 'https://vote-scope.com/en/sports/track-record/',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/en/sports/' },
        { '@type': 'ListItem', position: 3, name: 'Track Record', item: 'https://vote-scope.com/en/sports/track-record/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Sports Scope · Track record"
    title="The model, on the record."
    promise="Sports Scope track record — covering NHL Stanley Cup playoffs. Every simulation run, every published call, tracked."
    question="Does the model actually pick winners?"
    primaryHref="/en/sports/nhl/"
    primaryLabel="NHL desk"
    secondaryHref="/en/sports/"
    secondaryLabel="Sports hub"
  />

  <section class="content-band">
    <div class="container">
      <p class="section-label">Model activity</p>
      <div class="content-grid-3">
        <div class="note-card note-card--stat">
          <p class="eyebrow">Simulations run</p>
          <strong class="stat-value">
            <AnimatedNumber value={meta.n_sims} format="thousands" client:visible />
          </strong>
          <p>per model run, BSTS + GoalieLayer</p>
        </div>
        <div class="note-card note-card--stat">
          <p class="eyebrow">Teams tracked</p>
          <strong class="stat-value">
            <AnimatedNumber value={nTeams} client:visible />
          </strong>
          <p>playoff-eligible teams in the current bracket</p>
        </div>
        <div class="note-card note-card--stat">
          <p class="eyebrow">Model version</p>
          <strong class="stat-value stat-value--mono">{meta.version}</strong>
          <p>Last run: {meta.run_date}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="section-label">What Sports Scope covers</p>
      <div class="content-grid-2">
        <div class="note-card">
          <p class="eyebrow">NHL Stanley Cup playoffs</p>
          <h3>Cup path probabilities.</h3>
          <p>
            A Bayesian structural time-series model (BSTS) combined with a goalie volatility layer (HDSV%) and 10,000 Monte Carlo simulations. The model tracks each team's path to the Stanley Cup with per-round probabilities updated after every series result.
          </p>
        </div>
        <div class="note-card">
          <p class="eyebrow">Methodology</p>
          <h3>BSTS + GoalieLayer.</h3>
          <p>
            The model blends team-level EWMA game-log strength estimates with a goalie modifier derived from high-danger save percentage. Market signals from 2 books are blended in where available. No black-box inputs — every weight is documented.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="section-label">Resolved calls</p>
      <p style="max-width:680px;color:var(--ink-2);font-size:15px;line-height:1.65;margin:0 0 4px;">
        Each call is frozen from the git history that proves it was public before the result — model probability against the market at the same instant. Market reach is context, never a headline; sports and elections are counted separately.
      </p>
    </div>
    <ResolvedCalls locale="en" domain="sport" />
  </section>

  <div class="container" style="max-width: 1080px; margin-bottom: 80px;">
    <KeepDigging
      eyebrow="Keep digging"
      title="Back to Sports Scope."
      body="The NHL desk has live cup-path probabilities, goalie volatility, and market signals updated after every round."
      links={[
        {
          href: '/en/sports/nhl/',
          label: 'NHL Desk',
          detail: 'Cup path · Goalie volatility · Markets',
        },
        {
          href: '/en/sports/',
          label: 'Sports hub',
          detail: 'All sports instruments',
        },
        {
          href: '/en/track-record/',
          label: 'Political track record',
          detail: '7 for 7 · Verified calls',
        },
      ]}
    />
  </div>
</EditorialLayout>

<style>
  .section-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 20px;
  }

  .content-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .note-card--stat {
    padding: 24px;
  }

  .stat-value {
    display: block;
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin: 14px 0 10px;
  }

  .stat-value--mono {
    font-family: var(--mono);
    font-size: 32px;
    letter-spacing: 0;
  }

  .coming-soon-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 28px 32px;
    max-width: 680px;
  }

  .coming-soon-box h2 {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .coming-soon-box p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .content-grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
