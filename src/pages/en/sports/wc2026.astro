---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import WcGroupTables from '../../../components/WcGroupTables.astro';
import WcSchedule from '../../../components/WcSchedule.astro';
import WcBracket from '../../../components/WcBracket.astro';
import WcLiveScores from '../../../islands/WcLiveScores';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import wcData from '../../../../web_data/sports/worldcup2026_latest.json';

const board = wcData.board as Array<{
  team: string;
  labels: { en: string; fr: string; es: string };
  group: string;
  confederation: string;
  is_host: boolean;
  p_champion: number;
  p_final: number;
  p_semifinal: number;
  p_quarterfinal: number;
  p_round16: number;
  p_knockout_stage: number;
  strength_mean: number;
  trend_direction: string;
  blend_alpha: number;
  market_books: number;
}>;

const hero = wcData.hero;
const meta = wcData.board_meta;

const topTeams = board.slice(0, 10);
const topThree = board.slice(0, 3);

// Group by confederation
const byConf: Record<string, typeof board> = {};
for (const t of topTeams) {
  if (!byConf[t.confederation]) byConf[t.confederation] = [];
  byConf[t.confederation].push(t);
}
const confOrder = ['UEFA', 'CONMEBOL', 'CONCACAF', 'AFC', 'CAF', 'OFC'];
const sortedConfs = confOrder.filter((c) => byConf[c]);

const hostTeams = board.filter((t) => t.is_host).slice(0, 3);

// Prediction-market embed — drive the slug from the model's market_embeds so it
// tracks the correct World Cup market (was previously a stray NHL slug).
const marketEmbeds = (wcData.market_embeds ?? []) as Array<{ type: string; embed_url: string; url?: string }>;
const winnerEmbed = marketEmbeds.find((m) => m.type === 'winner');
const winnerSlug = winnerEmbed ? new URL(winnerEmbed.embed_url).searchParams.get('market') : null;
const winnerUrl = winnerEmbed?.url ?? undefined;
---

<EditorialLayout
  title="WC2026 Forecast — Vote-Scope"
  description="Projects every team's path through the 2026 inter-continental football tournament — group stage to final. 50,000 simulations, updated through the tournament — Vote-Scope."
  canonical="https://vote-scope.com/en/sports/wc2026/"
  lang="en"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/wc2026/', fr: 'https://vote-scope.com/fr/sports/wc2026/', es: 'https://vote-scope.com/es/sports/wc2026/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'WC2026 Forecast',
      description: '48-team forecast for the 2026 inter-continental football tournament. 50,000 simulations with confederation strength blend.',
      url: 'https://vote-scope.com/en/sports/wc2026/',
      dateModified: meta.run_date ?? '',
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/sports/worldcup2026_latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/en/sports/' },
        { '@type': 'ListItem', position: 3, name: 'WC2026', item: 'https://vote-scope.com/en/sports/wc2026/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="2026 international tournament"
    title="Who wins the 2026 inter-continental tournament?"
    promise="48 countries. 50,000 simulations. Group-stage and knockout-round path probabilities, updated through the tournament."
    question="Is the favorite legitimately dominant, or is it a thin edge in a chaotic 48-team bracket?"
    primaryHref="/en/sports/"
    primaryLabel="Sports hub"
    secondaryHref="/en/sports/nhl/"
    secondaryLabel="NHL desk"
  />

  <!-- Hero stats -->
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Top contenders — model run {meta.run_date}</p>
      <div class="content-grid-2" style="gap:1.5rem;margin-top:1rem;">
        {topThree.map((team, i) => (
          <div class="note-card" style="border-left:4px solid var(--accent);">
            <p class="eyebrow">
              {i === 0 ? 'Tournament favorite' : i === 1 ? 'Runner-up' : 'Third'}
              · {team.confederation} · Group {team.group}
              {team.is_host ? ' · Host' : ''}
            </p>
            <h3 style="font-size:1.75rem;margin:0.25rem 0;">{team.labels.en}</h3>
            <p style="font-size:2rem;font-weight:700;color:var(--accent);">
              <AnimatedNumber client:visible value={team.p_champion} decimals={2} suffix="%" />
            </p>
            <p style="font-size:0.9rem;">
              Final: <strong>{team.p_final}%</strong> ·
              Semi: <strong>{team.p_semifinal}%</strong> ·
              QF: <strong>{team.p_quarterfinal}%</strong>
            </p>
            <p style="font-size:0.85rem;margin-top:0.25rem;color:var(--text-muted);">
              Round of 16: {team.p_round16}% · Knockout stage: {team.p_knockout_stage}%
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Live & recent scores -->
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Live & recent scores</p>
      <WcLiveScores client:idle lang="en" />
    </div>
  </section>

  <!-- Full top-10 board -->
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Top 10 — championship probabilities</p>
      <h2>Full tournament board</h2>
      <p style="margin-bottom:1.5rem;font-size:0.9rem;">
        Tournament phase: {meta.tournament_phase.replace(/_/g, ' ')} ·
        {meta.n_sims.toLocaleString()} simulations ·
        {meta.n_teams} teams · {meta.n_groups} groups
      </p>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:2px solid var(--rule,#ddd);text-align:left;">
              <th style="padding:8px 12px;">#</th>
              <th style="padding:8px 12px;">Country</th>
              <th style="padding:8px 12px;">Conf.</th>
              <th style="padding:8px 12px;">Grp</th>
              <th style="padding:8px 12px;text-align:right;">Champion%</th>
              <th style="padding:8px 12px;text-align:right;">Final%</th>
              <th style="padding:8px 12px;text-align:right;">Semi%</th>
              <th style="padding:8px 12px;text-align:right;">QF%</th>
              <th style="padding:8px 12px;text-align:right;">R16%</th>
            </tr>
          </thead>
          <tbody>
            {topTeams.map((team, i) => (
              <tr style={`border-bottom:1px solid var(--rule,#eee);${i % 2 === 0 ? 'background:var(--surface-alt,#fafafa);' : ''}`}>
                <td style="padding:8px 12px;color:var(--ink-3);">{i + 1}</td>
                <td style="padding:8px 12px;font-weight:600;">
                  {team.labels.en}
                  {team.is_host ? <span style="font-size:0.75rem;color:var(--accent);margin-left:4px;">(host)</span> : null}
                </td>
                <td style="padding:8px 12px;font-size:0.85rem;color:var(--ink-3);">{team.confederation}</td>
                <td style="padding:8px 12px;font-size:0.85rem;">{team.group}</td>
                <td style="padding:8px 12px;text-align:right;font-weight:700;">{team.p_champion}%</td>
                <td style="padding:8px 12px;text-align:right;">{team.p_final}%</td>
                <td style="padding:8px 12px;text-align:right;">{team.p_semifinal}%</td>
                <td style="padding:8px 12px;text-align:right;">{team.p_quarterfinal}%</td>
                <td style="padding:8px 12px;text-align:right;">{team.p_round16}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Confederation breakdown -->
  <section class="content-band">
    <div class="container">
      <p class="eyebrow">By confederation — top contenders</p>
      <h2>Where the tournament strength clusters.</h2>
      <div class="content-grid-2" style="gap:1rem;margin-top:1rem;">
        {sortedConfs.map((conf) => (
          <div class="note-card">
            <p class="eyebrow">{conf}</p>
            {byConf[conf].map((t) => (
              <p style="margin:0.25rem 0;">
                <strong>{t.labels.en}</strong>
                {t.is_host ? ' (host)' : ''} —
                {t.p_champion}% champion · {t.p_knockout_stage}% knockout stage
              </p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Host nations -->
  {hostTeams.length > 0 && (
    <section class="content-band">
      <div class="container">
        <p class="eyebrow">Host nations</p>
        <h2>How the hosts are positioned.</h2>
        <div class="content-grid-2" style="gap:1rem;margin-top:1rem;">
          {hostTeams.map((team) => (
            <div class="note-card" style="border-left:4px solid var(--accent);">
              <p class="eyebrow">Host · {team.confederation} · Group {team.group}</p>
              <h3 style="margin:0.25rem 0;">{team.labels.en}</h3>
              <p>Champion: <strong>{team.p_champion}%</strong> · Knockout stage: <strong>{team.p_knockout_stage}%</strong></p>
              <p style="font-size:0.85rem;margin-top:0.25rem;">Final: {team.p_final}% · Semi: {team.p_semifinal}%</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <WcGroupTables lang="en" groups={wcData.groups} />

  <section class="content-band">
    <div class="container">
      <p><a href="/en/sports/wc2026/teams/">All 48 teams →</a></p>
    </div>
  </section>

  <WcSchedule lang="en" schedule={wcData.match_schedule} />

  <WcBracket lang="en" bracket={wcData.knockout_bracket} />

  <section class="content-band">
    <div class="container">
      <PolymarketEmbed slug={winnerSlug} lang="en" eventUrl={winnerUrl} title="Market — 2026 World Cup champion" subtitle="Win probability by country" />
    </div>
  </section>

  <MethodologyNote
    title="50,000 simulations. Group stage through knockout bracket."
    body="The 2026 international tournament model uses an ELO-blend approach: confederation-adjusted team strength combined with a market-calibrated weighting factor (α=0.65). Each of the 50,000 simulations runs the full 48-team tournament bracket from group stage through the final."
    bullets={[
      '48 teams in 12 groups of 4 — top 2 per group plus 8 best thirds advance.',
      'Team strength derived from recent international results weighted by opponent quality.',
      'Blend factor α=0.65 calibrated against tournament betting markets.',
      'Group-stage phase: probabilities update as group matches resolve.',
    ]}
  />

  <!-- Legal disclaimer — mandatory -->
  <section class="content-band" style="background:var(--surface-alt,#f8f8f8);padding-block:32px;">
    <div class="container">
      <p style="font-size:0.82rem;color:var(--ink-3);max-width:760px;line-height:1.6;">
        <strong>Disclaimer:</strong> Vote-Scope is not affiliated with FIFA or any official tournament rights-holders.
        Country names are used for purely descriptive and informational purposes.
        This page presents statistical model output only and makes no claim to official tournament status or sponsorship.
      </p>
    </div>
  </section>
</EditorialLayout>

<style>
  table th {
    font-family: var(--mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3, #666);
    font-weight: 400;
  }
</style>
