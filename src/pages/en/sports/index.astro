---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MarketCheck from '../../../components/MarketCheck.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';

import sportsData from '../../../../web_data/sports/latest.json';
import mlbData from '../../../../web_data/sports/mlb2026_latest.json';
import { teamLabel, fmtProb, type MlbData } from '../../../lib/mlb';
import DeskSections from '../../../components/DeskSections.astro';

const hero = sportsData.hero;
const boardMeta = sportsData.board_meta;

const mlb = mlbData as unknown as MlbData;
const mlbByCode = new Map(mlb.board.map((t) => [t.code, t]));
const mlbFav = mlbByCode.get(mlb.hero.favorite.code)!;
const mlbJays = mlbByCode.get(mlb.hero.canadian_focus.code);
---

<EditorialLayout
  title="Sports Scope — MLB, NHL & World Cup Forecasts — Vote-Scope"
  description="Projects MLB World Series paths and NHL Cup runs, tracks goalie volatility, and compares model vs market gaps. Updated daily — Vote-Scope."
  canonical="https://vote-scope.com/en/sports/"
  lang="en"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/', fr: 'https://vote-scope.com/fr/sports/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sports Scope — Vote-Scope',
      url: 'https://vote-scope.com/en/sports/',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/en/sports/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Sports Scope"
    title="Who has the cleanest path, and who is riding a fragile streak?"
    promise="A sportier desk for playoff paths, goalie volatility, live scores, market checks, and tournament chaos."
    question="Is the favorite actually built for the next round?"
    primaryHref="/en/sports/mlb/"
    primaryLabel="MLB desk"
    secondaryHref="/en/sports/wc2026/"
    secondaryLabel="World Cup archive"
  />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">MLB 2026 · live desk · nightly run</p>
      <h2>{mlbFav.emoji} {teamLabel(mlbFav, 'en')} lead the World Series race at {fmtProb(mlbFav.p_ws, 'en')}.</h2>
      <p>
        All 30 teams, {mlb.board_meta.sims.toLocaleString('en-US')} simulations a night — playoffs, division, pennant and championship odds.
        {mlbJays && (
          <>Canadian check: the {teamLabel(mlbJays, 'en')} sit at <strong>{fmtProb(mlbJays.p_series, 'en')}</strong> to make the playoffs.</>
        )}
      </p>
      <p style="margin-top:0.5rem;">
        <a href="/en/sports/mlb/" class="cta-link">Open the MLB desk →</a>
      </p>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">World Cup 2026 · complete · July 19</p>
      <h2>Spain are world champions.</h2>
      <p>Spain beat Argentina 1–0 after extra time. The archive preserves the whole model record: Spain opened first at 7.36%, while the last pre-final update narrowly preferred Argentina 53.59–46.41.</p>
      <p style="margin-top:0.5rem;">
        <a href="/en/sports/wc2026/" class="cta-link">Open the World Cup archive →</a>
        &nbsp;·&nbsp;
        <a href="/en/sports/wc2026/teams/" class="cta-link">Team stories →</a>
      </p>
    </div>
  </section>


  <section class="content-band">
    <div class="container content-grid-2">
      <div class="note-card">
        <p class="eyebrow">Sports track record</p>
        <h3><a href="/en/sports/track-record/">Model history.</a></h3>
        <p>NHL playoff simulations and series calls — every model run, every published prediction, tracked.</p>
        <p style="margin-top:1rem;">
          <a href="/en/sports/track-record/" class="cta-link">View track record →</a>
        </p>
      </div>
      <a class="note-card" href="/en/sports/wc2026/" style="text-decoration:none;color:inherit;">
        <p class="eyebrow">2026 international football tournament</p>
        <h3>🇪🇸 Spain — 2026 world champions</h3>
        <p>Final: Spain 1–0 Argentina after extra time · opening and pre-final model snapshots archived.</p>
        <footer style="margin-top:1rem;">
          <span class="cta-link">Open tournament archive →</span>
        </footer>
      </a>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <PolymarketEmbed slug="nhl-2027-champion-20260612185656162" kind="event" title="Polymarket — 2027 NHL champion" lang="en" eventUrl="https://polymarket.com/event/nhl-2027-champion-20260612185656162" />
    </div>
  </section>

  <section class="content-band" style="padding:1.5rem 0;">
    <div class="container">
      <div class="note-card" style="opacity:.85;">
        <p class="eyebrow">NHL — 2025-26 season complete</p>
        <h3>{hero.favorite_label_en}: 2026 Stanley Cup champions.</h3>
        <p>Runner-up: {hero.runner_up_label_en}. The desk and the full model track record remain open — NHL instruments return at training camp.</p>
        <p style="margin-top:0.75rem;"><a href="/en/sports/nhl/" class="cta-link">NHL desk →</a>&nbsp;·&nbsp;<a href="/en/sports/track-record/" class="cta-link">Track record →</a></p>
      </div>
    </div>
  </section>

  <MarketCheck
    kicker="Sports market pulse"
    title="The market sees the same game. The model sees the path."
    body="Polymarket and Kalshi odds run alongside the model as an independent benchmark. Where they agree, the signal is strong. Where they diverge, that gap is the story."
    modelLabel="Vote-Scope model"
    marketLabel="Market pulse"
    note="Prediction-market data is shown as a benchmark only. Model and market are updated on independent cadences."
  />

  <DeskSections lang="en" desk="sports" />

  <MethodologyNote
    title="Three sports desks. One standard."
    body="MLB, World Cup and NHL share the same Monte Carlo discipline: outcomes are simulated thousands of times per run, conditioned on real results as the season unfolds."
    bullets={[
      'MLB 2026: 30 teams, 10,000 nightly simulations — pythagenpat strength and log5 matchups over every remaining game, data from the MLB Stats API.',
      'World Cup 2026: 48 teams, 50,000 simulations conditioned on real results (FIFA rankings, recent form, home advantage), updated after every match through the final.',
      'NHL Cup Path: 50,000 simulations per playoff round, updated after each series result. Goalie volatility layer conditions on recent save percentage and injury status.',
      'Track record is public: every published model run and series call is archived and verifiable.',
      'Model outputs are available as public JSON at each desk, updated on a rolling basis.',
    ]}
  />
</EditorialLayout>
