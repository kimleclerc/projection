---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import federalMeta from '../../../../web_data/federal/latest.json';

const j = jurisdictions.federal;
const canonical = 'https://vote-scope.com/en/canada/federal';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/canada/federal',
  es: 'https://vote-scope.com/es/canada/federal',
};
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Canada Federal 2025 Projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: federalMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/federal/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Federal Projection', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en" />
  <RidingsCta
    eyebrow="Riding profile"
    title="Dive into a specific riding"
    blurb="Projection, sitting member, last-election candidates, demographics, projection track and neighbouring ridings — for each of the 343 federal ridings."
    href="/en/canada/federal/ridings/"
    cta="Browse all 343 ridings →"
  />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <!-- TODO: when Federal Canada Polymarket emerges, set slug here -->
    <PolymarketEmbed slug={null} />
  </div>
</EditorialLayout>

