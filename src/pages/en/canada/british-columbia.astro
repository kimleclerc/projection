---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import { raceEditorial } from '../../../data/raceEditorial';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import bcMeta from '../../../../web_data/british-columbia/latest.json';

const j = jurisdictions.britishColumbia;
const canonical = 'https://vote-scope.com/en/canada/british-columbia/';
const alternates = { en: 'https://vote-scope.com/en/canada/british-columbia/', fr: 'https://vote-scope.com/fr/canada/colombie-britannique/', es: 'https://vote-scope.com/es/canada/columbia-britanica/' };
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'British Columbia projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: bcMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/conditions/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/british-columbia/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: 'British Columbia', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en"><Fragment slot="narrative"><RaceNarrative locale="en" {...raceEditorial.britishColumbia.en} /></Fragment></ProjectionEngine>
  <MethodologyNote
    title="What the model assumes, and what it does not claim"
    body="Two of the parties in this projection did not exist at the 2024 election, and twenty of the forty-four MLAs elected as Conservatives have left that caucus at least once since—some of them returning days later. The assumptions filling those two gaps are exploratory, and are stated here rather than dissolved into a number."
    bullets={[
      "CentreBC and OneBC have no 2024 baseline. Their provincial support is spread across ridings by a measured affinity — the 2020 Liberal share for CentreBC, the 2024 Conservative share for OneBC — a third of which is deliberately left flat, because nobody knows where these parties are strong.",
      "The model gives CentreBC no seat, even when its provincial share is raised to 12%. That is a property of the model, not a real impossibility: eight incumbents are defending their seats, and concentrated local standing can do what a provincial share cannot.",
      "The personal-vote premium for an incumbent stripped of a major label is 11.7 points, measured on five 2024 cases — five incumbents who CHOSE to run, while fifteen others stood down. It is an order of magnitude, not a settled calibration.",
      "The probabilities shown are conditional on these assumptions. They will move as candidates are nominated and as pollsters start naming these parties on their questionnaires.",
    ]}
  />
  <RidingsCta
    eyebrow="Riding profile"
    title="Go into a single riding"
    blurb="Projection, sitting member and the label they were elected under, 2024 candidates, projection history and neighbouring ridings — for each of the 93 seats."
    href="/en/canada/british-columbia/ridings/"
    cta="Browse all 93 ridings →"
  />
  <NewsletterCta lang="en" placement="british-columbia" />
</EditorialLayout>
