---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ontarioMeta from '../../../../web_data/ontario/latest.json';

const j = jurisdictions.ontario;
const canonical = 'https://vote-scope.com/en/canada/ontario/';
const alternates = {
  en: canonical,
  fr: 'https://vote-scope.com/fr/canada/ontario/',
  es: 'https://vote-scope.com/es/canada/ontario/',
};
---

<EditorialLayout
  title={j.pageTitle.en}
  description={j.metaDescription.en}
  canonical={canonical}
  lang="en"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Ontario 2026 Projection',
      description: j.metaDescription.en,
      url: canonical,
      dateModified: ontarioMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/ontario/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Ontario Projection', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="en" />
  <RidingsCta
    eyebrow="Provincial by-elections"
    title="Three Ontario by-elections on September 3"
    blurb="Hamilton East—Stoney Creek, Scarborough Southwest and York—Simcoe. Two Progressive Conservative seats are being defended without the member who won them — one of them amid the hotel controversy. Race-by-race forecasts."
    href="/en/canada/ontario/byelections/"
    cta="See all three forecasts →"
  />
  <RidingsCta
    eyebrow="Riding profile"
    title="Dive into a specific riding"
    blurb="Projection, sitting MPP, 2025 candidates, projection track and nearby ridings — for each of the 124 Ontario provincial ridings."
    href="/en/canada/ontario/ridings/"
    cta="Browse all 124 ridings →"
  />
  <NewsletterCta lang="en" placement="ontario" />
</EditorialLayout>

