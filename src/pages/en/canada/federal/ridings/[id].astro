---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../../components/riding/RidingPage.astro';
import { getAllFederalRidings, FEDERAL_MVP_IDS } from '../../../../../lib/riding-adapters/federal';

export function getStaticPaths() {
  const all = getAllFederalRidings();
  const set = FEDERAL_MVP_IDS ? all.filter((r) => FEDERAL_MVP_IDS.includes(r.id)) : all;
  return set.map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/en/canada/federal/ridings/${data.slug}/`;
const alternateFr = `https://vote-scope.com/fr/canada/federal/circonscriptions/${data.slug}/`;
const alternateEs = `https://vote-scope.com/es/canada/federal/distritos/${data.slug}/`;
const title = `${data.name.en} — Federal riding projection — Vote-Scope`;
const description = `Vote-Scope projection for ${data.name.en} (${data.province}): vote share, win probability, baseline vs current model, demographics.`;
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="en"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: canonical, fr: alternateFr, es: alternateEs }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: data.name.en,
      ...(data.alternateNames?.length ? { alternateName: data.alternateNames } : {}),
      containedInPlace: { '@type': 'AdministrativeArea', name: data.province },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada',     item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Federal',    item: 'https://vote-scope.com/en/canada/federal/' },
        { '@type': 'ListItem', position: 4, name: data.name.en, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="en" />
</EditorialLayout>
