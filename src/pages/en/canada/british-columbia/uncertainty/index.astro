---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import SeatUncertaintyPage from '../../../../../components/SeatUncertaintyPage.astro';
import NewsletterCta from '../../../../../components/NewsletterCta.astro';
import { jurisdictions } from '../../../../../data/jurisdictions';
import projectionMeta from '../../../../../../web_data/british-columbia/latest.json';

const j = jurisdictions.britishColumbia;
const canonical = 'https://vote-scope.com/en/canada/british-columbia/uncertainty/';
const alternates = { en: 'https://vote-scope.com/en/canada/british-columbia/uncertainty/', fr: 'https://vote-scope.com/fr/canada/colombie-britannique/incertitude/', es: 'https://vote-scope.com/es/canada/columbia-britanica/incertidumbre/' };
const description = '80% and 95% seat ranges, the probability of finishing first or second, and the run-by-run trajectory of our British Columbia projections. The second layer of the forecast.';
---

<EditorialLayout
  title={'British Columbia projection uncertainty — seat ranges and trajectory — Vote-Scope'}
  description={description}
  canonical={canonical}
  lang="en"
  currentPage="canada"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'British Columbia projection uncertainty',
      description,
      url: canonical,
      dateModified: projectionMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/en/conditions/',
      isAccessibleForFree: true,
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://vote-scope.com/web_data/british-columbia/latest.json',
        encodingFormat: 'application/json',
      },
      isBasedOn: 'https://vote-scope.com/en/canada/british-columbia/',
    },
  ]}
>
  <SeatUncertaintyPage jurisdiction={j} locale="en" />
  <NewsletterCta lang="en" placement="british-columbia-uncertainty" />
</EditorialLayout>
