---
import { jurisdictions } from '../../../../../data/jurisdictions';
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../../components/riding/RidingPage.astro';
import QuebecRidingLive from '../../../../../components/QuebecRidingLive.astro';
import { getAllQuebecRidings } from '../../../../../lib/riding-adapters/quebec';

export function getStaticPaths() {
  return getAllQuebecRidings().map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/en/canada/quebec/ridings/${data.slug}/`;
const alternateFr = `https://vote-scope.com/fr/canada/quebec/circonscriptions/${data.slug}/`;
const alternateEs = `https://vote-scope.com/es/canada/quebec/distritos/${data.slug}/`;
const elected = data.candidates?.find((c) => c.is_elected);
const title = data.results
  ? `${data.name.en || data.name.fr}: 2026 Quebec election results | Vote-Scope`
  : `${data.name.en || data.name.fr}: forecast and 2026 result | Vote-Scope`;
const description = !data.results && elected
  ? `Who would win ${data.name.en || data.name.fr} if Quebec voted today? Vote-Scope forecast. On October 5, 2026, ${elected.name} won with ${elected.vote_pct ?? 0}% of the vote: votes for every candidate.`
  : data.results
  ? `October 5, 2026 Quebec election in ${data.name.en || data.name.fr}: ${data.results.winnerName} wins with ${data.results.candidates[0].pct}% of the vote. Votes for every candidate, turnout, comparison with our forecast and the 2022 result.`
  : `October 5, 2026 Quebec election in ${data.name.en || data.name.fr}: Vote-Scope forecast, candidates and the 2022 result.`;
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="en"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/share/map/quebec/en.png"
  alternates={{ en: canonical, fr: alternateFr, es: alternateEs }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: data.name.en || data.name.fr,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Quebec' },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada',     item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Quebec',     item: 'https://vote-scope.com/en/canada/quebec/' },
        { '@type': 'ListItem', position: 4, name: 'Ridings',    item: 'https://vote-scope.com/en/canada/quebec/ridings/' },
        { '@type': 'ListItem', position: 5, name: data.name.en || data.name.fr, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="en">
    {jurisdictions.quebec.phase !== 'between' && (
      <QuebecRidingLive slot="local-feature" locale="en" ridingId={data.id} name={(data.name.en || data.name.fr)} />
    )}
  </RidingPage>
</EditorialLayout>
