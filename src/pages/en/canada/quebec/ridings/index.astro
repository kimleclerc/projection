---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import { getAllQuebecRidings } from '../../../../../lib/riding-adapters/quebec';
import { partyMeta } from '../../../../../lib/riding-adapters/parties';

const all = getAllQuebecRidings();
const byRegion: Record<string, typeof all> = {};
for (const r of all) {
  const reg = r.region || 'other';
  (byRegion[reg] ??= []).push(r);
}
for (const k of Object.keys(byRegion)) {
  byRegion[k].sort((a, b) => (a.name.en || a.name.fr).localeCompare(b.name.en || b.name.fr, 'en'));
}
const REGION_ORDER = Object.keys(byRegion).sort();
const REGION_LABEL: Record<string, string> = {
  montreal: 'Montréal',
  quebec_city: 'Quebec City',
  rest: 'Rest of Quebec',
  other: 'Other',
};

const canonical = 'https://vote-scope.com/en/canada/quebec/ridings/';
---

<EditorialLayout
  title="Quebec provincial ridings — Vote-Scope"
  description="All 125 Quebec provincial ridings (qc_2026), Vote-Scope projection by party, sitting MNA. Browse by region."
  canonical={canonical}
  lang="en"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: canonical, fr: 'https://vote-scope.com/fr/canada/quebec/circonscriptions/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Quebec provincial ridings',
      url: canonical,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
    },
  ]}
>
  <section class="ridings-index-hero">
    <div class="container">
      <p class="eyebrow">Riding index · Quebec</p>
      <h1>All 125 Quebec ridings, redrawn for 2026.</h1>
      <p class="lede">Projection, sitting MNA, 2022 candidates. The 2026 map redistricted Quebec's electoral boundaries — each page also shows where the new riding comes from.</p>
    </div>
  </section>

  <section class="ridings-index">
    <div class="container">
      {REGION_ORDER.map((reg) => (
        <div class="prov-block">
          <h2 id={reg}>{REGION_LABEL[reg] ?? reg} <span class="count">{byRegion[reg].length}</span></h2>
          <ul class="riding-list">
            {byRegion[reg].map((r) => {
              const meta = partyMeta(r.jurisdiction, r.projection.winner);
              return (
                <li>
                  <a href={`/en/canada/quebec/ridings/${r.slug}/`} style={`--accent:${meta.color}`}>
                    <span class="dot" aria-hidden="true"></span>
                    <span class="name">{r.name.en || r.name.fr}</span>
                    <span class="party">{meta.label_en}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>
</EditorialLayout>

<style>
  .ridings-index-hero { padding: 80px 0 32px; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .ridings-index-hero h1 { margin: 8px 0 16px; font-family: var(--serif); font-size: clamp(40px, 5vw, 64px); font-weight: 420; letter-spacing: -0.02em; line-height: 1.02; max-width: 900px; }
  .ridings-index-hero .lede { max-width: 760px; font-family: var(--serif); font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; color: var(--ink-2); }
  .ridings-index { padding: 48px 0; background: var(--paper-2); }
  .prov-block { margin-bottom: 48px; }
  .prov-block h2 { margin: 0 0 18px; font-family: var(--serif); font-size: clamp(24px, 2.6vw, 32px); font-weight: 420; letter-spacing: -0.01em; }
  .prov-block .count { font-family: var(--mono); font-size: 13px; color: var(--ink-2); margin-left: 10px; }
  .riding-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .riding-list a { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--card); text-decoration: none; color: inherit; transition: background .15s ease; }
  .riding-list a:hover { background: color-mix(in oklab, var(--accent) 12%, var(--card)); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
  .name { font-family: var(--serif); font-size: 15px; flex: 1; }
  .party { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
</style>
