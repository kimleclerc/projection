---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import QuebecElectionNight from '../../../../../components/QuebecElectionNight.astro';

const canonical = "https://vote-scope.com/en/canada/quebec/results/";
const title = "Quebec Election 2026: Live Results by Riding | Vote-Scope";
const description = "Live results of the October 5, 2026 Quebec election from 8 p.m., when polls close: seats, votes and polls reporting in all 127 ridings, plus our race calls.";
const eventName = "Quebec general election, 2026";
const ogImage = "https://vote-scope.com/og/projections/quebec/en.png";
const alternates = {
  fr: "https://vote-scope.com/fr/canada/quebec/resultats/",
  en: "https://vote-scope.com/en/canada/quebec/results/",
  es: "https://vote-scope.com/es/canada/quebec/resultados/",
};
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="en"
  currentPage="canada"
  ogImage={ogImage}
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
      about: {
        '@type': 'Event',
        name: eventName,
        description,
        image: [ogImage],
        startDate: '2026-10-05T20:00:00-04:00',
        endDate: '2026-10-06T02:00:00-04:00',
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@type': 'Place', name: 'Québec', address: { '@type': 'PostalAddress', addressRegion: 'QC', addressCountry: 'CA' } },
        organizer: { '@type': 'GovernmentOrganization', name: 'Élections Québec', url: 'https://www.electionsquebec.qc.ca/' },
        performer: [
          { '@type': 'PoliticalParty', name: 'Parti québécois' },
          { '@type': 'PoliticalParty', name: 'Parti libéral du Québec' },
          { '@type': 'PoliticalParty', name: 'Coalition avenir Québec' },
          { '@type': 'PoliticalParty', name: 'Parti conservateur du Québec' },
          { '@type': 'PoliticalParty', name: 'Québec solidaire' },
        ],
        offers: { '@type': 'Offer', price: 0, priceCurrency: 'CAD', availability: 'https://schema.org/InStock', url: canonical, validFrom: '2026-09-26T00:00:00-04:00' },
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/en/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/en/canada/' },
        { '@type': 'ListItem', position: 3, name: eventName, item: canonical },
      ],
    },
  ]}
>
  <QuebecElectionNight locale="en" />
</EditorialLayout>
