---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import manifest from '../../../web_data/public-api/latest.json';

const canonical = 'https://vote-scope.com/api/';
const datasets = manifest.datasets as Array<{
  id: string;
  kind: string;
  title: string;
  data_through?: string;
  latest_url: string;
  backlink_url: string;
  model_version?: string;
  record_count?: number;
  history: { available: boolean; snapshot_count: number };
}>;
const catalogues = Object.entries(manifest.meta.catalogs ?? {}) as Array<[string, string]>;
---

<EditorialLayout
  title="Vote-Scope Data API — Forecasts, polls, candidates and indexes"
  description="Discover Vote-Scope’s public forecasts, polling archives, candidate registries, original indexes, special elections and provenance through a stable static API."
  canonical={canonical}
  lang="en"
  currentPage="api"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'DataCatalog',
    name: 'Vote-Scope Data API',
    url: canonical,
    creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    dataset: datasets.map((dataset) => ({
      '@type': 'Dataset',
      name: dataset.title,
      url: dataset.backlink_url,
      distribution: {
        '@type': 'DataDownload',
        contentUrl: dataset.latest_url,
        encodingFormat: 'application/json',
      },
    })),
  }}
>
  <article class="api-docs container">
    <header class="api-hero">
      <p class="eyebrow">VOTE-SCOPE DATA · VERSION {manifest.meta.schema_version}</p>
      <h1>Forecast data built to be cited.</h1>
      <p class="lede">A read-only catalogue of Vote-Scope forecasts, polls, candidates, primaries, original indexes and special elections. Existing <code>/web_data/</code> resources remain canonical; this API adds discovery, provenance, checksums and stable backlinks.</p>
      <div class="api-actions">
        <a class="primary" href="/api/v1/manifest.json">Open manifest</a>
        <a href="/api/v1/elections.json">Election datasets</a>
      </div>
      <nav class="catalog-links" aria-label="Dataset catalogues">
        {catalogues.map(([name, url]) => <a href={url}>{name.replace('-', ' ')}</a>)}
      </nav>
    </header>

    <section class="api-note" aria-labelledby="attribution-title">
      <div>
        <p class="eyebrow">ATTRIBUTION</p>
        <h2 id="attribution-title">Link to the desk you use.</h2>
      </div>
      <p>When republishing a Vote-Scope forecast, use “According to Vote-Scope” and link to the dataset’s <code>backlink_url</code>. That URL points readers to the relevant forecast, methodology and context—not merely to a raw file.</p>
    </section>

    <section aria-labelledby="datasets-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">CURRENT CATALOGUE</p>
          <h2 id="datasets-title">{datasets.length} public datasets</h2>
        </div>
        <p>As of {String(manifest.meta.data_through).slice(0, 10)}</p>
      </div>
      <div class="dataset-grid">
        {datasets.map((dataset) => (
          <article class="dataset-card">
            <p class="dataset-kind">{dataset.kind.replace('_', ' ')}</p>
            <h3>{dataset.title}</h3>
            <dl>
              <div><dt>Data through</dt><dd>{dataset.data_through ?? 'See dataset'}</dd></div>
              <div><dt>Model</dt><dd>{dataset.model_version ?? 'Desk-specific'}</dd></div>
              {dataset.record_count != null && <div><dt>Records</dt><dd>{dataset.record_count.toLocaleString('en-CA')}</dd></div>}
              <div><dt>Snapshots</dt><dd>{dataset.history.snapshot_count}</dd></div>
            </dl>
            <div class="dataset-links">
              <a href={dataset.backlink_url}>Forecast page</a>
              <a href={dataset.latest_url}>JSON</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="api-uses" aria-labelledby="uses-title">
      <p class="eyebrow">WHAT CAN I BUILD?</p>
      <h2 id="uses-title">From newsroom graphics to reproducible research.</h2>
      <div class="use-grid">
        <p>Retrieve the latest forecast or polling catalogue for an election graphic.</p>
        <p>Compare immutable runs to explain how a race changed over time.</p>
        <p>Cite a dated projection and send readers back to its Vote-Scope desk.</p>
      </div>
    </section>

    <section class="api-reference" aria-labelledby="reference-title">
      <p class="eyebrow">STATIC BY DESIGN</p>
      <h2 id="reference-title">Simple files, explicit provenance.</h2>
      <pre><code>curl https://vote-scope.com/api/v1/manifest.json<br/><br/>const data = await fetch(<br/>  'https://vote-scope.com/web_data/quebec/latest.json'<br/>).then(response =&gt; response.json());<br/><br/>console.log(data.parties);</code></pre>
      <p><code>latest.json</code> resources change as forecasts update. Historical run files are treated as immutable and publish with SHA-256 checksums in the manifest. No account or API key is required.</p>
      <div class="stability-contract">
        <h3>Version 1 stability contract</h3>
        <p>Additions to <code>/api/v1/</code> are backwards-compatible. A change that removes or redefines existing fields will publish under a new API version. Canonical <code>/web_data/</code> URLs remain in place.</p>
      </div>
    </section>
  </article>
</EditorialLayout>

<style>
  .api-docs { padding-block: clamp(54px, 8vw, 110px); }
  .api-hero { max-width: 880px; margin-bottom: 64px; }
  .eyebrow, .dataset-kind { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--red); }
  h1 { font-family: var(--serif); font-size: clamp(46px, 8vw, 86px); line-height: .96; letter-spacing: -.045em; margin: 18px 0 24px; }
  h2 { font-family: var(--serif); font-size: clamp(30px, 4vw, 48px); line-height: 1.02; letter-spacing: -.03em; margin: 8px 0 12px; }
  .lede { max-width: 760px; font-size: clamp(18px, 2vw, 23px); line-height: 1.55; color: var(--ink-2); }
  code, pre { font-family: var(--mono); }
  .api-actions, .dataset-links, .catalog-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .api-actions a, .dataset-links a { border: 1px solid var(--rule); padding: 10px 14px; font-family: var(--mono); font-size: 12px; }
  .catalog-links { margin-top: 14px; }
  .catalog-links a { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); }
  .api-actions a.primary { color: var(--paper); background: var(--ink); border-color: var(--ink); }
  .api-note { display: grid; grid-template-columns: minmax(220px, .8fr) 1.4fr; gap: 40px; padding: 34px; margin-bottom: 70px; border: 1px solid var(--rule); background: var(--paper-2); }
  .api-note p:last-child { font-size: 17px; line-height: 1.65; color: var(--ink-2); }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .section-head > p { color: var(--ink-3); font-family: var(--mono); font-size: 12px; }
  .dataset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .dataset-card { padding: 28px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .dataset-card h3 { font-family: var(--serif); font-size: 28px; margin: 8px 0 22px; }
  dl { display: grid; gap: 7px; margin: 0; }
  dl div { display: grid; grid-template-columns: 105px 1fr; gap: 12px; font-size: 13px; }
  dt { color: var(--ink-3); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .dataset-links a { padding: 7px 10px; }
  .api-uses, .api-reference { max-width: 850px; margin-top: 70px; }
  .use-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); margin-top: 24px; }
  .use-grid p { background: var(--paper); margin: 0; padding: 24px; line-height: 1.55; }
  pre { overflow-x: auto; padding: 24px; border: 1px solid var(--rule); background: var(--paper-2); line-height: 1.8; }
  .api-reference > p { color: var(--ink-2); line-height: 1.65; }
  .stability-contract { border-left: 3px solid var(--red); margin-top: 28px; padding: 4px 0 4px 22px; }
  .stability-contract h3 { margin: 0 0 8px; font-family: var(--serif); font-size: 24px; }
  .stability-contract p { margin: 0; color: var(--ink-2); line-height: 1.6; }
  @media (max-width: 760px) {
    .api-note { grid-template-columns: 1fr; }
    .dataset-grid { grid-template-columns: 1fr; }
    .use-grid { grid-template-columns: 1fr; }
    .section-head { align-items: start; flex-direction: column; }
  }
</style>
