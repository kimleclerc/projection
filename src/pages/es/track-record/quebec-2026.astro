---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import QuebecReview2026 from '../../../components/QuebecReview2026.astro';

const canonical = 'https://vote-scope.com/es/track-record/quebec-2026';
const title = 'Elecciones de Quebec 2026: nuestro balance, aciertos y errores | Vote-Scope';
const description = 'Nuestra proyección de las elecciones de Quebec del 5 de octubre de 2026 frente al resultado: escaños, voto, 127 distritos, nuestros dos motores, la mezcla 50/50 y los anuncios de la noche.';
const alternates = { fr: 'https://vote-scope.com/fr/track-record/quebec-2026', en: 'https://vote-scope.com/en/track-record/quebec-2026', es: 'https://vote-scope.com/es/track-record/quebec-2026' };
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/projections/quebec/es.png"
  alternates={alternates}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'es' },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Historial', item: 'https://vote-scope.com/es/track-record' },
        { '@type': 'ListItem', position: 3, name: 'Quebec 2026', item: 'https://vote-scope.com/es/track-record/quebec-2026' },
      ],
    },
  ]}
>
  <QuebecReview2026 locale="es" />
</EditorialLayout>
