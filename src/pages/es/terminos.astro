---
import { getEntry } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import EditorialStory from '../../components/EditorialStory.astro';

const entry = await getEntry('editorial', 'es/terminos');
if (!entry) throw new Error('Missing editorial entry: es/terminos');
const d = entry.data;
---

<EditorialLayout
  title={d.title}
  description={d.description}
  canonical={d.alternates.es}
  lang="es"
  currentPage="terms"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={d.alternates}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: d.title, url: d.alternates.es, inLanguage: 'es' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Condiciones', item: d.alternates.es },
    ]},
  ]}
>
  <EditorialStory entry={entry} />
</EditorialLayout>
