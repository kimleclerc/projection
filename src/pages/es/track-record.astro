---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import KeepDigging from '../../components/KeepDigging.astro';
import CalibrationSection from '../../components/CalibrationSection.astro';
import AnimatedNumber from '../../islands/AnimatedNumber.tsx';

import resolvedCalls from '../../../web_data/resolved-calls.json';

const LOCALE = 'es' as const;

const dataPath = resolve(process.cwd(), 'web_data', 'track-record', 'predictions.json');
const data = JSON.parse(readFileSync(dataPath, 'utf-8'));
const metaExtra = data.meta;
const note = metaExtra[`note_${LOCALE}`] ?? metaExtra.note_en;
const upcoming = data.upcoming as Array<{ flag: string; title_en: string; date: string }>;

const electionCalls = (resolvedCalls.calls as any[]).filter((c) => c.domain === 'election');
const predictions = electionCalls.map((c) => ({
  flag: c.flag as string,
  title: c.text.title[LOCALE] as string,
  subtitle: c.competition[LOCALE] as string,
  date: c.result.date as string,
  confidence: c.model_snapshot.subject_prob as number,
  call: c.text.call[LOCALE] as string,
  result: c.result.outcome[LOCALE] as string,
  correct: c.result.status === 'correct',
  status: c.result.status as string,
  volume: (c.market?.volume_usd ?? 0) as number,
}));
const resolvedCount = predictions.filter((p) => p.correct).length;
const totalCount = predictions.length;
const accuracyPct = Math.round((resolvedCount / totalCount) * 100);
const netVolume = predictions.reduce((s, p) => s + p.volume, 0);

function fmtCurrency(n: number) {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(2)}M`;
  if (n >= 1_000) return `$${Math.round(n / 1_000)}K`;
  return `$${n.toLocaleString('es-ES')}`;
}

function fmtDate(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString('es-ES', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Base
  title="Historial de pronósticos — Vote-Scope"
  description="Cada pronóstico de Vote-Scope, rastreado y verificado: llamadas realizadas, resultados confirmados y el volumen de los mercados de predicción detrás de cada una. Transparencia antes que confianza."
  canonical="https://vote-scope.com/es/track-record/"
  lang="es"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: 'https://vote-scope.com/en/track-record/',
    fr: 'https://vote-scope.com/fr/track-record/',
    es: 'https://vote-scope.com/es/track-record/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Historial de pronósticos — Vote-Scope', url: 'https://vote-scope.com/es/track-record/', inLanguage: 'es' },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Historial', item: 'https://vote-scope.com/es/track-record/' },
    ]},
  ]}
>
  <article class="track-page">
    <header class="track-hero container">
      <p class="track-kicker">Pronósticos verificados · Actualizado el {fmtDate(metaExtra.last_updated)}</p>
      <h1>Cada llamada.<br />Cada resultado.</h1>
      <p class="track-dek">
        {note}
      </p>
    </header>

    <section class="track-stats container" aria-label="Marcador de pronósticos">
      <div class="track-stat-card">
        <p class="track-stat-label">Marcador</p>
        <strong class="track-stat-value">
          <AnimatedNumber value={resolvedCount} client:visible /> / {totalCount}
        </strong>
        <span class="track-stat-note">de {totalCount} llamadas resueltas</span>
      </div>
      <div class="track-stat-card track-stat-card--gold">
        <p class="track-stat-label">Tasa de acierto</p>
        <strong class="track-stat-value track-stat-value--gold">
          <AnimatedNumber value={accuracyPct} suffix="%" client:visible />
        </strong>
        <span class="track-stat-note">Basada únicamente en pronósticos resueltos</span>
      </div>
      <div class="track-stat-card">
        <p class="track-stat-label">Volumen de mercado neto validado</p>
        <strong class="track-stat-value">
          <AnimatedNumber value={netVolume} format="thousands" prefix="$" client:visible />
        </strong>
        <span class="track-stat-note">Volumen de llamadas correctas menos el volumen de cualquier fallo futuro</span>
      </div>
    </section>

    <section class="track-resolved container" aria-labelledby="track-resolved-title">
      <p class="track-section-label" id="track-resolved-title">Pronósticos resueltos</p>
      <div class="track-pred-list">
        {predictions.map((pred, i) => {
          const totalVol = pred.volume;
          const resultClass = pred.correct ? 'track-pred-correct' : 'track-pred-miss';
          const resultPrefix = pred.correct ? '✓ ' : '✗ ';
          const isResolvedCorrect = pred.status === 'resolved' && pred.correct;
          const isPending = pred.status === 'pending';
          const isResolvedMiss = pred.status === 'resolved' && !pred.correct;
          return (
            <article class="track-pred-row">
              <div class="track-pred-num">{i + 1}</div>
              <div class="track-pred-info">
                <strong>{pred.flag} {pred.title}</strong>
                <span>{pred.subtitle} · {fmtDate(pred.date)}</span>
              </div>
              <div class="track-pred-conf">
                <strong>{pred.confidence.toFixed(1)}%</strong>
                <span>confianza</span>
              </div>
              <div class="track-pred-call">
                <span class="track-pred-label">Nuestra llamada</span>
                <strong>{pred.call}</strong>
              </div>
              <div class="track-pred-result">
                <strong class={resultClass}>{resultPrefix}{pred.result}</strong>
              </div>
              <div class="track-pred-volume">
                <strong>{fmtCurrency(totalVol)}</strong>
                <span>volumen de mercado</span>
              </div>
              <div class="track-pred-badge">
                {isResolvedCorrect && <span class="track-badge track-badge--correct">Correcto</span>}
                {isPending && <span class="track-badge track-badge--pending">Pendiente</span>}
                {isResolvedMiss && <span class="track-badge track-badge--miss">Fallo</span>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="track-upcoming container" aria-labelledby="track-upcoming-title">
      <p class="track-section-label" id="track-upcoming-title">Lo que viene</p>
      <div class="track-upcoming-box">
        <h2>Próximos desks y ciclos</h2>
        <p>Las llamadas resueltas pasan al archivo, mientras que las elecciones especiales y los grandes ciclos siguen en los desks activos.</p>
        <div class="track-upcoming-list">
          {upcoming.map((item) => (
            <div class="track-upcoming-item">
              <div>
                <strong>{item.flag} {item.title_en}</strong>
                <span>{fmtDate(item.date)}</span>
              </div>
              <span class="track-upcoming-date">{item.date.split('-')[0]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="track-markets container" aria-labelledby="track-markets-title">
      <p class="track-section-label" id="track-markets-title">Desglose del volumen de mercado validado</p>
      <div class="track-market-row">
        <span class="track-market-name">Kalshi</span>
        <span class="track-market-vol">{fmtCurrency(metaExtra.kalshi_volume_usd)}</span>
      </div>
      <div class="track-market-row">
        <span class="track-market-name">Polymarket</span>
        <span class="track-market-vol">{fmtCurrency(metaExtra.polymarket_volume_usd)}</span>
      </div>
    </section>

    <section class="track-method container">
      <div class="track-method-box">
        <h2>Qué significa «volumen de mercado neto validado»</h2>
        <p>
          Cuando Vote-Scope publica un pronóstico, los operadores de plataformas como Kalshi y Polymarket valoran de forma independiente el mismo resultado. La cifra neta validada suma el volumen negociado en los mercados que se resolvieron en la dirección de nuestras llamadas correctas, menos el volumen que se habría resuelto en contra de cualquier fallo. Es un contador de rendición de cuentas, no una ganancia personal.
        </p>
      </div>
    </section>

    <CalibrationSection lang="es" backtests={data.backtests} />

    <div class="track-keep-digging container">
      <KeepDigging
        eyebrow="Sigue explorando"
        title="Volver a los instrumentos."
        body="Todas las llamadas resueltas enlazan a sus páginas de proyección originales. Los desks activos se actualizan a medida que llegan nuevos datos."
        links={[
          {
            href: '/es/us/specials/ca1/',
            label: 'Pronóstico especial CA-1',
            detail: '2 de junio de 2026 · Cámara de EE. UU.',
          },
          {
            href: '/es/canada/byelections/',
            label: 'Elecciones parciales de Canadá',
            detail: '3 resueltas · abril de 2026',
          },
          {
            href: '/es/us/',
            label: 'Desk de EE. UU.',
            detail: 'Cámara · Senado · índices',
          },
          {
            href: '/es/metodologia/',
            label: 'Metodología',
            detail: 'Cómo funcionan los modelos',
          },
        ]}
      />
    </div>
  </article>
</Base>

<style>
  .track-page {
    padding-block: 64px 96px;
  }

  .track-hero {
    max-width: 1080px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--rule);
  }

  .track-kicker {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-hero h1 {
    max-width: 700px;
    margin: 0 0 18px;
    font-family: var(--serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 0.96;
  }

  .track-dek {
    max-width: 680px;
    margin: 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
  }

  .track-stats {
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .track-stat-card {
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    padding: 24px 24px 20px;
    position: relative;
    overflow: hidden;
  }

  .track-stat-card--gold {
    background: color-mix(in oklab, var(--duck) 8%, var(--card));
  }

  .track-stat-label {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-stat-value {
    display: block;
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .track-stat-value--gold {
    color: var(--duck-deep);
  }

  .track-stat-note {
    display: block;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.5;
  }

  .track-resolved {
    max-width: 1080px;
    margin-top: 56px;
  }

  .track-section-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 14px;
  }

  .track-pred-list {
    display: grid;
    gap: 10px;
  }

  .track-pred-row {
    display: grid;
    grid-template-columns: 36px 1fr 100px 180px 1fr 120px 90px;
    gap: 12px;
    align-items: center;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
  }

  .track-pred-row:hover {
    border-color: var(--ink-3);
  }

  .track-pred-num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    text-align: center;
  }

  .track-pred-info strong {
    display: block;
    font-size: 14px;
    margin-bottom: 3px;
  }

  .track-pred-info span {
    color: var(--ink-3);
    font-size: 12px;
  }

  .track-pred-conf {
    text-align: center;
  }

  .track-pred-conf strong {
    display: block;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-pred-conf span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-pred-label {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 4px;
  }

  .track-pred-call strong {
    font-size: 13px;
  }

  .track-pred-correct {
    color: oklch(0.52 0.14 160);
    font-size: 13px;
  }

  .track-pred-miss {
    color: var(--red);
    font-size: 13px;
  }

  .track-pred-volume {
    text-align: right;
  }

  .track-pred-volume strong {
    display: block;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 430;
    letter-spacing: -0.01em;
  }

  .track-pred-volume span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .track-badge {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .track-badge--correct {
    background: oklch(0.93 0.06 160);
    border: 1px solid oklch(0.75 0.12 160);
    color: oklch(0.40 0.14 160);
  }

  [data-theme="dark"] .track-badge--correct {
    background: oklch(0.28 0.08 160);
    border-color: oklch(0.45 0.12 160);
    color: oklch(0.72 0.14 160);
  }

  .track-badge--pending {
    background: color-mix(in oklab, var(--duck) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--duck) 30%, transparent);
    color: var(--duck-deep);
  }

  .track-badge--miss {
    background: var(--red-tint);
    border: 1px solid var(--red-soft);
    color: var(--red);
  }

  .track-upcoming {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-upcoming-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 22px 24px;
  }

  .track-upcoming-box h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-upcoming-box > p {
    margin: 0 0 16px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .track-upcoming-list {
    display: grid;
    gap: 10px;
  }

  .track-upcoming-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
  }

  .track-upcoming-item strong {
    display: block;
    font-size: 14px;
    margin-bottom: 3px;
  }

  .track-upcoming-item span {
    color: var(--ink-3);
    font-size: 12px;
  }

  .track-upcoming-date {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--duck-deep);
    white-space: nowrap;
    font-weight: 600;
  }

  .track-markets {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-market-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--card);
    margin-bottom: 8px;
  }

  .track-market-name {
    font-weight: 600;
    font-size: 14px;
  }

  .track-market-vol {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 430;
    letter-spacing: -0.01em;
    color: oklch(0.52 0.14 160);
  }

  [data-theme="dark"] .track-market-vol {
    color: oklch(0.72 0.14 160);
  }

  .track-method {
    max-width: 1080px;
    margin-top: 40px;
  }

  .track-method-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 22px 24px;
  }

  .track-method-box h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .track-method-box p {
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.7;
  }

  .track-keep-digging {
    max-width: 1080px;
    margin-top: 64px;
  }

  @media (max-width: 1020px) {
    .track-pred-row {
      grid-template-columns: 36px 1fr 90px;
      gap: 10px;
    }

    .track-pred-conf,
    .track-pred-call,
    .track-pred-volume,
    .track-pred-badge {
      display: none;
    }

    .track-pred-result {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .track-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
