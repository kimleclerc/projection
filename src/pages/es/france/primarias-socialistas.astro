---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FrancePsPrimary from '../../../components/FrancePsPrimary.astro';
import polls from '../../../../web_data/france-presidential/polls.json';
import latest from '../../../../web_data/france-presidential/latest.json';

// Description : le poids de Glucksmann dans les sondages des 90 derniers jours.
const run = Date.parse(`${(latest as any).meta.run_date}T12:00:00Z`);
const shares = (((polls as any).first_round ?? []) as any[])
  .filter((r) => r.field_end && (run - Date.parse(`${r.field_end}T12:00:00Z`)) / 86_400_000 <= 90)
  .flatMap((r) => (r.entries ?? []).filter((e: any) => e.id === 'left_glucksmann').map((e: any) => Number(e.share)));
const mean = shares.length ? shares.reduce((a, b) => a + b, 0) / shares.length : null;
const fav = mean === null ? null : { short: 'Glucksmann', v: `${mean.toFixed(1).replace('.', ',')} %` };
const lead = fav ? `${fav.short} obtiene ${fav.v} en las encuestas presidenciales. ` : '';
const canonical = 'https://vote-scope.com/es/france/primarias-socialistas/';
---

<EditorialLayout
  title="Primarias socialistas de Francia 2026: candidatos, fechas y encuestas — Vote-Scope"
  description={`Primarias socialistas del 9-10 y 16-17 de octubre: Glucksmann, Faure, Royal, Guedj, Maurel. ${lead}Quién vota, cómo y lo que el ganador cambia para 2027.`}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/france-desk/es.png"
  alternates={{ en: 'https://vote-scope.com/en/france/socialist-primary/', fr: 'https://vote-scope.com/fr/france/primaire-socialiste/', es: 'https://vote-scope.com/es/france/primarias-socialistas/' }}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Primarias socialistas de Francia 2026',
    startDate: '2026-10-09',
    endDate: '2026-10-17',
    eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'VirtualLocation', url: 'https://parti-socialiste.fr/actualites/participe-a-la-primaire-socialiste/' },
    organizer: { '@type': 'Organization', name: 'Parti socialiste', url: 'https://parti-socialiste.fr' },
    url: canonical,
  }]}
>
  <FrancePsPrimary locale="es" />
</EditorialLayout>
