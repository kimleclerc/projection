---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FrancePsPrimary from '../../../components/FrancePsPrimary.astro';
const canonical = 'https://vote-scope.com/es/france/primarias-socialistas/';
---

<EditorialLayout
  title="Primarias socialistas de Francia 2026: Raphaël Glucksmann gana con el 66 % — resultados — Vote-Scope"
  description="Resultados de las primarias socialdemócratas del 11 de octubre de 2026: Raphaël Glucksmann gana en la primera vuelta con el 66,2 %, por delante de Olivier Faure (14,5 %), Ségolène Royal, Emmanuel Maurel y Jérôme Guedj. Participación y lo que cambia para 2027."
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/share/projection/france-presidential/es.png"
  alternates={{ en: 'https://vote-scope.com/en/france/socialist-primary/', fr: 'https://vote-scope.com/fr/france/primaire-socialiste/', es: 'https://vote-scope.com/es/france/primarias-socialistas/' }}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'Primarias socialistas de Francia 2026',
    startDate: '2026-10-09',
    endDate: '2026-10-11',
    eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'VirtualLocation', url: 'https://parti-socialiste.fr/actualites/participe-a-la-primaire-socialiste/' },
    organizer: { '@type': 'Organization', name: 'Parti socialiste', url: 'https://parti-socialiste.fr' },
    url: canonical,
  }]}
>
  <FrancePsPrimary locale="es" />
</EditorialLayout>
