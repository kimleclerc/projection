---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FrancePollsPage from '../../../../components/FrancePollsPage.astro';
import polls from '../../../../../web_data/france-presidential/polls.json';

const meta = (polls as any).meta;
const lastPoll = meta.last_release_date
  ? new Date(meta.last_release_date + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
const canonical = 'https://vote-scope.com/es/france/sondeos/';
const alternates = {
  en: 'https://vote-scope.com/en/france/polls/',
  fr: 'https://vote-scope.com/fr/france/sondages/',
  es: canonical,
};
---

<EditorialLayout
  title={lastPoll
    ? `Sondeos presidenciales Francia 2027 — la clasificación al ${lastPoll}`
    : 'Sondeos presidenciales Francia 2027 — la clasificación al día'}
  description={`¿Quién lidera la presidencial francesa de 2027? ${meta.n_first_round_polls} sondeos de primera vuelta y ${meta.n_runoff_polls} duelos de segunda vuelta${meta.n_firms ? ` de ${meta.n_firms} encuestadoras` : ''}${lastPoll ? `, al ${lastPoll}` : ''}. Promedio ponderado y sondeo por sondeo.`}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Sondeos presidenciales de Francia 2027',
    description: 'Compilación de sondeos de primera y segunda vuelta de la elección presidencial francesa de 2027.',
    url: canonical,
    dateModified: meta.generated_at,
    creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    license: 'https://vote-scope.com/es/terminos/',
    isAccessibleForFree: true,
  }]}
>
  <FrancePollsPage locale="es" />
</EditorialLayout>
