---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FranceCandidatePage from '../../../../components/FranceCandidatePage.astro';
import { getAllCandidates, slugify, candidateProse } from '../../../../lib/fr-candidates';
import { candidateSeo } from '../../../../lib/fr-candidate-seo';

export function getStaticPaths() {
  return getAllCandidates().map((candidate) => ({
    params: { id: candidate.slug },
    props: { candidate },
  }));
}

const { candidate } = Astro.props;
const canonical = `https://vote-scope.com/es/france/candidatos/${candidate.slug}/`;
const prose = candidateProse(candidate, 'es');
const seo = candidateSeo(candidate, 'es', prose[0]);
---

<EditorialLayout
  title={seo.title}
  description={seo.description}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage={`https://vote-scope.com/og/share/candidate/${candidate.slug}/es.png`}
  alternates={{
    en: `https://vote-scope.com/en/france/candidates/${slugify(candidate.name)}/`,
    fr: `https://vote-scope.com/fr/france/candidats/${slugify(candidate.name)}/`,
    es: canonical,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      url: canonical,
      name: seo.title,
      description: seo.description,
      inLanguage: 'es',
      dateModified: candidate.runDate,
      about: { '@type': 'Person', name: candidate.name, description: prose[0] },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: candidate.name,
      url: canonical,
      description: prose[0],
    },
  ]}
>
  <FranceCandidatePage candidate={candidate} locale="es" />
</EditorialLayout>
