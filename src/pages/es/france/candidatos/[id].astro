---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import FranceCandidatePage from '../../../../components/FranceCandidatePage.astro';
import { getAllCandidates, slugify } from '../../../../lib/fr-candidates';
import { blocLabel, statusLabel } from '../../../../lib/fr-pres';
import latest from '../../../../../web_data/france-presidential/latest.json';

export function getStaticPaths() {
  return getAllCandidates().map((candidate) => ({
    params: { id: candidate.slug },
    props: { candidate },
  }));
}

const { candidate } = Astro.props;
const meta = (latest as any).meta;
const canonical = `https://vote-scope.com/es/france/candidatos/${candidate.slug}/`;
const desc = `${candidate.name} — elección presidencial francesa de 2027: ${statusLabel(candidate.status, 'es').toLowerCase()}, ${blocLabel(candidate.bloc, 'es')}. Intención de voto en primera vuelta y duelos de segunda vuelta en ${candidate.activeScenarios} combinaciones. Ejecución del ${meta.run_date}.`;
---

<EditorialLayout
  title={`${candidate.name} — Presidencial Francia 2027 — Vote-Scope`}
  description={desc}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{
    en: `https://vote-scope.com/en/france/candidates/${slugify(candidate.name)}/`,
    fr: `https://vote-scope.com/fr/france/candidats/${slugify(candidate.name)}/`,
    es: canonical,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: candidate.name,
      url: canonical,
      description: `Candidato·a en la elección presidencial francesa de 2027 (${blocLabel(candidate.bloc, 'es')}).`,
    },
  ]}
>
  <FranceCandidatePage candidate={candidate} locale="es" />
</EditorialLayout>
