---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FranceCandidacyEffect from '../../../components/FranceCandidacyEffect.astro';
import effects from '../../../../web_data/france-presidential/candidacy_effects.json';

const m = (effects as any).meta;
// La plus grosse sortie mesurée donne la phrase de la description.
const top = ((effects as any).exits ?? [])
  .filter((e: any) => e.destinations?.length)
  .sort((a: any, b: any) => b.own.mean - a.own.mean)[0];
const lead = top ? `Sin ${top.short}, el ${Math.round(top.destinations[0].share_of_votes * 100)} % de sus votantes va a ${top.destinations[0].short}. ` : '';
const canonical = 'https://vote-scope.com/es/france/efecto-candidatura/';
---

<EditorialLayout
  title="Presidenciales Francia 2027: de quién toma sus votos cada candidatura — Vote-Scope"
  description={`De quién toma sus votos cada candidatura, medido dentro de las propias encuestas. ${lead}Cálculo sobre ${m.n_polls} encuestas de los últimos doce meses.`}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/france-desk/es.png"
  alternates={{ en: 'https://vote-scope.com/en/france/candidacy-effect/', fr: 'https://vote-scope.com/fr/france/effet-candidature/', es: 'https://vote-scope.com/es/france/efecto-candidatura/' }}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Presidenciales Francia 2027: de quién toma sus votos cada candidatura',
    url: canonical,
    dateModified: m.run_date,
    creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
    publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
    isAccessibleForFree: true,
  }]}
>
  <FranceCandidacyEffect locale="es" />
</EditorialLayout>
