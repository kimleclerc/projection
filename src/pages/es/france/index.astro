---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import FranceDesk from '../../../components/FranceDesk.astro';
import latest from '../../../../web_data/france-presidential/latest.json';
import DeskSections from '../../../components/DeskSections.astro';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/es/france/';
---

<EditorialLayout
  title="Elección presidencial francesa 2027 — Proyección Vote-Scope"
  description={`Proyección por escenarios de la elección presidencial francesa de 2027: primera vuelta, duelos de segunda vuelta y combinaciones hipotéticas. ${meta.n_first_round_polls} sondeos agregados, ejecución del ${meta.run_date}.`}
  canonical={canonical}
  lang="es"
  currentPage="france"
  ogImage="https://vote-scope.com/og/france-desk/es.png"
  alternates={{
    en: 'https://vote-scope.com/en/france/',
    fr: 'https://vote-scope.com/fr/france/',
    es: canonical,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección presidencial Francia 2027',
      description: 'Proyección por escenarios: primera vuelta y duelos de segunda vuelta.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      copyrightHolder: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terminos/',
      isAccessibleForFree: true,
    },
  ]}
>
  <FranceDesk locale="es" />
  <DeskSections lang="es" desk="france" />
</EditorialLayout>
