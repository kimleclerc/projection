---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import AboutVoteScope from '../../components/AboutVoteScope.astro';

const canonical = 'https://vote-scope.com/es/acerca-de/';
const alternates = {
  en: 'https://vote-scope.com/en/about/',
  fr: 'https://vote-scope.com/fr/a-propos/',
  es: canonical,
};
const subjectOf = [
  { '@type': 'Article', name: 'Lanzamiento del modelo de proyecciones electorales Vote-Scope', url: 'https://pilulerouge.ca/projections-electorales-kim-leclerc-lance-un-nouveau-site-pour-decoder-la-carte-politique/', datePublished: '2026-04-23' },
  { '@type': 'VideoObject', name: 'Gobernanza y gestión de crisis en Air Canada', url: 'https://www.cbc.ca/player/play/video/9.7143764' },
  { '@type': 'VideoObject', name: 'Debates políticos y preparación de los líderes', url: 'https://www.cbc.ca/player/play/video/9.6999303' },
  { '@type': 'Article', name: 'Costos del F-35 y alternativas para los países aliados', url: 'https://www.aa.com.tr/en/americas/experts-believe-countries-could-seek-alternatives-amid-rising-costs-of-us-made-f-35-fighter-jets/3621045', datePublished: '2025-07-03' },
];
---

<EditorialLayout
  title="Acerca de Vote-Scope — Proyecciones electorales independientes"
  description="Quién crea Vote-Scope, cómo evaluar sus proyecciones independientes y una selección de entrevistas de Kim Leclerc en medios."
  canonical={canonical}
  lang="es"
  currentPage="about"
  alternates={alternates}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Acerca de Vote-Scope', url: canonical, inLanguage: 'es', mainEntity: { '@id': 'https://vote-scope.com/#organization' } },
    { '@context': 'https://schema.org', '@type': 'Organization', '@id': 'https://vote-scope.com/#organization', name: 'Vote-Scope', url: 'https://vote-scope.com/', logo: 'https://vote-scope.com/favicon.svg', founder: { '@id': 'https://vote-scope.com/#kim-leclerc' } },
    { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://vote-scope.com/#kim-leclerc', name: 'Kim Leclerc', url: 'https://kimleclerc.ca', sameAs: ['https://x.com/kimleclerc'], knowsAbout: ['Proyecciones electorales', 'Encuestas', 'Modelización bayesiana', 'Análisis político', 'Adquisiciones de defensa'], subjectOf },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Acerca de', item: canonical },
    ]},
  ]}
>
  <AboutVoteScope lang="es" />
</EditorialLayout>
