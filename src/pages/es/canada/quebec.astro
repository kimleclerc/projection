---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import quebecMeta from '../../../../web_data/quebec/latest.json';

const j = jurisdictions.quebec;
const canonical = 'https://vote-scope.com/es/canada/quebec/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/quebec/',
  fr: 'https://vote-scope.com/fr/canada/quebec/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/share/map/quebec/es.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Próximas elecciones de Quebec: proyección de los 127 distritos',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: quebecMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/quebec/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canadá',     item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Quebec',     item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es" />
  <RidingsCta
    eyebrow="5 de octubre de 2026"
    title="El PQ forma un gobierno minoritario"
    blurb="Los ganadores de los 127 distritos, los escaños y el voto popular de la última elección. El balance compara nuestra proyección de la víspera con los resultados oficiales, distrito por distrito."
    href="/es/canada/quebec/resultados/"
    cta="Ver los resultados de 2026"
  />
  <RidingsCta
    eyebrow="Balance de 2026"
    title="Lo que nuestra proyección acertó, y lo que se le escapó"
    blurb="Voto popular, escaños y ganadores locales, comparados con los resultados oficiales del 5 de octubre y las últimas encuestas."
    href="/es/track-record/quebec-2026/"
    cta="Leer el balance"
  />
  <RidingsCta
    eyebrow="El simulador"
    title="¿Y si Quebec votara de otra manera?"
    blurb="Mueve el voto en una página dedicada y mira cómo reaccionan los escaños, el mapa y los 127 distritos, sin confundir tu escenario con nuestra proyección."
    href="/es/herramientas/simulador-quebec"
    cta="Abrir el simulador"
  />
  <RidingsCta
    eyebrow="Perfil por distrito"
    title="Explora un distrito concreto"
    blurb="Proyección, el diputado elegido el 5 de octubre, candidaturas y votos de 2026, y distritos vecinos, para cada uno de los 127 distritos."
    href="/es/canada/quebec/distritos/"
    cta="Ver los 127 distritos"
  />
  <NewsletterCta lang="es" placement="quebec" />
</EditorialLayout>
