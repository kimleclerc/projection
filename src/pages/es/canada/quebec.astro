---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import quebecMeta from '../../../../web_data/quebec/latest.json';
import advanceVote from '../../../../web_data/quebec/advance_vote.json';
const nfEs = (x: number) => x.toLocaleString('es', { maximumFractionDigits: 1 });

const j = jurisdictions.quebec;
const canonical = 'https://vote-scope.com/es/canada/quebec/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/quebec/',
  fr: 'https://vote-scope.com/fr/canada/quebec/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/projections/quebec/es.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección Quebec 2026',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: quebecMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/quebec/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canadá',     item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Quebec',     item: canonical },
      ],
    },
  ]}
>
  <RidingsCta
    eyebrow="La noche del 5 de octubre"
    title="Resultados en directo, desde las 20:00"
    blurb="Guarda la página de resultados en tus favoritos: desde el cierre de las urnas a las 20:00 del 5 de octubre, sigue los 127 distritos mesa por mesa, los escaños y nuestras adjudicaciones a medida que se deciden."
    href="/es/canada/quebec/resultados/"
    cta="Abrir la página de resultados →"
  />
  <ProjectionEngine jurisdiction={j} locale="es" />
  <RidingsCta
    eyebrow="Voto anticipado"
    title={`Cerca del ${advanceVote.meta.provincial.advance_share_est_pct} % de los votos ya está en las urnas`}
    blurb={`El ${nfEs(advanceVote.meta.provincial.advance_turnout_pct)} % de los electores inscritos votó por anticipado el 27 y 28 de septiembre. La participación en cada una de las 127 circunscripciones, en el mapa y por región.`}
    href="/es/canada/quebec/voto-anticipado/"
    cta="Ver la participación por circunscripción →"
  />
  <RidingsCta
    eyebrow="El simulador"
    title="¿Y si Quebec votara de otra manera?"
    blurb="Mueve el voto en una página propia y observa cómo reaccionan los escaños, el mapa y los 127 distritos — sin confundir tu escenario con nuestra proyección."
    href="/es/herramientas/simulador-quebec"
    cta="Abrir el simulador →"
  />
  <RidingsCta
    eyebrow="Perfil por distrito"
    title="Profundiza en un distrito específico"
    blurb="Proyección, diputado·a en funciones, candidatos 2022, demografía y distritos vecinos — para cada uno de los 127 distritos provinciales de Quebec del mapa 2026."
    href="/es/canada/quebec/distritos/"
    cta="Explorar los 127 distritos →"
  />
  <RidingsCta
    eyebrow="Barómetro de candidaturas"
    title="Género y acceso a distritos ganables"
    blurb="La carrera hacia 127 candidaturas, partido por partido — y si cada partido da a sus candidatas los distritos donde es realmente competitivo. Calibrado con 2018 y 2022."
    href="/es/canada/quebec/barometro-candidaturas/"
    cta="Abrir el Barómetro de candidaturas →"
  />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug={null} />
  </div>
  <NewsletterCta lang="es" placement="quebec" />
</EditorialLayout>
