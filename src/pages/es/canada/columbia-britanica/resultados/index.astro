---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import BritishColumbiaElectionNight from '../../../../../components/BritishColumbiaElectionNight.astro';

const canonical = "https://vote-scope.com/es/canada/columbia-britanica/resultados/";
const title = "Elecciones Columbia Británica 2026: resultados en directo | Vote-Scope";
const description = "Resultados en directo de la elección en Columbia Británica del 24 de octubre de 2026: votos, escaños y ganadores en los 93 distritos desde las 20:00 hora del Pacífico, y las contiendas pendientes del recuento final.";
const eventName = "Elección general de Columbia Británica de 2026";
const ogImage = "https://vote-scope.com/og/share/map/british-columbia/es.png";
const alternates = {
  fr: "https://vote-scope.com/fr/canada/colombie-britannique/resultats/",
  en: "https://vote-scope.com/en/canada/british-columbia/results/",
  es: "https://vote-scope.com/es/canada/columbia-britanica/resultados/",
};
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="canada"
  ogImage={ogImage}
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'es',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
      about: {
        '@type': 'Event',
        name: eventName,
        description,
        image: [ogImage],
        startDate: '2026-10-24T20:00:00-07:00',
        endDate: '2026-10-25T02:00:00-07:00',
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@type': 'Place', name: "Columbia Británica", address: { '@type': 'PostalAddress', addressRegion: 'BC', addressCountry: 'CA' } },
        organizer: { '@type': 'GovernmentOrganization', name: 'Elections BC', url: 'https://elections.bc.ca/' },
        performer: [
          { '@type': 'PoliticalParty', name: 'BC NDP' },
          { '@type': 'PoliticalParty', name: 'Conservative Party of BC' },
          { '@type': 'PoliticalParty', name: 'BC Greens' },
        ],
        offers: { '@type': 'Offer', price: 0, priceCurrency: 'CAD', availability: 'https://schema.org/InStock', url: canonical, validFrom: '2026-10-20T00:00:00-07:00' },
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: "Columbia Británica", item: "https://vote-scope.com/es/canada/columbia-britanica/" },
        { '@type': 'ListItem', position: 4, name: eventName, item: canonical },
      ],
    },
  ]}
>
  <BritishColumbiaElectionNight locale="es" />
</EditorialLayout>
