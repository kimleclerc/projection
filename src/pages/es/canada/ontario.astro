---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ontarioMeta from '../../../../web_data/ontario/latest.json';

const j = jurisdictions.ontario;
const canonical = 'https://vote-scope.com/es/canada/ontario';
const alternates = {
  en: 'https://vote-scope.com/en/canada/ontario',
  fr: 'https://vote-scope.com/fr/canada/ontario',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección Ontario 2026',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: ontarioMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/ontario/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canadá',     item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Ontario',    item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es" />
  <RidingsCta
    eyebrow="Parciales provinciales"
    title="Tres parciales de Ontario el 3 de septiembre"
    blurb="Hamilton East—Stoney Creek, Scarborough Southwest y York—Simcoe. Dos escaños progresistas conservadores se defienden sin quien los ganó — uno de ellos en medio de la controversia de los hoteles. Proyecciones carrera por carrera."
    href="/es/canada/ontario/byelections/"
    cta="Ver las tres proyecciones →"
  />
  <RidingsCta
    eyebrow="Perfil por distrito"
    title="Profundiza en un distrito específico"
    blurb="Proyección, diputado·a en funciones, candidatos 2025, trayectoria del modelo y distritos vecinos — para cada uno de los 124 distritos provinciales de Ontario del mapa 2029."
    href="/es/canada/ontario/distritos/"
    cta="Explorar los 124 distritos →"
  />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug={null} />
  </div>
</EditorialLayout>

