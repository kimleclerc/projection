---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import SeatUncertaintyPage from '../../../../../components/SeatUncertaintyPage.astro';
import NewsletterCta from '../../../../../components/NewsletterCta.astro';
import { jurisdictions } from '../../../../../data/jurisdictions';
import projectionMeta from '../../../../../../web_data/ontario/latest.json';

const j = jurisdictions.ontario;
const canonical = 'https://vote-scope.com/es/canada/ontario/incertidumbre/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/ontario/uncertainty/',
  fr: 'https://vote-scope.com/fr/canada/ontario/incertitude/',
  es: 'https://vote-scope.com/es/canada/ontario/incertidumbre/',
};
const description = 'Rangos de escaños al 80 % y 95 %, probabilidad de quedar primero o segundo y la trayectoria de nuestras proyecciones de Ontario corrida tras corrida.';
---

<EditorialLayout
  title={'Incertidumbre de la proyección de Ontario — rangos de escaños y trayectoria — Vote-Scope'}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="canada"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Incertidumbre de la proyección de Ontario',
      description,
      url: canonical,
      dateModified: projectionMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terminos/',
      isAccessibleForFree: true,
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://vote-scope.com/web_data/ontario/latest.json',
        encodingFormat: 'application/json',
      },
      isBasedOn: 'https://vote-scope.com/es/canada/ontario/',
    },
  ]}
>
  <SeatUncertaintyPage jurisdiction={j} locale="es" />
  <NewsletterCta lang="es" placement="ontario-uncertainty" />
</EditorialLayout>
