---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import RidingPage from '../../../../../components/riding/RidingPage.astro';
import { getAllQuebecRidings } from '../../../../../lib/riding-adapters/quebec';

export function getStaticPaths() {
  return getAllQuebecRidings().map((data) => ({
    params: { id: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const canonical = `https://vote-scope.com/es/canada/quebec/distritos/${data.slug}/`;
const alternateEn = `https://vote-scope.com/en/canada/quebec/ridings/${data.slug}/`;
const alternateFr = `https://vote-scope.com/fr/canada/quebec/circonscriptions/${data.slug}/`;
const title = `${data.name.fr || data.name.en} — Proyección provincial (Quebec) — Vote-Scope`;
const description = `Proyección Vote-Scope para ${data.name.fr || data.name.en} (Quebec): cuota de voto, probabilidad de victoria, diputado·a en funciones y candidatos 2022.`;
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: alternateEn, fr: alternateFr, es: canonical }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: data.name.fr || data.name.en,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Quebec' },
      url: canonical,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canadá',     item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Quebec',     item: 'https://vote-scope.com/es/canada/quebec/' },
        { '@type': 'ListItem', position: 4, name: 'Distritos',  item: 'https://vote-scope.com/es/canada/quebec/distritos/' },
        { '@type': 'ListItem', position: 5, name: data.name.fr || data.name.en, item: canonical },
      ],
    },
  ]}
>
  <RidingPage data={data} lang="es" />
</EditorialLayout>
