---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import QuebecElectionNight from '../../../../../components/QuebecElectionNight.astro';

const canonical = "https://vote-scope.com/es/canada/quebec/resultados/";
const title = "Resultados de la elección de Quebec del 5 de octubre de 2026 — Vote-Scope";
const description = "Recuento en directo de los 127 distritos de Quebec el 5 de octubre de 2026: votos, mesas escrutadas, escaños y adjudicaciones. El desarrollo de la noche y la proyección actual.";
const eventName = "Elección general de Quebec de 2026";
const alternates = {
  fr: "https://vote-scope.com/fr/canada/quebec/resultats/",
  en: "https://vote-scope.com/en/canada/quebec/results/",
  es: "https://vote-scope.com/es/canada/quebec/resultados/",
};
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="canada"
  ogImage="https://vote-scope.com/og/projections/quebec/es.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'es',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
      about: {
        '@type': 'Event',
        name: eventName,
        startDate: '2026-10-05T20:00:00-04:00',
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@type': 'Place', name: 'Québec', address: { '@type': 'PostalAddress', addressRegion: 'QC', addressCountry: 'CA' } },
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canada', item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: eventName, item: canonical },
      ],
    },
  ]}
>
  <QuebecElectionNight locale="es" />
</EditorialLayout>
