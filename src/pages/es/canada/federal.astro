---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import federalMeta from '../../../../web_data/federal/latest.json';

const j = jurisdictions.federal;
const canonical = 'https://vote-scope.com/es/canada/federal/';
const alternates = {
  en: 'https://vote-scope.com/en/canada/federal/',
  fr: 'https://vote-scope.com/fr/canada/federal/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección federal Canadá 2025',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: federalMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/federal/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Canadá',     item: 'https://vote-scope.com/es/canada/' },
        { '@type': 'ListItem', position: 3, name: 'Proyección federal', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es" />
  <RidingsCta
    eyebrow="Perfil por distrito"
    title="Profundiza en un distrito específico"
    blurb="Proyección, diputado·a en funciones, candidatos de la última elección, demografía, trayectoria de las proyecciones y distritos vecinos — para cada uno de los 343 distritos federales."
    href="/es/canada/federal/distritos/"
    cta="Explorar los 343 distritos →"
  />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug={null} />
  </div>
  <NewsletterCta lang="es" placement="federal" />
</EditorialLayout>

