---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import KeepDigging from '../../../components/KeepDigging.astro';
import ResolvedCalls from '../../../components/ResolvedCalls.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber.tsx';

import sportsData from '../../../../web_data/sports/latest.json';

const meta = sportsData.board_meta;
const board = sportsData.board as Array<{ p_cup_win: number; label_en: string }>;
const nTeams = board.length;
---

<EditorialLayout
  title="Historial Sports Scope — Vote-Scope"
  description="Cada pronóstico Sports Scope publicado, rastreado y verificado: rendimiento del modelo NHL playoffs Copa Stanley, simulaciones y precisión histórica — Vote-Scope."
  canonical="https://vote-scope.com/es/sports/track-record/"
  lang="es"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/track-record/', fr: 'https://vote-scope.com/fr/sports/track-record/', es: 'https://vote-scope.com/es/sports/track-record/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Historial Sports Scope — Vote-Scope',
      url: 'https://vote-scope.com/es/sports/track-record/',
      inLanguage: 'es',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/es/sports/' },
        { '@type': 'ListItem', position: 3, name: 'Historial', item: 'https://vote-scope.com/es/sports/track-record/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Sports Scope · Historial"
    title="El modelo, con el expediente en mano."
    promise="Historial Sports Scope — playoffs NHL Stanley Cup. Cada simulación lanzada, cada pronóstico publicado, archivados."
    question="¿El modelo realmente elige ganadores?"
    primaryHref="/es/sports/nhl/"
    primaryLabel="Desk NHL"
    secondaryHref="/es/sports/"
    secondaryLabel="Hub deportivo"
  />

  <section class="content-band">
    <div class="container">
      <p class="section-label">Actividad del modelo</p>
      <div class="content-grid-3">
        <div class="note-card note-card--stat">
          <p class="eyebrow">Simulaciones ejecutadas</p>
          <strong class="stat-value">
            <AnimatedNumber value={meta.n_sims} format="thousands" client:visible />
          </strong>
          <p>por ciclo, BSTS + capa de portero</p>
        </div>
        <div class="note-card note-card--stat">
          <p class="eyebrow">Equipos seguidos</p>
          <strong class="stat-value">
            <AnimatedNumber value={nTeams} client:visible />
          </strong>
          <p>equipos en el cuadro actual</p>
        </div>
        <div class="note-card note-card--stat">
          <p class="eyebrow">Versión del modelo</p>
          <strong class="stat-value stat-value--mono">{meta.version}</strong>
          <p>Última ejecución: {meta.run_date}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="section-label">Qué cubre Sports Scope</p>
      <div class="content-grid-2">
        <div class="note-card">
          <p class="eyebrow">Playoffs NHL Stanley Cup</p>
          <h3>Probabilidades de camino a la Copa.</h3>
          <p>
            Un modelo bayesiano de series temporales estructurales (BSTS) combinado con una capa de volatilidad del portero (HDSV%) y 10,000 simulaciones Monte Carlo. El modelo sigue el camino de cada equipo hacia la Stanley Cup con probabilidades por ronda actualizadas tras cada resultado de serie.
          </p>
        </div>
        <div class="note-card">
          <p class="eyebrow">Metodología</p>
          <h3>BSTS + capa de portero.</h3>
          <p>
            El modelo combina estimaciones de fortaleza EWMA a partir de registros de partidos con un modificador de portero derivado del porcentaje de paradas en alta peligrosidad. Las señales de mercado de 2 libros se integran cuando están disponibles. Sin caja negra: cada ponderación está documentada.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="section-label">Pronósticos resueltos</p>
      <p style="max-width:680px;color:var(--ink-2);font-size:15px;line-height:1.65;margin:0 0 4px;">
        Cada pronóstico se congela desde el historial git que prueba que fue público antes del resultado — probabilidad del modelo frente al mercado en el mismo instante. El alcance de los mercados es contexto, nunca un titular; deportes y elecciones se cuentan por separado.
      </p>
    </div>
    <ResolvedCalls locale="es" domain="sport" />
  </section>

  <div class="container" style="max-width: 1080px; margin-bottom: 80px;">
    <KeepDigging
      eyebrow="Seguir explorando"
      title="De vuelta a Sports Scope."
      body="El desk NHL tiene probabilidades Copa en vivo, volatilidad del portero y señales de mercado actualizadas tras cada ronda."
      links={[
        {
          href: '/es/sports/nhl/',
          label: 'Desk NHL',
          detail: 'Camino Copa · Volatilidad portero · Mercados',
        },
        {
          href: '/es/sports/',
          label: 'Hub deportivo',
          detail: 'Todos los instrumentos deportivos',
        },
        {
          href: '/en/track-record/',
          label: 'Historial político',
          detail: '6 de 6 · Pronósticos verificados',
        },
      ]}
    />
  </div>
</EditorialLayout>

<style>
  .section-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin-bottom: 20px;
  }

  .content-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .note-card--stat {
    padding: 24px;
  }

  .stat-value {
    display: block;
    font-family: var(--serif);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin: 14px 0 10px;
  }

  .stat-value--mono {
    font-family: var(--mono);
    font-size: 32px;
    letter-spacing: 0;
  }

  .coming-soon-box {
    border: 1px solid color-mix(in oklab, var(--duck) 30%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--duck) 6%, var(--card));
    padding: 28px 32px;
    max-width: 680px;
  }

  .coming-soon-box h2 {
    margin: 0 0 12px;
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 430;
    color: var(--duck-deep);
    letter-spacing: -0.01em;
  }

  .coming-soon-box p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .content-grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
