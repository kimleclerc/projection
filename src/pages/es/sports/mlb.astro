---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import MlbDesk from '../../../components/MlbDesk.astro';
import mlbData from '../../../../web_data/sports/mlb2026_latest.json';

const meta = mlbData.board_meta;
const canonical = 'https://vote-scope.com/es/sports/mlb/';
---

<EditorialLayout
  title="MLB 2026 — Proyección Serie Mundial — Vote-Scope"
  description={`Proyecta el camino de los 30 equipos de MLB hacia la Serie Mundial 2026 — probabilidades de postemporada, división, banderín y título. ${meta.sims.toLocaleString('es-ES')} simulaciones cada noche — Vote-Scope.`}
  canonical={canonical}
  lang="es"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/mlb-desk/es.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/mlb/', fr: 'https://vote-scope.com/fr/sports/mlb/', es: canonical }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección MLB 2026 — Serie Mundial',
      description: `Modelo de probabilidades de la Serie Mundial para los 30 equipos de MLB: ${meta.sims.toLocaleString('es-ES')} simulaciones por run, ${meta.model}, datos de ${meta.source}.`,
      url: canonical,
      dateModified: mlbData.generated_at,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      license: 'https://vote-scope.com/es/terminos/',
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/sports/mlb2026_latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/es/sports/' },
        { '@type': 'ListItem', position: 3, name: 'MLB', item: canonical },
      ],
    },
  ]}
>
  <MlbDesk locale="es" />
</EditorialLayout>
