---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MarketCheck from '../../../components/MarketCheck.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';

import sportsData from '../../../../web_data/sports/latest.json';
import mlbData from '../../../../web_data/sports/mlb2026_latest.json';
import { teamLabel, fmtProb, type MlbData } from '../../../lib/mlb';
import DeskSections from '../../../components/DeskSections.astro';

const hero = sportsData.hero;
const boardMeta = sportsData.board_meta;

const mlb = mlbData as unknown as MlbData;
const mlbByCode = new Map(mlb.board.map((t) => [t.code, t]));
const mlbFav = mlbByCode.get(mlb.hero.favorite.code)!;
const mlbJays = mlbByCode.get(mlb.hero.canadian_focus.code);
---

<EditorialLayout
  title="Sports Scope — proyecciones MLB, NHL y Copa del Mundo — Vote-Scope"
  description="Proyecta caminos a la Serie Mundial de MLB y a la Stanley Cup, sigue la volatilidad de porteros y compara diferencias entre modelo y mercado. Actualizado diariamente — Vote-Scope."
  canonical="https://vote-scope.com/es/sports/"
  lang="es"
  currentPage="sports"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/sports/', fr: 'https://vote-scope.com/fr/sports/', es: 'https://vote-scope.com/es/sports/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sports Scope — Vote-Scope',
      url: 'https://vote-scope.com/es/sports/',
      inLanguage: 'es',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Sports Scope', item: 'https://vote-scope.com/es/sports/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Sports Scope"
    title="¿Quién tiene el camino más despejado y quién vive de una racha frágil?"
    promise="Un desk más deportivo: caminos de serie, volatilidad de porteros, marcadores en vivo, controles de mercado y caos de torneo."
    question="¿El favorito está realmente construido para la siguiente ronda?"
    primaryHref="/es/sports/mlb/"
    primaryLabel="Desk MLB"
    secondaryHref="/es/sports/wc2026/"
    secondaryLabel="Archivo Copa del Mundo"
  />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">MLB 2026 · desk en vivo · run nocturno</p>
      <h2>{mlbFav.emoji} {teamLabel(mlbFav, 'es')} lideran la carrera por la Serie Mundial con {fmtProb(mlbFav.p_ws, 'es')}.</h2>
      <p>
        Los 30 equipos, {mlb.board_meta.sims.toLocaleString('es-ES')} simulaciones cada noche — probabilidades de postemporada, división, banderín y título.
        {mlbJays && (
          <>Pulso canadiense: los {teamLabel(mlbJays, 'es')} están en <strong>{fmtProb(mlbJays.p_series, 'es')}</strong> de alcanzar la postemporada.</>
        )}
      </p>
      <p style="margin-top:0.5rem;">
        <a href="/es/sports/mlb/" class="cta-link">Abrir el desk MLB →</a>
      </p>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Copa del Mundo 2026 · terminada · 19 de julio</p>
      <h2>España es campeona del mundo.</h2>
      <p>España venció 1–0 a Argentina tras la prórroga. El archivo conserva todo el registro del modelo: España primera al inicio con 7,36%, pero Argentina ligeramente favorita en el último run previo, 53,59–46,41.</p>
      <p style="margin-top:0.5rem;">
        <a href="/es/sports/wc2026/" class="cta-link">Abrir el archivo del Mundial →</a>
        &nbsp;·&nbsp;
        <a href="/es/sports/wc2026/equipos/" class="cta-link">Historias de las selecciones →</a>
      </p>
    </div>
  </section>


  <section class="content-band">
    <div class="container content-grid-2">
      <div class="note-card">
        <p class="eyebrow">Historial deportivo</p>
        <h3><a href="/es/sports/track-record/">Historial del modelo.</a></h3>
        <p>Simulaciones de playoffs NHL y pronósticos de series: cada ciclo del modelo y cada predicción publicada, archivados.</p>
        <p style="margin-top:1rem;">
          <a href="/es/sports/track-record/" class="cta-link">Ver historial →</a>
        </p>
      </div>
      <a class="note-card" href="/es/sports/wc2026/" style="text-decoration:none;color:inherit;">
        <p class="eyebrow">Torneo internacional de fútbol 2026</p>
        <h3>🇪🇸 España — campeona del mundo 2026</h3>
        <p>Final: España 1–0 Argentina tras la prórroga · instantáneas inicial y previa a la final archivadas.</p>
        <footer style="margin-top:1rem;">
          <span class="cta-link">Abrir archivo del torneo →</span>
        </footer>
      </a>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <PolymarketEmbed slug="nhl-2027-champion-20260612185656162" kind="event" title="Polymarket — Campeón NHL 2027" lang="es" eventUrl="https://polymarket.com/event/nhl-2027-champion-20260612185656162" />
    </div>
  </section>

  <section class="content-band" style="padding:1.5rem 0;">
    <div class="container">
      <div class="note-card" style="opacity:.85;">
        <p class="eyebrow">NHL — temporada 2025-26 terminada</p>
        <h3>{hero.favorite_label_en}: campeones de la Stanley Cup 2026.</h3>
        <p>Finalista: {hero.runner_up_label_en}. El desk y el historial completo del modelo siguen abiertos — los instrumentos NHL vuelven en el training camp.</p>
        <p style="margin-top:0.75rem;"><a href="/es/sports/nhl/" class="cta-link">Desk NHL →</a>&nbsp;·&nbsp;<a href="/es/sports/track-record/" class="cta-link">Historial →</a></p>
      </div>
    </div>
  </section>

  <MarketCheck
    kicker="Pulso del mercado deportivo"
    title="El mercado ve el mismo partido. El modelo ve el camino."
    body="Las cuotas de Polymarket y Kalshi acompañan al modelo como referencia independiente. Donde convergen, la señal es fuerte. Donde divergen, esa brecha es la historia."
    modelLabel="Modelo Vote-Scope"
    marketLabel="Pulso de mercado"
    note="Los datos de mercados de predicción se muestran solo como referencia. El modelo y el mercado se actualizan en cadencias independientes."
  />

  <DeskSections lang="es" desk="sports" />

  <MethodologyNote
    title="Tres desks deportivos. Un mismo estándar."
    body="MLB, Copa del Mundo y NHL comparten la misma disciplina Monte Carlo: los resultados se simulan miles de veces por ciclo, condicionados a los resultados reales según avanza la temporada."
    bullets={[
      'MLB 2026: 30 equipos, 10,000 simulaciones nocturnas — fuerza pythagenpat y enfrentamientos log5 sobre cada partido restante, datos de la MLB Stats API.',
      'NHL Cup Path: 50,000 simulaciones por ronda de playoffs, actualizadas tras cada resultado de serie. La capa de volatilidad del portero se condiciona en el porcentaje de paradas reciente y el estado de lesiones.',
      'Modelo de fase de grupos WC2026: simulación de 48 selecciones con 50,000 corridas, usando clasificación FIFA, forma reciente y ventaja de local.',
      'El historial es público: cada ciclo del modelo publicado y cada pronóstico de serie están archivados y son verificables.',
      'Las salidas del modelo están disponibles como JSON público en cada desk, actualizadas de forma continua.',
    ]}
  />
</EditorialLayout>
