---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import WcTeamsIndex from '../../../../components/WcTeamsIndex.astro';
import { wcTeamsAlternates } from '../../../../lib/wc';

const alts = wcTeamsAlternates();
---

<EditorialLayout
  title="Todos los equipos — pronóstico torneo 2026 — Vote-Scope"
  description="Todas las selecciones nacionales del torneo internacional de fútbol 2026, ordenadas por probabilidad de título dentro de cada confederación. Modelo Vote-Scope."
  canonical={alts.es}
  lang="es"
  currentPage="sports"
  alternates={alts}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Todos los equipos — pronóstico torneo 2026',
      description: 'Probabilidades de título para cada selección nacional en el torneo internacional de fútbol 2026.',
      url: alts.es,
      isAccessibleForFree: true,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Sports Scope', item: 'https://vote-scope.com/es/sports/' },
        { '@type': 'ListItem', position: 2, name: 'WC2026', item: 'https://vote-scope.com/es/sports/wc2026/' },
        { '@type': 'ListItem', position: 3, name: 'Equipos', item: alts.es },
      ],
    },
  ]}
>
  <WcTeamsIndex lang="es" />
</EditorialLayout>
