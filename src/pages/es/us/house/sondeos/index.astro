---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import PollsHub from '../../../../../components/PollsHub.astro';
import { getPollsMeta, getNationalPolls, getFirms, getPollsTrend } from '../../../../../lib/polls-adapter';
import { pollPartyChips } from '../../../../../lib/poll-parties';

const WEB_KEY = 'us-house';
const meta = getPollsMeta(WEB_KEY)!;
const polls = getNationalPolls(WEB_KEY);
const firms = getFirms(WEB_KEY);
const trend = getPollsTrend(WEB_KEY);
const chips = pollPartyChips(WEB_KEY, meta.parties, 'es');

const canonical = 'https://vote-scope.com/es/us/house/sondeos/';
---

<EditorialLayout
  title="Sondeos de la Cámara de Representantes 2026 — Vote-Scope"
  description="Todos los sondeos del voto genérico para la Cámara (ciclo 2026): encuestadora, fechas de campo, muestra e intención de voto. Actualizado en continuo."
  canonical={canonical}
  lang="es"
  currentPage="us"
  ogImage="https://vote-scope.com/og/us-house/polls/es.png"
  alternates={{
    en: 'https://vote-scope.com/en/us/house/polls/',
    fr: 'https://vote-scope.com/fr/us/chambre/sondages/',
    es: canonical,
  }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Sondeos de la Cámara de Representantes 2026',
      url: canonical,
      inLanguage: 'es',
      isPartOf: { '@type': 'WebSite', name: 'Vote-Scope', url: 'https://vote-scope.com/' },
    },
  ]}
>
  <section class="polls-hero">
    <div class="container">
      <p class="eyebrow">Sondeos · Cámara de Representantes de EE. UU. · ciclo 2026</p>
      <h1>El voto genérico para la Cámara.</h1>
      <p class="lede">¿Qué partido controlará la Cámara tras las legislativas de 2026? El <em>voto genérico</em> —preguntar a los votantes si apoyarían al candidato demócrata o republicano en su distrito— es el mejor termómetro nacional de la contienda.</p>
      <p class="lede">Vote-Scope reúne todos los sondeos nacionales publicados y, con su modelo, los convierte en una proyección de escaños. Abajo: la tendencia frente a la estimación del modelo, y la tabla completa sondeo por sondeo.</p>
    </div>
  </section>

  <PollsHub lang="es" meta={meta} polls={polls} firms={firms} parties={chips} trend={trend} pollsBase="/es/us/house/sondeos" />
</EditorialLayout>

<style>
  .polls-hero { padding: 80px 0 28px; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .polls-hero .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .polls-hero h1 { margin: 8px 0 16px; font-family: var(--serif); font-size: clamp(40px, 5vw, 64px); font-weight: 420; letter-spacing: -0.02em; line-height: 1.02; max-width: 900px; }
  .polls-hero .lede { max-width: 760px; font-family: var(--serif); font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; color: var(--ink-2); }
  .polls-hero .lede + .lede { margin-top: 14px; }
  .polls-hero .lede em { font-style: italic; }
</style>
