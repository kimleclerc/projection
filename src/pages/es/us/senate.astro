---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import senateMeta from '../../../../web_data/us-senate/latest.json';

const j = jurisdictions.usSenate;
const canonical = 'https://vote-scope.com/es/us/senate';
const alternates = {
  en: 'https://vote-scope.com/en/us/senate',
  fr: 'https://vote-scope.com/fr/us/senat',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección Senado de EE. UU. 2026',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: senateMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-senate/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: 'Senado de EE. UU.', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections" title="Senado 2026 — control del partido" />
  </div>

  <RidingsCta
    eyebrow="Perfil de escaño"
    title="Profundiza en una carrera del Senado"
    blurb="Proyección, resultado de referencia, clasificación de la carrera, escaños competitivos cercanos — para cada una de las 35 carreras contestadas en 2026 (33 regulares Clase III + 2 extraordinarias)."
    href="/es/us/senate/escanos/"
    cta="Explorar las 35 carreras →"
  />
</EditorialLayout>

