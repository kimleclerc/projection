---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import EditorialHero from '../../../components/EditorialHero.astro';
import MarketCheck from '../../../components/MarketCheck.astro';
import MethodologyNote from '../../../components/MethodologyNote.astro';
import AnimatedNumber from '../../../islands/AnimatedNumber';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import { specialElections } from '../../../data/specialElections';

import ldiData from '../../../../web_data/us-lame-duck/latest.json';
import houseData from '../../../../web_data/us-house/latest.json';
import senateData from '../../../../web_data/us-senate/latest.json';
import governorData from '../../../../web_data/us-governor/latest.json';
import showdownData from '../../../../web_data/cusma-showdown/latest.json';
import presData from '../../../../web_data/us-president/latest.json';
import primaryDesk from '../../../../web_data/us-primaries/latest.json';
import DeskSections from '../../../components/DeskSections.astro';

const nextPrimary = (primaryDesk as any).upcoming?.[0];
const nextPrimaryStates = [...new Set(((primaryDesk as any).upcoming ?? [])
  .filter((g: any) => g.primary_date === nextPrimary?.primary_date)
  .map((g: any) => g.state_name['es']))].join(' · ');

const ldi = ldiData.ldi;
const houseDem = (houseData.parties as Array<{party:string;seats_projected:number;p_majority:number;label_en:string;color:string}>).find((p) => p.party === 'us_dem')!;
const houseRep = (houseData.parties as Array<{party:string;seats_projected:number;p_majority:number;label_en:string;color:string}>).find((p) => p.party === 'us_rep')!;
const senateDem = (senateData.parties as Array<{party:string;seats_mean:number;p_majority:number;label_en:string;color:string}>).find((p) => p.party === 'us_dem')!;
const senateRep = (senateData.parties as Array<{party:string;seats_mean:number;p_majority:number;label_en:string;color:string}>).find((p) => p.party === 'us_rep')!;
const govParties = governorData.parties as Array<{party:string;seats_mean:number;p_majority:number;label_en:string;color:string}>;
const govDem = govParties.find((p) => p.party === 'us_dem')!;
const govRep = govParties.find((p) => p.party === 'us_rep')!;
// Les sièges ouverts sont le fait saillant du cycle gubernatorial : la moitié
// des courses n'a pas de sortant. Compté sur les données, jamais écrit en dur.
const govOpenSeats = (governorData.ridings as Array<{open_seat?:boolean}>).filter((r) => r.open_seat).length;

const specials = Object.values(specialElections);
const deltaSign = ldi.delta_7d >= 0 ? '+' : '';
const presRep = (presData as any).primary.rep;
const presDem = (presData as any).primary.dem;
const presRepLead = presRep.standings.find((s: any) => s.status !== 'ineligible') ?? presRep.standings[0];
const presDemLead = presDem.standings.find((s: any) => s.status !== 'ineligible') ?? presDem.standings[0];
---

<EditorialLayout
  title="Política de EE. UU. — Vote-Scope"
  description="Control de la Cámara, fragilidad del Senado, elecciones especiales y el Lame-Duck Index en un solo lugar. Proyecciones en vivo actualizadas con cada encuesta — Vote-Scope."
  canonical="https://vote-scope.com/es/us/"
  lang="es"
  currentPage="usa-hub"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/us/', fr: 'https://vote-scope.com/fr/us/', es: 'https://vote-scope.com/es/us/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Política de EE. UU. — Vote-Scope',
      url: 'https://vote-scope.com/es/us/',
      inLanguage: 'es',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Desk Estados Unidos"
    title="¿Quién controla Washington cuando el mapa deja de ser teórico?"
    promise="Cámara, Senado, elecciones especiales y peso presidencial — proyectados a partir de sondeos públicos y actualizados a medida que llegan los números."
    question="¿El mapa de EE. UU. es estable, frágil o mal leído por el mercado?"
    primaryHref="/es/us/indexes/lame-duck/"
    primaryLabel="Abrir Lame-Duck"
    secondaryHref="/en/indexes/"
    secondaryLabel="Todos los índices"
    preferredSourceLocale="es"
  />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Nuevo · Índice propio</p>
      <div class="note-card" style="border-left:4px solid #c64d2d;">
        <h2>Radar Latino USA</h2>
        <p>Las contiendas de Cámara y Senado donde coinciden el peso electoral latino, la competitividad y el control del Congreso — clasificadas sobre 100.</p>
        <p><a href="/es/us/radar-latino/" class="cta-link">Abrir el radar →</a></p>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <AffiliateCard partner="proton" lang="es" visual placement="us-desk" />
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Instrumento en vivo</p>
      <div class="content-grid-2" style="gap:1.5rem;align-items:start;">
        <div class="note-card" style={`border-left:4px solid ${ldi.zone_color};`}>
          <p class="eyebrow">Lame-Duck Index</p>
          <h2 style="font-size:3rem;margin:0.25rem 0;color:var(--text);">
            <AnimatedNumber client:visible value={ldi.score} decimals={1} />
            <span style="font-size:1.1rem;font-weight:400;">/100</span>
          </h2>
          <p style={`font-weight:700;color:${ldi.zone_color};font-size:1.1rem;`}>{ldi.label_en}</p>
          <p>Delta 7 días: <strong>{deltaSign}{ldi.delta_7d}</strong></p>
          <p style="margin-top:1rem;">
            <a href="/es/us/indexes/lame-duck/" class="cta-link">Índice completo →</a>
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div class="note-card" style={`border-left:4px solid ${houseDem.color};`}>
            <p class="eyebrow">Cámara 2026</p>
            <p>
              Dem <strong><AnimatedNumber client:visible value={houseDem.seats_projected} /></strong> ·
              Rep <strong><AnimatedNumber client:visible value={houseRep.seats_projected} /></strong>
              <span style="font-size:0.85rem;"> / 435</span>
            </p>
            <p>Probabilidad de mayoría D: <strong>{Math.round(houseDem.p_majority * 100)}%</strong></p>
            <a href="/es/us/house/" class="cta-link" style="font-size:0.85rem;">Proyección Cámara →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${senateDem.color};`}>
            <p class="eyebrow">Senado 2026</p>
            <p>
              Dem ~<strong><AnimatedNumber client:visible value={Math.round(senateDem.seats_mean)} /></strong> ·
              Rep ~<strong><AnimatedNumber client:visible value={Math.round(senateRep.seats_mean)} /></strong>
              <span style="font-size:0.85rem;"> / 100</span>
            </p>
            <p>Probabilidad de mayoría D: <strong>{Math.round(senateDem.p_majority * 100)}%</strong></p>
            <a href="/es/us/senate/" class="cta-link" style="font-size:0.85rem;">Proyección Senado →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${govDem.color};`}>
            <p class="eyebrow">Gobernadores 2026</p>
            <p>
              Dem. ~<strong><AnimatedNumber client:visible value={Math.round(govDem.seats_mean)} /></strong> ·
              Rep. ~<strong><AnimatedNumber client:visible value={Math.round(govRep.seats_mean)} /></strong>
              <span style="font-size:0.85rem;"> / 50</span>
            </p>
            <p style="font-size:0.85rem;">36 contiendas en la papeleta · {govOpenSeats} puestos abiertos.</p>
            <a href="/es/us/gobernadores/" class="cta-link" style="font-size:0.85rem;">Proyección de gobernadores →</a>
          </div>
          <div class="note-card">
            <p class="eyebrow">Primarias 2026</p>
            <p>{nextPrimary ? `Próxima: ${nextPrimaryStates}` : ""}</p>
            <p style="font-size:0.85rem;">{(primaryDesk as any).meta.n_races_decided} decididas hasta ahora.</p>
            <a href="/es/us/primarias/" class="cta-link" style="font-size:0.85rem;">Seguimiento de primarias →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${presRep.color};`}>
            <p class="eyebrow">Presidencial 2028 · Primaria invisible</p>
            <p>
              REP <strong>{presRepLead.short_label} {presRepLead.share.toFixed(0)} %</strong> ·
              DEM <strong>{presDemLead.short_label} {presDemLead.share.toFixed(0)} %</strong>
            </p>
            <p style="font-size:0.85rem;">Campos de primarias + mapa del colegio electoral.</p>
            <a href="/es/us/presidencial/" class="cta-link" style="font-size:0.85rem;">Desk presidencial →</a>
          </div>
          <div class="note-card" style={`border-left:4px solid ${showdownData.showdown.zone_color};`}>
            <p class="eyebrow">Duelo T-MEC</p>
            <p>Brecha de ventaja: <strong style={`color:${showdownData.showdown.zone_color};`}>{showdownData.showdown.gap > 0 ? '+' : ''}{showdownData.showdown.gap}</strong> — {showdownData.showdown.label_es}</p>
            <a href="/es/indexes/cusma-showdown/" class="cta-link" style="font-size:0.85rem;">Ganso vs Pato cojo →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Elecciones especiales</p>
      <h2>Especiales activas y recientes</h2>
      <div class="content-grid-2" style="gap:1rem;margin-top:1rem;">
        {specials.map((s) => (
          <a class="note-card" href={s.paths.es ?? s.paths.en ?? '#'} style="text-decoration:none;color:inherit;">
            <p class="eyebrow">{s.kicker}</p>
            <h3 style="margin:0.25rem 0;">{s.headline.replace(/\n/g, ' ')}</h3>
            <p style="font-size:0.9rem;">{s.dek.slice(0, 100)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container">
      <PolymarketEmbed slug="2026-balance-of-power-d-senate-d-house-949" title="Elecciones intermedias 2026 — equilibrio de poder" />
      <PolymarketEmbed slug="will-gavin-newsom-win-the-2028-us-presidential-election" title="Elección presidencial 2028" />
    </div>
  </section>

  <MarketCheck
    kicker="Modelo vs. mercado"
    title="Dónde difieren el modelo y el mercado."
    body="Probabilidades de control, confianza por carrera y los momentos en que los traders entran en pánico — junto a nuestra proyección, para que las brechas se vean de inmediato."
    modelLabel="Modelo Vote-Scope"
    marketLabel="Polymarket / cuotas"
    note="Referencias de Polymarket, actualizadas a diario junto a cada proyección."
  />

  <DeskSections lang="es" desk="us" />

  <MethodologyNote
    title="Cómo se construyen las proyecciones de EE. UU."
    body="Control de la Cámara y el Senado, fragilidad de escaños y desacuerdo con el mercado — cada uno construido a partir de sondeos públicos, un modelo bayesiano y simulaciones Monte Carlo, todo abierto en la página."
    bullets={[
      'Las encuestas de Cámara y Senado se agregan con un modelo BSTS bayesiano y se someten a 435 y 100 simulaciones por distrito respectivamente.',
      'El Lame-Duck Index (LDI) combina aprobación presidencial, indicadores económicos, márgenes de distrito y cuotas de mercados de predicción en un puntaje de 0 a 100.',
      'Las elecciones especiales usan un modelo de fundamentos: incumbencia, margen histórico, perfil de candidatos y encuestas locales disponibles.',
      'Los benchmarks de mercados de predicción (Polymarket) se muestran junto al modelo como señal de desacuerdo independiente, actualizada diariamente.',
    ]}
  />
</EditorialLayout>
