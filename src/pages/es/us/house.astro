---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import houseMeta from '../../../../web_data/us-house/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.usHouse;
const canonical = 'https://vote-scope.com/es/us/house/';
const alternates = {
  en: 'https://vote-scope.com/en/us/house/',
  fr: 'https://vote-scope.com/fr/us/chambre/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección Cámara de Representantes 2026',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: houseMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      isAccessibleForFree: true,
      license: 'https://vote-scope.com/es/terminos/',
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-house/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: 'Cámara de Representantes', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es"><Fragment slot="narrative"><RaceNarrative locale="es" {...raceEditorial.usHouse.es} /></Fragment></ProjectionEngine>
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug="will-the-democratic-party-control-the-house-after-the-2026-midterm-elections" title="Cámara 2026 — control del partido" />
  </div>

  <RidingsCta
    eyebrow="Perfil de distrito"
    title="Profundiza en un distrito"
    blurb="Proyección, representante en funciones, candidatos 2026, líder de la primaria (cuando se sondea), impacto del redistritado 2025-2026 — para cada uno de los 435 distritos de la Cámara."
    href="/es/us/house/distritos/"
    cta="Explorar los 435 distritos →"
  />
</EditorialLayout>

