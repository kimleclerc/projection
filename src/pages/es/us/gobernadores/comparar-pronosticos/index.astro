---
import EditorialLayout from '../../../../../layouts/EditorialLayout.astro';
import ForecasterComparison from '../../../../../components/ForecasterComparison.astro';
import NewsletterCta from '../../../../../components/NewsletterCta.astro';

const canonical = "https://vote-scope.com/es/us/gobernadores/comparar-pronosticos/";
const pageName = "Comparar pronósticos de gobernador 2026";
---

<EditorialLayout
  title={"Comparar pronósticos de gobernador 2026 — Vote-Scope"}
  description={"Todos los pronósticos de gobernador de 2026 en una página: el modelo de Vote-Scope, los precios de Kalshi, más Cook, Sabato, Inside Elections, DDHQ, Split Ticket y otros, cada uno con su enlace."}
  canonical={canonical}
  lang="es"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: "https://vote-scope.com/en/us/governors/compare-forecasts/", fr: "https://vote-scope.com/fr/us/gouverneurs/comparer-les-previsions/", es: "https://vote-scope.com/es/us/gobernadores/comparar-pronosticos/" }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: "EE. UU.", item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: pageName, item: canonical },
      ],
    },
  ]}
>
  <ForecasterComparison locale="es" jurisdiction="governor" />
  <NewsletterCta lang="es" placement="compare-governors" />
</EditorialLayout>
