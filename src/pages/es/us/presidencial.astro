---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import UsPresidentDesk from '../../../components/UsPresidentDesk.astro';
import latest from '../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/es/us/presidencial/';
const alternates = {
  en: 'https://vote-scope.com/en/us/president/',
  fr: 'https://vote-scope.com/fr/us/presidentielle/',
  es: canonical,
};
---

<EditorialLayout
  title="Presidencial de EE. UU. 2028 — Primaria invisible y colegio electoral — Vote-Scope"
  description={`Media ponderada por calidad de los sondeos de primarias de la presidencial de EE. UU. 2028 (DEM y REP), escenarios de campo, primeros estados y mapa del colegio electoral. ${meta.n_primary_polls} sondeos, ejecución del ${meta.run_date}.`}
  canonical={canonical}
  lang="es"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Presidencial de EE. UU. 2028 — Primaria invisible',
      description: 'Media ponderada por calidad de los sondeos de primarias de 2028 y marco del colegio electoral.',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: 'Presidencial', item: canonical },
      ],
    },
  ]}
>
  <UsPresidentDesk locale="es" />
</EditorialLayout>
