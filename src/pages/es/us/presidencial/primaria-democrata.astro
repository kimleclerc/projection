---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const block = (latest as any).primary.dem;
const elig = block.standings.filter((s: any) => s.status !== 'ineligible');
const [lead, second, third] = elig;
const pct = (s: any) => `${s.share.toFixed(1).replace('.', ',')}\u00a0%`;
const canonical = 'https://vote-scope.com/es/us/presidencial/primaria-democrata/';
const alternates = { en: 'https://vote-scope.com/en/us/president/democratic-primary/', fr: 'https://vote-scope.com/fr/us/presidentielle/primaire-democrate/', es: 'https://vote-scope.com/es/us/presidencial/primaria-democrata/' };
---

<EditorialLayout
  title="Primaria demócrata 2028: encuestas, candidato por candidato | Vote-Scope"
  description={`Media de encuestas de la primaria demócrata 2028: ${lead.name} lidera con ${pct(lead)}, por delante de ${second.name} y ${third.name}${third.name.endsWith('.') ? '' : '.'} Todos los candidatos medidos, escenarios y primeros estados.`}
  canonical={canonical}
  lang="es"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Primaria demócrata 2028: encuestas, candidato por candidato',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: 'Presidencial', item: 'https://vote-scope.com/es/us/presidencial/' },
        { '@type': 'ListItem', position: 4, name: 'Primaria demócrata', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="es" view="dem" />
</EditorialLayout>
