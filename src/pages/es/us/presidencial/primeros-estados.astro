---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import UsPrimaryView from '../../../../components/UsPrimaryView.astro';
import latest from '../../../../../web_data/us-president/latest.json';

const meta = (latest as any).meta;
const canonical = 'https://vote-scope.com/es/us/presidencial/primeros-estados/';
const alternates = { en: 'https://vote-scope.com/en/us/president/early-states/', fr: 'https://vote-scope.com/fr/us/presidentielle/premiers-etats/', es: 'https://vote-scope.com/es/us/presidencial/primeros-estados/' };
---

<EditorialLayout
  title="Primarias 2028: encuestas en Iowa, Nuevo Hampshire, Carolina del Sur y Nevada | Vote-Scope"
  description="Medias de encuestas estatales de las primeras primarias presidenciales de 2028, demócratas y republicanas: Iowa, Nuevo Hampshire, Carolina del Sur y Nevada, con el número de encuestas de cada una."
  canonical={canonical}
  lang="es"
  currentPage="us"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Primarias 2028: encuestas en Iowa, Nuevo Hampshire, Carolina del Sur y Nevada',
      url: canonical,
      dateModified: meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/us-president/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'EE. UU.', item: 'https://vote-scope.com/es/us/' },
        { '@type': 'ListItem', position: 3, name: 'Presidencial', item: 'https://vote-scope.com/es/us/presidencial/' },
        { '@type': 'ListItem', position: 4, name: 'Primeros estados', item: canonical },
      ],
    },
  ]}
>
  <UsPrimaryView locale="es" view="early" />
</EditorialLayout>
