---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import PollsterScorecards from '../../../components/PollsterScorecards.astro';

const canonical = 'https://vote-scope.com/es/metodologia/encuestadoras/';
const title = 'Boletín de encuestadoras: ¿qué encuestas creer? Léger, Pallas, Mainstreet… | Vote-Scope';
const description = 'Las encuestadoras clasificadas según su precisión, elección tras elección: Léger, Forum, Pallas, Research Co., Liaison, Synopsis y Mainstreet en Quebec 2026.';
const alternates = { fr: 'https://vote-scope.com/fr/methodologie/sondeurs/', en: 'https://vote-scope.com/en/methodology/pollsters/', es: 'https://vote-scope.com/es/metodologia/encuestadoras/' };
---

<EditorialLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="methodology"
  ogImage="https://vote-scope.com/og/projections/quebec/es.png"
  alternates={alternates}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'es' },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Metodología', item: 'https://vote-scope.com/es/metodologia/' },
        { '@type': 'ListItem', position: 3, name: 'Boletín de encuestadoras', item: 'https://vote-scope.com/es/metodologia/encuestadoras/' },
      ],
    },
  ]}
>
  <PollsterScorecards locale="es" />
</EditorialLayout>
