---
import EditorialLayout from '../../../../layouts/EditorialLayout.astro';
import SeatUncertaintyPage from '../../../../components/SeatUncertaintyPage.astro';
import NewsletterCta from '../../../../components/NewsletterCta.astro';
import { jurisdictions } from '../../../../data/jurisdictions';
import projectionMeta from '../../../../../web_data/uk/latest.json';

const j = jurisdictions.uk;
const canonical = 'https://vote-scope.com/es/uk/incertidumbre/';
const alternates = {
  en: 'https://vote-scope.com/en/uk/uncertainty/',
  fr: 'https://vote-scope.com/fr/uk/incertitude/',
  es: 'https://vote-scope.com/es/uk/incertidumbre/',
};
const description = 'Rangos de escaños al 80 % y 95 %, probabilidad de quedar primero o segundo y la trayectoria de nuestras proyecciones del Reino Unido corrida tras corrida.';
---

<EditorialLayout
  title={'Incertidumbre de la proyección del Reino Unido — rangos de escaños y trayectoria — Vote-Scope'}
  description={description}
  canonical={canonical}
  lang="es"
  currentPage="uk"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Incertidumbre de la proyección del Reino Unido',
      description,
      url: canonical,
      dateModified: projectionMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terminos/',
      isAccessibleForFree: true,
      distribution: {
        '@type': 'DataDownload',
        contentUrl: 'https://vote-scope.com/web_data/uk/latest.json',
        encodingFormat: 'application/json',
      },
      isBasedOn: 'https://vote-scope.com/es/uk/general-election/',
    },
  ]}
>
  <SeatUncertaintyPage jurisdiction={j} locale="es" />
  <NewsletterCta lang="es" placement="uk-uncertainty" />
</EditorialLayout>
