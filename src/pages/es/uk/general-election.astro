---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ukMeta from '../../../../web_data/uk/latest.json';

const j = jurisdictions.uk;
const canonical = 'https://vote-scope.com/es/uk/general-election/';
const alternates = {
  en: 'https://vote-scope.com/en/uk/general-election/',
  fr: 'https://vote-scope.com/fr/uk/general-election/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección elecciones generales R.U.',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: ukMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/uk/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope',           item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Reino Unido',          item: 'https://vote-scope.com/es/uk/' },
        { '@type': 'ListItem', position: 3, name: 'Elecciones generales', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es" />
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug={null} />
  </div>

  <section class="ridings-cta">
    <div class="container">
      <p class="eyebrow">Perfil por circunscripción</p>
      <h2>Profundiza en una circunscripción</h2>
      <p>Proyección, diputado·a en funciones, candidatos 2024 y circunscripciones vecinas — para cada una de las 650 circunscripciones de Westminster. Los escaños de Irlanda del Norte conservan su identidad partidista (DUP, Sinn Féin, SDLP, Alliance, UUP, TUV) incluso cuando el modelo usa el bucket «otros».</p>
      <a href="/es/uk/circunscripciones/" class="cta-btn">Explorar las 650 circunscripciones →</a>
    </div>
  </section>
</EditorialLayout>

<style>
  .ridings-cta { padding: 56px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--paper-2); }
  .ridings-cta h2 { margin: 8px 0 12px; font-family: var(--serif); font-size: clamp(28px,3.2vw,40px); font-weight: 420; letter-spacing: -0.01em; }
  .ridings-cta p { max-width: 720px; color: var(--ink-2); margin: 0 0 20px; line-height: 1.55; }
  .cta-btn { display: inline-block; padding: 12px 22px; background: var(--ink); color: var(--paper); text-decoration: none; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .cta-btn:hover { background: color-mix(in oklab, var(--ink) 80%, transparent); }
</style>
