---
import EditorialLayout from '../../../layouts/EditorialLayout.astro';
import RidingsCta from '../../../components/RidingsCta.astro';
import NewsletterCta from '../../../components/NewsletterCta.astro';
import ProjectionEngine from '../../../components/ProjectionEngine.astro';
import RaceNarrative from '../../../components/RaceNarrative.astro';
import PolymarketEmbed from '../../../components/PolymarketEmbed.astro';
import { jurisdictions } from '../../../data/jurisdictions';
import ukMeta from '../../../../web_data/uk/latest.json';
import { raceEditorial } from '../../../data/raceEditorial';

const j = jurisdictions.uk;
const canonical = 'https://vote-scope.com/es/uk/general-election/';
const alternates = {
  en: 'https://vote-scope.com/en/uk/general-election/',
  fr: 'https://vote-scope.com/fr/uk/general-election/',
  es: canonical,
};
---

<EditorialLayout
  title={j.pageTitle.es ?? j.pageTitle.en}
  description={j.metaDescription.es ?? j.metaDescription.en}
  canonical={canonical}
  lang="es"
  currentPage={j.currentPage}
  ogImage="https://vote-scope.com/og/projections/uk/es.png"
  alternates={alternates}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Proyección elecciones generales R.U.',
      description: j.metaDescription.es ?? j.metaDescription.en,
      url: canonical,
      dateModified: ukMeta.meta.run_date,
      creator: { '@type': 'Person', name: 'Kim Leclerc', url: 'https://kimleclerc.ca' },
      publisher: { '@type': 'Organization', name: 'Vote-Scope', url: 'https://vote-scope.com' },
      license: 'https://vote-scope.com/es/terms/',
      isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', contentUrl: 'https://vote-scope.com/web_data/uk/latest.json', encodingFormat: 'application/json' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope',           item: 'https://vote-scope.com/es/' },
        { '@type': 'ListItem', position: 2, name: 'Reino Unido',          item: 'https://vote-scope.com/es/uk/' },
        { '@type': 'ListItem', position: 3, name: 'Elecciones generales', item: canonical },
      ],
    },
  ]}
>
  <ProjectionEngine jurisdiction={j} locale="es"><Fragment slot="narrative"><RaceNarrative locale="es" {...raceEditorial.uk.es} /></Fragment></ProjectionEngine>
  <div class="container" style="max-width:1080px;margin-inline:auto;padding-inline:1.5rem;">
    <PolymarketEmbed slug={null} />
  </div>

  <RidingsCta
    eyebrow="Perfil por circunscripción"
    title="Profundiza en una circunscripción"
    blurb="Proyección, diputado·a en funciones, candidatos 2024 y circunscripciones vecinas — para cada una de las 650 circunscripciones de Westminster. Los escaños de Irlanda del Norte conservan su identidad partidista (DUP, Sinn Féin, SDLP, Alliance, UUP, TUV) incluso cuando el modelo usa el bucket «otros»."
    href="/es/uk/circunscripciones/"
    cta="Explorar las 650 circunscripciones →"
  />
  <NewsletterCta lang="es" placement="general-election" />
</EditorialLayout>
