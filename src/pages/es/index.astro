---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import HomeFront from '../../components/HomeFront.astro';
import StoryList from '../../components/StoryList.astro';
import DeskSections from '../../components/DeskSections.astro';
import MethodologyNote from '../../components/MethodologyNote.astro';
import SearchFastPath from '../../components/SearchFastPath.astro';
import AuthorStrip from '../../components/AuthorStrip.astro';
import { editorialPhilosophy, instruments } from '../../data/editorial';

const philosophy = editorialPhilosophy.es;
// Une de journal (docs/DESIGN.md §7) : la course principale en grand, les autres
// élections en colonne, puis la signature, la recherche, les desks et les indices.
const indexItems = instruments.es.filter((i) => i.status === 'live').slice(0, 6).map((i) => ({
  meta: i.cadence,
  title: i.name,
  text: i.question,
  href: i.href,
}));
---

<EditorialLayout
  title="Encuestas y proyecciones electorales: EE. UU., Canadá, Reino Unido, Francia, España — Vote-Scope"
  description="Encuestas y proyecciones electorales independientes: presidenciales de EE. UU. 2028, resultados de las elecciones intermedias de 2026, Canadá, Reino Unido, Francia 2027 y las elecciones generales españolas del 29 de noviembre. Actualizados cada día. Por Kim Leclerc."
  canonical="https://vote-scope.com/es/"
  lang="es"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/', fr: 'https://vote-scope.com/fr/', es: 'https://vote-scope.com/es/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      inLanguage: 'es',
      description: philosophy.position,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      logo: 'https://vote-scope.com/favicon.svg',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      ],
    },
  ]}
>
  <HomeFront lang="es" />

  <AuthorStrip lang="es" />


  <DeskSections lang="es" />


  <MethodologyNote
    title="Cómo se construyen las proyecciones."
    body={philosophy.proof}
    bullets={[
      'La mayoría de nuestras proyecciones agregan encuestas públicas en un modelo bayesiano BSTS — sesgos de encuestadora medidos y corregidos, exactitud calibrada sobre elecciones pasadas. La simulación solo lo traduce todo en escaños.',
      'Los datos de mercados de predicción (Polymarket) acompañan al modelo como detector de desacuerdo, no como sustituto.',
      'Las probabilidades por circunscripción se condicionan a los movimientos nacionales y regionales, y luego se reagrupan en distribuciones de escaños.',
      'Los datos fuente, las notas metodológicas y los resultados del modelo son públicos en cada desk. Se actualizan de forma continua a medida que llegan nuevas encuestas.',
    ]}
  />
</EditorialLayout>
