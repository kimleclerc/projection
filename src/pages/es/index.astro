---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import InstrumentGrid from '../../components/InstrumentGrid.astro';
import MarketCheck from '../../components/MarketCheck.astro';
import MethodologyNote from '../../components/MethodologyNote.astro';
import IdentityMark from '../../components/IdentityMark.astro';
import SignalTicker from '../../islands/SignalTicker';
import AnimatedNumber from '../../islands/AnimatedNumber';
import { desks, editorialPhilosophy, instruments } from '../../data/editorial';

import ldiData from '../../../web_data/us-lame-duck/latest.json';
import bfiData from '../../../web_data/fr-barrage/latest.json';
import frLegData from '../../../web_data/france-legislative/latest.json';
import clactonData from '../../../web_data/uk-clacton-special/latest.json';
import gooseData from '../../../web_data/ca-canada-goose/latest.json';
import cusmaData from '../../../web_data/cusma-showdown/latest.json';

const philosophy = editorialPhilosophy.es;
const ldi = ldiData.ldi;
const deltaSign = ldi.delta_7d >= 0 ? '+' : '';

const bfi = (bfiData as any).bfi;
const legCentral = (frLegData as any).scenarios.find((s: any) => s.id === (frLegData as any).meta.central_scenario);
const pMajRN = Math.round((legCentral?.p_majority_far_right ?? 0) * 100);
const pFarage = Math.round(((clactonData as any).model.p_farage_win ?? 0) * 1000) / 10;
const goose = (gooseData as any).cgi;
const cusma = (cusmaData as any).showdown;

// La cinta solo lleva cifras del sitio — nunca promesas.
const signals = [
  { label: 'Mundial 2026', value: '🇪🇸 España campeona — 1–0 t.e.', href: '/es/sports/wc2026/' },
  { label: 'Índice Barrage', value: `${bfi.score}/100 · ${bfi.label_es}`, href: '/es/france/indexes/barrage/' },
  { label: 'Legislativas FR', value: `p(mayoría RN) ${pMajRN}% con frente 2024`, href: '/es/france/legislativas' },
  { label: 'Parcial de Clacton', value: `Farage ${pFarage}% — 13 de agosto`, href: '/es/uk/byelections/clacton/' },
  { label: 'Lame-Duck Index', value: `${ldi.score}/100 · ${ldi.label_es ?? ldi.label_en}`, href: '/es/us/indexes/lame-duck/' },
  { label: 'Canada Goose Index', value: `${goose.score}/100 · ${goose.label_es}`, href: '/es/canada/indexes/canada-goose/' },
  { label: 'Duelo T-MEC', value: `brecha ${cusma.gap > 0 ? '+' : ''}${cusma.gap} — ${cusma.label_es}`, href: '/es/indexes/cusma-showdown/' },
];

// La cifra más llamativa de cada desk, inyectada en su tarjeta.
const liveSignals: Record<string, string> = {
  us: `Lame-Duck ${ldi.score}/100`,
  canada: `Goose ${goose.score}/100 · T-MEC ${cusma.gap > 0 ? '+' : ''}${cusma.gap}`,
  france: `p(mayoría RN) ${pMajRN}% con frente 2024 · Barrage ${bfi.score}/100`,
  uk: `Clacton: Farage ${pFarage}% — 13 de agosto`,
  sports: '🇪🇸 España campeona · archivo del modelo',
};
---

<EditorialLayout
  title="Vote-Scope — Inteligencia Electoral y Deportiva"
  description="Proyecciones electorales y deportivas en vivo, señales de mercados de predicción e instrumentos editoriales. Respuestas claras sobre quién va adelante, qué es frágil y qué pierde el mercado."
  canonical="https://vote-scope.com/es/"
  lang="es"
  currentPage="intl"
  ogImage="https://vote-scope.com/og/vote-scope.png"
  alternates={{ en: 'https://vote-scope.com/en/', fr: 'https://vote-scope.com/fr/', es: 'https://vote-scope.com/es/' }}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      inLanguage: 'es',
      description: philosophy.position,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Vote-Scope',
      url: 'https://vote-scope.com/',
      logo: 'https://vote-scope.com/favicon.svg',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      ],
    },
  ]}
>
  <EditorialHero
    eyebrow="Inteligencia electoral y deportiva"
    title="Una oficina de inteligencia electoral y deportiva."
    promise="No solo quién va adelante. Qué se está moviendo, qué es frágil y qué está perdiendo el mercado."
    question="¿Quién va adelante, qué es frágil y dónde se equivoca el mercado?"
    primaryHref="/es/indexes/"
    primaryLabel="Ver instrumentos"
    secondaryHref="/es/us/"
    secondaryLabel="Abrir desk EE. UU."
  />

  <section class="content-band" style="border-top:4px solid var(--red, #c33);">
    <div class="container" style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
      <div>
        <p class="eyebrow" style="margin-bottom:0.25rem;">Copa del Mundo 2026 — archivo final</p>
        <h2 style="margin:0;">España es campeona del mundo.</h2>
        <p style="font-size:1.5rem;font-weight:700;margin-top:0.5rem;">🇪🇸 España 1–0 Argentina · tras la prórroga</p>
      </div>
      <div style="flex:1;min-width:220px;">
        <p>España ganó el primer Mundial de 48 selecciones. El archivo conserva ambas lecturas: España primera al inicio (7,36%), pero Argentina ligeramente favorita en el último run antes de la final, 53,59–46,41.</p>
        <p style="margin-top:0.75rem;">
          <a href="/es/sports/wc2026/" class="cta-link">Abrir el archivo del Mundial →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="content-band" style="background:var(--surface-alt,#f9f7f2);padding:2rem 0;">
    <div class="container" style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
      <div>
        <p class="eyebrow" style="margin-bottom:0.25rem;display:flex;align-items:center;gap:.6rem;"><IdentityMark src="/assets/identity/lame-duck.png" label="Pato cojo" size={36} /> Cifra del día</p>
        <div style={`font-size:3.5rem;font-weight:800;color:${ldi.zone_color};line-height:1;`}>
          <AnimatedNumber client:visible value={ldi.score} decimals={1} />
          <span style="font-size:1.25rem;font-weight:400;color:var(--text);"> /100</span>
        </div>
        <p style={`font-weight:700;font-size:1.1rem;color:${ldi.zone_color};margin-top:0.25rem;`}>{ldi.label_en}</p>
        <p style="font-size:0.9rem;color:var(--text-muted);margin-top:0.25rem;">
          Lame-Duck Index · 7d: <strong>{deltaSign}{ldi.delta_7d}</strong> · al {ldiData.meta.as_of_date}
        </p>
      </div>
      <div style="flex:1;min-width:200px;">
        <p>El instrumento insignia de Vote-Scope mide el peso presidencial antes de las elecciones de medio término 2026. Más alto = más "pato cojo". Actualmente en zona <strong style={`color:${ldi.zone_color};`}>{ldi.label_en}</strong>.</p>
        <p style="margin-top:0.75rem;">
          <a href="/es/us/indexes/lame-duck/" class="cta-link">Abrir índice completo →</a>
        </p>
      </div>
    </div>
  </section>

  <SignalTicker client:idle signals={signals} locale="es" />

  <section class="content-band">
    <div class="container">
      <p class="eyebrow">Desks</p>
      <div class="desk-grid">
        {desks.es.map((desk) => (
          <a class="desk-card" href={desk.href}>
            <p class="eyebrow">{desk.eyebrow}</p>
            <h2>{desk.name}</h2>
            <strong>{desk.question}</strong>
            <p>{desk.description}</p>
            <footer>{liveSignals[desk.id] ?? desk.signal}</footer>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InstrumentGrid
    instruments={instruments.es.slice(0, 6)}
    title="Los números son públicos. La señal es nuestra."
    intro="Cada índice responde a una pregunta con un número que puedes seguir en el tiempo — peso presidencial, fragilidad de las mayorías y dónde difieren el modelo y el mercado."
  />

  <MarketCheck
    kicker="Modelo vs. mercado"
    title="Dónde coincidimos con el mercado — y dónde no."
    body="Polymarket y las cuotas se colocan justo al lado del modelo: de un vistazo ves dónde coinciden los traders y los números, dónde entra en pánico el mercado y dónde Vote-Scope ve una ventaja."
    modelLabel="Salida del modelo"
    marketLabel="Referencia"
    note="Actualizado a diario, junto a cada proyección."
  />

  <MethodologyNote
    title="Cómo se construyen las proyecciones."
    body={philosophy.proof}
    bullets={[
      'Todas las proyecciones agregan encuestas públicas en un modelo bayesiano BSTS — sesgos de encuestadora medidos y corregidos, correlaciones estimadas de los datos, exactitud calibrada sobre elecciones pasadas. La simulación solo lo traduce todo en escaños.',
      'Los datos de mercados de predicción (Polymarket) acompañan al modelo como detector de desacuerdo, no como sustituto.',
      'Las probabilidades por circunscripción se condicionan a los movimientos nacionales y regionales, y luego se reagrupan en distribuciones de escaños.',
      'Los datos fuente, las notas metodológicas y los resultados del modelo son públicos en cada desk. Se actualizan de forma continua a medida que llegan nuevas encuestas.',
    ]}
  />
</EditorialLayout>
