---
import Base from '../../../layouts/Base.astro';
import LabsHub from '../../../components/LabsHub.astro';

const LOCALE = 'es' as const;
const url = 'https://vote-scope.com/es/labs/';
---

<Base
  title="Órbita — el motor cuántico y relativista de VoteScope Labs"
  description="¿Y si pronosticáramos una elección con la física de Einstein? Órbita, nuestro motor experimental con qubits, lee las mismas encuestas que nuestra proyección de referencia y se compara con ella en Quebec, Columbia Británica y Estados Unidos."
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: 'https://vote-scope.com/en/labs/',
    fr: 'https://vote-scope.com/fr/labs/',
    es: 'https://vote-scope.com/es/labs/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Órbita — el motor cuántico y relativista de VoteScope Labs', url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: url },
    ]},
  ]}
>
  <LabsHub locale={LOCALE} />
</Base>
