---
import Base from '../../../layouts/Base.astro';
import LabsHub from '../../../components/LabsHub.astro';

const LOCALE = 'es' as const;
const url = 'https://vote-scope.com/es/labs/';
---

<Base
  title="VoteScope Labs — el motor de proyección experimental"
  description="Un segundo motor de proyección construido desde cero: mismas encuestas, otra mecánica (geometría curva, mediciones cuánticas, escaños contados sin sorteos). Comparado con nuestras proyecciones de referencia."
  canonical={url}
  lang={LOCALE}
  currentPage="match"
  alternates={{
    en: 'https://vote-scope.com/en/labs/',
    fr: 'https://vote-scope.com/fr/labs/',
    es: 'https://vote-scope.com/es/labs/',
  }}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'WebPage', name: 'VoteScope Labs', url, inLanguage: LOCALE },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vote-Scope', item: 'https://vote-scope.com/es/' },
      { '@type': 'ListItem', position: 2, name: 'Labs', item: url },
    ]},
  ]}
>
  <LabsHub locale={LOCALE} />
</Base>
