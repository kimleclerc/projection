---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Key used to mark the active nav link: 'lame-duck' | 'house' | 'senate' | 'canada' | etc. */
  currentPage?: string;
  lang?: 'en' | 'fr' | 'es';
  /** Absolute URL to OG image (1200×630) */
  ogImage?: string;
  ogType?: string;
  /** hreflang alternates: { en: 'https://...', fr: 'https://...', es?: 'https://...' } */
  alternates?: { en: string; fr: string; es?: string };
  /** schema.org JSON-LD object — rendered as <script type="application/ld+json"> */
  jsonLd?: object | object[];
  /** Prevent indexing for temporary untranslated or duplicate stubs. */
  noindex?: boolean;
}

type Locale = 'en' | 'fr' | 'es';

const {
  title,
  description = '',
  canonical = '',
  currentPage = '',
  lang = 'en',
  ogImage = '',
  ogType = 'website',
  alternates,
  jsonLd,
  noindex = false,
} = Astro.props;

const localeCopy: Record<Locale, {
  root: string;
  us: string;
  canada: string;
  uk: string;
  france: string;
  indexes: string;
  sports: string;
  lameDuck: string;
  methodology: string;
  trackRecord: string;
  privacy: string;
  contact: string;
  homeLabel: string;
  usLabel: string;
  canadaLabel: string;
  ukLabel: string;
  franceLabel: string;
  indexesLabel: string;
  sportsLabel: string;
  subscribeLabel: string;
  footerDescription: string;
  unitedStatesLabel: string;
  houseLabel: string;
  senateLabel: string;
  otherMarketsLabel: string;
  allRegionsLabel: string;
  aboutLabel: string;
  methodologyLabel: string;
  trackRecordLabel: string;
  privacyLabel: string;
  contactLabel: string;
  languageLabel: string;
  themeLabel: string;
  skipLabel: string;
  ogLocale: string;
}> = {
  en: {
    root: '/en/',
    us: '/en/us/',
    canada: '/en/canada/',
    uk: '/en/uk/',
    france: '/en/france/',
    indexes: '/en/indexes/',
    sports: '/en/sports/',
    lameDuck: '/en/us/indexes/lame-duck/',
    methodology: '/en/methodology/',
    trackRecord: '/en/track-record/',
    privacy: '/en/privacy/',
    contact: '/en/',
    homeLabel: 'Home',
    usLabel: 'U.S.',
    canadaLabel: 'Canada',
    ukLabel: 'U.K.',
    franceLabel: 'France',
    indexesLabel: 'Indexes',
    sportsLabel: 'Sports',
    subscribeLabel: 'Subscribe',
    footerDescription: 'Independent election projection. Published from Paris, Montréal, and Washington since 2021.',
    unitedStatesLabel: 'United States',
    houseLabel: 'House',
    senateLabel: 'Senate',
    otherMarketsLabel: 'Other markets',
    allRegionsLabel: 'All regions',
    aboutLabel: 'About',
    methodologyLabel: 'Methodology',
    trackRecordLabel: 'Track record',
    privacyLabel: 'Privacy',
    contactLabel: 'Contact',
    languageLabel: 'Language',
    themeLabel: 'Toggle dark mode',
    skipLabel: 'Skip to main content',
    ogLocale: 'en_US',
  },
  fr: {
    root: '/fr/',
    us: '/fr/us/',
    canada: '/fr/canada/',
    uk: '/fr/uk/',
    france: '/fr/france/',
    indexes: '/fr/indexes/',
    sports: '/fr/sports/',
    lameDuck: '/fr/us/indexes/lame-duck/',
    methodology: '/fr/methodologie/',
    trackRecord: '/fr/track-record/',
    privacy: '/fr/confidentialite/',
    contact: '/fr/',
    homeLabel: 'Accueil',
    usLabel: 'États-Unis',
    canadaLabel: 'Canada',
    ukLabel: 'R.-U.',
    franceLabel: 'France',
    indexesLabel: 'Index',
    sportsLabel: 'Sports',
    subscribeLabel: "S'abonner",
    footerDescription: 'Projection électorale indépendante. Publié depuis Paris, Montréal et Washington depuis 2021.',
    unitedStatesLabel: 'États-Unis',
    houseLabel: 'Chambre',
    senateLabel: 'Sénat',
    otherMarketsLabel: 'Autres marchés',
    allRegionsLabel: 'Toutes les régions',
    aboutLabel: 'À propos',
    methodologyLabel: 'Méthodologie',
    trackRecordLabel: 'Historique',
    privacyLabel: 'Confidentialité',
    contactLabel: 'Contact',
    languageLabel: 'Langue',
    themeLabel: 'Basculer le mode sombre',
    skipLabel: 'Aller au contenu principal',
    ogLocale: 'fr_CA',
  },
  es: {
    root: '/es/',
    us: '/es/us/',
    canada: '/es/canada/',
    uk: '/en/uk/',
    france: '/en/france/',
    indexes: '/es/indexes/',
    sports: '/es/sports/',
    lameDuck: '/es/us/indexes/lame-duck/',
    methodology: '/es/methodology/',
    trackRecord: '/es/track-record/',
    privacy: '/es/privacy/',
    contact: '/es/',
    homeLabel: 'Inicio',
    usLabel: 'EE. UU.',
    canadaLabel: 'Canadá',
    ukLabel: 'R.U.',
    franceLabel: 'Francia',
    indexesLabel: 'Índices',
    sportsLabel: 'Deportes',
    subscribeLabel: 'Suscribirse',
    footerDescription: 'Proyección electoral independiente. Publicada desde París, Montreal y Washington desde 2021.',
    unitedStatesLabel: 'Estados Unidos',
    houseLabel: 'Cámara',
    senateLabel: 'Senado',
    otherMarketsLabel: 'Otros mercados',
    allRegionsLabel: 'Todas las regiones',
    aboutLabel: 'Acerca de',
    methodologyLabel: 'Metodología',
    trackRecordLabel: 'Historial',
    privacyLabel: 'Privacidad',
    contactLabel: 'Contacto',
    languageLabel: 'Idioma',
    themeLabel: 'Cambiar modo oscuro',
    skipLabel: 'Saltar al contenido principal',
    ogLocale: 'es_US',
  },
};

const copy = localeCopy[lang as Locale] ?? localeCopy.en;

const navLinks = [
  { href: copy.root, label: copy.homeLabel, key: 'intl' },
  { href: copy.us, label: copy.usLabel, key: 'usa-hub' },
  { href: copy.canada, label: copy.canadaLabel, key: 'canada' },
  { href: copy.uk, label: copy.ukLabel, key: 'uk' },
  { href: copy.france, label: copy.franceLabel, key: 'france' },
  { href: copy.indexes, label: copy.indexesLabel, key: 'indexes' },
  { href: copy.sports, label: copy.sportsLabel, key: 'sports' },
];

const languageLabels: Record<Locale, string> = { en: 'EN', fr: 'FR', es: 'ES' };
const languageLinks = alternates
  ? (['en', 'fr', 'es'] as Locale[])
      .filter((locale) => locale !== lang && alternates[locale])
      .map((locale) => ({ locale, label: languageLabels[locale], href: alternates[locale] as string }))
  : [];
---
<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical  && <link rel="canonical" href={canonical} />}

  <!-- Open Graph -->
  <meta property="og:site_name" content="Vote-Scope" />
  <meta property="og:type"      content={ogType} />
  {canonical  && <meta property="og:url"   content={canonical} />}
  <meta property="og:title"     content={title} />
  {description && <meta property="og:description" content={description} />}
  {ogImage    && <meta property="og:image"  content={ogImage} />}
  {ogImage    && <meta property="og:image:width"  content="1200" />}
  {ogImage    && <meta property="og:image:height" content="630" />}
  <meta property="og:locale"    content={copy.ogLocale} />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImage    && <meta name="twitter:image"       content={ogImage} />}

  <!-- Crawler / AI hints -->
  <meta name="robots" content={noindex ? 'noindex,follow' : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
  <link rel="alternate" type="text/plain" title="LLM context" href="/llms.txt" />

  <!-- hreflang alternates -->
  {alternates && (
    <>
      <link rel="alternate" hreflang="en"        href={alternates.en} />
      <link rel="alternate" hreflang="fr"        href={alternates.fr} />
      {alternates.es && <link rel="alternate" hreflang="es" href={alternates.es} />}
      <link rel="alternate" hreflang="x-default" href={alternates.en} />
    </>
  )}

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- schema.org JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : jsonLd)} />
  )}

  <!-- Dark-mode: read preference before first paint to avoid FOUC -->
  <script is:inline>
    (function() {
      var saved  = localStorage.getItem('vs-theme');
      var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = saved || system;
    })();
  </script>

  <style is:global>
    /* ── FONT FACES (Fontsource variable fonts) ──────────────────────── */
    /* Imported via frontmatter — Vite self-hosts the .woff2 files        */

    /* ── DESIGN TOKENS ───────────────────────────────────────────────── */
    :root {
      /* Light (default) */
      --ink:    #1a1814; --ink-2: #3a3530; --ink-3: #6a635a; --ink-4: #9a9288;
      --rule:   #d8d3c8; --rule-2: #e8e3d8;
      --paper:  #f5f1e8; --paper-2: #ede8db; --paper-3: #faf7ef; --card: #fffdf6;
      --blue:   oklch(0.42 0.13 255); --blue-soft: oklch(0.55 0.10 255); --blue-tint: oklch(0.93 0.03 255);
      --red:    oklch(0.52 0.18 25);  --red-soft:  oklch(0.62 0.14 25);  --red-tint:  oklch(0.94 0.03 25);
      --duck:      oklch(0.87 0.17 92);
      --duck-deep: oklch(0.78 0.18 75);
      --beak:      oklch(0.72 0.19 55);
      --water:     oklch(0.72 0.07 220);
      --water-deep: oklch(0.55 0.09 230);
      /* Fontsource variable font families */
      --serif: "Newsreader Variable", Georgia, serif;
      --sans:  "Geist Variable", -apple-system, system-ui, sans-serif;
      --mono:  "JetBrains Mono Variable", ui-monospace, monospace;
    }

    /* Dark mode overrides */
    [data-theme="dark"] {
      --ink:    #ede8de; --ink-2: #c8c3b8; --ink-3: #8a857c; --ink-4: #5a5550;
      --rule:   #2e2a24; --rule-2: #252118;
      --paper:  #14120e; --paper-2: #1a1710; --paper-3: #0f0e0a; --card: #1e1b14;
      --blue:   oklch(0.72 0.14 255); --blue-soft: oklch(0.62 0.12 255); --blue-tint: oklch(0.22 0.05 255);
      --red:    oklch(0.72 0.16 25);  --red-soft:  oklch(0.65 0.13 25);  --red-tint:  oklch(0.24 0.05 25);
      --duck:      oklch(0.82 0.17 92);
      --duck-deep: oklch(0.74 0.18 75);
      --water:     oklch(0.35 0.07 230);
      --water-deep: oklch(0.28 0.09 235);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    a:focus-visible, button:focus-visible, input:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 3px;
    }
    .mono    { font-family: var(--mono); }
    .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
    .container      { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
    .container-wide { max-width: 1440px; margin: 0 auto; padding: 0 32px; }
    hr.rule { height: 1px; background: var(--rule); border: 0; }
    .skip-link {
      position: fixed;
      left: 16px;
      top: 12px;
      z-index: 100;
      transform: translateY(-150%);
      background: var(--ink);
      color: var(--paper-3);
      border-radius: 3px;
      padding: 9px 12px;
      font-family: var(--mono);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      transition: transform .12s ease;
    }
    .skip-link:focus { transform: translateY(0); }

    /* NAV */
    .nav { border-bottom: 1px solid var(--rule); position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px); background: color-mix(in oklab, var(--paper) 90%, transparent); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 22px; height: 60px; }
    .logo { display: flex; align-items: baseline; gap: 10px; font-family: var(--serif); font-size: 22px; font-weight: 500; letter-spacing: -0.02em; }
    .logo-dot { width: 8px; height: 8px; border-radius: 2px; background: var(--red); display: inline-block; transform: translateY(-2px); }
    .nav-links { display: flex; gap: 28px; font-size: 14px; color: var(--ink-2); }
    .nav-links a { padding: 6px 0; border-bottom: 1px solid transparent; }
    .nav-links a:hover { border-color: var(--ink); }
    .nav-links a.current { color: var(--ink); font-weight: 500; }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .nav-cta { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; padding: 8px 14px; background: var(--ink); color: var(--paper-3); border-radius: 2px; display: inline-block; }
    /* Dark mode toggle */
    .theme-toggle { background: none; border: 1px solid var(--rule); border-radius: 2px; padding: 7px 8px; cursor: pointer; color: var(--ink-3); line-height: 1; display: flex; align-items: center; justify-content: center; transition: color .15s, border-color .15s; }
    .theme-toggle:hover { color: var(--ink); border-color: var(--ink-3); }
    .theme-toggle .icon-sun  { display: none; }
    .theme-toggle .icon-moon { display: block; }
    [data-theme="dark"] .theme-toggle .icon-sun  { display: block; }
    [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
    /* Lang toggle */
    .lang-switcher { display: inline-flex; gap: 6px; align-items: center; }
    .lang-toggle { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--rule); border-radius: 2px; padding: 7px 10px; transition: color .15s, border-color .15s; }
    .lang-toggle:hover { color: var(--ink); border-color: var(--ink-3); }

    /* FOOTER */
    .footer { padding: 56px 0 32px; background: var(--paper-2); border-top: 1px solid var(--rule); }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 40px; }
    .footer-col h4 { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 14px; font-weight: 500; }
    .footer-col a { display: block; color: var(--ink-2); font-size: 14px; padding: 4px 0; }
    .footer-col a:hover { color: var(--ink); }
    .footer-bottom { padding-top: 22px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-3); font-family: var(--mono); }

    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
      .nav-links    { gap: 14px; }
    }
    @media (max-width: 760px) {
      .nav-inner {
        flex-wrap: wrap;
        align-content: center;
        gap: 8px 14px;
        height: auto;
        min-height: 60px;
        padding-top: 8px;
        padding-bottom: 8px;
      }
      .logo {
        flex: 1 1 auto;
      }
      .nav-right {
        margin-left: auto;
      }
      .nav-links {
        order: 3;
        flex: 1 0 100%;
        gap: 18px;
        overflow-x: auto;
        padding: 4px 0 2px;
        scrollbar-width: none;
      }
      .nav-links::-webkit-scrollbar {
        display: none;
      }
      .nav-links a {
        flex: 0 0 auto;
      }
      .nav-cta {
        padding: 8px 10px;
        font-size: 10px;
      }
      .lang-toggle {
        padding: 7px 9px;
      }
    }
    @media (max-width: 600px) {
      .container, .container-wide { padding: 0 18px; }
      .nav-links { gap: 16px; font-size: 12px; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<a class="skip-link" href="#main-content">{copy.skipLabel}</a>

<nav class="nav">
  <div class="container nav-inner">
    <a class="logo" href={copy.root}>
      <span class="logo-dot"></span>Vote-Scope
    </a>
    <div class="nav-links">
      {navLinks.map(link => (
        <a href={link.href} class={currentPage === link.key ? 'current' : ''}>
          {link.label}
        </a>
      ))}
    </div>
    <div class="nav-right">
      {languageLinks.length > 0 && (
        <div class="lang-switcher" role="group" aria-label={copy.languageLabel}>
          {languageLinks.map((language) => (
            <a class="lang-toggle" href={language.href} aria-label={`${copy.languageLabel}: ${language.label}`}>
              {language.label}
            </a>
          ))}
        </div>
      )}
      <!-- Dark mode toggle -->
      <button class="theme-toggle" id="theme-toggle" aria-label={copy.themeLabel} aria-pressed="false" type="button">
        <!-- Moon (show in light mode) -->
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <!-- Sun (show in dark mode) -->
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a class="nav-cta" href="#newsletter">{copy.subscribeLabel}</a>
    </div>
  </div>
</nav>

<main id="main-content">
  <slot />
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href={copy.root} style="margin-bottom:14px;display:inline-flex">
          <span class="logo-dot"></span>Vote-Scope
        </a>
        <p style="font-size:14px;color:var(--ink-3);max-width:320px;line-height:1.6;margin-top:10px">
          {copy.footerDescription}
        </p>
      </div>
      <div class="footer-col">
        <h4>{copy.unitedStatesLabel}</h4>
        <a href={copy.us}>Hub</a>
        <a href={`${copy.us}#house`}>{copy.houseLabel}</a>
        <a href={`${copy.us}#senate`}>{copy.senateLabel}</a>
        <a href={copy.lameDuck}>
          Lame-Duck Index
        </a>
      </div>
      <div class="footer-col">
        <h4>{copy.otherMarketsLabel}</h4>
        <a href={copy.canada}>{copy.canadaLabel}</a>
        <a href={copy.uk}>{copy.ukLabel}</a>
        <a href={copy.france}>{copy.franceLabel}</a>
        <a href={copy.sports}>Sports Scope</a>
        <a href={copy.indexes}>Instruments</a>
        <a href={copy.root}>{copy.allRegionsLabel}</a>
      </div>
      <div class="footer-col">
        <h4>{copy.aboutLabel}</h4>
        <a href={copy.methodology}>{copy.methodologyLabel}</a>
        <a href={copy.trackRecord}>{copy.trackRecordLabel}</a>
        <a href={copy.privacy}>{copy.privacyLabel}</a>
        <a href={copy.contact}>{copy.contactLabel}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Vote-Scope</span>
      <slot name="footer-version"><span id="footer-version"></span></slot>
      {languageLinks.length > 0
        ? (
          <span class="lang-switcher" role="group" aria-label={copy.languageLabel}>
            {languageLinks.map((language) => (
              <a class="lang-toggle" href={language.href} style="border:0;padding:0">{language.label}</a>
            ))}
          </span>
        )
        : <span>EN · FR · ES</span>}
    </div>
  </div>
</footer>

<!-- Dark mode toggle script — no framework needed, 150 bytes -->
<script>
  function syncThemeToggle() {
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    button.setAttribute('aria-pressed', document.documentElement.dataset.theme === 'dark' ? 'true' : 'false');
  }
  syncThemeToggle();
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('vs-theme', next);
    syncThemeToggle();
  });
</script>

</body>
</html>
