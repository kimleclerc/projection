const copy = localeCopy[lang as Locale] ?? localeCopy.en;

// Evergreen footer partner line — renders only once a real tracking URL is
// set in src/data/affiliates.ts. rel="sponsored" is required on these links.
const footerPartner = affiliates.proton.url.trim() !== '' ? affiliates.proton : null;
const footerPartnerLabel: Record<string, string> = {
  en: 'Partner: Proton — encrypted email & VPN',
  fr: 'Partenaire : Proton — courriel chiffré & VPN',
  es: 'Socio: Proton — correo cifrado y VPN',
};

const navLinks = [
  { href: copy.root, label: copy.homeLabel, key: 'intl' },
  { href: copy.us, label: copy.usLabel, key: 'usa-hub' },
  { href: copy.canada, label: copy.canadaLabel, key: 'canada' },
  // Le jeu, placé au contact du Canada plutôt qu'en bout de barre : sur
  // mobile les liens défilent horizontalement, et la fin de course est le
  // pire endroit pour ce qu'on veut rendre visible.
  { href: copy.match, label: copy.matchLabel, key: 'match' },
  { href: copy.uk, label: copy.ukLabel, key: 'uk' },
  { href: copy.france, label: copy.franceLabel, key: 'france' },
  { href: copy.indexes, label: copy.indexesLabel, key: 'indexes' },
  { href: copy.sports, label: copy.sportsLabel, key: 'sports' },
];

const languageLabels: Record<Locale, string> = { en: 'EN', fr: 'FR', es: 'ES' };

/**
 * Derive a sibling URL in another locale from the current path.
 *
 * Pages can pass an explicit `alternates` prop when their URL shapes
 * diverge in ways this mapper can't infer (different query strings,
 * one-off canonical paths, etc.). When `alternates` is missing or
 * incomplete, we fall back to a path-rewrite using the slug variants
 * that are stable across the site.
 *
 * Slug variants kept here:
 *   federal/quebec/ontario ridings ↔ circonscriptions ↔ distritos
 *   uk constituencies ↔ circonscriptions ↔ circunscripciones
 *   us house ↔ chambre + districts ↔ distritos
 *   us senate ↔ senat + seats ↔ sieges ↔ escanos
 */
const SLUG_VARIANTS: Array<{ en: string; fr: string; es: string }> = [
  // CA federal / QC / ON riding folders
  { en: '/ridings/', fr: '/circonscriptions/', es: '/distritos/' },
  // UK
  { en: '/constituencies/', fr: '/circonscriptions/', es: '/circunscripciones/' },
  // US House districts/distritos (FR keeps 'districts')
  { en: '/us/house/districts/', fr: '/us/chambre/districts/', es: '/us/house/distritos/' },
  { en: '/us/house/',           fr: '/us/chambre/',           es: '/us/house/' },
  // US Senate seats/sieges/escanos
  { en: '/us/senate/seats/',    fr: '/us/senat/sieges/',      es: '/us/senate/escanos/' },
  { en: '/us/senate/',          fr: '/us/senat/',             es: '/us/senate/' },
];

function deriveAltPath(path: string, from: Locale, to: Locale): string {
  // Normalise to a trailing slash so SLUG_VARIANTS (which end with `/`) match
  // cleanly — and KEEP it on the way out. Cloudflare serves every route with
  // the trailing slash and 308s the bare form, so an hreflang emitted without
  // it points at a redirect; Google drops hreflang clusters whose URLs are not
  // self-canonical. `Astro.url.pathname` arrives bare under
  // `trailingSlash: 'never'`, hence the normalisation here rather than upstream.
  let p = path.endsWith('/') ? path : `${path}/`;
  // Swap the locale prefix first.
  p = p.replace(new RegExp(`^/${from}(/|$)`), `/${to}$1`);
  // Apply known slug variants. We swap from→to ONLY when the from token
  // is actually present, to avoid accidental rewrites.
  for (const v of SLUG_VARIANTS) {
    if (v[from] !== v[to] && p.includes(v[from])) {
      p = p.replace(v[from], v[to]);
    }
  }
  return p;
}

const ORIGIN = 'https://vote-scope.com';
const currentPath = Astro?.url?.pathname ?? '/';
const derivedAlternates: Record<Locale, string> = {
  en: alternates?.en ?? `${ORIGIN}${deriveAltPath(currentPath, lang as Locale, 'en')}`,
  fr: alternates?.fr ?? `${ORIGIN}${deriveAltPath(currentPath, lang as Locale, 'fr')}`,
  es: alternates?.es ?? `${ORIGIN}${deriveAltPath(currentPath, lang as Locale, 'es')}`,
};

// Show every locale except the current one. Even when alternates isn't
// fully declared by the page, deriveAltPath gives us a sensible link.
const languageLinks = (['en', 'fr', 'es'] as Locale[])
  .filter((locale) => locale !== lang)
  .map((locale) => ({ locale, label: languageLabels[locale], href: derivedAlternates[locale] }));
---
<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Consent Mode v2 default for measurement, and ONLY for measurement.
       Cloudflare's Google Tag Gateway injects the GTM container as the last
       script in <head>, so this inline script is guaranteed to run first and
       nothing is measured until src/lib/consent.ts sends the update.

       The advertising signals (ad_storage, ad_user_data, ad_personalization)
       are deliberately absent. They belong to Journey by Mediavine: it is their
       ad stack, their certified CMP and their vendor list. Declaring them here
       denied them everywhere, Canada and the United States included, where
       Google requires no consent signal at all — which quietly put Google ad
       demand into restricted mode and cost revenue for nothing.

       Defining the default here rather than in a GTM Custom HTML tag is also
       deliberate: GTM warns that gtag commands inside Custom HTML may not be
       processed as consent commands at all. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      wait_for_update: 2000
    });
  </script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical  && <link rel="canonical" href={canonical} />}

  <!-- Open Graph -->
  <meta property="og:site_name" content="Vote-Scope" />
  <meta property="og:type"      content={ogType} />
  {canonical  && <meta property="og:url"   content={canonical} />}
  <meta property="og:title"     content={title} />
  {description && <meta property="og:description" content={description} />}
  {ogImage    && <meta property="og:image"  content={ogImage} />}
  {ogImage    && <meta property="og:image:width"  content="1200" />}
  {ogImage    && <meta property="og:image:height" content="630" />}
  <meta property="og:locale"    content={copy.ogLocale} />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImage    && <meta name="twitter:image"       content={ogImage} />}

  <!-- Crawler / AI hints -->
  <meta name="robots" content={noindex ? 'noindex,follow' : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
  <link rel="alternate" type="text/plain" title="LLM context" href="/llms.txt" />
  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <script type="module" src="/pagefind/pagefind-component-ui.js"></script>

  <!-- hreflang alternates — uses derivedAlternates so every locale gets a
       link even when the page didn't declare an explicit `alternates` prop. -->
  <link rel="alternate" hreflang="en"        href={derivedAlternates.en} />
  <link rel="alternate" hreflang="fr"        href={derivedAlternates.fr} />
  <link rel="alternate" hreflang="es"        href={derivedAlternates.es} />
  <link rel="alternate" hreflang="x-default" href={derivedAlternates.en} />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- schema.org JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : jsonLd)} />
  )}

  <!-- Dark-mode: read preference before first paint to avoid FOUC -->
  <script is:inline>
    (function() {
      var saved  = localStorage.getItem('vs-theme');
      var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = saved || system;
    })();
  </script>

  <style is:global>
    /* ── FONT FACES (Fontsource variable fonts) ──────────────────────── */
    /* Imported via frontmatter — Vite self-hosts the .woff2 files        */

    /* ── DESIGN TOKENS + BASE ────────────────────────────────────────── */
    /* Extraits vers ../styles/tokens.css (import frontmatter), partagés  */
    /* avec le layout Embed pour que les iframes suivent la palette.      */

    .skip-link {
      position: fixed;
      left: 16px;
      top: 12px;
      z-index: 100;
      transform: translateY(-150%);
      background: var(--ink);
      color: var(--paper-3);
      border-radius: 3px;
      padding: 9px 12px;
      font-family: var(--mono);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      transition: transform .12s ease;
    }
    .skip-link:focus { transform: translateY(0); }

    /* NAV */
    .nav { border-bottom: 1px solid var(--rule); position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px); background: color-mix(in oklab, var(--paper) 90%, transparent); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 22px; height: 60px; }
    .logo { display: flex; align-items: baseline; gap: 10px; font-family: var(--serif); font-size: 22px; font-weight: 500; letter-spacing: -0.02em; }
    .logo-dot { width: 8px; height: 8px; border-radius: 2px; background: var(--red); display: inline-block; transform: translateY(-2px); }
    .nav-links { display: flex; gap: 28px; font-size: 14px; color: var(--ink-2); }
    .nav-links a { padding: 6px 0; border-bottom: 1px solid transparent; }
    .nav-links a:hover { border-color: var(--ink); }
    .nav-links a.current { color: var(--ink); font-weight: 500; }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .nav-search { display: inline-flex; }
    .nav-search pagefind-modal-trigger {
      --pagefind-ui-primary: var(--ink);
      --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--paper);
      --pagefind-ui-border: var(--rule);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 2px;
      font-size: 12px;
    }
    .nav-cta { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; padding: 8px 14px; background: var(--ink); color: var(--paper-3); border-radius: 2px; display: inline-block; }
    /* Dark mode toggle */
    .theme-toggle { min-width: 44px; min-height: 44px; background: none; border: 1px solid var(--rule); border-radius: 2px; padding: 7px 8px; cursor: pointer; color: var(--ink-3); line-height: 1; display: flex; align-items: center; justify-content: center; transition: color .15s, border-color .15s; }
    .theme-toggle:hover { color: var(--ink); border-color: var(--ink-3); }
    .theme-toggle .icon-sun  { display: none; }
    .theme-toggle .icon-moon { display: block; }
    [data-theme="dark"] .theme-toggle .icon-sun  { display: block; }
    [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
    /* Lang toggle */
    .lang-switcher { display: inline-flex; gap: 6px; align-items: center; }
    .lang-toggle { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--rule); border-radius: 2px; padding: 7px 10px; transition: color .15s, border-color .15s; }
    .lang-toggle:hover { color: var(--ink); border-color: var(--ink-3); }

    /* FOOTER */
    .footer { padding: 56px 0 32px; background: var(--paper-2); border-top: 1px solid var(--rule); }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 40px; }
    .footer-col h4 { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 14px; font-weight: 500; }
    .footer-col a { display: block; color: var(--ink-2); font-size: 14px; padding: 4px 0; }
    .footer-col a:hover { color: var(--ink); }
    .coffee-btn {
      display: inline-grid;
      grid-template-columns: 38px 1fr;
      align-items: center;
      gap: 10px;
      min-width: 220px;
      margin-top: 18px;
      padding: 10px 14px 10px 11px;
      border: 1px solid #c89716;
      border-radius: 7px;
      color: #17130a;
      background: #ffdd57;
      box-shadow: 0 3px 0 #c89716;
      text-decoration: none;
      transition: transform .15s, box-shadow .15s, background .15s;
    }
    .coffee-btn:hover {
      transform: translateY(-1px);
      background: #ffe475;
      box-shadow: 0 5px 0 #c89716;
      color: #17130a;
    }
    .coffee-btn svg {
      width: 38px;
      height: 38px;
      padding: 7px;
      border-radius: 50%;
      background: rgb(255 255 255 / .48);
    }
    .coffee-btn-copy { display: flex; flex-direction: column; line-height: 1.15; }
    .coffee-btn-copy strong { font-family: var(--serif); font-size: 17px; font-weight: 650; }
    .coffee-btn-copy small {
      margin-top: 4px;
      font-family: var(--mono);
      font-size: 8px;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: .72;
    }
    .footer-bottom { padding-top: 22px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-3); font-family: var(--mono); }

    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
      .nav-links    { gap: 14px; }
    }
    @media (max-width: 760px) {
      .nav-inner {
        flex-wrap: wrap;
        align-content: center;
        gap: 8px 14px;
        height: auto;
        min-height: 60px;
        padding-top: 8px;
        padding-bottom: 8px;
      }
      .logo {
        flex: 1 1 auto;
      }
      .nav-right {
        margin-left: auto;
      }
      .nav-links {
        order: 3;
        flex: 1 0 100%;
        gap: 18px;
        overflow-x: auto;
        padding: 4px 0 2px;
        scrollbar-width: none;
      }
      .nav-links::-webkit-scrollbar {
        display: none;
      }
      .nav-links a {
        flex: 0 0 auto;
      }
      .nav-cta {
        padding: 8px 10px;
        font-size: 10px;
      }
      .nav-search pagefind-modal-trigger { max-width: 44px; overflow: hidden; }
      .lang-toggle {
        padding: 7px 9px;
      }
    }
    @media (max-width: 600px) {
      .container, .container-wide { padding: 0 18px; }
      .nav-links { gap: 16px; font-size: 12px; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  {/* Journey by Mediavine. Renders nothing while ads.enabled is false —
      see src/data/ads.ts for the pre-launch checklist. data-cfasync="false"
      keeps Cloudflare Rocket Loader from deferring it; is:inline keeps
      Astro from bundling a third-party URL. */}
  {ads.enabled && (
    <script
      is:inline
      async
      data-noptimize="1"
      data-cfasync="false"
      src={adScriptUrl()}
    ></script>
  )}
</head>
<body>
<a class="skip-link" href="#main-content">{copy.skipLabel}</a>

<nav class="nav" aria-label={lang === 'fr' ? 'Navigation principale' : lang === 'es' ? 'Navegación principal' : 'Primary navigation'} data-analytics-region="header">
  <div class="container nav-inner">
    <a class="logo" href={copy.root}>
      <span class="logo-dot"></span>Vote-Scope
    </a>
    <div class="nav-links">
      {navLinks.map(link => (
        <a href={link.href} class={currentPage === link.key ? 'current' : ''} aria-current={currentPage === link.key ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </div>
    <div class="nav-right">
      <span class="nav-search">
        <pagefind-modal-trigger compact aria-label={lang === 'fr' ? 'Rechercher sur Vote-Scope' : lang === 'es' ? 'Buscar en Vote-Scope' : 'Search Vote-Scope'}></pagefind-modal-trigger>
      </span>
      {languageLinks.length > 0 && (
        <div class="lang-switcher" role="group" aria-label={copy.languageLabel}>
          {languageLinks.map((language) => (
            <a class="lang-toggle" href={language.href} aria-label={`${copy.languageLabel}: ${language.label}`} data-analytics-event="language_change" data-analytics-target-locale={language.locale}>
              {language.label}
            </a>
          ))}
        </div>
      )}
      <!-- Dark mode toggle -->
      <button class="theme-toggle" id="theme-toggle" aria-label={copy.themeLabel} aria-pressed="false" type="button">
        <!-- Moon (show in light mode) -->
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <!-- Sun (show in dark mode) -->
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a class="nav-cta" href={copy.subscribeUrl} target="_blank" rel="noopener" data-analytics-event="newsletter_click" data-analytics-location="header">{copy.subscribeLabel}</a>
    </div>
  </div>
</nav>

<main id="main-content" data-pagefind-body={searchIndex ? true : undefined}>
  <slot />
</main>

<footer class="footer" data-analytics-region="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="logo" href={copy.root} style="margin-bottom:14px;display:inline-flex">
          <span class="logo-dot"></span>Vote-Scope
        </a>
        <p style="font-size:14px;color:var(--ink-3);max-width:320px;line-height:1.6;margin-top:10px">
          {copy.footerDescription}
        </p>
        <a class="coffee-btn" href="https://buymeacoffee.com/kimleclerc" target="_blank" rel="noopener">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M7 10h16v8.5A7.5 7.5 0 0 1 15.5 26h-1A7.5 7.5 0 0 1 7 18.5V10Z" fill="currentColor"/>
            <path d="M23 13h2.2a3.8 3.8 0 0 1 0 7.6H23" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M11 5.5c0 1.5 1.5 1.5 1.5 3M17 5.5c0 1.5 1.5 1.5 1.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span class="coffee-btn-copy">
            <strong>{copy.coffeeLabel}</strong>
            <small>{lang === 'fr' ? 'Soutenir les projections indépendantes' : lang === 'es' ? 'Apoyar proyecciones independientes' : 'Support independent forecasts'}</small>
          </span>
        </a>
        {footerPartner && (
          <p style="font-size:12px;color:var(--ink-3);margin-top:12px;">
            <a href={footerPartner.url} target="_blank" rel="sponsored noopener" style="color:inherit;">
              {footerPartnerLabel[lang] ?? footerPartnerLabel.en}
            </a>
            · <a href={copy.disclosure} style="color:inherit;">{copy.disclosureLabel}</a>
          </p>
        )}
      </div>
      <div class="footer-col">
        <h4>{copy.unitedStatesLabel}</h4>
        <a href={copy.us}>Hub</a>
        <a href={`${copy.us}#house`}>{copy.houseLabel}</a>
        <a href={`${copy.us}#senate`}>{copy.senateLabel}</a>
        <a href={copy.lameDuck}>
          Lame-Duck Index
        </a>
      </div>
      <div class="footer-col">
        <h4>{copy.otherMarketsLabel}</h4>
        <a href={copy.canada}>{copy.canadaLabel}</a>
        <a href={copy.uk}>{copy.ukLabel}</a>
        <a href={copy.france}>{copy.franceLabel}</a>
        <a href={copy.sports}>Sports Scope</a>
        <a href={copy.indexes}>Instruments</a>
        <a href={copy.root}>{copy.allRegionsLabel}</a>
      </div>
      <div class="footer-col">
        <h4>{copy.aboutLabel}</h4>
        <a href={copy.about}>{copy.aboutLabel}</a>
        <a href={copy.methodology}>{copy.methodologyLabel}</a>
        <a href={copy.trackRecord}>{copy.trackRecordLabel}</a>
        <a href={copy.privacy}>{copy.privacyLabel}</a>
        <a href={copy.terms}>{copy.termsLabel}</a>
        <a href={copy.disclosure}>{copy.disclosureLabel}</a>
        <a href={copy.library}>{copy.libraryLabel}</a>
        <a href={copy.api}>{copy.apiLabel}</a>
        <a href={copy.contact} target="_blank" rel="me noopener">{copy.contactLabel}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Vote-Scope</span>
      <slot name="footer-version"><span id="footer-version"></span></slot>
      {languageLinks.length > 0
        ? (
          <span class="lang-switcher" role="group" aria-label={copy.languageLabel}>
            {languageLinks.map((language) => (
              <a class="lang-toggle" href={language.href} style="border:0;padding:0" data-analytics-event="language_change" data-analytics-target-locale={language.locale}>{language.label}</a>
            ))}
          </span>
        )
        : <span>EN · FR · ES</span>}
    </div>
  </div>
</footer>

<pagefind-modal></pagefind-modal>

<!-- Dark mode toggle script — no framework needed, 150 bytes -->
<script>
  import { initAnalyticsTracking, trackAnalyticsEvent } from '../lib/analytics';
  import { initConsentArbitration } from '../lib/consent';

  // Resolve which consent manager governs this reader before anything is
  // measured — see src/lib/consent.ts for why there are two of them.
  initConsentArbitration();
  initAnalyticsTracking();

  function syncThemeToggle() {
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    button.setAttribute('aria-pressed', document.documentElement.dataset.theme === 'dark' ? 'true' : 'false');
  }
  syncThemeToggle();
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('vs-theme', next);
    trackAnalyticsEvent('display_preference_change', { preference: 'theme', value: next });
    syncThemeToggle();
  });
</script>

{amazon.oneLinkScriptSrc.trim() !== '' && (
  <script is:inline async src={amazon.oneLinkScriptSrc}></script>
)}
</body>
</html>
