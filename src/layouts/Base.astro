interface Props {
  title: string;
  description?: string;
  canonical?: string;
  /** Key used to mark the active nav link: 'lame-duck' | 'house' | 'senate' | 'canada' | etc. */
  currentPage?: string;
  lang?: 'en' | 'fr' | 'es';
  /** Absolute URL to OG image (1200×630) */
  ogImage?: string;
  ogType?: string;
  /** hreflang alternates: { en: 'https://...', fr: 'https://...', es?: 'https://...' } */
  alternates?: { en: string; fr: string; es?: string };
  /** schema.org JSON-LD object — rendered as <script type="application/ld+json"> */
  jsonLd?: object | object[];
  /** Prevent indexing for temporary untranslated or duplicate stubs. */
  noindex?: boolean;
  /** Include the page in the internal Pagefind search index. */
  searchIndex?: boolean;
}

type Locale = 'en' | 'fr' | 'es';

const {
  title,
  description = '',
  canonical = '',
  currentPage = '',
  lang = 'en',
  ogImage = '',
  ogType = 'website',
  alternates,
  jsonLd,
  noindex = false,
  searchIndex = true,
} = Astro.props;

const localeCopy: Record<Locale, {
