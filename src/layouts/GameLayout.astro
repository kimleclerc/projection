---
/**
 * Coquille plein écran des jeux Vote-Scope.
 *
 * Volontairement à côté de `Base.astro` plutôt que dessus : un jeu de cartes à
 * glisser se joue sans barre de navigation ni pied de page, et hérite de sa
 * propre palette. Ce qui suit ne réimplémente donc que ce dont un jeu a besoin
 * dans le `<head>` — et que la première version oubliait : les alternances de
 * langue, et les cartes de partage, sans lesquelles une expérience faite pour
 * être partagée arrive nue dans les fils.
 */
import { ads, adScriptUrl } from '../data/ads';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/geist/wght.css';
import { versionSocialCardUrl } from '../lib/og/version';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: 'fr' | 'en' | 'es';
  alternates?: { en: string; fr: string; es: string };
  ogImage?: string;
  /** Par défaut le jeu est indexable : c'est une porte d'entrée, pas une annexe. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  lang = 'fr',
  alternates,
  ogImage = 'https://vote-scope.com/og/vote-scope.png',
  noindex = false,
} = Astro.props;

const versionedOgImage = versionSocialCardUrl(ogImage);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />

    {alternates && (
      <>
        <link rel="alternate" hreflang="fr" href={alternates.fr} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="es" href={alternates.es} />
        <link rel="alternate" hreflang="x-default" href={alternates.en} />
      </>
    )}

    <meta property="og:site_name" content="Vote-Scope" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={versionedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={versionedOgImage} />

    <!-- Même lecture que Base.astro : le jeu suit la préférence choisie
         ailleurs sur le site, et le système à défaut. Lue AVANT la première
         peinture, sinon la carte clignote en clair puis bascule. -->
    <script is:inline>
      (function() {
        var saved  = localStorage.getItem('vs-theme');
        var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || system;
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />
    <style is:global>
      :root {
        --vibe-paper: #f5f1e8;
        --vibe-card: #fffdf6;
        --vibe-ink: #171512;
        --vibe-muted: #70695f;
        --vibe-rule: #d8d0c2;
        --vibe-red: #b8242b;
        --vibe-blue: #143858;
        --vibe-serif: "Newsreader Variable", Georgia, serif;
        --vibe-sans: "Geist Variable", -apple-system, BlinkMacSystemFont, sans-serif;
      }

      /* Le jeu a sa propre palette : elle doit donc avoir sa propre version
         sombre, sans quoi il restait le seul écran clair du site. */
      :root[data-theme="dark"] {
        --vibe-paper: #14120f;
        --vibe-card: #1d1a16;
        --vibe-ink: #f2ece1;
        --vibe-muted: #a89d8d;
        --vibe-rule: #35302a;
        --vibe-red: #d9484f;
        --vibe-blue: #5b8cba;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; background: var(--vibe-paper); color: var(--vibe-ink); }
      body { font-family: var(--vibe-sans); -webkit-font-smoothing: antialiased; }
      button, input, select { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {
        outline: 3px solid #1f6595;
        outline-offset: 3px;
      }
    </style>

    {/* Journey by Mediavine — le jeu ne passe pas par Base.astro, il portait
        donc aucune publicité alors que le reste du site en sert. Voir
        src/data/ads.ts. */}
    {ads.enabled && (
      <script is:inline async data-noptimize="1" data-cfasync="false" src={adScriptUrl()}></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
