---
import Base from './Base.astro';
import type { Locale } from '../data/editorial';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: Locale;
  currentPage?: string;
  alternates?: { en: string; fr: string; es?: string };
  jsonLd?: object | object[];
  /** Absolute URL to OG image (1200×630). Defaults to brand fallback. */
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonical,
  lang,
  currentPage = 'intl',
  alternates,
  jsonLd,
  ogImage = 'https://vote-scope.com/og/vote-scope.png',
  ogType = 'website',
} = Astro.props;
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  lang={lang}
  currentPage={currentPage}
  alternates={alternates}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogType={ogType}
>
  <slot />
</Base>

<style is:global>
  .btn-primary,
  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 3px;
    padding: 11px 15px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper-3);
  }

  .btn-outline {
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .desk-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .desk-card {
    min-height: 300px;
    padding: 26px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--card);
  }

  .desk-card h2,
  .content-band h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .desk-card strong {
    display: block;
    margin-top: 18px;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }

  .desk-card p,
  .content-band p {
    margin-top: 15px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .desk-card footer {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-2);
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 11px;
  }

  .content-band {
    padding: 72px 0;
    border-bottom: 1px solid var(--rule);
  }

  .content-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 30px;
  }

  .note-card {
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    padding: 24px;
  }

  .note-card h3 {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .note-card p {
    color: var(--ink-2);
    line-height: 1.6;
  }

  .island-panel {
    margin-top: 28px;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .filter-row button {
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--card);
    color: var(--ink-2);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    padding: 9px 12px;
    text-transform: uppercase;
  }

  .filter-row button.active {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper-3);
  }

  .island-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .island-card {
    min-height: 260px;
    padding: 22px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--card);
  }

  .island-card span,
  .island-card footer {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .island-card h3 {
    margin: 16px 0 10px;
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1.04;
  }

  .island-card strong {
    display: block;
    line-height: 1.35;
  }

  .island-card p {
    margin-top: 12px;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .island-card footer {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--rule-2);
  }

  .island-card em {
    font-style: normal;
  }

  .signal-ticker {
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    color: var(--paper-3);
  }

  .signal-track {
    display: flex;
    width: max-content;
    animation: signal-scroll 55s linear infinite;
  }

  .signal-item {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 28px;
    white-space: nowrap;
  }

  .signal-item span {
    color: color-mix(in oklab, var(--paper-3) 64%, transparent);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .signal-item strong {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 430;
  }

  @keyframes signal-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-track {
      animation: none;
    }
  }

  @media (max-width: 920px) {
    .desk-grid,
    .content-grid-2,
    .island-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
