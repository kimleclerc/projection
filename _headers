# Astro emits content-hashed filenames in /_astro/. These assets are immutable:
# a new deployment creates a new URL instead of replacing an existing file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep Cloudflare Pages' technical host and branch previews out of search
# indexes. Canonical public pages live exclusively on vote-scope.com.
https://projection-3tg.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.projection-3tg.pages.dev/*
  X-Robots-Tag: noindex, nofollow
