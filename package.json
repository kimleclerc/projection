{
  "name": "votescope",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run sync:machine-metadata -- --check && npm run validate:live-data && npm run check:mini-sim",
    "build": "astro build && node scripts/copy-legacy.mjs && pagefind --site dist",
    "preview": "astro preview",
    "validate:editorial": "node scripts/validate-editorial-astro.mjs",
    "check:polymarket": "node scripts/check-polymarket-embeds.mjs",
    "check:mini-sim": "node scripts/check-mini-sim.mjs",
    "validate:mapping": "node scripts/check-quebec-mapping.mjs",
    "validate:live-data": "node scripts/validate-live-data.mjs",
    "sync:machine-metadata": "node scripts/sync-machine-metadata.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:all": "node scripts/submit-indexnow.mjs --all"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.2",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.2.2",
    "leaflet": "^1.9.4",
    "plotly.js-basic-dist-min": "^3.5.1",
    "preact": "^10.29.1",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "pagefind": "^1.5.2"
  }
}
